// ============================================================
// 自举路线图 阶段0-2/0-3:HB 字符串子程序 + 十六进制输出
// 内容:
//   取串长(指针入R0 → 长度出R0):统计 0 结尾串字节数
//   串比较(指针A入R0, 指针B入R1 → R0=0相等 否则非0)
//   输出十六进制(R0 值 → 以 8 位 hex 输出,不换行)
// 主流程:读入 IN 到 0x1000(0 结尾),把常量串 "abc" 放到 0x1200
//        打印 输入串长;比较输入与 "abc" 并打印结果。
// 运行: hbcc 本文件 --run --in <含 abc 的文件>
// 预期: 输入 "abc" → 输出 "00000003\n00000000\n"
// ============================================================

// ---- 常量串 "abc"(0 结尾)放到 0x1200 ----
加载立即数 R0, 0x1200;
加载立即数 R1, 97
存储间接寻址 R1, R0       // 'a'
加立即数 R0, 1
加载立即数 R1, 98
存储间接寻址 R1, R0       // 'b'
加立即数 R0, 1
加载立即数 R1, 99
存储间接寻址 R1, R0       // 'c'
加立即数 R0, 1
加载立即数 R1, 0
存储间接寻址 R1, R0       // 终止符

// ---- 读入 IN 到 0x1000 ----
加载立即数 R0, 0x1000;
读循环:
    读取字符 R1
    加载立即数 R2, 0
    取反 R2                // EOF 哨兵
    比较 R1, R2
    相等跳转 读结束
    存储间接寻址 R1, R0
    加立即数 R0, 1
    跳转 读循环
读结束:
    加载立即数 R1, 0
    存储间接寻址 R1, R0    // 0 结尾

// ---- 打印 输入串长 ----
加载立即数 R0, 0x1000;
调用 取串长
调用 输出十六进制
输出换行

// ---- 比较 输入 与 "abc" ----
加载立即数 R0, 0x1000;
加载立即数 R1, 0x1200
调用 串比较
调用 输出十六进制
输出换行
停止

// ==================== 子程序 ====================

// R0 = 串长(地址入R0,长度出R0),破坏 R1 R2
取串长:
    加载立即数 R1, 0
取长循环:
    加载间接寻址 R2, R0
    比较立即数 R2, 0
    相等跳转 取长完成
    加立即数 R0, 1
    加立即数 R1, 1
    跳转 取长循环
取长完成:
    复制 R0, R1
    返回

// R0 = 比较结果(地址A入R0,地址B入R1;相等 R0=0,否则非0),破坏 R3 R4
串比较:
串比循环:
    加载间接寻址 R3, R0
    加载间接寻址 R4, R1
    比较 R3, R4
    不相等跳转 串比不等
    比较立即数 R3, 0
    相等跳转 串比相等
    加立即数 R0, 1
    加立即数 R1, 1
    跳转 串比循环
串比不等:
    加载立即数 R0, 1
    返回
串比相等:
    加载立即数 R0, 0
    返回

// 输出十六进制:把 R0 以 8 位十六进制输出(不换行),破坏 R1 R2 R3 R5
输出十六进制:
    入栈 R0
    复制 R4, R0            // 值副本
    加载立即数 R3, 28      // 起始移位量
    加载立即数 R5, 8       // 8 个 nibble
hex循环:
    复制 R1, R4
    复制 R2, R3
    右移 R1, R2            // R1 = 值 >> 移位量
    加载立即数 R2, 0xF
    与 R1, R2              // R1 = nibble
    加载立即数 R2, 10
    比较 R1, R2
    小于跳转 hex数字        // nibble < 10
    加立即数 R1, 55         // 'A'-10
    跳转 hex输出
hex数字:
    加立即数 R1, 48         // '0'
hex输出:
    输出字符 R1
    减立即数 R3, 4          // 移位量 28→0(受 R5 计数控制,回绕无碍)
    减立即数 R5, 1
    比较立即数 R5, 0
    不相等跳转 hex循环
    出栈 R0
    返回
