// ============================================================
// 自举路线图 阶段0-6(务实版):HB 汇编器扩展——跳转类指令编码
// 在 0-5(HALT/ADD/LOAD_IMMEDIATE)基础上新增:
//   JMP <地址十进制>     → J 型:op=0x06 | (addr>>2)      (addr 需 4 对齐)
//   CALL <地址十进制>    → J 型:op=0x0D | (addr>>2)
//   JZ R0 <地址十进制>   → I 型:op=0x07 | reg<<20 | addr  (低20位字节地址,不左移)
// 说明:标签两遍扫描(T 型操作数=标签)放 0-7;本步先把三类目标地址形态
//      全部编码能力打通,仍为单遍,复用 0-5 的 词法/寄存器/十进制/写编码。
// 验证:宿主比较 HB 输出与 C# 汇编器输出逐字节一致。
// 内存:源码 0x1000 词缓冲 0x1800 指令名表 0x1A00~0x1F00
//      槽 0x1F00/0x1F04 输出 0x2000
// ============================================================

// ==================== 指令名表 ====================
// 0x1A00 HALT 0x1B00 ADD 0x1C00 LOAD_IMMEDIATE 0x1D00 JMP 0x1E00 CALL 0x1F00 JZ
加载立即数 R7, 0x1A00
加载立即数 R1, 72
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 65
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 76
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 84
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 0
存储间接寻址 R1, R7
// 0x1B00 "ADD"
加载立即数 R7, 0x1B00
加载立即数 R1, 65
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 68
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 68
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 0
存储间接寻址 R1, R7
// 0x1C00 "LOAD_IMMEDIATE"
加载立即数 R7, 0x1C00
加载立即数 R1, 76
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 79
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 65
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 68
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 95
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 73
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 77
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 77
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 69
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 68
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 73
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 65
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 84
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 69
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 0
存储间接寻址 R1, R7
// 0x1D00 "JMP"
加载立即数 R7, 0x1D00
加载立即数 R1, 74
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 77
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 80
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 0
存储间接寻址 R1, R7
// 0x1E00 "CALL"
加载立即数 R7, 0x1E00
加载立即数 R1, 67
存储间接寻址 R1, R7
加立即数 R7, 1
加载立即数 R1, 65
存储间接寻址 R1, R7
