// ============================================================
// CSV.hb —— 带引号转义的表格行进出(CSV / TSV 同一套)(零依赖)
//
// 用法:包含 "../库/CSV.hb";`CSV.字段数("张三,28,杭州", ",")` 给 3,
//   `CSV.取字段("张三,\"28,5\",杭州", ",", 1)` 给 `28,5`(引号里那个逗号不算分隔),
//   `CSV.生成(行文本, 段起, 段长, 段数, ",")` 把 `string.hb.切分` 切好的几段拼回一行。
//
// 口径(2026-10):
//   · **切段口径与 `string.hb.切分` 一致**(这一库是它的"带引号版"):`"账号,姓名"` 按 `,` 给 **2** 段、
//     `"账号,姓名,"` 给 **3** 段(最后那个是空串);**空串给 1 段(一个空字段)**;
//   · **引号只在"字段开头"才算引号**:`账号"姓名` 这种中间出现的引号是**普通字符**;
//     `"账号"姓名` 这种引号后面又跟着东西的:引号里那段算内容,**引号后面到分隔符之间的字节丢掉**;
//   · **引号里的 `""` 是一个引号**;引号里的分隔符 / 换行**都算内容**(所以一整行里可以有换行);
//   · **`取字段` 的号从 0 起**;号越界给空串(不报错);**`转义` 只处理一个字段**(要拼一行就用 `生成`);
//   · **不报错、不停机**:任何一行、任何一个号都有结果。
//
// 英文对照:字段数 fieldCount · 取字段 fieldAt · 是需转义 needsQuote · 转义 quoteField · 生成 buildRow
//
// 复杂度:字段数 / 取字段 O(这一行的字数);转义 / 生成 O(字段字数 × 字段数)。
//
// 边界(如实登记):
//   · **不做"整份文件的解析"**:一行一行读归 `文件.hb.下一行` / `流.hb.读行`,解析每一行归这一库;
//   · **不做"表头 / 列名映射"**(要"一列一个字符串"的容器,语言现在给不了);
//   · **不做"宽松模式"**:引号没配对时**当作一直到行尾都是引号里**,照实给内容(不报错也不猜);
//   · **不认"分号 / 制表符自动猜"**:分隔串是你传进来的那一个。
// 提供的函数(5 个):逐个见下面那张公开方法表。
// ============================================================
模块 CSV

// 私有:取一段(起 + 长)
私有 方法 CSV切字段(字符串 文本, 整数 起, 整数 长) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 0;
    当 (i < 长)
     {
        整数 位 = 起 + i;
        如果 (位 >= 文本.长度())
        {
            跳出;
        }
        文字 c = 文本[位];
        拼接到(结果, c);
        i = i + 1;
    }
    返回 结果;
}

// 私有:一个位置起是不是那条分隔串
私有 方法 CSV是分隔(字符串 行, 整数 位, 字符串 分隔) 返回 逻辑
{
    整数 分隔长 = 分隔.长度();
    如果 (分隔长 == 0 || 位 + 分隔长 > 行.长度())
    {
        返回 假;
    }
    整数 k = 0;
    当 (k < 分隔长)
    {
        文字 a = 行[位 + k];
        文字 b = 分隔[k];
        如果 (a != b)
        {
            返回 假;
        }
        k = k + 1;
    }
    返回 真;
}

// 私有:扫这一行 —— 返回第 `要的号` 个字段(要的号 < 0 = 只数个数),个数写进 `个数`
私有 方法 CSV扫(字符串 行, 字符串 分隔, 整数 要的号, 引用 整数 个数) 返回 字符串
{
    整数 长 = 行.长度();
    整数 号 = 0;
    字符串 结果 = "";
    整数 i = 0;
    当 (i <= 长)
    {
        字符串 本段 = "";
        如果 (i < 长 && 行[i] == '"')
        {
            // 引号包着的一段:里面的 "" 是一个引号
            i = i + 1;
            当 (i < 长)
            {
                如果 (行[i] == '"')
                {
                    如果 (i + 1 < 长 && 行[i + 1] == '"')
                    {
                        拼接到(本段, '"');
                        i = i + 2;
                    }
                    否则
                    {
                        i = i + 1;
                        跳出;
                    }
                }
                否则
                {
                    文字 c = 行[i];
                    拼接到(本段, c);
                    i = i + 1;
                }
            }
            // 引号收尾之后到分隔符之间的东西丢掉
            当 (i < 长 && CSV是分隔(行, i, 分隔) == 假)
            {
                i = i + 1;
            }
        }
        否则
        {
            当 (i < 长 && CSV是分隔(行, i, 分隔) == 假)
            {
                文字 c = 行[i];
                拼接到(本段, c);
                i = i + 1;
            }
        }
        如果 (要的号 == 号)
        {
            结果 = 本段;
        }
        号 = 号 + 1;
        如果 (要的号 >= 0 && 要的号 < 号)
        {
            个数 = 号;
            返回 结果;
        }
        如果 (i >= 长)
        {
            个数 = 号;
            返回 结果;
        }
        // 走到分隔串上:跳过它,继续下一段(末尾那个空段由下一轮给)
        i = i + 分隔.长度();
        如果 (i == 长)
        {
            如果 (要的号 == 号)
            {
                结果 = "";
            }
            号 = 号 + 1;
            个数 = 号;
            返回 结果;
        }
    }
    个数 = 号;
    返回 结果;
}

// ============================================================
// 1、读
// ============================================================

// 这一行有几个字段(空串给 1 —— 一"行"最少有一个字段)。
方法 字段数(字符串 行, 字符串 分隔) 返回 整数
{
    整数 个数 = 0;
    字符串 丢 = CSV扫(行, 分隔, 0 - 1, 个数);
    返回 个数;
}

// 第 `第几个` 个字段(0 起;越界给空串)。
方法 取字段(字符串 行, 字符串 分隔, 整数 第几个) 返回 字符串
{
    如果 (第几个 < 0)
    {
        返回 "";
    }
    整数 个数 = 0;
    返回 CSV扫(行, 分隔, 第几个, 个数);
}

// ============================================================
// 2、写
// ============================================================

// 这个字段里有分隔串 / 引号 / 换行 / 回车吗(有就得包引号)。
方法 是需转义(字符串 字段, 字符串 分隔) 返回 逻辑
{
    整数 i = 0;
    整数 长 = 字段.长度();
    当 (i < 长)
    {
        文字 c = 字段[i];
        如果 (c == '"' || c == '\n' || c == '\r')
        {
            返回 真;
        }
        如果 (CSV是分隔(字段, i, 分隔))
        {
            返回 真;
        }
        i = i + 1;
    }
    返回 假;
}

// 按 CSV 的规矩转义一个字段(要转义就包引号、里面的引号写成两个)。
方法 转义(字符串 字段, 字符串 分隔) 返回 字符串
{
    如果 (是需转义(字段, 分隔) == 假)
    {
        返回 字段;
    }
    字符串 结果 = "\"";
    整数 i = 0;
    整数 长 = 字段.长度();
    当 (i < 长)
    {
        文字 c = 字段[i];
        如果 (c == '"')
        {
            拼接到(结果, "\"\"");
        }
        否则
        {
            拼接到(结果, c);
        }
        i = i + 1;
    }
    拼接到(结果, "\"");
    返回 结果;
}

// 把"一条整串 + 两条并排定长表 + 个数"拼成一行 CSV(`段起[]` / `段长[]` 与 `string.hb.切分` 出来的表逐字一致)。
方法 生成(字符串 行文本, 整数 段起[], 整数 段长[], 整数 段数, 字符串 分隔) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 0;
    当 (i < 段数)
    {
        如果 (i > 0)
        {
            拼接到(结果, 分隔);
        }
        整数 起 = 段起[i];
        整数 长 = 段长[i];
        字符串 段 = CSV切字段(行文本, 起, 长);
        字符串 转 = 转义(段, 分隔);
        拼接到(结果, 转);
        i = i + 1;
    }
    返回 结果;
}

