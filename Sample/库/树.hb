// ============================================================
// 树.hb —— 二叉查找树(堆上节点)库(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 一棵树 = **一个句柄**(堆上一小块控制块):
// 用法:
// ```
// 包含 "../库/树.hb";
// 整数 树根 = 树.新建();
// 树.插入(树根, 50);
// 树.插入(树根, 20);
// 树.插入(树根, 70);
// 整数 游标 = 树.最小游标(树根);       // 拉模式:有序遍历从头开始
// 整数 值 = 0;
// 当 (树.下一项(游标, 值))
// {
//     输出行(值);                       // 20 / 50 / 70(从小到大)
// }
// 树.销毁(树根);                        // 节点与控制块一起还回堆里
// ```
//
// ★ 节点长什么样(这一库的全部"内存账")
//   **节点 16 字节**:`值 [+0]` · `左 [+4]` · `右 [+8]` · **`父 [+12]`**
//   **控制块 8 字节**:`根 [+0]` · `个数 [+4]`(= `新建()` 交出来的那个句柄)
//   **`父` 那一格是这一库好用的关键**:有了它,"中序下一个"不用从根重找一遍(见下面迭代器那一段),
//   删除时"把接替者挂回去"也不用一路记着来路。代价是每插一个节点要多写一格(4 字节)。
//   `0` 就是"没有"(空孩子 / 根的父亲),与 `示例09_堆与数据结构` 那一套写法一致。
//
// ★ 二叉查找树:**左边都比它小,右边都比它大** —— 查一个值像二分,比它小往左、比它大往右,走到 `0` 就是没有;**中序遍历**(左 → 根 → 右)出来一定是从小到大,这一库的迭代器走的就是中序。**重复的值一律拒绝**:`插入` 见到树上已经有这个值就给 `假`。
//
// ★ 迭代器口径(与 `基础库框架.md` §8.4 那条"拉模式"同一套)
//   **拉模式 = 调用方攥着一个游标,自己一句一句地要**:
//     `最小游标(句柄)` 交出中序第一个 → `当 (下一项(游标, 值)) { … }` → 到头给 `假`。
//   要点三条(照 §8.4 写):
//     ① **游标是"下一个要读的那个节点"**:`下一项` 先把当前节点的值写进 `收值`,**再把游标往前挪**;
//     ② **越过头就是 `0`**:`下一项` 见到 `0` 立刻给 `假`(不再动 `收值`);
//     ③ **`当前(游标)` 是"只读一眼"**(不推进)。
//   **"中序下一个"怎么一步找到**(有 `父` 就不用从根重找):
//     · 有右孩子 → 右子树里**树最左**的那个;
//     · 没有右孩子 → 一路往上走,走到"我是我父亲的左孩子"为止,那个父亲就是下一个;
//       一路走到根还没等到,就说明"我是最大的那个" ⇒ 没有了(给 `0`)。
//
// 口径(2026-10;每条都对着实测写):
//   · **一律 32 位有符号 `整数`**:值、句柄、游标都是它(节点地址也是);
//   · **`新建()` 从堆里要块**(默认 64KB 堆 ⇒ 连控制块一起约 4090 个节点);**要不到会当场停下**;
//   · **`销毁` 与 `清掉` 的区别**:`销毁` = 节点 + 控制块**全还回**,句柄当场作废;
//     `清掉` = 只还节点,控制块留着(还能接着插);
//   · **重复值给 `假`**(见上面那一段);`查找` / `删除` 没有那个值也给 `假`(什么都不动);
//   · **空树处处合法**:`最小 / 最大` 给 `假`、`最小游标` 给 0、`高度` 给 0、`到数组` 给 0 个;
//   · **`高度` 是"节点层数"**(空树 0、只有一个根 1);它是**量出来的**(一层一层往下数),
//     不是记在控制块里的 —— 插入 / 删除都不维护它(要频繁问就自己缓存,这一库不替你做决定);
//   · **中序遍历不用递归**:靠 `父` 一格一格走(见上面),所以**没有"树一深就爆栈"这件事**
//     (递归写法在退化成一条链时会吃掉软栈);
//   · **不做"平衡"**:普通二叉查找树**有序插入会退化成一条链**(高度 = 个数)——
//     这是"二叉查找树"本身的边界,不是这一库的偷懒;要平衡请看将来的"AVL / 红黑"那一档。
//
// 提供的函数(15 个):逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:新建 / 销毁 / 清掉 O(节点数);是空 / 个数 O(1);
//   插入 / 查找 / 删除 / 最小 / 最大 **O(树高)**(平衡时 O(log n),退化成链时 O(n));
//   高度 O(节点数);到数组 O(节点数);最小游标 O(树高);
//   下一项 **均摊 O(1)**(每条边最多走两趟)、当前 O(1)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **句柄与游标都是"堆地址"**:`销毁` 之后再用那个句柄会**被当场拦住**(语言的堆会认出来);
//   · **节点不自动回收**:语言没有 GC ⇒ 用完了自己 `销毁` / `清掉`;
//   · **重复值一律拒绝**(见上面那一段):要装重复的用 `链句柄.hb` / 列句柄;
//   · **不做平衡**(见上面口径最后一条):有序插入会退化成一条链;
//   · **`高度` 是现数的**(O(节点数)):它在递归数子树,退化成链时递归深度就是节点数 ——
//     实测语言会**在软栈上"递归太深"报错**(不是崩),这是刻意留的护栏;
//   · **不做"前序 / 后序遍历"**:要那两种就自己写(这一库只给中序,因为"有序"才是查找树的卖点)。
// ============================================================
模块 树

// 控制块两格:根 / 个数
// 节点四格:值 / 左 / 右 / 父

// ---------- 私有:要一个节点(值 / 左 / 右 / 父 都写好) ----------
私有 方法 树造节点(整数 值, 整数 左, 整数 右, 整数 父) 返回 整数
{
    整数 节点 = 申请(16);
    存字(节点, 0, 值);
    存字(节点, 4, 左);
    存字(节点, 8, 右);
    存字(节点, 12, 父);
    返回 节点;
}

// ---------- 私有:把 `父` 里"原来指着 `老`"的那一格改成指着 `新`(父 = 0 就是"根"那一格) ----------
私有 方法 树接到父节点(整数 句柄, 整数 父, 整数 老, 整数 新)
{
    如果 (父 == 0)
    {
        存字(句柄, 0, 新);
        返回;
    }
    如果 (取字(父, 4) == 老)
    {
        存字(父, 4, 新);
        返回;
    }
    存字(父, 8, 新);
}

// ---------- 私有:顺着值找那个节点(没有给 0) ----------
私有 方法 树找节点(整数 句柄, 整数 值) 返回 整数
{
    整数 走 = 取字(句柄, 0);
    当 (走 != 0)
    {
        整数 当值 = 取字(走, 0);
        如果 (值 == 当值)
        {
            返回 走;
        }
        如果 (值 < 当值)
        {
            走 = 取字(走, 4);
        }
        否则
        {
            走 = 取字(走, 8);
        }
    }
    返回 0;
}

// ---------- 私有:一棵子树里最左 / 最右的那个节点 ----------
私有 方法 树最左(整数 节点) 返回 整数
{
    整数 走 = 节点;
    当 (走 != 0 && 取字(走, 4) != 0)
    {
        走 = 取字(走, 4);
    }
    返回 走;
}

私有 方法 树最右(整数 节点) 返回 整数
{
    整数 走 = 节点;
    当 (走 != 0 && 取字(走, 8) != 0)
    {
        走 = 取字(走, 8);
    }
    返回 走;
}

// ---------- 私有:中序下一个(有 `父` 所以两条路都不用从根重找) ----------
私有 方法 树后继(整数 节点) 返回 整数
{
    如果 (节点 == 0)
    {
        返回 0;
    }
    整数 右 = 取字(节点, 8);
    如果 (右 != 0)
    {
        返回 树最左(右);
    }
    整数 走 = 节点;
    整数 父 = 取字(走, 12);
    当 (父 != 0 && 取字(父, 8) == 走)
    {
        走 = 父;
        父 = 取字(走, 12);
    }
    返回 父;
}

// ---------- 私有:子树高(空子树 0) ----------
私有 方法 树子高(整数 节点) 返回 整数
{
    如果 (节点 == 0)
    {
        返回 0;
    }
    整数 左高 = 树子高(取字(节点, 4));
    整数 右高 = 树子高(取字(节点, 8));
    如果 (左高 > 右高)
    {
        返回 左高 + 1;
    }
    返回 右高 + 1;
}

// ---------- 私有:把一个节点从树上摘掉(左 / 右 / 父三格都还读得到),然后还回堆里 ----------
私有 方法 树摘掉(整数 句柄, 整数 节点)
{
    整数 左 = 取字(节点, 4);
    整数 右 = 取字(节点, 8);
    整数 父 = 取字(节点, 12);
    如果 (左 == 0 && 右 == 0)
    {
        树接到父节点(句柄, 父, 节点, 0);
    }
    否则 如果 (左 == 0)
    {
        存字(右, 12, 父);
        树接到父节点(句柄, 父, 节点, 右);
    }
    否则 如果 (右 == 0)
    {
        存字(左, 12, 父);
        树接到父节点(句柄, 父, 节点, 左);
    }
    否则
    {
        // 两个孩子:拿**右子树最小的那个**(中序后继)顶上来 —— 它一定没有左孩子
        整数 接替 = 树最左(右);
        整数 接替父 = 取字(接替, 12);
        整数 接替右 = 取字(接替, 8);
        如果 (接替父 != 节点)
        {
            树接到父节点(句柄, 接替父, 接替, 接替右);       // 先把它从老位置摘掉
            如果 (接替右 != 0)
            {
                存字(接替右, 12, 接替父);
            }
            存字(接替, 8, 右);                       // 再把原节点的右子树接过来
            存字(右, 12, 接替);
        }
        存字(接替, 4, 左);
        存字(左, 12, 接替);
        存字(接替, 12, 父);
        树接到父节点(句柄, 父, 节点, 接替);
    }
    释放(节点);
}

// ============================================================
// 1、建与收拾
// ============================================================

// 从堆里要 8 字节控制块当树的家(根与个数都写 0);要不到会当场停下
方法 新建() 返回 整数
{
    整数 句柄 = 申请(8);
    存字(句柄, 0, 0);
    存字(句柄, 4, 0);
    返回 句柄;
}

// 节点与控制块一起还回堆里,句柄当场作废;之后再用会被语言的堆拦住
方法 销毁(整数 句柄)
{
    清掉(句柄);
    释放(句柄);
}

// 只还节点,控制块留着(还能接着插)。
// 做法:**一路摘最左的那个**(它没有左孩子,摘起来只要把它右孩子接上去),
// 把树清空:一路摘最左的那个还回堆里;控制块留着,根与个数两格归 0
方法 清掉(整数 句柄)
{
    当 (取字(句柄, 0) != 0)
    {
        整数 走 = 树最左(取字(句柄, 0));
        整数 右 = 取字(走, 8);
        整数 父 = 取字(走, 12);
        如果 (父 == 0)
        {
            存字(句柄, 0, 右);
        }
        否则
        {
            存字(父, 4, 右);
        }
        如果 (右 != 0)
        {
            存字(右, 12, 父);
        }
        释放(走);
    }
    存字(句柄, 0, 0);
    存字(句柄, 4, 0);
}

// ============================================================
// 2、问
// ============================================================

// 一个节点都没有时给真;控制块里个数那一格是 0 就是空
方法 是空(整数 句柄) 返回 逻辑
{
    返回 取字(句柄, 4) == 0;
}

// 树上现在有几个值;重复的插不进来,所以它也是不同值的个数
方法 个数(整数 句柄) 返回 整数
{
    返回 取字(句柄, 4);
}

// ============================================================
// 3、插 / 查 / 删
// ============================================================

// 比着大小往树上挂一个值(小的往左、大的往右);重复的值一律给假、不覆盖
方法 插入(整数 句柄, 整数 值) 返回 逻辑
{
    如果 (取字(句柄, 0) == 0)
    {
        存字(句柄, 0, 树造节点(值, 0, 0, 0));
        存字(句柄, 4, 1);
        返回 真;
    }
    整数 走 = 取字(句柄, 0);
    当 (真)
    {
        整数 当值 = 取字(走, 0);
        如果 (值 == 当值)
        {
            返回 假;
        }
        如果 (值 < 当值)
        {
            整数 左 = 取字(走, 4);
            如果 (左 == 0)
            {
                存字(走, 4, 树造节点(值, 0, 0, 走));
                存字(句柄, 4, 取字(句柄, 4) + 1);
                返回 真;
            }
            走 = 左;
        }
        否则
        {
            整数 右 = 取字(走, 8);
            如果 (右 == 0)
            {
                存字(走, 8, 树造节点(值, 0, 0, 走));
                存字(句柄, 4, 取字(句柄, 4) + 1);
                返回 真;
            }
            走 = 右;
        }
    }
    返回 假;
}

// 顺着大小一路找这个值;有给真、没有给假,树上哪一格都不动
方法 查找(整数 句柄, 整数 值) 返回 逻辑
{
    返回 树找节点(句柄, 值) != 0;
}

// 摘掉这个值(两个孩子时拿右子树最小的顶上来);没有它给假、什么都不动
方法 删除(整数 句柄, 整数 值) 返回 逻辑
{
    整数 节点 = 树找节点(句柄, 值);
    如果 (节点 == 0)
    {
        返回 假;
    }
    树摘掉(句柄, 节点);
    存字(句柄, 4, 取字(句柄, 4) - 1);
    返回 真;
}

// ============================================================
// 4、最小 / 最大 / 高
// ============================================================

// 一路往左走到底,把那个值写进收值;空树给假,收值保持原样
方法 最小(整数 句柄, 引用 整数 收值) 返回 逻辑
{
    整数 节点 = 树最左(取字(句柄, 0));
    如果 (节点 == 0)
    {
        返回 假;
    }
    收值 = 取字(节点, 0);
    返回 真;
}

// 一路往右走到底,把那个值写进收值;空树给假,收值一个字节都不改
方法 最大(整数 句柄, 引用 整数 收值) 返回 逻辑
{
    整数 节点 = 树最右(取字(句柄, 0));
    如果 (节点 == 0)
    {
        返回 假;
    }
    收值 = 取字(节点, 0);
    返回 真;
}

// 节点层数(空树 0、只一个根给 1);现数的,退化成链时递归深度就是节点数
方法 高度(整数 句柄) 返回 整数
{
    返回 树子高(取字(句柄, 0));
}

// ============================================================
// 5、迭代器(拉模式:调用方攥着游标,自己一句一句地要)
// ============================================================

// 中序(从小到大)铺进数组,铺满数组长度就停;返回实际铺进去几个
方法 到数组(整数 句柄, 整数 出去[]) 返回 整数
{
    整数 走 = 树最左(取字(句柄, 0));
    整数 铺 = 0;
    当 (走 != 0 && 铺 < 出去.长度())
    {
        出去[铺] = 取字(走, 0);
        铺 = 铺 + 1;
        走 = 树后继(走);
    }
    返回 铺;
}

// 交出遍历起点:中序第一个节点(也就是最小的那个);空树给 0
方法 最小游标(整数 句柄) 返回 整数
{
    返回 树最左(取字(句柄, 0));
}

// 把游标那个节点的值写进收值,再挪到中序下一个;到头给假且不动收值
方法 下一项(引用 整数 游标, 引用 整数 收值) 返回 逻辑
{
    如果 (游标 == 0)
    {
        返回 假;
    }
    收值 = 取字(游标, 0);
    游标 = 树后继(游标);
    返回 真;
}

// 只看一眼游标那个节点的值(不动游标);游标是 0 给 0
方法 当前(整数 游标) 返回 整数
{
    如果 (游标 == 0)
    {
        返回 0;
    }
    返回 取字(游标, 0);
}
