// ============================================================
// 定点.hb —— 16.16 定点数库(纯 HB,不动语言面)
//
// 一个定点数就是**一个 `整数`**,它的值 = 那串位 ÷ 65536(`1.0` 就是 65536):
//   高 16 位是整数部分、低 16 位是小数部分 ⇒ 能表示 `-32768.0 ~ 32767.99998`,
//   **分辨率 1/65536 ≈ 0.0000153**;加、减与普通整数一模一样,乘除各挪一次 16 位。
//
// 用法:包含 "../库/定点.hb";`整数 左 = 定点.从整数(3)`(= 3.0)、`整数 右 = 定点.从分数(1, 2)`(= 0.5),
//   然后 `定点.相乘(左, 右)` 得 1.5,`定点.转字符串(乘积, 2)` 得 `"1.50"`。
//
// 口径(2026-10):
//   · **底层就是一个 32 位有符号 `整数`** —— 不新开类型、不加关键字、不加内建;
//   · `从整数(n)` = `n * 65536`;`到整数(值)` = **四舍五入**(不是截断);`取整` 向零截断;
//   · ⚠ **乘除的天花板(32 位中间项)**:两条都靠一个"零头 × 一个数"的中间项,它要**塞进 32 位**
//     —— 两边都不小时会**回绕**。安全界限:`相乘` 要 `小数(左) × 右 < 0.5`;`相除` 要 `左 % 右 < 32768`。
//     加减**没有这个限制**(定点加减就是整数加减,只在 `±32768.0` 上封顶)。
//   · **`开方(值)` 只收非负数**(负数给 0);**`转字符串(值, 小数位)`**:小数位 0~5,超了夹回,
//     末位**四舍五入**,负数带 `-`(0 不带);**`谁大(左, 右)` 给 -1 / 0 / 1**(普通整数比较);
//   · **不做"双精度互转"**:真需要就自己 `双精度乘(…)` 之后取整,再 `从整数`。
//
// 英文对照:从整数 fromInt · 从分数 fromRatio · 到整数 toInt · 取整 intPart · 取小数 fracPart
//   相加 add · 相减 sub · 相乘 mul · 相除 div · 开方 sqrtOf · 绝对值 absOf · 谁大 compareTo · 转字符串 toText
//
// 复杂度:除了 `转字符串`(要拼串)全是 **O(1)**(几条整数指令)。
// 边界(如实登记):**`相除` 右为 0 给 0**、**`从分数` 分母 ≤ 0 给 0**、**`开方` 负数给 0** —— 都不停机;
//   乘法与除法按 32 位回绕(要更大范围请用 `双精度` / `float64.hb`);这一库零依赖。
// 提供的函数(13 个):逐个见下面那张公开方法表。
// ============================================================
模块 定点

// 小数部分的位数:16 位 ⇒ 1.0 = 65536
私有 整数 半步 = 32768;
私有 整数 一步 = 65536;

// 私有:定点整数开方(牛顿迭代,只收非负)
私有 方法 定点整数开方(整数 值) 返回 整数
{
    如果 (值 <= 0)
    {
        返回 0;
    }
    整数 猜 = 值;
    如果 (猜 > 46340)                     // 2^31 的平方根约 46340:先压到不会溢出的范围
    {
        猜 = 46340;
    }
    整数 前 = 0;
    当 (猜 != 前)
    {
        前 = 猜;
        猜 = (猜 + 值 / 猜) / 2;
    }
    返回 猜;
}

// 私有:把 `值` 夹进 [0, 上界]
私有 方法 定点夹回(整数 值, 整数 上界) 返回 整数
{
    如果 (值 < 0)
    {
        返回 0;
    }
    如果 (值 > 上界)
    {
        返回 上界;
    }
    返回 值;
}

// 私有:整数 → 十进制串(零依赖,不用 `格式化`)
私有 方法 定点数文(整数 值) 返回 字符串
{
    字符串 结果 = "";
    整数 正 = 值;
    如果 (正 < 0)
    {
        拼接到(结果, '-');
        正 = 0 - 正;
    }
    如果 (正 == 0)
    {
        拼接到(结果, '0');
        返回 结果;
    }
    字符串 倒 = "";
    当 (正 > 0)
    {
        拼接到(倒, 定点输出数字(正 % 10));
        正 = 正 / 10;
    }
    整数 末 = 倒.长度() - 1;
    当 (末 >= 0)
    {
        拼接到(结果, 倒[末]);
        末 = 末 - 1;
    }
    返回 结果;
}

// 私有:一位数字 → 一个字符
私有 方法 定点输出数字(整数 位) 返回 字符串
{
    如果 (位 == 0)
    {
        返回 "0";
    }
    如果 (位 == 1)
    {
        返回 "1";
    }
    如果 (位 == 2)
    {
        返回 "2";
    }
    如果 (位 == 3)
    {
        返回 "3";
    }
    如果 (位 == 4)
    {
        返回 "4";
    }
    如果 (位 == 5)
    {
        返回 "5";
    }
    如果 (位 == 6)
    {
        返回 "6";
    }
    如果 (位 == 7)
    {
        返回 "7";
    }
    如果 (位 == 8)
    {
        返回 "8";
    }
    返回 "9";
}

// 私有:10 的 `位` 次方
私有 方法 定点十的幂(整数 位) 返回 整数
{
    整数 结果 = 1;
    整数 i = 0;
    当 (i < 位)
    {
        结果 = 结果 * 10;
        i = i + 1;
    }
    返回 结果;
}

// 私有:十进制串左补 0 到 `位数` 位
私有 方法 定点补零(字符串 文本, 整数 位数) 返回 字符串
{
    字符串 结果 = "";
    整数 缺 = 位数 - 文本.长度();
    当 (缺 > 0)
    {
        拼接到(结果, '0');
        缺 = 缺 - 1;
    }
    拼接到(结果, 文本);
    返回 结果;
}

// ============================================================
// 1、转进来 / 转出去
// ============================================================

// 整数 → 定点(乘 65536);会按 32 位回绕。
方法 从整数(整数 值) 返回 整数
{
    返回 值 * 一步;
}

// 比例 → 定点:分子 / 分母(分母 ≤ 0 给 0;先把分子放大 16 位再除)。
方法 从分数(整数 分子, 整数 分母) 返回 整数
{
    如果 (分母 == 0)
    {
        返回 0;
    }
    返回 (分子 * 一步) / 分母;
}

// 四舍五入(不是截断)。
方法 到整数(整数 值) 返回 整数
{
    如果 (值 >= 0)
    {
        返回 (值 + 半步) / 一步;
    }
    返回 (值 - 半步) / 一步;
}

// 只要整数部分(向零截断)。
方法 取整(整数 值) 返回 整数
{
    返回 值 / 一步;
}

// 只要小数部分(0~65535 的原始值;负数取绝对值那一侧的小数)。
方法 取小数(整数 值) 返回 整数
{
    整数 余 = 值 % 一步;
    如果 (余 < 0)
    {
        余 = 0 - 余;
    }
    返回 余;
}

// ============================================================
// 2、四则(乘除要各挪一次 16 位,直接乘会溢出)
// ============================================================

// 定点加。
方法 相加(整数 左, 整数 右) 返回 整数
{
    返回 左 + 右;
}

// 定点减。
方法 相减(整数 左, 整数 右) 返回 整数
{
    返回 左 - 右;
}

// 定点乘;要 `小数(左) × 右 < 0.5`,否则中间项按 32 位回绕。
方法 相乘(整数 左, 整数 右) 返回 整数
{
    整数 高大 = (左 / 一步) * 右;
    整数 零头 = ((左 % 一步) * 右) / 一步;
    返回 高大 + 零头;
}

// 定点除;右为 0 给 0;要 `左 % 右 < 32768`,否则中间项按 32 位回绕。
方法 相除(整数 左, 整数 右) 返回 整数
{
    如果 (右 == 0)
    {
        返回 0;
    }
    整数 高大 = (左 / 右) * 一步;
    整数 零头 = ((左 % 右) * 一步) / 右;
    返回 高大 + 零头;
}

// ============================================================
// 3、开方 / 绝对值 / 比大小
// ============================================================

// 负数给 0(没定义的那一档给一个确定的答案,不停机)。
方法 开方(整数 值) 返回 整数
{
    如果 (值 <= 0)
    {
        返回 0;
    }
    返回 定点整数开方(值) * 256;
}

// 取绝对值。
// 转给语言内建的 `取整数绝对值`(一条指令;`-2147483648` 的回绕口径与这里原来那一版相同)。
方法 绝对值(整数 值) 返回 整数
{
    返回 取整数绝对值(值);
}

// -1 / 0 / 1(普通整数比较,不做任何缩放)。
方法 谁大(整数 左, 整数 右) 返回 整数
{
    如果 (左 < 右)
    {
        返回 -1;
    }
    如果 (左 > 右)
    {
        返回 1;
    }
    返回 0;
}

// ============================================================
// 4、转字符串(零依赖:数文自己写)
// ============================================================

// `小数位` 0~5(超了夹回),末位四舍五入;负数带 `-`(0 不带)。
方法 转字符串(整数 值, 整数 小数位) 返回 字符串
{
    整数 位 = 定点夹回(小数位, 5);
    整数 放大 = 定点十的幂(位);
    整数 负 = 0;
    如果 (值 < 0)
    {
        负 = 1;
        值 = 0 - 值;
    }
    // 先把小数部分按 10^位 四舍五入,再拆成"整数部分 + 小数部分"
    整数 总 = (值 * 放大 + 半步) / 一步;
    整数 整部 = 总 / 放大;
    字符串 结果 = 定点数文(整部);
    如果 (位 > 0)
    {
        拼接到(结果, '.');
        拼接到(结果, 定点补零(定点数文(总 - 整部 * 放大), 位));
    }
    如果 (负 == 1 && 总 != 0)
    {
        字符串 带负 = "-";
        拼接到(带负, 结果);
        返回 带负;
    }
    返回 结果;
}
