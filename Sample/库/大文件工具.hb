// ============================================================
// 大文件工具.hb —— 逐块拷贝 / 数行 / 逐块校验(依赖 `流.hb`)
//
// 用法:包含 "../库/大文件工具.hb";`拷到(源, 目标)` 给字节数(-1 = 失败);`数行` / `校验` / `读头` 各一件。
//
// 口径(2026-10):
//   · **一块 4096 字节**,三件活都按它循环 ⇒ 内存占用是常数(时间是 O(文件字节数)),与文件多大无关;
//   · **`拷到` 是覆盖写**(目标已存在就从头上)、**不建目录**;返回**真写下去的字节数**(-1 = 开不出来 / 中途写失败,失败会先把两条流关掉);
//   · **`数行` 按字节认 `\n`**(末行没有换行也算一行;空文件给 0);数的是**换行的个数**,不问编码;
//   · **`校验` 是 FNV-1a 32**(`和` 初值 `2166136261`,每字节 `异或` 完再乘 `16777619`,按 32 位回绕):
//     它**按字节**算;空文件给初值;**失败给假**(不改 `和`);
//   · **`读头` 最多 64 字节**(内建 `读一块` 的上限要编译期常量):短文件给全部,打不开给空串;
//
// 英文对照:拷到 copyTo · 数行 countLines · 校验 fnv1a · 读头 readHead
//
// 边界(如实登记):
//   · **不做"取文件大小"**(要长度就用 `拷到` 的返回值,或者自己开流数一遍);**不做 CRC32**;
//   · **`读头` 的 64 字节是硬上限**(不是"默认值"),要更多就用 `流.hb` 自己读;
//   · **不递归、不删、不建目录**:这一库只管"文件内容"这三件,目录那一族归 `目录.hb`。
// 提供的函数(4 个):逐个见下面那张公开方法表。
// 复杂度:三件都是 O(文件字节数);空间 O(4096)。
// ============================================================
模块 大文件工具

包含 "流.hb"

// 模块状态:一块 4KB 的定长缓冲。
//   `字符串[i]` 取的是"第 i 个文字",UTF-8 得从头数 ⇒ 逐字扫是 O(n²);定长缓冲的下标是 O(1),所以逐字节那两件先把一块搬进来再看。
私有 字符 区[4100];

// ============================================================
// 1、逐块拷贝
// ============================================================

// 把 `源` 一块一块拷到 `目标`(覆盖写);返回真写下去的字节数(-1 = 失败)。
方法 拷到(字符串 源, 字符串 目标) 返回 整数
{
    整数 读句 = 流.开读(源);
    如果 (读句 < 0)
    {
        返回 0 - 1;
    }
    整数 写句 = 流.开写(目标);
    如果 (写句 < 0)
    {
        逻辑 读流收尾 = 流.关(读句);
        返回 0 - 1;
    }
    整数 合计 = 0;
    整数 块长 = 流.读块(读句);
    当 (块长 > 0)
    {
        字符串 块 = 流.当前块(读句);
        整数 写掉 = 流.写块(写句, 块);
        如果 (写掉 < 0)
        {
            逻辑 读流收尾 = 流.关(读句);
            逻辑 写流收尾 = 流.关(写句);
            返回 0 - 1;
        }
        合计 = 合计 + 块长;
        块长 = 流.读块(读句);
    }
    逻辑 读流收尾 = 流.关(读句);
    逻辑 写流收尾 = 流.关(写句);
    如果 (写流收尾 == 假)
    {
        返回 0 - 1;
    }
    返回 合计;
}

// ============================================================
// 2、数行
// ============================================================

// 数一数文件里有几行(`\n` 个数为准;末行没有换行也算一行);打不开给 -1。
方法 数行(字符串 路径) 返回 整数
{
    整数 句 = 流.开读(路径);
    如果 (句 < 0)
    {
        返回 0 - 1;
    }
    整数 换行数 = 0;
    整数 合计 = 0;
    逻辑 末是换行 = 假;
    整数 块长 = 流.读块(句);
    当 (块长 > 0)
    {
        字符串 块 = 流.当前块(句);
        区[0] = 0;
        拼接到(区, 块);
        整数 i = 0;
        当 (i < 块长)
        {
            字符 c = 区[i];
            如果 (c == 10)
            {
                换行数 = 换行数 + 1;
                末是换行 = 真;
            }
            否则
            {
                末是换行 = 假;
            }
            i = i + 1;
        }
        合计 = 合计 + 块长;
        块长 = 流.读块(句);
    }
    逻辑 收 = 流.关(句);
    如果 (合计 == 0)
    {
        返回 0;
    }
    如果 (末是换行)
    {
        返回 换行数;
    }
    返回 换行数 + 1;
}

// ============================================================
// 3、逐块校验(FNV-1a 32)
// ============================================================

// 把整份文件的字节喂进 FNV-1a(32 位);成功给真并把结果写进 `和`,打不开给假。
方法 校验(字符串 路径, 引用 无符号整数 和) 返回 逻辑
{
    和 = 2166136261;
    整数 句 = 流.开读(路径);
    如果 (句 < 0)
    {
        返回 假;
    }
    无符号整数 值 = 2166136261;
    整数 块长 = 流.读块(句);
    当 (块长 > 0)
    {
        字符串 块 = 流.当前块(句);
        区[0] = 0;
        拼接到(区, 块);
        整数 i = 0;
        当 (i < 块长)
        {
            无符号整数 一个 = 区[i];
            值 = 大文件工具哈希字节(值, 一个);
            i = i + 1;
        }
        块长 = 流.读块(句);
    }
    逻辑 收 = 流.关(句);
    和 = 值;
    返回 真;
}

// ---------- 私有:一个字节喂进 FNV-1a(32 位回绕) ----------
私有 方法 大文件工具哈希字节(无符号整数 值, 无符号整数 一个字节) 返回 无符号整数
{
    无符号整数 结果 = 值 ^ (一个字节 & 255);
    返回 结果 * 16777619;
}

// ============================================================
// 4、读头
// ============================================================

// 头最多 64 字节(短文件给全部;空文件 / 打不开给空串)。
方法 读头(字符串 路径) 返回 字符串
{
    整数 句 = 流.开读(路径);
    如果 (句 < 0)
    {
        返回 "";
    }
    整数 块长 = 流.读块(句);
    字符串 结果 = 流.当前块(句);
    逻辑 收 = 流.关(句);
    如果 (块长 <= 0)
    {
        返回 "";
    }
    如果 (结果.长度() > 64)
    {
        字符串 截 = "";
        整数 i = 0;
        当 (i < 64)
        {
            文字 c = 结果[i];
            拼接到(截, c);
            i = i + 1;
        }
        返回 截;
    }
    返回 结果;
}
