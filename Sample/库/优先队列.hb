// ============================================================
// 优先队列.hb —— 优先队列(最小堆)库(纯 HB,不动语言面)
//
// 用法:包含 "../库/优先队列.hb";一个队列 = "一张定长数组 + 一个计数" ——
//   `整数 堆格[16]; 整数 用 = 0;` 之后 `优先队列.放(堆格, 用, 7)`,
//   `优先队列.取最小(堆格, 用, 最小)`(空的给 假,不动 `最小`)。
//
// 为什么不是"新建(容量) 返回一个队列对象":语言里**列表取不出地址**、传不进函数 ⇒
//   照语言自己的容器惯用法来:**定长数组 = 容量**,`引用 整数 个数` 是状态。
//   名字叫 `优先队列` 不叫"堆":语言里的**堆**是 `申请 / 释放 / 取字 / 存字` 管的那块内存。
//
// 口径(2026-10):
//   · **一律 32 位有符号 `整数`**,按**数值大小**比(不是无符号位模式):要"取绝对值最大的"
//     就自己先取负再放;
//   · **`个数` 参数一律先夹回 `[0, 表长]` 再说**:传大了、传负了都不越界(不报错、不停机);
//   · **满了 / 空了不是错误**:`放` 给 `假`、`取最小 / 看最小` 给 `假`(不写错误槽、不停机);
//   · **取不到时不动 `收值`**:"没取到"与"取到一个 0"必须分得清;
//   · **相等的值不保证先进先出**:最小堆只保证"取出来的顺序不降"(要稳定顺序就放 `[值, 序号]` 那种复合键);
//   · **`清掉` 只把计数清 0**(不擦数组里的旧值);**本库可重入**(一个模块级变量都不占)。
//
// 英文对照:是空 isEmpty · 是满 isFull · 个数 count · 放 push · 取最小 popMin
//   看最小 peekMin · 建堆 heapify · 升序取出 drainSorted · 清掉 clearAll
//
// 复杂度:是空 / 是满 / 个数 / 看最小 / 清掉 O(1);放 / 取最小 O(log 个数);
//   建堆 O(个数);升序取出 O(个数 × log 个数)(就是堆排序)。
//
// 边界(如实登记):
//   · **队列对象传不进函数**、**动态列表不能当容量**(容量一定是定长数组);
//   · **`升序取出` 目标表小了就只铺一部分**,返回实际铺出去几个;没铺出去的那些**已经取走了**
//     (`个数` 已经减过)⇒ 目标表不够大时,队列里少了、`出去` 里也没有。
// 提供的函数(9 个):逐个见下面那张公开方法表。
// ============================================================
模块 优先队列

// 私有:把 `值` 压进 [0, 上界]
私有 方法 优先队列夹回(整数 值, 整数 上界) 返回 整数
{
    如果 (值 < 0)
    {
        返回 0;
    }
    如果 (值 > 上界)
    {
        返回 上界;
    }
    返回 值;
}

// 私有:换两个下标上的值(只在两下标都合法时调用)
私有 方法 优先队列换一对(整数 表[], 整数 左, 整数 右)
{
    整数 暂 = 表[左];
    表[左] = 表[右];
    表[右] = 暂;
}

// 私有:上浮(新放进来的那个一路跟父亲比,比父亲小就换上去)
私有 方法 优先队列上浮(整数 表[], 整数 位置)
{
    当 (位置 > 0)
    {
        整数 父亲 = (位置 - 1) / 2;
        如果 (表[位置] >= 表[父亲])
        {
            跳出;
        }
        优先队列换一对(表, 位置, 父亲);
        位置 = 父亲;
    }
}

// 私有:下沉(跟两个孩子里小的那个比,比它大就换下去)
私有 方法 优先队列下沉(整数 表[], 整数 有效个数, 整数 位置)
{
    当 (真)
    {
        整数 左 = 位置 * 2 + 1;
        如果 (左 >= 有效个数)
        {
            跳出;                             // 没有孩子了 → 到底
        }
        整数 小 = 左;
        整数 右 = 左 + 1;
        如果 (右 < 有效个数 && 表[右] < 表[左])
        {
            小 = 右;
        }
        如果 (表[位置] <= 表[小])
        {
            跳出;                             // 已经不比孩子大 → 到位
        }
        优先队列换一对(表, 位置, 小);
        位置 = 小;
    }
}

// ============================================================
// 1、问状态
// ============================================================

// 里面一个都没有。
方法 是空(整数 表[], 整数 个数) 返回 逻辑
{
    返回 优先队列夹回(个数, 表.长度()) == 0;
}

// 个数到了表长。
方法 是满(整数 表[], 整数 个数) 返回 逻辑
{
    返回 优先队列夹回(个数, 表.长度()) >= 表.长度();
}

// 夹回之后的有效个数。
方法 个数(整数 表[], 整数 个数) 返回 整数
{
    返回 优先队列夹回(个数, 表.长度());
}

// ============================================================
// 2、进与出(改计数的两个动作)
// ============================================================

// 塞一个进去;满了给 假。
方法 放(整数 表[], 引用 整数 个数, 整数 值) 返回 逻辑
{
    整数 表长 = 表.长度();
    整数 用了 = 优先队列夹回(个数, 表长);
    如果 (用了 >= 表长)
    {
        返回 假;
    }
    表[用了] = 值;
    优先队列上浮(表, 用了);
    个数 = 用了 + 1;
    返回 真;
}

// 取走最小的;空了给 假(不动 `收值`)。
方法 取最小(整数 表[], 引用 整数 个数, 引用 整数 收值) 返回 逻辑
{
    整数 用了 = 优先队列夹回(个数, 表.长度());
    如果 (用了 <= 0)
    {
        返回 假;
    }
    收值 = 表[0];
    用了 = 用了 - 1;
    表[0] = 表[用了];                        // 把最后一个搬到堆顶,再往下沉
    优先队列下沉(表, 用了, 0);
    个数 = 用了;
    返回 真;
}

// ============================================================
// 3、看(不动计数)
// ============================================================

// 只看不取(O(1),不排序也能看);空了给 假。
方法 看最小(整数 表[], 整数 个数, 引用 整数 收值) 返回 逻辑
{
    如果 (优先队列夹回(个数, 表.长度()) <= 0)
    {
        返回 假;
    }
    收值 = 表[0];
    返回 真;
}

// ============================================================
// 4、整队动作
// ============================================================

// 把前 `个数` 格当场理成堆(从最后一个有孩子的父亲往前逐个下沉,总代价 O(个数));里面本来就空就什么都不做。
方法 建堆(整数 表[], 引用 整数 个数)
{
    整数 用了 = 优先队列夹回(个数, 表.长度());
    如果 (用了 <= 1)
    {
        个数 = 用了;
        返回;
    }
    整数 位置 = 用了 / 2 - 1;
    当 (位置 >= 0)
    {
        优先队列下沉(表, 用了, 位置);
        位置 = 位置 - 1;
    }
    个数 = 用了;
}

// 一直取最小铺进 `出去`,直到取空或者 `出去` 铺满;返回实际铺出去几个(取出来就不在队列里了)。
方法 升序取出(整数 表[], 引用 整数 个数, 整数 出去[]) 返回 整数
{
    整数 用了 = 优先队列夹回(个数, 表.长度());
    整数 目标长 = 出去.长度();
    整数 铺了 = 0;
    当 (用了 > 0 && 铺了 < 目标长)
    {
        出去[铺了] = 表[0];
        铺了 = 铺了 + 1;
        用了 = 用了 - 1;
        表[0] = 表[用了];
        优先队列下沉(表, 用了, 0);
    }
    个数 = 用了;
    返回 铺了;
}

// 计数清 0(数组里的旧值一个都不擦 —— 下一次 `放` 会盖掉它们)。
方法 清掉(整数 表[], 引用 整数 个数)
{
    个数 = 0;
}
