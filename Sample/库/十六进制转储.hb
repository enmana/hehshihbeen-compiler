// ============================================================
// 十六进制转储.hb —— 二进制看三栏(偏移 / 十六进制 / ASCII)(纯 HB,零依赖)
//
// 用法:包含 "../库/十六进制转储.hb";`转储(块, 字节数)` 拼出整段。
//
// 口径(2026-10):
//   · **每行 16 字节**,格式**逐字钉死**:
//     `00000010  48 65 6C 6C 6F 20 57 6F  72 6C 64 21 00 00 00 00  |Hello World!....|`
//   · **最后一行不满 16 个**:十六进制栏用空格补齐(ASCII 栏照样对齐),ASCII 只写真实字节;
//   · **ASCII 栏里不可打印的字节给 `.`**(32~126 之外,含换行 / 制表);
//   · **按字节偏移读堆**(与 `取字` / `存字` 同一把尺子);
//   · **不报错、不停机**:字节数给 0 给空串、负数当 0;O(字节数)。
//
// 英文对照:转储 dump · 转储到控制台 dumpToConsole
//
// 边界(如实登记):
//   · **不做"解析转储"**(那一半归 `编码.hb`)、**颜色 / 分栏宽度可调**;
//   · **`块` 必须是 `申请` 出来的地址**(语言里 `地址` 只能由 `申请` 产生)。
// 提供的函数(2 个):逐个见下面那张公开方法表。
// 复杂度:O(字节数);空间 O(行数 × 80)。
// ============================================================
模块 十六进制转储

// 私有:一个字节从堆里读出来(堆按 4 字节字、按字节偏移读写)
私有 方法 十六进制转储读字节(地址 块, 整数 位置) 返回 整数
{
    整数 字起 = 位置 - 位置 % 4;
    整数 移位量 = (位置 % 4) * 8;
    返回 (取字(块, 字起) >> 移位量) & 255;
}

// 私有:0~15 → 一个大写十六进制字符
私有 方法 十六进制转储位符(整数 位) 返回 字符
{
    如果 (位 < 10)
    {
        返回 48 + 位;
    }
    返回 65 + (位 - 10);
}

// 私有:偏移(整数值)→ 8 位十六进制
私有 方法 十六进制转储偏移文字(整数 值) 返回 字符串
{
    字符 位表[8];
    整数 i = 0;
    当 (i < 8)
    {
        位表[7 - i] = 十六进制转储位符(值 >> (i * 4) & 15);
        i = i + 1;
    }
    字符串 结果 = "";
    i = 0;
    当 (i < 8)
    {
        拼接到(结果, 位表[i]);
        i = i + 1;
    }
    返回 结果;
}

// 私有:一个字节 → 两个十六进制字符
私有 方法 十六进制转储字节文字(整数 值) 返回 字符串
{
    字符串 结果 = "";
    字符 高 = 十六进制转储位符(值 >> 4 & 15);        // `拼接到` 只收字符串或字节变量,调用结果要先落一格
    字符 低 = 十六进制转储位符(值 & 15);
    拼接到(结果, 高);
    拼接到(结果, 低);
    返回 结果;
}

// 私有:ASCII 栏那一个字符(不可打印给 '.')
私有 方法 十六进制转储显示字(整数 值) 返回 字符
{
    如果 (值 >= 32 && 值 <= 126)
    {
        返回 值;
    }
    返回 46;                            // '.'
}

// 按上面的格式拼出整段文本(末尾带一个换行)。
方法 转储(地址 块, 整数 字节数) 返回 字符串
{
    字符串 全文 = "";
    字符 换行符 = 10;
    如果 (字节数 <= 0)
    {
        返回 全文;
    }
    整数 行起 = 0;
    当 (行起 < 字节数)
    {
        拼接到(全文, 十六进制转储偏移文字(行起));
        拼接到(全文, "  ");
        整数 本行 = 字节数 - 行起;
        如果 (本行 > 16)
        {
            本行 = 16;
        }
        整数 k = 0;
        当 (k < 16)
        {
            如果 (k == 8)
            {
                拼接到(全文, ' ');      // 第 8 个后面多一个空格(两条八字,好数)
            }
            如果 (k < 本行)
            {
                整数 值 = 十六进制转储读字节(块, 行起 + k);
                拼接到(全文, 十六进制转储字节文字(值));
            }
            否则
            {
                拼接到(全文, "  ");      // 不满一行:十六进制栏补空格,ASCII 栏才对齐得上
            }
            拼接到(全文, ' ');
            k = k + 1;
        }
        拼接到(全文, ' ');
        拼接到(全文, '|');
        k = 0;
        当 (k < 本行)                  // ASCII 栏单独走一遍(不跨语句攒临时串)
        {
            整数 后一值 = 十六进制转储读字节(块, 行起 + k);
            字符 显 = 46;                 // 不可打印给 '.'
            如果 (后一值 >= 32 && 后一值 <= 126)
            {
                显 = 后一值;
            }
            拼接到(全文, 显);
            k = k + 1;
        }
        拼接到(全文, '|');
        拼接到(全文, 换行符);
        行起 = 行起 + 16;
    }
    返回 全文;
}

// 把 `转储` 的结果整段 `输出` 出去(不额外加换行)。
方法 转储到控制台(地址 块, 整数 字节数) 返回 逻辑
{
    输出(转储(块, 字节数));
    返回 真;
}


