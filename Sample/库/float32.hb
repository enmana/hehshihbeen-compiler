// ============================================================
// float32.hb —— 单精度浮点库(IEEE754 binary32),纯整数 ISA 实现
//
// 走**软件库**路线:一个 float32 值就是**一个 `无符号整数`**(32 位 = 符号 1 + 指数 8 + 尾数 23),
// **不动 ISA、不动语言面**(不加 `浮点` 类型名、不加 `1.5` 字面量)。
// 用法:在文件开头 包含 "../库/float32.hb"
//
// 性能(先看这段再决定怎么写常量):加 / 减 / 乘 / 除 / 比较 / 开方是纯整数例程,与常量怎么写无关;
//   常量要零运行期开销只有两条路 —— ① 直接写位模式(`无符号整数 圆周率 = 0x40490FDB;`,编译期常量装载);
//   ② 用命名常量表(`浮点常量.圆周率`,静态容器字段,读一次一条 LOAD)。
//   `字符串转浮点("3.14")` 是**运行期解析**(几十~几百条指令),别写在热循环里。
//
// 位模式速查(常用值,十六进制)
//   0        0x00000000       -0       0x80000000       1        0x3F800000
//   -1       0xBF800000       0.5      0x3F000000       2        0x40000000
//   3.14     0x4048F5C3       圆周率    0x40490FDB       e        0x402DF854
//   正无穷    0x7F800000       负无穷   0xFF800000       非数      0x7FC00000
//   最大有限  0x7F7FFFFF       最小规格化 0x00800000     最小非零  0x00000001
//
// 接口:逐条见本页末尾那张公开方法表。口径三条:
//   · `浮点32比较` 给 -1(左小) / 0(相等,含 +0 与 -0) / 1(左大) / 2(不可比:有 非数);
//   · 相等 / 小于 / 小于等于 / 大于 / 大于等于 有一边 非数 都给 假(与 IEEE 一致);
//   · `是零`(+0 与 -0 都算)/ `是负`(严格小于 0)/ `有负号`(-0 也算)。
//   `浮点常量` 是静态容器字段:零 / 负零 / 一 / 负一 / 二 / 三 / 半 / 负半 / 十 / 百 / 千 / 万 / 一亿 /
//   圆周率 / 负圆周率 / e / 最大有限 / 最小规格化 / 最小非零 / 正无穷 / 负无穷 / 非数(NaN)。
//
// 口径(2026-10):舍入一律**就近连偶**(IEEE754 默认);保护位 / 舍位 / 粘位一路带着走。
// 特殊值:Inf + (-Inf) = 非数;Inf + 有限 = Inf;+0 + (-0) = +0;-0 + (-0) = -0;x + (-x) = +0;
//   溢出 → ±Inf;落到次正规区按次正规编码(精度自然变差)。`宽整数`(64 位多字)是库内辅助,不暴露。
//
// 提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 依赖:string.hb(用它的 转字符串 / 取子串);浮点库自己**不产生**十进制字面量需求
包含 "string.hb"

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 1、内部:宽整数(64 位 = 高 32 位 + 低 32 位)与基本多字运算
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 64 位宽整数 = 无符号整数 高 + 无符号整数 低(高半区在前)
结构 宽整数
{
    无符号整数 高;
    无符号整数 低;
}

// 32 位无符号数 → 宽整数(高 32 位补 0;不做符号扩展)
方法 宽整数从32(无符号整数 低) 返回 宽整数
{
    宽整数 r;
    r.高 = 0;
    r.低 = 低;
    返回 r;
}

// 宽整数 → 低 32 位(高 32 位直接丢掉,不查越界)
方法 宽整数到32(宽整数 x) 返回 无符号整数
{
    返回 x.低;
}

// 宽整数 → 是不是 0(高 32 位与低 32 位都为 0;无符号口径,无 -0)
方法 宽整数是零(宽整数 x) 返回 逻辑
{
    返回 x.高 == 0 && x.低 == 0;
}

// v 的二进制位数(0 → 0)
方法 整数位长(无符号整数 值) 返回 整数
{
    无符号整数 v = 值;
    整数 n = 0;
    如果 (v >= 0x10000)
    {
        v = v >> 16;
        n = n + 16;
    }
    如果 (v >= 0x100)
    {
        v = v >> 8;
        n = n + 8;
    }
    如果 (v >= 0x10)
    {
        v = v >> 4;
        n = n + 4;
    }
    如果 (v >= 4)
    {
        v = v >> 2;
        n = n + 2;
    }
    如果 (v >= 2)
    {
        v = v >> 1;
        n = n + 1;
    }
    如果 (v >= 1)
    {
        n = n + 1;
    }
    返回 n;
}

// 宽整数 的二进制位数(0 → 0;高 32 位非 0 时接着往高半区数,上限 64)
方法 宽整数位长(宽整数 x) 返回 整数
{
    如果 (x.高 != 0)
    {
        返回 32 + 整数位长(x.高);
    }
    返回 整数位长(x.低);
}

// 宽整数 × m(m ≤ 65535;调用方保证 x×m < 2^64)
方法 宽整数乘半区(宽整数 x, 无符号整数 m) 返回 宽整数
{
    无符号整数 a0 = x.低 & 0xFFFF;
    无符号整数 a1 = (x.低 >> 16) & 0xFFFF;
    无符号整数 a2 = x.高 & 0xFFFF;
    无符号整数 a3 = (x.高 >> 16) & 0xFFFF;
    无符号整数 t = a0 * m;
    无符号整数 w0 = t & 0xFFFF;
    无符号整数 进 = t >> 16;
    t = a1 * m + 进;
    无符号整数 w1 = t & 0xFFFF;
    进 = t >> 16;
    t = a2 * m + 进;
    无符号整数 w2 = t & 0xFFFF;
    进 = t >> 16;
    t = a3 * m + 进;
    无符号整数 w3 = t & 0xFFFF;
    宽整数 结果;
    结果.低 = (w1 << 16) | w0;
    结果.高 = (w3 << 16) | w2;
    返回 结果;
}

// 宽整数 逻辑右移 n 位(0 ≤ n ≤ 63)
方法 宽整数右移(宽整数 x, 整数 n) 返回 宽整数
{
    宽整数 结果;
    如果 (n <= 0)
    {
        结果.高 = x.高;
        结果.低 = x.低;
        返回 结果;
    }
    如果 (n >= 64)
    {
        结果.高 = 0;
        结果.低 = 0;
        返回 结果;
    }
    如果 (n >= 32)
    {
        结果.高 = 0;
        结果.低 = x.高 >> (n - 32);
        返回 结果;
    }
    结果.低 = (x.低 >> n) | (x.高 << (32 - n));
    结果.高 = x.高 >> n;
    返回 结果;
}

// 宽整数 左移 n 位(0 ≤ n ≤ 63;溢出的高位丢掉)
方法 宽整数左移(宽整数 x, 整数 n) 返回 宽整数
{
    宽整数 结果;
    如果 (n <= 0)
    {
        结果.高 = x.高;
        结果.低 = x.低;
        返回 结果;
    }
    如果 (n >= 64)
    {
        结果.高 = 0;
        结果.低 = 0;
        返回 结果;
    }
    如果 (n >= 32)
    {
        结果.高 = x.低 << (n - 32);
        结果.低 = 0;
        返回 结果;
    }
    结果.高 = (x.高 << n) | (x.低 >> (32 - n));
    结果.低 = x.低 << n;
    返回 结果;
}

// x 的"第 n 位以下还有没有 1"(舍入的粘位)
方法 宽整数低位有1(宽整数 x, 整数 n) 返回 逻辑
{
    如果 (n <= 0)
    {
        返回 假;
    }
    如果 (n >= 64)
    {
        返回 !宽整数是零(x);
    }
    如果 (n >= 32)
    {
        如果 (x.低 != 0)
        {
            返回 真;
        }
        返回 (x.高 & ((1 << (n - 32)) - 1)) != 0;
    }
    返回 (x.低 & ((1 << n) - 1)) != 0;
}

// a - b(调用方保证 a ≥ b)
方法 宽整数减(宽整数 a, 宽整数 b) 返回 宽整数
{
    无符号整数 借 = 0;
    如果 (a.低 < b.低)
    {
        借 = 1;
    }
    宽整数 结果;
    结果.低 = a.低 - b.低;
    结果.高 = a.高 - b.高 - 借;
    返回 结果;
}

// x - (小数字 << n)(调用方保证不借位;n ≤ 63)
方法 宽整数减左移(宽整数 x, 无符号整数 小数字, 整数 n) 返回 宽整数
{
    宽整数 底 = 宽整数从32(小数字);
    宽整数 移位量 = 宽整数左移(底, n);
    宽整数 结果 = 宽整数减(x, 移位量);
    返回 结果;
}

// 比较:与 `双精度比较` 一个口径 —— -1 = 左小 / 0 = 相等 / 1 = 左大 / 2 = 不可比。
// 宽整数是精确整数 ⇒ **永不返回 2**(那一档留给"不可比"的将来)。
方法 宽整数比较(宽整数 a, 宽整数 b) 返回 整数
{
    如果 (a.高 > b.高)
    {
        返回 1;
    }
    如果 (a.高 < b.高)
    {
        返回 -1;
    }
    如果 (a.低 > b.低)
    {
        返回 1;
    }
    如果 (a.低 < b.低)
    {
        返回 -1;
    }
    返回 0;
}

// 整数除法的两个出口:商与余数(都是宽整数)
结构 除法结果
{
    宽整数 商;
    宽整数 余;
}

// 整数开方的结果 —— 除了根还要**余数**,开方要拿它当"粘位"
// (余 ≠ 0 ⟺ 被开数不是完全平方 ⟺ 真值在 根 和 根+1 之间,舍入时底下还有东西)
结构 开方结果
{
    无符号整数 根;
    无符号整数 余;
}

// 宽整数 长除(移位减法,64 轮;只在乘除/解析里用,不进加法热路径)
方法 宽整数除(宽整数 被除, 宽整数 除数) 返回 除法结果
{
    除法结果 结果;
    结果.商 = 宽整数从32(0);
    结果.余 = 宽整数从32(0);
    整数 i = 63;
    当 (i >= 0)
    {
        整数 位 = 0;
        如果 (i >= 32)
        {
            位 = (被除.高 >> (i - 32)) & 1;
        }
        否则
        {
            位 = (被除.低 >> i) & 1;
        }
        宽整数 移位量 = 宽整数左移(结果.余, 1);
        结果.余 = 移位量;
        结果.余.低 = 结果.余.低 | 位;
        整数 比 = 宽整数比较(结果.余, 除数);
        如果 (比 != -1)
        {
            宽整数 新余 = 宽整数减(结果.余, 除数);
            结果.余 = 新余;
            如果 (i >= 32)
            {
                结果.商.高 = 结果.商.高 | (1 << (i - 32));
            }
            否则
            {
                结果.商.低 = 结果.商.低 | (1 << i);
            }
        }
        i = i - 1;
    }
    返回 结果;
}

// 宽整数 十进制文字(精确;x < 2^63 时最多 19 位数字)
方法 宽整数转字符串(宽整数 x) 返回 字符串
{
    如果 (宽整数是零(x))
    {
        返回 "0";
    }
    无符号整数 l0 = x.低 & 0xFFFF;
    无符号整数 l1 = (x.低 >> 16) & 0xFFFF;
    无符号整数 l2 = x.高 & 0xFFFF;
    无符号整数 l3 = (x.高 >> 16) & 0xFFFF;
    字符 倒[20];
    整数 个 = 0;
    当 (l0 != 0 || l1 != 0 || l2 != 0 || l3 != 0)
    {
        无符号整数 t = l3;
        无符号整数 q3 = t / 10;
        无符号整数 余 = t % 10;
        t = (余 << 16) | l2;
        无符号整数 q2 = t / 10;
        余 = t % 10;
        t = (余 << 16) | l1;
        无符号整数 q1 = t / 10;
        余 = t % 10;
        t = (余 << 16) | l0;
        无符号整数 q0 = t / 10;
        余 = t % 10;
        l3 = q3;
        l2 = q2;
        l1 = q1;
        l0 = q0;
        倒[个] = 余 + '0';
        个 = 个 + 1;
    }
    字符串 结果 = "";
    整数 i = 个 - 1;
    当 (i >= 0)
    {
        拼接到(结果, 倒[i]);
        i = i - 1;
    }
    返回 结果;
}

// 无符号整数的十进制文字
方法 浮点32u数转字符串(无符号整数 v) 返回 字符串
{
    如果 (v == 0)
    {
        返回 "0";
    }
    字符 倒[12];
    整数 个 = 0;
    无符号整数 剩 = v;
    当 (剩 > 0)
    {
        倒[个] = (剩 % 10) + '0';
        个 = 个 + 1;
        剩 = 剩 / 10;
    }
    字符串 结果 = "";
    整数 i = 个 - 1;
    当 (i >= 0)
    {
        拼接到(结果, 倒[i]);
        i = i - 1;
    }
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 2、float32:拆 / 合 / 判断 / 取负
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 单精度位模式 → 符号位(0 = 正 / 1 = 负;-0 也给 1)
方法 浮点32取符号(无符号整数 位) 返回 整数
{
    返回 位 >> 31;
}
// 单精度位模式 → 指数域(第 30~23 位,0~255 偏移码;0 与 255 是特殊档)
方法 浮点32取指数域(无符号整数 位) 返回 整数
{
    返回 (位 >> 23) & 0xFF;
}
// 单精度位模式 → 尾数域(低 23 位原样截取,不含隐含位 1)
方法 浮点32取尾数域(无符号整数 位) 返回 整数
{
    返回 位 & 0x7FFFFF;
}

// 符号位 / 指数域 / 尾数域 三段 → 单精度位模式(各段按掩码取低位,超出位丢掉)
方法 浮点32组装(整数 符号, 整数 指数域, 整数 尾数域) 返回 无符号整数
{
    返回 (符号 & 1) << 31 | (指数域 & 0xFF) << 23 | (尾数域 & 0x7FFFFF);
}

// 0 与 -0 都算"是零"
方法 浮点32是零(无符号整数 位) 返回 逻辑
{
    返回 (位 & 0x7FFFFFFF) == 0;
}

// 符号位是 1(-0 也算有负号)
方法 浮点32有负号(无符号整数 位) 返回 逻辑
{
    返回 (位 >> 31) == 1;
}

// 严格小于 0(-0 **不算**小于 0)
方法 浮点32是负(无符号整数 位) 返回 逻辑
{
    返回 (位 >> 31) == 1 && (位 & 0x7FFFFFFF) != 0;
}

// 单精度位模式 → 是不是无穷(指数域 255 且尾数域全 0;±无穷 都算,非数 不算)
方法 浮点32是无穷(无符号整数 位) 返回 逻辑
{
    返回 (位 & 0x7FFFFFFF) == 0x7F800000;
}

// 单精度位模式 → 是不是非数(指数域 255 且尾数域非 0;±非数 都算,无穷 不算)
方法 浮点32是非数(无符号整数 位) 返回 逻辑
{
    无符号整数 绝 = 位 & 0x7FFFFFFF;
    返回 绝 > 0x7F800000;
}

// 规格化数(指数域 1~254);次正规/零/无穷/非数 都给 假
方法 浮点32是规格化(无符号整数 位) 返回 逻辑
{
    整数 e = (位 >> 23) & 0xFF;
    返回 e >= 1 && e <= 254;
}

// 有效指数 E 与 24 位尾数 M(含隐含位 1):值 = M × 2^E(零/无穷/非数 不在这个口径里)
方法 浮点32取指数(无符号整数 位) 返回 整数
{
    整数 e = (位 >> 23) & 0xFF;
    如果 (e == 0)
    {
        返回 -149;
    }
    返回 e - 150;
}

// 单精度位模式 → 24 位尾数 M(指数域非 0 补隐含位 1;指数域 0 给尾数域原值)
方法 浮点32取尾数(无符号整数 位) 返回 无符号整数
{
    整数 e = (位 >> 23) & 0xFF;
    无符号整数 m = 位 & 0x7FFFFF;
    如果 (e == 0)
    {
        返回 m;
    }
    返回 m | 0x800000;
}

// 单精度位模式 → 取负(只翻符号位;+0 与 -0 互换,非数 也照翻)
方法 浮点32取负(无符号整数 位) 返回 无符号整数
{
    返回 位 ^ 0x80000000;
}
// 单精度位模式 → 绝对值(只清符号位;-0 → +0,非数 也照清)
方法 浮点32绝对值(无符号整数 位) 返回 无符号整数
{
    返回 位 & 0x7FFFFFFF;
}

// 十六进制写法(核对位模式用;不依赖别的库)
方法 浮点32转十六进制(无符号整数 位) 返回 字符串
{
    字符 表[16];
    表[0] = '0';
    表[1] = '1';
    表[2] = '2';
    表[3] = '3';
    表[4] = '4';
    表[5] = '5';
    表[6] = '6';
    表[7] = '7';
    表[8] = '8';
    表[9] = '9';
    表[10] = 'A';
    表[11] = 'B';
    表[12] = 'C';
    表[13] = 'D';
    表[14] = 'E';
    表[15] = 'F';
    字符串 结果 = "0x";
    整数 i = 7;
    当 (i >= 0)
    {
        整数 半 = (位 >> (i * 4)) & 0xF;
        拼接到(结果, 表[半]);
        i = i - 1;
    }
    返回 结果;
}

// 取宽整数的第 i 位(0 = 最低位);i ≥ 64 给 0
方法 宽整数取位(宽整数 x, 整数 i) 返回 整数
{
    如果 (i < 0 || i >= 64)
    {
        返回 0;
    }
    如果 (i >= 32)
    {
        返回 (x.高 >> (i - 32)) & 1;
    }
    返回 (x.低 >> i) & 1;
}

// 去掉字符串末尾的 '0'(小数位收尾用;不处理 '.' 本身)
方法 浮点32去尾零(字符串 s) 返回 字符串
{
    整数 n = s.长度();
    当 (n > 0)
    {
        如果 (s[n - 1] == '0')
        {
            n = n - 1;
        }
        否则
        {
            跳出;
        }
    }
    字符串 结果 = 取子串(s, 0, n);
    返回 结果;
}

// 把"7 位有效数字的整数 N + 十进指数 d"(值 ≈ N × 10^(d-6))排成定点写法
//   例:N=3141593, d=0 → "3.141593";N=1000000, d=8 → "100000000";N=1000000, d=-6 → "0.000001"
方法 浮点32定点串转字符串(无符号整数 N, 整数 d) 返回 字符串
{
    字符串 数 = 浮点32u数转字符串(N);
    字符串 结果 = "";
    如果 (d >= 6)
    {
        拼接到(结果, 数);
        整数 补 = d - 6;
        当 (补 > 0)
        {
            拼接到(结果, '0');
            补 = 补 - 1;
        }
        返回 结果;
    }
    如果 (d >= 0)
    {
        字符串 整段 = 取子串(数, 0, d + 1);
        拼接到(结果, 整段);
        字符串 小段 = 取子串(数, d + 1, 7 - d - 1);
        小段 = 浮点32去尾零(小段);
        如果 (小段.长度() > 0)
        {
            拼接到(结果, '.');
            拼接到(结果, 小段);
        }
        返回 结果;
    }
    拼接到(结果, "0.");
    整数 零数 = 0 - d - 1;
    当 (零数 > 0)
    {
        拼接到(结果, '0');
        零数 = 零数 - 1;
    }
    字符串 尾段 = 浮点32去尾零(数);
    拼接到(结果, 尾段);
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 二点五、打印:位模式 → 十进制文字
//
// 口径(文档里的一串承诺):
//   · **7 位有效数字**,**就近连偶**(与加减同一套舍入口径);小数末尾的 0 去掉(0.5 打成 "0.5")
//   · 特殊值:`0` / `-0` / `Inf` / `-Inf` / `非数`(NaN)
//   · 十进制区间:|值| 约在 `1e-10 ~ 8.4e6`(二进制指数 -33~22)用定点;`2^23 ~ 2^63` 的**整数值**打精确整数;
//     其余(如 `1e-30`、`1e20`)打**精确的二进制写法** `尾数*2^指数`(不猜十进制,也不糊弄)
//   · 三段拆成三个小函数:一个函数塞不下 96 字节的帧(试过,编译器会直接报帧超限)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 单精度位模式 → 十进制文字(7 位有效数字就近连偶,末尾 0 去掉;Inf / NaN 照打)
方法 浮点32转字符串(无符号整数 位) 返回 字符串
{
    整数 号 = 位 >> 31;
    整数 域 = (位 >> 23) & 0xFF;
    无符号整数 段 = 位 & 0x7FFFFF;
    如果 (域 == 255)
    {
        如果 (段 != 0)
        {
            返回 "NaN";
        }
        如果 (号 == 1)
        {
            返回 "-Inf";
        }
        返回 "Inf";
    }
    如果 (域 == 0 && 段 == 0)
    {
        如果 (号 == 1)
        {
            返回 "-0";
        }
        返回 "0";
    }
    无符号整数 尾 = 段;
    整数 指 = 0 - 149;
    如果 (域 != 0)
    {
        尾 = 段 | 0x800000;
        指 = 域 - 150;
    }
    整数 最高 = 整数位长(尾) - 1;
    整数 二进 = 最高 + 指;
    字符串 数值串 = "";
    如果 (指 >= 0 && 指 <= 39)
    {
        数值串 = 浮点32整值转字符串(尾, 指);
    }
    否则
    {
        如果 (二进 >= 0 - 33 && 二进 <= 22)
        {
            数值串 = 浮点32定点转字符串(尾, 指, 二进);
        }
        否则
        {
            数值串 = 浮点32二进制转字符串(尾, 指);
        }
    }
    字符串 结果 = "";
    如果 (号 == 1)
    {
        拼接到(结果, '-');
    }
    拼接到(结果, 数值串);
    返回 结果;
}

// ① 整数值:值 = 尾 × 2^指(指 0~39 ⇒ 尾<<指 < 2^63),打精确十进制整数
方法 浮点32整值转字符串(无符号整数 尾, 整数 指) 返回 字符串
{
    宽整数 底 = 宽整数从32(尾);
    宽整数 大 = 宽整数左移(底, 指);
    字符串 结果 = 宽整数转字符串(大);
    返回 结果;
}

// ② 定点区间:算出 7 位有效数字 N 与十进指数 d(值 ≈ N × 10^(d-6)),再排版
方法 浮点32定点转字符串(无符号整数 尾, 整数 指, 整数 二进) 返回 字符串
{
    整数 积 = 二进 * 30103;                 // log10(2) ≈ 0.30103
    整数 d = 积 / 100000;
    如果 (积 < 0 && d * 100000 != 积)
    {
        d = d - 1;                          // 负数向下取整
    }
    整数 k = 6 - d;
    宽整数 P = 宽整数从32(尾);
    整数 j = 0;
    当 (j < k)
    {
        宽整数 新P = 宽整数乘半区(P, 5);            // ×5 做 k 次 = ×5^k
        P = 新P;
        j = j + 1;
    }
    整数 移位量 = 0 - (指 + k);                 // 值 × 10^k = P × 2^(指+k)
    无符号整数 N = 0;
    如果 (移位量 <= 0)
    {
        宽整数 放大 = 宽整数左移(P, 0 - 移位量);
        N = 宽整数到32(放大);
    }
    否则
    {
        宽整数 商 = 宽整数右移(P, 移位量);
        N = 宽整数到32(商);
        整数 保护 = 宽整数取位(P, 移位量 - 1);
        整数 舍 = 0;
        如果 (移位量 >= 2)
        {
            舍 = 宽整数取位(P, 移位量 - 2);
        }
        整数 粘位 = 0;
        如果 (移位量 >= 3)
        {
            如果 (宽整数低位有1(P, 移位量 - 2))
            {
                粘位 = 1;
            }
        }
        如果 (保护 == 1 && (舍 == 1 || 粘位 == 1 || (N & 1) == 1))
        {
            N = N + 1;
        }
    }
    当 (N < 1000000)
    {
        // 估计误差 ±1:把 N 拉回 7 位
        N = N * 10;
        d = d - 1;
    }
    当 (N >= 10000000)
    {
        N = N / 10;
        d = d + 1;
    }
    字符串 结果 = 浮点32定点串转字符串(N, d);
    返回 结果;
}

// ③ 其余:精确的二进制写法 `尾数*2^指数`
方法 浮点32二进制转字符串(无符号整数 尾, 整数 指) 返回 字符串
{
    字符串 结果 = 浮点32u数转字符串(尾);
    拼接到(结果, "*2^");
    字符串 指串 = 转字符串(指);
    拼接到(结果, 指串);
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 二点七、解析:十进制文字 → 位模式
//
// 口径:
//   · 收 `[+-]数字[.数字][eE[+-]数字]`;首尾空白自动去掉;空串 / 看不懂 → **NaN**
//   · 有效数字最多 9 位(多出来的位只用来定十进指数,不参与尾数)
//   · 十进指数 |k| ≤ 15 **一步算准**(商带够位数、余数进粘位 ⇒ 就近连偶);更大逐次 ÷5(可能有 1 个最小单位的误差)
//   · 溢出 → ±Inf;小到 0 → ±0
//   · **性能提醒**:这是运行期解析(几十~几百条指令)。热循环里别调它 ——
//     常量请写位模式(`0x40490FDB`)或用 `浮点常量.圆周率`(零开销)
//   · 调试留痕:局部变量名一律带 `解` 前缀 —— 单字母名(`m` 这种)与同一函数里叫 `M` 的参数
//     会**静默串味**(实测:同一个函数里 `整数 m = 62 - 宽整数位长(M)` 读出来是 0,换个名字就好),
//     **这条已修掉**(声明初值不许看见自己),局部名带前缀这条纪律继续留着
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 尾数缩放的结果:值 + 移位量 + 粘位(粘位非 0 = 右移时丢过 1)
结构 缩放结果
{
    宽整数 值;
    整数 移位量;
    整数 粘位;
}

// 十进制文字 → 单精度位模式(收 ±数字[.数字][eE±数字];看不懂 / 空串 → 非数,溢出 → ±无穷)
方法 字符串转浮点(字符串 文本) 返回 无符号整数
{
    字符串 解净 = 去空白(文本);
    整数 解长 = 解净.长度();
    整数 解位 = 0;
    整数 解号 = 0;
    如果 (解位 < 解长 && (解净[解位] == '+' || 解净[解位] == '-'))
    {
        如果 (解净[解位] == '-')
        {
            解号 = 1;
        }
        解位 = 解位 + 1;
    }
    无符号整数 解有效 = 0;
    整数 解位数 = 0;
    整数 解十次 = 0;
    逻辑 解见点 = 假;
    逻辑 解有数 = 假;
    当 (解位 < 解长)
    {
        文字 解字 = 解净[解位];
        如果 (解字 == '.')
        {
            如果 (解见点)
            {
                返回 0x7FC00000;
            }
            解见点 = 真;
            解位 = 解位 + 1;
            继续;
        }
        如果 (解字 == 'e' || 解字 == 'E')
        {
            跳出;
        }
        整数 解码 = 解字;
        如果 (解码 < 48 || 解码 > 57)
        {
            返回 0x7FC00000;
        }
        解有数 = 真;
        如果 (解位数 < 9)
        {
            解有效 = 解有效 * 10 + (解码 - 48);
            解位数 = 解位数 + 1;
            如果 (解见点)
            {
                解十次 = 解十次 - 1;
            }
        }
        否则
        {
            如果 (!解见点)
            {
                解十次 = 解十次 + 1;
            }
        }
        解位 = 解位 + 1;
    }
    如果 (!解有数)
    {
        返回 0x7FC00000;
    }
    如果 (解位 < 解长)
    {
        整数 解指号 = 0;
        解位 = 解位 + 1;
        如果 (解位 < 解长 && (解净[解位] == '+' || 解净[解位] == '-'))
        {
            如果 (解净[解位] == '-')
            {
                解指号 = 1;
            }
            解位 = 解位 + 1;
        }
        逻辑 解指有 = 假;
        整数 解指数 = 0;
        当 (解位 < 解长)
        {
            文字 解字二 = 解净[解位];
            整数 解码二 = 解字二;
            如果 (解码二 < 48 || 解码二 > 57)
            {
                返回 0x7FC00000;
            }
            解指有 = 真;
            如果 (解指数 < 100000)
            {
                解指数 = 解指数 * 10 + (解码二 - 48);
            }
            解位 = 解位 + 1;
        }
        如果 (!解指有)
        {
            返回 0x7FC00000;
        }
        如果 (解指号 == 1)
        {
            解十次 = 解十次 - 解指数;
        }
        否则
        {
            解十次 = 解十次 + 解指数;
        }
    }
    返回 浮点32从十进制(解有效, 解十次, 解号);
}

// 值 = M × 10^k(k ≥ 0):×5 做 k 次;超过 31 位就右移一位(丢的位记进粘位)
方法 宽整数乘十的幂(宽整数 乘数, 整数 乘次) 返回 缩放结果
{
    缩放结果 乘积;
    乘积.值 = 乘数;
    乘积.移位量 = 0;
    乘积.粘位 = 0;
    整数 乘计 = 0;
    当 (乘计 < 乘次)
    {
        乘积.值 = 宽整数乘半区(乘积.值, 5);
        当 (宽整数位长(乘积.值) > 31)
        {
            如果 (宽整数取位(乘积.值, 0) == 1)
            {
                乘积.粘位 = 1;
            }
            乘积.值 = 宽整数右移(乘积.值, 1);
            乘积.移位量 = 乘积.移位量 + 1;
        }
        乘计 = 乘计 + 1;
    }
    乘积.移位量 = 乘积.移位量 + 乘次;
    返回 乘积;
}

// 值 = M ÷ 10^k(k ≥ 1):先把 M 补到 ≥ 29 位再 ÷5,丢的位进粘位(多步 ⇒ 可能有 1 个最小单位误差)
方法 宽整数除十的幂(宽整数 除数, 整数 除次) 返回 缩放结果
{
    缩放结果 除果包;
    除果包.值 = 除数;
    除果包.移位量 = 0;
    除果包.粘位 = 0;
    宽整数 除五 = 宽整数从32(1);
    整数 除计 = 0;
    如果 (除次 <= 15)
    {
        整数 补位 = 62 - 宽整数位长(除果包.值);
        如果 (补位 < 0)
        {
            补位 = 0;
        }
        宽整数 除分 = 宽整数左移(除果包.值, 补位);
        当 (除计 < 除次)
        {
            除五 = 宽整数乘半区(除五, 5);
            除计 = 除计 + 1;
        }
        除法结果 除单 = 宽整数除(除分, 除五);
        除果包.值 = 除单.商;
        除果包.移位量 = 0 - 除次 - 补位;
        如果 (!宽整数是零(除单.余))
        {
            除果包.粘位 = 1;
        }
        返回 除果包;
    }
    除五 = 宽整数从32(5);
    当 (除计 < 除次)
    {
        当 (宽整数位长(除果包.值) < 29)
        {
            除果包.值 = 宽整数左移(除果包.值, 1);
            除果包.移位量 = 除果包.移位量 - 1;
        }
        除法结果 除单二 = 宽整数除(除果包.值, 除五);
        除果包.值 = 除单二.商;
        除果包.移位量 = 除果包.移位量 - 1;
        如果 (!宽整数是零(除单二.余))
        {
            除果包.粘位 = 1;
        }
        除计 = 除计 + 1;
    }
    返回 除果包;
}

// 值 = 有效 × 10^十次(有效 ≤ 9 位十进制)
方法 浮点32从十进制(无符号整数 有效数字, 整数 十进指数, 整数 符号) 返回 无符号整数
{
    无符号整数 转有效 = 有效数字;
    整数 转十次 = 十进指数;
    如果 (转有效 == 0)
    {
        如果 (符号 == 1)
        {
            返回 0x80000000;
        }
        返回 0;
    }
    当 (转有效 % 10 == 0)
    {
        转有效 = 转有效 / 10;
        转十次 = 转十次 + 1;
    }
    宽整数 转双 = 宽整数从32(转有效);
    缩放结果 转包;
    如果 (转十次 >= 0)
    {
        转包 = 宽整数乘十的幂(转双, 转十次);
    }
    否则
    {
        转包 = 宽整数除十的幂(转双, 0 - 转十次);
    }
    返回 浮点32组装位(转包.值, 转包.移位量, 转包.粘位, 符号);
}

// 把 `M × 2^移位量` 收成位模式:收 ≤ 31 位 → 归一到"最高位在第 26 位" → 交 收尾(同一套舍入口径)
方法 浮点32组装位(宽整数 尾数, 整数 移位量, 整数 粘位, 整数 符号) 返回 无符号整数
{
    如果 (宽整数是零(尾数))
    {
        如果 (符号 == 1)
        {
            返回 0x80000000;
        }
        返回 0;
    }
    当 (宽整数位长(尾数) > 31)
    {
        如果 (宽整数取位(尾数, 0) == 1)
        {
            粘位 = 1;
        }
        尾数 = 宽整数右移(尾数, 1);
        移位量 = 移位量 + 1;
    }
    整数 包高 = 宽整数位长(尾数) - 1;
    整数 包需 = 包高 - 26;
    整数 包和 = 0;
    整数 包基 = 移位量 + 包需 - 3;                  // 和 = 尾数 << 3 ⇒ 指数要减 3
    如果 (包需 <= 0)
    {
        尾数 = 宽整数左移(尾数, 0 - 包需);
        包和 = 宽整数到32(尾数) << 3;
    }
    否则
    {
        如果 (包需 >= 32)
        {
            包和 = 0;
            粘位 = 1;
        }
        否则
        {
            宽整数 包缩 = 宽整数右移(尾数, 包需);
            包和 = 宽整数到32(包缩) << 3;
            包和 = 包和 | (宽整数取位(尾数, 包需 - 1) << 2);
            如果 (包需 >= 2)
            {
                包和 = 包和 | (宽整数取位(尾数, 包需 - 2) << 1);
            }
            如果 (包需 >= 3)
            {
                包和 = 包和 | 宽整数取位(尾数, 包需 - 3);
                如果 (宽整数低位有1(尾数, 包需 - 3))
                {
                    粘位 = 1;
                }
            }
        }
    }
    返回 浮点32收尾(包和, 包基, 粘位, 符号);
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 二点八、乘除
//
// 都走"有效尾数算准 + 交给 打包 归一/舍入"这条路(与解析共用同一套舍入口径):
//   乘:尾数 24×24 → 48 位积(宽整数乘24位),指数相加
//   除:尾数左移 28 位再长除,指数相减,余数进粘位 ⇒ 就近连偶一次到位
// 特殊值:Inf×0 = 非数、Inf/Inf = 非数、0/0 = 非数、x/0 = ±Inf、有限/Inf = ±0,符号按 IEEE 异或
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 按号给无穷的位模式:号 = 1 给 0xFF800000,其余给 0x7F800000
方法 浮点32无穷(整数 号) 返回 无符号整数
{
    如果 (号 == 1)
    {
        返回 0xFF800000;
    }
    返回 0x7F800000;
}

// 零的位模式:号 = 1 给 -0(0x80000000),其余给 +0(0x00000000)
方法 浮点32零(整数 号) 返回 无符号整数
{
    如果 (号 == 1)
    {
        返回 0x80000000;
    }
    返回 0;
}

// 两个 **≤ 2^24** 的宽整数相乘(48 位积;尾数 24 位正好够用)
//   24 位 ⇒ 低半 16 位、高半 ≤ 8 位,四段积相加不会溢出 32 位(每段最多 2^24 + 2^24 + 2^16 < 2^32)
方法 宽整数乘24位(宽整数 左, 宽整数 右) 返回 宽整数
{
    无符号整数 a0 = 左.低 & 0xFFFF;
    无符号整数 a1 = 左.低 >> 16;
    无符号整数 b0 = 右.低 & 0xFFFF;
    无符号整数 b1 = 右.低 >> 16;
    无符号整数 积0 = a0 * b0;
    无符号整数 进 = 积0 >> 16;
    无符号整数 积1 = a1 * b0 + a0 * b1 + 进;
    无符号整数 乘积高 = a1 * b1 + (积1 >> 16);
    宽整数 结果;
    结果.低 = ((积1 & 0xFFFF) << 16) | (积0 & 0xFFFF);
    结果.高 = 乘积高 & 0xFFFF;
    返回 结果;
}

// 乘法的特殊值判定:返回 0xFFFFFFFF = "不是特殊值,继续算"
方法 浮点32乘特殊值(无符号整数 A, 无符号整数 B) 返回 无符号整数
{
    整数 域A = (A >> 23) & 0xFF;
    整数 域B = (B >> 23) & 0xFF;
    无符号整数 段A = A & 0x7FFFFF;
    无符号整数 段B = B & 0x7FFFFF;
    整数 号 = (A >> 31) ^ (B >> 31);
    如果 ((域A == 255 && 段A != 0) || (域B == 255 && 段B != 0))
    {
        返回 0x7FC00000;
    }
    如果 ((域A == 255 && 段A == 0) || (域B == 255 && 段B == 0))
    {
        如果 ((域A == 0 && 段A == 0) || (域B == 0 && 段B == 0))
        {
            返回 0x7FC00000;                    // Inf × 0
        }
        返回 浮点32无穷(号);
    }
    如果 ((域A == 0 && 段A == 0) || (域B == 0 && 段B == 0))
    {
        返回 浮点32零(号);
    }
    返回 0xFFFFFFFF;
}

// 乘法:尾数 24×24 位积、指数相加 → 规格化,舍入到最近偶数;无穷 × 0 = 非数
方法 浮点32乘(无符号整数 A, 无符号整数 B) 返回 无符号整数
{
    无符号整数 乘特 = 浮点32乘特殊值(A, B);
    如果 (乘特 != 0xFFFFFFFF)
    {
        返回 乘特;
    }
    整数 乘号 = (A >> 31) ^ (B >> 31);
    宽整数 左尾数 = 宽整数从32(浮点32取尾数(A));
    宽整数 右尾数 = 宽整数从32(浮点32取尾数(B));
    宽整数 乘积 = 宽整数乘24位(左尾数, 右尾数);
    返回 浮点32组装位(乘积, 浮点32取指数(A) + 浮点32取指数(B), 0, 乘号);
}

// 除法的特殊值判定:返回 0xFFFFFFFF = "不是特殊值,继续算"
方法 浮点32除特殊值(无符号整数 A, 无符号整数 B) 返回 无符号整数
{
    整数 域A = (A >> 23) & 0xFF;
    整数 域B = (B >> 23) & 0xFF;
    无符号整数 段A = A & 0x7FFFFF;
    无符号整数 段B = B & 0x7FFFFF;
    整数 号 = (A >> 31) ^ (B >> 31);
    如果 ((域A == 255 && 段A != 0) || (域B == 255 && 段B != 0))
    {
        返回 0x7FC00000;
    }
    如果 (域A == 255 && 段A == 0)
    {
        如果 (域B == 255 && 段B == 0)
        {
            返回 0x7FC00000;                    // Inf / Inf
        }
        返回 浮点32无穷(号);
    }
    如果 (域B == 255 && 段B == 0)
    {
        返回 浮点32零(号);                          // 有限 / Inf = ±0
    }
    如果 (域B == 0 && 段B == 0)
    {
        如果 (域A == 0 && 段A == 0)
        {
            返回 0x7FC00000;                    // 0 / 0
        }
        返回 浮点32无穷(号);                        // x / 0
    }
    如果 (域A == 0 && 段A == 0)
    {
        返回 浮点32零(号);
    }
    返回 0xFFFFFFFF;
}

// 除法:尾数左移 28 位长除、指数相减,余数进粘位,舍入到最近偶数;除数为 0 → ±无穷,0 / 0 → 非数
方法 浮点32除(无符号整数 A, 无符号整数 B) 返回 无符号整数
{
    无符号整数 除特 = 浮点32除特殊值(A, B);
    如果 (除特 != 0xFFFFFFFF)
    {
        返回 除特;
    }
    整数 除号 = (A >> 31) ^ (B >> 31);
    宽整数 左尾数 = 宽整数从32(浮点32取尾数(A));
    宽整数 右尾数 = 宽整数从32(浮点32取尾数(B));
    宽整数 除分 = 宽整数左移(左尾数, 28);               // 商带够位数:2^24 << 28 < 2^52
    除法结果 除果 = 宽整数除(除分, 右尾数);
    整数 除粘 = 0;
    如果 (!宽整数是零(除果.余))
    {
        除粘 = 1;
    }
    返回 浮点32组装位(除果.商, 浮点32取指数(A) - 浮点32取指数(B) - 28, 除粘, 除号);
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 二点九、开方
//
// 思路:把指数调成偶数,尾数左移 26 位,用**整数开方**(逐位试根,26 轮、不用除法)拿到根,
// 再交给 `浮点32组装位` 归一/舍入。特殊值:负数(除 -0) → 非数、±0 → ±0、+Inf → +Inf、非数 → 非数。
// 精度(修过一版):
//   · **次正规输入先归一**(见 浮点32开方 里那句注释)—— 不归一的话尾数只有十几位,根的分辨率不够,
//     实测最小非零 `sqrt(1.4e-45)` 差到 471 个最小单位;
//   · **粘位由整数开方的余数给**(余 ≠ 0 ⇒ 底下还有东西)—— 以前拿"被开数的低两位"当粘位,
//     而那两位恒为 0(被开数 = 尾数 << 26),等于**永远不标记余量**,正常值会偶尔差 1 个最小单位
//     (实测 `sqrt(1.5)` / `sqrt(0.001)` / `sqrt(10.24)` 都差 −1)。
//   修完:45 例(含次正规 / 完全平方 / 边界)对拍 .NET 逐位一致;开方还是这套库里最贵的一步。
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 整数开方(逐位试根 26 轮);给根与余数,余 ≠ 0 说明开不尽
方法 宽整数整开方(宽整数 被开) 返回 开方结果
{
    宽整数 余 = 宽整数从32(0);
    无符号整数 根 = 0;
    整数 位 = 25;
    当 (位 >= 0)
    {
        宽整数 余二 = 宽整数左移(余, 2);
        整数 两位 = 宽整数取位(被开, 2 * 位 + 1) * 2 + 宽整数取位(被开, 2 * 位);
        余二.低 = 余二.低 | 两位;
        无符号整数 试 = (根 << 2) | 1;
        宽整数 试双 = 宽整数从32(试);
        如果 (宽整数比较(余二, 试双) != -1)
        {
            余 = 宽整数减(余二, 试双);
            根 = (根 << 1) | 1;
        }
        否则
        {
            余 = 余二;
            根 = 根 << 1;
        }
        位 = 位 - 1;
    }
    开方结果 结果;
    结果.根 = 根;
    结果.余 = 宽整数到32(余);            // 余 < 2·根+1 ≤ 2^27,装得下 32 位
    返回 结果;
}

// 开方:次正规先归一,尾数左移 26 位整数开方,余数进粘位;负数(除 -0)→ 非数,±0 与 +无穷 原样
方法 浮点32开方(无符号整数 A) 返回 无符号整数
{
    整数 域 = (A >> 23) & 0xFF;
    无符号整数 段 = A & 0x7FFFFF;
    如果 (域 == 255 && 段 != 0)
    {
        返回 0x7FC00000;                        // 非数
    }
    整数 开号 = A >> 31;
    如果 (开号 == 1 && (域 != 0 || 段 != 0))
    {
        返回 0x7FC00000;                        // 负数开方 → 非数(-0 除外)
    }
    如果 (域 == 255)
    {
        返回 A;                                 // +Inf
    }
    如果 (域 == 0 && 段 == 0)
    {
        返回 A;                                 // ±0
    }
    整数 开指 = 域 - 150;
    无符号整数 开尾 = 段 | 0x800000;
    如果 (域 == 0)
    {
        // **次正规先归一** —— 把 段 的最高位挪到第 23 位(与正规数的尾数同一量级),
        // 指数相应往下走。不归一的话 `开尾 << 26` 很小,整数开方拿到的根只有十几位,
        // 舍入信息不够用(实测最小非零 `sqrt(1.4e-45)` 差 471 个最小单位)。
        整数 开段长 = 整数位长(段);
        开尾 = 段 << (24 - 开段长);
        开指 = 0 - 149 - (24 - 开段长);
    }
    如果 ((开指 & 1) == 1)
    {
        // 指数要偶数:尾数补一位顶上
        开尾 = 开尾 << 1;
        开指 = 开指 - 1;
    }
    宽整数 开底 = 宽整数从32(开尾);
    宽整数 被开 = 宽整数左移(开底, 26);               // sqrt(尾) × 2^13 = sqrt(尾 << 26)(尾 < 2^25 ⇒ N < 2^51)
    开方结果 开果 = 宽整数整开方(被开);
    整数 开粘 = 0;
    如果 (开果.余 != 0)
    {
        开粘 = 1;                               // A10:余 ≠ 0 ⇒ 不是完全平方 ⇒ 底下还有东西,舍入要看它
    }
    宽整数 根双 = 宽整数从32(开果.根);
    返回 浮点32组装位(根双, 开指 / 2 - 13, 开粘, 0);
}

// 3、命名常量表(零运行期开销:静态容器的一个字段就是数据段里的一个字)
//     用法:`无符号整数 圆周率 = 浮点常量.圆周率;`
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
静态 方法 浮点常量()
{
    无符号整数 零 = 0x00000000;
    无符号整数 负零 = 0x80000000;
    无符号整数 一 = 0x3F800000;
    无符号整数 负一 = 0xBF800000;
    无符号整数 二 = 0x40000000;
    无符号整数 三 = 0x40400000;
    无符号整数 半 = 0x3F000000;
    无符号整数 负半 = 0xBF000000;
    无符号整数 十 = 0x41200000;
    无符号整数 百 = 0x42C80000;
    无符号整数 千 = 0x447A0000;
    无符号整数 万 = 0x461C4000;
    无符号整数 一亿 = 0x4CBEBC20;
    无符号整数 圆周率 = 0x40490FDB;
    无符号整数 负圆周率 = 0xC0490FDB;
    无符号整数 e = 0x402DF854;
    无符号整数 最大有限 = 0x7F7FFFFF;
    无符号整数 最小规格化 = 0x00800000;
    无符号整数 最小非零 = 0x00000001;
    无符号整数 正无穷 = 0x7F800000;
    无符号整数 负无穷 = 0xFF800000;
    无符号整数 非数 = 0x7FC00000;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 4、加减:低 3 位当余数(保护位/舍位/粘位)+ 就近连偶
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 带保护位 / 舍位 / 粘位的右移结果(低 3 位就是那三位)
结构 右移结果
{
    无符号整数 值;
    整数 保护;      // 被丢掉的最高位
    整数 舍;        // 次高位
    整数 粘位;        // 更低位有没有 1
}

// v 逻辑右移 n 位,低位信息按 IEEE 舍入口径收好
方法 宽整数右移舍入(无符号整数 值入, 整数 n) 返回 右移结果
{
    无符号整数 v = 值入;
    右移结果 结果;
    结果.值 = 0;
    结果.保护 = 0;
    结果.舍 = 0;
    结果.粘位 = 0;
    如果 (n <= 0)
    {
        结果.值 = v;
        返回 结果;
    }
    如果 (n >= 32)
    {
        如果 (v != 0)
        {
            结果.粘位 = 1;
        }
        返回 结果;
    }
    结果.保护 = (v >> (n - 1)) & 1;
    如果 (n >= 2)
    {
        结果.舍 = (v >> (n - 2)) & 1;
    }
    如果 (n >= 3)
    {
        无符号整数 掩 = (1 << (n - 2)) - 1;
        如果 ((v & 掩) != 0)
        {
            结果.粘位 = 1;
        }
    }
    结果.值 = v >> n;
    返回 结果;
}

// 收尾:规格化 + 就近连偶 + 编码成位模式(从 浮点32加 里拆出来,免得帧超限)
//   `和` 是"尾数和 × 8"(低 3 位是余数:保护位/舍位/粘位),值 = 和 × 2^指基
//   `粘位入` = 对齐时丢掉的位里有没有 1
方法 浮点32收尾(无符号整数 和, 整数 指基, 整数 粘位入, 整数 号) 返回 无符号整数
{
    整数 剩余位 = 粘位入;              // 更低位还有没有 1(规格化时一路累积)
    整数 最高 = 整数位长(和) - 1;
    整数 二进指 = 最高 + 指基;
    如果 (二进指 >= -126)
    {
        如果 (最高 < 26)
        {
            和 = 和 << (26 - 最高);
        }
        否则
        {
            如果 (最高 > 26)
            {
                整数 移位量 = 最高 - 26;
                如果 (移位量 >= 32)
                {
                    如果 (和 != 0)
                    {
                        剩余位 = 1;
                    }
                    和 = 0;
                }
                否则
                {
                    无符号整数 掩 = (1 << 移位量) - 1;
                    如果 ((和 & 掩) != 0)
                    {
                        剩余位 = 1;
                    }
                    和 = 和 >> 移位量;
                }
            }
        }
        整数 阶 = 二进指 + 127;
        无符号整数 尾 = 和 >> 3;
        整数 保护 = (和 >> 2) & 1;
        整数 舍 = (和 >> 1) & 1;
        整数 粘位 = 和 & 1;             // 和的最低位 = 这一位以下还有没有 1
        如果 (保护 == 1 && (舍 == 1 || 粘位 == 1 || 剩余位 == 1 || (尾 & 1) == 1))
        {
            尾 = 尾 + 1;
        }
        如果 (尾 >= 0x1000000)
        {
            尾 = 尾 >> 1;
            阶 = 阶 + 1;
        }
        如果 (阶 >= 255)
        {
            如果 (号 == 1)
            {
                返回 0xFF800000;
            }
            返回 0x7F800000;
        }
        返回 (号 << 31) | (阶 << 23) | (尾 & 0x7FFFFF);
    }
    整数 移 = 指基 + 149;
    无符号整数 m = 0;
    整数 保护位 = 0;
    整数 舍入位 = 0;
    如果 (移 >= 0)
    {
        如果 (移 >= 32)
        {
            剩余位 = 1;
        }
        否则
        {
            m = 和 << 移;
        }
    }
    否则
    {
        整数 右移量 = 0 - 移;
        如果 (右移量 >= 32)
        {
            如果 (和 != 0)
            {
                剩余位 = 1;
            }
        }
        否则
        {
            m = 和 >> 右移量;
            保护位 = (和 >> (右移量 - 1)) & 1;
            如果 (右移量 >= 2)
            {
                舍入位 = (和 >> (右移量 - 2)) & 1;
            }
            如果 (右移量 >= 3)
            {
                无符号整数 低位掩码 = (1 << (右移量 - 2)) - 1;
                如果 ((和 & 低位掩码) != 0)
                {
                    剩余位 = 1;
                }
            }
        }
    }
    如果 (保护位 == 1 && (舍入位 == 1 || 剩余位 == 1 || (m & 1) == 1))
    {
        m = m + 1;
    }
    如果 (m == 0)
    {
        如果 (号 == 1)
        {
            返回 0x80000000;
        }
        返回 0;
    }
    如果 (m >= 0x800000)
    {
        返回 (号 << 31) | 0x00800000;
    }
    返回 (号 << 31) | m;
}

// 加法:对齐指数 → 尾数相加 → 规格化,舍入到最近偶数;异号无穷 = 非数,+0 + -0 = +0
方法 浮点32加(无符号整数 A, 无符号整数 B) 返回 无符号整数
{
    整数 号A = A >> 31;
    整数 号B = B >> 31;
    整数 域A = (A >> 23) & 0xFF;
    整数 域B = (B >> 23) & 0xFF;
    无符号整数 段A = A & 0x7FFFFF;
    无符号整数 段B = B & 0x7FFFFF;

    // ---- 非数 / 无穷 ----
    如果 ((域A == 255 && 段A != 0) || (域B == 255 && 段B != 0))
    {
        返回 0x7FC00000;
    }
    如果 (域A == 255 || 域B == 255)
    {
        如果 (域A == 255 && 域B == 255 && 号A != 号B)
        {
            返回 0x7FC00000;
        }
        如果 (域A == 255)
        {
            返回 A;
        }
        返回 B;
    }

    // ---- 零(含 -0)----
    如果 (域A == 0 && 段A == 0 && 域B == 0 && 段B == 0)
    {
        如果 (号A == 号B)
        {
            返回 A;                 // -0 + -0 = -0
        }
        返回 0;                     // +0 + (-0) = +0
    }
    如果 (域A == 0 && 段A == 0)
    {
        返回 B;
    }
    如果 (域B == 0 && 段B == 0)
    {
        返回 A;
    }

    // ---- 归一:值 = M × 2^E ----
    整数 左指数 = 域A - 150;
    整数 右指数 = 域B - 150;
    如果 (域A == 0)
    {
        左指数 = -149;
    }
    如果 (域B == 0)
    {
        右指数 = -149;
    }
    无符号整数 左尾数 = 段A;
    无符号整数 右尾数 = 段B;
    如果 (域A != 0)
    {
        左尾数 = 段A | 0x800000;
    }
    如果 (域B != 0)
    {
        右尾数 = 段B | 0x800000;
    }

    // ---- 大的在前(先比指数,再比尾数;换的时候一个临时变量就够)----
    如果 (左指数 < 右指数 || (左指数 == 右指数 && 左尾数 < 右尾数))
    {
        整数 临时 = 号A;
        号A = 号B;
        号B = 临时;
        临时 = 左指数;
        左指数 = 右指数;
        右指数 = 临时;
        无符号整数 临时尾 = 左尾数;
        左尾数 = 右尾数;
        右尾数 = 临时尾;
    }

    // ---- 对齐:基准 = 左指数 - 3(尾数左移 3 位,低 3 位留给余数)----
    整数 指基 = 左指数 - 3;
    整数 移位量 = 指基 - 右指数;
    无符号整数 和 = 左尾数 << 3;
    整数 粘位 = 0;
    无符号整数 右移量 = 0;
    如果 (移位量 >= 32)
    {
        粘位 = 1;
    }
    否则
    {
        如果 (移位量 >= 0)
        {
            右移量 = 右尾数 >> 移位量;
            如果 (移位量 >= 1)
            {
                无符号整数 掩 = (1 << 移位量) - 1;
                如果 ((右尾数 & 掩) != 0)
                {
                    粘位 = 1;
                }
            }
        }
        否则
        {
            右移量 = 右尾数 << (0 - 移位量);
        }
    }
    如果 (号A == 号B)
    {
        和 = 和 + 右移量;
    }
    否则
    {
        如果 (和 >= 右移量)
        {
            和 = 和 - 右移量;
        }
        否则
        {
            和 = 右移量 - 和;
            号A = 号B;
        }
    }
    如果 (和 == 0)
    {
        返回 0;                     // x + (-x) = +0
    }
    返回 浮点32收尾(和, 指基, 粘位, 号A);
}

// 减法:翻 B 的符号位后走加法(对齐指数 → 尾数相减 → 规格化,舍入到最近偶数);同值相减 = +0
方法 浮点32减(无符号整数 A, 无符号整数 B) 返回 无符号整数
{
    返回 浮点32加(A, 浮点32取负(B));
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 5、比较
//   浮点32比较 → -1(左小) / 0(相等,含 +0 与 -0) / 1(左大) / 2(不可比:有 非数)
//   布尔那几个:只要有一边 非数 就给 假(与 IEEE 的 ==、< 一致)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 比两个单精度:左小 -1 / 相等(含 +0 = -0) / 左大 1;有非数给 2
方法 浮点32比较(无符号整数 A, 无符号整数 B) 返回 整数
{
    如果 (浮点32是非数(A) || 浮点32是非数(B))
    {
        返回 2;
    }
    逻辑 左零 = 浮点32是零(A);
    逻辑 右零 = 浮点32是零(B);
    如果 (左零 && 右零)
    {
        返回 0;                     // +0 == -0
    }
    如果 (左零)
    {
        如果 (浮点32有负号(B))
        {
            返回 1;
        }
        返回 -1;
    }
    如果 (右零)
    {
        如果 (浮点32有负号(A))
        {
            返回 -1;
        }
        返回 1;
    }
    整数 左号 = A >> 31;
    整数 右号 = B >> 31;
    如果 (左号 != 右号)
    {
        如果 (左号 == 1)
        {
            返回 -1;
        }
        返回 1;
    }
    无符号整数 左绝对值 = 浮点32绝对值(A);
    无符号整数 右绝对值 = 浮点32绝对值(B);
    整数 大小 = 0;
    如果 (左绝对值 > 右绝对值)
    {
        大小 = 1;
    }
    否则
    {
        如果 (左绝对值 < 右绝对值)
        {
            大小 = -1;
        }
    }
    如果 (大小 == 0)
    {
        返回 0;
    }
    如果 (左号 == 1)
    {
        返回 0 - 大小;
    }
    返回 大小;
}

// `浮点32比较` 给 0 → 真(+0 与 -0 算相等;任一边 非数 一律 假)
方法 浮点32相等(无符号整数 A, 无符号整数 B) 返回 逻辑
{
    返回 浮点32比较(A, B) == 0;
}

// `浮点32比较` 给 -1 → 真(严格小于;-0 与 +0 判相等,不算;任一边 非数 一律 假)
方法 浮点32小于(无符号整数 A, 无符号整数 B) 返回 逻辑
{
    返回 浮点32比较(A, B) == -1;
}

// `浮点32比较` 给 -1 或 0 → 真(含 -0 与 +0 相等这一档;任一边 非数 一律 假)
方法 浮点32小于等于(无符号整数 A, 无符号整数 B) 返回 逻辑
{
    整数 c = 浮点32比较(A, B);
    返回 c == -1 || c == 0;
}

// `浮点32比较` 给 1 → 真(严格大于;-0 与 +0 判相等,不算;任一边 非数 一律 假)
方法 浮点32大于(无符号整数 A, 无符号整数 B) 返回 逻辑
{
    返回 浮点32比较(A, B) == 1;
}

// `浮点32比较` 给 1 或 0 → 真(含 -0 与 +0 相等这一档;任一边 非数 一律 假)
方法 浮点32大于等于(无符号整数 A, 无符号整数 B) 返回 逻辑
{
    整数 c = 浮点32比较(A, B);
    返回 c == 1 || c == 0;
}
