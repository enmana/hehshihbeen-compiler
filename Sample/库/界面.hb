// ============================================================
// 界面.hb —— 控件库(标签 / 按钮 / 文本框 / 列表 / 复选框 / 单选组 / 进度条;纯 HB 库,不动 ISA、不动关键字)
//
// 用法:包含 "../../库/界面.hb"
//
// 口径(2026-09):
//   · **即时模式**:库不持有窗口,也不替你 `刷新()` —— 一帧的顺序永远是「收事件 → `送事件` → `要重画`? →
//     `重画` → 刷新()」,帧边界在程序手里。干净的一帧照样要 `刷新()`,但一条绘制命令都不发。
//   · **一屏一表**:控件按号存在 `界面` 里的一片**平行列表**上(`类型[]` / `左[]` / `上[]` / `宽[]` / `高[]` /
//     `文本号[]` / `值[]` / `项起[]` / `项数[]` / `行高[]` / `显示[]`),号就是下标,从 0 起、后加的盖在上面;
//     **文本住两个顶层池**(`控件文本池` / `列表项池`),控件里只存下标,同一程序里多开几个界面池子一起长。
//   · **布局**:纵向堆叠。`建界面(面, x, y, 宽, 间距)` 给出列左边界、第一个控件的上边、列宽与间距,之后每加
//     一个控件就把落点往下推(标签 22 / 按钮 30 / 文本框 30 / 复选框 26 / 单选组 26 / 进度条 12;列表高 =
//     行数 × 行高)。要另外摆用 `摆到` / `设为宽高`(摆了之后库自己标脏)。
//   · **命中测试**:从**最后加的往前**找(后加的盖在上面),`显示 == 假` 的跳过;不在任何控件上给 -1;
//     列表还要再往里算一行(`命中行`)。
//   · **重绘调度**:改了什么就 `标脏`(所有会改状态的库函数都替你标了);`要重画` 问一句,`重画` 才真发绘制
//     命令(清屏 + 每个可见控件),回来的是**这一帧发了几条命令**,顺手把脏清掉。
//   · **点一下 = 按下 + 抬起**:`按下` 记在按钮上、`抬起` 还在同一个按钮上才算数;`取点击` 取一次就清掉。
//   · **文本框**只吃 ASCII 可见字符(32~126)与退格(8);中文输入要平台输入法,本版不做。
//   · **键码**沿用宿主那套(`图形键C`):编辑键 / 方向键取老虚拟键编号,字母数字取 ASCII;源码里比键码不必写
//     数字 —— `键回车()` / `键退格()` / `键制表()` / `键空格()` / `键退出()` 就是那几个常量。
//   · **不报错、不停机**:命中不到给 -1,行号越界给 假,状态查询都给确定值。
//
// 配色(库内写死,一屏一个口径;要换色就改 `重画` 那一族里的颜色字面量):
//   背景 0xFF101018 · 标签字 0xFFB0B0B8 · 按钮底 0xFF2A3550(按住 0xFF2A6EF0)· 按钮字 0xFFFFFFFF
//   输入底 0xFF1C1C26 · 输入字 0xFFE8E8F0 · 光标 0xFF2A6EF0 · 列表底 0xFF16161E · 选中 0xFF2A6EF0
//
// 一屏长这样(纵向堆叠,`建界面(面, 12, 12, 200, 8)`):
//     标签   (12, 12)  200×22        按钮   (12, 42)  200×30
//     文本框 (12, 80)  200×30        列表   (12, 118) 200×66(3 行 × 22)
//
// 提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 一屏控件的全部状态:一格一条并排数组 + 布局游标 / 焦点 / 热点 / 脏标
结构 界面
{
    整数 类型[];      // 1 标签 / 2 按钮 / 3 文本框 / 4 列表 / 5 复选框 / 6 单选组 / 7 进度条
    整数 左[];
    整数 上[];
    整数 宽[];
    整数 高[];
    整数 文本号[];    // → 控件文本池
    整数 值[];        // 按钮:0 松 / 1 按住;列表:选中的行(-1 没选);复选框·单选组:0/1;进度条:当前值
    整数 项起[];      // 列表:第一行在 列表项池 的下标(行 r → 项起 + r)
    整数 项数[];      // 列表:一共几行
    整数 行高[];      // 列表:一行多高
    整数 显示[];      // 0 = 这一帧不画、也不命中
    整数 组号[];      // 单选组:同号的一组里只能选一个(默认 0);别的控件不用这一格
    整数 上限[];      // 进度条:满格是多少(别的控件不用这一格)
    整数 布局x;       // 列左边界
    整数 布局y;       // 下一个控件的上边(每加一个往下推)
    整数 布局宽;      // 所有控件的列宽
    整数 间距;        // 控件之间留多少
    整数 焦点;        // 收键盘的文本框(-1 没有)
    整数 热点;        // 鼠标底下的控件(-1 没有)
    整数 按下号;      // 鼠标正按在哪个控件上(-1 没有)
    整数 点击号;      // 刚被"点一下"的控件(取一次清掉)
    整数 脏;          // 0 = 干净,非 0 = 要重画
    整数 帧;          // 重画过几次
    整数 命令数;      // 上一帧发了几条绘制命令
}

字符串 控件文本池[];
字符串 列表项池[];

// ---------- 键码常量名(宿主那套编号:编辑键取老虚拟键编号,字母数字取 ASCII) ----------
方法 键回车() 返回 整数
{
    返回 13;
}
// 退格的键码常量
方法 键退格() 返回 整数
{
    返回 8;
}
// 制表的键码常量
方法 键制表() 返回 整数
{
    返回 9;
}
// 空格的键码常量
方法 键空格() 返回 整数
{
    返回 32;
}
// 退出的键码常量
方法 键退出() 返回 整数
{
    返回 27;
}

// 能直接当文字敲进文本框的键:ASCII 可见字符(32 空格 ~ 126 波浪号)
方法 可打字键(整数 键码) 返回 逻辑
{
    返回 键码 >= 32 && 键码 <= 126;
}

// ---------- 池子:文本按号取(返回的是**副本**,调用方改不动池子里那一份) ----------
方法 文本池取(整数 文本号) 返回 字符串
{
    字符串 结果;
    如果 (文本号 < 0 || 文本号 >= 控件文本池.长度())
    {
        返回 结果;
    }
    拼接到(结果, 控件文本池[文本号]);
    返回 结果;
}

// 按号往文本池写一格:先抄一份再存,存进去之后调用方改那个串也带不动它。
方法 池子设文本(整数 文本号, 字符串 文本)
{
    字符串 副本;
    拼接到(副本, 文本);
    控件文本池[文本号] = 副本;
    返回
}

// 往一段文本后面添一个字(字符来自键码)
方法 添一字(整数 文本号, 字符 字)
{
    字符串 旧串 = 文本池取(文本号);
    字符串 新串;
    拼接到(新串, 旧串, 字);
    池子设文本(文本号, 新串);
    返回
}

// 去掉末尾一个字(按**码点**算:一个汉字就是一个字,与 `.长度()` 同一口径)
方法 退一格(整数 文本号)
{
    字符串 旧串 = 文本池取(文本号);
    整数 长 = 旧串.长度();
    字符串 新串;
    整数 i = 0;
    当 (i < 长 - 1)
    {
        文字 某字 = 旧串[i];
        拼接到(新串, 某字);
        i = i + 1;
    }
    池子设文本(文本号, 新串);
    返回
}

// ---------- 建界面 / 布局 ----------
方法 建界面(界面 面, 整数 x, 整数 y, 整数 宽, 整数 间距)
{
    面.类型.清空();
    面.左.清空();
    面.上.清空();
    面.宽.清空();
    面.高.清空();
    面.文本号.清空();
    面.值.清空();
    面.项起.清空();
    面.项数.清空();
    面.行高.清空();
    面.显示.清空();
    面.组号.清空();
    面.上限.清空();
    面.布局x = x;
    面.布局y = y;
    面.布局宽 = 宽;
    面.间距 = 间距;
    面.焦点 = -1;
    面.热点 = -1;
    面.按下号 = -1;
    面.点击号 = -1;
    面.脏 = 1;
    面.帧 = 0;
    面.命令数 = 0;
    返回
}

// 标记这一屏要重画
方法 标脏(界面 面)
{
    面.脏 = 1;
    返回
}

// 这一帧要不要重画
方法 要重画(界面 面) 返回 逻辑
{
    返回 面.脏 != 0;
}

// 上一帧发了几条绘制命令
方法 上帧命令数(界面 面) 返回 整数
{
    返回 面.命令数;
}

// 这一屏有几个控件
方法 控件数(界面 面) 返回 整数
{
    返回 面.类型.长度();
}

// 第 `号` 个控件的类型
方法 控件类型(界面 面, 整数 号) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 0;
    }
    返回 面.类型[号];
}

// 第 `号` 个控件的左边界
方法 控件左(界面 面, 整数 号) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 0;
    }
    返回 面.左[号];
}

// 第 `号` 个控件的上边界
方法 控件上(界面 面, 整数 号) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 0;
    }
    返回 面.上[号];
}

// 第 `号` 个控件的宽
方法 控件宽(界面 面, 整数 号) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 0;
    }
    返回 面.宽[号];
}

// 第 `号` 个控件的高
方法 控件高(界面 面, 整数 号) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 0;
    }
    返回 面.高[号];
}

// 把控件挪到 (x, y);库自己标脏
方法 摆到(界面 面, 整数 号, 整数 x, 整数 y)
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回
    }
    面.左[号] = x;
    面.上[号] = y;
    标脏(面);
    返回
}

// 改控件尺寸;库自己标脏
方法 设为宽高(界面 面, 整数 号, 整数 宽, 整数 高)
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回
    }
    面.宽[号] = 宽;
    面.高[号] = 高;
    标脏(面);
    返回
}

// 显示 / 隐藏一个控件
方法 设显示(界面 面, 整数 号, 逻辑 显示)
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回
    }
    如果 (显示)
    {
        面.显示[号] = 1;
    }
    否则
    {
        面.显示[号] = 0;
    }
    标脏(面);
    返回
}

// 加一个控件:占位(落点往下推)、文本进池子、标脏。四个"加…"都走它。
方法 加控件(界面 面, 整数 类型, 字符串 文本, 整数 高, 整数 行高) 返回 整数
{
    整数 号 = 面.类型.长度();
    面.类型.添加(类型);
    面.左.添加(面.布局x);
    面.上.添加(面.布局y);
    面.宽.添加(面.布局宽);
    面.高.添加(高);
    面.文本号.添加(控件文本池.长度());
    如果 (类型 == 5 || 类型 == 6)
    {
        面.值.添加(0);                 // 复选框 / 单选组:0 = 没选
    }
    否则
    {
        面.值.添加(-1);                // 列表:-1 = 没选;按钮 / 进度条随后各自赋值
    }
    面.项起.添加(列表项池.长度());
    面.项数.添加(0);
    面.行高.添加(行高);
    面.显示.添加(1);
    面.组号.添加(0);
    面.上限.添加(0);
    控件文本池.添加(文本);
    面.布局y = 面.布局y + 高 + 面.间距;
    标脏(面);
    返回 号;
}

// 加一个标签;高 22
方法 加标签(界面 面, 字符串 文本) 返回 整数
{
    返回 加控件(面, 1, 文本, 22, 0);
}

// 加一个按钮;高 30
方法 加按钮(界面 面, 字符串 文本) 返回 整数
{
    返回 加控件(面, 2, 文本, 30, 0);
}

// 加一个文本框;高 30
方法 加文本框(界面 面, 字符串 文本) 返回 整数
{
    返回 加控件(面, 3, 文本, 30, 0);
}

// 复选框:点一下切换勾选状态(`值` = 0/1)
方法 加复选框(界面 面, 字符串 文本) 返回 整数
{
    返回 加控件(面, 5, 文本, 26, 0);
}

// 单选组:同组只有一个能选上(`组号` 默认 0;要多组就 单选组设组)
方法 加单选组(界面 面, 字符串 文本) 返回 整数
{
    返回 加控件(面, 6, 文本, 26, 0);
}

// 进度条:高 12;`上限` 是满格那个数(<= 0 按 100 算),当前值用 `设控件值` 改
方法 加进度条(界面 面, 整数 上限值) 返回 整数
{
    整数 号 = 加控件(面, 7, "", 12, 0);
    如果 (上限值 <= 0)
    {
        上限值 = 100;
    }
    面.上限[号] = 上限值;
    面.值[号] = 0;
    返回 号;
}

// 把这一号单选组划到某个组里(默认全在 0 组)
方法 单选组设组(界面 面, 整数 号, 整数 组号值)
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回
    }
    面.组号[号] = 组号值;
    返回
}

// 列表:一次把行数 × 行高的位置占下来,行文字在池子里**先占好空位**(以后 `加列表项` 只改内容,
// 池子里的排布就不会被"给别的列表添项"搅乱)
方法 加列表(界面 面, 整数 行数, 整数 行高) 返回 整数
{
    整数 号 = 加控件(面, 4, "", 行数 * 行高, 行高);
    面.项数[号] = 行数;
    整数 k = 0;
    当 (k < 行数)
    {
        列表项池.添加("");
        k = k + 1;
    }
    返回 号;
}

// 给列表第 `行` 行填文本;行从 0 起,越界给 假(不进内存)
方法 加列表项(界面 面, 整数 号, 整数 行, 字符串 文本) 返回 逻辑
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 假;
    }
    如果 (行 < 0 || 行 >= 面.项数[号])
    {
        返回 假;
    }
    整数 项号 = 面.项起[号] + 行;
    如果 (项号 >= 列表项池.长度())
    {
        返回 假;
    }
    字符串 副本;
    拼接到(副本, 文本);
    列表项池[项号] = 副本;
    标脏(面);
    返回 真;
}

// 列表有几行
方法 列表行数(界面 面, 整数 号) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 0;
    }
    返回 面.项数[号];
}

// ---------- 查询 ----------
方法 文本框内容(界面 面, 整数 号) 返回 字符串
{
    字符串 结果;
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 结果;
    }
    返回 文本池取(面.文本号[号]);
}

// 改一个控件的文字
方法 设置控件文本(界面 面, 整数 号, 字符串 文本)
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回
    }
    池子设文本(面.文本号[号], 文本);
    标脏(面);
    返回
}

// 列表选中第几行
方法 列表选中行(界面 面, 整数 号) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 -1;
    }
    返回 面.值[号];
}

// 列表第 `行` 行的文字
方法 列表项文本(界面 面, 整数 号, 整数 行) 返回 字符串
{
    字符串 结果;
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 结果;
    }
    如果 (行 < 0 || 行 >= 面.项数[号])
    {
        返回 结果;
    }
    整数 项号 = 面.项起[号] + 行;
    如果 (项号 >= 列表项池.长度())
    {
        返回 结果;
    }
    拼接到(结果, 列表项池[项号]);
    返回 结果;
}

// 收键盘的文本框(-1 没有)
方法 焦点控件(界面 面) 返回 整数
{
    返回 面.焦点;
}

// 控件值:按钮 0/1(按住);复选框 0/1;单选组 0/1;进度条当前值;列表选中行;号不对给 -1
方法 控件值(界面 面, 整数 号) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 -1;
    }
    返回 面.值[号];
}

// 设控件值:按钮 / 复选框 / 单选组 / 进度条都能用 ——
// 复选框与单选组按"0 = 没选、非 0 = 选"收;单选组选上时同组别的自动落选;
// 进度条会把值夹在 0 ~ 上限 之间;列表**不走这里**(它的值是"选中的行",用 `选中列表行`)。
方法 设控件值(界面 面, 整数 号, 整数 值)
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回
    }
    整数 控类 = 面.类型[号];
    如果 (控类 == 4)
    {
        选中列表行(面, 号, 值);
        返回
    }
    如果 (控类 == 6 && 值 != 0)
    {
        让同组的落选(面, 号);
        面.值[号] = 1;
        标脏(面);
        返回
    }
    如果 (控类 == 7)
    {
        如果 (值 < 0)
        {
            值 = 0;
        }
        如果 (值 > 面.上限[号])
        {
            值 = 面.上限[号];
        }
        面.值[号] = 值;
        标脏(面);
        返回
    }
    如果 (值 != 0)
    {
        面.值[号] = 1;
    }
    否则
    {
        面.值[号] = 0;
    }
    标脏(面);
    返回
}

// 把同一组里别的单选组都落选(选中某一个时调)
方法 让同组的落选(界面 面, 整数 号)
{
    整数 组 = 面.组号[号];
    整数 i = 0;
    整数 总数 = 面.类型.长度();
    当 (i < 总数)
    {
        如果 (i != 号 && 面.类型[i] == 6 && 面.组号[i] == 组)
        {
            面.值[i] = 0;
        }
        i = i + 1;
    }
    返回
}

// 列表选中行:直接改(不改 `值` 以外的状态)
方法 选中列表行(界面 面, 整数 号, 整数 行)
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回
    }
    如果 (面.类型[号] != 4)
    {
        返回
    }
    如果 (行 < -1 || 行 >= 面.项数[号])
    {
        返回
    }
    面.值[号] = 行;
    标脏(面);
    返回
}

// 鼠标底下的控件(-1 没有)
方法 热点控件(界面 面) 返回 整数
{
    返回 面.热点;
}

// 鼠标正按在这个按钮上
方法 按住了(界面 面, 整数 号) 返回 逻辑
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 假;
    }
    返回 面.值[号] == 1 && 面.按下号 == 号;
}

// 取一次就清掉:一个"点一下"只报给调用方一次(不然每帧都得判是不是同一次点击)
方法 取点击(界面 面) 返回 整数
{
    整数 号 = 面.点击号;
    面.点击号 = -1;
    返回 号;
}

// ---------- 命中测试:后加的盖在上面,所以从后往前找 ----------
方法 命中控件(界面 面, 整数 x, 整数 y) 返回 整数
{
    整数 i = 面.类型.长度() - 1;
    当 (i >= 0)
    {
        如果 (面.显示[i] != 0)
        {
            整数 右 = 面.左[i] + 面.宽[i];
            整数 下 = 面.上[i] + 面.高[i];
            如果 (x >= 面.左[i] && x < 右 && y >= 面.上[i] && y < 下)
            {
                返回 i;
            }
        }
        i = i - 1;
    }
    返回 -1;
}

// 列表里第几行(y 减去列表上边再整除以行高);不在这个列表的行上给 -1
方法 命中行(界面 面, 整数 号, 整数 y) 返回 整数
{
    如果 (号 < 0 || 号 >= 面.类型.长度())
    {
        返回 -1;
    }
    如果 (面.类型[号] != 4 || 面.行高[号] <= 0)
    {
        返回 -1;
    }
    如果 (y < 面.上[号])
    {
        返回 -1;
    }
    整数 行 = (y - 面.上[号]) / 面.行高[号];
    如果 (行 < 0 || 行 >= 面.项数[号])
    {
        返回 -1;
    }
    返回 行;
}

// ---------- 送事件:宿主来的五种事件(1 关窗 / 2 按键 / 3 移动 / 4 按下 / 5 抬起) ----------
// 真 = 这次事件改了控件状态(要重画)。关窗(1)不归库管 —— 程序自己收手,这里给 假。
方法 送事件(界面 面, 整数 类型, 整数 键码, 整数 x, 整数 y) 返回 逻辑
{
    // 移动:只改"鼠标底下是哪个控件"(热点),变了才要重画
    如果 (类型 == 3)
    {
        整数 新热点 = 命中控件(面, x, y);
        如果 (新热点 == 面.热点)
        {
            返回 假;
        }
        面.热点 = 新热点;
        标脏(面);
        返回 真;
    }

    // 按下:记住按在谁身上;按钮进"按住"态,文本框拿焦点,列表选中那一行
    如果 (类型 == 4)
    {
        整数 号 = 命中控件(面, x, y);
        面.按下号 = 号;
        如果 (号 < 0)
        {
            如果 (面.焦点 >= 0)
            {
                面.焦点 = -1;
                标脏(面);
                返回 真;
            }
            返回 假;
        }
        整数 控类 = 面.类型[号];
        如果 (控类 == 2)
        {
            面.值[号] = 1;
            标脏(面);
            返回 真;
        }
        如果 (控类 == 5)
        {
            如果 (面.值[号] != 0)
            {
                面.值[号] = 0;
            }
            否则
            {
                面.值[号] = 1;
            }
            标脏(面);
            返回 真;
        }
        如果 (控类 == 6)
        {
            让同组的落选(面, 号);
            面.值[号] = 1;
            标脏(面);
            返回 真;
        }
        如果 (控类 == 3)
        {
            面.焦点 = 号;
            标脏(面);
            返回 真;
        }
        如果 (控类 == 4)
        {
            整数 行 = 命中行(面, 号, y);
            如果 (行 < 0)
            {
                返回 假;
            }
            面.焦点 = -1;
            如果 (面.值[号] == 行)
            {
                返回 假;
            }
            面.值[号] = 行;
            标脏(面);
            返回 真;
        }
        // 标签:点了不算数,只把焦点收掉
        如果 (面.焦点 >= 0)
        {
            面.焦点 = -1;
            标脏(面);
            返回 真;
        }
        返回 假;
    }

    // 抬起:按下与抬起在同一个按钮上才算"点一下"(点击号交给 取点击)
    如果 (类型 == 5)
    {
        整数 号 = 命中控件(面, x, y);
        整数 原按下 = 面.按下号;
        面.按下号 = -1;
        如果 (原按下 >= 0 && 面.类型[原按下] == 2)
        {
            面.值[原按下] = 0;
            如果 (号 == 原按下)
            {
                面.点击号 = 原按下;
            }
            标脏(面);
            返回 真;
        }
        返回 假;
    }

    // 按键:只有拿到焦点的文本框吃键 —— 退格删一个字,可打字键追加一个字
    如果 (类型 == 2)
    {
        整数 焦 = 面.焦点;
        如果 (焦 < 0)
        {
            返回 假;
        }
        如果 (面.类型[焦] != 3)
        {
            返回 假;
        }
        整数 文本号 = 面.文本号[焦];
        如果 (键码 == 键退格())
        {
            退一格(文本号);
            标脏(面);
            返回 真;
        }
        如果 (可打字键(键码))
        {
            字符 字 = 键码;
            添一字(文本号, 字);
            标脏(面);
            返回 真;
        }
        返回 假;
    }

    返回 假;
}

// ---------- 重画:清屏 + 每个可见控件(回来的是这一帧发了几条绘制命令) ----------
// 每条画图命令在库这边各算一条;"清屏"也算一条。焦点框 / 选中行多出来的那几条照算。
方法 画标签(界面 面, 整数 号) 返回 整数
{
    整数 左 = 面.左[号];
    整数 上 = 面.上[号];
    字符串 文本 = 文本池取(面.文本号[号]);
    画文字(左, 上 + 4, 文本, 0xFFB0B0B8);
    返回 1;
}

// 把一个按钮的绘制命令发出去
方法 画按钮(界面 面, 整数 号) 返回 整数
{
    整数 左 = 面.左[号];
    整数 上 = 面.上[号];
    整数 宽 = 面.宽[号];
    整数 高 = 面.高[号];
    如果 (面.值[号] == 1)
    {
        画矩形(左, 上, 宽, 高, 0xFF2A6EF0);
    }
    否则
    {
        画矩形(左, 上, 宽, 高, 0xFF2A3550);
    }
    字符串 文本 = 文本池取(面.文本号[号]);
    画文字(左 + 10, 上 + 7, 文本, 0xFFFFFFFF);
    返回 2;
}

// 把一个文本框的绘制命令发出去
方法 画文本框(界面 面, 整数 号) 返回 整数
{
    整数 左 = 面.左[号];
    整数 上 = 面.上[号];
    整数 宽 = 面.宽[号];
    整数 高 = 面.高[号];
    画矩形(左, 上, 宽, 高, 0xFF1C1C26);
    字符串 内容 = 文本池取(面.文本号[号]);
    画文字(左 + 8, 上 + 7, 内容, 0xFFE8E8F0);
    如果 (面.焦点 != 号)
    {
        返回 2;
    }
    整数 光标x = 左 + 8 + 取文字宽度(内容);
    画线(光标x, 上 + 5, 光标x, 上 + 高 - 5, 0xFF2A6EF0);
    返回 3;
}

// 把一个列表的绘制命令发出去
方法 画列表(界面 面, 整数 号) 返回 整数
{
    整数 左 = 面.左[号];
    整数 上 = 面.上[号];
    整数 宽 = 面.宽[号];
    整数 行高 = 面.行高[号];
    整数 行数 = 面.项数[号];
    画矩形(左, 上, 宽, 行数 * 行高, 0xFF16161E);
    整数 条 = 1;
    整数 行 = 0;
    当 (行 < 行数)
    {
        整数 行y = 上 + 行 * 行高;
        如果 (面.值[号] == 行)
        {
            画矩形(左 + 1, 行y, 宽 - 2, 行高, 0xFF2A6EF0);
            条 = 条 + 1;
        }
        字符串 项 = 列表项文本(面, 号, 行);
        画文字(左 + 8, 行y + 4, 项, 0xFFD0D0D8);
        条 = 条 + 1;
        行 = 行 + 1;
    }
    返回 条;
}

// 复选框:一个小方框 + 勾上的时候里面填一块 + 右边的文字
方法 画复选框(界面 面, 整数 号) 返回 整数
{
    整数 左 = 面.左[号];
    整数 上 = 面.上[号];
    画矩形(左, 上 + 4, 14, 14, 0xFF1C1C26);
    如果 (面.值[号] != 0)
    {
        画矩形(左 + 3, 上 + 7, 8, 8, 0xFF2A6EF0);
    }
    字符串 文本 = 文本池取(面.文本号[号]);
    画文字(左 + 20, 上 + 5, 文本, 0xFFB0B0B8);
    返回 3;
}

// 单选组:一个小方框(选中时里面填一块)+ 右边的文字;同组互斥在 `送事件` / `设控件值` 里管
方法 画单选组(界面 面, 整数 号) 返回 整数
{
    整数 左 = 面.左[号];
    整数 上 = 面.上[号];
    画矩形(左, 上 + 4, 14, 14, 0xFF1C1C26);
    如果 (面.值[号] != 0)
    {
        画矩形(左 + 4, 上 + 8, 6, 6, 0xFF2A6EF0);
    }
    字符串 文本 = 文本池取(面.文本号[号]);
    画文字(左 + 20, 上 + 5, 文本, 0xFFB0B0B8);
    返回 3;
}

// 进度条:整条底 + 按比例填一块(值超上限按满格画;上限 <= 0 当 100)
方法 画进度条(界面 面, 整数 号) 返回 整数
{
    整数 左 = 面.左[号];
    整数 上 = 面.上[号];
    整数 宽 = 面.宽[号];
    整数 上限值 = 面.上限[号];
    如果 (上限值 <= 0)
    {
        上限值 = 100;
    }
    整数 值 = 面.值[号];
    画矩形(左, 上, 宽, 12, 0xFF1C1C26);
    如果 (值 > 上限值)
    {
        值 = 上限值;
    }
    如果 (值 > 0)
    {
        整数 填宽 = 宽 * 值 / 上限值;
        如果 (填宽 > 0)
        {
            画矩形(左, 上, 填宽, 12, 0xFF2A6EF0);
        }
    }
    返回 2;
}

// 真发绘制命令(清屏 + 每个可见控件);返回这一帧发了几条
方法 重画(界面 面) 返回 整数
{
    整数 条 = 0;
    清屏(0xFF101018);
    条 = 条 + 1;
    整数 i = 0;
    整数 总数 = 面.类型.长度();
    当 (i < 总数)
    {
        如果 (面.显示[i] != 0)
         {
             整数 控类 = 面.类型[i];
             如果 (控类 == 1)
             {
                 条 = 条 + 画标签(面, i);
             }
             否则
             {
                 如果 (控类 == 2)
                 {
                     条 = 条 + 画按钮(面, i);
                 }
                 否则
                 {
                     如果 (控类 == 3)
                     {
                         条 = 条 + 画文本框(面, i);
                     }
                     否则
                     {
                         如果 (控类 == 4)
                         {
                             条 = 条 + 画列表(面, i);
                         }
                         否则
                         {
                             如果 (控类 == 5)
                             {
                                 条 = 条 + 画复选框(面, i);
                             }
                             否则
                             {
                                 如果 (控类 == 6)
                                 {
                                     条 = 条 + 画单选组(面, i);
                                 }
                                 否则
                                 {
                                     条 = 条 + 画进度条(面, i);
                                 }
                             }
                         }
                     }
                 }
             }
         }
        i = i + 1;
    }
    面.脏 = 0;
    面.帧 = 面.帧 + 1;
    面.命令数 = 条;
    返回 条;
}
