// ============================================================
// 位集合.hb —— 位集合(一个 32 位字当 32 个标记)库(纯 HB,不动语言面)
//
// 一个位集合就是"一张整数数组":**一个字 = 32 个标记,低位先**
// (`占位 = 位 / 32` 是字下标、`第几位 = 位 % 32`,0 = 最低位)。
//
// 用法:包含 "../库/位集合.hb";`整数 格子[32]` 就是 1024 个标记位,
//   然后 `位集合.清全部(格子)` / `位集合.置位(格子, 1000)` / `位集合.取位(格子, 1000)`。
//
// 口径(2026-10):
//   · **数组元素是 `整数`,可它装的是位模式**:第 31 位那一枚掩码按有符号看是负数
//     (`1 << 31` = -2147483648)—— 不影响 `& | ~ != 0` 这些判断,但**要打印整字**就得先赋给
//     一个 `无符号整数` 变量再打;
//   · **越界一律不报错、不停机**:`位` 不在 `[0, 表长 × 32)` 里时,`置位 / 清位 / 翻位` 给 `假`
//     (什么都不动)、`取位` 给 `假`;要"传错了当场知道"的调用方自己先问 `是否有效`;
//   · **`清全部 / 置前几位` 只动"这一张表"**:`置前几位(表, 位数)` 把前 `位数` 位置 1、**其余的清 0**;
//   · **`数一 / 找首个一 / 找首个零` 只看前 `位数` 位**(`位数` 夹回 `[0, 表长 × 32]`);
//   · **`或位 / 交位 / 异或位` 按整字算,长度取三张表里最短的**,返回值是**真算了几个字**
//     (目标表小了就少算几个,不报错);
//   · **不做**"位集合当哈希表 / 当稀疏集合",也不做排序 / 求和 / 统计。
//
// 英文对照:要几个字 wordsFor · 位宽 bitWidth · 是否有效 isValid · 置位 setBit · 清位 clearBit
//   取位 testBit · 翻位 flipBit · 清全部 clearAll · 置前几位 fillBits · 数一 popCount
//   找首个一 firstSet · 找首个零 firstZero · 或位 orBits · 交位 andBits · 异或位 xorBits
//
// 复杂度:要几个字 / 位宽 / 是否有效 / 置位 / 清位 / 取位 / 翻位 O(1);清全部 O(表长);
//   置前几位 / 数一 / 找首个一 / 找首个零 O(表长 × 32);或位 / 交位 / 异或位 O(最短表长)。
// 提供的函数(15 个):逐个见下面那张公开方法表。
// 边界(如实登记):一个位集合就是一张 `整数` 数组(列表取不出地址 ⇒ 传不进函数);越界不报错。
// ============================================================
模块 位集合

// 私有:把 `值` 夹进 [下, 上]
私有 方法 位集合夹回(整数 值, 整数 下, 整数 上) 返回 整数
{
    如果 (值 < 下)
    {
        返回 下;
    }
    如果 (值 > 上)
    {
        返回 上;
    }
    返回 值;
}

// 私有:第 `第几位`(0~31)位那一枚掩码(用乘 2 顶上去,不走移位)
私有 方法 位集合一位掩码(整数 第几位) 返回 整数
{
    整数 掩码 = 1;
    整数 i = 0;
    当 (i < 第几位)
    {
        掩码 = 掩码 * 2;
        i = i + 1;
    }
    返回 掩码;
}

// 私有:一个整字里有几个 1(固定 32 轮)
私有 方法 位集合数一个字(整数 字) 返回 整数
{
    整数 数 = 0;
    整数 i = 0;
    当 (i < 32)
    {
        如果 ((字 & 位集合一位掩码(i)) != 0)
        {
            数 = 数 + 1;
        }
        i = i + 1;
    }
    返回 数;
}

// 私有:把 `位数` 夹进 [0, 表长 × 32]
私有 方法 位集合夹位数(整数 表[], 整数 位数) 返回 整数
{
    返回 位集合夹回(位数, 0, 表.长度() * 32);
}

// ============================================================
// 1、问规模
// ============================================================

// 要标记 `位数` 件事得开几个字(向上取整到 32);位数 ≤ 0 给 0。
方法 要几个字(整数 位数) 返回 整数
{
    如果 (位数 <= 0)
    {
        返回 0;
    }
    整数 整字 = 位数 / 32;
    如果 (位数 - 整字 * 32 > 0)
    {
        整字 = 整字 + 1;
    }
    返回 整字;
}

// 这张表一共管几个标记位(表长 × 32)。
方法 位宽(整数 表[]) 返回 整数
{
    返回 表.长度() * 32;
}

// `位` 在 [0, 表长 × 32) 里。
方法 是否有效(整数 表[], 整数 位) 返回 逻辑
{
    返回 位 >= 0 && 位 < 表.长度() * 32;
}

// ============================================================
// 2、单点读写(一次一个标记)
// ============================================================

// 把这一位改成 1;越界给 假(什么都不动)。
方法 置位(整数 表[], 整数 位) 返回 逻辑
{
    如果 (是否有效(表, 位) == 假)
    {
        返回 假;
    }
    整数 占位 = 位 / 32;
    表[占位] = 表[占位] | 位集合一位掩码(位 - 占位 * 32);
    返回 真;
}

// 把这一位改成 0;越界给 假(什么都不动)。
方法 清位(整数 表[], 整数 位) 返回 逻辑
{
    如果 (是否有效(表, 位) == 假)
    {
        返回 假;
    }
    整数 占位 = 位 / 32;
    表[占位] = 表[占位] & (~位集合一位掩码(位 - 占位 * 32));
    返回 真;
}

// 这一位是不是 1;越界给 假。
方法 取位(整数 表[], 整数 位) 返回 逻辑
{
    如果 (是否有效(表, 位) == 假)
    {
        返回 假;
    }
    整数 占位 = 位 / 32;
    返回 (表[占位] & 位集合一位掩码(位 - 占位 * 32)) != 0;
}

// 把这一位翻过来;越界给 假(什么都不动)。
方法 翻位(整数 表[], 整数 位) 返回 逻辑
{
    如果 (是否有效(表, 位) == 假)
    {
        返回 假;
    }
    整数 占位 = 位 / 32;
    表[占位] = 表[占位] ^ 位集合一位掩码(位 - 占位 * 32);
    返回 真;
}

// ============================================================
// 3、整表动作
// ============================================================

// 整表清 0。
方法 清全部(整数 表[])
{
    整数 i = 0;
    当 (i < 表.长度())
    {
        表[i] = 0;
        i = i + 1;
    }
}

// 前 `位数` 位置 1,**其余的清 0**(于是"只置前几位"与"整表置满"分得清)。
方法 置前几位(整数 表[], 整数 位数)
{
    整数 上界 = 位集合夹位数(表, 位数);
    清全部(表);
    整数 i = 0;
    当 (i < 上界)
    {
        置位(表, i);
        i = i + 1;
    }
}

// 前 `位数` 位里有几个 1。
方法 数一(整数 表[], 整数 位数) 返回 整数
{
    整数 上界 = 位集合夹位数(表, 位数);
    整数 整字 = 上界 / 32;
    整数 零头 = 上界 - 整字 * 32;
    整数 数 = 0;
    整数 i = 0;
    当 (i < 整字)
    {
        数 = 数 + 位集合数一个字(表[i]);
        i = i + 1;
    }
    整数 j = 0;
    当 (j < 零头)
    {
        如果 ((表[整字] & 位集合一位掩码(j)) != 0)
        {
            数 = 数 + 1;
        }
        j = j + 1;
    }
    返回 数;
}

// 第一个 1 在第几位;没有给 -1。
方法 找首个一(整数 表[], 整数 位数) 返回 整数
{
    整数 上界 = 位集合夹位数(表, 位数);
    整数 i = 0;
    当 (i < 上界)
    {
        整数 占位 = i / 32;
        如果 ((表[占位] & 位集合一位掩码(i - 占位 * 32)) != 0)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// 第一个 0 在第几位;没有给 -1。
方法 找首个零(整数 表[], 整数 位数) 返回 整数
{
    整数 上界 = 位集合夹位数(表, 位数);
    整数 i = 0;
    当 (i < 上界)
    {
        整数 占位 = i / 32;
        如果 ((表[占位] & 位集合一位掩码(i - 占位 * 32)) == 0)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// ============================================================
// 4、三则位运算(整字算,长度取三张表里最短的)
// ============================================================

// 私有:三张表里最短的那张有多长
私有 方法 位集合可算几个字(整数 表左[], 整数 表右[], 整数 出去[]) 返回 整数
{
    整数 短 = 表左.长度();
    如果 (表右.长度() < 短)
    {
        短 = 表右.长度();
    }
    如果 (出去.长度() < 短)
    {
        短 = 出去.长度();
    }
    返回 短;
}

// 按位或(三张表最短的那么多个字);返回真算了几个字。
方法 或位(整数 表左[], 整数 表右[], 整数 出去[]) 返回 整数
{
    整数 可算 = 位集合可算几个字(表左, 表右, 出去);
    整数 i = 0;
    当 (i < 可算)
    {
        出去[i] = 表左[i] | 表右[i];
        i = i + 1;
    }
    返回 可算;
}

// 按位与(同上)。
方法 交位(整数 表左[], 整数 表右[], 整数 出去[]) 返回 整数
{
    整数 可算 = 位集合可算几个字(表左, 表右, 出去);
    整数 i = 0;
    当 (i < 可算)
    {
        出去[i] = 表左[i] & 表右[i];
        i = i + 1;
    }
    返回 可算;
}

// 按位异或(同上)。
方法 异或位(整数 表左[], 整数 表右[], 整数 出去[]) 返回 整数
{
    整数 可算 = 位集合可算几个字(表左, 表右, 出去);
    整数 i = 0;
    当 (i < 可算)
    {
        出去[i] = 表左[i] ^ 表右[i];
        i = i + 1;
    }
    返回 可算;
}
