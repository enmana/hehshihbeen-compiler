// ============================================================
// 测试助手.hb —— 断言里"条件怎么算"与"失败时给人看什么"(纯 HB,零依赖)
//
// 用法:包含 "../库/测试助手.hb";`测试 "表算法" { 断言 测试助手.表相等(表左, 表右); }`。
//
// **报行号、记失败、块尾汇总那一半是语言内建的 `测试` / `断言`** ⇒ 这一库的函数一律**返回 `逻辑`**,
//   由调用方交给 `断言` 去报(这样报出来的**行号是调用方那一行**);本库只做"没有直接写法"的比较与"表 → 文字"。
//
// 口径(2026-10):
//   · **`近似` 是"容差比"**:`|左 - 右| <= 误差`;**误差给负数一律算不相等**(不静默取绝对值);
//   · **整表比按"长度也不同、元素也不同"两层判**:长度不等直接不相等,不看元素;`表近似` 同理;
//   · **只收定长数组**(`整数 表[10]` 这种):动态列表传不进来 —— 报"列表的地址不能取";
//   · **子串包含认空串**(任何串都含空串);**不报错、不停机**:任何入参都给一个 `逻辑`。
//
// 英文对照:近似 near · 表相等 arraysEqual · 表近似 arraysNear · 字符串包含 contains · 表文字 arrayText
//
// 边界(如实登记):
//   · **不做浮点近似**(双精度在 `float64.hb` 里是**结构**,这一库零依赖,不把它拉进来);
//   · **不做 `计数(名字)`**(内建的 `测试 名字 { … }` 块尾已经会汇总);
//   · **`表文字` 只认 `整数` 表**(`字符串 表[]` 连形参都写不出来);`字符串包含` O(主串长 × 子串长)。
// 提供的函数(5 个):逐个见下面那张公开方法表。
// 复杂度:近似 O(1);表相等 / 表近似 O(表长);字符串包含 O(主串长 × 子串长);表文字 O(表长 × 数字位数)。
// ============================================================
模块 测试助手

// 私有:整数转十进制文字(`表文字` 与"人看的失败信息"要用)
私有 方法 测试助手转字符串(整数 值) 返回 字符串
{
    字符串 结果 = "";
    无符号整数 大 = 值;
    如果 (值 < 0)
     {
        大 = 0 - 值;
        拼接到(结果, '-');
    }
    整数 位数 = 1;
    无符号整数 剩 = 大;
    当 (剩 >= 10)
    {
        剩 = 剩 / 10;
        位数 = 位数 + 1;
    }
    剩 = 大;
    整数 k = 0;
    当 (k < 位数)                          // 从最高位开始拼
    {
        整数 移位量 = 位数 - 1 - k;
        无符号整数 十的幂 = 1;
        整数 j = 0;
        当 (j < 移位量)
        {
            十的幂 = 十的幂 * 10;
            j = j + 1;
        }
        字符 这位 = 48 + 剩 / 十的幂 % 10;   // 先存进一个 `字符`:`拼接到` 只收字符串或**字节变量**,不收算式
        拼接到(结果, 这位);
        剩 = 剩 % 十的幂;
        k = k + 1;
    }
    返回 结果;
}

// 私有:子串查找(朴素逐位;找得到给下标,找不到给 -1)
私有 方法 测试助手找位置(字符串 主串, 字符串 子串) 返回 整数
{
    整数 主长 = 主串.长度();
    整数 子长 = 子串.长度();
    如果 (子长 == 0)
    {
        返回 0;
    }
    如果 (子长 > 主长)
    {
        返回 -1;
    }
    整数 起 = 0;
    当 (起 + 子长 <= 主长)
    {
        整数 对得上 = 1;
        整数 i = 0;
        当 (i < 子长)
        {
            如果 (主串[起 + i] != 子串[i])
            {
                对得上 = 0;
                跳出;
            }
            i = i + 1;
        }
        如果 (对得上 == 1)
        {
            返回 起;
        }
        起 = 起 + 1;
    }
    返回 -1;
}

// 容差与整表
// 两个整数差在容差里。
方法 近似(整数 左, 整数 右, 整数 误差) 返回 逻辑
{
    如果 (误差 < 0)
    {
        返回 假;
    }
    整数 差 = 左 - 右;
    如果 (差 < 0)
    {
        差 = 0 - 差;
    }
    返回 差 <= 误差;
}
// 两张整表逐个元素相等(长度也要一样)。
方法 表相等(整数 表左[], 整数 表右[]) 返回 逻辑
{
    整数 左长 = 表左.长度();
    如果 (左长 != 表右.长度())
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 左长)
    {
        如果 (表左[i] != 表右[i])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}
// 两张整表逐位都在容差里(长度也要一样)。
方法 表近似(整数 表左[], 整数 表右[], 整数 误差) 返回 逻辑
{
    如果 (误差 < 0)
    {
        返回 假;
    }
    整数 左长 = 表左.长度();
    如果 (左长 != 表右.长度())
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 左长)
    {
        如果 (近似(表左[i], 表右[i], 误差) == 假)
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}
// 子串在不在里面(空子串算在)。
方法 字符串包含(字符串 主串, 字符串 子串) 返回 逻辑
{
    返回 测试助手找位置(主串, 子串) >= 0;
}

// 给人看的表
// 把一张整表写成 `[1, 2, 3]` 给人看(失败信息里好用)。
方法 表文字(整数 表[]) 返回 字符串
{
    字符串 结果 = "";
    拼接到(结果, '[');
    整数 个数 = 表.长度();
    整数 i = 0;
    当 (i < 个数)
    {
        如果 (i > 0)
        {
            拼接到(结果, ", ");
        }
        拼接到(结果, 测试助手转字符串(表[i]));
        i = i + 1;
    }
    拼接到(结果, ']');
    返回 结果;
}
