// ============================================================
// 素体.hb —— 参数化**女性人体素体**(纯 HB,依赖 `三维数学.hb` 与 `三维网格.hb`)
//
// 口径(2026-10):
//   · 只做**不穿衣服的形体**(比例 / 曲线 / 四肢粗细);衣服是另一层,由另一份库套在外面;
//   · 单位:**厘米**(身高约 170),`三维网格` 的相机就是按厘米配的,不用缩放;
//   · 坐标:y 向上、x 左右(正值在角色的左手边)、z **前后**(正值在前 = 胸口那一面);
//   · 比例照"写实向"的常见值,但**没做解剖学级别的还原**:关节是球、脚是块、手没有手指。
//
// 核心是**躯干那五张表**(放模块级:函数帧只有 96 字节):每一行是一个高度上的横截面,
//   其中 **`躯干偏`(前后偏移)那一列决定侧视图像不像人** —— 没有它每个横截面都落在 z=0 上,
//   侧视图就是一块板。**改那五张表就是改体形**。
// 提供的函数(7 个):逐个见下面那张公开方法表。
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名)。
// 复杂度:建一次走完全部横截面(O(顶点数));没有按数据规模长大的循环。
// 用法:包含 "../库/素体.hb";然后调用 `素体.建()`。
// 边界(如实登记):没做解剖学级别的还原(关节是球、脚是块、手没有手指);只有女性素体这一份。
// ============================================================
模块 素体

// 躯干:16 个高度上的横截面(裆部 → 头顶);每一行 = 高(y)/ 半宽(左右)/ 半深(前后)/ **前后偏移** / 方圆(0 椭圆、1 圆角矩形)。
//   改这里就是改体形:`躯干宽[3]` 是腰的粗细、`躯干深[6]` 是胸的厚薄、`躯干偏[1]` 是屁股多翘。
浮点 躯干高[16];
浮点 躯干宽[16];
浮点 躯干深[16];
浮点 躯干偏[16];
浮点 躯干方[16];

// 把躯干那五张表填上(16 个高度上的横截面)。
方法 素体填表() 返回 整数
{
    //                  高     半宽   半深   前后偏  方圆
    躯干高[0] = 82.0;
    躯干宽[0] = 10.0;
    躯干深[0] = 10.0;
    躯干偏[0] = 0.0;
    躯干方[0] = 0.25;
    躯干高[1] = 88.0;
    躯干宽[1] = 19.0;           // 臀:比肩宽(收窄后的沙漏)
    躯干深[1] = 13.5;
    躯干偏[1] = 0.0 - 3.0;      // 臀往后凸 3 厘米 —— 侧面这一笔最出效果
    躯干方[1] = 0.35;
    躯干高[2] = 95.0;
    躯干宽[2] = 16.0;
    躯干深[2] = 12.0;
    躯干偏[2] = 0.0 - 1.4;
    躯干方[2] = 0.30;
    躯干高[3] = 102.0;
    躯干宽[3] = 8.6;            // 腰:最细(腰臀比 ≈ 0.45,沙漏的关键)
    躯干深[3] = 7.8;
    躯干偏[3] = 0.4;            // 腰略往前顶
    躯干方[3] = 0.22;
    躯干高[4] = 108.0;
    躯干宽[4] = 10.0;
    躯干深[4] = 8.6;
    躯干偏[4] = 0.0 - 0.6;
    躯干方[4] = 0.22;
    躯干高[5] = 114.0;
    躯干宽[5] = 12.4;
    躯干深[5] = 10.0;
    躯干偏[5] = 0.0 - 0.2;
    躯干方[5] = 0.25;
    躯干高[6] = 120.0;
    躯干宽[6] = 14.2;
    躯干深[6] = 11.0;
    躯干偏[6] = 0.4;            // 胸廓:最厚
    躯干方[6] = 0.30;
    躯干高[7] = 128.0;
    躯干宽[7] = 13.4;
    躯干深[7] = 10.0;
    躯干偏[7] = 0.8;
    躯干方[7] = 0.30;
    躯干高[8] = 134.0;
    躯干宽[8] = 13.0;           // 肩:收窄(原来 14.6 太宽厚)
    躯干深[8] = 9.2;
    躯干偏[8] = 1.0;
    躯干方[8] = 0.35;
    躯干高[9] = 137.0;
    躯干宽[9] = 11.2;           // 肩斜:落得快,削出溜肩
    躯干深[9] = 8.4;
    躯干偏[9] = 1.0;
    躯干方[9] = 0.30;
    躯干高[10] = 140.0;
    躯干宽[10] = 4.6;           // 颈:细
    躯干深[10] = 4.8;
    躯干偏[10] = 0.8;
    躯干方[10] = 0.0;
    躯干高[11] = 146.0;
    躯干宽[11] = 4.2;
    躯干深[11] = 4.6;
    躯干偏[11] = 0.6;
    躯干方[11] = 0.0;
    躯干高[12] = 151.0;
    躯干宽[12] = 5.4;
    躯干深[12] = 5.8;
    躯干偏[12] = 0.4;
    躯干方[12] = 0.1;
    躯干高[13] = 157.0;
    躯干宽[13] = 7.4;
    躯干深[13] = 8.0;
    躯干偏[13] = 0.2;
    躯干方[13] = 0.15;
    躯干高[14] = 164.0;
    躯干宽[14] = 8.8;
    躯干深[14] = 9.6;
    躯干偏[14] = 0.0 - 0.4;     // 后脑略往后
    躯干方[14] = 0.2;
    躯干高[15] = 170.0;
    躯干宽[15] = 3.4;
    躯干深[15] = 3.6;
    躯干偏[15] = 0.0 - 0.4;
    躯干方[15] = 0.1;
    返回 0;
}

// ---------- 躯干(含头):16 圈,每圈 18 个点 ----------
方法 素体躯干() 返回 整数
{
    素体填表();
    整数 每圈 = 32;
    整数 上圈 = -1;
    整数 i = 0;
    当 (i < 16)
    {
        // ⚠ 拆两句:参数一多,一句里算完 `躯干高[i]` 那一串会把 15 个临时寄存器用光(踩过)
        浮点 层y = 躯干高[i];
        浮点 层z = 躯干偏[i];
        整数 本圈 = 三维网格.加一圈(0.0, 层y, 层z, 0.0, 1.0, 0.0, 躯干宽[i], 躯干深[i], 躯干方[i], 每圈);
        如果 (上圈 >= 0)
        {
            三维网格.接圈(上圈, 本圈, 每圈);
        }
        上圈 = 本圈;
        i = i + 1;
    }
    返回 0;
}

// 一侧胸:球状,一串横截面从下往上堆(`侧` = 1 或 -1;四个数是左右位置 / 高度 / 前后位置 / 半径)。
方法 素体胸(浮点 侧) 返回 整数
{
    浮点 心x = 侧 * 8.0;
    浮点 心y = 115.0;
    浮点 心z = 8.8;
    浮点 半 = 7.6;
    整数 每圈 = 20;
    整数 层数 = 8;
    整数 上圈 = -1;
    整数 i = 0;
    当 (i <= 层数)
    {
        浮点 比 = 浮点(i) / 浮点(层数);
        浮点 相对 = 比 * 2.0 - 1.0;
        浮点 半径 = 半 * 三维数学.开方(1.0 - 相对 * 相对);
        浮点 层y = 心y + 半 * 相对;
        浮点 层深 = 半径 * 0.95;
        整数 本圈 = 三维网格.加一圈(心x, 层y, 心z, 0.0, 1.0, 0.0, 半径, 层深, 0.0, 每圈);
        如果 (上圈 >= 0)
        {
            三维网格.接圈(上圈, 本圈, 每圈);
        }
        上圈 = 本圈;
        i = i + 1;
    }
    返回 0;
}

// 头发:一大块体积(从头顶往下、包住后脑与两侧,到肩胛附近收窄);做法还是一串横截面,
//   每一圈比头略大、而且往后偏。
方法 素体发() 返回 整数
{
    整数 每圈 = 24;
    整数 层数 = 12;
    整数 上圈 = -1;
    整数 i = 0;
    当 (i <= 层数)
    {
        // 从头顶(171)一路落到肩下(132)
        浮点 比 = 浮点(i) / 浮点(层数);
        浮点 层y = 171.0 - 39.0 * 比;
        // 半径:头顶那一圈收口,到耳朵附近最宽(11.5),再往下略收
        浮点 半径 = 3.2 + 8.6 * 比;
        如果 (比 > 0.45)
        {
            半径 = 11.8 - (比 - 0.45) * 3.4;
        }
        // 往后偏:整块头发贴在脑后(越往下越往后)
        浮点 层z = 0.0 - 1.2 - 3.2 * 比;
        浮点 层深 = 半径 * 0.92;
        整数 本圈 = 三维网格.加一圈(0.0, 层y, 层z, 0.0, 1.0, 0.0, 半径, 层深, 0.15, 每圈);
        如果 (上圈 >= 0)
        {
            三维网格.接圈(上圈, 本圈, 每圈);
        }
        上圈 = 本圈;
        i = i + 1;
    }
    返回 0;
}

// 一条肢体:起 → 中 → 止 两段锥管(肩肘腕 / 胯膝踝都走它)。
方法 素体肢(浮点 起x, 浮点 起y, 浮点 起z, 浮点 中x, 浮点 中y, 浮点 中z, 浮点 止x, 浮点 止y, 浮点 止z, 浮点 起半径, 浮点 中半径, 浮点 止半径) 返回 整数
{
    整数 每圈 = 14;
    三维网格.加管(起x, 起y, 起z, 中x, 中y, 中z, 起半径, 中半径, 1.0, 每圈, 8);
    三维网格.加管(中x, 中y, 中z, 止x, 止y, 止z, 中半径, 止半径, 1.0, 每圈, 8);
    返回 0;
}

// 一只脚:从踝往前伸的一小块。
方法 素体脚(浮点 侧) 返回 整数
{
    浮点 踝x = 侧 * 5.5;
    三维网格.加管(踝x, 7.0, 0.0, 踝x, 3.0, 7.0, 3.8, 3.0, 1.6, 12, 3);
    返回 0;
}

// 建:整个人(素体,不穿衣服)。
方法 建() 返回 整数
{
    三维网格.清空();
    素体躯干();
    素体发();
    素体胸(1.0);
    素体胸(0.0 - 1.0);
    // 手臂:肩(±13,134) → 肘(±20,110) → 腕(±24,88)
    // ⚠ **往外张**:第一版肩肘腕几乎在一条竖线上 ⇒ 胳膊贴在身子上、把胸糊住
    素体肢(13.5, 133.0, 0.0, 20.0, 110.0, 1.0, 24.0, 88.0, 1.5, 4.8, 3.6, 2.8);
    素体肢(0.0 - 13.5, 133.0, 0.0, 0.0 - 20.0, 110.0, 1.0, 0.0 - 24.0, 88.0, 1.5, 4.8, 3.6, 2.8);
    // 腿:胯(±7.5,86) → 膝(±7,48) → 踝(±5.5,10)
    素体肢(7.5, 86.0, 0.0, 7.0, 48.0, 0.0, 5.5, 10.0, 0.0, 9.4, 6.4, 4.0);
    素体肢(0.0 - 7.5, 86.0, 0.0, 0.0 - 7.0, 48.0, 0.0, 0.0 - 5.5, 10.0, 0.0, 9.4, 6.4, 4.0);
    素体脚(1.0);
    素体脚(0.0 - 1.0);
    素体摆正();
    返回 0;
}

// 摆正:把模型的中高对到 y = 0(只居中、不缩放;就地算,不走 `三维网格.居中`)。
私有 方法 素体摆正() 返回 整数
{
    浮点 高 = 三维网格.顶点y[0];
    浮点 低 = 三维网格.顶点y[0];
    整数 i = 1;
    当 (i < 三维网格.顶点数)
    {
        浮点 v = 三维网格.顶点y[i];
        如果 (v > 高)
        {
            高 = v;
        }
        如果 (v < 低)
        {
            低 = v;
        }
        i = i + 1;
    }
    浮点 中 = (高 + 低) * 0.5;
    i = 0;
    当 (i < 三维网格.顶点数)
    {
        浮点 vy = 三维网格.顶点y[i];
        三维网格.顶点y[i] = vy - 中;
        i = i + 1;
    }
    返回 0;
}
