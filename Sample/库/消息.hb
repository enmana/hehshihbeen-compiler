// ============================================================
// 消息.hb —— **发布 / 订阅**(纯 HB 库:不动 ISA、不动关键字、不动机器码)
//
// 用法:
// ```
// 包含 "../库/消息.hb";
//
// 方法 温度记录(整数 号, 整数 值)
// {
//     输出行("温度记录 " + 值);
// }
// 方法 全量记录(整数 号, 整数 值)
// {
//     输出行("全量记录 " + 值);
// }
//
// 消息.订阅("温度", 地址(温度记录));
// 消息.订阅("温度", 地址(全量记录));
// 消息.订阅("湿度", 地址(全量记录));
// 消息.发布全部("温度", 25);        // 温度记录、全量记录都收到;返回 2
// 消息.发布全部("湿度", 60);        // 只有全量记录收到;返回 1
// 消息.退订("温度");                // 那个主题上的两条都撤掉
// ```
//
// 治的是**模块之间不互相认识**那件事:把“主题 → 处理函数”那张表收成一处,订阅 / 发布 / 退订三件事各有**确定**的返回(退订最容易漏 —— 漏了就“关掉的面板还在收消息”)。
//
// ★★ 本库**真的能把调用方的处理函数存下来、并在 `发布` 里替你调** —— 做法是**每个函数的回调形参各起一个不同的名字**(`订阅_处理` / `发布_处理`),于是每个函数有自己的形参表。这是它与 `事件.hb` 那两条库最大的不同。
//
// 口径(2026-10-10;每条都对着实测写):
//   · **格子数写死**:订阅簿 **16 格**(`消息_主题[16]` + 16 个回调槽)。
//     满了 `订阅` 给 **假**(不覆盖别人的订阅 —— 覆盖是最难查的那种错);
//   · **主题是个字符串**,按**内容**比(`==` 逐字节比,与 `string.hb` 一个口径);
//   · **`发布` 调用的是库** —— 调用方只要 `订阅` 一次,以后 `发布` 就自动调过去;
//   · **一个主题可以有多条订阅**:`发布全部` 把那个主题上的**每一条**都调一遍,返回**调了几条**;
//     `发布一个` 只调**第 N 条**(从 0 数),返回逻辑(有没有这一条);
//   · **处理函数的签名是 `(整数 号, 整数 值)`**:`号` = 这一条订阅的**序号**(订阅时返回的那个),
//     `值` = `发布` 带过来的那个整数 ⇒ 同一个函数给多个主题订阅时,**靠 `号` 分得清是谁**;
//   · **`退订(主题)`** 撤掉那个主题上的**全部**订阅,返回撤了几条;
//     `退订一个(号)` 只撤那一条,返回逻辑。撤掉之后那一格**空出来给下一次订阅用**;
//   · **不报错、不停机**:没订阅过就 `发布` 给 0、订阅簿满了给假、号越界给假 ——
//     与 `string.hb` / `日志.hb` 同一个规矩;
//   · **`发布` 里调用方那个处理函数抛不回东西**:本库**只认"没有返回值"的处理函数**
//     (写成 `方法 处理(整数 号, 整数 值)` 就行);要"返回值"就在处理函数里自己往别处写;
//   · **发布期间不许订阅 / 退订**(那条路本库不拦,但**格子在改**会让"这一轮该调哪几条"变得不确定)
//     —— 要改就先收进一个待办,发布回来再改;
//   · **一次 `发布` 走一遍 16 格**:16 是写死的上限,与订阅了几条无关(不做链表:链表在 1MB 内存下
//     要多一次堆申请,而发布是热路径)。
//
// 提供的函数(12 个):逐条的作用见本页末尾那张公开方法表。
//                                           只调**第 N 条**(0 起);返回 1 调了 / 0 没有
//   发布全部(字符串 主题, 整数 值) 返回 整数 那个主题上**每一条**都调;返回调了几条
//   退订(字符串 主题) 返回 整数             撤掉那个主题上的全部订阅;返回撤了几条
//   退订一个(整数 号) 返回 逻辑             撤掉第 N 条;返回真 = 撤掉了
//   有订阅(字符串 主题) 返回 逻辑           那个主题上还有订阅吗
//   条数() 返回 整数                        现在一共几条订阅
//   主题(整数 号) 返回 字符串               第 N 条订阅的主题("" = 没这一条)
//   清掉()                                  订阅簿清空(回调槽一并复位)
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:`订阅` / `退订一个` / `退订` / `条数` 都是 O(格数 = 16);`发布*` 是 O(16 × 主题长度)
//   (逐格比主题)—— 与"订阅了几条"无关,不会随订阅数长大。
//
// 内存账:**一次都不申请堆**:16 条主题串在两个时刻造(订阅时把主题抄进来一条;
//   `主题(号)` 现造一条结果串)。回调槽是 16 个模块级 `回调` 变量(每个 4 字节)。
//   **模块级变量一律带 `消息` 前缀**(语言现状:模块级私有变量会与调用方的顶层同名变量共用一格)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **16 格是上限**,不是"够用":要更多订阅就自己写一层"主题 → 分组"的映射(或者等本库出第二版);
//   · **主题只在订阅那一刻抄一份**:订阅之后再去改调用方那条串,**订阅簿里那份不变**(这是有意的:
//     订阅簿不该被外面的字符串改动牵着走);
//   · **同一个处理函数给同一个主题订阅两次** = 两条独立订阅(发布时会被调两次)——
//     本库**不做去重**(要去重就自己先 `有订阅`);
//   · **不排队**:`发布` 是同步直调,处理函数里做的事**当场做完**;要"攒起来稍后处理"就用
//     `消息` + 自己的队列(或者 `异步.hb` 的任务队列那一半)。
// ============================================================

模块 消息

// ---- 订阅簿:16 格(主题串 + 那个回调槽 + 占没占用)----
// ⚠ 回调**不能放数组**(实测:`回调 表[4]` 报"要写清指向哪个函数")⇒ 一格一个具名槽。
//    槽是"变量名"而不是"数组元素"还有一个好处:`间接调用` 只认变量(M 的报文里那条口径)。
回调 消息_槽0 = 地址(消息_占位);
回调 消息_槽1 = 地址(消息_占位);
回调 消息_槽2 = 地址(消息_占位);
回调 消息_槽3 = 地址(消息_占位);
回调 消息_槽4 = 地址(消息_占位);
回调 消息_槽5 = 地址(消息_占位);
回调 消息_槽6 = 地址(消息_占位);
回调 消息_槽7 = 地址(消息_占位);
回调 消息_槽8 = 地址(消息_占位);
回调 消息_槽9 = 地址(消息_占位);
回调 消息_槽10 = 地址(消息_占位);
回调 消息_槽11 = 地址(消息_占位);
回调 消息_槽12 = 地址(消息_占位);
回调 消息_槽13 = 地址(消息_占位);
回调 消息_槽14 = 地址(消息_占位);
回调 消息_槽15 = 地址(消息_占位);

字符串 消息_主题[16];
逻辑 消息_占用[16];

// 空槽指到这儿(不是"空指针"):真去调它也只是什么都不做
方法 消息_占位(整数 号, 整数 值)
{
    返回
}

// 把处理函数存进第 号 格(号 0～15,也就是订阅号);号不对不写、不报错。
方法 消息_存槽(整数 号, 回调 存_处理(整数, 整数))
{
    如果 (号 == 0)
    {
        消息_槽0 = 存_处理;
    }
    如果 (号 == 1)
    {
        消息_槽1 = 存_处理;
    }
    如果 (号 == 2)
    {
        消息_槽2 = 存_处理;
    }
    如果 (号 == 3)
    {
        消息_槽3 = 存_处理;
    }
    如果 (号 == 4)
    {
        消息_槽4 = 存_处理;
    }
    如果 (号 == 5)
    {
        消息_槽5 = 存_处理;
    }
    如果 (号 == 6)
    {
        消息_槽6 = 存_处理;
    }
    如果 (号 == 7)
    {
        消息_槽7 = 存_处理;
    }
    如果 (号 == 8)
    {
        消息_槽8 = 存_处理;
    }
    如果 (号 == 9)
    {
        消息_槽9 = 存_处理;
    }
    如果 (号 == 10)
    {
        消息_槽10 = 存_处理;
    }
    如果 (号 == 11)
    {
        消息_槽11 = 存_处理;
    }
    如果 (号 == 12)
    {
        消息_槽12 = 存_处理;
    }
    如果 (号 == 13)
    {
        消息_槽13 = 存_处理;
    }
    如果 (号 == 14)
    {
        消息_槽14 = 存_处理;
    }
    如果 (号 == 15)
    {
        消息_槽15 = 存_处理;
    }
    返回
}

// 同步调第 号 格存下的处理函数,实参是 号 与 值;号 0～15,越界不调。
方法 消息_调一格(整数 号, 整数 值)
{
    如果 (号 == 0)
    {
        间接调用(消息_槽0, 号, 值);
    }
    如果 (号 == 1)
    {
        间接调用(消息_槽1, 号, 值);
    }
    如果 (号 == 2)
    {
        间接调用(消息_槽2, 号, 值);
    }
    如果 (号 == 3)
    {
        间接调用(消息_槽3, 号, 值);
    }
    如果 (号 == 4)
    {
        间接调用(消息_槽4, 号, 值);
    }
    如果 (号 == 5)
    {
        间接调用(消息_槽5, 号, 值);
    }
    如果 (号 == 6)
    {
        间接调用(消息_槽6, 号, 值);
    }
    如果 (号 == 7)
    {
        间接调用(消息_槽7, 号, 值);
    }
    如果 (号 == 8)
    {
        间接调用(消息_槽8, 号, 值);
    }
    如果 (号 == 9)
    {
        间接调用(消息_槽9, 号, 值);
    }
    如果 (号 == 10)
    {
        间接调用(消息_槽10, 号, 值);
    }
    如果 (号 == 11)
    {
        间接调用(消息_槽11, 号, 值);
    }
    如果 (号 == 12)
    {
        间接调用(消息_槽12, 号, 值);
    }
    如果 (号 == 13)
    {
        间接调用(消息_槽13, 号, 值);
    }
    如果 (号 == 14)
    {
        间接调用(消息_槽14, 号, 值);
    }
    如果 (号 == 15)
    {
        间接调用(消息_槽15, 号, 值);
    }
    返回
}

// 第 号 格(0～15)恢复成占位处理:那一格空了,再调它什么都不做。
方法 消息_清槽(整数 号)
{
    如果 (号 == 0)
    {
        消息_槽0 = 地址(消息_占位);
    }
    如果 (号 == 1)
    {
        消息_槽1 = 地址(消息_占位);
    }
    如果 (号 == 2)
    {
        消息_槽2 = 地址(消息_占位);
    }
    如果 (号 == 3)
    {
        消息_槽3 = 地址(消息_占位);
    }
    如果 (号 == 4)
    {
        消息_槽4 = 地址(消息_占位);
    }
    如果 (号 == 5)
    {
        消息_槽5 = 地址(消息_占位);
    }
    如果 (号 == 6)
    {
        消息_槽6 = 地址(消息_占位);
    }
    如果 (号 == 7)
    {
        消息_槽7 = 地址(消息_占位);
    }
    如果 (号 == 8)
    {
        消息_槽8 = 地址(消息_占位);
    }
    如果 (号 == 9)
    {
        消息_槽9 = 地址(消息_占位);
    }
    如果 (号 == 10)
    {
        消息_槽10 = 地址(消息_占位);
    }
    如果 (号 == 11)
    {
        消息_槽11 = 地址(消息_占位);
    }
    如果 (号 == 12)
    {
        消息_槽12 = 地址(消息_占位);
    }
    如果 (号 == 13)
    {
        消息_槽13 = 地址(消息_占位);
    }
    如果 (号 == 14)
    {
        消息_槽14 = 地址(消息_占位);
    }
    如果 (号 == 15)
    {
        消息_槽15 = 地址(消息_占位);
    }
    返回
}

// ---- 对外 ----

// 订阅簿有几格(16)
方法 上限() 返回 整数
{
    返回 16;
}

// 登记一条订阅;返回订阅号(0 起),满了给 -1
方法 订阅(字符串 主题, 回调 订阅_处理(整数, 整数)) 返回 整数
{
    整数 i = 0;
    当 (i < 16)
    {
        如果 (消息_占用[i] == 假)
        {
            消息_主题[i] = 主题;
            消息_占用[i] = 真;
            消息_存槽(i, 订阅_处理);
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// 调那个主题上的**第一条**;返回 1 调了 / 0 没有
方法 发布(字符串 主题, 整数 值) 返回 整数
{
    返回 发布一个(主题, 0, 值);
}

// 只调**第 N 条**(0 起,按"这个主题上第几条"数);返回 1 调了 / 0 没有
方法 发布一个(字符串 主题, 整数 共几条, 整数 值) 返回 整数
{
    整数 i = 0;
    整数 见 = 0;
    当 (i < 16)
    {
        如果 (消息_占用[i] && 消息_主题[i] == 主题)
        {
            如果 (见 == 共几条)
            {
                消息_调一格(i, 值);
                返回 1;
            }
            见 = 见 + 1;
        }
        i = i + 1;
    }
    返回 0;
}

// 那个主题上**每一条**都调;返回调了几条
方法 发布全部(字符串 主题, 整数 值) 返回 整数
{
    整数 i = 0;
    整数 见 = 0;
    当 (i < 16)
    {
        如果 (消息_占用[i] && 消息_主题[i] == 主题)
        {
            消息_调一格(i, 值);
            见 = 见 + 1;
        }
        i = i + 1;
    }
    返回 见;
}

// 撤掉那个主题上的全部订阅;返回撤了几条
方法 退订(字符串 主题) 返回 整数
{
    整数 i = 0;
    整数 撤 = 0;
    当 (i < 16)
    {
        如果 (消息_占用[i] && 消息_主题[i] == 主题)
        {
            消息_占用[i] = 假;
            消息_主题[i] = "";
            消息_清槽(i);
            撤 = 撤 + 1;
        }
        i = i + 1;
    }
    返回 撤;
}

// 撤掉第 N 条;返回真 = 撤掉了
方法 退订一个(整数 号) 返回 逻辑
{
    如果 (号 < 0 || 号 >= 16)
    {
        返回 假;
    }
    如果 (消息_占用[号] == 假)
    {
        返回 假;
    }
    消息_占用[号] = 假;
    消息_主题[号] = "";
    消息_清槽(号);
    返回 真;
}

// 那个主题上还有订阅吗
方法 有订阅(字符串 主题) 返回 逻辑
{
    整数 i = 0;
    当 (i < 16)
    {
        如果 (消息_占用[i] && 消息_主题[i] == 主题)
        {
            返回 真;
        }
        i = i + 1;
    }
    返回 假;
}

// 现在一共几条订阅
方法 条数() 返回 整数
{
    整数 i = 0;
    整数 共 = 0;
    当 (i < 16)
    {
        如果 (消息_占用[i])
        {
            共 = 共 + 1;
        }
        i = i + 1;
    }
    返回 共;
}

// 第 N 条订阅的主题("" = 没这一条)
方法 主题(整数 号) 返回 字符串
{
    如果 (号 < 0 || 号 >= 16)
    {
        返回 "";
    }
    如果 (消息_占用[号] == 假)
    {
        返回 "";
    }
    返回 消息_主题[号];
}

// 订阅簿清空(回调槽一并复位)
方法 清掉()
{
    整数 i = 0;
    当 (i < 16)
    {
        消息_占用[i] = 假;
        消息_主题[i] = "";
        消息_清槽(i);
        i = i + 1;
    }
    返回
}
