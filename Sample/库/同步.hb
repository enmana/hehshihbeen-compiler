// ============================================================
// 同步.hb —— 重入保护 / 汇合 / 等待(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 用法:文件开头写 包含 "../../库/同步.hb";调用写 `同步.进锁(...)` / `同步.等到(...)`
//
// 单线程里那两件真事:① **重入** —— 回调里又触发同一个回调 ⇒ 递归爆栈(典型:"改了数据就重画"的处理
//   函数重画那一趟顺手改了数据),一把**锁**(嵌套深度计数)就够了,已经在里面就直接跳过这一次;
//   ② **汇合 / 等待** —— 等三件活都做完再往下走(门),或者"等某个条件成立,最多等这么久"(等到)。
//
//   ⚠ **不是线程安全那一套**。HB 是单线程:互斥量 / 条件变量 / 信号量是为**数据竞争**准备的,这里不需要。
//   与 `异步.hb` 的分工:`异步` 管"排着的活什么时候做",这一库管"现在能不能进 / 大家都到了没有"。
//
// 口径(2026-10,每条都对着实测写):
//   · **锁是一块"嵌套深度"**:`进锁` 成功 +1、`出锁` −1。**已经在里面**(深度 > 0)时 `进锁` 给假,
//     **让调用方自己跳过那一段** —— 不是阻塞(单线程里阻塞就是死锁):
//     `如果 (同步.进锁(锁)) { 干活(); 同步.出锁(锁); }`
//   · **锁要成对**:进了就得出的那条路上一定 `出锁`(早退 / 出错那一支也别落下);
//   · **门是"到了几件 / 要几件"**:`到门` 记一件,`门齐了吗` 看够不够;`清门` 把计数清回 0;
//   · **号 = 表里那一格的下标**(0 起、取最小空位)。`建锁` / `建门` 给号,**建不出来给 -1**(表满 8 格);
//     越界 / 号不对一律给假,不报错不停机;
//   · **`等到` 要有"谁去喂事件循环"**:它每一轮 ①跑一遍 `异步.跑一轮()` ②看条件成立没有。**定时器不归它管**
//     (那是 `定时.hb` 的事):轮子里也要走定时器,就在条件回调里顺手 `定时.推进()`;
//   · **两条上界与 `异步.等待` 同**:真时间(`当前毫秒()`,每轮看一次)+ 轮数(最多 `超时毫秒` 轮)⇒
//     同一份程序跑两次结果一样,机器忙时早一点收手;
//   · **条件怎么交给库**:回调**不能经参数转一手** ⇒ 先 `设条件(地址(我的条件))` 把它挂到槽 0~7 上,再
//     `等到`;条件回调**没有参数**、返回 `逻辑`(真 = 成立)。
//
// 提供的函数(17 个):锁五件 + 门五件 + 条件三件 + 等到 / 等刻度 / 进的次数 / 清空同步;
//   逐条见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:建 / 进 / 出 / 到 / 查都是 O(格数)= O(8);`等到` 是 O(轮数 × 一格任务表)。
// 内存账:两张定长小表(锁 / 门)+ 一排条件槽,一共几百字节;一个字符串都不造。
//
// 边界(如实登记):越界 / 号不对一律给假;锁与门都只 8 格(建不出来给 -1)。
// ============================================================
模块 同步

包含 "异步.hb"        // 同目录的库:路径按 `Sample\库\` 这一层算(与帮助站点读库同一套)

// 一屏一张表(与 `异步.hb` / `定时.hb` 的平行列同一个道理)
整数 锁有效[];          // 1 = 这一号建过
整数 锁层数表[];        // 现在嵌套了几层(0 = 不在里面)
整数 锁进过表[];        // 这一把锁成功进过几次
整数 门有效[];          // 1 = 这一号建过
整数 门要表[];          // 这道门要几件
整数 门到表[];          // 现在到了几件
回调 条件表0 = 地址(假条件);
回调 条件表1 = 地址(假条件);
回调 条件表2 = 地址(假条件);
回调 条件表3 = 地址(假条件);
回调 条件表4 = 地址(假条件);
回调 条件表5 = 地址(假条件);
回调 条件表6 = 地址(假条件);
回调 条件表7 = 地址(假条件);
整数 槽上限 = 8;        // 展开的槽就这几格(与文件头那段"语言面限制"一致)

// 占位条件:没挂条件的槽指向它(给"假" = 条件不成立,所以 `等到` 会一直等到超时)
方法 假条件() 返回 逻辑
{
    返回 假;
}

// ---------- 条件槽(语言面:回调不能进数组,只能展开成一排) ----------
// 私有:外面走 `设条件` / `清条件` 两个入口
私有 方法 同步装条件(整数 槽, 回调 处理)
{
    如果 (槽 == 0)
    {
        条件表0 = 处理;
        返回
    }
    如果 (槽 == 1)
    {
        条件表1 = 处理;
        返回
    }
    如果 (槽 == 2)
    {
        条件表2 = 处理;
        返回
    }
    如果 (槽 == 3)
    {
        条件表3 = 处理;
        返回
    }
    如果 (槽 == 4)
    {
        条件表4 = 处理;
        返回
    }
    如果 (槽 == 5)
    {
        条件表5 = 处理;
        返回
    }
    如果 (槽 == 6)
    {
        条件表6 = 处理;
        返回
    }
    如果 (槽 == 7)
    {
        条件表7 = 处理;
        返回
    }
    返回
}

私有 方法 同步卸条件(整数 槽)
{
    如果 (槽 == 0)
    {
        条件表0 = 地址(假条件);
        返回
    }
    如果 (槽 == 1)
    {
        条件表1 = 地址(假条件);
        返回
    }
    如果 (槽 == 2)
    {
        条件表2 = 地址(假条件);
        返回
    }
    如果 (槽 == 3)
    {
        条件表3 = 地址(假条件);
        返回
    }
    如果 (槽 == 4)
    {
        条件表4 = 地址(假条件);
        返回
    }
    如果 (槽 == 5)
    {
        条件表5 = 地址(假条件);
        返回
    }
    如果 (槽 == 6)
    {
        条件表6 = 地址(假条件);
        返回
    }
    如果 (槽 == 7)
    {
        条件表7 = 地址(假条件);
        返回
    }
    返回
}

// 条件槽的调用点:**只能直接写模块级那一格**,抽不成 `问第几槽(槽)` ——
// `间接调用` 的第一个实参必须是编译器认得的模块级那一格(与 `定时.hb` / `异步.hb` 同一个形状)。
// 所以下面这八个调用点**写两遍**:`等到` 与 `等刻度` 各一份。
//
// `等到` 与 `等刻度` 的差别只有"上界怎么给":
//   · `等到(槽, 超时毫秒)`   —— 超时毫秒既是**真时间**的上界(每轮看一次 `当前毫秒()`),
//     也是**轮数**的上界(最多跑那么多轮);两条先到哪个算哪个 ⇒ 结果可复现。
//   · `等刻度(槽, 超时刻度)` —— 只看 `异步.现在刻度()` 涨了多少轮,**一眼不看机器钟**
//     (自检与固定步长的动画要的就是这个)。两处都按"到了就给真"写。

// 一边跑一边等条件成立(成立给真;超时 / 槽空给假)
方法 等到(整数 槽, 整数 超时毫秒) 返回 逻辑
{
    如果 (槽 < 0 || 槽 >= 槽上限)
    {
        返回 假;
    }
    整数 起 = 当前毫秒();
    整数 限 = 超时毫秒;
    如果 (限 < 1)
    {
        限 = 1;
    }
    整数 轮 = 0;
    当 (轮 < 限)
    {
        如果 (槽 == 0)
        {
            如果 (间接调用(条件表0))
            {
                返回 真;
            }
        }
        否则
        {
            如果 (槽 == 1)
            {
                如果 (间接调用(条件表1))
                {
                    返回 真;
                }
            }
            否则
            {
                如果 (槽 == 2)
                {
                    如果 (间接调用(条件表2))
                    {
                        返回 真;
                    }
                }
                否则
                {
                    如果 (槽 == 3)
                    {
                        如果 (间接调用(条件表3))
                        {
                            返回 真;
                        }
                    }
                    否则
                    {
                        如果 (槽 == 4)
                        {
                            如果 (间接调用(条件表4))
                            {
                                返回 真;
                            }
                        }
                        否则
                        {
                            如果 (槽 == 5)
                            {
                                如果 (间接调用(条件表5))
                                {
                                    返回 真;
                                }
                            }
                            否则
                            {
                                如果 (槽 == 6)
                                {
                                    如果 (间接调用(条件表6))
                                    {
                                        返回 真;
                                    }
                                }
                                否则
                                {
                                    如果 (槽 == 7)
                                    {
                                        如果 (间接调用(条件表7))
                                        {
                                            返回 真;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        异步.跑一轮();
        轮 = 轮 + 1;
        如果 (当前毫秒() - 起 >= 超时毫秒)
        {
            跳出;                          // 真时间到了:收手
        }
    }
    返回 假;
}

// 同 `等到`,但**看刻度不看机器钟**
方法 等刻度(整数 槽, 整数 超时刻度) 返回 逻辑
{
    如果 (槽 < 0 || 槽 >= 槽上限)
    {
        返回 假;
    }
    整数 限 = 超时刻度;
    如果 (限 < 1)
    {
        限 = 1;
    }
    整数 起 = 异步.现在刻度();
    当 (异步.现在刻度() - 起 < 限)
    {
        如果 (槽 == 0)
        {
            如果 (间接调用(条件表0))
            {
                返回 真;
            }
        }
        否则
        {
            如果 (槽 == 1)
            {
                如果 (间接调用(条件表1))
                {
                    返回 真;
                }
            }
            否则
            {
                如果 (槽 == 2)
                {
                    如果 (间接调用(条件表2))
                    {
                        返回 真;
                    }
                }
                否则
                {
                    如果 (槽 == 3)
                    {
                        如果 (间接调用(条件表3))
                        {
                            返回 真;
                        }
                    }
                    否则
                    {
                        如果 (槽 == 4)
                        {
                            如果 (间接调用(条件表4))
                            {
                                返回 真;
                            }
                        }
                        否则
                        {
                            如果 (槽 == 5)
                            {
                                如果 (间接调用(条件表5))
                                {
                                    返回 真;
                                }
                            }
                            否则
                            {
                                如果 (槽 == 6)
                                {
                                    如果 (间接调用(条件表6))
                                    {
                                        返回 真;
                                    }
                                }
                                否则
                                {
                                    如果 (槽 == 7)
                                    {
                                        如果 (间接调用(条件表7))
                                        {
                                            返回 真;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        异步.跑一轮();
    }
    返回 假;
}

// 把"条件函数"挂到 0~7 号槽上(越界给假)
方法 设条件(整数 槽, 回调 处理) 返回 逻辑
{
    如果 (槽 < 0 || 槽 >= 槽上限)
    {
        返回 假;
    }
    同步装条件(槽, 处理);
    返回 真;
}

// 摘掉那一槽
方法 清条件(整数 槽) 返回 逻辑
{
    如果 (槽 < 0 || 槽 >= 槽上限)
    {
        返回 假;
    }
    同步卸条件(槽);
    返回 真;
}

// ---------- 锁 ----------
// 找一个空位(取最小空位);表没满就先长一格。给号,满了给 -1
私有 方法 同步找锁位() 返回 整数
{
    整数 个数 = 锁有效.长度();
    整数 空位 = -1;
    整数 i = 0;
    当 (i < 个数)
    {
        如果 (锁有效[i] == 0)
        {
            空位 = i;
            跳出;
        }
        i = i + 1;
    }
    如果 (空位 < 0)
    {
        如果 (个数 >= 槽上限)
        {
            返回 -1;
        }
        空位 = 个数;
        锁有效.添加(0);
        锁层数表.添加(0);
        锁进过表.添加(0);
    }
    返回 空位;
}
私有 方法 同步锁号对吗(整数 锁) 返回 逻辑
{
    整数 个数 = 锁有效.长度();
    如果 (锁 < 0 || 锁 >= 个数)
    {
        返回 假;
    }
    返回 锁有效[锁] != 0;
}

// 要一把锁(号;建不出来给 -1)
方法 建锁() 返回 整数
{
    整数 位 = 同步找锁位();
    如果 (位 < 0)
    {
        返回 -1;
    }
    锁有效[位] = 1;
    锁层数表[位] = 0;
    锁进过表[位] = 0;
    返回 位;
}

// 进得去给真(顺手 +1);**已经在里面给假,让调用方跳过**
方法 进锁(整数 锁) 返回 逻辑
{
    如果 (!同步锁号对吗(锁))
    {
        返回 假;
    }
    如果 (锁层数表[锁] > 0)
    {
        返回 假;                        // 已经在里面:这一趟让最外层去做
    }
    锁层数表[锁] = 锁层数表[锁] + 1;
    锁进过表[锁] = 锁进过表[锁] + 1;
    返回 真;
}

// 出一层(没进过 / 号不对给假)
方法 出锁(整数 锁) 返回 逻辑
{
    如果 (!同步锁号对吗(锁))
    {
        返回 假;
    }
    如果 (锁层数表[锁] <= 0)
    {
        返回 假;
    }
    锁层数表[锁] = 锁层数表[锁] - 1;
    返回 真;
}

// 现在是不是在里面
方法 在锁里吗(整数 锁) 返回 逻辑
{
    如果 (!同步锁号对吗(锁))
    {
        返回 假;
    }
    返回 锁层数表[锁] > 0;
}

// 嵌套了几层
方法 锁层数(整数 锁) 返回 整数
{
    如果 (!同步锁号对吗(锁))
    {
        返回 -1;
    }
    返回 锁层数表[锁];
}

// 这一把锁成功进过几次
方法 进的次数(整数 锁) 返回 整数
{
    如果 (!同步锁号对吗(锁))
    {
        返回 -1;
    }
    返回 锁进过表[锁];
}

// ---------- 门 ----------
私有 方法 同步找门位() 返回 整数
{
    整数 个数 = 门有效.长度();
    整数 空位 = -1;
    整数 i = 0;
    当 (i < 个数)
    {
        如果 (门有效[i] == 0)
        {
            空位 = i;
            跳出;
        }
        i = i + 1;
    }
    如果 (空位 < 0)
    {
        如果 (个数 >= 槽上限)
        {
            返回 -1;
        }
        空位 = 个数;
        门有效.添加(0);
        门要表.添加(0);
        门到表.添加(0);
    }
    返回 空位;
}

私有 方法 同步门号对吗(整数 门) 返回 逻辑
{
    整数 个数 = 门有效.长度();
    如果 (门 < 0 || 门 >= 个数)
    {
        返回 假;
    }
    返回 门有效[门] != 0;
}

// 要一道门(号;建不出来给 -1)
方法 建门(整数 要几件) 返回 整数
{
    整数 位 = 同步找门位();
    如果 (位 < 0)
    {
        返回 -1;
    }
    如果 (要几件 < 1)
    {
        要几件 = 1;
    }
    门有效[位] = 1;
    门要表[位] = 要几件;
    门到表[位] = 0;
    返回 位;
}

// 记一件"到了"
方法 到门(整数 门) 返回 逻辑
{
    如果 (!同步门号对吗(门))
    {
        返回 假;
    }
    门到表[门] = 门到表[门] + 1;
    返回 真;
}

// 够了没有
方法 门齐了吗(整数 门) 返回 逻辑
{
    如果 (!同步门号对吗(门))
    {
        返回 假;
    }
    返回 门到表[门] >= 门要表[门];
}

// 现在到了几件
方法 门计数(整数 门) 返回 整数
{
    如果 (!同步门号对吗(门))
    {
        返回 -1;
    }
    返回 门到表[门];
}

// 计数清回 0(下一轮再用)
方法 清门(整数 门) 返回 逻辑
{
    如果 (!同步门号对吗(门))
    {
        返回 假;
    }
    门到表[门] = 0;
    返回 真;
}

// ---------- 清空 ----------
// 锁 / 门 / 条件槽全归零
方法 清空同步()
{
    锁有效.清空();
    锁层数表.清空();
    锁进过表.清空();
    门有效.清空();
    门要表.清空();
    门到表.清空();
    整数 i = 0;
    当 (i < 槽上限)
    {
        同步卸条件(i);
        i = i + 1;
    }
    返回
}
