// ============================================================
// 模型.hb —— **把"读一个 .obj 进网格"这件事包成一句**
//
// 用法(最短的两句):
// ```
// 包含 "../库/三维数学.hb"
// 包含 "../库/三维网格.hb"
// 包含 "../库/模型.hb"
//
// 如果 (模型.装进网格("Sample/模型/人头肩/头肩.obj"))    // ① 读 + 装,一句
// {
//     三维网格.眼距 = 8.0;  三维网格.焦距 = 3200.0;
//     三维网格.画心x = 320.0;  三维网格.画心y = 330.0;
//     三维网格.画实心带光(0xFFD8CFC0);
// }
// 否则
// {
//     输出行(模型.上次错());        // ② 人话:打不开 / 不是 OBJ / 装不下
//     输出行(模型.要几颗顶点());  输出行(模型.要几条边());  输出行(模型.要几个面());
//     输出行(模型.大档有多少颗());  输出行(模型.大档有多少条());  输出行(模型.大档有多少个());
// }
// ```
//
// ★★ **不用猜上限**:`装` / `装进网格` 一进来**先只读探查一次** —— 拿三个 4 字节"桩块"、容量各给 1,
//   问宿主"这份模型本来多大"。宿主**先判容量、后写块** ⇒ 这一趟**一个字节都不写**,报回来的三个数
//   就是**真实规模**。于是:装得下就自动挑最小那一档;小档不够**自动升到大档**;两档都不够 ⇒ 错码 3,
//   `要几颗 / 要几条 / 要几个` 给真实规模,`大档有多少*` 给本库能收多少。要手动钉死内存占用仍可用
//   `开小()` / `开中()` / `开大()`。
//
// 宿主能力 56 `读取模型` 是一把**低层工具**:要调用方自己申请三块、自己算字节数、自己配三个编译期上限、
//   自己去块里读四个整数。本库把这四件事收成"**开一次 / 装一次**":缓冲按上限申请一次、状态码翻译成人话、
//   装不下时把"**要多少 vs 有多少**"逐项摆出来。
//
// 口径(2026-10):
//   · **一次只装一份 `.obj`**:`装(路径)` 读一份;`装进网格(路径)` 读一份并顺带装进 `三维网格`
//     (内部先 `三维网格.清空()` ⇒ "装进网格"是**替换**,不是叠加);
//   · **上限在 `开()` 里一次定死**;边块由本库按"顶点上限 × 2"**自动配**;
//   · **不报错、不停机**:读不成给假,**哪一项不够**用 `要几颗顶点 / 要几条边 / 要几个面` 三个数问;
//   · **宿主会把读到的顶点归一化**(包围盒居中 + 最长边缩到 2 个单位),本库照原样传;
//   · ⚠ **多件拼装要当心**:归一化是**逐次**的,四件分开读会**各自**被缩放到 2 个单位(小的那件被放得很大)
//     ⇒ 多件请在盘上先拼成**一份** `.obj` 再读。
//
// 提供的函数(18 个):`装` / `装进网格` / `探查` 三大件 + 规模与上限那一族(`要几颗顶点` / `顶点上限` /
//   `大档有多少*`)+ 错码与错话(`上次错码` / `上次错`);逐条见本页末尾那张公开方法表。
//
// 英文对照(库里不另立英文函数):装 load · 装进网格 loadIntoGrid · 探查 probe · 清掉 clear
//
// 复杂度:`装` 与 `.obj` 行数成正比(宿主那一趟);装进网格额外 O(顶点数 + 面数)。
//
// 内存账(实测口径):
//   `装` 先只读探查、再**按实测规模挑最小那一档**,只申请要用到的那一块 ——
//     · 一档 300 / 900 / 700 ⇒ 19.2 KB —— 默认 64 KB 堆随便跑;
//     · 二档 550 / 1700 / 1350 ⇒ 36.4 KB —— 默认 64 KB 堆实测跑得动(真人头那份就是它);
//     · 三档 1300 / 4500 / 2600 ⇒ 82.8 KB —— 工程文件写 `"堆": "128KB"`;
//     · 四档 2600 / 9000 / 5200 ⇒ 165.6 KB —— 工程文件写 `"堆": "256KB"`。
//   探查那三个桩块 = 12 + 8 + 12 = **32 字节**(固定,忽略不计)。
//   ⚠ **边块也占地方**,别只按"顶点 + 面"算(闭合网格的边数约为顶点数的 3 倍,这正是"按顶点挑档、
//     边先爆"的原因);⚠ 峰值不只有缓冲:宿主读文件时**整份文本也在同一块堆里**,大文件 + 大档要一起算。
//
// 边界(如实登记):
//   · 上限就是上限:超过就给"装不下"并**如实报"要多少"**(不会截一半给你);
//   · 一份模型一份缓冲:要同时留两份模型,就自己申请两套 + 直接调宿主能力;
//   · 模块级变量一律带 `模型_` 前缀(模块级私有变量会与调用方顶层同名变量共用一格)。
// ============================================================

模块 模型

地址 模型_顶点区 = 0;
地址 模型_边区 = 0;
地址 模型_面区 = 0;
地址 模型_条数区 = 0;
整数 模型_顶点上限 = 0;
整数 模型_面上限 = 0;
整数 模型_边上限 = 0;
整数 模型_入顶点数 = 0;
整数 模型_入面数 = 0;
逻辑 模型_是大档 = 假;
整数 模型_错码 = 0;
整数 模型_要顶点 = 0;
整数 模型_要边 = 0;
整数 模型_要面 = 0;
逻辑 模型_探查过了 = 假;
// 只读探查用的三个**桩块**:各 4 字节,一辈子只用这一格(装不下 ⇒ 宿主一个字节都不往里写)
地址 模型_桩顶点 = 0;
地址 模型_桩边 = 0;
地址 模型_桩面 = 0;

// 本库当前这一档的顶点上限
方法 顶点上限() 返回 整数
{
    返回 模型_顶点上限;
}

// 本库当前这一档的面上限
方法 面上限() 返回 整数
{
    返回 模型_面上限;
}

// 本库当前这一档的边上限(按"顶点上限 × 2"自动配)
方法 边上限() 返回 整数
{
    返回 模型_边上限;
}

// 上一趟的规模:顶点数
方法 顶点数() 返回 整数
{
    返回 模型_入顶点数;
}

// 上一趟的规模:面数
方法 面数() 返回 整数
{
    返回 模型_入面数;
}

// 0 没错 / 1 打不开 / 2 不是 OBJ / 3 装不下 / 4 没先 `开` / 5 网格计数对不上 / 6 网格自己装不下 / 7 堆不够开缓冲
方法 上次错码() 返回 整数
{
    返回 模型_错码;
}

// 装不下时:这一份**真实需要**几颗顶点
方法 要几颗顶点() 返回 整数
{
    返回 模型_要顶点;
}

// 装不下时:这一份**真实需要**几条边
方法 要几条边() 返回 整数
{
    返回 模型_要边;
}

// 装不下时:这一份**真实需要**几个面
方法 要几个面() 返回 整数
{
    返回 模型_要面;
}

// 上一趟探查成没成
方法 探查过了() 返回 逻辑
{
    返回 模型_探查过了;
}

// 调试用(公开):把内部那几格状态一口气倒出来 —— ①顶点上限 ②边上限 ③面上限 ④探查过了
//   为什么要有它:换档 / 挑档那几步**全在库里**,外面只看得到最后那三个数;
//   出岔子时要能一眼看出"它以为自己在哪一档、探到的数是多少"。
方法 状态(整数 问什么) 返回 整数
{
    如果 (问什么 == 0)
    {
        返回 模型_顶点上限;
    }
    如果 (问什么 == 1)
    {
        返回 模型_边上限;
    }
    如果 (问什么 == 2)
    {
        返回 模型_面上限;
    }
    如果 (问什么 == 3)
    {
        如果 (模型_探查过了)
        {
            返回 1;
        }
        返回 0;
    }
    如果 (问什么 == 4)
    {
        返回 模型_桩顶点;
    }
    如果 (问什么 == 5)
    {
        返回 模型_条数区;
    }
    如果 (问什么 == 8)
    {
        返回 模型_错码;
    }
    如果 (问什么 == 9)
    {
        返回 模型_要顶点;
    }
    如果 (问什么 == 10)
    {
        返回 模型_要边;
    }
    如果 (问什么 == 11)
    {
        返回 模型_要面;
    }
    返回 模型_入顶点数;
}

// ============================================================
// 四档容量表(**按"装得下多少"分档,不按"分配多少"分档**)
// ============================================================
// 为什么要分四档(2026-10-10 晚实测出来的账):三块缓冲的大小是**编译期定死**的
//   (`读取模型` 的三个上限必须是字面量),所以"一份模型要多大缓冲"只能做成一串台阶。
//   台阶按**实测的 OBJ 形状**定(顶点 / 边 / 面 ≈ 1 : 3 : 2 —— 闭合三角网格就是这个比例):
//
//   | 档 | 顶点 | 边 | 面 | 三块缓冲 | 谁用这一档 |
//   |---|---|---|---|---|---|
//   | 一 | 300 | 900 | 700 | 3.6 + 7.2 + 8.4 = **19.2 KB** | 小件(球带面、四面体) |
//   | 二 | 550 | 1700 | 1350 | 6.6 + 13.6 + 16.2 = **36.4 KB** | **真人头那一档**(527 / 1555 / 1081) |
//   | 三 | 1300 | 4500 | 2600 | 15.6 + 36 + 31.2 = **82.8 KB** | 更大的角色 |
//   | 四 | 2600 | 9000 | 5200 | 31.2 + 72 + 62.4 = **165.6 KB** | 大件(要用大堆) |
//
// ⇒ **默认 64 KB 堆:一档与二档随便跑**(二档 36.4 KB 是最要紧的那一档),
//   三档要 `"堆": "128KB"`、四档要 `"堆": "256KB"`。
// ⚠ 老的"小档 1300/2500/2200 = 62 KB"那一版**默认堆都喂不饱**(实测:`申请` 当场失败)——
//   根子不在"档太小",在**一次要得太多**。现在按实测形状给比例,同样的堆能多装一倍。
方法 一档顶点() 返回 整数
{
    返回 300;
}

// 一档(最小那一档)能收的边数,给 900 条。
方法 一档边() 返回 整数
{
    返回 900;
}

// 一档(最小那一档)能收的面数,给 700 个。
方法 一档面() 返回 整数
{
    返回 700;
}

// 二档(真人头那一档)能收的顶点数,给 550 个。
方法 二档顶点() 返回 整数
{
    返回 550;
}

// 二档(真人头那一档)能收的边数,给 1700 条。
方法 二档边() 返回 整数
{
    返回 1700;
}

// 二档(真人头那一档)能收的面数,给 1350 个。
方法 二档面() 返回 整数
{
    返回 1350;
}

// 三档(更大角色那一档)能收的顶点数,给 1300 个。
方法 三档顶点() 返回 整数
{
    返回 1300;
}

// 三档(更大角色那一档)能收的边数,给 4500 条。
方法 三档边() 返回 整数
{
    返回 4500;
}

// 三档(更大角色那一档)能收的面数,给 2600 个。
方法 三档面() 返回 整数
{
    返回 2600;
}

// 四档(最大那一档)能收的顶点数,给 2600 个。
方法 四档顶点() 返回 整数
{
    返回 2600;
}

// 四档(最大那一档)能收的边数,给 9000 条。
方法 四档边() 返回 整数
{
    返回 9000;
}

// 四档(最大那一档)能收的面数,给 5200 个。
方法 四档面() 返回 整数
{
    返回 5200;
}

// 本库**最大那一档**(四档)的三个数 —— 给"装不下"时比一比用。
//   为什么单列这三个:`顶点上限()` / `面上限()` 报的是**当前**那一档,
//   而"装不下"的时候调用方要知道的是"最多能收多少"。
方法 大档有多少颗() 返回 整数
{
    返回 2600;
}

// 本库**最大那一档**能收几条边
方法 大档有多少条() 返回 整数
{
    返回 9000;
}

// 本库**最大那一档**能收几个面
方法 大档有多少个() 返回 整数
{
    返回 5200;
}

// 探查到的那一份,四档收不收得下(三个数一起判)
方法 适合大档() 返回 逻辑
{
    如果 (模型_要顶点 <= 2600 && 模型_要边 <= 9000 && 模型_要面 <= 5200)
    {
        返回 真;
    }
    返回 假;
}

// 四档各收不收得下(给"该开哪一档"用)
方法 符合一档() 返回 逻辑
{
    如果 (模型_要顶点 <= 300 && 模型_要边 <= 900 && 模型_要面 <= 700)
    {
        返回 真;
    }
    返回 假;
}

// 二档收不收得下探查到的那一份(顶点≤550 且边≤1700 且面≤1350)。
方法 符合二档() 返回 逻辑
{
    如果 (模型_要顶点 <= 550 && 模型_要边 <= 1700 && 模型_要面 <= 1350)
    {
        返回 真;
    }
    返回 假;
}

// 三档收不收得下探查到的那一份(顶点≤1300 且边≤4500 且面≤2600)。
方法 符合三档() 返回 逻辑
{
    如果 (模型_要顶点 <= 1300 && 模型_要边 <= 4500 && 模型_要面 <= 2600)
    {
        返回 真;
    }
    返回 假;
}

// 四档收不收得下探查到的那一份(顶点≤2600 且边≤9000 且面≤5200)。
方法 符合四档() 返回 逻辑
{
    如果 (模型_要顶点 <= 2600 && 模型_要边 <= 9000 && 模型_要面 <= 5200)
    {
        返回 真;
    }
    返回 假;
}

// ============================================================
// ★★ 只读探查:量一份 `.obj` **真实多大**,一个字节都不写
// ============================================================
// 怎么做到的(2026-10-10 实测):宿主 `读取模型` 是**先判容量、后写块** ——
//   三个块地址给三个 4 字节的桩块、三个容量各给 **1**,任何非空模型都判"装不下",
//   于是它把**真实条数**写进条数块、把状态码写成 3,然后**直接返回**,四个写块都到不了。
//   实测:桩块里预埋记号(1234567 / 7654321 / 1111111),跑完三个记号原样 ⇒ 确实没写。
//
// ⚠ **容量不许给 0**:中间层当场报"`顶点上限` 不能是 0(块是空的就没意义)" —— 给 1 才行。
// ⚠ 桩块**每次探查前重申请一遍**(先释放):探查这一趟不占别的内存,而"装"那一步要申请真缓冲,
//   不腾出来就是白占 32 字节(无所谓,但白占着不如还回去 —— 这一库的账要算得清)。
私有 方法 模型探查开桩() 返回 逻辑
{
    如果 (模型_桩顶点 == 0)
    {
        模型_桩顶点 = 申请(12);
    }
    如果 (模型_桩边 == 0)
    {
        模型_桩边 = 申请(8);
    }
    如果 (模型_桩面 == 0)
    {
        模型_桩面 = 申请(12);
    }
    如果 (模型_条数区 == 0)
    {
        模型_条数区 = 申请(16);
    }
    如果 (模型_桩顶点 == 0 || 模型_桩边 == 0 || 模型_桩面 == 0 || 模型_条数区 == 0)
    {
        返回 假;
    }
    返回 真;
}

// 量一份模型(公开,可以自己调:换了模型先量一眼再决定要不要装)
//   成了 ⇒ 真,`要几颗顶点/要几条边/要几个面` 是**真实规模**;
//   不成 ⇒ 假,`上次错码` 说为什么(1 打不开 / 2 不是 OBJ)。
方法 探查(字符串 路径) 返回 逻辑
{
    模型_探查过了 = 假;
    模型_要顶点 = 0;
    模型_要边 = 0;
    模型_要面 = 0;
    模型_错码 = 0;
    如果 (模型探查开桩() == 假)
    {
        模型_错码 = 4;
        返回 假;
    }
    逻辑 成 = 读取模型(路径, 模型_桩顶点, 模型_桩边, 模型_桩面, 1, 1, 1, 模型_条数区);
    // 返回值照旧是"这一趟成没成" —— 装不下那一路它也是真,所以**成不成看条数块**
    如果 (成 == 假)
    {
        模型_错码 = 1;
        返回 假;
    }
    整数 顶点数 = 整数(取字(模型_条数区, 0));
    整数 边数 = 整数(取字(模型_条数区, 4));
    整数 面数 = 整数(取字(模型_条数区, 8));
    整数 状态 = 整数(取字(模型_条数区, 12));
    如果 (状态 == 1)
    {
        模型_错码 = 1;
        返回 假;
    }
    如果 (状态 == 2)
    {
        模型_错码 = 2;
        返回 假;
    }
    // ⚠ 探查这一路**状态码必然是 3**(三个上限给 1,任何非空模型都装不下)⇒ 只要不是 1/2 就当探到了。
    //   状态 0 也当"探到了":只有**空模型**才会三个上限给 1 还装得下 —— 那一份顶点数为 0,
    //   与状态 2 同一条路(不是 OBJ),这里统一处理,免得调用方拿到"探查成、顶点 0"。
    如果 (顶点数 <= 0)
    {
        模型_错码 = 2;
        返回 假;
    }
    模型_要顶点 = 顶点数;
    模型_要边 = 边数;
    模型_要面 = 面数;
    模型_探查过了 = 真;
    返回 真;
}

// 人话。⚠ 这门语言**字符串不能拼**(实测报"字符串不能当数字用"),所以这里按项分支:
//   装不下时把三行数字分别摆出来(调用方 `输出行` 三次数就够),错在哪儿由 `上次错码` 说。
方法 上次错() 返回 字符串
{
    如果 (模型_错码 == 1)
    {
        返回 "打不开这个文件(路径对不对?盘上有没有?)";
    }
    如果 (模型_错码 == 2)
    {
        返回 "这个文件里没有顶点 —— 不是 Wavefront .obj 吧";
    }
    如果 (模型_错码 == 3)
    {
        返回 "装不下 —— 用 `要几颗顶点/几条边/几个面` 三行数字比一比 `大档有多少*`";
    }
    如果 (模型_错码 == 4)
    {
        返回 "缓冲没申请出来(堆不够?先 `模型.装(...)` 或 `模型.开小()`)";
    }
    如果 (模型_错码 == 5)
    {
        返回 "网格里的计数与读进来的对不上(装的过程出了岔子)";
    }
    如果 (模型_错码 == 6)
    {
        返回 "网格自己收不下这么多顶点/面(这份模型太大了)";
    }
    如果 (模型_错码 == 7)
    {
        返回 "堆不够开缓冲 —— 工程文件里把 `堆` 配大(大档要 88KB,写 `128KB`)";
    }
    返回 "没错";
}

// 申请缓冲。
//
// ⚠ **为什么这里只能"两档定死"**(2026-10-10 实测踩到):
//   宿主 `读取模型` 的三个上限**必须是编译期数字**(中间层当场报"要写一个编译期数字"),
//   而形参是**运行期的** ⇒ 没法把它们直接传下去。所以本库开两档:
//     · `开小()` —— 顶点 1300 / 边 2500 / 面 2200 ⇒ 15.6 + 20 + 26.4 = **62 KB**
//       ⇒ **默认 64 KB 堆就装得下**(从 IDE 跑、直接 `hbcc 主程序.hb --run` 跑都一样);
//     · `开大()` —— 顶点 2000 / 边 4000 / 面 2600 ⇒ 24 + 32 + 31.2 = **87.2 KB**
//       ⇒ 工程文件里要写 `"堆": "128KB"`。
//   **一般不用手动挑**(`装` 自己会探查、会挑、会升档,见文件头 ★★ 那段);
//   这两个留着手动用 = "我就想钉死内存占用"的场合。
//   要更大就自己 `申请` + 直接调宿主能力(那条路见 `示例56_读OBJ模型`)。
// ============================================================
// 开缓冲(四档)
// ============================================================
//   · `开(预期顶点数)` —— **按个数挑档**(最常用:`模型.开(600)` 就够真人头那一份);
//   · `开小()` / `开大()` / `开中()` —— 手动钉死一档(想控制内存占用时用);
//   · **一般连 `开` 都不用写**:`装` / `装进网格` 自己会探查、会挑档、会在需要时升一档。
//
// ⚠ 这一档收不收得下要**三个数一起看**(顶点 / 边 / 面)—— 只看顶点会挑小:
//   实测"527 顶点"的那一份要 **1555 条边**(闭合网格边数约为顶点数的 3 倍),
//   按"给顶点留点余量"挑档 ⇒ 边先爆。
方法 开(整数 预期顶点数) 返回 逻辑
{
    如果 (预期顶点数 <= 300)
    {
        返回 开一档();
    }
    如果 (预期顶点数 <= 550)
    {
        返回 开二档();
    }
    如果 (预期顶点数 <= 1300)
    {
        返回 开三档();
    }
    返回 开四档();
}

// 手动钉死:用一档(不挑就用"装"里那套自动的)
方法 开小() 返回 逻辑
{
    返回 开一档();
}

// 手动钉死:用二档
方法 开中() 返回 逻辑
{
    返回 开二档();
}

// 手动钉死:用四档
方法 开大() 返回 逻辑
{
    返回 开四档();
}

// 一档:300 / 900 / 700 ⇒ 19.2 KB
方法 开一档() 返回 逻辑
{
    模型_是大档 = 假;
    模型还缓冲();
    模型_顶点区 = 申请(300 * 12);
    模型_边区 = 申请(900 * 8);
    模型_面区 = 申请(700 * 12);
    如果 (模型缓冲够开() == 假)
    {
        模型_错码 = 7;
        返回 假;
    }
    模型_顶点上限 = 300;
    模型_边上限 = 900;
    模型_面上限 = 700;
    模型_错码 = 0;
    返回 真;
}

// 二档:550 / 1700 / 1350 ⇒ 36.4 KB(**真人头那一档**)
方法 开二档() 返回 逻辑
{
    模型_是大档 = 假;
    模型还缓冲();
    模型_顶点区 = 申请(550 * 12);
    模型_边区 = 申请(1700 * 8);
    模型_面区 = 申请(1350 * 12);
    如果 (模型缓冲够开() == 假)
    {
        模型_错码 = 7;
        返回 假;
    }
    模型_顶点上限 = 550;
    模型_边上限 = 1700;
    模型_面上限 = 1350;
    模型_错码 = 0;
    返回 真;
}

// 三档:1300 / 4500 / 2600 ⇒ 82.8 KB(工程里要写 `"堆": "128KB"`)
方法 开三档() 返回 逻辑
{
    模型_是大档 = 假;
    模型还缓冲();
    模型_顶点区 = 申请(1300 * 12);
    模型_边区 = 申请(4500 * 8);
    模型_面区 = 申请(2600 * 12);
    如果 (模型缓冲够开() == 假)
    {
        模型_错码 = 7;
        返回 假;
    }
    模型_顶点上限 = 1300;
    模型_边上限 = 4500;
    模型_面上限 = 2600;
    模型_错码 = 0;
    返回 真;
}

// 四档:2600 / 9000 / 5200 ⇒ 165.6 KB(工程里要写 `"堆": "256KB"`)
方法 开四档() 返回 逻辑
{
    模型_是大档 = 真;
    模型还缓冲();
    模型_顶点区 = 申请(2600 * 12);
    模型_边区 = 申请(9000 * 8);
    模型_面区 = 申请(5200 * 12);
    如果 (模型缓冲够开() == 假)
    {
        模型_错码 = 7;
        返回 假;
    }
    模型_顶点上限 = 2600;
    模型_边上限 = 9000;
    模型_面上限 = 5200;
    模型_错码 = 0;
    返回 真;
}

// 只还三个"装模型"的缓冲(**条数区留着** —— 探查与"要多少"都要用它)。
//   ⚠ 换档那一步必须**先还再要**(实测过:不还的话峰值 = 两档相加 ⇒ 当场 `申请` 失败,
//   而换档本来就是给"这一档不够"的场合准备的 —— 一失败就白搭)。
私有 方法 模型还缓冲()
{
    如果 (模型_顶点区 != 0)
    {
        释放(模型_顶点区);
        模型_顶点区 = 0;
    }
    如果 (模型_边区 != 0)
    {
        释放(模型_边区);
        模型_边区 = 0;
    }
    如果 (模型_面区 != 0)
    {
        释放(模型_面区);
        模型_面区 = 0;
    }
    返回
}
// 清掉库里的状态(探查结果 / 缓冲 / 当前档)
方法 清掉()
{
    如果 (模型_顶点区 != 0)
    {
        释放(模型_顶点区);
        模型_顶点区 = 0;
    }
    如果 (模型_边区 != 0)
    {
        释放(模型_边区);
        模型_边区 = 0;
    }
    如果 (模型_面区 != 0)
    {
        释放(模型_面区);
        模型_面区 = 0;
    }
    如果 (模型_条数区 != 0)
    {
        释放(模型_条数区);
        模型_条数区 = 0;
    }
    模型_入顶点数 = 0;
    模型_入面数 = 0;
    返回
}

// 读一份 `.obj`。成不成看返回值;装不下时 `要几颗顶点/几条边/几个面` 给**真实规模**。
//
// ★ 进来按四步走(**这就是"不用猜上限"**):
//   ① **每次装每次装都先只读探查一遍**:拿**这一份**的真规模;
//   ② 没开过缓冲 ⇒ 按真规模**挑最小那一档**开;
//   ③ 当前这一档收不下、而更大一档收得下 ⇒ **自动升一档**再读;
//   ④ 四档都收不下 ⇒ 错码 3,`要几颗/要几条/要几个` 给真实规模,`大档有多少*` 给能收多少;
//      ⚠ 这一路**不再申请大缓冲**(申请了也是白申请,还会把真话顶掉)。
//
// ⚠ **每一档各写一套字面量**:宿主的上限必须是编译期数字,所以"哪一档"要落在**字面量**上
//   —— 不能拿 `模型_顶点上限` 那个运行期值去传(那是给调用方看的账,不是给宿主的)。
方法 装(字符串 路径) 返回 逻辑
{
    // ★ **先把上一份的缓冲还回去再探查**(2026-10-11 实测):探查本身不占大块内存,
    //   而换档要靠下一次 `申请` 拿到地方 —— 旧缓冲不还,那次申请就会在
    //   "堆里明明还有余量、却拼不出一整块"的情况下失败(实测:连着换三份不同大小就撞上)。
    模型还缓冲();
    如果 (探查(路径) == 假)
    {
        返回 假;
    }
    // ⚠ **先判"四档都收不下"那一档**:那一路**不许再申请大缓冲** ——
    //   反正一个字节都不会写(宿主先判容量),为它申请 165 KB 只会在小堆上
    //   先报"申请失败"(把真正的"装不下 + 要多少"顶掉,实测就是这么翻车的)。
    //   这时候能用的就是手上最小那点缓冲:没有就开一档(19.2 KB),有就接着用。
    如果 (适合大档() == 假)
    {
        如果 (模型缓冲够开() == 假)
        {
            开一档();
        }
        如果 (模型缓冲够开() == 假)
        {
            模型_错码 = 7;
            返回 假;
        }
        如果 (模型_顶点上限 == 300)
        {
            返回 模型读一档(路径);
        }
        如果 (模型_顶点上限 == 550)
        {
            返回 模型读二档(路径);
        }
        如果 (模型_顶点上限 == 1300)
        {
            返回 模型读三档(路径);
        }
        返回 模型读四档(路径);
    }
    如果 (模型缓冲够开() == 假)
    {
        // 还没开过:按真规模挑最小那一档(下面"收不下就升"还会再往上抬)
        模型按规模开();
    }
    如果 (模型这一档收不下())
    {
        模型升一档();
        如果 (模型缓冲够开() == 假)
        {
            模型_错码 = 7;
            返回 假;
        }
    }
    返回 模型分派读(路径);
}

// 当前这一档收不下手上这一份(三个数一起判)
私有 方法 模型这一档收不下() 返回 逻辑
{
    如果 (模型_要顶点 > 模型_顶点上限)
    {
        返回 真;
    }
    如果 (模型_要边 > 模型_边上限)
    {
        返回 真;
    }
    如果 (模型_要面 > 模型_面上限)
    {
        返回 真;
    }
    返回 假;
}

// 按探查到的规模挑**最小**那一档(收不下就往上挑;四档都收不下 ⇒ 挑四档,
//   让真正的读去报"装不下"并给出真实规模,而不是在这里静默失败)
私有 方法 模型按规模开()
{
    如果 (符合一档())
    {
        开一档();
        返回
    }
    如果 (符合二档())
    {
        开二档();
        返回
    }
    如果 (符合三档())
    {
        开三档();
        返回
    }
    开四档();
    返回
}

// 升一档:一→二、二→三、三→四(四档收不下就原地不动 —— 由"装不下"那条路去报)
私有 方法 模型升一档()
{
    如果 (符合一档())
    {
        开一档();
        返回
    }
    如果 (符合二档())
    {
        开二档();
        返回
    }
    如果 (符合三档())
    {
        开三档();
        返回
    }
    开四档();
    返回
}

// 三个"装模型"的缓冲都就位了没有(少一块就不能装 —— 少一块还去装就是往空地址里写)
私有 方法 模型缓冲够开() 返回 逻辑
{
    如果 (模型_顶点区 == 0 || 模型_边区 == 0 || 模型_面区 == 0)
    {
        返回 假;
    }
    返回 真;
}

// 照**当前这一档**分派下去读(每一支的上限都是字面量,见 `装` 头上的 ⚠)
私有 方法 模型分派读(字符串 路径) 返回 逻辑
{
    如果 (模型_顶点上限 == 300)
    {
        返回 模型读一档(路径);
    }
    如果 (模型_顶点上限 == 550)
    {
        返回 模型读二档(路径);
    }
    如果 (模型_顶点上限 == 1300)
    {
        返回 模型读三档(路径);
    }
    返回 模型读四档(路径);
}

私有 方法 模型读一档(字符串 路径) 返回 逻辑
{
    // ⚠ 形如"验证过能写进块"的那种写法:实参直接是模块级 `地址` 变量、上限写死字面量
    逻辑 成了 = 读取模型(路径, 模型_顶点区, 模型_边区, 模型_面区, 300, 900, 700, 模型_条数区);
    返回 模型收尾(成了);
}

私有 方法 模型读二档(字符串 路径) 返回 逻辑
{
    逻辑 成了 = 读取模型(路径, 模型_顶点区, 模型_边区, 模型_面区, 550, 1700, 1350, 模型_条数区);
    返回 模型收尾(成了);
}

私有 方法 模型读三档(字符串 路径) 返回 逻辑
{
    逻辑 成了 = 读取模型(路径, 模型_顶点区, 模型_边区, 模型_面区, 1300, 4500, 2600, 模型_条数区);
    返回 模型收尾(成了);
}

私有 方法 模型读四档(字符串 路径) 返回 逻辑
{
    逻辑 成了 = 读取模型(路径, 模型_顶点区, 模型_边区, 模型_面区, 2600, 9000, 5200, 模型_条数区);
    返回 模型收尾(成了);
}
// 调试用(公开):把块地址本身报出来 —— 与调用方 `申请` 到的那两个地址对照,看是不是同一块
方法 块地址(整数 哪块) 返回 整数
{
    如果 (哪块 == 0)
    {
        返回 整数(模型_顶点区);
    }
    如果 (哪块 == 1)
    {
        返回 整数(模型_边区);
    }
    返回 整数(模型_面区);
}

// 把条数块那四格翻译成"顶点数 / 边数 / 面数 / 错码"。
//
// ⚠ **这里不许把 `模型_要顶点` 那三个先清零再靠条数块补**:装不下那一路宿主**照样**写真实条数,
//   而探查那一路也是它写的 —— 两边同一个来源。清零再补的写法在"读失败"那一路会把手上的
//   真规模冲掉(调用方刚要拿它比,却读到 0)。
// 把条数块那四格翻译成"顶点数 / 边数 / 面数 / 错码"。
//
// ⚠⚠ **判据是条数块里的状态码,不是返回值**(2026-10-11 实测踩到,查了很久):
//   宿主 `读取模型` 在**"装不下"那一路返回的是真** —— 它只在条数块的第四格写 3
//   (见 `宿主能力C.处理读取模型` 与 `hb_host_读取模型`:那一路 `return 状态_成功`,
//   中间层再把状态 0 转成 `逻辑 真`)。
//   我第一版写成"先看 `成了`:真是成功、假才去看状态码" ⇒ **装不下被当成装成了**:
//   函数报"读进来了"、顶点数却停在上一份,后面全线错位(实测:一份装不下的模型
//   让 `装` 返回真、错码留着 0)。
//   ⇒ 正确的优先次序:**先看状态码 1/2/3**(那是宿主给的准话),再看返回值。
//   状态码 0 时返回值必为真,所以末尾那个 `返回 成了` 只是兜底。
私有 方法 模型收尾(逻辑 成了) 返回 逻辑
{
    模型_错码 = 0;
    整数 顶点数 = 整数(取字(模型_条数区, 0));
    整数 边数 = 整数(取字(模型_条数区, 4));
    整数 面数 = 整数(取字(模型_条数区, 8));
    整数 状态 = 整数(取字(模型_条数区, 12));
    // 装不下(状态 3):宿主把**真实规模**写在条数块前三格里 —— 照着记,错码给 3
    如果 (状态 == 3)
    {
        模型_要顶点 = 顶点数;
        模型_要边 = 边数;
        模型_要面 = 面数;
        模型_探查过了 = 真;
        模型_错码 = 3;
        返回 假;
    }
    如果 (状态 == 1)
    {
        模型_错码 = 1;
        返回 假;
    }
    如果 (状态 == 2)
    {
        模型_错码 = 2;
        返回 假;
    }
    如果 (成了 == 假)
    {
        // 状态码 0 而返回假:理论上到不了这儿;真到了就按"打不开"如实报,别静默当成功
        模型_错码 = 1;
        返回 假;
    }
    模型_入顶点数 = 顶点数;
    模型_入面数 = 面数;
    模型_要顶点 = 顶点数;
    模型_要边 = 边数;
    模型_要面 = 面数;
    模型_探查过了 = 真;
    返回 真;
}

// 读一份 **并**装进 `三维网格`(先清空 ⇒ 替换)。
//
// ⚠ **这里不许把 `模型_入顶点数` 当实参传进 `装顶点`**(2026-10-10 实测,静默致错两小时):
//   `三维网格` 模块里有模块级的 `顶点数` / `面数`,而**模块级变量会与调用方同名变量串成一格**
//   (见 `三维网格.hb` 顶部那条 ⚠)—— 传进去之后函数里收到的 `几颗` 变成 **0**,一颗都装不进去,
//   而**编译器一声不响**。所以这里改成:装完**回头数一遍**网格自己的计数,对不对由它判。
方法 装进网格(字符串 路径) 返回 逻辑
{
    如果 (装(路径) == 假)
    {
        返回 假;
    }
    // ★ 先问一句"网格自己收不收得下"(2026-10-10 晚加,这就是"装不下要说清楚"那一条):
    //   `三维网格` 的顶点 / 边 / 面是**定长数组**(8000 / 20000 / 12000)。
    //   模型装得进本库的缓冲、却塞不进网格 ⇒ 以前是**静默丢后半截**(顶点数停在 8000、
    //   面数停在 12000,画出来缺一块而没有任何提示)。现在当场判、给错码 6。
    如果 (模型_入顶点数 > 三维网格.顶点上限())
    {
        模型_错码 = 6;
        返回 假;
    }
    如果 (模型_入面数 > 12000)
    {
        模型_错码 = 6;
        返回 假;
    }
    三维网格.清空();
    三维网格.装顶点(模型_顶点区, 模型_入顶点数);
    三维网格.装面(模型_面区, 模型_入面数);
    // `三维网格.顶点数` / `.面数` 是那两个模块的**模块级变量**,这里直接当字段读(库之间可以这么读)
    如果 (三维网格.顶点数 != 模型_入顶点数 || 三维网格.面数 != 模型_入面数)
    {
        模型_错码 = 5;
        模型_要顶点 = 模型_入顶点数;
        模型_要面 = 模型_入面数;
        返回 假;
    }
    返回 真;
}

// 调试用(公开):把第 i 颗顶点的头一个"字"(位模式)取出来 —— 用来核对"块里到底有没有数据"。
//   判据:与 `.obj` 文件里那一颗 x 的 IEEE754 位模式一致 ⇒ 数据真的写进去了。
方法 第几颗顶点的位模式(整数 i) 返回 整数
{
    返回 整数(取字(模型_顶点区, i * 12));
}