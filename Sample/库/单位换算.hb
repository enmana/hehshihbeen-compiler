// ============================================================
// 单位换算.hb —— 钱 / 时间 / 大小 / 角度(纯 HB,零依赖)
//
// 用法:
// ```
// 包含 "../库/单位换算.hb";
// 整数 分 = 0;
// 如果 (单位换算.元转分("12.34", 分)) { 输出行(分); }          // 1234
// 字符串 元 = 单位换算.分转元(1234);  输出行(元);              // 12.34
// ```
//
// 治的是**同一个量的两种写法之间的那一步**,而且全都是“以整数算”的那一档:**钱**(元 ↔ 分 —— 浮点存钱是经典的坑,所以库里进出都是分)、**时间**(秒 ↔ 时分秒 / 时长文字 / `时:分:秒.毫秒`)、**大小**(字节数 ↔ `1.5 KB / 2.0 MB / 3.4 GB`)、**角度**(度 ↔ 微弧度,1 度 = 17453 微弧度)。
//
// 口径(2026-10;每条都对着实测写):
//   · **钱一律以分为单位**,`元转分` 认 `12` / `12.3` / `12.34` / `-0.05` / `+7`;
//     小数**超过两位**时按第三位四舍五入(`"1.005"` ⇒ 101 分),**第三位以后不再看**;
//     认不出(空串 / 有别的字符 / 只有一个小数点 / 超过 21474836.47 元)⇒ **给假并且把 `分` 清 0**;
//   · **`分转元` 永远两位小数**(`1234` ⇒ `12.34`、`-5` ⇒ `-0.05`、`0` ⇒ `0.00`)——
//     这样它可以直接进表格 / 报表,不用调用方再补零;
//   · **时长**从"秒"这一档起算:`秒转时分秒` 拆,`时分秒转秒` 拼;
//     **负数按绝对值拆 / 拼**(正负由调用方自己判;这一对只搬数字);
//   · **`时长文本` 只写非零的那几段**(`3661` ⇒ `1 小时 1 分 1 秒`、`90` ⇒ `1 分 30 秒`、
//     `3600` ⇒ `1 小时`、`0` ⇒ `0 秒`);负数在前面加 `-`;
//   · **`时长文本毫秒` 是秒表那一档**:`时:分:秒.毫秒`,分 / 秒补两位、毫秒补三位
//     (`3723456` ⇒ `1:02:03.456`、`500` ⇒ `0:00:00.500`);
//   · **大小按 1000 进制(KB / MB / GB),一位小数、四舍五入**:`1500` ⇒ `1.5 KB`、
//     `999` ⇒ `999 B`(不到 1000 的照字节写)、`1999` ⇒ `2.0 KB`;
//   · **角度**:`度转微弧度` 是 `度 × 17453`(1° = 0.0174532925 弧度),
//     `微弧度转度` 四舍五入(`1570796` ⇒ `90`)。
//
// 提供的函数(9 个):逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:全是 O(1)(位数固定的整数运算与十来个字符的拼接);拼串走池,一条结果一次。
//
// 内存账:本库自己一块缓冲都不占(不申请堆、不建模块级大数组);每个"返回字符串"的函数
//   现造一条结果串(住在池里,由编译器按水位收)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **`-2147483648` 是那一格极端值**:`元转分` 收得下 `-21474836.48`(它就是分的那一格);
//     `分转元` 也认得它;但 `秒转时分秒` / `时长文本` 那一族"取绝对值"会在它上面回绕
//     (取负还是它自己)—— 一秒都不差的那一档不在这条边界上,如实登记;
//   · **溢出按 32 位回绕**:`时分秒转秒` 给个几百万小时就会绕回去(调用方自己判范围);
//   · **不做时区 / 不做日历**:那是 `时间.hb` 的活(它管"某一刻"),这一库只管"一段时间";
//   · **不做单位表 / 不做任意换算**(米 ↔ 英尺、公斤 ↔ 磅 ……):这一库收的是**天天用的那几件**,
//     别的换算一行乘除就写完了,不值得再进一层调用;
//   · **角度只给整数微弧度**:要三角函数得等框架里那一批浮点算法(§5 明确写了远期)。
// ============================================================
模块 单位换算

// ============================================================
// 私有:整数 → 十进制文字(零依赖:自写一份,含 -2147483648)
// ============================================================
私有 方法 单位换算数文(整数 值) 返回 字符串
{
    如果 (值 == -2147483648)
    {
        返回 "-2147483648";
    }
    如果 (值 == 0)
    {
        返回 "0";
    }
    逻辑 负 = 值 < 0;
    整数 数 = 值;
    如果 (负)
    {
        数 = 0 - 数;
    }
    字符 倒[12];
    整数 个数 = 0;
    当 (数 > 0)
    {
        倒[个数] = 48 + 数 % 10;
        个数 = 个数 + 1;
        数 = 数 / 10;
    }
    字符串 结果 = "";
    如果 (负)
    {
        拼接到(结果, '-');
    }
    整数 i = 个数 - 1;
    当 (i >= 0)
    {
        拼接到(结果, 倒[i]);
        i = i - 1;
    }
    返回 结果;
}

// 私有:十进制数,左边补 '0' 到 `位` 位(已经够长就原样)
私有 方法 单位换算补零(整数 值, 整数 位) 返回 字符串
{
    字符串 数文 = 单位换算数文(值);
    字符串 结果 = "";
    整数 缺 = 位 - 数文.长度();
    整数 i = 0;
    当 (i < 缺)
    {
        拼接到(结果, '0');
        i = i + 1;
    }
    拼接到(结果, 数文);
    返回 结果;
}

// ============================================================
// 1、钱:元 ↔ 分(一律以分进出)
// ============================================================

// 把 "12.34" 这样的元读成分(第三位小数四舍五入);认不出给假并把分清 0
方法 元转分(字符串 文本, 引用 整数 分) 返回 逻辑
{
    分 = 0;
    整数 个数 = 文本.长度();
    如果 (个数 == 0)
    {
        返回 假;
    }
    整数 i = 0;
    逻辑 负 = 假;
    整数 头码 = 文本[0];
    如果 (头码 == 45 || 头码 == 43)
    {
        负 = 头码 == 45;
        i = 1;
    }
    整数 整部 = 0;
    逻辑 见过数字 = 假;
    逻辑 到点 = 假;
    当 (i < 个数)
    {
        整数 码 = 文本[i];
        如果 (码 == 46)
        {
            到点 = 真;
            跳出;
        }
        如果 (码 < 48 || 码 > 57)
        {
            返回 假;
        }
        见过数字 = 真;
        整部 = 整部 * 10 + (码 - 48);
        如果 (整部 > 21474836)
        {
            返回 假;
        }
        i = i + 1;
    }
    如果 (见过数字 == 假)
    {
        返回 假;
    }
    整数 小部 = 0;
    整数 小位 = 0;
    逻辑 进位 = 假;
    如果 (到点)
    {
        i = i + 1;
        逻辑 见过小数 = 假;
        当 (i < 个数)
        {
            整数 码 = 文本[i];
            如果 (码 < 48 || 码 > 57)
            {
                返回 假;
            }
            见过小数 = 真;
            如果 (小位 < 2)
            {
                小部 = 小部 * 10 + (码 - 48);
            }
            否则
            {
                如果 (小位 == 2 && 码 >= 53)
                {
                    进位 = 真;
                }
            }
            小位 = 小位 + 1;
            i = i + 1;
        }
        如果 (见过小数 == 假)
        {
            返回 假;
        }
    }
    当 (小位 < 2)
    {
        小部 = 小部 * 10;
        小位 = 小位 + 1;
    }
    如果 (进位)
    {
        小部 = 小部 + 1;
    }
    整数 值 = 整部 * 100 + 小部;
    如果 (值 < 0)
    {
        返回 假;
    }
    如果 (负)
    {
        值 = 0 - 值;
    }
    分 = 值;
    返回 真;
}

// 分变回元的文字,永远是两位小数(1234 → 12.34、-5 → -0.05)
方法 分转元(整数 分) 返回 字符串
{
    如果 (分 == -2147483648)
    {
        返回 "-21474836.48";
    }
    逻辑 负 = 分 < 0;
    整数 数 = 分;
    如果 (负)
    {
        数 = 0 - 数;
    }
    整数 整部 = 数 / 100;
    整数 小部 = 数 % 100;
    字符串 结果 = "";
    如果 (负)
    {
        拼接到(结果, '-');
    }
    拼接到(结果, 单位换算数文(整部));
    拼接到(结果, '.');
    拼接到(结果, 单位换算补零(小部, 2));
    返回 结果;
}

// ============================================================
// 2、时间:秒 ↔ 时分秒 / 时长文字
// ============================================================

// 把总秒拆成时 / 分 / 秒(负数按绝对值拆,正负自己判;整型最小值会回绕)
方法 秒转时分秒(整数 总秒, 引用 整数 时, 引用 整数 分, 引用 整数 秒)
{
    整数 数 = 总秒;
    如果 (数 < 0)
    {
        数 = 0 - 数;
    }
    时 = 数 / 3600;
    分 = (数 % 3600) / 60;
    秒 = 数 % 60;
    返回
}

// 时 / 分 / 秒 拼回总秒数(不做范围检查,给大了按 32 位回绕)
方法 时分秒转秒(整数 时, 整数 分, 整数 秒) 返回 整数
{
    返回 时 * 3600 + 分 * 60 + 秒;
}

// 总秒写成 "1 小时 1 分 1 秒"(只写非零的段,0 给 0 秒,负数前面加 -)
方法 时长文本(整数 总秒) 返回 字符串
{
    如果 (总秒 == 0)
    {
        返回 "0 秒";
    }
    逻辑 负 = 总秒 < 0;
    整数 数 = 总秒;
    如果 (负)
    {
        数 = 0 - 数;
    }
    整数 时 = 数 / 3600;
    整数 分 = (数 % 3600) / 60;
    整数 秒 = 数 % 60;
    字符串 结果 = "";
    如果 (负)
    {
        拼接到(结果, '-');
    }
    如果 (时 > 0)
    {
        拼接到(结果, 单位换算数文(时));
        拼接到(结果, " 小时");
    }
    如果 (分 > 0)
    {
        如果 (时 > 0)
        {
            拼接到(结果, ' ');
        }
        拼接到(结果, 单位换算数文(分));
        拼接到(结果, " 分");
    }
    如果 (秒 > 0)
    {
        如果 (时 > 0 || 分 > 0)
        {
            拼接到(结果, ' ');
        }
        拼接到(结果, 单位换算数文(秒));
        拼接到(结果, " 秒");
    }
    返回 结果;
}

// 毫秒写成 "1:02:03.456" 这种秒表样式(分 / 秒补两位、毫秒补三位;负数带 -)
方法 时长文本毫秒(整数 毫秒) 返回 字符串
{
    逻辑 负 = 毫秒 < 0;
    整数 数 = 毫秒;
    如果 (负)
    {
        数 = 0 - 数;
    }
    整数 时 = 数 / 3600000;
    整数 分 = (数 % 3600000) / 60000;
    整数 秒 = (数 % 60000) / 1000;
    整数 毫 = 数 % 1000;
    字符串 结果 = "";
    如果 (负)
    {
        拼接到(结果, '-');
    }
    字符串 部 = 单位换算数文(时);
    拼接到(结果, 部);
    拼接到(结果, ':');
    部 = 单位换算补零(分, 2);
    拼接到(结果, 部);
    拼接到(结果, ':');
    部 = 单位换算补零(秒, 2);
    拼接到(结果, 部);
    拼接到(结果, '.');
    部 = 单位换算补零(毫, 3);
    拼接到(结果, 部);
    返回 结果;
}

// ============================================================
// 3、大小:字节数 → "1.5 KB"(1000 进制,一位小数,四舍五入)
// ============================================================
// 私有:不到 1000 字节那一档(照字节写)
私有 方法 单位换算字节文字(整数 字节数) 返回 字符串
{
    字符串 结果 = "";
    如果 (字节数 <= 0)
    {
        拼接到(结果, '0');
    }
    否则
    {
        拼接到(结果, 单位换算数文(字节数));
    }
    拼接到(结果, " B");
    返回 结果;
}

// 字节数写成 "1.5 KB"(1000 进制、一位小数四舍五入;不到 1000 照字节写)
方法 字节转大小文本(整数 字节数) 返回 字符串
{
    如果 (字节数 < 1000)
    {
        返回 单位换算字节文字(字节数);
    }
    整数 单位 = 1000;
    字符串 后缀 = "KB";
    如果 (字节数 >= 1000000)
    {
        单位 = 1000000;
        后缀 = "MB";
    }
    如果 (字节数 >= 1000000000)
    {
        单位 = 1000000000;
        后缀 = "GB";
    }
    整数 整部 = 字节数 / 单位;
    整数 余 = 字节数 % 单位;
    整数 二十分之一 = 单位 / 20;
    整数 十分之一 = 单位 / 10;
    整数 小部 = (余 + 二十分之一) / 十分之一;
    如果 (小部 >= 10)
    {
        小部 = 小部 - 10;
        整部 = 整部 + 1;
    }
    字符串 结果 = "";
    拼接到(结果, 单位换算数文(整部));
    拼接到(结果, '.');
    拼接到(结果, 单位换算数文(小部));
    拼接到(结果, ' ');
    拼接到(结果, 后缀);
    返回 结果;
}

// ============================================================
// 4、角度:度 ↔ 微弧度(整数档;浮点三角排在远期)
// ============================================================

// 度 × 17453 得微弧度(1 度 = 17453;乘大了按 32 位回绕)
方法 度转微弧度(整数 度) 返回 整数
{
    返回 度 * 17453;
}

// 四舍五入(1570796 → 90)
方法 微弧度转度(整数 微弧度) 返回 整数
{
    逻辑 负 = 微弧度 < 0;
    整数 数 = 微弧度;
    如果 (负)
    {
        数 = 0 - 数;
    }
    整数 度 = 数 / 17453;
    如果 (数 % 17453 * 2 >= 17453)
    {
        度 = 度 + 1;
    }
    如果 (负)
    {
        度 = 0 - 度;
    }
    返回 度;
}
