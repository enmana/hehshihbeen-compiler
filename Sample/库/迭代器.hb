// ============================================================
// 迭代器.hb —— "逐项处理"的统一写法(拉模式)(零依赖)
//
// 用法:
// ```
// 包含 "../库/迭代器.hb";
// 整数 句 = 迭代器.建("张三,28,杭州\n李四,7,乌鲁木齐\n", "\n");
// 当 (迭代器.下一项(句))
// {
//     输出行(迭代器.当前项(句));          // 一项一项来,源一直在原地
// }
// 迭代器.关(句);
//
// 整数 名 = 迭代器.建("账号,姓名,备注", ",");
// 输出行(迭代器.剩几项(名));               // 3
// 输出行(迭代器.取前(名, 2));              // 2(走到前两项)
// 迭代器.重开(名);
// 整数 和 = 0;
// 输出行(迭代器.汇聚整数(迭代器.建("1,2,3", ","), 和));   // 3
// 输出行(和);                                             // 6
// ```
//
// 这门语言里“逐项处理”统一成**拉模式**:调用方 `当 (下一项(句)) { … 当前项(句) … }`,处理什么、什么时候停全在调用方手里。这一库把这条协议收成一处,并配上几个组合子:**取前 / 跳过 / 找含子串的项 / 把每一项当整数加起来 / 重开**。与 `文件.hb.下一行` / `流.hb.读行` / `链表.hb.下一项` 是同一套形状。
//
// 口径(2026-10;每条都对着实测写):
//   · **源就是一条字符串**(内存里),切法由"分隔串"说了算:**分隔写空串 = 按行**(`\n` 断行、
//     行尾 `\r` 去掉、末行没有换行也算一项);分隔非空 = 按那条分隔串切(**分隔串本身不进项**);
//   · **切段口径与 `string.hb.切分` 一致**:`"账号,姓名"` 按 `,` 切给 **2** 项;
//     `"账号,姓名,"` 给 **3** 项(最后那个是空串);空源给 **0** 项;
//   · **`下一项` 只往前走**:走到末尾给假并**保持当前位置**(不会回头);要回头用 `重开`;
//   · **不占字符串池的"大块"**:源一直挂在库里(**不进池**),每一项是现切出来的一小段;
//     但**源本身要是字符串**(整份已经在内存里了)⇒ 比 1MB 还大的数据请走 `流.hb` 那一层;
//   · **16 格**:同时开 16 条;句柄 = `格子 * 65536 + 版本`,关掉之后版本 +1 ⇒ 旧句柄当场作废;
//   · **失败给假 / -1,不停机**:句柄不成形、位置越界都有确定结果。
//
// 提供的函数:逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:建 / 重开 / 关 O(1);下一项 O(这一项的字数);剩几项 O(剩下的字数 × 项数);
//   取前 / 跳过 O(走过的字数);找含子串 O(扫过的字数);汇聚整数 O(扫过的字数)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **不给"推模式"那一档**(`每项(句柄, 处理函数, 上下文)`):回调能写,但库收回调会把
//     "谁负责停"这件事搅浑 —— 拉模式一种写法就够(框架 §8.4 也是这么并列的);
//   · **不做"排序 / 分组"这些要整份数据的组合子**:那些归 `数组.hb` / `列表.hb` / `排序.hb`;
//   · **源不能改**:迭代期间改源得自己重新 `建`(库不跟踪源的变化);
//   · **`汇聚整数` 认不出的项跳过**:返回的是"真加进去几项",不是"走过几项"。
// ============================================================
模块 迭代器

// ---------- 私有:取一段(顺带把这一段的 '\r' 去掉;按行那一档要用) ----------
私有 方法 迭代器切段(字符串 文本, 整数 起, 整数 止) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 起;
    当 (i < 止)
    {
        文字 c = 文本[i];
        如果 (c != '\r')
        {
            拼接到(结果, c);
        }
        i = i + 1;
    }
    返回 结果;
}

// ---------- 模块状态:16 格,每格一条源 ----------
//   字符串那几样按 **格子 * 每格 + 序号** 排在一张表里(与 `配置.hb` 同一套排法):
//   0 = 源 / 1 = 分隔 / 2 = 当前项
私有 字符串 串[48];
私有 整数 位[16];
私有 整数 尾空[16];
私有 整数 版本[16];
私有 整数 在用[16];

// ============================================================
// 私有:串表那两格 + 句柄 / 空格
// ============================================================
私有 方法 迭代器取串(整数 下标) 返回 字符串
{
    返回 串[下标];
}

私有 方法 迭代器置串(整数 下标, 字符串 文本)
{
    串[下标] = 文本;
    返回
}

私有 方法 迭代器查格(整数 句柄) 返回 整数
{
    整数 格 = 句柄 / 65536;
    整数 版 = 句柄 % 65536;
    如果 (格 < 0 || 格 > 15)
    {
        返回 0 - 1;
    }
    如果 (在用[格] == 0 || 版本[格] != 版)
    {
        返回 0 - 1;
    }
    返回 格;
}

私有 方法 迭代器找空格() 返回 整数
{
    整数 i = 0;
    当 (i < 16)
    {
        如果 (在用[i] == 0)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}


// ---------- 私有:从 `起` 迭代器找行(没有给 -1) ----------
私有 方法 迭代器找行(字符串 文本, 整数 起) 返回 整数
{
    整数 i = 起;
    整数 长 = 文本.长度();
    当 (i < 长)
    {
        如果 (文本[i] == '\n')
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// ---------- 私有:从 `起` 找分隔串(没有给 -1);分隔串为空给 -1 ----------
私有 方法 迭代器找分隔(字符串 文本, 字符串 分隔, 整数 起) 返回 整数
{
    整数 分隔长 = 分隔.长度();
    如果 (分隔长 == 0)
    {
        返回 0 - 1;
    }
    整数 i = 起;
    整数 长 = 文本.长度();
    当 (i + 分隔长 <= 长)
    {
        整数 k = 0;
        逻辑 同 = 真;
        当 (k < 分隔长)
        {
            文字 a = 文本[i + k];
            文字 b = 分隔[k];
            如果 (a != b)
            {
                同 = 假;
                跳出;
            }
            k = k + 1;
        }
        如果 (同)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// ---------- 私有:往前走一项(内部那一份;`下一项` 与几个组合子共用) ----------
私有 方法 迭代器走一项(整数 格) 返回 逻辑
{
    字符串 源 = 迭代器取串(格 * 3);
    整数 长 = 源.长度();
    整数 起 = 位[格];
    如果 (起 >= 长)
    {
        如果 (尾空[格] == 1)
        {
            尾空[格] = 0;
            迭代器置串(格 * 3 + 2, "");
            返回 真;
        }
        返回 假;
    }
    字符串 分 = 迭代器取串(格 * 3 + 1);
    如果 (分.长度() == 0)
    {
        整数 断 = 迭代器找行(源, 起);
        如果 (断 < 0)
        {
            字符串 末段 = 迭代器切段(源, 起, 长);
            迭代器置串(格 * 3 + 2, 末段);
            位[格] = 长;
            返回 真;
        }
        字符串 行段 = 迭代器切段(源, 起, 断);
        迭代器置串(格 * 3 + 2, 行段);
        位[格] = 断 + 1;
        返回 真;
    }
    整数 后一断 = 迭代器找分隔(源, 分, 起);
    如果 (后一断 < 0)
    {
        字符串 尾段 = 迭代器切段(源, 起, 长);
        迭代器置串(格 * 3 + 2, 尾段);
        位[格] = 长;
        返回 真;
    }
    字符串 中间段 = 迭代器切段(源, 起, 后一断);
    迭代器置串(格 * 3 + 2, 中间段);
    位[格] = 后一断 + 分.长度();
    如果 (位[格] >= 长)
    {
        尾空[格] = 1;               // 分隔串正好在末尾:`切分` 那一档还会给一个空项
    }
    返回 真;
}

// ============================================================
// 1、开 / 关 / 重开
// ============================================================

// 源文本与分隔串存进一格,给一个句柄(分隔空串 = 按行切);16 格占满给 -1
方法 建(字符串 源文本, 字符串 分隔串) 返回 整数
{
    整数 格 = 迭代器找空格();
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    迭代器置串(格 * 3, 源文本);
    迭代器置串(格 * 3 + 1, 分隔串);
    迭代器置串(格 * 3 + 2, "");
    位[格] = 0;
    尾空[格] = 0;
    在用[格] = 1;
    版本[格] = 版本[格] + 1;
    返回 格 * 65536 + 版本[格];
}

// 从头再来:位置与当前项都清掉,下一项又从第一项起;句柄不成形给假
方法 重开(整数 句柄) 返回 逻辑
{
    整数 格 = 迭代器查格(句柄);
    如果 (格 < 0)
    {
        返回 假;
    }
    位[格] = 0;
    尾空[格] = 0;
    迭代器置串(格 * 3 + 2, "");
    返回 真;
}

// 放掉那一格(句柄作废)
方法 关(整数 句柄) 返回 逻辑
{
    整数 格 = 迭代器查格(句柄);
    如果 (格 < 0)
    {
        返回 假;
    }
    迭代器置串(格 * 3, "");
    迭代器置串(格 * 3 + 1, "");
    迭代器置串(格 * 3 + 2, "");
    位[格] = 0;
    尾空[格] = 0;
    在用[格] = 0;
    版本[格] = 版本[格] + 1;
    返回 真;
}

// ============================================================
// 2、往前走
// ============================================================

// 往前走一项(到末尾给假,位置留在原地不回头);坏句柄也给假
方法 下一项(整数 句柄) 返回 逻辑
{
    整数 格 = 迭代器查格(句柄);
    如果 (格 < 0)
    {
        返回 假;
    }
    返回 迭代器走一项(格);
}

// 刚走过去的那一项;没走过或句柄不成形都取回空串
方法 当前项(整数 句柄) 返回 字符串
{
    整数 格 = 迭代器查格(句柄);
    如果 (格 < 0)
    {
        返回 "";
    }
    返回 迭代器取串(格 * 3 + 2);
}

// ============================================================
// 3、组合子
// ============================================================

// 从当前位置一路数到末尾,给剩下的项数(数完位置就到末尾了);坏句柄给 -1
方法 剩几项(整数 句柄) 返回 整数
{
    整数 格 = 迭代器查格(句柄);
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    整数 个数 = 0;
    当 (迭代器走一项(格))
    {
        个数 = 个数 + 1;
    }
    返回 个数;
}

// 最多往前走 几个 项,给真走掉的项数(不够就早停);坏句柄给 -1
方法 取前(整数 句柄, 整数 几个) 返回 整数
{
    整数 格 = 迭代器查格(句柄);
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    整数 个数 = 0;
    当 (个数 < 几个 && 迭代器走一项(格))
    {
        个数 = 个数 + 1;
    }
    返回 个数;
}

// 和 `取前` 是一回事(就是转调它):前进 几个 项,给真走掉的项数
方法 跳过(整数 句柄, 整数 几个) 返回 整数
{
    返回 取前(句柄, 几个);
}

// 往前走,停在第一个含 子串 的项上给真(空子串在第一项上就算命中);没有给假
方法 找含子串(整数 句柄, 字符串 子串) 返回 逻辑
{
    整数 格 = 迭代器查格(句柄);
    如果 (格 < 0)
    {
        返回 假;
    }
    当 (迭代器走一项(格))
    {
        字符串 本项 = 迭代器取串(格 * 3 + 2);
        如果 (迭代器找子串(本项, 子串) >= 0)
        {
            返回 真;
        }
    }
    返回 假;
}

// 把每一项当整数加进 合计,给真加进去的项数(认不出的跳过);坏句柄给 -1
方法 汇聚整数(整数 句柄, 引用 整数 合计) 返回 整数
{
    整数 格 = 迭代器查格(句柄);
    如果 (格 < 0)
     {
        返回 0 - 1;
    }
    整数 个数 = 0;
    当 (迭代器走一项(格))
    {
        整数 值 = 0;
        如果 (迭代器读整数(迭代器取串(格 * 3 + 2), 值))
        {
            合计 = 合计 + 值;
            个数 = 个数 + 1;
        }
    }
    返回 个数;
}

// ---------- 私有:十进制文字 → 整数(认不出给假;只认可选正负号 + 数字) ----------
私有 方法 迭代器读整数(字符串 文本, 引用 整数 数) 返回 逻辑
{
    数 = 0;
    整数 长 = 文本.长度();
    如果 (长 == 0)
    {
        返回 假;
    }
    整数 i = 0;
    逻辑 负 = 假;
    文字 首 = 文本[0];
    如果 (首 == '-' || 首 == '+')
    {
        负 = 首 == '-';
        i = 1;
        如果 (长 == 1)
        {
            返回 假;
        }
    }
    整数 结果 = 0;
    当 (i < 长)
    {
        文字 d = 文本[i];
        如果 (d < '0' || d > '9')
        {
            返回 假;
        }
        结果 = 结果 * 10 + (d - '0');
        i = i + 1;
    }
    如果 (负)
    {
        结果 = 0 - 结果;
    }
    数 = 结果;
    返回 真;
}

// ---------- 私有:找一个子串(没有给 -1)—— 不引 string.hb,保持零依赖 ----------
私有 方法 迭代器找子串(字符串 主串, 字符串 子串) 返回 整数
{
    整数 主长 = 主串.长度();
    整数 子长 = 子串.长度();
    如果 (子长 == 0)
    {
        返回 0;
    }
    整数 i = 0;
    当 (i + 子长 <= 主长)
    {
        整数 k = 0;
        逻辑 同 = 真;
        当 (k < 子长)
        {
            文字 a = 主串[i + k];
            文字 b = 子串[k];
            如果 (a != b)
            {
                同 = 假;
                跳出;
            }
            k = k + 1;
        }
        如果 (同)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}
