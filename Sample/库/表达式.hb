// ============================================================
// 表达式.hb —— 算术 / 比较 / 逻辑表达式的求值(纯 HB,零依赖)
//
// 用法:
// ```
// 包含 "../库/表达式.hb";
// 整数 成果 = 0;
// 如果 (表达式.求值("1 + 2 * 3", 成果)) { 输出行(成果); }        // 7
// 表达式.清变量();
// 表达式.设变量("总分", 3);
// 如果 (表达式.求值("总分 * (2 + 1)", 成果) == 假)
// {
//     输出行(表达式.说明("总分 * (2 + 1)"));            // 第 N 格:…
// }
// ```
// 治的是"运行期拿到的一串文本要算出数来":配置里的一行算式(`超时 * 2 + 5`)、规则判断
//   (`除数 != 0 && 100 / 除数 > 5`)、小计算器。语言自己的表达式是**写死在源码里、编译期就展开掉**的,
//   所以这一库做的是**递归下降 + 优先级 + 括号**,算错了**指着第几格**给一句说明。
//
// 口径(2026-10;每条都对着实测写):
//   · **值一律是 `整数`**(32 位有符号;溢出按补码回绕,不报错)—— `长整数` 是 `int64s.hb` 的库类型,
//     本库零依赖,不碰那一档;
//   · **优先级从低到高**:`||` → `&&` → `== != < > <= >=` → `+ -` → `* / %` → 一元 `- + !` → 括号 / 数 /
//     名字 —— 与语言里那套表达式**同一份优先级**(本库是它的子集);
//   · **不含位运算**:`| ^ & << >>` 一个都不认;算式里出现它们,`说明` 会指着那一格说"本库不做位运算";
//   · **`&&` / `||` 真短路**:左边已经定了结果,右边**只解析不算数** —— 那一支里"除以 0"与"名字没设过"
//     都**不报错**(值丢掉);**语法错照报**;
//   · **比较与逻辑的结果是 1 / 0**;`-7 / 2` = `-3`、`-7 % 2` = `-1`(与语言里一致:有符号);
//   · **除以 0 是一处运行期错误**(错因 4,`/` 与 `%` 的右边是 0 都算),不是静默给 0;
//   · **数**:十进制,或 `0x` / `0X` 开头的十六进制;**名字**:首格是字母 / `_` / 汉字(码 ≥ 128),后面还可
//     以是数字;
//   · **出错给位置**:`取出错格` 是 1 起的"第几格"(按**字符**数,一个汉字算一格),`取错因` 是一句原因,
//     `说明(串)` 把两者排成人看的一段话;
//   · **变量表最多 16 个名字**,`设变量` 满了返回假(**不悄悄丢掉**已有的);
//   · **不报错、不停机**:所有失败都走"返回假 + 记下错因与位置",没有异常、没有停机、不写错误槽。
//
// 提供的函数(7 个):求值 / 设变量 / 清变量 / 有变量 / 取错因 / 取出错格 / 说明;
//   逐条的参数与返回值见本页末尾那张公开方法表。
//   (变量不走形参:`字符串 表[]` 当形参编不过,所以走模块里的表,落地成 `清变量` + `设变量` + `求值`。)
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:O(算式长度);空间 O(1)(只在切名字时借一个中间串)。**平铺的长算式不占递归深度**
//   (`1+1+1+…` 走循环),只有**括号嵌套**才吃软栈(一层括号约七个调用帧)。
//
// 边界(如实登记):
//   · **不做浮点**:`1 / 2` 是 `0`(整数除);要小数请自己拿 `float64.hb` 那一套算;
//   · **不做幂、不做函数调用、不做赋值**:算式里只有上面那些运算符、数、括号、名字;
//   · **不可重入**:模块里只留一份解析状态 ⇒ `求值` 还没返回时再调 `求值` 会串状态;
//   · **括号嵌套很深会报软栈满**(一层括号约七个调用帧,默认软栈约五百帧 ⇒ 几十层没问题);
//   · **变量最多 16 个、名字长短不设限**(受字符串池管);
//   · **32 位回绕**:`2147483647 + 1` 是 `-2147483648`,`-(-2147483648)` 还是它自己 —— 不报错。
// ============================================================
模块 表达式

// ---------- 模块级解析状态(单线程:一份就够) ----------
私有 整数 位置 = 0;        // 现在看到第几格(0 起,按字符)
私有 整数 错因 = 0;        // 0 = 没错;1~8 见 `表达式原因文`
私有 整数 出错格 = 0;      // 1 起;0 = 没错
私有 整数 静默 = 0;        // 短路时"只解析不算数"的深度(>0:除以 0 与名字没设过都不报错)
私有 整数 算符格 = 0;      // 最近一个乘除余运算符在第几格(1 起;除数是 0 时指它)

// ---------- 变量表(最多 16 个名字) ----------
私有 整数 变量数 = 0;
私有 整数 变量上限 = 16;
私有 字符串 名表[16];
私有 整数 值表[16];

// ============================================================
// 1、扫描器(位置 / 表达式看码 / 表达式吃码 / 表达式跳空白)
// ============================================================

私有 方法 表达式看码(字符串 文本) 返回 整数
{
    如果 (位置 >= 文本.长度())
    {
        返回 -1;
    }
    返回 文本[位置];
}

私有 方法 表达式看两码(字符串 文本) 返回 整数
{
    如果 (位置 + 1 >= 文本.长度())
    {
        返回 -1;
    }
    返回 文本[位置 + 1];
}

私有 方法 表达式吃码(字符串 文本, 整数 码) 返回 逻辑
{
    如果 (表达式看码(文本) != 码)
    {
        返回 假;
    }
    位置 = 位置 + 1;
    返回 真;
}

私有 方法 表达式吃两码(字符串 文本, 整数 首码, 整数 次码) 返回 逻辑
{
    如果 (表达式看码(文本) != 首码)
    {
        返回 假;
    }
    如果 (表达式看两码(文本) != 次码)
    {
        返回 假;
    }
    位置 = 位置 + 2;
    返回 真;
}

// 空白:空格 / 制表 / 回车 / 换行(算式里可以随便换行断句)
私有 方法 表达式跳空白(字符串 文本)
{
    当 (位置 < 文本.长度())
    {
        整数 码 = 文本[位置];
        如果 (码 != 32 && 码 != 9 && 码 != 13 && 码 != 10)
        {
            跳出;
        }
        位置 = 位置 + 1;
    }
}

// ---------- 出错:只留**第一条**(后面一路解开时别再改它) ----------
私有 方法 表达式置错(整数 因, 整数 格)
{
    如果 (错因 == 0)
    {
        错因 = 因;
        出错格 = 格;
    }
}

// ============================================================
// 2、词素(数 / 名字 / 括号)
// ============================================================

私有 方法 表达式是名首(整数 码) 返回 逻辑
{
    如果 (码 >= 65 && 码 <= 90)
    {
        返回 真;
    }
    如果 (码 >= 97 && 码 <= 122)
    {
        返回 真;
    }
    如果 (码 == 95)
    {
        返回 真;
    }
    返回 码 >= 128;
}

私有 方法 表达式是名码(整数 码) 返回 逻辑
{
    如果 (码 >= 48 && 码 <= 57)
    {
        返回 真;
    }
    返回 表达式是名首(码);
}

// ---------- 取一段(起 含、止 不含;按字符) ----------
私有 方法 表达式取段(字符串 文本, 整数 起, 整数 止) 返回 字符串
{
    字符串 成果 = "";
    整数 i = 起;
    当 (i < 止 && i < 文本.长度())
    {
        拼接到(成果, 文本[i]);
        i = i + 1;
    }
    返回 成果;
}

私有 方法 表达式十六值(整数 码) 返回 整数
{
    如果 (码 >= 48 && 码 <= 57)
    {
        返回 码 - 48;
    }
    如果 (码 >= 65 && 码 <= 70)
    {
        返回 码 - 55;
    }
    如果 (码 >= 97 && 码 <= 102)
    {
        返回 码 - 87;
    }
    返回 -1;
}

私有 方法 表达式是十六开头(字符串 文本) 返回 逻辑
{
    如果 (表达式看码(文本) != 48)
    {
        返回 假;
    }
    整数 二 = 表达式看两码(文本);
    返回 二 == 120 || 二 == 88;
}

私有 方法 表达式读十进(字符串 文本) 返回 整数
{
    整数 值 = 0;
    当 (位置 < 文本.长度())
    {
        整数 码 = 文本[位置];
        如果 (码 < 48 || 码 > 57)
        {
            跳出;
        }
        值 = 值 * 10 + (码 - 48);
        位置 = 位置 + 1;
    }
    返回 值;
}

私有 方法 表达式读十六(字符串 文本) 返回 整数
{
    整数 起 = 位置;
    位置 = 位置 + 2;
    整数 值 = 0;
    整数 位 = 0;
    当 (位置 < 文本.长度())
    {
        整数 数 = 表达式十六值(文本[位置]);
        如果 (数 < 0)
        {
            跳出;
        }
        值 = 值 * 16 + 数;
        位置 = 位置 + 1;
        位 = 位 + 1;
    }
    如果 (位 == 0)
    {
        表达式置错(7, 起 + 1);
    }
    返回 值;
}

私有 方法 表达式读数字(字符串 文本) 返回 整数
{
    如果 (表达式是十六开头(文本))
    {
        返回 表达式读十六(文本);
    }
    返回 表达式读十进(文本);
}

// ---------- 名字:切出来查变量表(查不到就是错因 6;短路那一支给 0) ----------
私有 方法 表达式找变量(字符串 名字) 返回 整数
{
    整数 i = 0;
    当 (i < 变量数)
    {
        如果 (名表[i] == 名字)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

私有 方法 表达式读名字(字符串 文本) 返回 整数
{
    整数 起 = 位置;
    当 (位置 < 文本.长度())
    {
        如果 (表达式是名码(文本[位置]) == 假)
        {
            跳出;
        }
        位置 = 位置 + 1;
    }
    字符串 名 = 表达式取段(文本, 起, 位置);
    整数 格 = 表达式找变量(名);
    如果 (格 >= 0)
    {
        返回 值表[格];
    }
    如果 (静默 > 0)
    {
        返回 0;
    }
    表达式置错(6, 起 + 1);
    返回 0;
}

// ============================================================
// 3、递归下降(优先级从低到高)
// ============================================================

私有 方法 表达式逻辑转整数(逻辑 条件) 返回 整数
{
    如果 (条件)
    {
        返回 1;
    }
    返回 0;
}

// ---------- 基本款:括号 / 数 / 名字 ----------
私有 方法 表达式算基本(字符串 文本) 返回 整数
{
    如果 (错因 != 0)
    {
        返回 0;
    }
    表达式跳空白(文本);
    整数 码 = 表达式看码(文本);
    如果 (码 < 0)
    {
        表达式置错(2, 位置 + 1);
        返回 0;
    }
    如果 (码 == 40)
    {
        返回 表达式算括号(文本);
    }
    如果 (码 >= 48 && 码 <= 57)
    {
        返回 表达式读数字(文本);
    }
    如果 (表达式是名首(码))
    {
        返回 表达式读名字(文本);
    }
    表达式置错(2, 位置 + 1);
    返回 0;
}

// ---------- `( … )`:开括号的位置记下来(少右括号时指着它) ----------
私有 方法 表达式算括号(字符串 文本) 返回 整数
{
    整数 开 = 位置 + 1;
    表达式吃码(文本, 40);
    整数 值 = 表达式算或(文本);
    如果 (错因 != 0)
    {
        返回 0;
    }
    表达式跳空白(文本);
    如果 (表达式吃码(文本, 41) == 假)
    {
        表达式置错(3, 开);
    }
    返回 值;
}

// ---------- 一元:`- + !`(可以连着写:`- - 3`、`!!5`) ----------
私有 方法 表达式算一元(字符串 文本) 返回 整数
{
    如果 (错因 != 0)
    {
        返回 0;
    }
    表达式跳空白(文本);
    如果 (表达式吃码(文本, 45))
    {
        整数 值 = 表达式算一元(文本);
        如果 (错因 != 0)
        {
            返回 0;
        }
        返回 0 - 值;
    }
    如果 (表达式吃码(文本, 43))
    {
        返回 表达式算一元(文本);
    }
    如果 (表达式吃码(文本, 33))
    {
        整数 反 = 表达式算一元(文本);
        如果 (错因 != 0)
        {
            返回 0;
        }
        如果 (反 == 0)
        {
            返回 1;
        }
        返回 0;
    }
    返回 表达式算基本(文本);
}

// ---------- `* / %` ----------
私有 方法 表达式算乘除项(整数 码, 整数 左, 整数 右) 返回 整数
{
    如果 (码 == 42)
    {
        返回 左 * 右;
    }
    如果 (右 == 0)
    {
        如果 (静默 == 0)
        {
            表达式置错(4, 算符格);
        }
        返回 0;
    }
    如果 (码 == 47)
    {
        返回 左 / 右;
    }
    返回 左 % 右;
}

私有 方法 表达式算积(字符串 文本) 返回 整数
{
    整数 左 = 表达式算一元(文本);
    当 (错因 == 0)
    {
        表达式跳空白(文本);
        整数 码 = 表达式看码(文本);
        如果 (码 != 42 && 码 != 47 && 码 != 37)
        {
            跳出;
        }
        算符格 = 位置 + 1;
        位置 = 位置 + 1;
        整数 右 = 表达式算一元(文本);
        如果 (错因 != 0)
        {
            跳出;
        }
        左 = 表达式算乘除项(码, 左, 右);
    }
    返回 左;
}

// ---------- `+ -` ----------
私有 方法 表达式算和(字符串 文本) 返回 整数
{
    整数 左 = 表达式算积(文本);
    当 (错因 == 0)
    {
        表达式跳空白(文本);
        整数 码 = 表达式看码(文本);
        如果 (码 != 43 && 码 != 45)
        {
            跳出;
        }
        位置 = 位置 + 1;
        整数 右 = 表达式算积(文本);
        如果 (错因 != 0)
        {
            跳出;
        }
        如果 (码 == 43)
        {
            左 = 左 + 右;
        }
        否则
        {
            左 = 左 - 右;
        }
    }
    返回 左;
}

// ---------- 比较(`<=` 要先试,别被 `<` 抢走) ----------
私有 方法 表达式取记号(字符串 文本) 返回 整数
{
    如果 (表达式吃两码(文本, 61, 61))
    {
        返回 1;
    }
    如果 (表达式吃两码(文本, 33, 61))
    {
        返回 2;
    }
    如果 (表达式吃两码(文本, 60, 61))
    {
        返回 3;
    }
    如果 (表达式吃两码(文本, 62, 61))
    {
        返回 4;
    }
    // `<<` / `>>` 不归比较管:`<` 后面还是 `<` 就整个留给"多余字符"那条路(错因 8 指着它)
    如果 (表达式看两码(文本) == 60)
    {
        返回 0;
    }
    如果 (表达式看两码(文本) == 62)
    {
        返回 0;
    }
    如果 (表达式吃码(文本, 60))
    {
        返回 5;
    }
    如果 (表达式吃码(文本, 62))
    {
        返回 6;
    }
    返回 0;
}

私有 方法 表达式比较值(整数 记号, 整数 左, 整数 右) 返回 整数
{
    如果 (记号 == 1)
    {
        返回 表达式逻辑转整数(左 == 右);
    }
    如果 (记号 == 2)
    {
        返回 表达式逻辑转整数(左 != 右);
    }
    如果 (记号 == 3)
    {
        返回 表达式逻辑转整数(左 <= 右);
    }
    如果 (记号 == 4)
    {
        返回 表达式逻辑转整数(左 >= 右);
    }
    如果 (记号 == 5)
    {
        返回 表达式逻辑转整数(左 < 右);
    }
    返回 表达式逻辑转整数(左 > 右);
}

私有 方法 表达式算比(字符串 文本) 返回 整数
{
    整数 左 = 表达式算和(文本);
    当 (错因 == 0)
    {
        表达式跳空白(文本);
        整数 记号 = 表达式取记号(文本);
        如果 (记号 == 0)
        {
            跳出;
        }
        整数 右 = 表达式算和(文本);
        如果 (错因 != 0)
        {
            跳出;
        }
        左 = 表达式比较值(记号, 左, 右);
    }
    返回 左;
}

// ---------- `&&`(左 0 ⇒ 右边只解析不算数) ----------
私有 方法 表达式算与(字符串 文本) 返回 整数
{
    整数 左 = 表达式算比(文本);
    当 (错因 == 0)
    {
        表达式跳空白(文本);
        如果 (表达式吃两码(文本, 38, 38) == 假)
        {
            跳出;
        }
        如果 (左 == 0)
        {
            静默 = 静默 + 1;
        }
        整数 右 = 表达式算比(文本);
        如果 (左 == 0)
        {
            静默 = 静默 - 1;
        }
        如果 (错因 != 0)
        {
            跳出;
        }
        如果 (左 != 0)
        {
            左 = 表达式逻辑转整数(右 != 0);
        }
    }
    返回 左;
}

// ---------- `||`(左非 0 ⇒ 右边只解析不算数) ----------
私有 方法 表达式算或(字符串 文本) 返回 整数
{
    整数 左 = 表达式算与(文本);
    当 (错因 == 0)
    {
        表达式跳空白(文本);
        如果 (表达式吃两码(文本, 124, 124) == 假)
        {
            跳出;
        }
        如果 (左 != 0)
        {
            静默 = 静默 + 1;
        }
        整数 右 = 表达式算与(文本);
        如果 (左 != 0)
        {
            静默 = 静默 - 1;
        }
        如果 (错因 != 0)
        {
            跳出;
        }
        如果 (左 == 0)
        {
            左 = 表达式逻辑转整数(右 != 0);
        }
    }
    返回 左;
}

// ============================================================
// 4、公开接口
// ============================================================

// 算出来写进 `结果`;失败给假(`结果` 清 0,错因与位置问下面三个)
方法 求值(字符串 表达式串, 引用 整数 结果) 返回 逻辑
{
    结果 = 0;
    位置 = 0;
    错因 = 0;
    出错格 = 0;
    静默 = 0;
    算符格 = 0;
    表达式跳空白(表达式串);
    如果 (位置 >= 表达式串.长度())
    {
        表达式置错(1, 1);
        返回 假;
    }
    整数 值 = 表达式算或(表达式串);
    如果 (错因 != 0)
    {
        返回 假;
    }
    表达式跳空白(表达式串);
    如果 (位置 < 表达式串.长度())
    {
        整数 余 = 表达式串[位置];
        如果 (余 == 124 || 余 == 94 || 余 == 38 || 余 == 60 || 余 == 62)
        {
            表达式置错(8, 位置 + 1);
        }
        否则
        {
            表达式置错(5, 位置 + 1);
        }
        返回 假;
    }
    结果 = 值;
    返回 真;
}

// 有就改、没有就加(表满 16 个给假)
方法 设变量(字符串 名字, 整数 值) 返回 逻辑
{
    整数 格 = 表达式找变量(名字);
    如果 (格 >= 0)
    {
        值表[格] = 值;
        返回 真;
    }
    如果 (变量数 >= 变量上限)
    {
        返回 假;
    }
    名表[变量数] = 名字;
    值表[变量数] = 值;
    变量数 = 变量数 + 1;
    返回 真;
}

// 变量表清空(换一份算式前记得调)
方法 清变量()
{
    变量数 = 0;
}

// 这个名字在变量表里吗
方法 有变量(字符串 名字) 返回 逻辑
{
    返回 表达式找变量(名字) >= 0;
}

// 上一次求值失败在第几格(1 起;没失败给 0)
方法 取出错格() 返回 整数
{
    返回 出错格;
}

// ---------- 错因 → 一句原因(说明 / 取错因 共用) ----------
私有 方法 表达式原因文(整数 因) 返回 字符串
{
    如果 (因 == 2)
    {
        返回 "这一格要一个数、一个名字或者 `(`";
    }
    如果 (因 == 3)
    {
        返回 "这一格开的 `(` 没有关上";
    }
    如果 (因 == 4)
    {
        返回 "这一格的除数是 0";
    }
    如果 (因 == 5)
    {
        返回 "算式到这里就完了,后面还有多余的字符";
    }
    如果 (因 == 6)
    {
        返回 "这一格的名字没有设过值(先用 设变量 给它一个值)";
    }
    如果 (因 == 7)
    {
        返回 "这一格的 `0x` 后面没有十六进制数字";
    }
    如果 (因 == 8)
    {
        返回 "本库不做位运算(`| ^ & << >>` 请自己先算好再写进来)";
    }
    返回 "认不出的算式";
}

// 上一次求值失败的原因(没失败给 "")
方法 取错因() 返回 字符串
{
    如果 (错因 == 0)
    {
        返回 "";
    }
    返回 表达式原因文(错因);
}

// ---------- 整数 → 十进制文字(自己写一个:`格式化` 转数字要 `string.hb` 的 `转字符串`,
//            那会把本库变成"有依赖";这一段是零依赖的代价,也是本库唯一一处手写转换) ----------
私有 方法 表达式数文(整数 值) 返回 字符串
{
    如果 (值 == 0)
    {
        返回 "0";
    }
    字符串 表 = "0123456789";
    字符串 倒 = "";
    整数 剩 = 值;
    整数 负 = 0;
    如果 (剩 < 0)
    {
        负 = 1;
    }
    当 (剩 != 0)
    {
        整数 余 = 剩 % 10;
        如果 (余 < 0)
        {
            余 = 0 - 余;
        }
        字符 字 = 表[余];
        拼接到(倒, 字);
        剩 = 剩 / 10;
    }
    字符串 成果 = "";
    如果 (负 == 1)
    {
        拼接到(成果, '-');
    }
    整数 i = 倒.长度() - 1;
    当 (i >= 0)
    {
        拼接到(成果, 倒[i]);
        i = i - 1;
    }
    返回 成果;
}

// ---------- 表达式尾巴:"那一格是 `X`;算式共 M 格" ----------
私有 方法 表达式尾巴(字符串 表达式串) 返回 字符串
{
    字符串 成果 = "";
    整数 总 = 表达式串.长度();
    如果 (出错格 <= 总)
    {
        拼接到(成果, ";那一格是 `");
        拼接到(成果, 表达式串[出错格 - 1]);
        拼接到(成果, "`");
    }
    拼接到(成果, ";算式共 ");
    字符串 总文 = 表达式数文(总);
    拼接到(成果, 总文);
    拼接到(成果, " 格");
    返回 成果;
}

// 人看的一行:"第 N 格:…;那一格是 `X`;算式共 M 格"
方法 说明(字符串 表达式串) 返回 字符串
{
    如果 (错因 == 0)
    {
        返回 "算式没问题";
    }
    如果 (错因 == 1)
    {
        返回 "算式是空的(一个字符都没有)";
    }
    字符串 格文 = 表达式数文(出错格);
    字符串 因文 = 表达式原因文(错因);
    字符串 尾文 = 表达式尾巴(表达式串);
    字符串 成果 = "";
    拼接到(成果, "第 ");
    拼接到(成果, 格文);
    拼接到(成果, " 格:");
    拼接到(成果, 因文);
    拼接到(成果, 尾文);
    返回 成果;
}
