// ============================================================
// 缓冲.hb —— 字符串构建器(纯 HB,不动语言面)
//
// 用法:包含 "../库/缓冲.hb";`地址 本 = 缓冲.建(1024)` → `缓冲.加(本, "第 ")` /
//   `缓冲.加整数(本, 42)` / `缓冲.加行(本, " 行")` → `字符串 报告 = 缓冲.取值(本)` → `缓冲.销毁(本)`。
//
// 为什么要它:字符串住在**池**里,池的水位只在**函数返回**时回收 ⇒ 在**顶层循环**里一边拼一边造
//   临时串,池只会一路往上涨。这一库把中间数据放进**堆**(`申请`),只在最后 `取值` 那一下成型一次:
//   循环里 `加 / 加整数 / 加行` **一个临时串都不产生** ⇒ 池用量与"拼了多少次"无关。
//
// 口径(2026-10):
//   · **一块缓冲 = 堆里一个块**:头 8 字节是 `[0] 容量 / [4] 字节数`,后面才是数据;
//     `建(预估容量)` 给的容量小于 16 就按 16 算;**装满了不自动长**(满了 `加*` 一律给 -1)——
//     要更大的就 `建` 一个更大的、或者 `重置` 了重用;
//   · **一切按字节算**:容量 / 字节数 / 返回值都是字节数(不是 `.长度()` 那种"文字数");
//   · **加进去的是 UTF-8 字节**:`加` 按码点自己编 UTF-8 ⇒ `取值` 拿回来的串逐字节等于当初加进去的那些串接起来;
//   · **不报错、不停机**:装不下给 -1;名字叫 `重置` 不叫 `清空`(`清空` 是语言里容器动作的名字,会要求"单独成句")。
//
// 英文对照:建 create · 容量 capacity · 字节数 byteCount · 剩余 remaining · 加 append
//   加字符 appendChar · 加整数 appendInt · 加行 appendLine · 取值 toText · 重置 reset · 销毁 destroy
//
// 复杂度:一次 `加` 是 O(这个串的字节数);`取值` 是 O(总字节数);其余都是 O(1)。
//
// 边界(如实登记):
//   · **`申请` 要不到就当场停下**⇒ 预估容量别乱写大;
//   · **`加行` 是"先加文本再加换行"**:换行放不下时给 -1,而文本已经进去了 ——
//     要"要么都进、要么都不进",先拿 `剩余` 判一下再调;
//   · **`销毁` 之后再用这一块**由堆自己拦(释放后读写会被拦下并停下);
//   · **同一块缓冲不许同时被两处写**:这一库不带锁,单线程用。
// 提供的函数(11 个):逐个见下面那张公开方法表。
// ============================================================
模块 缓冲


// 私有:一个码点占几个 UTF-8 字节
私有 方法 缓冲码点字节数(整数 码) 返回 整数
{
    如果 (码 < 128)
    {
        返回 1;
    }
    如果 (码 < 2048)
    {
        返回 2;
    }
    如果 (码 < 65536)
    {
        返回 3;
    }
    返回 4;
}

// 私有:堆是按 4 字节字、按字节偏移读写的,这里做读改写
私有 方法 缓冲写字节(地址 缓冲, 整数 位置, 整数 值)
{
    整数 字起 = 位置 - 位置 % 4;
    整数 移位量 = (位置 % 4) * 8;
    整数 整字 = 取字(缓冲, 8 + 字起);
    整字 = 整字 & (~(255 << 移位量));
    整字 = 整字 | ((值 & 255) << 移位量);
    存字(缓冲, 8 + 字起, 整字);
    返回
}

// 私有:读一个字节
私有 方法 缓冲读字节(地址 缓冲, 整数 位置) 返回 字符
{
    整数 字起 = 位置 - 位置 % 4;
    整数 移位量 = (位置 % 4) * 8;
    返回 (取字(缓冲, 8 + 字起) >> 移位量) & 255;
}

// 私有:把一个码点按 UTF-8 写进去,返回写了几个字节
私有 方法 缓冲写码点(地址 缓冲, 整数 位置, 整数 码) 返回 整数
{
    如果 (码 < 128)
    {
        缓冲写字节(缓冲, 位置, 码);
        返回 1;
    }
    如果 (码 < 2048)
    {
        缓冲写字节(缓冲, 位置, 192 + 码 / 64);
        缓冲写字节(缓冲, 位置 + 1, 128 + 码 % 64);
        返回 2;
    }
    如果 (码 < 65536)
    {
        缓冲写字节(缓冲, 位置, 224 + 码 / 4096);
        缓冲写字节(缓冲, 位置 + 1, 128 + 码 / 64 % 64);
        缓冲写字节(缓冲, 位置 + 2, 128 + 码 % 64);
        返回 3;
    }
    缓冲写字节(缓冲, 位置, 240 + 码 / 262144);
    缓冲写字节(缓冲, 位置 + 1, 128 + 码 / 4096 % 64);
    缓冲写字节(缓冲, 位置 + 2, 128 + 码 / 64 % 64);
    缓冲写字节(缓冲, 位置 + 3, 128 + 码 % 64);
    返回 4;
}

// ---------- 建 / 问大小 ----------

// 从堆里要一块(容量至少 16 字节)。
方法 建(整数 预估容量) 返回 地址
{
    如果 (预估容量 < 16)
    {
        预估容量 = 16;                    // 太小了没意思:给一格底
    }
    地址 块 = 申请(8 + 预估容量);
    存字(块, 0, 预估容量);
    存字(块, 4, 0);
    返回 块;
}

// 这一块一共装得下多少字节。
方法 容量(地址 缓冲) 返回 整数
{
    返回 取字(缓冲, 0);
}

// 现在装了多少字节。
方法 字节数(地址 缓冲) 返回 整数
{
    返回 取字(缓冲, 4);
}

// 还装得下多少字节。
方法 剩余(地址 缓冲) 返回 整数
{
    返回 取字(缓冲, 0) - 取字(缓冲, 4);
}

// ---------- 加:串 / 字节 / 整数 / 行 ----------

// 追加一个串;返回追加后的**总字节数**,放不下给 -1。
方法 加(地址 缓冲, 字符串 文本) 返回 整数
{
    整数 个数 = 文本.长度();
    整数 需要 = 0;
    整数 i = 0;
    当 (i < 个数)                          // 先量一遍:放不下就一个字节都别写进去
    {
        需要 = 需要 + 缓冲码点字节数(文本[i]);
        i = i + 1;
    }
    如果 (剩余(缓冲) < 需要)
    {
        返回 -1;
    }
    整数 起 = 字节数(缓冲);
    整数 位置 = 起;
    i = 0;
    当 (i < 个数)
    {
        位置 = 位置 + 缓冲写码点(缓冲, 位置, 文本[i]);
        i = i + 1;
    }
    存字(缓冲, 4, 起 + 需要);
    返回 起 + 需要;
}

// 追加**一个字节**。
方法 加字符(地址 缓冲, 字符 字) 返回 整数
{
    如果 (剩余(缓冲) < 1)
    {
        返回 -1;
    }
    整数 起 = 字节数(缓冲);
    缓冲写字节(缓冲, 起, 字);
    存字(缓冲, 4, 起 + 1);
    返回 起 + 1;
}

// 追加一个整数的十进制写法(含负号)。
方法 加整数(地址 缓冲, 整数 值) 返回 整数
{
    无符号整数 大 = 值;                    // 负数取相反数:走无符号除法,`-2147483648` 也不会回绕
    整数 负号 = 0;
    如果 (值 < 0)
    {
        大 = 0 - 值;
        负号 = 1;
    }
    整数 位数 = 1;
    无符号整数 剩 = 大;
    当 (剩 >= 10)
    {
        剩 = 剩 / 10;
        位数 = 位数 + 1;
    }
    整数 需要 = 位数 + 负号;
    如果 (剩余(缓冲) < 需要)
    {
        返回 -1;
    }
    整数 起 = 字节数(缓冲);
    如果 (负号 == 1)
    {
        缓冲写字节(缓冲, 起, 45);             // '-'
    }
    剩 = 大;
    整数 k = 0;
    当 (k < 位数)                          // 从个位起写,所以从尾巴往前填
    {
        缓冲写字节(缓冲, 起 + 负号 + 位数 - 1 - k, 48 + 剩 % 10);
        剩 = 剩 / 10;
        k = k + 1;
    }
    存字(缓冲, 4, 起 + 需要);
    返回 起 + 需要;
}

// 先追加文本、再追加一个换行(10);换行放不下给 -1,而文本已经进去了。
方法 加行(地址 缓冲, 字符串 文本) 返回 整数
{
    整数 成果 = 加(缓冲, 文本);
    如果 (成果 < 0)
    {
        返回 -1;
    }
    如果 (剩余(缓冲) < 1)
    {
        返回 -1;                           // 文本已经进去了,换行没地方 —— 见头注释的边界
    }
    缓冲写字节(缓冲, 字节数(缓冲), 10);        // 换行
    存字(缓冲, 4, 字节数(缓冲) + 1);
    返回 字节数(缓冲);
}

// ---------- 取值 / 重置 / 销毁 ----------

// 把现在这些字节**成型成一个字符串**(缓冲本身不动)。
方法 取值(地址 缓冲) 返回 字符串
{
    字符串 结果 = "";
    整数 个数 = 字节数(缓冲);
    整数 i = 0;
    当 (i < 个数)                          // 一次成型:池里只多这一个串
    {
        字符 这个字节 = 缓冲读字节(缓冲, i);    // 先存进一个 `字符`:`拼接到` 只收字符串或**字节变量**,不收调用
        拼接到(结果, 这个字节);
        i = i + 1;
    }
    返回 结果;
}

// 字节数归零(容量不变,内容不用抹)。
方法 重置(地址 缓冲) 返回 逻辑
{
    存字(缓冲, 4, 0);                      // 容量不动、内容不用抹:字节数说了算
    返回 真;
}

// 把这一块还回堆(还了之后别再用它)。
方法 销毁(地址 缓冲) 返回 逻辑
{
    释放(缓冲);
    返回 真;
}
