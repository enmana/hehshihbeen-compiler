// ============================================================
// int64s.hb —— 64 位【有符号】整数库(纯软件:不动 ISA、不加类型、不加关键字)
//
// 表示:结构 长整数 = 4 个 16 位半区,半区0 最低 … 半区3 最高,补码(two's complement)。字段用 `整数`
//   (32 位)存"已经 & 65535 的半区"(窄字段读回来会补符号位);最高半区 半区3 的 bit15(值 32768)就是符号位。
//
// 与 int64.hb 的关系:那个是 64 位【无符号】。两个库的 API 都走"结构整体传",可以同时 包含;区别只在
//   **比较 / 打印 / 解析**的口径 —— 同一个位模式 `18446744073709551615` 在本库是 -1,在 int64.hb 是 2^64-1。
//
// 传参规矩:HB 的结构参数**按地址传**,实参只能是 变量 / 字段 / 数组元素,不能是表达式。所以
//   `长整数加(a, 长整数取负(b))` 是错的,要先 `长整数 t = 长整数取负(b);` 再 `长整数加(a, t)`。
//
// 库的约定(不是报错):`字符串转长整数` 遇到非法字符或超出 int64 范围**返回 0**。
//
// 提供(全部按"结构整体传"):
//   长整数加 / 减 / 取负 / 乘(16 位半区竖式,软件够用);长整数是负
//   长整数比较(a, b) → -1(左小) / 0(相等) / 1(左大);相等 / 小于 / 小于等于 / 大于 / 大于等于 → 逻辑
//   长整数转字符串(值) → 十进制字符串(负数带前导 '-'、0 就是 "0"、INT64_MIN 也能打)
//   字符串转长整数(文本) → 长整数(可带前导 '-' 或 '+',越界 / 非法 → 0)
//   长整数零 / 长整数最大 / 长整数最小
//
// 用法:
// ```
// 包含 "../../库/int64s.hb"
// ```
//
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 64 位有符号整数 = 四个 32 位半区(半区3 最高、半区0 最低)
结构 长整数
{
    整数 半区0;
    整数 半区1;
    整数 半区2;
    整数 半区3;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 1、加减取负:16 位半区逐级进位/借位(最高半区的进位丢掉 = 回绕,补码就该这样)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// a + b
方法 长整数加(长整数 左, 长整数 右) 返回 长整数
{
    长整数 长整数加果;
    长整数加果.半区0 = 左.半区0 + 右.半区0;
    长整数加果.半区1 = 左.半区1 + 右.半区1;
    长整数加果.半区2 = 左.半区2 + 右.半区2;
    长整数加果.半区3 = 左.半区3 + 右.半区3;
    如果 (长整数加果.半区0 > 65535)
    {
        // 第 1 段溢出 → 第 2 段加一
        长整数加果.半区1 = 长整数加果.半区1 + 1;
    }
    如果 (长整数加果.半区1 > 65535)
    {
        // 第 2 段(含进位)溢出 → 第 3 段加一
        长整数加果.半区2 = 长整数加果.半区2 + 1;
    }
    如果 (长整数加果.半区2 > 65535)
    {
        // 第 3 段溢出 → 第 4 段加一
        长整数加果.半区3 = 长整数加果.半区3 + 1;
    }
    长整数加果.半区0 = 长整数加果.半区0 & 65535;
    长整数加果.半区1 = 长整数加果.半区1 & 65535;
    长整数加果.半区2 = 长整数加果.半区2 & 65535;
    长整数加果.半区3 = 长整数加果.半区3 & 65535;
    返回 长整数加果;
}

// a - b
方法 长整数减(长整数 左, 长整数 右) 返回 长整数
{
    长整数 长整数减果;
    长整数减果.半区0 = 左.半区0 - 右.半区0;   // 负 = 这一段要向下借位
    长整数减果.半区1 = 左.半区1 - 右.半区1;
    长整数减果.半区2 = 左.半区2 - 右.半区2;
    长整数减果.半区3 = 左.半区3 - 右.半区3;
    如果 (长整数减果.半区0 < 0)
    {
        长整数减果.半区1 = 长整数减果.半区1 - 1;
    }
    如果 (长整数减果.半区1 < 0)
    {
        长整数减果.半区2 = 长整数减果.半区2 - 1;
    }
    如果 (长整数减果.半区2 < 0)
    {
        长整数减果.半区3 = 长整数减果.半区3 - 1;
    }
    长整数减果.半区0 = 长整数减果.半区0 & 65535;
    长整数减果.半区1 = 长整数减果.半区1 & 65535;
    长整数减果.半区2 = 长整数减果.半区2 & 65535;
    长整数减果.半区3 = 长整数减果.半区3 & 65535;
    返回 长整数减果;
}

// 取反加一。注意 INT64_MIN(-9223372036854775808)取负还是它自己(补码回绕,符合预期)
方法 长整数取负(长整数 值) 返回 长整数
{
    长整数 长整数取负果;
    长整数取负果.半区0 = (65535 - 值.半区0) + 1;
    长整数取负果.半区1 = 65535 - 值.半区1;
    长整数取负果.半区2 = 65535 - 值.半区2;
    长整数取负果.半区3 = 65535 - 值.半区3;
    如果 (长整数取负果.半区0 > 65535)
    {
        长整数取负果.半区0 = 长整数取负果.半区0 & 65535;
        长整数取负果.半区1 = 长整数取负果.半区1 + 1;
    }
    如果 (长整数取负果.半区1 > 65535)
    {
        长整数取负果.半区1 = 长整数取负果.半区1 & 65535;
        长整数取负果.半区2 = 长整数取负果.半区2 + 1;
    }
    如果 (长整数取负果.半区2 > 65535)
    {
        长整数取负果.半区2 = 长整数取负果.半区2 & 65535;
        长整数取负果.半区3 = 长整数取负果.半区3 + 1;
    }
    长整数取负果.半区3 = 长整数取负果.半区3 & 65535;
    返回 长整数取负果;
}

// a × b:逐位"移位累加"(64 轮),只留低 64 位 —— 补码下
//   有符号乘 = 无符号乘取低 64 位,所以不用单独处理符号。
//   不追求速度:十六位半区竖式乘法的累加器要 8 个半区(32 字节)+ 两个 4 半区数组,
//   帧里放不下,这里改成"被乘数每轮左移一位、按乘数第 i 位决定加不加"。
方法 长整数乘(长整数 左, 长整数 右) 返回 长整数
{
    长整数 长整数乘积;
    长整数乘积.半区0 = 0;
    长整数乘积.半区1 = 0;
    长整数乘积.半区2 = 0;
    长整数乘积.半区3 = 0;
    长整数 长整数乘被;
    长整数乘被.半区0 = 左.半区0;
    长整数乘被.半区1 = 左.半区1;
    长整数乘被.半区2 = 左.半区2;
    长整数乘被.半区3 = 左.半区3;
    整数 长整数乘i = 0;
    当 (长整数乘i < 64)
    {
        整数 长整数乘半号 = 长整数乘i >> 4;          // 乘数第 i 位落在哪个半区
        整数 长整数乘位号 = 长整数乘i & 15;
        整数 长整数乘该半 = 右.半区0;
        如果 (长整数乘半号 == 1)
        {
            长整数乘该半 = 右.半区1;
        }
        如果 (长整数乘半号 == 2)
        {
            长整数乘该半 = 右.半区2;
        }
        如果 (长整数乘半号 == 3)
        {
            长整数乘该半 = 右.半区3;
        }
        整数 长整数乘位值 = (长整数乘该半 >> 长整数乘位号) & 1;
        如果 (长整数乘位值 != 0)
        {
            长整数乘积.半区0 = 长整数乘积.半区0 + 长整数乘被.半区0;
            长整数乘积.半区1 = 长整数乘积.半区1 + 长整数乘被.半区1;
            长整数乘积.半区2 = 长整数乘积.半区2 + 长整数乘被.半区2;
            长整数乘积.半区3 = 长整数乘积.半区3 + 长整数乘被.半区3;
            如果 (长整数乘积.半区0 > 65535)
            {
                长整数乘积.半区1 = 长整数乘积.半区1 + 1;
            }
            如果 (长整数乘积.半区1 > 65535)
            {
                长整数乘积.半区2 = 长整数乘积.半区2 + 1;
            }
            如果 (长整数乘积.半区2 > 65535)
            {
                长整数乘积.半区3 = 长整数乘积.半区3 + 1;
            }
            长整数乘积.半区0 = 长整数乘积.半区0 & 65535;
            长整数乘积.半区1 = 长整数乘积.半区1 & 65535;
            长整数乘积.半区2 = 长整数乘积.半区2 & 65535;
            长整数乘积.半区3 = 长整数乘积.半区3 & 65535;
        }
        长整数乘被.半区3 = ((长整数乘被.半区3 << 1) | (长整数乘被.半区2 >> 15)) & 65535;   // 被乘数左移一位
        长整数乘被.半区2 = ((长整数乘被.半区2 << 1) | (长整数乘被.半区1 >> 15)) & 65535;
        长整数乘被.半区1 = ((长整数乘被.半区1 << 1) | (长整数乘被.半区0 >> 15)) & 65535;
        长整数乘被.半区0 = (长整数乘被.半区0 << 1) & 65535;
        长整数乘i = 长整数乘i + 1;
    }
    返回 长整数乘积;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 2、判断与比较
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 最高半区的 bit15 是符号位
方法 长整数是负(长整数 值) 返回 逻辑
{
    返回 (值.半区3 & 32768) != 0;
}

// a ? b:-1/0/1。**符号不同时先比符号**(不然负数会被当"无符号大数"看)
方法 长整数比较(长整数 左, 长整数 右) 返回 整数
{
    逻辑 长整数比较负左 = (左.半区3 & 32768) != 0;
    逻辑 长整数比较负右 = (右.半区3 & 32768) != 0;
    如果 (长整数比较负左 != 长整数比较负右)
    {
        如果 (长整数比较负左)
        {
            返回 -1;
        }
        返回 1;
    }
    如果 (左.半区3 != 右.半区3)
    {
        如果 (左.半区3 < 右.半区3)
        {
            返回 -1;
        }
        返回 1;
    }
    如果 (左.半区2 != 右.半区2)
    {
        如果 (左.半区2 < 右.半区2)
        {
            返回 -1;
        }
        返回 1;
    }
    如果 (左.半区1 != 右.半区1)
    {
        如果 (左.半区1 < 右.半区1)
        {
            返回 -1;
        }
        返回 1;
    }
    如果 (左.半区0 != 右.半区0)
    {
        如果 (左.半区0 < 右.半区0)
        {
            返回 -1;
        }
        返回 1;
    }
    返回 0;
}

// 五个关系比较:直接拿 `长整数比较` 的结果比(它给 -1 / 0 / 1),不用先落局部
方法 长整数相等(长整数 左, 长整数 右) 返回 逻辑
{
    返回 长整数比较(左, 右) == 0;
}
// 有符号 64 位整数比大小:左 < 右 给真。
方法 长整数小于(长整数 左, 长整数 右) 返回 逻辑
{
    返回 长整数比较(左, 右) < 0;
}
// 有符号 64 位整数比大小:左 ≤ 右 给真。
方法 长整数小于等于(长整数 左, 长整数 右) 返回 逻辑
{
    返回 长整数比较(左, 右) <= 0;
}
// 有符号 64 位整数比大小:左 > 右 给真。
方法 长整数大于(长整数 左, 长整数 右) 返回 逻辑
{
    返回 长整数比较(左, 右) > 0;
}
// 有符号 64 位整数比大小:左 ≥ 右 给真。
方法 长整数大于等于(长整数 左, 长整数 右) 返回 逻辑
{
    返回 长整数比较(左, 右) >= 0;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 3、十进制打印与解析
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 4 个半区(无符号 64 位,值 = 2^48·a3 + 2^32·a2 + 2^16·a1 + a0)→ 十进制文字。
// 竖式除以 10:从最高半区往最低半区走,余数带进下一个半区。0 → "0"。
方法 长整数半区转字符串(无符号整数 半区0, 无符号整数 半区1, 无符号整数 半区2, 无符号整数 半区3) 返回 字符串
{
    无符号整数 长整数半区转半[4];
    长整数半区转半[0] = 半区0;
    长整数半区转半[1] = 半区1;
    长整数半区转半[2] = 半区2;
    长整数半区转半[3] = 半区3;
    字符 长整数半区转倒[20];                      // 2^64-1 是 20 位十进制
    整数 长整数半区转个 = 0;
    当 (长整数半区转半[0] != 0 || 长整数半区转半[1] != 0 || 长整数半区转半[2] != 0 || 长整数半区转半[3] != 0)
    {
        无符号整数 长整数半区转余 = 0;
        整数 长整数半区转k = 3;
        当 (长整数半区转k >= 0)
        {
            无符号整数 长整数半区转部 = (长整数半区转余 << 16) | 长整数半区转半[长整数半区转k];
            长整数半区转半[长整数半区转k] = 长整数半区转部 / 10;
            长整数半区转余 = 长整数半区转部 % 10;
            长整数半区转k = 长整数半区转k - 1;
        }
        长整数半区转倒[长整数半区转个] = 长整数半区转余 + '0';
        长整数半区转个 = 长整数半区转个 + 1;
    }
    字符串 长整数半区转果 = "";
    如果 (长整数半区转个 == 0)
    {
        拼接到(长整数半区转果, '0');
    }
    整数 长整数半区转i = 长整数半区转个 - 1;
    当 (长整数半区转i >= 0)
    {
        拼接到(长整数半区转果, 长整数半区转倒[长整数半区转i]);
        长整数半区转i = 长整数半区转i - 1;
    }
    返回 长整数半区转果;
}

// a 的十进制文字:负数带前导 '-'。**不用"取负再打印"** ——
//   INT64_MIN 取负还是它自己,那条路会打出错的符号串;
//   这里先把 |a| 按无符号解析出来再打印。
方法 长整数转字符串(长整数 值) 返回 字符串
{
    无符号整数 长整数转字符串s0 = 值.半区0;
    无符号整数 长整数转字符串s1 = 值.半区1;
    无符号整数 长整数转字符串s2 = 值.半区2;
    无符号整数 长整数转字符串s3 = 值.半区3;
    逻辑 长整数转字符串负 = (长整数转字符串s3 & 32768) != 0;
    如果 (长整数转字符串负)
    {
        长整数转字符串s0 = (65535 - 长整数转字符串s0) + 1;          // 取反加一 = 绝对值
        长整数转字符串s1 = 65535 - 长整数转字符串s1;
        长整数转字符串s2 = 65535 - 长整数转字符串s2;
        长整数转字符串s3 = 65535 - 长整数转字符串s3;
        无符号整数 长整数转字符串c = 长整数转字符串s0 >> 16;
        长整数转字符串s0 = 长整数转字符串s0 & 65535;
        长整数转字符串s1 = 长整数转字符串s1 + 长整数转字符串c;
        长整数转字符串c = 长整数转字符串s1 >> 16;
        长整数转字符串s1 = 长整数转字符串s1 & 65535;
        长整数转字符串s2 = 长整数转字符串s2 + 长整数转字符串c;
        长整数转字符串c = 长整数转字符串s2 >> 16;
        长整数转字符串s2 = 长整数转字符串s2 & 65535;
        长整数转字符串s3 = (长整数转字符串s3 + 长整数转字符串c) & 65535;
    }
    字符串 长整数转字符串串 = 长整数半区转字符串(长整数转字符串s0, 长整数转字符串s1, 长整数转字符串s2, 长整数转字符串s3);
    如果 (长整数转字符串负)
    {
        字符串 长整数转字符串果 = "-";
        拼接到(长整数转字符串果, 长整数转字符串串);
        返回 长整数转字符串果;
    }
    返回 长整数转字符串串;
}

// 十进制文字 → 长整数。可带前导 '-' 或 '+'。
// 约定:非法字符 / 空串 / 超出 int64 范围(INT64_MIN ~ INT64_MAX)**返回 0**(不报错)。
// 过程按无符号累加(×10 + 位),溢出看最高半区有没有进位出来;
// 最后再按符号查上界:负数 ≤ 2^63,正数 ≤ 2^63-1。
方法 字符串转长整数(字符串 文本) 返回 长整数
{
    长整数 字符串转长整数果;
    字符串转长整数果.半区0 = 0;
    字符串转长整数果.半区1 = 0;
    字符串转长整数果.半区2 = 0;
    字符串转长整数果.半区3 = 0;
    整数 字符串转长整数长 = 文本.长度();
    整数 字符串转长整数位 = 0;
    逻辑 字符串转长整数负 = 假;
    逻辑 字符串转长整数越 = 假;
    逻辑 字符串转长整数有 = 假;
    如果 (字符串转长整数长 > 0)
    {
        如果 (文本[0] == '-')
        {
            字符串转长整数负 = 真;
            字符串转长整数位 = 1;
        }
        否则
        {
            如果 (文本[0] == '+')
            {
                字符串转长整数位 = 1;
            }
        }
    }
    当 (字符串转长整数位 < 字符串转长整数长)
    {
        文字 字符串转长整数字 = 文本[字符串转长整数位];
        整数 字符串转长整数码 = 字符串转长整数字;
        如果 (字符串转长整数码 < 48 || 字符串转长整数码 > 57)
        {
            字符串转长整数越 = 真;
            跳出;
        }
        字符串转长整数有 = 真;
        整数 字符串转长整数c = 字符串转长整数果.半区0 * 10 + (字符串转长整数码 - 48);
        字符串转长整数果.半区0 = 字符串转长整数c & 65535;
        字符串转长整数c = 字符串转长整数c >> 16;
        字符串转长整数c = 字符串转长整数果.半区1 * 10 + 字符串转长整数c;
        字符串转长整数果.半区1 = 字符串转长整数c & 65535;
        字符串转长整数c = 字符串转长整数c >> 16;
        字符串转长整数c = 字符串转长整数果.半区2 * 10 + 字符串转长整数c;
        字符串转长整数果.半区2 = 字符串转长整数c & 65535;
        字符串转长整数c = 字符串转长整数c >> 16;
        字符串转长整数c = 字符串转长整数果.半区3 * 10 + 字符串转长整数c;
        字符串转长整数果.半区3 = 字符串转长整数c & 65535;
        字符串转长整数c = 字符串转长整数c >> 16;
        如果 (字符串转长整数c != 0)
        {
            // 第 4 段还有进位 = 超过 2^64-1
            字符串转长整数越 = 真;
        }
        字符串转长整数位 = 字符串转长整数位 + 1;
    }
    如果 (!字符串转长整数有)
    {
        字符串转长整数越 = 真;
    }
    如果 (字符串转长整数负)
    {
        如果 (字符串转长整数果.半区3 > 32768)
        {
            字符串转长整数越 = 真;
        }
        如果 (字符串转长整数果.半区3 == 32768 && (字符串转长整数果.半区2 != 0 || 字符串转长整数果.半区1 != 0 || 字符串转长整数果.半区0 != 0))
        {
            字符串转长整数越 = 真;
        }
    }
    否则
    {
        如果 (字符串转长整数果.半区3 > 32767)
        {
            字符串转长整数越 = 真;
        }
    }
    如果 (字符串转长整数越)
    {
        字符串转长整数果.半区0 = 0;
        字符串转长整数果.半区1 = 0;
        字符串转长整数果.半区2 = 0;
        字符串转长整数果.半区3 = 0;
        返回 字符串转长整数果;
    }
    如果 (字符串转长整数负)
    {
        长整数 字符串转长整数新 = 长整数取负(字符串转长整数果);
        返回 字符串转长整数新;
    }
    返回 字符串转长整数果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 4、顺手给几个常用值(免得每次都从字符串解析)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 值为 0 的长整数(四个半区全是 0),当“零”的起点用。
方法 长整数零() 返回 长整数
{
    长整数 长整数零果;
    长整数零果.半区0 = 0;
    长整数零果.半区1 = 0;
    长整数零果.半区2 = 0;
    长整数零果.半区3 = 0;
    返回 长整数零果;
}

// 最大的长整数 9223372036854775807(2^63-1,最高半区 32767)。
方法 长整数最大() 返回 长整数
{
    长整数 长整数最大果;
    长整数最大果.半区0 = 65535;
    长整数最大果.半区1 = 65535;
    长整数最大果.半区2 = 65535;
    长整数最大果.半区3 = 32767;
    返回 长整数最大果;
}

// 最小的长整数 -9223372036854775808(补码里只有符号位是 1)。
方法 长整数最小() 返回 长整数
{
    长整数 长整数最小果;
    长整数最小果.半区0 = 0;
    长整数最小果.半区1 = 0;
    长整数最小果.半区2 = 0;
    长整数最小果.半区3 = 32768;
    返回 长整数最小果;
}
