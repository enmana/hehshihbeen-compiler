// ============================================================
// 错误.hb —— 状态码的名字与说法(纯 HB,零依赖)
//
// 用法:包含 "../库/错误.hb";`整数 状态 = 打开读流("数据/名单.bin", 句柄)`,然后
//
// 口径(2026-10):**21 个公开整数就是编译器里那 21 个 `状态_*` 常量的值**(文件 / 目录 / 流 / 网络那一族
//   内建都用同一套号)。它们是**模块级整数** ⇒ **别给它们赋值**;
//
// 21 个号:`无错` 0 · `没挂能力` 1 · `打不开` 2 · `放不下` 3 · `读写失败` 4 · `参数不合法` 9 ·
//   `不在白名单` 10 · `超时` 11 · `退出码非零` 12 · `目录不空` 13 · `已经存在` 14 · `不是目录` 15 ·
//   `到末尾` 16 · `连不上` 17 · `网络超时` 18 · `响应出错` 19 · `网址不在白名单` 20 · `协议不支持` 21 ·
//   `句柄无效` 22 · `流太多` 23 · `任务太多` 24
//
// 英文对照:说明 describe · 是否成功 succeeded
//
// 边界(如实登记):
//   · **`说明` 认不出的码也给一句话**;
//   · **只管"状态码"**;"运行期错误"(除零 / 越界)当场停下;
// 提供的函数:21 个公开整数 + 2 个函数(逐个见下面那张公开方法表)。
// 复杂度:都是 O(1)(最多 21 次比较)。
// ============================================================
模块 错误

// 21 个状态码(与编译器里那 21 个 `状态_*` 常量逐条一致)
整数 无错 = 0;
整数 没挂能力 = 1;
整数 打不开 = 2;
整数 放不下 = 3;
整数 读写失败 = 4;
整数 参数不合法 = 9;
整数 不在白名单 = 10;
整数 超时 = 11;
整数 退出码非零 = 12;
整数 目录不空 = 13;
整数 已经存在 = 14;
整数 不是目录 = 15;
整数 到末尾 = 16;
整数 连不上 = 17;
整数 网络超时 = 18;
整数 响应出错 = 19;
整数 网址不在白名单 = 20;
整数 协议不支持 = 21;
整数 句柄无效 = 22;
整数 流太多 = 23;
整数 任务太多 = 24;

// 私有:整数转十进制文字(只给"认不出的码"拼那句话用)
私有 方法 错误转字符串(整数 值) 返回 字符串
{
    字符串 结果 = "";
    无符号整数 大 = 值;
    如果 (值 < 0)
    {
        大 = 0 - 值;
        拼接到(结果, '-');
    }
    整数 位数 = 1;
    无符号整数 剩 = 大;
    当 (剩 >= 10)
    {
        剩 = 剩 / 10;
        位数 = 位数 + 1;
    }
    剩 = 大;
    整数 k = 0;
    当 (k < 位数)
    {
        整数 移位量 = 位数 - 1 - k;
        无符号整数 十的幂 = 1;
        整数 j = 0;
        当 (j < 移位量)
        {
            十的幂 = 十的幂 * 10;
            j = j + 1;
        }
        字符 这位 = 48 + 剩 / 十的幂 % 10;
        拼接到(结果, 这位);
        剩 = 剩 % 十的幂;
        k = k + 1;
    }
    返回 结果;
}

// ---------- 说明 / 是否成功 ----------

// 这个码是什么意思(认不出给"未知状态码(N)")。
方法 说明(整数 码) 返回 字符串
{
    如果 (码 == 无错)
    {
        返回 "成功(没有出错)";
    }
    如果 (码 == 没挂能力)
    {
        返回 "这个宿主没挂这项能力(手机端 / 独立 exe 上常见)";
    }
    如果 (码 == 打不开)
    {
        返回 "打不开:文件 / 目录不在,或者路径上缺目录";
    }
    如果 (码 == 放不下)
    {
        返回 "放不下:目标那块地方装不了这么多字节";
    }
    如果 (码 == 读写失败)
    {
        返回 "读写失败:文件在,但这一趟读 / 写没成";
    }
    如果 (码 == 参数不合法)
    {
        返回 "参数不合法:给的数字 / 名字不在允许的范围里";
    }
    如果 (码 == 不在白名单)
    {
        返回 "不在白名单:这一项没写进工程文件的允许表";
    }
    如果 (码 == 超时)
    {
        返回 "超时:等太久了,这一趟放弃";
    }
    如果 (码 == 退出码非零)
    {
        返回 "退出码非零:子进程跑完了,但它自己报错退出";
    }
    如果 (码 == 目录不空)
    {
        返回 "目录不空:删目录只删空目录,里面还有东西";
    }
    如果 (码 == 已经存在)
    {
        返回 "已经存在:目标已经在那儿了,这一趟不覆盖";
    }
    如果 (码 == 不是目录)
    {
        返回 "不是目录:要目录的地方给了一个文件";
    }
    如果 (码 == 到末尾)
    {
        返回 "到末尾:后面没有更多字节了";
    }
    如果 (码 == 连不上)
    {
        返回 "连不上:对端不在,或者不接受这一趟连接";
    }
    如果 (码 == 网络超时)
    {
        返回 "网络超时:连上之后等数据等太久了";
    }
    如果 (码 == 响应出错)
    {
        返回 "响应出错:对端答的不是一个正常回应";
    }
    如果 (码 == 网址不在白名单)
    {
        返回 "网址不在白名单:主机 + 端口没写进工程文件的 `网址` 表";
    }
    如果 (码 == 协议不支持)
    {
        返回 "协议不支持:这一趟用的协议这一版不认";
    }
    如果 (码 == 句柄无效)
    {
        返回 "句柄无效:这个句柄没开过 / 已经关了 / 已经作废";
    }
    如果 (码 == 流太多)
    {
        返回 "流太多:同时开的流到了上限(64 格)";
    }
    如果 (码 == 任务太多)
    {
        返回 "任务太多:同时跑的异步任务到了上限(32 格)";
    }
    字符串 兜底 = "未知状态码(";               // 字符串不能拿 `+` 拼(语言口径):用 `拼接到`
    拼接到(兜底, 错误转字符串(码));
    拼接到(兜底, ')');
    返回 兜底;
}

// 码 == 无错(0)。
方法 是否成功(整数 码) 返回 逻辑
{
    返回 码 == 无错;
}
