// ============================================================
// 三维数学.hb —— 3D 要用的浮点数学(纯 HB)
//
// 口径(2026-10):这门语言有 `浮点` 与四则,但没有开方 / 正余弦 ⇒ 这一份补齐 `开方`(负数给 0)、
//   `正弦` / `余弦`(角度一律用**弧度**)、`文`(浮点 → 字符串),误差在 1e-6 以下。
//   旋转只做**右乘列向量**(`x' = R · x`),按"先绕 X、再绕 Y、最后绕 Z"合;要别的顺序就分开调。
//
// ⚠ **`输出行(浮点)` 打的是位模式**(3.0 打成 1077936128)⇒ 要给人看浮点走 `三维数学.文(数, 小数位)`(0~6)。
// 提供的函数(6 个):逐个见下面那张公开方法表。
// 英文对照:库里不另立英文函数。
// 复杂度:全是固定轮数(开方 20 轮、正余弦固定项数)。
// 边界(如实登记):没有内建的开方 / 三角函数(这一份自己写)。
// ============================================================
模块 三维数学

// 常量:圆周率,以及"度 → 弧度"
方法 圆周率() 返回 浮点
{
    返回 3.14159265;
}

// 度 → 弧度。
方法 弧度(浮点 度) 返回 浮点
{
    返回 度 * 3.14159265 / 180.0;
}

// 私有:浮点绝对值(避免和内建那一族撞名)
私有 方法 三维数学绝对(浮点 x) 返回 浮点
{
    如果 (x < 0.0)
    {
        返回 0.0 - x;
    }
    返回 x;
}

// 平方根:牛顿迭代 20 轮;负数给 0(不报错)。
方法 开方(浮点 x) 返回 浮点
{
    如果 (x <= 0.0)
    {
        返回 0.0;
    }
    浮点 猜 = x;
    如果 (猜 < 1.0)
    {
        猜 = 1.0;                      // 小于 1 的数从 1 起收敛更快
    }
    整数 轮 = 0;
    当 (轮 < 20)
    {
        猜 = (猜 + x / 猜) * 0.5;
        轮 = 轮 + 1;
    }
    返回 猜;
}

// 私有:把角化到 [-π, π](泰勒级数只在原点附近好用)。
私有 方法 三维数学化角(浮点 角) 返回 浮点
{
    浮点 两派 = 6.28318531;
    浮点 半派 = 3.14159265;
    浮点 a = 角;
    // 先按 2π 绕:最多绕 64 圈(再大的角调用方自己先归一)
    整数 轮 = 0;
    当 (轮 < 64)
    {
        如果 (a > 半派)
        {
            a = a - 两派;
        }
        否则
        {
            如果 (a < 0.0 - 半派)
            {
                a = a + 两派;
            }
            否则
            {
                轮 = 64;                   // 已经落进区间,收工
            }
        }
        轮 = 轮 + 1;
    }
    返回 a;
}

// 正弦:泰勒级数(化角之后展开到 a¹³,在 [-π, π] 上误差约 1e-8);角度用弧度。
方法 正弦(浮点 角) 返回 浮点
{
    浮点 a = 三维数学化角(角);
    浮点 平方 = a * a;
    浮点 项 = a;
    浮点 和 = a;
    项 = 0.0 - 项 * 平方 / 6.0;            // /3!
    和 = 和 + 项;
    项 = 0.0 - 项 * 平方 / 20.0;           // /(5·4)
    和 = 和 + 项;
    项 = 0.0 - 项 * 平方 / 42.0;           // /(7·6)
    和 = 和 + 项;
    项 = 0.0 - 项 * 平方 / 72.0;           // /(9·8)
    和 = 和 + 项;
    项 = 0.0 - 项 * 平方 / 110.0;          // /(11·10)
    和 = 和 + 项;
    项 = 0.0 - 项 * 平方 / 156.0;          // /(13·12)
    和 = 和 + 项;
    返回 和;
}

// 余弦:`cos a = sin(a + π/2)`(不另写一套级数,两条路永远同相)。
方法 余弦(浮点 角) 返回 浮点
{
    返回 正弦(角 + 1.57079633);
}

// 浮点转字符串(内建 `输出行` 会把浮点按整数打);`小数位` = 小数点后几位(0~6)。
//   用法:`输出行(三维数学.文(数, 3));`
方法 文(浮点 x, 整数 小数位) 返回 字符串
{
    字符串 结果 = "";
    浮点 v = x;
    如果 (v < 0.0)
    {
        拼接到(结果, '-');
        v = 0.0 - v;
    }
    整数 整部 = 整数(v);
    浮点 余 = v - 浮点(整部);
    拼接到(结果, 三维数学整数文(整部));
    整数 要几位 = 小数位;
    如果 (要几位 > 6)
    {
        要几位 = 6;                        // 单精度大约只有 7 位有效数字,再多是假的
    }
    如果 (要几位 > 0)
    {
        拼接到(结果, '.');
        整数 k = 0;
        当 (k < 要几位)
        {
            余 = 余 * 10.0;
            // ⚠ **必须 +0.5 再截断**:单精度下 `0.99` 的余数会算成 0.9899999…,
            // 直接截断就差一个数(实测 `-0.99` 打成 `-0.98`)。
            整数 位 = 整数(余 + 0.5);
            如果 (位 > 9)
            {
                位 = 9;
            }
            拼接到(结果, 三维数学数码文(位));
            余 = 余 - 浮点(位);
            k = k + 1;
        }
    }
    返回 结果;
}

// 私有:整数 → 十进制串(先拼成倒的,再倒着读回来)
私有 方法 三维数学整数文(整数 n) 返回 字符串
{
    字符串 结果 = "";
    整数 正 = n;
    如果 (正 < 0)
    {
        拼接到(结果, '-');
        正 = 0 - 正;
    }
    如果 (正 == 0)
    {
        拼接到(结果, '0');
        返回 结果;
    }
    字符串 倒 = "";
    当 (正 > 0)
    {
        拼接到(倒, 三维数学数码文(正 % 10));
        正 = 正 / 10;
    }
    整数 末 = 倒.长度() - 1;
    当 (末 >= 0)
    {
        拼接到(结果, 倒[末]);
        末 = 末 - 1;
    }
    返回 结果;
}

// 私有:一位数码 → 一个字符的串
私有 方法 三维数学数码文(整数 位) 返回 字符串
{
    如果 (位 == 0)
    {
        返回 "0";
    }
    如果 (位 == 1)
    {
        返回 "1";
    }
    如果 (位 == 2)
    {
        返回 "2";
    }
    如果 (位 == 3)
    {
        返回 "3";
    }
    如果 (位 == 4)
    {
        返回 "4";
    }
    如果 (位 == 5)
    {
        返回 "5";
    }
    如果 (位 == 6)
    {
        返回 "6";
    }
    如果 (位 == 7)
    {
        返回 "7";
    }
    如果 (位 == 8)
    {
        返回 "8";
    }
    返回 "9";
}
