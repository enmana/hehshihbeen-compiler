// ============================================================
// 剖析.hb —— 计时 / 计数 / 报表(依赖 `时间.hb` + `数字.hb`)
//
// 用法:包含 "../库/剖析.hb";`剖析.开始("读文件")` → … → `剖析.结束("读文件")`。
//
// 口径(2026-10):
//   · **标签是一整条字符串**,按**内容**找槽:**只有 `开始` 会开新槽**(最多 16 个;第 17 个给假),
//     `结束` 与那几个取数的碰到没见过的标签一律给 -1 / 0,**不会**悄悄多出一个空槽;
//   · **`开始(标签)`**:记下此刻的毫秒;这个标签**已经在跑**时给假(不重入 ⇒ 递归 / 嵌套的同一段
//     会算成一次,不会把计时器冲掉);
//   · **`结束(标签)`**:返回这一趟的毫秒数并累加;这个标签**没在跑**时给 -1(不记这一笔);
//   · **时钟是单调毫秒**(`时间.开机毫秒()`,不是墙上的钟)⇒ 改系统时间 / 夏令时都不影响它;
//     分辨力是本机时钟那一条(Windows 上通常 1~16 毫秒),**单次几毫秒的活别指望准** —— 跑 N 次看平均;
//   · **`报表()`**:一个标签一行(`标签` + 次数 / 总毫秒 / 平均毫秒 / 最大毫秒 + 换行),
//     按**开槽的先后**排;一个槽都没有给空串;平均 = 总毫秒 / 次数(整数除);
//   · **`清零()`** 把次数 / 总 / 最大归零,槽与标签都留着。
//
// 英文对照:开始 begin · 结束 end · 次数 times · 总毫秒 totalMs · 平均毫秒 averageMs · 最大毫秒 maxMs
//   报表 report · 清零 reset · 是空的 isEmpty
//
// 复杂度:开始 / 结束 / 那几个取数都是 O(槽数)(最多 16 次字符串比较);报表 O(槽数 × 数字位数)。
//
// 边界(如实登记):
//   · **最多 16 个标签**:第 17 个标签 `开始` 给假(前面那 16 个照旧);
//   · **不做调用树 / 嵌套自洽,也不做基准测试那一档**(要跑 N 次就自己写 `当` 循环夹住 `开始` / `结束`);
//   · **时钟被系统挂起 / 休眠时会算进去**;`报表` 每次现造一条结果串 ⇒ **别在循环里反复要报表**。
// 提供的函数(9 个):逐个见下面那张公开方法表。
// 内存账:16 个槽静态几百字节;`报表` 每次现造一条结果串 ⇒ **别在循环里反复要报表**。
// ============================================================
模块 剖析

包含 "时间.hb"
包含 "数字.hb"

私有 字符串 剖析标签[16];
私有 整数 剖析次数表[16];
私有 整数 剖析总表[16];
私有 整数 剖析最大表[16];
私有 整数 剖析起表[16];
私有 逻辑 剖析在跑[16];
私有 整数 剖析槽数 = 0;

// 私有:只找,不开槽(没有给 -1)—— 只读那几条与 `结束` 走它
私有 方法 剖析查(字符串 标签) 返回 整数
{
    整数 i = 0;
    当 (i < 剖析槽数)
    {
        如果 (剖析标签[i] == 标签)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// 私有:找槽,没有就开一个(满 16 给 -1)—— 只有 `开始` 走它
私有 方法 剖析开(字符串 标签) 返回 整数
{
    整数 已有 = 剖析查(标签);
    如果 (已有 >= 0)
    {
        返回 已有;
    }
    如果 (剖析槽数 >= 16)
    {
        返回 -1;
    }
    整数 新 = 剖析槽数;
    剖析标签[新] = 标签;
    剖析次数表[新] = 0;
    剖析总表[新] = 0;
    剖析最大表[新] = 0;
    剖析起表[新] = 0;
    剖析在跑[新] = 假;
    剖析槽数 = 剖析槽数 + 1;
    返回 新;
}

// ============================================================
// 1、计时
// ============================================================

// 开始计时;这个标签已经在跑给假(不重入)。
方法 开始(字符串 标签) 返回 逻辑
{
    整数 槽 = 剖析开(标签);
    如果 (槽 < 0)
    {
        返回 假;
    }
    如果 (剖析在跑[槽])
    {
        返回 假;
    }
    剖析起表[槽] = 时间.开机毫秒();
    剖析在跑[槽] = 真;
    返回 真;
}

// 收工;返回这一趟毫秒数;-1 = 这个标签没在跑。
方法 结束(字符串 标签) 返回 整数
{
    整数 槽 = 剖析查(标签);
    如果 (槽 < 0)
    {
        返回 -1;
    }
    如果 (剖析在跑[槽] == 假)
    {
        返回 -1;
    }
    整数 这一趟 = 时间.开机毫秒() - 剖析起表[槽];
    如果 (这一趟 < 0)
    {
        这一趟 = 0;
    }
    剖析在跑[槽] = 假;
    剖析次数表[槽] = 剖析次数表[槽] + 1;
    剖析总表[槽] = 剖析总表[槽] + 这一趟;
    如果 (这一趟 > 剖析最大表[槽])
    {
        剖析最大表[槽] = 这一趟;
    }
    返回 这一趟;
}

// ============================================================
// 2、看数
// ============================================================

// 跑过几次(没有这个标签给 0)。
方法 次数(字符串 标签) 返回 整数
{
    整数 槽 = 剖析查(标签);
    如果 (槽 < 0)
    {
        返回 0;
    }
    返回 剖析次数表[槽];
}

// 累计毫秒(没有这个标签给 0)。
方法 总毫秒(字符串 标签) 返回 整数
{
    整数 槽 = 剖析查(标签);
    如果 (槽 < 0)
    {
        返回 0;
    }
    返回 剖析总表[槽];
}

// 总 / 次(整数除;没跑过给 0)。
方法 平均毫秒(字符串 标签) 返回 整数
{
    整数 槽 = 剖析查(标签);
    如果 (槽 < 0)
    {
        返回 0;
    }
    如果 (剖析次数表[槽] <= 0)
    {
        返回 0;
    }
    返回 剖析总表[槽] / 剖析次数表[槽];
}

// 最慢那一次(没跑过给 0)。
方法 最大毫秒(字符串 标签) 返回 整数
{
    整数 槽 = 剖析查(标签);
    如果 (槽 < 0)
    {
        返回 0;
    }
    返回 剖析最大表[槽];
}

// ============================================================
// 3、报表与清零
// ============================================================

// 一张表(一个标签一行);一个槽都没有给空串。
方法 报表() 返回 字符串
{
    字符 换行 = 10;
    字符串 结果 = "";
    整数 i = 0;
    当 (i < 剖析槽数)
    {
        字符串 数文 = 数字.按进制转字符串(剖析次数表[i], 10);
        拼接到(结果, 剖析标签[i]);
        拼接到(结果, "  次数=");
        拼接到(结果, 数文);
        拼接到(结果, "  总毫秒=");
        数文 = 数字.按进制转字符串(剖析总表[i], 10);
        拼接到(结果, 数文);
        拼接到(结果, "  平均毫秒=");
        如果 (剖析次数表[i] > 0)
        {
            数文 = 数字.按进制转字符串(剖析总表[i] / 剖析次数表[i], 10);
        }
        否则
        {
            数文 = "0";
        }
        拼接到(结果, 数文);
        拼接到(结果, "  最大毫秒=");
        数文 = 数字.按进制转字符串(剖析最大表[i], 10);
        拼接到(结果, 数文);
        拼接到(结果, 换行);
        i = i + 1;
    }
    返回 结果;
}

// 数字归零(槽留着,标签与顺序都还在;没有返回值,单独成句用)。
方法 清零()
{
    整数 i = 0;
    当 (i < 剖析槽数)
    {
        剖析次数表[i] = 0;
        剖析总表[i] = 0;
        剖析最大表[i] = 0;
        剖析起表[i] = 0;
        剖析在跑[i] = 假;
        i = i + 1;
    }
    返回
}

// 一个槽都没开过给真。
方法 是空的() 返回 逻辑
{
    返回 剖析槽数 == 0;
}
