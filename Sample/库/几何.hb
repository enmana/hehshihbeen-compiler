// ============================================================
// 几何.hb —— 点 / 矩形 / 线段(纯 HB,零依赖;全整数)
//
// 用法:包含 "../库/几何.hb";`几何.点在矩形内(鼠标x, 鼠标y, 左, 上, 宽, 高)`、
//   `几何.交宽(首左, 首宽, 次左, 次宽)`、`几何.线段相交(首x1, 首y1, 首x2, 首y2, 次x1, 次y1, 次x2, 次y2)`。
//
// 口径(2026-10):
//   · **矩形就是四个整数**:`左 / 上 / 宽 / 高`,**左上角闭、右下角开** ——
//     占的格子是 `[左, 左 + 宽) × [上, 上 + 高)`(`宽 = 高 = 0` 是空框);`宽 / 高` 给负数一律当**空框**;
//   · **相交 = 交叠面积 > 0**:边挨着边(交宽 = 0)算**不相交**;要判"挨着也算",自己写 `交宽 >= 0 && 交高 >= 0`;
//   · **交叠框是现算的**:`交左 / 交上` 给左上角、`交宽 / 交高` 给宽高(不相交时其中至少一个是 0 或负数);
//   · **距离是"向下取整的平方根"**:`距离(…)` 给整数(3-4-5 那种给 5,`距离平方` 给 25);
//   · **线段相交把"端点搭在另一条线上"也算相交**;要"内部相交才算"就自己排掉端点重合那几种。
//
// 英文对照:点在矩形内 pointInRect · 矩形相交 rectsOverlap · 矩形内含 rectContains
//   交左 overlapLeft · 交上 overlapTop · 交宽 overlapWidth · 交高 overlapHeight
//   距离平方 distanceSquared · 距离 distance · 线段相交 segmentsCross · 点在线段上 pointOnSegment
//
// 复杂度:全是 O(1)(`距离` 多 16 轮整数开方,`线段相交` 固定 4 次叉积);本库不申请堆、不占缓冲。
//
// 边界(如实登记):
//   · **没有小数**(点坐标 / 宽高都是整数);**不做多边形 / 圆 / 凸包 / 旋转矩形**;
//   · **坐标上界**:`距离平方` 里 `|Δx|` 与 `|Δy|` 都不超过 **46340** 时平方和还在 32 位里;
//     `线段相交` / `点在线段上` 的叉积要求坐标差在 **±30000** 以内(屏幕坐标够用好几倍)。
// 提供的函数(11 个):逐个见下面那张公开方法表。
// 内存账:本库自己一块缓冲都不占(不申请堆、不建模块级大数组、不造字符串)。
// ============================================================
模块 几何

// 私有:两个整数的较小
私有 方法 几何小者(整数 左, 整数 右) 返回 整数
{
    如果 (左 < 右)
    {
        返回 左;
    }
    返回 右;
}

// 私有:两个整数的较大
私有 方法 几何大者(整数 左, 整数 右) 返回 整数
{
    如果 (左 > 右)
    {
        返回 左;
    }
    返回 右;
}

// 私有:叉积 (b - a) × (c - a)(正 = c 在 ab 左边,0 = 三点共线)
私有 方法 几何叉(整数 ax, 整数 ay, 整数 bx, 整数 by, 整数 cx, 整数 cy) 返回 整数
{
    返回 (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
}

// 私有:向下取整的整数平方根(逐位还原法,最多 16 轮)
私有 方法 几何开方(无符号整数 值) 返回 整数
{
    无符号整数 位 = 1073741824;
    无符号整数 根 = 0;
    无符号整数 余 = 值;
    当 (位 > 余)
    {
        位 = 位 >> 2;
    }
    当 (位 > 0)
    {
        无符号整数 试 = 根 + 位;
        根 = 根 >> 1;
        如果 (余 >= 试)
        {
            余 = 余 - 试;
            根 = 根 + 位;
        }
        位 = 位 >> 2;
    }
    返回 根;
}

// ============================================================
// 1、点与矩形
// ============================================================

// 点在不在矩形里(左上角闭、右下角开;空框一律给假)。
方法 点在矩形内(整数 x, 整数 y, 整数 左, 整数 上, 整数 宽, 整数 高) 返回 逻辑
{
    如果 (宽 <= 0 || 高 <= 0)
    {
        返回 假;
    }
    返回 x >= 左 && x < 左 + 宽 && y >= 上 && y < 上 + 高;
}

// 两个矩形有没有交叠(交叠面积 > 0 才算;边挨着边算不相交)。
方法 矩形相交(整数 首左, 整数 首上, 整数 首宽, 整数 首高, 整数 次左, 整数 次上, 整数 次宽, 整数 次高) 返回 逻辑
{
    返回 交宽(首左, 首宽, 次左, 次宽) > 0 && 交高(首上, 首高, 次上, 次高) > 0;
}

// 外框是不是把内框整个包住(内框是空框给假)。
方法 矩形内含(整数 外左, 整数 外上, 整数 外宽, 整数 外高, 整数 内左, 整数 内上, 整数 内宽, 整数 内高) 返回 逻辑
{
    如果 (外宽 <= 0 || 外高 <= 0 || 内宽 <= 0 || 内高 <= 0)
    {
        返回 假;
    }
    返回 内左 >= 外左 && 内上 >= 外上 && 内左 + 内宽 <= 外左 + 外宽 && 内上 + 内高 <= 外上 + 外高;
}

// 交叠框的左边界(取两个左边里靠右的那个)。
方法 交左(整数 首左, 整数 首宽, 整数 次左, 整数 次宽) 返回 整数
{
    返回 几何大者(首左, 次左);
}

// 交叠框的上边界(取两个上边里靠下的那个)。
方法 交上(整数 首上, 整数 首高, 整数 次上, 整数 次高) 返回 整数
{
    返回 几何大者(首上, 次上);
}

// 交叠框的宽(<= 0 = 这一维上没有交叠)。
方法 交宽(整数 首左, 整数 首宽, 整数 次左, 整数 次宽) 返回 整数
{
    返回 几何小者(首左 + 首宽, 次左 + 次宽) - 几何大者(首左, 次左);
}

// 交叠框的高(<= 0 = 这一维上没有交叠)。
方法 交高(整数 首上, 整数 首高, 整数 次上, 整数 次高) 返回 整数
{
    返回 几何小者(首上 + 首高, 次上 + 次高) - 几何大者(首上, 次上);
}

// ============================================================
// 2、距离
// ============================================================

// Δx² + Δy²(不开方;比远近用这一条最省)。
方法 距离平方(整数 首x, 整数 首y, 整数 次x, 整数 次y) 返回 无符号整数
{
    整数 横差 = 首x - 次x;
    整数 纵差 = 首y - 次y;
    返回 横差 * 横差 + 纵差 * 纵差;
}

// 欧几里得距离,向下取整(3-4 那种给 5)。
方法 距离(整数 首x, 整数 首y, 整数 次x, 整数 次y) 返回 整数
{
    返回 几何开方(距离平方(首x, 首y, 次x, 次y));
}

// ============================================================
// 3、线段
// ============================================================

// 点在不在线段上(先共线、再看落没落在段内)。
方法 点在线段上(整数 x, 整数 y, 整数 x1, 整数 y1, 整数 x2, 整数 y2) 返回 逻辑
{
    如果 (几何叉(x1, y1, x2, y2, x, y) != 0)
    {
        返回 假;
    }
    如果 (x < 几何小者(x1, x2) || x > 几何大者(x1, x2))
    {
        返回 假;
    }
    如果 (y < 几何小者(y1, y2) || y > 几何大者(y1, y2))
    {
        返回 假;
    }
    返回 真;
}

// 两条线段相不相交(端点搭在另一条线上也算)。
方法 线段相交(整数 首x1, 整数 首y1, 整数 首x2, 整数 首y2, 整数 次x1, 整数 次y1, 整数 次x2, 整数 次y2) 返回 逻辑
{
    整数 首侧1 = 几何叉(首x1, 首y1, 首x2, 首y2, 次x1, 次y1);
    整数 首侧2 = 几何叉(首x1, 首y1, 首x2, 首y2, 次x2, 次y2);
    整数 次侧1 = 几何叉(次x1, 次y1, 次x2, 次y2, 首x1, 首y1);
    整数 次侧2 = 几何叉(次x1, 次y1, 次x2, 次y2, 首x2, 首y2);
    逻辑 头一段 = (首侧1 > 0 && 首侧2 < 0) || (首侧1 < 0 && 首侧2 > 0);
    逻辑 尾一段 = (次侧1 > 0 && 次侧2 < 0) || (次侧1 < 0 && 次侧2 > 0);
    如果 (头一段 && 尾一段)
    {
        返回 真;
    }
    如果 (首侧1 == 0 && 点在线段上(次x1, 次y1, 首x1, 首y1, 首x2, 首y2))
    {
        返回 真;
    }
    如果 (首侧2 == 0 && 点在线段上(次x2, 次y2, 首x1, 首y1, 首x2, 首y2))
    {
        返回 真;
    }
    如果 (次侧1 == 0 && 点在线段上(首x1, 首y1, 次x1, 次y1, 次x2, 次y2))
    {
        返回 真;
    }
    如果 (次侧2 == 0 && 点在线段上(首x2, 首y2, 次x1, 次y1, 次x2, 次y2))
    {
        返回 真;
    }
    返回 假;
}
