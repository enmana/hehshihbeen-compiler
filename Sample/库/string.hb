// ============================================================
// string.hb —— 字符串库(用新字符串类型 `字符串 名字` 写)
//
// 用法:包含 "../库/string.hb"
//
// 设计口径(2026-09 重写):语言已经内置的**不再重复提供**(一个需求一个入口)—— 长度走 `字符串.长度()`(按
//   **文字**算)、下标走 `名字[下标]`(取出一个 `文字`;等长才能写回去)、比较走 `== != < <= > >=`(按 UTF-8
//   字节)、输出走 `输出` / `输出行`、赋值是值语义、拼接走 `拼接到(结果, a, b…)`。这里只放"语言还没有的"
//   字符串工具:库里的函数都收 / 发 `字符串`,不跟"地址 + 长度"打交道。
//
// 段表为什么是"两条并排的数组"(`切分` / `段数` / `段取` / `连接` 那一族):三条语言边界是写库前先量出来的 ——
//   ① 动态列表**不能当参数传**(报"列表的地址不能取")、**不能当返回值**;② 元素是字符串的列表**不能进结构
//   字段**;③ 字符串参数 + 结构参数同处一个函数头时,结构字段取下标**编不过**(实测报"`XX` 不是字符串" /
//   "`XX.XX` 不是列表/数组")⇒ 段表走**调用方给的定长整数数组**;段本身**不另存一份**(表里只有下标,文字还在
//   原串里)⇒ 库不设全局段池、不留跨调用状态。
//
// 提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 一个文字是不是"空白"(空格 / 制表 / 回车 / 换行)
// 这个 `文字` 是不是空格 / 制表 / 回车 / 换行
方法 是空白(文字 某字) 返回 逻辑
{
    如果 (某字 == ' ' || 某字 == '\t' || 某字 == '\r' || 某字 == '\n')
    {
        返回 真;
    }
    返回 假;
}

// 数值 → 十进制文字:负数带 '-';0 就是 "0"
// 整数 → 十进制文字(负数带 -,含 -2147483648)
方法 转字符串(var 数值) 返回 字符串
{
    字符串 结果;
    无符号整数 剩 = 数值;
    如果 (数值 < 0)
    {
        拼接到(结果, '-');
        剩 = 0 - 剩;
    }
    字符 数字[10];
    整数 位 = 0;
    当 (剩 > 0)
    {
        数字[位] = 剩 % 10 + '0';
        位 = 位 + 1;
        剩 = 剩 / 10;
    }
    如果 (位 == 0)
    {
        拼接到(结果, '0');
    }
    当 (位 > 0)
    {
        位 = 位 - 1;
        拼接到(结果, 数字[位]);
    }
    返回 结果;
}

// 下标;没找到 -1;空子串返回 0
方法 找子串(字符串 主串, 字符串 子串) 返回 整数
{
    整数 主长 = 主串.长度();
    整数 子长 = 子串.长度();
    如果 (子长 == 0)
    {
        返回 0;
    }
    整数 i = 0;
    当 (i + 子长 <= 主长)
    {
        整数 j = 0;
        当 (j < 子长)
        {
            如果 (主串[i + j] != 子串[j])
            {
                跳出;
            }
            j = j + 1;
        }
        如果 (j == 子长)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// 整串是不是以 `前缀` 开头
方法 以开头(字符串 主串, 字符串 前缀) 返回 逻辑
{
    整数 前长 = 前缀.长度();
    如果 (前长 > 主串.长度())
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 前长)
    {
        如果 (主串[i] != 前缀[i])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 整串是不是以 `后缀` 结尾
方法 以结尾(字符串 主串, 字符串 后缀) 返回 逻辑
{
    整数 主长 = 主串.长度();
    整数 后长 = 后缀.长度();
    如果 (后长 > 主长)
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 后长)
    {
        如果 (主串[主长 - 后长 + i] != 后缀[i])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 取子串:从"起"取"个数"个**文字**(下标按文字算,中文一个字算一个)。
// 从 `起` 取 `个数` 个文字;越界自动夹到范围内
方法 取子串(字符串 主串, 整数 起, 整数 个数) 返回 字符串
{
    字符串 结果;
    整数 长 = 主串.长度();
    如果 (个数 <= 0)
    {
        返回 结果;
    }
    如果 (起 < 0)
    {
        起 = 0;
    }
    如果 (起 >= 长)
    {
        返回 结果;
    }
    整数 止 = 起 + 个数;
    如果 (止 > 长)
    {
        止 = 长;
    }
    整数 i = 起;
    当 (i < 止)
    {
        拼接到(结果, 主串[i]);
        i = i + 1;
    }
    返回 结果;
}

// 全部替换(`旧` 为空串时原样返回)
方法 替换(字符串 主串, 字符串 旧, 字符串 新) 返回 字符串
{
    字符串 结果;
    整数 旧长 = 旧.长度();
    整数 主长 = 主串.长度();
    如果 (旧长 == 0)
    {
        拼接到(结果, 主串);
        返回 结果;
    }
    整数 i = 0;
    当 (i < 主长)
    {
        整数 j = 0;
        当 (j < 旧长 && i + j < 主长)
        {
            如果 (主串[i + j] != 旧[j])
            {
                跳出;
            }
            j = j + 1;
        }
        如果 (j == 旧长)
        {
            拼接到(结果, 新);
            i = i + 旧长;
        }
        否则
        {
            拼接到(结果, 主串[i]);
            i = i + 1;
        }
    }
    返回 结果;
}

// 去掉首尾的空格 / 制表 / 回车 / 换行
方法 去空白(字符串 主串) 返回 字符串
{
    整数 长 = 主串.长度();
    整数 头 = 0;
    当 (头 < 长 && 是空白(主串[头]))
    {
        头 = 头 + 1;
    }
    整数 尾 = 长;
    当 (尾 > 头 && 是空白(主串[尾 - 1]))
    {
        尾 = 尾 - 1;
    }
    返回 取子串(主串, 头, 尾 - 头);
}

// ASCII 的 a~z 折成大写;其余原样
方法 转大写(字符串 主串) 返回 字符串
{
    字符串 结果;
    整数 长 = 主串.长度();
    整数 i = 0;
    当 (i < 长)
    {
        文字 c = 主串[i];
        如果 (c >= 'a' && c <= 'z')
        {
            c = c - 32;
        }
        拼接到(结果, c);
        i = i + 1;
    }
    返回 结果;
}

// ASCII 的 A~Z 折成小写;其余原样
方法 转小写(字符串 主串) 返回 字符串
{
    字符串 结果;
    整数 长 = 主串.长度();
    整数 i = 0;
    当 (i < 长)
    {
        文字 c = 主串[i];
        如果 (c >= 'A' && c <= 'Z')
        {
            c = c + 32;
        }
        拼接到(结果, c);
        i = i + 1;
    }
    返回 结果;
}

// ============================================================
// 小件:文字与整数、忽略大小写、去首尾、按分隔符取段
//   · 口径都写在每个函数头上,库函数的规矩照旧:**不停机、不报错、不写错误槽**
//   · 局部变量一律带函数专属前缀 —— 避让"与同名参数只差大小写"那个老坑
// ============================================================

// ---------- 文字 → 整数 ----------
// 口径:① 首尾空白先去掉;② 认一个 `+` / `-`;③ 接着吃连续数字;④ **一个数字都没有 ⇒ 0**;
//       ⑤ 超出 32 位不报错,夹到 `2147483647` / `-2147483648`;⑥ 数字后面还有别的东西**不管**
// 读十进制整数(首尾空白自动去、认 +/-;读不出给 0、越界夹住)
方法 字符串转整数(字符串 文本) 返回 整数
{
    字符串 字符串转整数净 = 去空白(文本);
    整数 字符串转整数长 = 字符串转整数净.长度();
    整数 字符串转整数i = 0;
    整数 字符串转整数号 = 1;
    如果 (字符串转整数i < 字符串转整数长 && (字符串转整数净[字符串转整数i] == '-' || 字符串转整数净[字符串转整数i] == '+'))
    {
        如果 (字符串转整数净[字符串转整数i] == '-')
        {
            字符串转整数号 = -1;
        }
        字符串转整数i = 字符串转整数i + 1;
    }
    整数 字符串转整数果 = 0;
    整数 字符串转整数有 = 0;
    当 (字符串转整数i < 字符串转整数长)
    {
        文字 字符串转整数字 = 字符串转整数净[字符串转整数i];
        如果 (字符串转整数字 < '0' || 字符串转整数字 > '9')
        {
            跳出;
        }
        整数 字符串转整数位 = 字符串转整数字 - '0';
        如果 (字符串转整数果 > 214748364 || (字符串转整数果 == 214748364 && 字符串转整数位 > 7))
        {
            如果 (字符串转整数号 < 0)
            {
                返回 -2147483648;
            }
            返回 2147483647;
        }
        字符串转整数果 = 字符串转整数果 * 10 + 字符串转整数位;
        字符串转整数有 = 1;
        字符串转整数i = 字符串转整数i + 1;
    }
    如果 (字符串转整数有 == 0)
    {
        返回 0;
    }
    返回 字符串转整数号 * 字符串转整数果;
}

// ---------- 忽略大小写比较 ----------
// 口径:只折 ASCII 的 `A~Z`(与 转大写/转小写 同一口径);汉字/其它字符按码点原样比
//   返回 -1(左小) / 0(相等) / 1(左大)
方法 忽略大小写折小(文字 某字) 返回 整数
{
    如果 (某字 >= 'A' && 某字 <= 'Z')
    {
        返回 某字 - 'A' + 'a';
    }
    返回 某字;
}

// -1 / 0 / 1(只折 ASCII 的 A~Z)
方法 比较忽略大小写(字符串 左, 字符串 右) 返回 整数
{
    整数 比较忽略大小写长左 = 左.长度();
    整数 比较忽略大小写长右 = 右.长度();
    整数 比较忽略大小写小 = 比较忽略大小写长左;
    如果 (比较忽略大小写长右 < 比较忽略大小写小)
    {
        比较忽略大小写小 = 比较忽略大小写长右;
    }
    整数 比较忽略大小写i = 0;
    当 (比较忽略大小写i < 比较忽略大小写小)
    {
        整数 比较忽略大小写码左 = 忽略大小写折小(左[比较忽略大小写i]);
        整数 比较忽略大小写码右 = 忽略大小写折小(右[比较忽略大小写i]);
        如果 (比较忽略大小写码左 < 比较忽略大小写码右)
        {
            返回 -1;
        }
        如果 (比较忽略大小写码左 > 比较忽略大小写码右)
        {
            返回 1;
        }
        比较忽略大小写i = 比较忽略大小写i + 1;
    }
    如果 (比较忽略大小写长左 < 比较忽略大小写长右)
    {
        返回 -1;
    }
    如果 (比较忽略大小写长左 > 比较忽略大小写长右)
    {
        返回 1;
    }
    返回 0;
}

// 忽略大小写比相等
方法 相等忽略大小写(字符串 左, 字符串 右) 返回 逻辑
{
    返回 比较忽略大小写(左, 右) == 0;
}

// ---------- 去首尾指定字符 ----------
// 口径:`集` 里出现的**任意一个文字**在首/尾连着出现就都去掉(和 `去空白` 一个手势,只是集合自己给);
//   中间的照旧保留;整串都是集合里的字 ⇒ 空串
方法 集里有字(字符串 集, 文字 某字) 返回 逻辑
{
    整数 集里有字长 = 集.长度();
    整数 集里有字i = 0;
    当 (集里有字i < 集里有字长)
    {
        如果 (集[集里有字i] == 某字)
        {
            返回 真;
        }
        集里有字i = 集里有字i + 1;
    }
    返回 假;
}

// 首尾连着出现、且在 `集` 里的文字都去掉
方法 去首尾(字符串 主串, 字符串 集) 返回 字符串
{
    整数 去首尾长 = 主串.长度();
    整数 去首尾起 = 0;
    当 (去首尾起 < 去首尾长 && 集里有字(集, 主串[去首尾起]))
    {
        去首尾起 = 去首尾起 + 1;
    }
    当 (去首尾长 > 去首尾起 && 集里有字(集, 主串[去首尾长 - 1]))
    {
        去首尾长 = 去首尾长 - 1;
    }
    字符串 去首尾果 = 取子串(主串, 去首尾起, 去首尾长 - 去首尾起);
    返回 去首尾果;
}

// ---------- 按分隔符取第 n 段 ----------
// 口径:**序号从 0 开始**(和下标一致);越界(含负数)给**空串**;分隔符为空串时:
// 按分隔符取第 `序号` 段(**从 0 开始**;越界给空串)
方法 取段(字符串 主串, 字符串 分隔, 整数 序号) 返回 字符串
{
    字符串 取段果;
    整数 取段长 = 主串.长度();
    整数 取段隔长 = 分隔.长度();
    如果 (取段隔长 == 0)
    {
        如果 (序号 == 0)
        {
            拼接到(取段果, 主串);
        }
        返回 取段果;
    }
    如果 (序号 < 0)
    {
        返回 取段果;
    }
    整数 取段号 = 0;
    整数 取段起 = 0;
    整数 取段i = 0;
    当 (取段i <= 取段长 - 取段隔长)
    {
        逻辑 取段中 = 真;
        整数 取段j = 0;
        当 (取段j < 取段隔长)
        {
            如果 (主串[取段i + 取段j] != 分隔[取段j])
            {
                取段中 = 假;
                跳出;
            }
            取段j = 取段j + 1;
        }
        如果 (取段中)
        {
            如果 (取段号 == 序号)
            {
                字符串 取段前 = 取子串(主串, 取段起, 取段i - 取段起);
                返回 取段前;
            }
            取段号 = 取段号 + 1;
            取段起 = 取段i + 取段隔长;
            取段i = 取段起;
        }
        否则
        {
            取段i = 取段i + 1;
        }
    }
    如果 (取段号 == 序号)
    {
        字符串 取段尾 = 取子串(主串, 取段起, 取段长 - 取段起);
        返回 取段尾;
    }
    返回 取段果;
}

// ============================================================
// 字符分类
//   · 口径:**只认 ASCII**(与 `转大写` / `转小写` / `比较忽略大小写` 同一口径)——
//     `是数字('5')` 真,而 `'五'`、全角 `'５'`、阿拉伯-印度数字**一律假**。
//     想要"Unicode 类别"(Unicode 里的 Nd / Lu 等)得另立一套口径,那是另一个决定,这里不做。
//   · 参数都是**一个文字**(`主串[下标]` 取出来的就是它):写解析器时"取一个字 → 归一归一类"最顺手。
//   · 规矩照旧:纯库函数,**不停机、不报错、不写错误槽**;空串上扫一遍自然一个都认不出来(0 个),不用特判。
// ============================================================

// 这个 `文字` 是不是 ASCII 数字
方法 是数字(文字 某字) 返回 逻辑
{
    如果 (某字 >= '0' && 某字 <= '9')
    {
        返回 真;
    }
    返回 假;
}

// 这个 `文字` 是不是 ASCII 字母
方法 是字母(文字 某字) 返回 逻辑
{
    如果 ((某字 >= 'A' && 某字 <= 'Z') || (某字 >= 'a' && 某字 <= 'z'))
    {
        返回 真;
    }
    返回 假;
}

// 这个 `文字` 是不是 ASCII 数字或字母
方法 是数字或字母(文字 某字) 返回 逻辑
{
    如果 (是数字(某字))
    {
        返回 真;
    }
    如果 (是字母(某字))
    {
        返回 真;
    }
    返回 假;
}

// 这个 `文字` 是不是十六进制位(0~9 a~f A~F)
方法 是十六进制位(文字 某字) 返回 逻辑
{
    如果 (是数字(某字))
    {
        返回 真;
    }
    如果 ((某字 >= 'A' && 某字 <= 'F') || (某字 >= 'a' && 某字 <= 'f'))
    {
        返回 真;
    }
    返回 假;
}

// ============================================================
// 文本处理
//   · 切分 / 连接 / 段集 一族:段用「原串 + 起/长」表示,库不设全局段池(理由见文件头)
//   · 反转 / 重复 / 左补位 / 右补位 / 安全解析整数:单串上的小工具
//   · 规矩照旧:纯库函数,**不停机、不报错、不写错误槽**;局部变量带函数专属前缀
// ============================================================

// ---------- 段表:切分 / 段数 / 段取 / 连接 ----------
// 段表 = **两条并排的整数数组**(起、长),地方由**调用方**给(定长数组):
//     · 不用"字符串列表":动态列表不能当参数传、不能当返回值,
//       元素是字符串的列表也不能进结构字段(见文件头);
//     · 不用"结构装两条列表":**字符串参数 + 结构参数**同处一个函数头时,
//       结构字段(列表)取下标在本编译器上编不过(实测:
//       报"`XX` 不是字符串" / "`XX.XX` 不是列表/数组")——
//       所以走**并排数组**,与 `排序.hb` / `界面.hb` 同一套手势(库文件头也记了这条)。
// 口径与 `取段` 一致:分隔符**不重叠**地找;空段照样记账(`"a,,b"` 按 `","` 是 3 段);
// `分隔` 为空串 ⇒ 整串算一段;空串切成 1 段(空的那一段)。

// 切分:把每段的「起 + 长」写进调用方那两条数组,**返回实际写下的段数**。
// 按分隔符切开,每段「起 + 长」写进**调用方的两条数组**;返回**实际写下的段数**(装不下只写能放的)
方法 切分(字符串 主串, 字符串 分隔, 整数 起表[], 整数 长表[]) 返回 整数
{
    整数 切分可 = 起表.长度();
    如果 (长表.长度() < 切分可)
    {
        切分可 = 长表.长度();
    }
    如果 (切分可 <= 0)
    {
        返回 0;
    }
    整数 切分主长 = 主串.长度();
    整数 切分隔长 = 分隔.长度();
    如果 (切分隔长 == 0)
    {
        起表[0] = 0;
        长表[0] = 切分主长;
        返回 1;
    }
    整数 切分记 = 0;
    整数 切分起 = 0;
    整数 切分i = 0;
    当 (切分i <= 切分主长 - 切分隔长)
    {
        逻辑 切分中 = 真;
        整数 切分j = 0;
        当 (切分j < 切分隔长)
        {
            如果 (主串[切分i + 切分j] != 分隔[切分j])
            {
                切分中 = 假;
                跳出;
            }
            切分j = 切分j + 1;
        }
        如果 (切分中)
        {
            如果 (切分记 < 切分可)
            {
                起表[切分记] = 切分起;
                长表[切分记] = 切分i - 切分起;
                切分记 = 切分记 + 1;
            }
            切分起 = 切分i + 切分隔长;
            切分i = 切分起;
        }
        否则
        {
            切分i = 切分i + 1;
        }
    }
    如果 (切分记 < 切分可)
    {
        起表[切分记] = 切分起;
        长表[切分记] = 切分主长 - 切分起;
        切分记 = 切分记 + 1;
    }
    返回 切分记;
}

// 光数段数(不建表);口径与 `切分` / `取段` 一致
方法 段数(字符串 主串, 字符串 分隔) 返回 整数
{
    整数 段数隔长 = 分隔.长度();
    如果 (段数隔长 == 0)
    {
        返回 1;
    }
    整数 段数主长 = 主串.长度();
    整数 段数个 = 1;
    整数 段数i = 0;
    当 (段数i <= 段数主长 - 段数隔长)
    {
        逻辑 段数中 = 真;
        整数 段数j = 0;
        当 (段数j < 段数隔长)
        {
            如果 (主串[段数i + 段数j] != 分隔[段数j])
            {
                段数中 = 假;
                跳出;
            }
            段数j = 段数j + 1;
        }
        如果 (段数中)
        {
            段数个 = 段数个 + 1;
            段数i = 段数i + 段数隔长;
        }
        否则
        {
            段数i = 段数i + 1;
        }
    }
    返回 段数个;
}

// 段取:把第 `序号` 段取出来(序号从 0 起);越界(含负数)给空串。
// 把第 `序号` 段取回来(从 0 起;越界给空串)
方法 段取(字符串 主串, 整数 起表[], 整数 长表[], 整数 序号) 返回 字符串
{
    字符串 段取果;
    整数 段取可 = 起表.长度();
    如果 (长表.长度() < 段取可)
    {
        段取可 = 长表.长度();
    }
    如果 (序号 >= 0 && 序号 < 段取可)
    {
        整数 段取起 = 起表[序号];
        整数 段取长 = 长表[序号];
        段取果 = 取子串(主串, 段取起, 段取长);
    }
    返回 段取果;
}

// 连接:把前 `个数` 段依次取出来,中间插 `分隔`,拼成一条(个数 <= 0 ⇒ 空串)
// 把前 `个数` 段用 `分隔` 按顺序拼成一条
方法 连接(字符串 主串, 整数 起表[], 整数 长表[], 整数 个数, 字符串 分隔) 返回 字符串
{
    字符串 连接果;
    整数 连接可 = 起表.长度();
    如果 (长表.长度() < 连接可)
    {
        连接可 = 长表.长度();
    }
    整数 连接数 = 个数;
    如果 (连接数 > 连接可)
    {
        连接数 = 连接可;
    }
    整数 连接i = 0;
    当 (连接i < 连接数)
    {
        如果 (连接i > 0)
        {
            拼接到(连接果, 分隔);
        }
        整数 连接起 = 起表[连接i];
        整数 连接长 = 长表[连接i];
        字符串 连接段 = 取子串(主串, 连接起, 连接长);
        拼接到(连接果, 连接段);
        连接i = 连接i + 1;
    }
    返回 连接果;
}

// 按**文字**倒过来(中文一个字算一个)
方法 反转(字符串 值) 返回 字符串
{
    字符串 反转果;
    整数 反转i = 值.长度();
    当 (反转i > 0)
    {
        反转i = 反转i - 1;
        拼接到(反转果, 值[反转i]);
    }
    返回 反转果;
}

// 连着放 `次` 遍(次 <= 0 给空串)
方法 重复(字符串 值, 整数 次) 返回 字符串
{
    字符串 重复果;
    整数 重复i = 0;
    当 (重复i < 次)
    {
        拼接到(重复果, 值);
        重复i = 重复i + 1;
    }
    返回 重复果;
}

// 左补位 / 右补位:不足 `宽度` 个文字就在左边 / 右边用 `补字` 补到宽度。
// 不足 `宽度` 个文字就用 `补字` 补到宽度;**超了不截断**
方法 左补位(字符串 值, 整数 宽度, 文字 补字) 返回 字符串
{
    字符串 左补位果;
    整数 左补位缺 = 宽度 - 值.长度();
    当 (左补位缺 > 0)
    {
        拼接到(左补位果, 补字);
        左补位缺 = 左补位缺 - 1;
    }
    拼接到(左补位果, 值);
    返回 左补位果;
}

// 同 `左补位`,补在右边
方法 右补位(字符串 值, 整数 宽度, 文字 补字) 返回 字符串
{
    字符串 右补位果;
    拼接到(右补位果, 值);
    整数 右补位缺 = 宽度 - 值.长度();
    当 (右补位缺 > 0)
    {
        拼接到(右补位果, 补字);
        右补位缺 = 右补位缺 - 1;
    }
    返回 右补位果;
}

// ---------- 安全解析整数 ----------
// 口径:去首尾空白之后**整串**必须正好是一个十进制整数(可带一个 `+` / `-`),而且落在 32 位里;
//   成功 ⇒ 真 + 把值写进 `值`;失败 ⇒ 假 + **一个字都不动 `值`**。
//   与 `字符串转整数` 的区别:那个是"能读多少读多少、越界夹住、读不出给 0",
//   这个是"要么整条合法、要么当没读" —— 校验命令行参数 / 配置文件就用这个。
//   边界:`2147483647` 真、`2147483648` 假、`-2147483648` 真、`-2147483649` 假;
// 整串必须正好是十进制整数且不越 32 位:成功 ⇒ 真 + 写 `值`;失败 ⇒ 假 + **不动 `值`**
方法 安全解析整数(字符串 文本, 引用 整数 值) 返回 逻辑
{
    字符串 安全解析整数净 = 去空白(文本);
    整数 安全解析整数长 = 安全解析整数净.长度();
    如果 (安全解析整数长 == 0)
    {
        返回 假;
    }
    整数 安全解析整数i = 0;
    整数 安全解析整数号 = 1;
    如果 (安全解析整数净[0] == '-' || 安全解析整数净[0] == '+')
    {
        如果 (安全解析整数净[0] == '-')
        {
            安全解析整数号 = -1;
        }
        安全解析整数i = 1;
    }
    如果 (安全解析整数i >= 安全解析整数长)
    {
        返回 假;
    }
    整数 安全解析整数果 = 0;
    当 (安全解析整数i < 安全解析整数长)
    {
        文字 安全解析整数字 = 安全解析整数净[安全解析整数i];
        如果 (安全解析整数字 < '0' || 安全解析整数字 > '9')
        {
            返回 假;
        }
        整数 安全解析整数位 = 安全解析整数字 - '0';
        如果 (安全解析整数果 > 214748364)
        {
            返回 假;
        }
        如果 (安全解析整数果 == 214748364)
        {
            如果 (安全解析整数号 > 0 && 安全解析整数位 > 7)
            {
                返回 假;
            }
            如果 (安全解析整数号 < 0 && 安全解析整数位 > 8)
            {
                返回 假;
            }
            // 下界那个数(-2147483648)没有正数那一半可借:单独把它接住,免得这里乘出去回绕
            如果 (安全解析整数号 < 0 && 安全解析整数位 == 8)
            {
                如果 (安全解析整数i + 1 != 安全解析整数长)
                {
                    返回 假;
                }
                值 = -2147483648;
                返回 真;
            }
        }
        安全解析整数果 = 安全解析整数果 * 10 + 安全解析整数位;
        安全解析整数i = 安全解析整数i + 1;
    }
    值 = 安全解析整数号 * 安全解析整数果;
    返回 真;
}
