// ============================================================
// 排序.hb —— 排序库(纯 HB,不动语言面)
//
// 用法:包含 "../库/排序.hb";调用写 `排序.整数升序(表)`。**就地排**(排完就是调用方那张表本身);**不报错、不停机**。
//
// 口径(2026-09):
//   · **算法是插入排序**:**稳定**(相等的保持原来先后),小表最快;代价是 O(n²) —— 上万条的乱序表别用它;
//   · **`按键排序` 把两张表配对重排**,排完 `键表[i]` 与 `值表[i]` 还是原来那一对;
//     两表长度不一样时只排"两边都有的那一段";
//   · **`部分升序` 走的是选择排序**,只保证前 k 个就位,**不做稳定承诺**;
//   · **字符串表排序编不过**(会当成"名字叫 表[] 的字符串参数");要按串排就用 `按键排序` 自己造键;
//   · **只收固定数组**(`整数 表[10]` 这种):动态列表传不了 —— 报"列表的地址不能取";
//   · **没有"比较函数"**:次序按固定口径 —— 整数按数值。
//
// 英文对照:整数升序 sortIntsAsc · 整数降序 sortIntsDesc · 按键排序 sortByKeys · 部分升序 partialSortAsc
//
// 复杂度:插入排序 最好 O(n)、最坏与平均 O(n²),只多用一个临时量;`按键排序` 同阶;`部分升序` O(n·k)。
// 提供的函数(4 个):逐个见下面那张公开方法表。
// 边界(如实登记):只收固定数组;插入排序 O(n²);`部分升序` 不做稳定承诺。
// ============================================================
模块 排序

// 整数表从小到大(**稳定**);就地排。
方法 整数升序(整数 表[])
{
    整数 个数 = 表.长度();
    整数 i = 1;
    当 (i < 个数)
    {
        整数 值 = 表[i];
        整数 j = i;
        当 (j > 0 && 表[j - 1] > 值)
        {
            表[j] = 表[j - 1];
            j = j - 1;
        }
        表[j] = 值;
        i = i + 1;
    }
    返回
}

// 整数表从大到小(**稳定**);就地排。
方法 整数降序(整数 表[])
{
    整数 个数 = 表.长度();
    整数 i = 1;
    当 (i < 个数)
    {
        整数 值 = 表[i];
        整数 j = i;
        当 (j > 0 && 表[j - 1] < 值)
        {
            表[j] = 表[j - 1];
            j = j - 1;
        }
        表[j] = 值;
        i = i + 1;
    }
    返回
}

// 按 `键表` 升序,两张表配对重排(相同键保持原来先后)。
方法 按键排序(整数 值表[], 整数 键表[])
{
    整数 个数 = 键表.长度();
    如果 (值表.长度() < 个数)
    {
        个数 = 值表.长度();      // 两表不一样长:只排"两边都有"的那一段,谁也不越界
    }
    整数 i = 1;
    当 (i < 个数)
    {
        整数 键 = 键表[i];
        整数 值 = 值表[i];
        整数 j = i;
        当 (j > 0 && 键表[j - 1] > 键)
        {
            键表[j] = 键表[j - 1];
            值表[j] = 值表[j - 1];
            j = j - 1;
        }
        键表[j] = 键;
        值表[j] = 值;
        i = i + 1;
    }
    返回
}

// 只要"最小的前 k 个"就位(其余次序不保证);`前几个` 比表长还大就整表排完。
方法 部分升序(整数 表[], 整数 前几个)
{
    整数 个数 = 表.长度();
    如果 (前几个 > 个数)
    {
        前几个 = 个数;          // 要的比有的多:整表排完
    }
    整数 i = 0;
    当 (i < 前几个)
    {
        整数 最小位 = i;
        整数 j = i + 1;
        当 (j < 个数)
        {
            如果 (表[j] < 表[最小位])
            {
                最小位 = j;
            }
            j = j + 1;
        }
        如果 (最小位 != i)
        {
            整数 暂 = 表[i];
            表[i] = 表[最小位];
            表[最小位] = 暂;
        }
        i = i + 1;
    }
    返回
}
