// ============================================================
// JSON.hb —— JSON 值的解析与生成(整份那一层;零依赖)
//
// 用法:
// ```
// 包含 "../库/JSON.hb"
// 整数 根 = JSON.解析("{\"名字\":\"张三\",\"年龄\":28,\"在职\":true,\"爱好\":[\"读书\",\"爬山\"]}");
// 如果 (根 == 0) { 输出行("不成立"); }                // 哪里不成立看 `错处位置`
// 字符串 谁 = "";
// 输出行(JSON.取文本(根, "名字", 谁));        // 1(取到了);`谁` = 张三
// 输出行(JSON.取整数(根, "年龄", 0));         // 28
// 输出行(JSON.取文本(根, "爱好[1]", 谁));     // 1;`谁` = 爬山
// 输出行(JSON.个数(根, "爱好"));              // 2
// 字符串 出 = "";
// JSON.生成到(根, 出);                        // `出` 与解析进来那段**逐字节相同**
//
// JSON.清空(); 整数 新根 = JSON.新建对象();  JSON.放文本(新根, "名字", "李四");
// 整数 爱好 = JSON.新建数组();  JSON.放(新根, "爱好", 爱好);  JSON.加文本(爱好, "下棋");
// 字符串 文 = JSON.生成(新根);                 // {"名字":"李四","爱好":["下棋"]}
// ```
// 一行一条那种大文件走 `NDJSON流.hb`(它建在这一库与 `流.hb` 上,一条一条吃)。
//
// 口径(2026-10;每条都对着实测写):
//   · **节点只记原文的位置**:节点存它在**字节区**里的 `起` / `长`,不另存串 ⇒ 解析几乎不占字符串池;
//     生成把原字节照抄回去(`解析` → `生成` 逐字节相同,连空格与换行都原样);
//   · **数字存原样文本**:`1.0` / `1e9` / `-0` 进出一个样(所以这一库**零依赖**);要整数用 `取整数`
//     (小数 / 指数 / 越 32 位给默认值),要原样用 `取数文`;
//   · **结果写进你自己的那一格**:`取文本 / 取数文 / 取键 / 生成到` 的返回值只说"取到没有",那一格就地复用;
//     `生成` 是"给我一个串"的省事档,每次返回**新串**(长循环请用 `生成到`);
//   · **路径**:`记录.账号[0].姓名` —— `.` 走对象成员、`[n]` 走数组下标(从 0 起);空路径 = 节点自己;
//     走不到给 0(不报错、不停机);键名里带 `.` 或 `[` 的用 `取成员` / `取键` 那一对;
//   · **一份文档**:库里只留"当前这一份",换文档前 `清空()`;节点号只在这一份里有效(清空后作废);
//   · **两类节点**:`解析` 出来的生成时照抄原文;`新建对象 / 新建数组` 那一套没有原文,按结构拼。
//
// 提供的函数(30 个):解析 / 清空 / 节点 / 取成员 / 子项 / 个数 / 种类 / 取整数 / 取文本 /
//   新建对象 / 放* / 加* / 生成 / 生成到 ……—— 逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:解析 O(文档字节数);`节点` O(路径长 × 成员数);单步取 / `个数` / `种类` O(1);
//   `生成到` O(文档字节数);`取文本` O(这个串的字节数)。
//
// 内存账:节点池 512 格 × 8 张定长表 = **16KB**、字节区 **16KB**,一共约 **32KB 静态数据** ——
//   装得下"几百个字段 / 十几 KB 文本"。要更大就改本文件头部那两行数组长度(`JSON种类[512]` 那八行 /
//   `JSON字节区[16384]`),两边一起放大;再大请走 `NDJSON流.hb`。
//
// 边界(如实登记):
//   · **解析出来的是只读的**:不做"改一个字段再生成";要改就 `新建对象` / `新建数组` 重新搭一棵;
//   · **不做放宽写法**(注释 / 尾逗号 / 单引号 / 反引号):认的是标准 JSON(尾逗号、`{'a':1}` 一律不成立);
//   · **嵌套深度**吃软栈:套得太深由语言自己报「递归太深」;节点数超 512、字节超 16KB 一律"解析不成立"
//     (`错处位置` 给到出界那一点);
//   · **`\uXXXX` 代理对不合并**:解出来是两个码点(EMOJI 那一档会散开);
//   · **重复键**:两个同名成员都留着,`取成员` / 路径取到**最前面**那一个;
//   · **不做排序 / 折叠 / 格式化输出**:要缩进版自己按结构拼。
// ============================================================
模块 JSON

// ---------- 模块状态:一份"当前文档" ----------
// 节点只记原文位置;八张表按同一个节点号排(名字带 `JSON` 前缀,免得与调用方的顶层变量共用一格)
私有 整数 JSON种类[512];
私有 整数 JSON文起[512];
私有 整数 JSON文长[512];
私有 整数 JSON键起[512];
私有 整数 JSON键长[512];
私有 整数 JSON子项头[512];
私有 整数 JSON子项尾[512];
私有 整数 JSON同级下个[512];
私有 整数 JSON子项数[512];
私有 字符 JSON字节区[16384];
私有 整数 JSON节点用量 = 0;
私有 整数 JSON字节用量 = 0;
私有 整数 JSON读位 = 0;
私有 整数 JSON错处 = 0;

// ============================================================
// 1、字节区:加 / 取 / 比(全部按**字节**走,不碰字符串池)
// ============================================================

// 一个串一共占几个字节(`.长度()` 给的是文字数;取码点要用 `文字`)
私有 方法 JSON字节长(字符串 文本) 返回 整数
{
    整数 合计 = 0;
    整数 i = 0;
    整数 文字数 = 文本.长度();
    当 (i < 文字数)
     {
        文字 本字 = 文本[i];
        整数 码 = 本字;
        如果 (码 < 128)
         {
            合计 = 合计 + 1;
        }
        否则 如果 (码 < 2048)
        {
            合计 = 合计 + 2;
        }
        否则 如果 (码 < 65536)
        {
            合计 = 合计 + 3;
        }
        否则
        {
            合计 = 合计 + 4;
        }
        i = i + 1;
    }
    返回 合计;
}

// 往字节区尾巴上接一个字节;放不下给假
私有 方法 JSON区加字节(字符 值) 返回 逻辑
{
    如果 (JSON字节用量 + 1 >= 16384)
     {
        返回 假;
    }
    JSON字节区[JSON字节用量] = 值;
    JSON字节用量 = JSON字节用量 + 1;
    JSON字节区[JSON字节用量] = 0;
    返回 真;
}

// 往字节区尾巴上接一个串;放不下给 -1,否则给起点
私有 方法 JSON区加串(字符串 文本) 返回 整数
{
    整数 长 = JSON字节长(文本);
    如果 (JSON字节用量 + 长 + 1 >= 16384)
     {
        返回 0 - 1;
    }
    整数 起 = JSON字节用量;
    JSON字节区[起] = 0;
    拼接到(JSON字节区, 文本);
    JSON字节用量 = 起 + 长;
    JSON字节区[JSON字节用量] = 0;
    返回 起;
}

// 按 UTF-8 把一个码点接进字节区
私有 方法 JSON区加码点(文字 字)
{
    整数 码 = 字;
    如果 (码 < 128)
     {
        逻辑 丢 = JSON区加字节(字);
        返回
    }
    如果 (码 < 2048)
     {
        逻辑 丢一 = JSON区加字节(128 + 码 / 64);
        逻辑 丢二 = JSON区加字节(128 + 码 % 64);
        返回
    }
    如果 (码 < 65536)
     {
        逻辑 丢一 = JSON区加字节(224 + 码 / 4096);
        逻辑 丢二 = JSON区加字节(128 + 码 / 64 % 64);
        逻辑 丢三 = JSON区加字节(128 + 码 % 64);
        返回
    }
    逻辑 丢一 = JSON区加字节(240 + 码 / 262144);
    逻辑 丢二 = JSON区加字节(128 + 码 / 4096 % 64);
    逻辑 丢三 = JSON区加字节(128 + 码 / 64 % 64);
    逻辑 丢四 = JSON区加字节(128 + 码 % 64);
    返回
}

// 接一个整数的十进制写法(带负号)
私有 方法 JSON区加整数(整数 值)
{
    如果 (值 == 0)
     {
        逻辑 丢 = JSON区加字节('0');
        返回
    }
    如果 (值 < 0)
    {
        逻辑 丢 = JSON区加字节('-');
    }
    整数 剩 = 值;
    如果 (剩 < 0)
    {
        剩 = 0 - 剩;
    }
    字符 数位[12];
    整数 几个 = 0;
    当 (剩 > 0)
     {
        数位[几个] = '0' + 剩 % 10;
        几个 = 几个 + 1;
        剩 = 剩 / 10;
    }
    当 (几个 > 0)
     {
        几个 = 几个 - 1;
        逻辑 丢 = JSON区加字节(数位[几个]);
    }
    返回
}

// 把字节区里 [起, 起 + 长) 这一段**照抄**到尾巴上
私有 方法 JSON区搬(整数 起, 整数 长)
{
    整数 i = 0;
    当 (i < 长)
     {
        如果 (JSON区加字节(JSON字节区[起 + i]) == 假)
        {
            返回
        }
        i = i + 1;
    }
    返回
}

// 把字节区里 [起, 起 + 长) 这一段搬进"出"参数字符串
私有 方法 JSON区写进槽(整数 起, 整数 长, 字符串 出 文)
{
    文 = "";
    整数 i = 0;
    当 (i < 长)
     {
        拼接到(文, JSON字节区[起 + i]);
        i = i + 1;
    }
    返回
}

// 两段字节一样吗
私有 方法 JSON段相等(整数 起一, 整数 长一, 整数 起二, 整数 长二) 返回 逻辑
{
    如果 (长一 != 长二)
     {
        返回 假;
    }
    整数 i = 0;
    当 (i < 长一)
     {
        如果 (JSON字节区[起一 + i] != JSON字节区[起二 + i])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 这一段里有反斜杠吗(有就得走解转义那条慢路)
私有 方法 JSON段有反斜杠(整数 起, 整数 长) 返回 逻辑
{
    整数 i = 0;
    当 (i < 长)
     {
        如果 (JSON字节区[起 + i] == '\\')
        {
            返回 真;
        }
        i = i + 1;
    }
    返回 假;
}

// 读 4 个十六进制位(给一个码点;认不出给 -1)
私有 方法 JSON读十六(整数 起, 整数 止) 返回 整数
{
    如果 (起 + 4 > 止)
     {
        返回 0 - 1;
    }
    整数 结果 = 0;
    整数 i = 0;
    当 (i < 4)
     {
        字符 c = JSON字节区[起 + i];
        整数 位 = 0 - 1;
        如果 (c >= '0' && c <= '9')
        {
            位 = c - '0';
        }
        否则 如果 (c >= 'a' && c <= 'f')
        {
            位 = c - 'a' + 10;
        }
        否则 如果 (c >= 'A' && c <= 'F')
        {
            位 = c - 'A' + 10;
        }
        如果 (位 < 0)
        {
            返回 0 - 1;
        }
        结果 = 结果 * 16 + 位;
        i = i + 1;
    }
    返回 结果;
}

// 把 [起, 止) 里的转义解出来,写进"出"参数那一格(串里的引号由调用方去过)
私有 方法 JSON解转义进槽(整数 起, 整数 止, 字符串 出 文)
{
    文 = "";
    整数 i = 起;
    当 (i < 止)
     {
        字符 c = JSON字节区[i];
        如果 (c != '\\' || i + 1 >= 止)
        {
            拼接到(文, c);
            i = i + 1;
            继续;
        }
        字符 e = JSON字节区[i + 1];
        如果 (e == 'n')
        {
            拼接到(文, "\n");
            i = i + 2;
            继续;
        }
        如果 (e == 'r')
        {
            拼接到(文, "\r");
            i = i + 2;
            继续;
        }
        如果 (e == 't')
        {
            拼接到(文, "\t");
            i = i + 2;
            继续;
        }
        如果 (e == 'b')
        {
            拼接到(文, "\b");
            i = i + 2;
            继续;
        }
        如果 (e == 'f')
        {
            拼接到(文, "\f");
            i = i + 2;
            继续;
        }
        如果 (e == 'u')
        {
            整数 码 = JSON读十六(i + 2, 止);
            如果 (码 < 0)
            {
                拼接到(文, c);
                i = i + 1;
                继续;
            }
            文字 字 = 码;
            拼接到(文, 字);
            i = i + 6;
            继续;
        }
        拼接到(文, e);
        i = i + 2;
    }
    返回
}

// 把 [起, 起 + 长) 里的转义解出来接进字节区(给"键比较"那条慢路用)
私有 方法 JSON区解转义(整数 起, 整数 长) 返回 逻辑
{
    整数 i = 起;
    整数 止 = 起 + 长;
    当 (i < 止)
     {
        字符 c = JSON字节区[i];
        如果 (c != '\\' || i + 1 >= 止)
        {
            如果 (JSON区加字节(c) == 假)
            {
                返回 假;
            }
            i = i + 1;
            继续;
        }
        字符 e = JSON字节区[i + 1];
        如果 (e == 'n')
        {
            逻辑 丢 = JSON区加字节('\n');
            i = i + 2;
            继续;
        }
        如果 (e == 'r')
        {
            逻辑 丢 = JSON区加字节('\r');
            i = i + 2;
            继续;
        }
        如果 (e == 't')
        {
            逻辑 丢 = JSON区加字节('\t');
            i = i + 2;
            继续;
        }
        如果 (e == 'u')
        {
            整数 码 = JSON读十六(i + 2, 止);
            如果 (码 < 0)
            {
                逻辑 丢 = JSON区加字节(c);
                i = i + 1;
                继续;
            }
            文字 字 = 码;
            JSON区加码点(字);
            i = i + 6;
            继续;
        }
        如果 (JSON区加字节(e) == 假)
        {
            返回 假;
        }
        i = i + 2;
    }
    返回 真;
}

// 把 [起, 起 + 长) 当十进制整数读出来;认不出(夹着非数字 / 越 32 位)给默认
私有 方法 JSON段转整数(整数 起, 整数 长, 整数 默认值) 返回 整数
{
    如果 (长 <= 0)
     {
        返回 默认值;
    }
    整数 i = 0;
    整数 号 = 1;
    如果 (JSON字节区[起] == '-')
    {
        号 = 0 - 1;
        i = 1;
    }
    否则 如果 (JSON字节区[起] == '+')
    {
        i = 1;
    }
    如果 (i >= 长)
    {
        返回 默认值;
    }
    整数 结果 = 0;
    当 (i < 长)
     {
        字符 c = JSON字节区[起 + i];
        如果 (c < '0' || c > '9')
        {
            返回 默认值;
        }
        整数 位 = c - '0';
        如果 (结果 > 214748364)
        {
            返回 默认值;
        }
        如果 (结果 == 214748364)
        {
            如果 (号 > 0 && 位 > 7)
            {
                返回 默认值;
            }
            如果 (号 < 0 && 位 > 8)
            {
                返回 默认值;
            }
            如果 (号 < 0 && 位 == 8 && i + 1 != 长)
            {
                返回 默认值;
            }
        }
        结果 = 结果 * 10 + 位;
        i = i + 1;
    }
    返回 号 * 结果;
}

// ============================================================
// 2、节点池
// ============================================================

// 要一个新节点(种类号见头注释);池满给 0
私有 方法 JSON造节点(整数 种) 返回 整数
{
    如果 (JSON节点用量 + 1 >= 512)
    {
        返回 0;
    }
    JSON节点用量 = JSON节点用量 + 1;
    整数 号 = JSON节点用量;
    JSON种类[号] = 种;
    JSON文起[号] = 0;
    JSON文长[号] = 0;
    JSON键起[号] = 0 - 1;
    JSON键长[号] = 0;
    JSON子项头[号] = 0;
    JSON子项尾[号] = 0;
    JSON同级下个[号] = 0;
    JSON子项数[号] = 0;
    返回 号;
}

// 把 `子` 接成 `父` 的最后一个子项(O(1):靠 `子项尾`)
私有 方法 JSON接子项(整数 父, 整数 子)
{
    如果 (JSON子项头[父] == 0)
    {
        JSON子项头[父] = 子;
    }
    否则
    {
        整数 尾号 = JSON子项尾[父];
        JSON同级下个[尾号] = 子;
    }
    JSON子项尾[父] = 子;
    JSON子项数[父] = JSON子项数[父] + 1;
    返回
}

// 第 `第几` 个子项(从 0 起;没有给 0)
私有 方法 JSON第几个子项(整数 号, 整数 第几) 返回 整数
{
    整数 走 = JSON子项头[号];
    整数 i = 0;
    当 (i < 第几 && 走 != 0)
     {
        走 = JSON同级下个[走];
        i = i + 1;
    }
    返回 走;
}

// ============================================================
// 3、解析(逐字节走 `字符` 区;字符串不落地,只记起 / 长)
// ============================================================

// 跳过空白(空格 / 制表 / 换行 / 回车)
私有 方法 JSON跳空白()
{
    当 (JSON读位 < JSON字节用量)
     {
        字符 c = JSON字节区[JSON读位];
        如果 (c == ' ' || c == '\t' || c == '\n' || c == '\r')
        {
            JSON读位 = JSON读位 + 1;
            继续;
        }
        返回
    }
    返回
}

// 扫一个串(从当前那个 `"` 起,到配对的 `"` 止);起 / 长写进"出"参数
私有 方法 JSON扫串(引用 整数 起, 引用 整数 长) 返回 逻辑
{
    整数 头 = JSON读位;
    JSON读位 = 头 + 1;
    逻辑 收尾 = 假;
    当 (JSON读位 < JSON字节用量)
     {
        字符 c = JSON字节区[JSON读位];
        如果 (c == '\\')
        {
            JSON读位 = JSON读位 + 2;
            继续;
        }
        如果 (c == '"')
        {
            JSON读位 = JSON读位 + 1;
            收尾 = 真;
            跳出;
        }
        JSON读位 = JSON读位 + 1;
    }
    如果 (收尾 == 假)
    {
        JSON错处 = 头;
        返回 假;
    }
    起 = 头;
    长 = JSON读位 - 头;
    返回 真;
}

// 扫一个数(`-` `+` `.` `e` `E` 与数字都吃进来;写法是否合法由"取"那一侧判)
私有 方法 JSON扫数(引用 整数 起, 引用 整数 长) 返回 逻辑
{
    整数 头 = JSON读位;
    当 (JSON读位 < JSON字节用量)
     {
        字符 c = JSON字节区[JSON读位];
        如果 ((c >= '0' && c <= '9') || c == '-' || c == '+' || c == '.' || c == 'e' || c == 'E')
        {
            JSON读位 = JSON读位 + 1;
            继续;
        }
        跳出;
    }
    如果 (JSON读位 == 头)
    {
        JSON错处 = 头;
        返回 假;
    }
    起 = 头;
    长 = JSON读位 - 头;
    返回 真;
}

// 扫一个字面(`true` / `false` / `null`)
私有 方法 JSON扫字面(字符 一, 字符 二, 字符 三, 字符 四) 返回 逻辑
{
    整数 头 = JSON读位;
    如果 (JSON字节用量 - 头 < 4)
    {
        JSON错处 = 头;
        返回 假;
    }
    如果 (JSON字节区[头] != 一 || JSON字节区[头 + 1] != 二 || JSON字节区[头 + 2] != 三 || JSON字节区[头 + 3] != 四)
    {
        JSON错处 = 头;
        返回 假;
    }
    JSON读位 = 头 + 4;
    返回 真;
}

// 解析一个值(对象 / 数组 / 串 / 数 / 真 / 假 / 空);不成立给 0
私有 方法 JSON解析值() 返回 整数
{
    JSON跳空白();
    如果 (JSON读位 >= JSON字节用量)
    {
        JSON错处 = JSON读位;
        返回 0;
    }
    字符 c = JSON字节区[JSON读位];
    如果 (c == '{')
    {
        返回 JSON解析对象();
    }
    如果 (c == '[')
    {
        返回 JSON解析数组();
    }
    如果 (c == '"')
    {
        整数 起 = 0;
        整数 长 = 0;
        如果 (JSON扫串(起, 长) == 假)
        {
            返回 0;
        }
        整数 号 = JSON造节点(4);
        如果 (号 == 0)
        {
            JSON错处 = 起;
            返回 0;
        }
        JSON文起[号] = 起;
        JSON文长[号] = 长;
        返回 号;
    }
    如果 (c == 't')
    {
        如果 (JSON扫字面('t', 'r', 'u', 'e') == 假)
        {
            返回 0;
        }
        整数 号 = JSON造节点(1);
        如果 (号 == 0)
        {
            返回 0;
        }
        JSON文起[号] = JSON读位 - 4;
        JSON文长[号] = 4;
        返回 号;
    }
    如果 (c == 'f')
    {
        如果 (JSON扫字面('f', 'a', 'l', 's') == 假)
        {
            返回 0;
        }
        如果 (JSON读位 >= JSON字节用量 || JSON字节区[JSON读位] != 'e')
        {
            JSON错处 = JSON读位;
            返回 0;
        }
        JSON读位 = JSON读位 + 1;
        整数 号 = JSON造节点(2);
        如果 (号 == 0)
        {
            返回 0;
        }
        JSON文起[号] = JSON读位 - 5;
        JSON文长[号] = 5;
        返回 号;
    }
    如果 (c == 'n')
    {
        如果 (JSON扫字面('n', 'u', 'l', 'l') == 假)
        {
            返回 0;
        }
        整数 号 = JSON造节点(0);
        如果 (号 == 0)
        {
            返回 0;
        }
        JSON文起[号] = JSON读位 - 4;
        JSON文长[号] = 4;
        返回 号;
    }
    如果 (c == '-' || (c >= '0' && c <= '9'))
    {
        整数 起 = 0;
        整数 长 = 0;
        如果 (JSON扫数(起, 长) == 假)
        {
            返回 0;
        }
        整数 号 = JSON造节点(3);
        如果 (号 == 0)
        {
            JSON错处 = 起;
            返回 0;
        }
        JSON文起[号] = 起;
        JSON文长[号] = 长;
        返回 号;
    }
    JSON错处 = JSON读位;
    返回 0;
}

// 解析一个数组
私有 方法 JSON解析数组() 返回 整数
{
    整数 开 = JSON读位;
    JSON读位 = 开 + 1;
    整数 号 = JSON造节点(5);
    如果 (号 == 0)
    {
        JSON错处 = 开;
        返回 0;
    }
    JSON跳空白();
    如果 (JSON读位 < JSON字节用量 && JSON字节区[JSON读位] == ']')
    {
        JSON读位 = JSON读位 + 1;
        JSON文起[号] = 开;
        JSON文长[号] = JSON读位 - 开;
        返回 号;
    }
    当 (真)
     {
        整数 子 = JSON解析值();
        如果 (子 == 0)
        {
            返回 0;
        }
        JSON接子项(号, 子);
        JSON跳空白();
        如果 (JSON读位 >= JSON字节用量)
        {
            JSON错处 = JSON读位;
            返回 0;
        }
        字符 c = JSON字节区[JSON读位];
        如果 (c == ',')
        {
            JSON读位 = JSON读位 + 1;
            继续;
        }
        如果 (c == ']')
        {
            JSON读位 = JSON读位 + 1;
            JSON文起[号] = 开;
            JSON文长[号] = JSON读位 - 开;
            返回 号;
        }
        JSON错处 = JSON读位;
        返回 0;
    }
    返回 0;
}

// 解析一个对象(成员节点 = 值节点本身,键挂在它上面)
私有 方法 JSON解析对象() 返回 整数
{
    整数 开 = JSON读位;
    JSON读位 = 开 + 1;
    整数 号 = JSON造节点(6);
    如果 (号 == 0)
    {
        JSON错处 = 开;
        返回 0;
    }
    JSON跳空白();
    如果 (JSON读位 < JSON字节用量 && JSON字节区[JSON读位] == '}')
    {
        JSON读位 = JSON读位 + 1;
        JSON文起[号] = 开;
        JSON文长[号] = JSON读位 - 开;
        返回 号;
    }
    当 (真)
     {
        JSON跳空白();
        如果 (JSON读位 >= JSON字节用量 || JSON字节区[JSON读位] != '"')
        {
            JSON错处 = JSON读位;
            返回 0;
        }
        整数 键起 = 0;
        整数 键长 = 0;
        如果 (JSON扫串(键起, 键长) == 假)
        {
            返回 0;
        }
        JSON跳空白();
        如果 (JSON读位 >= JSON字节用量 || JSON字节区[JSON读位] != ':')
        {
            JSON错处 = JSON读位;
            返回 0;
        }
        JSON读位 = JSON读位 + 1;
        整数 值号 = JSON解析值();
        如果 (值号 == 0)
        {
            返回 0;
        }
        JSON键起[值号] = 键起;
        JSON键长[值号] = 键长;
        JSON接子项(号, 值号);
        JSON跳空白();
        如果 (JSON读位 >= JSON字节用量)
        {
            JSON错处 = JSON读位;
            返回 0;
        }
        字符 c = JSON字节区[JSON读位];
        如果 (c == ',')
        {
            JSON读位 = JSON读位 + 1;
            继续;
        }
        如果 (c == '}')
        {
            JSON读位 = JSON读位 + 1;
            JSON文起[号] = 开;
            JSON文长[号] = JSON读位 - 开;
            返回 号;
        }
        JSON错处 = JSON读位;
        返回 0;
    }
    返回 0;
}

// ============================================================
// 4、找成员 / 走路径
// ============================================================

// 这个成员的键与字节区里 [段起, 段起 + 段长) 这一段一样吗(键里的转义走慢路解出来再比)
私有 方法 JSON键相等(整数 成员, 整数 段起, 整数 段长) 返回 逻辑
{
    如果 (JSON键长[成员] < 2)
    {
        返回 假;
    }
    整数 起 = JSON键起[成员] + 1;
    整数 长 = JSON键长[成员] - 2;
    如果 (JSON段有反斜杠(起, 长) == 假)
    {
        返回 JSON段相等(起, 长, 段起, 段长);
    }
    整数 暂起 = JSON字节用量;
    如果 (JSON区解转义(起, 长) == 假)
    {
        JSON字节区[暂起] = 0;
        JSON字节用量 = 暂起;
        返回 假;
    }
    整数 暂长 = JSON字节用量 - 暂起;
    逻辑 同 = JSON段相等(暂起, 暂长, 段起, 段长);
    JSON字节区[暂起] = 0;
    JSON字节用量 = 暂起;
    返回 同;
}

// 在对象 `节点` 的子项里按名字找(名字是字节区里 [段起, 段长);找不到给 0)
私有 方法 JSON找成员(整数 节点, 整数 段起, 整数 段长) 返回 整数
{
    如果 (JSON种类[节点] != 6)
    {
        返回 0;
    }
    整数 走 = JSON子项头[节点];
    当 (走 != 0)
     {
        如果 (JSON键相等(走, 段起, 段长) == 真)
        {
            返回 走;
        }
        走 = JSON同级下个[走];
    }
    返回 0;
}

// ============================================================
// 5、生成(解析来的节点照抄原文;现建的容器按结构拼)
// ============================================================

// 把一个节点生成进字节区尾巴
私有 方法 JSON生成(整数 号)
{
    如果 (JSON文长[号] > 0)
    {
        JSON区搬(JSON文起[号], JSON文长[号]);
        返回
    }
    如果 (JSON种类[号] == 5)
    {
        逻辑 丢一 = JSON区加字节('[');
        整数 走 = JSON子项头[号];
        整数 第 = 0;
        当 (走 != 0)
         {
            如果 (第 > 0)
            {
                逻辑 丢二 = JSON区加字节(',');
            }
            JSON生成(走);
            第 = 第 + 1;
            走 = JSON同级下个[走];
        }
        逻辑 丢三 = JSON区加字节(']');
        返回
    }
    如果 (JSON种类[号] == 6)
    {
        逻辑 丢一 = JSON区加字节('{');
        整数 走 = JSON子项头[号];
        整数 第 = 0;
        当 (走 != 0)
         {
            如果 (第 > 0)
            {
                逻辑 丢二 = JSON区加字节(',');
            }
            JSON区搬(JSON键起[走], JSON键长[走]);
            逻辑 丢三 = JSON区加字节(':');
            JSON生成(走);
            第 = 第 + 1;
            走 = JSON同级下个[走];
        }
        逻辑 丢四 = JSON区加字节('}');
        返回
    }
    返回
}

// 把一个串按 JSON 规矩转义着接进字节区(带两头的引号);给出起点
私有 方法 JSON加引号串(字符串 文本) 返回 整数
{
    整数 出起 = JSON字节用量;
    逻辑 丢零 = JSON区加字节('"');
    整数 i = 0;
    整数 文字数 = 文本.长度();
    当 (i < 文字数)
     {
        文字 字 = 文本[i];
        整数 码 = 字;
        如果 (码 == 34)
        {
            逻辑 丢一 = JSON区加字节('\\');
            逻辑 丢二 = JSON区加字节('"');
        }
        否则 如果 (码 == 92)
        {
            逻辑 丢一 = JSON区加字节('\\');
            逻辑 丢二 = JSON区加字节('\\');
        }
        否则 如果 (码 == 10)
        {
            逻辑 丢一 = JSON区加字节('\\');
            逻辑 丢二 = JSON区加字节('n');
        }
        否则 如果 (码 == 13)
        {
            逻辑 丢一 = JSON区加字节('\\');
            逻辑 丢二 = JSON区加字节('r');
        }
        否则 如果 (码 == 9)
        {
            逻辑 丢一 = JSON区加字节('\\');
            逻辑 丢二 = JSON区加字节('t');
        }
        否则 如果 (码 < 32)
        {
            逻辑 丢一 = JSON区加字节('\\');
            逻辑 丢二 = JSON区加字节('u');
            逻辑 丢三 = JSON区加字节('0');
            逻辑 丢四 = JSON区加字节('0');
            逻辑 丢五 = JSON区加字节('0' + 码 / 16);
            逻辑 丢六 = JSON区加字节('0' + 码 % 16);
        }
        否则
        {
            JSON区加码点(字);
        }
        i = i + 1;
    }
    逻辑 丢尾 = JSON区加字节('"');
    返回 出起;
}

// 建一个标量节点并接上去(名不是空串就先把键写进字节区)
私有 方法 JSON放新节点(整数 父, 字符串 名, 整数 种, 整数 起, 整数 长) 返回 整数
{
    整数 子 = JSON造节点(种);
    如果 (子 == 0)
    {
        返回 0;
    }
    JSON文起[子] = 起;
    JSON文长[子] = 长;
    如果 (名.长度() > 0)
    {
        整数 键起 = JSON加引号串(名);
        JSON键起[子] = 键起;
        JSON键长[子] = JSON字节用量 - 键起;
    }
    如果 (父 != 0)
    {
        JSON接子项(父, 子);
    }
    返回 子;
}

// ============================================================
// 6、对外的:解析与查询
// ============================================================

// 解析一份 JSON:给根节点号(0 = 不成立,错在第几个字节看 `错处位置`)。
方法 解析(字符串 文本) 返回 整数
{
    JSON清空();
    如果 (JSON区加串(文本) < 0)
    {
        JSON错处 = 0;
        返回 0;
    }
    整数 根 = JSON解析值();
    如果 (根 == 0)
    {
        返回 0;
    }
    JSON跳空白();
    如果 (JSON读位 != JSON字节用量)
    {
        JSON错处 = JSON读位;
        返回 0;
    }
    返回 根;
}

// 把"当前这一份"清掉(换文档之前调;节点号与字节区一起复位)
方法 清空()
{
    JSON清空();
    返回
}

// 私有:上面那个的实体(公开的 `清空` 转调它,免得两处各写一遍)
私有 方法 JSON清空()
{
    JSON节点用量 = 0;
    JSON字节用量 = 0;
    JSON字节区[0] = 0;
    JSON读位 = 0;
    JSON错处 = 0;
    返回
}

// 上一次 `解析` 停在第几个字节(解析成功给 0)
方法 错处位置() 返回 整数
{
    返回 JSON错处;
}

// 按路径走一格(`记录.账号[0].姓名`;空路径 = 自己;走不到给 0)
方法 节点(整数 节点, 字符串 路径) 返回 整数
{
    如果 (节点 == 0 || 节点 > JSON节点用量)
    {
        返回 0;
    }
    如果 (路径.长度() == 0)
    {
        返回 节点;
    }
    整数 路起 = JSON区加串(路径);
    如果 (路起 < 0)
    {
        返回 0;
    }
    整数 路止 = JSON字节用量;
    整数 当号 = 节点;
    整数 i = 路起;
    当 (i < 路止)
     {
        如果 (JSON字节区[i] == '[')
        {
            整数 j = i + 1;
            整数 号 = 0;
            整数 有数 = 0;
            当 (j < 路止 && JSON字节区[j] >= '0' && JSON字节区[j] <= '9')
             {
                号 = 号 * 10 + (JSON字节区[j] - '0');
                有数 = 1;
                j = j + 1;
            }
            如果 (j >= 路止 || JSON字节区[j] != ']' || 有数 == 0)
            {
                当号 = 0;
                跳出;
            }
            当号 = JSON第几个子项(当号, 号);
            i = j + 1;
        }
        否则
        {
            整数 j = i;
            当 (j < 路止 && JSON字节区[j] != '.' && JSON字节区[j] != '[')
            {
                j = j + 1;
            }
            当号 = JSON找成员(当号, i, j - i);
            i = j;
        }
        如果 (当号 == 0)
        {
            跳出;
        }
        如果 (i < 路止 && JSON字节区[i] == '.')
        {
            i = i + 1;
        }
    }
    JSON字节区[路起] = 0;
    JSON字节用量 = 路起;
    返回 当号;
}

// 单步:按**键名原文**在对象里找一个成员(给的是那个成员节点;找不到给 0)
方法 取成员(整数 节点, 字符串 名) 返回 整数
{
    如果 (节点 == 0 || 节点 > JSON节点用量)
    {
        返回 0;
    }
    整数 段起 = JSON区加串(名);
    如果 (段起 < 0)
    {
        返回 0;
    }
    整数 段长 = JSON字节用量 - 段起;
    整数 结果 = JSON找成员(节点, 段起, 段长);
    JSON字节区[段起] = 0;
    JSON字节用量 = 段起;
    返回 结果;
}

// 单步:第 `第几` 个子项(数组元素 / 对象成员,从 0 起;没有给 0)
方法 子项(整数 节点, 整数 第几) 返回 整数
{
    如果 (节点 == 0 || 节点 > JSON节点用量 || 第几 < 0)
    {
        返回 0;
    }
    返回 JSON第几个子项(节点, 第几);
}

// 数组元素数 / 对象成员数(取不到给 -1)
方法 个数(整数 节点, 字符串 路径) 返回 整数
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0)
    {
        返回 0 - 1;
    }
    返回 JSON子项数[号];
}

// 种类:0 空 / 1 真 / 2 假 / 3 数 / 4 串 / 5 数组 / 6 对象(取不到给 -1)
方法 种类(整数 节点, 字符串 路径) 返回 整数
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0)
    {
        返回 0 - 1;
    }
    返回 JSON种类[号];
}

// 这个路径上有东西吗
方法 有(整数 节点, 字符串 路径) 返回 逻辑
{
    返回 节点(节点, 路径) != 0;
}

// 是 null 吗
方法 是空(整数 节点, 字符串 路径) 返回 逻辑
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0)
    {
        返回 假;
    }
    返回 JSON种类[号] == 0;
}

// 是数组吗
方法 是数组(整数 节点, 字符串 路径) 返回 逻辑
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0)
    {
        返回 假;
    }
    返回 JSON种类[号] == 5;
}

// 是对象吗
方法 是对象(整数 节点, 字符串 路径) 返回 逻辑
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0)
    {
        返回 假;
    }
    返回 JSON种类[号] == 6;
}

// 取一个十进制整数(小数 / 指数 / 越 32 位 / 不是数,一律给默认)
方法 取整数(整数 节点, 字符串 路径, 整数 默认值) 返回 整数
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0 || JSON种类[号] != 3)
    {
        返回 默认值;
    }
    返回 JSON段转整数(JSON文起[号], JSON文长[号], 默认值);
}

// 取真 / 假(true 给真,false 给假,别的给默认)
方法 取逻辑(整数 节点, 字符串 路径, 逻辑 默认值) 返回 逻辑
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0)
    {
        返回 默认值;
    }
    如果 (JSON种类[号] == 1)
    {
        返回 真;
    }
    如果 (JSON种类[号] == 2)
    {
        返回 假;
    }
    返回 默认值;
}

// 取数字的**原样文本**(不带引号;不是数给假并把那一格清空)
方法 取数文(整数 节点, 字符串 路径, 字符串 出 文) 返回 逻辑
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0 || JSON种类[号] != 3)
    {
        文 = "";
        返回 假;
    }
    JSON区写进槽(JSON文起[号], JSON文长[号], 文);
    返回 真;
}

// 取串的内容(解掉转义、去掉两头引号;不是串给假并把那一格清空)
方法 取文本(整数 节点, 字符串 路径, 字符串 出 文) 返回 逻辑
{
    整数 号 = 节点(节点, 路径);
    如果 (号 == 0 || JSON种类[号] != 4)
    {
        文 = "";
        返回 假;
    }
    整数 起 = JSON文起[号] + 1;
    整数 止 = JSON文起[号] + JSON文长[号] - 1;
    如果 (止 < 起)
    {
        文 = "";
        返回 真;
    }
    JSON解转义进槽(起, 止, 文);
    返回 真;
}

// 取这个成员的键名(解掉转义;不是成员给假并把那一格清空)
方法 取键(整数 成员, 字符串 出 名) 返回 逻辑
{
    如果 (成员 == 0 || 成员 > JSON节点用量 || JSON键长[成员] < 2)
    {
        名 = "";
        返回 假;
    }
    JSON解转义进槽(JSON键起[成员] + 1, JSON键起[成员] + JSON键长[成员] - 1, 名);
    返回 真;
}

// ============================================================
// 7、对外的:现建(构造器)
// ============================================================

// 现建一个空对象节点(要接着往它里面放东西;换新树之前先 `清空`)
方法 新建对象() 返回 整数
{
    返回 JSON造节点(6);
}

// 现建一个空数组节点
方法 新建数组() 返回 整数
{
    返回 JSON造节点(5);
}

// 把 `子` 挂到对象 `父` 的 `名` 上(返回 `子`;挂不上给 0)
方法 放(整数 父, 字符串 名, 整数 子) 返回 整数
{
    如果 (父 == 0 || 子 == 0 || 子 > JSON节点用量)
    {
        返回 0;
    }
    整数 键起 = JSON加引号串(名);
    JSON键起[子] = 键起;
    JSON键长[子] = JSON字节用量 - 键起;
    JSON接子项(父, 子);
    返回 子;
}

// 把 `子` 接到数组 `父` 的尾巴上(返回 `子`;接不上给 0)
方法 加(整数 父, 整数 子) 返回 整数
{
    如果 (父 == 0 || 子 == 0 || 子 > JSON节点用量)
    {
        返回 0;
    }
    JSON接子项(父, 子);
    返回 子;
}

// 放一个十进制整数
方法 放整数(整数 父, 字符串 名, 整数 值) 返回 整数
{
    整数 起 = JSON字节用量;
    JSON区加整数(值);
    返回 JSON放新节点(父, 名, 3, 起, JSON字节用量 - 起);
}

// 放一个串(按 JSON 规矩转义)
方法 放文本(整数 父, 字符串 名, 字符串 文本) 返回 整数
{
    整数 起 = JSON加引号串(文本);
    返回 JSON放新节点(父, 名, 4, 起, JSON字节用量 - 起);
}

// 放 true / false
方法 放逻辑(整数 父, 字符串 名, 逻辑 值) 返回 整数
{
    整数 起 = JSON字节用量;
    如果 (值 == 真)
    {
        逻辑 丢一 = JSON区加字节('t');
        逻辑 丢二 = JSON区加字节('r');
        逻辑 丢三 = JSON区加字节('u');
        逻辑 丢四 = JSON区加字节('e');
        返回 JSON放新节点(父, 名, 1, 起, 4);
    }
    逻辑 丢一 = JSON区加字节('f');
    逻辑 丢二 = JSON区加字节('a');
    逻辑 丢三 = JSON区加字节('l');
    逻辑 丢四 = JSON区加字节('s');
    逻辑 丢五 = JSON区加字节('e');
    返回 JSON放新节点(父, 名, 2, 起, 5);
}

// 放 null
方法 放空(整数 父, 字符串 名) 返回 整数
{
    整数 起 = JSON字节用量;
    逻辑 丢一 = JSON区加字节('n');
    逻辑 丢二 = JSON区加字节('u');
    逻辑 丢三 = JSON区加字节('l');
    逻辑 丢四 = JSON区加字节('l');
    返回 JSON放新节点(父, 名, 0, 起, 4);
}

// 往数组尾巴上接一个整数
方法 加整数(整数 父, 整数 值) 返回 整数
{
    整数 起 = JSON字节用量;
    JSON区加整数(值);
    返回 JSON放新节点(父, "", 3, 起, JSON字节用量 - 起);
}

// 往数组尾巴上接一个串
方法 加文本(整数 父, 字符串 文本) 返回 整数
{
    整数 起 = JSON加引号串(文本);
    返回 JSON放新节点(父, "", 4, 起, JSON字节用量 - 起);
}

// 往数组尾巴上接一个 true / false
方法 加逻辑(整数 父, 逻辑 值) 返回 整数
{
    整数 起 = JSON字节用量;
    如果 (值 == 真)
    {
        逻辑 丢一 = JSON区加字节('t');
        逻辑 丢二 = JSON区加字节('r');
        逻辑 丢三 = JSON区加字节('u');
        逻辑 丢四 = JSON区加字节('e');
        返回 JSON放新节点(父, "", 1, 起, 4);
    }
    逻辑 丢一 = JSON区加字节('f');
    逻辑 丢二 = JSON区加字节('a');
    逻辑 丢三 = JSON区加字节('l');
    逻辑 丢四 = JSON区加字节('s');
    逻辑 丢五 = JSON区加字节('e');
    返回 JSON放新节点(父, "", 2, 起, 5);
}

// ============================================================
// 8、对外的:生成
// ============================================================

// 把一个节点生成成文本,**写进你给的那一格**(长循环里用这条)
方法 生成到(整数 节点, 字符串 出 文) 返回 逻辑
{
    如果 (节点 == 0 || 节点 > JSON节点用量)
    {
        文 = "";
        返回 假;
    }
    整数 起 = JSON字节用量;
    JSON生成(节点);
    如果 (JSON字节用量 + 1 >= 16384)
    {
        JSON字节区[起] = 0;
        JSON字节用量 = 起;
        文 = "";
        返回 假;
    }
    JSON区写进槽(起, JSON字节用量 - 起, 文);
    JSON字节区[起] = 0;
    JSON字节用量 = 起;
    返回 真;
}

// 把一个节点生成成文本,直接给一个串(每次新串;长循环里请用 `生成到`)
方法 生成(整数 节点) 返回 字符串
{
    字符串 文 = "";
    逻辑 好 = 生成到(节点, 文);
    如果 (好 == 假)
    {
        返回 "";
    }
    返回 文;
}
