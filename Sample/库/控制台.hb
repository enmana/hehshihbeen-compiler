// ============================================================
// 控制台.hb —— 输入输出与表格 / 进度条的人话层(依赖 `string.hb` / `宽度.hb` / `float64.hb`)
//
// 用法:
// ```
// 包含 "../库/控制台.hb";
// 控制台.写整数(42, 6);                       // 右对齐到 6 格
// 控制台.写整数补零(7, 3);                    // 007(编号 / 日期那种)
// 控制台.写双精度(3.14159, 2);                // 3.14(小数位固定)
// 整数 宽[3] = [8, 6, 10];
// 控制台.写表格线(宽, 3);
// 控制台.写表格头("姓名|年龄|城市", "|", 宽, 3);
// 控制台.写表格线(宽, 3);
// 控制台.写表格行("张三|28|杭州", "|", 宽, 3);
// 控制台.进度条(37, 100, 20);                 // [#######.............] 37%
// 字符串 行 = 控制台.读一行();
// 整数 数 = 控制台.读整数();
// ```
//
// 把**控制台输出**这一层收在一处:**写数字**(右对齐 / 补零 / 固定小数位)、**写表格**(列宽 + 中文按两格算 +
//   超宽截断)、**进度条**、**读输入**(一行 / 一个数 / 一个字符)。
//
// 口径(2026-10;每条都对着实测写):
//   · **宽度一律按"占几格"算**(不是字节数、也不是文字数):`取文字宽度` 那一套 —— 汉字 2 格、
//     ASCII 1 格 —— 所以中文表格才能对齐;`写整数` 的 `宽度` 也是格数;
//   · **`写整数` 是空格右对齐、`写整数补零` 是左侧补 `0`**:两件事分开给(表格列用前者、
//     编号 / 日期 / 端口用后者),`宽度` 写 0 或负数就是"不补";
//   · **`写双精度` 按 `小数位` 固定小数**:做法是拿 `双精度转字符串` 给的那一串**最短十进制表示**
//     在小数点后面截 + 四舍五入(**不按二进制精确值** —— 语言里没有"双精度 → 整数"的转换,
//     要二进制精确那一路只能走 `float64.hb` 的定点串那一族),所以 `0.145` 保留两位给 `0.15`
//     (按那串字面),不是 `0.14`;
//     非数 / 无穷 / 科学计数那种形态(**含 `e` `E` `n` `N` `I` 的**)**原样输出**,不动它;
//   · **表格的一行是一条整串 + 一个分隔串**:`"张三|28|杭州"` —— 语言现在**不能把 `字符串 表[]`
//     当形参**(见帮助《二十七、还没有的写法》),所以一行的几列只能拼成一条整串再传,库自己切
//     (与 `hb.切分` 同一套写法);分隔串可以是一个字(`|` / `\t`)也可以是几个字;
//   · **列不够就空着、列多了就丢掉**:那一行给的段数少于 `列数` 时后面的格子打空格;
//   · **超宽的格子按 `宽度.hb.截断` 截**(末尾一个 `…`);
//   · **表格每行自带 `|` 分隔与两侧空格**(`| 张三 | 28 |`),`写表格线` 给 `+------+----+` 那种线;
//   · **读输入那一族就是内建那三个的包**:`读一行` 给不含换行的一行(空行给空串)、
//     `读整数` 走 `读取数字`(读到不是数字**当场停下并给报错**,那是语言口径)、`读字符` 给一个 `字符`;
//   · **不报错、不停机**:除了 `读整数` 那一条(它按语言口径报错),其余任何入参都有结果。
//
// 提供的函数:逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:写整数 / 写整数补零 O(位数 + 宽度);写双精度 O(那段文字的长度);
//   写表格那一族 O(列数 × 列宽);进度条 O(格数);读那一族 O(这一行 / 这个数的长度)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **只管控制台那一头**:图形窗口上的文字排版归 `界面.hb` 与 `画文字`(那一套是**等宽**口径,
//     与这一库的"中文两格"不是同一条尺子);
//   · **表格的数据只能"一条整串 + 分隔"**:想要"一列一个字符串变量"的写法要等语言面放开
//     `字符串 表[]` 形参(见帮助《二十七、还没有的写法》),在那之前这一库的形态就是标准形态;
//   · **`写双精度` 不做"二进制精确四舍五入"**(见上):要那种口径请自己用 `float64.hb` 的
//     定点串那一族(它按二进制位算),代价是那一套只吐**一串最短表示**、不再按小数位排版;
//   · **`读整数` 会把程序停住**(语言里 `读取数字` 就是"读到非数字报错停下"):要"读一行自己解析"
//     请用 `读一行` + `hb.安全解析整数`;
//   · **进度条不回到行首**:它打一整行(`输出行`),要原地刷新得靠终端自己的回车,
//     这一库不碰 `\r`(标准输出上不保证效果,所以不做成"原地刷"的承诺)。
// ============================================================
模块 控制台

包含 "string.hb"
包含 "宽度.hb"
包含 "float64.hb"

// ---------- 模块状态:切段用的两条并排定长表 + 进位标志 ----------
私有 整数 段起[64];
私有 整数 段长[64];
私有 逻辑 尾满 = 假;

// ============================================================
// 1、写数字
// ============================================================

// 整数转成十进制串;`宽度` 大于 0 时左边补空格凑到该格数(本身更长就不补也不截)
方法 拼整数(整数 值, 整数 宽度) 返回 字符串
{
    字符串 文 = 转字符串(值);
    如果 (宽度 > 0)
    {
        文 = 宽度.右对齐(文, 宽度);
    }
    返回 文;
}

// 整数转成十进制串;`宽度` 大于 0 时左边补 `0` 凑到该格数(编号 / 日期那种排法)
方法 拼整数补零(整数 值, 整数 宽度) 返回 字符串
{
    字符串 文 = 转字符串(值);
    如果 (宽度 > 0)
    {
        文 = 左补位(文, 宽度, '0');
    }
    返回 文;
}

// 双精度按最短十进制表示截到 `小数位`(四舍五入,不看二进制值);非数 / 无穷原样给
方法 拼双精度(双精度 位, 整数 小数位) 返回 字符串
{
    字符串 原 = 双精度转字符串(位);
    返回 控制台定点文本(原, 小数位);
}

// 把右对齐好的整数打到控制台;末尾不换行,要换行得自己接一个 输出行
方法 写整数(整数 值, 整数 宽度)
{
    输出(拼整数(值, 宽度));
    返回
}

// 把左边补过 `0` 的整数打到控制台,末尾也不换行;`宽度` 不大于 0 就一个 0 也不补
方法 写整数补零(整数 值, 整数 宽度)
{
    输出(拼整数补零(值, 宽度));
    返回
}

// 把按 `小数位` 固定好的双精度打到控制台,末尾换行(非数 / 无穷原样打)
方法 写双精度(双精度 位, 整数 小数位)
{
    字符串 原 = 双精度转字符串(位);
    输出行(控制台定点文本(原, 小数位));
    返回
}

// ============================================================
// 2、表格
// ============================================================

// 按 `宽表` 每列的格数拼一条 +---+ 横线(每列打 格数 + 2 个减号,列宽为负当 0);只给串
方法 拼表格线(整数 宽表[], 整数 列数) 返回 字符串
{
    字符串 结果 = "+";
    整数 i = 0;
    当 (i < 列数)
    {
        整数 格 = 宽表[i];
        如果 (格 < 0)
        {
            格 = 0;
        }
        整数 k = 0;
        当 (k < 格 + 2)
        {
            拼接到(结果, "-");
            k = k + 1;
        }
        拼接到(结果, "+");
        i = i + 1;
    }
    返回 结果;
}

// 把 `标题行` 按 `分隔` 切段,逐段居中排进 `宽表` 给的列宽;段少补空格、超宽截断
方法 拼表格头(字符串 标题行, 字符串 分隔, 整数 宽表[], 整数 列数) 返回 字符串
{
    返回 控制台拼一行(标题行, 分隔, 宽表, 列数, 真);
}

// 把 `数据行` 按 `分隔` 切段后逐段左对齐摊进列宽(段少补空格、超宽接 …、多出的段丢掉)
方法 拼表格行(字符串 数据行, 字符串 分隔, 整数 宽表[], 整数 列数) 返回 字符串
{
    返回 控制台拼一行(数据行, 分隔, 宽表, 列数, 假);
}

// 打印表头上下那条 +---+ 横线(末尾换行;列宽照 `宽表`,不碰表头表身)
方法 写表格线(整数 宽表[], 整数 列数)
{
    输出行(拼表格线(宽表, 列数));
    返回
}

// 打印列标题排成的那一行(居中,末尾换行;超宽截断、段少补空格)
方法 写表格头(字符串 标题行, 字符串 分隔, 整数 宽表[], 整数 列数)
{
    输出行(拼表格头(标题行, 分隔, 宽表, 列数));
    返回
}

// 打印一条数据排成的那一行(左对齐,末尾换行;一条数据一行,超宽截断)
方法 写表格行(字符串 数据行, 字符串 分隔, 整数 宽表[], 整数 列数)
{
    输出行(拼表格行(数据行, 分隔, 宽表, 列数));
    返回
}

// 按 `当前` / `总数` 打一条 [###...] 百分比横条(`总数` ≤ 0 给 0%,比例夹在 0~100)
方法 进度条(整数 当前, 整数 总数, 整数 格数)
{
    整数 满 = 0;
    整数 百分 = 0;
    如果 (总数 > 0)
    {
        百分 = 当前 * 100 / 总数;
        如果 (格数 > 0)
        {
            满 = 当前 * 格数 / 总数;
        }
    }
    如果 (百分 < 0)
    {
        百分 = 0;
    }
    如果 (百分 > 100)
    {
        百分 = 100;
    }
    如果 (满 < 0)
    {
        满 = 0;
    }
    如果 (满 > 格数)
    {
        满 = 格数;
    }
    字符串 结果 = "[";
    整数 i = 0;
    当 (i < 满)
    {
        拼接到(结果, "#");
        i = i + 1;
    }
    当 (i < 格数)
    {
        拼接到(结果, ".");
        i = i + 1;
    }
    拼接到(结果, "] ");
    拼接到(结果, 转字符串(百分));
    拼接到(结果, "%");
    输出行(结果);
    返回
}

// ============================================================
// 3、读输入
// ============================================================

// 从控制台读一整行交回(不含行尾换行;空行给空串,读到末尾也给空串)
方法 读一行() 返回 字符串
{
    字符串 行 = "";
    整数 读到 = 读取行(行);
    返回 行;
}

// 从控制台读一个十进制整数交回;读到不是数字的地方按语言口径当场报错停下
方法 读整数() 返回 整数
{
    返回 读取数字();
}

// 读一个字符(读到末尾给 -1;接它的变量用 `var`)
方法 读字符() 返回 字符
{
    返回 读取字符();
}

// ============================================================
// 私有:表格那一行怎么拼(表头居中 / 表身左对齐)
// ============================================================
私有 方法 控制台拼一行(字符串 数据行, 字符串 分隔, 整数 宽表[], 整数 列数, 逻辑 居中) 返回 字符串
{
    整数 段数 = 切分(数据行, 分隔, 段起, 段长);
    字符串 结果 = "|";
    整数 i = 0;
    当 (i < 列数)
    {
        整数 格 = 宽表[i];
        如果 (格 < 0)
        {
            格 = 0;
        }
        字符串 段 = "";
        如果 (i < 段数)
        {
            段 = 段取(数据行, 段起, 段长, i);
        }
        如果 (取文字宽度(段) > 格)
        {
            段 = 宽度.截断(段, 格, "…");
        }
        如果 (居中)
        {
            段 = 宽度.居中(段, 格);
        }
        否则
        {
            段 = 宽度.左对齐(段, 格);
        }
        拼接到(结果, " ");
        拼接到(结果, 段);
        拼接到(结果, " |");
        i = i + 1;
    }
    返回 结果;
}

// ============================================================
// 私有:`双精度转字符串` 给的那串最短表示 → 固定小数位
// ============================================================

// 这串里有没有"不是普通十进制"的记号(`e` / `E` / `n` / `N` / `I`:科学计数 / 非数 / 无穷)
私有 方法 控制台是特殊数值文本(字符串 原) 返回 逻辑
{
    如果 (找子串(原, "e") >= 0)
    {
        返回 真;
    }
    如果 (找子串(原, "E") >= 0)
    {
        返回 真;
    }
    如果 (找子串(原, "n") >= 0)
    {
        返回 真;
    }
    如果 (找子串(原, "N") >= 0)
    {
        返回 真;
    }
    返回 找子串(原, "I") >= 0;
}

// 全是 `0` 吗(空串算"全是零")
私有 方法 控制台全是零(字符串 文本) 返回 逻辑
{
    整数 i = 0;
    整数 长 = 文本.长度();
    当 (i < 长)
     {
        如果 (文本[i] != '0')
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 一串数字 +1(只用来给小数部分进位;全 9 时把 `尾满` 置上)
私有 方法 控制台小数进位(字符串 尾) 返回 字符串
{
    尾满 = 假;
    整数 长 = 尾.长度();
    字符串 结果 = "";
    逻辑 带 = 真;
    整数 i = 长 - 1;
    当 (i >= 0)
    {
        整数 码 = 尾[i];
        如果 (带)
        {
            如果 (码 == 57)
            {
                码 = 48;
            }
            否则
            {
                码 = 码 + 1;
                带 = 假;
            }
        }
        字符 c = 码;
        字符串 前 = "";
        拼接到(前, c);
        拼接到(前, 结果);
        结果 = 前;
        i = i - 1;
    }
    尾满 = 带;
    返回 结果;
}

// 整数部分 +1(可能要往前长出一位,如 `99` → `100`)
私有 方法 控制台整数加一(字符串 整) 返回 字符串
{
    如果 (整.长度() == 0)
    {
        返回 "1";
    }
    字符串 加 = 控制台小数进位(整);
    如果 (尾满)
    {
        字符串 结果 = "1";
        拼接到(结果, 加);
        返回 结果;
    }
    返回 加;
}

// 最短十进制表示 → 固定小数位(先摘符号、把整数段与小数段分开,再交给 `拼定点`)
//   —— 拆成两个函数是**帧**的要求:参数 + 局部共用 96 字节,合在一处放不下(`帧超出 96 字节`)
私有 方法 控制台定点文本(字符串 原, 整数 小数位) 返回 字符串
{
    如果 (小数位 < 0)
    {
        小数位 = 0;
    }
    如果 (原.长度() == 0)
    {
        返回 "";
    }
    如果 (控制台是特殊数值文本(原))
    {
        返回 原;
    }
    逻辑 负 = 假;
    字符串 数 = 原;
    如果 (数[0] == '-')
    {
        负 = 真;
        数 = 取子串(数, 1, 数.长度() - 1);
    }
    整数 点 = 找子串(数, ".");
    字符串 整 = 数;
    字符串 小 = "";
    如果 (点 >= 0)
    {
        整 = 取子串(数, 0, 点);
        小 = 取子串(数, 点 + 1, 数.长度() - 点 - 1);
    }
    如果 (整.长度() == 0)
    {
        整 = "0";
    }
    返回 控制台拼定点(整, 小, 小数位, 负);
}

// 私有:补位 / 四舍五入 / 拼回去
私有 方法 控制台拼定点(字符串 整, 字符串 小, 整数 小数位, 逻辑 负) 返回 字符串
{
    字符串 尾 = 小;                     // 只读的字符串参数不能重新赋值:先落到本地变量上
    字符串 头 = 整;
    逻辑 进位 = 假;
    如果 (尾.长度() > 小数位)
    {
        如果 (尾[小数位] >= '5')
        {
            进位 = 真;
        }
        尾 = 取子串(尾, 0, 小数位);
    }
    当 (尾.长度() < 小数位)
    {
        拼接到(尾, "0");
    }
    如果 (进位)
    {
        尾 = 控制台小数进位(尾);
        如果 (尾满)
        {
            头 = 控制台整数加一(头);
        }
    }
    字符串 结果 = 头;
    如果 (小数位 > 0)
    {
        拼接到(结果, ".");
        拼接到(结果, 尾);
    }
    逻辑 零 = 头 == "0";
    如果 (零)
    {
        零 = 控制台全是零(尾);
    }
    如果 (负 && 零 == 假)
    {
        字符串 带号 = "-";
        拼接到(带号, 结果);
        返回 带号;
    }
    返回 结果;
}
