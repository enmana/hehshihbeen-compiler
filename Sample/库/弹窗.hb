// ============================================================
// 弹窗.hb —— **提示框 / 选文件 / 另存文件**(纯 HB 库:包住那几条宿主能力)
//
// 用法:包含 "../库/弹窗.hb";`弹窗.提醒(正文)` / `弹窗.确认(正文)` / `弹窗.选一个(后缀, 路径)`(路径为空 = 用户取消了)。
//
// 宿主那一侧有 `提示框` / `选文件` / `另存文件` 三条(82 / 83 / 84),这一层把按钮号 / 答案号收成有名字的函数。
//
// 口径(2026-10-11):
//   · **"取消了" 与 "没有这一手" 是两件事**:`用户取消了()` = 上一次挑文件是**人按了取消**
//     (下一步通常是"什么也不做");`能弹窗()` = 这个宿主**有没有这一手**(命令行 / 无头运行 /
//     非 Windows 桌面这些没有系统窗口能力的环境里都给假;下一步通常是"换一条路走")
//     ⇒ 挑文件那两条**返回假有两种原因**,靠这两个函数分开;
//   · **没有这一手时**:`提醒` 返回假,`确认` / `是不是` / `问三样` 返回 **-1**(**不是** 0)——
//     0 是"用户点了确定 / 是",不能与"根本没人问过"混;
//   · **`确认` 认"是"**:用户点「否」返回假(与"没弹成"同一个返回值,要分清就自己用 `问三样`);
//   · **后缀写成 `.obj` 这样的一整条**(要多种就写 `".obj;.obj.gz"`);**不查后缀对不对**;
//   · **路径是系统给的绝对路径**(可能是 `内容://…` 虚拟路径);
//   · **不抛异常、不停机**:全部靠返回值与 `上次错()` 说清楚。
//
// 英文对照:提醒 = alert / info · 确认 = confirm · 问三样 = ask3 · 选一个 = open · 另存为 = saveAs
//   能弹窗 = available · 用户取消了 = cancelled · 上次错 = lastError
//
// 复杂度:O(1)。依赖:宿主能力 82 / 83 / 84。
// 提供的函数(11 个):逐个见下面那张公开方法表。
// 边界(如实登记):命令行 / 无头运行 / 非 Windows 桌面这些环境里都给假;"取消"与"没有这一手"要分开看。
// ============================================================

模块 弹窗

// 上一次"没成"的码(按项分支:这门语言的字符串不能拼)
整数 弹窗_上次 = 0;        // 0 成了 / 1 用户取消 / 2 这个宿主没有这一手 / 3 别的失败
字符串 弹窗_标题 = "提示";

私有 方法 弹窗_记(整数 码)
{
    弹窗_上次 = 码;
}

// 一个「确定」的提示框(标题取默认 `提示`)
方法 提醒(字符串 正文) 返回 逻辑
{
    整数 答 = 提示框(弹窗_标题, 正文, 0);
    如果 (答 < 0)
    {
        弹窗_记(2);
        返回 假;
    }
    弹窗_记(0);
    返回 真;
}

// 带标题的「确定」提示框
方法 提醒带标题(字符串 标题, 字符串 正文) 返回 逻辑
{
    弹窗_标题 = 标题;
    整数 答 = 提示框(标题, 正文, 0);
    如果 (答 < 0)
    {
        弹窗_记(2);
        返回 假;
    }
    弹窗_记(0);
    返回 真;
}

// 「是 / 否」:点「是」给真;点「否」给假(**没弹成也给假** —— 要分清就自己用 `问三样`)
方法 确认(字符串 正文) 返回 逻辑
{
    整数 答 = 提示框(弹窗_标题, 正文, 2);
    如果 (答 < 0)
    {
        弹窗_记(2);
        返回 假;
    }
    如果 (答 == 2)
    {
        弹窗_记(0);
        返回 真;
    }
    弹窗_记(1);
    返回 假;
}

// 与 `确认` 同义(名字给人读着顺:`如果 (弹窗.是不是("…"))`)
方法 是不是(字符串 正文) 返回 逻辑
{
    返回 确认(正文);
}

// 「是 / 否 / 取消」:2 是 / 3 否 / 1 取消 / **-1 没弹成**(这个宿主没有这一手)
方法 问三样(字符串 正文) 返回 整数
{
    整数 答 = 提示框(弹窗_标题, 正文, 3);
    如果 (答 < 0)
    {
        弹窗_记(2);
        返回 -1;
    }
    弹窗_记(0);
    返回 答;
}

// 打开对话框挑一个文件;挑到的**绝对路径**写进 `字符串 出 路径`。真 = 挑好了;假 = 没挑到。
方法 选一个(字符串 后缀, 字符串 出 路径) 返回 逻辑
{
    路径 = "";                              // ⚠ `出` 参数可写(与普通字符串参数不同,见语言说明)
    逻辑 成 = 选文件(弹窗_标题, 后缀, 路径);
    如果 (成 == 假)
    {
        弹窗_记(2);
        返回 假;
    }
    如果 (路径.长度() == 0)
    {
        弹窗_记(1);
        返回 假;
    }
    弹窗_记(0);
    返回 真;
}

// 另存为:第二个参数是**预填的文件名**(用户能在框里改)
方法 另存为(字符串 后缀, 字符串 预填名, 字符串 出 路径) 返回 逻辑
{
    路径 = "";
    逻辑 成 = 另存文件(弹窗_标题, 后缀, 预填名, 路径);
    如果 (成 == 假)
    {
        弹窗_记(2);
        返回 假;
    }
    如果 (路径.长度() == 0)
    {
        弹窗_记(1);
        返回 假;
    }
    弹窗_记(0);
    返回 真;
}

// 这个宿主有没有这一手(命令行 / 无头运行 / 非 Windows 桌面都给假);判据是"**上一次**那一趟的结果"。
方法 能弹窗() 返回 逻辑
{
    返回 弹窗_上次 != 2;
}

// 上一次挑文件是不是"人按了取消"(那是正常的一步,不是出错)
方法 用户取消了() 返回 逻辑
{
    返回 弹窗_上次 == 1;
}

// 上一次没成的人话(成了 / 人取消了都给空串 —— 取消不是错);字符串**不能拼**,按项分支。
方法 上次错() 返回 字符串
{
    如果 (弹窗_上次 == 2)
    {
        返回 "这个宿主不弹窗(提示框 / 选文件要宿主明确允许:桌面 IDE 勾上「运行 → 允许弹窗」,命令行加 `--弹窗`)";
    }
    返回 "";
}

// 上一次没成的那句**较长**的说明(要给人看细节时用这条)。
方法 上次错详() 返回 字符串
{
    如果 (弹窗_上次 == 2)
    {
        返回 "那几条腿都关着:命令行 `hbcc --run`、自检、独立 exe —— 这是有意为之,免得没人点的框把程序挂住";
    }
    返回 "";
}
