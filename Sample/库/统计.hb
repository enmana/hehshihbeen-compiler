// ============================================================
// 统计.hb —— 统计库(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 用法:
// ```
// 包含 "../库/统计.hb";
// 调用写 `统计.平均值(表)`
// ```
//
// 治的是“一共多少 / 平均多少 / 波动多大 / 中间那个是多少”这几件 —— 每一件都要先想清楚**溢出与小数**(求和会冲破 32 位、平均值不是整数),这一库一次办掉。
//
// 依赖两个现成的库(不是第三方,零依赖的承诺没破):`int64s.hb` 让累加器走 64 位(32 位累加等于把“溢出”当正常结果给用户;**最后回到 `整数` 时是低 32 位**);`float64.hb` 因为平均值 / 方差 / 标准差**结果本来就是小数**。
//
// 口径(2026-10;每条都对着实测写):
//   · **一律 32 位有符号 `整数` 当输入**:表里装的就是内建 `整数`(4 字节一格)。
//   · **求和 / 乘积 / 平方和 累加时按 64 位**(不中途溢出),**交给调用方时回到 `整数`**
//     (低 32 位回绕)。要 64 位的和,直接用 `长整数` 那一档自己累加 —— 本库不返回结构。
//   · **平均值 / 方差 / 标准差 返回 `双精度`**(`float64.hb` 的结构):
//     要打印用 `双精度转字符串(值)`,要比大小用 `双精度比较 / 双精度小于` 那一套
//     (结构不能直接写进 `输出行`,也不能用 `>` 比 —— 那是 `float64.hb` 的口径)。
//   · **方差是"样本方差"**(除以 `n-1`),**总体方差**是除以 `n`:两个都给了,调用方按用途挑。
//     表里只有 1 个元素时样本方差给 0(分母 0 那一档**不报错、不停机**)。
//   · **中位数 / 众数 是"数值统计"**:中位数 = 排序后正中间那个;偶数个取中间两个的**整数平均**
//     (向下取整,不是小数)。众数 = 出现次数最多的那个值,**并列时取最小的那个**(排序后先遇到)。
//   · **排序只在内部进行**:临时表是模块级的一张 256 格草稿纸,排完不动调用方那张表。
//   · **表比 256 长时只统计前 256 个**:定长数组不能动态要临时表(与 `数组.hb` 同一条边界)。
//     `求和 / 乘积 / 平方和 / 最大 / 最小 / 个数` 这几件**不经过临时表**,多长的表都算。
//   · **空表**:个数给 0、求和/乘积给 0/1、最大/最小给 0、平均给 0、方差给 0、中位数给 0、
//     众数给 0 —— 没有一个函数会因为"表是空的"停程序。要区分"0"与"没有",先用 `个数` 问一句。
//   · **不做浮点表、不做直方图**:元素类型就是 `整数`;直方图要"按组数填一张计数表",
//     那张表得多大是调用方定的(定长数组长度写死在源码里),本库不当第二个收表的形参
//     —— 要做直方图请照 `个数` + `数组.计数` 自己写(三行)。
//
// 提供的函数(17 个):逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:求和 / 乘积 / 平方和 / 最大 / 最小 / 极差 / 个数 O(表长);
//   中位数 / 众数 / 第k小 O(n²)(那一趟**插入排序**的钱;n 是 256 以内);
//   平均值 O(表长);方差 / 标准差 O(表长)(平方和是一趟走完,不排)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **结果回到 `整数` 会回绕**:`求和` 超过 21.47 亿就按 32 位回绕(与语言自己的 `+` 一样);
//     要真正的大和请自己用 `长整数` 累加(本库不返回结构,一个返回值只能是一种类型);
//   · **平均值 / 方差 / 标准差 是 `双精度`**:`输出行(统计.平均值(表))` **打不出来**
//     (结构不是标量),要先 `双精度转字符串` 再打印 —— 示例 38 与自检都照这条写;
//   · **草稿纸 256 格**(见上面口径):`中位数 / 众数 / 第k小` 只看前 256 个;
//   · **`取草稿` / `草稿个数` 是给"想知道排序结果长什么样"的调用方**,平时用不上;
//     它们读的是模块里那张草稿纸,两次调用之间如果又算了别的统计,内容会被换掉;
//   · **不做加权 / 不做分组 / 不做回归**:本库只做"一张整数表的基本统计量"。
// ============================================================
模块 统计

// 累加走 64 位、小数走双精度:两个现成库,理由见文件头"依赖"那一段。
包含 "int64s.hb"
包含 "float64.hb"

// ---------- 私有:草稿纸(排序落脚的地方;256 格,与 `数组.hb` 同一条边界) ----------
私有 整数 草稿[256];
私有 整数 草稿几个 = 0;
私有 整数 草稿上限 = 256;

// ---------- 私有:把 `值` 压进 [0, 上界] ----------
私有 方法 统计夹回(整数 值, 整数 上界) 返回 整数
{
    如果 (值 < 0)
    {
        返回 0;
    }
    如果 (值 > 上界)
    {
        返回 上界;
    }
    返回 值;
}

// ---------- 私有:把 `表` 复制进草稿纸;返回真正拷了几个(表比 256 长就只拷前 256 个) ----------
私有 方法 统计拷进草稿(整数 表[]) 返回 整数
{
    整数 有效 = 表.长度();
    如果 (有效 > 草稿上限)
    {
        有效 = 草稿上限;
    }
    整数 i = 0;
    当 (i < 有效)
    {
        草稿[i] = 表[i];
        i = i + 1;
    }
    草稿几个 = 有效;
    返回 有效;
}

// ---------- 私有:草稿纸前 `有效` 格插入排序(稳定、实现短;n ≤ 256) ----------
私有 方法 统计排草稿(整数 有效)
{
    整数 i = 1;
    当 (i < 有效)
    {
        整数 值 = 草稿[i];
        整数 j = i;
        当 (j > 0 && 草稿[j - 1] > 值)
        {
            草稿[j] = 草稿[j - 1];
            j = j - 1;
        }
        草稿[j] = 值;
        i = i + 1;
    }
}

// ---------- 私有:复制 + 排序一步到位;返回有效格数 ----------
私有 方法 统计备好排序(整数 表[]) 返回 整数
{
    整数 有效 = 统计拷进草稿(表);
    统计排草稿(有效);
    返回 有效;
}

// ---------- 私有:0.0(结构返回值必须先落进变量再返回 —— 语言的规矩) ----------
私有 方法 统计双精度零() 返回 双精度
{
    宽整数 宽零 = 宽整数从32(0);
    双精度 零 = 双精度从整数(宽零);
    返回 零;
}

// ---------- 私有:整数 → 双精度(负数先取绝对值,最后补符号) ----------
//   `双精度从整数` 收的是**结构参数**(按地址传)⇒ 实参只能是变量/字段/数组元素,
//   不能把 `宽整数从32(0 - 值)` 直接写在实参位置上(实测报"不能是表达式")。
私有 方法 统计转双精度(整数 值) 返回 双精度
{
    如果 (值 < 0)
    {
        宽整数 宽正 = 宽整数从32(0 - 值);
        双精度 正 = 双精度从整数(宽正);
        双精度 负 = 双精度取负(正);
        返回 负;
    }
    宽整数 宽 = 宽整数从32(值);
    双精度 结果 = 双精度从整数(宽);
    返回 结果;
}

// ---------- 私有:两个整数相除,商转双精度(分母为 0 给 0,不报错) ----------
私有 方法 统计比较双精度(整数 分子, 整数 分母) 返回 双精度
{
    如果 (分母 == 0)
    {
        双精度 零 = 统计双精度零();
        返回 零;
    }
    双精度 上 = 统计转双精度(分子);
    双精度 下 = 统计转双精度(分母);
    双精度 商 = 双精度除(上, 下);
    返回 商;
}

// ---------- 私有:整数 → 长整数(32 位有符号落成 64 位补码:正数零扩展、负数全 1 扩展) ----------
//   ⚠ 结构变量的**声明初值**只认"0"或"同一种结构的另一份变量"(`长整数 初值 = 长整数零();`
//   那种函数调用结果**不行**,实测报"要么整体清 0,要么用同一种结构的另一份拷过来")——
//   所以结构一律**先声明、再逐个字段赋值**。负数的两个高半区补满 65535 就是符号扩展。
私有 方法 统计整数转长整数(整数 值) 返回 长整数
{
    长整数 结果;
    结果.半区0 = 值 & 65535;
    结果.半区1 = (值 >> 16) & 65535;
    如果 (值 < 0)
    {
        结果.半区2 = 65535;
        结果.半区3 = 65535;
    }
    否则
    {
        结果.半区2 = 0;
        结果.半区3 = 0;
    }
    返回 结果;
}

// ---------- 私有:64 位累加器的低 32 位(带符号;回绕口径与语言自己的 `+` 一样) ----------
私有 方法 统计取低32位(整数 半区0, 整数 半区1) 返回 整数
{
    整数 低 = 半区0 & 65535;
    整数 高 = 半区1 & 65535;
    返回 低 | (高 << 16);
}

// ============================================================
// 1、一趟走完的那些(不经过草稿纸,多长的表都算)
// ============================================================

// 返回表有几格;空表给 0,不经过草稿纸,多长的表都算
方法 个数(整数 表[]) 返回 整数
{
    返回 表.长度();
}

// 整表求和(用长整数累加,不中途溢出);交回 `整数` 时只留低 32 位,空表给 0
方法 求和(整数 表[]) 返回 整数
{
    长整数 累计;
    累计.半区0 = 0;
    累计.半区1 = 0;
    累计.半区2 = 0;
    累计.半区3 = 0;
    整数 i = 0;
    当 (i < 表.长度())
    {
        长整数 项 = 统计整数转长整数(表[i]);
        累计 = 长整数加(累计, 项);
        i = i + 1;
    }
    返回 统计取低32位(累计.半区0, 累计.半区1);
}

// 整表连乘(长整数里累加);空表给 1,交回 `整数` 时只留低 32 位
方法 乘积(整数 表[]) 返回 整数
{
    长整数 累计;
    累计.半区0 = 1;
    累计.半区1 = 0;
    累计.半区2 = 0;
    累计.半区3 = 0;
    整数 i = 0;
    当 (i < 表.长度())
    {
        长整数 项 = 统计整数转长整数(表[i]);
        累计 = 长整数乘(累计, 项);
        i = i + 1;
    }
    返回 统计取低32位(累计.半区0, 累计.半区1);
}

// 每格先平方再累加(平方在长整数里算);空表给 0,交回时只留低 32 位
方法 平方和(整数 表[]) 返回 整数
{
    长整数 累计;
    累计.半区0 = 0;
    累计.半区1 = 0;
    累计.半区2 = 0;
    累计.半区3 = 0;
    整数 i = 0;
    当 (i < 表.长度())
    {
        长整数 项 = 统计整数转长整数(表[i]);
        长整数 方 = 长整数乘(项, 项);
        累计 = 长整数加(累计, 方);
        i = i + 1;
    }
    返回 统计取低32位(累计.半区0, 累计.半区1);
}

// 找出表里最大的那个值;空表给 0,不排序,多长的表都一趟走完
方法 最大(整数 表[]) 返回 整数
{
    如果 (表.长度() <= 0)
    {
        返回 0;
    }
    整数 大 = 表[0];
    整数 i = 1;
    当 (i < 表.长度())
    {
        如果 (表[i] > 大)
        {
            大 = 表[i];
        }
        i = i + 1;
    }
    返回 大;
}

// 找出表里最小的那个值;空表给 0,不排序,多长的表都一趟走完
方法 最小(整数 表[]) 返回 整数
{
    如果 (表.长度() <= 0)
    {
        返回 0;
    }
    整数 小 = 表[0];
    整数 i = 1;
    当 (i < 表.长度())
    {
        如果 (表[i] < 小)
        {
            小 = 表[i];
        }
        i = i + 1;
    }
    返回 小;
}

// 最大值减最小值(表里数的跨度);空表给 0,不排序,差值按 32 位算
方法 极差(整数 表[]) 返回 整数
{
    如果 (表.长度() <= 0)
    {
        返回 0;
    }
    返回 最大(表) - 最小(表);
}

// ============================================================
// 2、要小数的三件(返回 `双精度`,打印要先 `双精度转字符串`)
// ============================================================

// 总和除以格数给 `双精度`(打印要先 `双精度转字符串`);空表给 0
方法 平均值(整数 表[]) 返回 双精度
{
    整数 总数 = 表.长度();
    如果 (总数 <= 0)
    {
        双精度 零 = 统计双精度零();
        返回 零;
    }
    双精度 结果 = 统计比较双精度(求和(表), 总数);
    返回 结果;
}

// ---------- 私有:统计离差平方和(每一项都在 64 位里平方后累加) ----------
// 均值用整数除法(先取整再算离差):这样同一张表在 C# 与 HB 两侧走的是同一条算式,
// 对拍时不会因为"一边用小数均值、一边用整数均值"而差出一个尾数。
私有 方法 统计离差平方和(整数 表[], 整数 总数) 返回 长整数
{
    整数 均 = 求和(表) / 总数;
    长整数 累计;
    累计.半区0 = 0;
    累计.半区1 = 0;
    累计.半区2 = 0;
    累计.半区3 = 0;
    整数 i = 0;
    当 (i < 总数)
    {
        整数 离 = 表[i] - 均;
        长整数 项 = 统计整数转长整数(离);
        长整数 方 = 长整数乘(项, 项);
        累计 = 长整数加(累计, 方);
        i = i + 1;
    }
    返回 累计;
}

// 离差平方和除以格数减 1 给 `双精度`;1 格及以下给 0(分母 0 也不停机)
方法 样本方差(整数 表[]) 返回 双精度
{
    整数 总数 = 表.长度();
    如果 (总数 <= 1)
    {
        双精度 零 = 统计双精度零();
        返回 零;
    }
    长整数 和 = 统计离差平方和(表, 总数);
    双精度 结果 = 统计比较双精度(统计取低32位(和.半区0, 和.半区1), 总数 - 1);
    返回 结果;
}

// 离差平方和除以格数给 `双精度`;空表给 0,与 `样本方差` 只差一个分母
方法 总体方差(整数 表[]) 返回 双精度
{
    整数 总数 = 表.长度();
    如果 (总数 <= 0)
    {
        双精度 零 = 统计双精度零();
        返回 零;
    }
    长整数 和 = 统计离差平方和(表, 总数);
    双精度 结果 = 统计比较双精度(统计取低32位(和.半区0, 和.半区1), 总数);
    返回 结果;
}

// 把 `总体方差` 开平方得到的 `双精度`;空表给 0,内部不排表
方法 标准差(整数 表[]) 返回 双精度
{
    双精度 方 = 总体方差(表);
    双精度 根 = 双精度开方(方);
    返回 根;
}

// ============================================================
// 3、要排序的那几件(经过草稿纸,只看前 256 个)
// ============================================================

// 逐格看后一格是否小于前一格;都不小给真,空表和单格表给真
方法 是否升序(整数 表[]) 返回 逻辑
{
    整数 i = 1;
    当 (i < 表.长度())
    {
        如果 (表[i] < 表[i - 1])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 排序后第 k 个值(k 从 1 数起);越界给 0,只看前 256 格,不动调用方的表
方法 第k小(整数 表[], 整数 k) 返回 整数
{
    整数 有效 = 统计备好排序(表);
    如果 (k < 1 || k > 有效)
    {
        返回 0;
    }
    返回 草稿[k - 1];
}

// 排序后正中间的值;偶数格取中间两格的整数平均,空表给 0,只看前 256 格
方法 中位数(整数 表[]) 返回 整数
{
    整数 有效 = 统计备好排序(表);
    如果 (有效 <= 0)
    {
        返回 0;
    }
    整数 中 = 有效 / 2;
    如果 (有效 % 2 == 1)
    {
        返回 草稿[中];
    }
    返回 (草稿[中 - 1] + 草稿[中]) / 2;
}

// 出现次数最多的值(并列时取最小的那个);空表给 0,只看前 256 格
方法 众数(整数 表[]) 返回 整数
{
    整数 有效 = 统计备好排序(表);
    如果 (有效 <= 0)
     {
        返回 0;
    }
    整数 最多 = 0;
    整数 答案 = 草稿[0];
    整数 i = 0;
    当 (i < 有效)
    {
        整数 j = i;
        当 (j < 有效 && 草稿[j] == 草稿[i])
        {
            j = j + 1;
        }
        如果 (j - i > 最多)
        {
            最多 = j - i;
            答案 = 草稿[i];
        }
        i = j;
    }
    返回 答案;
}

// ============================================================
// 4、草稿纸的调试口(想知道"排完长什么样"时用)
// ============================================================

// 上一次排序生效的格数(配合 `取草稿` 用)
方法 草稿个数() 返回 整数
{
    返回 草稿几个;
}

// 读上一次排序留在草稿纸上的第 `下标` 格;下标越界给 0,再算别的统计会被换掉
方法 取草稿(整数 下标) 返回 整数
{
    如果 (下标 < 0 || 下标 >= 草稿几个)
    {
        返回 0;
    }
    返回 草稿[下标];
}
