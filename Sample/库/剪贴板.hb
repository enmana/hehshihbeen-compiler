// ============================================================
// 剪贴板.hb —— **系统剪贴板**(纯 HB 库:包住那几条宿主能力)
//
// 用法:包含 "../库/剪贴板.hb";`剪贴板.复制("要粘的那段字")`(覆盖原内容)/
//   `如果 (剪贴板.有东西()) { 输出行(剪贴板.取()); }` / `剪贴板.清掉()`。
//
//
// 口径(2026-10-11):
//   · **内容只走内部缓冲**:`取()` 不带参数,它把文本读进内部缓冲并返回那个**字符串**
//     (⚠ `字符串` **不能当参数往函数里传**)⇒ **要长期留的那一段,读回来自己马上赋值给一个变量**;
//   · **缓冲 512 字节**:超了 `取()` 给空串、`上次好()` 给假 —— **不静默截断**(截一半更难查);
//   · **`有东西()` 是"读到过非空文本"**:剪贴板里是图片 / 空的,都算"没有东西";
//   · **`复制` / `清掉` 在平台没有这一手时给假**(非 Windows 桌面就是这样)——
//     靠 `上次好()` / `上次错()` 说清楚,**不抛异常、不停机**;
//   · ⚠ **别依赖剪贴板里原来的内容**(机器上别的东西也会动它)。
//
//
// 复杂度:全部 O(内容长度)。依赖:宿主能力 80 / 81 / 85(无库依赖)。
// 提供的函数(6 个):逐个见下面那张公开方法表。
// 英文对照:取 = get · 有东西 = has · 复制 = copy / put · 清掉 = clear · 上次好 = ok · 上次错 = lastError
// 边界(如实登记):只做文本(图片 / 空的都算"没有东西");缓冲 512 字节;非 Windows 桌面给假。
// ============================================================

模块 剪贴板

// 内部缓冲:512 字节(见头注释第二条口径)。⚠ 这一门语言**声明时不能给初值**,所以它是空的起步。
字符串 剪贴板_缓冲 = "";

// 上一次那三条的"成没成"与"为什么没成"
逻辑 剪贴板_上次好 = 真;
整数 剪贴板_错码 = 0;          // 0 没有 / 1 读失败 / 2 不是文本 / 3 太长 / 4 平台没有这一手

私有 方法 剪贴板_记(逻辑 好没, 整数 码)
{
    剪贴板_上次好 = 好没;
    剪贴板_错码 = 码;
}

// 读剪贴板里的文本(读进内部缓冲,返回它);成不成看 `上次好()`。
方法 取() 返回 字符串
{
    字符串 剪贴板_读到 = "";
    逻辑 成 = 读剪贴板(剪贴板_读到);
    如果 (成 == 假)
    {
        剪贴板_记(假, 4);
        返回 "";
    }
    // 512 字节的缓冲:读回来的比它长就**不装**(截一半的文本比"没读到"更难查)
    如果 (剪贴板_读到.长度() > 512)
    {
        剪贴板_记(假, 3);
        返回 "";
    }
    剪贴板_缓冲 = 剪贴板_读到;
    剪贴板_记(真, 0);
    返回 剪贴板_缓冲;
}

// 剪贴板里有非空文本吗
方法 有东西() 返回 逻辑
{
    字符串 剪贴板_看 = "";
    逻辑 成 = 读剪贴板(剪贴板_看);
    如果 (成 == 假)
    {
        剪贴板_记(假, 4);
        返回 假;
    }
    如果 (剪贴板_看.长度() == 0)
    {
        剪贴板_记(真, 2);          // "读到了,但没有东西" —— 这一条不算错
        返回 假;
    }
    如果 (剪贴板_看.长度() > 512)
    {
        剪贴板_记(假, 3);
        返回 真;                    // 太长也算"有东西"(只是 `取()` 拿不回来)
    }
    剪贴板_缓冲 = 剪贴板_看;
    剪贴板_记(真, 0);
    返回 真;
}

// 把一段文本放进剪贴板(覆盖原来的内容)
方法 复制(字符串 内容) 返回 逻辑
{
    逻辑 成 = 写剪贴板(内容);
    如果 (成 == 假)
    {
        剪贴板_记(假, 4);
        返回 假;
    }
    剪贴板_缓冲 = 内容;
    剪贴板_记(真, 0);
    返回 真;
}

// 清空剪贴板
方法 清掉() 返回 逻辑
{
    逻辑 成 = 清空剪贴板();
    如果 (成 == 假)
    {
        剪贴板_记(假, 4);
        返回 假;
    }
    剪贴板_缓冲 = "";
    剪贴板_记(真, 0);
    返回 真;
}

// 上一次成没成
方法 上次好() 返回 逻辑
{
    返回 剪贴板_上次好;
}

// 上一次没成的人话(成了给空串);字符串不能拼,按项分支。
方法 上次错() 返回 字符串
{
    如果 (剪贴板_上次好)
    {
        返回 "";
    }
    如果 (剪贴板_错码 == 4)
    {
        返回 "这个宿主没有剪贴板(提示框 / 选文件那一族在命令行与自检那条腿上是关着的;真机桌面程序里才有)";
    }
    如果 (剪贴板_错码 == 3)
    {
        返回 "剪贴板里的文本比 512 字节还长 —— 本库的缓冲装不下(自己声明一个更大的字符串,直接调 `读剪贴板`)";
    }
    返回 "剪贴板里没有文本(可能是一张图,或者是空的)";
}
