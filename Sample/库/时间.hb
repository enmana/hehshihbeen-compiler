// ============================================================
// 时间.hb —— 时间戳的人话层:拆分 / 拼回 / 按模板写读 / 日历 / 计时(零依赖)
//
// 用法:
// ```
// 包含 "../库/时间.hb";
// 时间.设时区偏移(8 * 3600);                                 // 东八区;不设就是 UTC(0)
// 整数 年 = 0; 整数 月 = 0; 整数 日 = 0; 整数 时 = 0; 整数 分 = 0; 整数 秒 = 0;
// 时间.拆分(时间.现在秒(), 年, 月, 日, 时, 分, 秒);
// 输出行(时间.按模板写(时间.现在秒(), "YYYY-MM-DD hh:mm:ss"));  // 2026-10-05 13:20:45
// 输出行(时间.按模板写(时间.现在秒(), "YYYY年MM月DD日 WW"));     // 2026年10月05日 星期一
// 整数 戳 = 0;
// 如果 (时间.按模板读("2026-10-05 13:20:45", 戳)) { 输出行(戳); }
// 输出行(时间.某月天数(2024, 2));                             // 29
// ```
// 宿主给的时间只有两个数:`当前时间()` 是"1970-01-01 UTC 起的秒数",`当前毫秒()` 是"开机以来的单调毫秒"
//   (改系统时间都不动它)。程序要的却是"年 / 月 / 日 / 时 / 分 / 秒"与"人看得懂的那串字"。这一库分四族:
//   ① **拆分 / 拼回**(秒数 ↔ 年月日时分秒,公历纯整数算法);② **按模板写 / 按模板读**(互为逆运算);
//   ③ **日历**(闰年 / 某月天数 / 周几 / 当日零点);④ **计时**(走 `当前毫秒()`,与系统时间改动无关)。
//
// 口径(2026-10;每条都对着实测写):
//   · **时区走"固定偏移",不进规则表**:`当前时间()` 给的是 **UTC 秒数**,这一库一律按 `时区偏移`
//     (秒,默认 **0 = UTC**)换算成本地时间;**夏令时 / 历史时区变更不做**;
//   · **收的时间戳一律是"秒"**(与 `当前时间()` 同一档);**`开机毫秒()` 是另一个钟** —— 不是"1970 起的
//     毫秒",别拿它当时间戳用:计时用它,日历用秒;
//   · **时间戳是 32 位有符号**:能表示的日历到 **2038-01-19** 为止;
//   · **模板里认这些记号**(大小写有意义 —— `MM` 是月、`mm` 是分):`YYYY` 四位年 · `YY` 两位年 ·
//     `MM` 两位月 · `M` 月 · `DD` 两位日 · `D` 日 · `hh` 两位时(24 小时制) · `h` 时 · `mm` 两位分 ·
//     `m` 分 · `ss` 两位秒 · `s` 秒 · `WW` 中文星期 · `W` 星期数字(0 = 星期日);**其余字符原样照抄**
//     (所以 `YYYY年MM月DD日` 直接能写);
//   · **`按模板读` 认 `YYYY-MM-DD[ hh:mm[:ss]]`**:年月日之间的分隔符随便是哪个非数字字符,日子后面可以
//     没有时间(按 00:00:00 算)、时分后面可以省秒;字段数不足三个 / 月日越界(月 1~12、日 1~当月天数、
//     时 0~23、分与秒 0~59)**整条给假并把时间戳清零**;读出来的是 **UTC 秒数**,与 `按模板写` 互逆;
//   · **不报错、不停机**:任何入参都有结果 —— `拼回` 对越界的年月日按"多退少补"算;
//   · **计时那三个用"标签"认格**:最多同时记 **16 个**;`计时开始` 对同一个标签是"重新起表"(不占新格);
//     满了给 -1,不报错。
//
// 提供的函数(18 个):时区两个 + 拆分 / 拼回 / 周几 / 加秒 / 加天 / 差秒 / 当日零点 + 农历三个(闰年 /
//   某月天数 / 周几)+ 模板两个 + 计时三个;逐条见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:拆分 / 拼回 / 周几 / 当日零点都是 O(1)(定长整数运算);按模板写 / 按模板读 O(模板字数);
//   计时那三个 O(标签格数)(最多 16)。
//
// 边界(如实登记):
//   · **不带时区规则表**:跨夏令时的地区要自己按季节改偏移;
//   · **`YY` 是"年份的后两位"**(`2026` → `26`),**不按 2000 年前后猜世纪**;
//   · **`按模板读` 不认"只有年月"**(字段数不足三个给假),也不认 `2026-10-05T13:20:45.123` 这种小数秒;
//   · **`某月天数(年, 13)` 给 0**(不是报错、不是下一年的 1 月);
//   · **计时走 `当前毫秒()`**:改系统时间不影响它;副作用是**跨进程 / 重启不连续**,只能给同一次运行里的活计时。
// ============================================================
模块 时间

// ---------- 模块状态:时区偏移 + 16 个计时格 ----------
私有 整数 时区偏移 = 0;
私有 字符串 计时名[16];
私有 整数 计时起[16];
私有 整数 计时用了几格 = 0;
// 按模板写用的那一份"拆出来的数字":住模块级,不占语句帧 ——
// 六个数摆在函数里就是 24 字节,`按模板写` 那种一个记号一句的地方帧会顶到上限
私有 整数 暂年 = 0;
私有 整数 暂月 = 0;
私有 整数 暂日 = 0;
私有 整数 暂时 = 0;
私有 整数 暂分 = 0;
私有 整数 暂秒 = 0;
私有 整数 暂周 = 0;

// ============================================================
// 私有:整数 → 十进制文字(左侧按 `位数` 补零;负数带 '-')
// ============================================================
私有 方法 时间整数写文本(整数 值, 整数 位数) 返回 字符串
{
    无符号整数 大 = 值;
    逻辑 负 = 假;
    如果 (值 < 0)
    {
        负 = 真;
        大 = 0 - 值;
    }
    字符串 数 = "";
    如果 (大 == 0)
    {
        数 = "0";
    }
    当 (大 > 0)
    {
        字符 字 = 48 + 大 % 10;
        字符串 前 = "";
        拼接到(前, 字);
        拼接到(前, 数);
        数 = 前;
        大 = 大 / 10;
    }
    当 (数.长度() < 位数)
    {
        字符串 前 = "0";
        拼接到(前, 数);
        数 = 前;
    }
    如果 (负)
    {
        字符串 带号 = "-";
        拼接到(带号, 数);
        返回 带号;
    }
    返回 数;
}

// ---------- 私有:时间非负取余(结果恒非负;语言的 `%` 对负数向零截断) ----------
私有 方法 时间非负取余(整数 被, 整数 模) 返回 整数
{
    整数 余 = 被 % 模;
    如果 (余 < 0)
    {
        余 = 余 + 模;
    }
    返回 余;
}

// ---------- 私有:天序号(1970-01-01 = 0)→ 年 / 月 / 日(公历;Howard Hinnant 那套整数算法) ----------
私有 方法 时间从天数(整数 天, 引用 整数 年, 引用 整数 月, 引用 整数 日)
{
    整数 z = 天 + 719468;
    整数 era = z / 146097;
    如果 (z < 0)
    {
        era = z - 146096;
        era = era / 146097;
    }
    整数 doe = era * 146097;
    doe = z - doe;
    整数 yoe = doe / 1460;
    yoe = doe - yoe;
    yoe = yoe + doe / 36524;
    yoe = yoe - doe / 146096;
    yoe = yoe / 365;
    整数 y = era * 400;
    y = y + yoe;
    整数 天份 = yoe / 4;
    天份 = yoe * 365 + 天份;
    天份 = 天份 - yoe / 100;
    整数 doy = doe - 天份;
    整数 mp = 5 * doy;
    mp = mp + 2;
    mp = mp / 153;
    整数 d = 153 * mp;
    d = d + 2;
    d = d / 5;
    d = doy - d;
    d = d + 1;
    整数 m = mp + 3;
    如果 (mp >= 10)
    {
        m = mp - 9;
    }
    如果 (m <= 2)
    {
        y = y + 1;
    }
    年 = y;
    月 = m;
    日 = d;
    返回
}

// ---------- 私有:年 / 月 / 日 → 天序号(上面那套的反运算) ----------
私有 方法 时间到天数(整数 年, 整数 月, 整数 日) 返回 整数
{
    整数 y = 年;
    如果 (月 <= 2)
    {
        y = y - 1;
    }
    整数 era = y / 400;
    如果 (y < 0)
    {
        era = y - 399;
        era = era / 400;
    }
    整数 yoe = era * 400;
    yoe = y - yoe;
    整数 mp = 月 - 3;
    如果 (月 <= 2)
    {
        mp = 月 + 9;
    }
    整数 doy = 153 * mp;
    doy = doy + 2;
    doy = doy / 5;
    doy = doy + 日;
    doy = doy - 1;
    整数 doe = yoe * 365;
    doe = doe + yoe / 4;
    doe = doe - yoe / 100;
    doe = doe + doy;
    整数 天 = era * 146097;
    天 = 天 + doe;
    返回 天 - 719468;
}

// ---------- 私有:一个字是不是数字(`0`~`9`) ----------
私有 方法 时间是数字(文字 某字) 返回 逻辑
{
    返回 某字 >= '0' && 某字 <= '9';
}

// ---------- 私有:星期几的中文名 ----------
私有 方法 时间星期字(整数 号) 返回 字符串
{
    如果 (号 == 0)
    {
        返回 "星期日";
    }
    如果 (号 == 1)
    {
        返回 "星期一";
    }
    如果 (号 == 2)
    {
        返回 "星期二";
    }
    如果 (号 == 3)
    {
        返回 "星期三";
    }
    如果 (号 == 4)
    {
        返回 "星期四";
    }
    如果 (号 == 5)
    {
        返回 "星期五";
    }
    返回 "星期六";
}

// ============================================================
// 1、时区与两个钟
// ============================================================

// 设成本地时间与 UTC 的差(东八区写 28800)
方法 设时区偏移(整数 秒)
{
    时区偏移 = 秒;
    返回
}

// 现在用的偏移(秒)
方法 取时区偏移() 返回 整数
{
    返回 时区偏移;
}

// 当前 UTC 秒数(`当前时间()` 的包)
方法 现在秒() 返回 整数
{
    返回 当前时间();
}

// 开机以来的单调毫秒(计时用,不是 1970 起)
方法 开机毫秒() 返回 整数
{
    返回 当前毫秒();
}

// ============================================================
// 2、日历
// ============================================================

// 这一年是不是闰年
方法 是闰年(整数 年) 返回 逻辑
{
    如果 (年 % 400 == 0)
    {
        返回 真;
    }
    如果 (年 % 100 == 0)
    {
        返回 假;
    }
    返回 年 % 4 == 0;
}

// 这个月有几天;月越界给 0
方法 某月天数(整数 年, 整数 月) 返回 整数
{
    如果 (月 < 1 || 月 > 12)
    {
        返回 0;
    }
    如果 (月 == 2)
    {
        如果 (是闰年(年))
        {
            返回 29;
        }
        返回 28;
    }
    如果 (月 == 4 || 月 == 6 || 月 == 9 || 月 == 11)
    {
        返回 30;
    }
    返回 31;
}

// 把时间戳按当前时区拆成六个整数(写进你给的那六格)
方法 拆分(整数 时间戳, 引用 整数 年, 引用 整数 月, 引用 整数 日, 引用 整数 时, 引用 整数 分, 引用 整数 秒)
{
    整数 偏 = 时间戳 + 时区偏移;
    整数 日内 = 时间非负取余(偏, 86400);
    整数 天 = (偏 - 日内) / 86400;
    时 = 日内 / 3600;
    分 = 日内 % 3600 / 60;
    秒 = 日内 % 60;
    时间从天数(天, 年, 月, 日);
    返回
}

// 0 = 星期日 … 6 = 星期六
方法 周几(整数 时间戳) 返回 整数
{
    整数 偏 = 时间戳 + 时区偏移;
    整数 天 = 偏 / 86400;
    如果 (偏 % 86400 < 0)
    {
        天 = 天 - 1;
    }
    返回 时间非负取余(天 + 4, 7);
}

// 六个整数 → UTC 秒数(越界按"多退少补"算)
方法 拼回(整数 年, 整数 月, 整数 日, 整数 时, 整数 分, 整数 秒) 返回 整数
{
    整数 天 = 时间到天数(年, 月, 日);
    返回 天 * 86400 + 时 * 3600 + 分 * 60 + 秒 - 时区偏移;
}

// 那一天 00:00:00(按当前时区)
方法 当日零点(整数 时间戳) 返回 整数
{
    整数 偏 = 时间戳 + 时区偏移;
    整数 日内 = 时间非负取余(偏, 86400);
    整数 天 = (偏 - 日内) / 86400;
    返回 天 * 86400 - 时区偏移;
}

// ============================================================
// 3、按模板写 / 按模板读
// ============================================================

// 按模板把时间戳写成文字
方法 按模板写(整数 时间戳, 字符串 模板) 返回 字符串
{
    拆分(时间戳, 暂年, 暂月, 暂日, 暂时, 暂分, 暂秒);
    暂周 = 周几(时间戳);
    字符串 结果 = "";
    整数 长 = 模板.长度();
    整数 i = 0;
    当 (i < 长)
    {
        整数 用了 = 0;
        字符串 段 = 时间写记号(模板, i, 用了);
        如果 (用了 == 0)
        {
            文字 c = 模板[i];
            拼接到(结果, c);
            i = i + 1;
        }
        否则
        {
            拼接到(结果, 段);
            i = i + 用了;
        }
    }
    返回 结果;
}

// 私有:把模板第 `i` 个位置起的那个记号写成文字;`用了` 写回吃掉了几个字(0 = 这里不是记号)。
//   记号那一套与 `按模板写` 的文件头说明逐条对应;当前那份时间住模块级的 暂* 那几格。
私有 方法 时间写记号(字符串 模板, 整数 i, 引用 整数 用了) 返回 字符串
{
    整数 长 = 模板.长度();
    整数 剩 = 长 - i;
    用了 = 0;
    如果 (剩 >= 4 && 模板[i] == 'Y' && 模板[i + 1] == 'Y' && 模板[i + 2] == 'Y' && 模板[i + 3] == 'Y')
    {
        用了 = 4;
        返回 时间整数写文本(暂年, 4);
    }
    如果 (剩 >= 2 && 模板[i] == 'Y' && 模板[i + 1] == 'Y')
    {
        用了 = 2;
        返回 时间整数写文本(时间非负取余(暂年, 100), 2);
    }
    如果 (剩 >= 2 && 模板[i] == 'M' && 模板[i + 1] == 'M')
    {
        用了 = 2;
        返回 时间整数写文本(暂月, 2);
    }
    如果 (剩 >= 2 && 模板[i] == 'D' && 模板[i + 1] == 'D')
    {
        用了 = 2;
        返回 时间整数写文本(暂日, 2);
    }
    如果 (剩 >= 2 && 模板[i] == 'h' && 模板[i + 1] == 'h')
    {
        用了 = 2;
        返回 时间整数写文本(暂时, 2);
    }
    如果 (剩 >= 2 && 模板[i] == 'm' && 模板[i + 1] == 'm')
    {
        用了 = 2;
        返回 时间整数写文本(暂分, 2);
    }
    如果 (剩 >= 2 && 模板[i] == 's' && 模板[i + 1] == 's')
    {
        用了 = 2;
        返回 时间整数写文本(暂秒, 2);
    }
    如果 (剩 >= 2 && 模板[i] == 'W' && 模板[i + 1] == 'W')
    {
        用了 = 2;
        返回 时间星期字(暂周);
    }
    如果 (模板[i] == 'M')
    {
        用了 = 1;
        返回 时间整数写文本(暂月, 1);
    }
    如果 (模板[i] == 'D')
    {
        用了 = 1;
        返回 时间整数写文本(暂日, 1);
    }
    如果 (模板[i] == 'h')
    {
        用了 = 1;
        返回 时间整数写文本(暂时, 1);
    }
    如果 (模板[i] == 'm')
    {
        用了 = 1;
        返回 时间整数写文本(暂分, 1);
    }
    如果 (模板[i] == 's')
    {
        用了 = 1;
        返回 时间整数写文本(暂秒, 1);
    }
    如果 (模板[i] == 'W')
    {
        用了 = 1;
        返回 时间整数写文本(暂周, 1);
    }
    返回 "";
}

// 按 `YYYY-MM-DD[ hh:mm[:ss]]` 读回时间戳;认不出给 假
方法 按模板读(字符串 文本, 引用 整数 时间戳) 返回 逻辑
{
    时间戳 = 0;
    整数 年 = 0;
    整数 月 = 0;
    整数 日 = 0;
    整数 时 = 0;
    整数 分 = 0;
    整数 秒 = 0;
    整数 段号 = 0;
    整数 值 = 0;
    逻辑 有数 = 假;
    逻辑 坏 = 假;
    整数 长 = 文本.长度();
    整数 i = 0;
    当 (i < 长)
    {
        文字 c = 文本[i];
        如果 (时间是数字(c))
        {
            值 = 值 * 10 + (c - '0');
            有数 = 真;
        }
        否则
        {
            如果 (有数)
            {
                如果 (段号 == 0)
                {
                    年 = 值;
                }
                否则
                {
                    如果 (段号 == 1)
                    {
                        月 = 值;
                    }
                    否则
                    {
                        如果 (段号 == 2)
                        {
                            日 = 值;
                        }
                        否则
                        {
                            如果 (段号 == 3)
                            {
                                时 = 值;
                            }
                            否则
                            {
                                如果 (段号 == 4)
                                {
                                    分 = 值;
                                }
                                否则
                                {
                                    秒 = 值;
                                }
                            }
                        }
                    }
                }
                段号 = 段号 + 1;
                如果 (段号 > 6)
                {
                    坏 = 真;
                }
                值 = 0;
                有数 = 假;
            }
        }
        i = i + 1;
    }
    如果 (有数)
    {
        如果 (段号 == 0)
        {
            年 = 值;
        }
        否则
        {
            如果 (段号 == 1)
            {
                月 = 值;
            }
            否则
            {
                如果 (段号 == 2)
                {
                    日 = 值;
                }
                否则
                {
                    如果 (段号 == 3)
                    {
                        时 = 值;
                    }
                    否则
                    {
                        如果 (段号 == 4)
                        {
                            分 = 值;
                        }
                        否则
                        {
                            秒 = 值;
                        }
                    }
                }
            }
        }
        段号 = 段号 + 1;
        如果 (段号 > 6)
        {
            坏 = 真;
        }
    }
    如果 (坏 || 段号 < 3)
    {
        时间戳 = 0;
        返回 假;
    }
    如果 (月 < 1 || 月 > 12)
    {
        时间戳 = 0;
        返回 假;
    }
    整数 上限 = 某月天数(年, 月);
    如果 (日 < 1 || 日 > 上限)
    {
        时间戳 = 0;
        返回 假;
    }
    如果 (时 < 0 || 时 > 23)
    {
        时间戳 = 0;
        返回 假;
    }
    如果 (分 < 0 || 分 > 59)
    {
        时间戳 = 0;
        返回 假;
    }
    如果 (秒 < 0 || 秒 > 59)
    {
        时间戳 = 0;
        返回 假;
    }
    时间戳 = 拼回(年, 月, 日, 时, 分, 秒);
    返回 真;
}

// ============================================================
// 4、加减与计时
// ============================================================

// 时间戳 + `秒数`
方法 加秒(整数 时间戳, 整数 秒数) 返回 整数
{
    返回 时间戳 + 秒数;
}

// 时间戳 + `天数` 天
方法 加天(整数 时间戳, 整数 天数) 返回 整数
{
    返回 时间戳 + 天数 * 86400;
}

// 左 - 右
方法 差秒(整数 左, 整数 右) 返回 整数
{
    返回 左 - 右;
}

// 起一个计时格(同一个标签是重新起表);满了给 -1
方法 计时开始(字符串 标签) 返回 整数
{
    整数 i = 0;
    当 (i < 计时用了几格)
    {
        如果 (计时名[i] == 标签)
        {
            计时起[i] = 开机毫秒();
            返回 i;
        }
        i = i + 1;
    }
    如果 (计时用了几格 >= 16)
    {
        返回 0 - 1;
    }
    计时名[计时用了几格] = 标签;
    计时起[计时用了几格] = 开机毫秒();
    计时用了几格 = 计时用了几格 + 1;
    返回 计时用了几格 - 1;
}

// 从 `计时开始` 到现在多少毫秒;没这个标签给 -1
方法 计时毫秒(字符串 标签) 返回 整数
{
    整数 i = 0;
    当 (i < 计时用了几格)
    {
        如果 (计时名[i] == 标签)
        {
            返回 开机毫秒() - 计时起[i];
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// 把计时格全清掉
方法 计时清空() 返回 逻辑
{
    整数 i = 0;
    当 (i < 计时用了几格)
    {
        计时名[i] = "";
        i = i + 1;
    }
    计时用了几格 = 0;
    返回 真;
}
