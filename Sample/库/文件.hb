// ============================================================
// 文件.hb —— 文件读写与按行迭代的人话层(零依赖)
//
// 用法:
// ```
// 包含 "../库/文件.hb";
// 如果 (文件.存在("数据/名单.txt"))
// {
//     输出行(文件.大小("数据/名单.txt"));
//     输出行(文件.读全部("数据/名单.txt"));
// }
// 文件.写全部("数据/名单.txt", "张三\n李四\n");
// 文件.追加("数据/名单.txt", "王五\n");
// 文件.安全写全部("数据/配置.txt", "键=值\n");     // 写临时文件 + 原子替换,写一半崩了不毁原文件
// 整数 句 = 文件.开读("数据/名单.txt");
// 当 (文件.下一行(句))
// {
//     输出行(文件.当前行(句));                    // 一行一行来,不把整份读进内存
// }
// 文件.关读(句);
// ```
//
// 内建那几个文件能力都很"低层"(`读文件` 要现成变量 + **编译期**上限、`读文件块` 还要自己数偏移)。
//   这一库包成"给路径、拿结果",并补上三件天天要的小活:**有没有 / 多大**、**逐行迭代**、**安全保存**。
//
// 口径(2026-10;每条都对着实测写):
//   · **`读全部` 的上限是 1MB**(内建 `读文件` 要一个编译期上限,这里固定给 1048576):
//     比这还大的文件请走 `开读` / `下一行` 或 `Sample\库\流.hb`,**别把大文件整份拉进内存**
//     (这个 1MB 是**本函数自己**的编译期上限,与运行内存那一档无关 —— 后者默认 1MB、
//      工程文件里写 `"内存"` 可以配到 64MB);
//     读不到(文件不在 / 太大 / 读失败)一律给**空串**;
//   · **`大小` 是"按块数出来"的**(内建没有"取文件大小"这一项,见 `未做任务清单.md` §8):
//     一块 4096 字节,从头读到尾,**代价是 O(文件大小)** —— 只想判有没有用 `存在`;
//     打不开给 **-1**;超过 2GB 会绕(4 字节整数装不下);
//   · **`存在` 走的是"能不能打开读流"**:目录 / 打不开 / 路径不存在都给假(它只管**文件**);
//   · **逐行迭代的换行口径**:`\n` 断行,行尾那个 `\r` **一并去掉**(Windows 文本 / Linux 文本
//     读出来一样);最后一行**没有换行也算一行**;空文件给"一行都没有";
//   · **迭代有 16 个格子**:同时开 16 条;句柄 = `格子 * 65536 + 版本`,**关掉之后那个句柄当场作废**
//     (版本 +1) —— 拿旧句柄再调一律给假,不会串到别人的流上;
//   · **`安全写全部` = 写临时文件 + `改名` 盖上去**(同一卷上是一次原子替换):
//     写完那一刻盘上要么是**旧的整份**、要么是**新的整份**,不会有"写了一半"的中间态;
//     `改名` 失败会把临时文件删掉再给假(不留垃圾);
//   · **失败给假 / 空串 / -1,不停机、不报错**:任何入参都有结果。
//
// 提供的函数:逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:读全部 / 写全部 / 追加 O(字节数)(一盘);大小 O(字节数)(按块读);行数 O(字节数);
//   开读 O(1);下一行 O(这一行的字节数);读块 O(一块);存在 O(1)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **"文件"与"目录"分开管**:路径里是不是目录、列目录、建目录 / 删目录都在 `目录.hb` 与内建那一族,
//     这一库只处理**文件内容**;
//   · **`读全部` 不是"大文件工具"**:1MB 上限是刻意的(见上);真要处理大文件用 `开读` / `下一行`,
//     或者等 `流.hb` 那一层;
//   · **不做"按行写回列表"**:语言现在**不能把 `字符串 表[]` 当形参**(见帮助《二十七、还没有的写法》),
//     所以框架表里那句 `按行读入列表(路径) 返回 列表` **落成**了"`开读` + `下一行` + `当前行` 迭代"这一形态
//     (与 `链表` / `树` 那几库的迭代器同一套写法);`行数` 是给"先要个数量"的场合补的;
//   · **写文件不回"写了几个字节"**:内建只回真假(要字节数请写流,见 `流.hb`);
//   · **`临时文件` 只给路径、不建文件**(要建就自己 `写全部`):这样"先算路径、再写"两步都看得见;
//     同一个进程里连着要两个 **不会重名**(内部按毫秒 + 序号排),跨进程不保证。
// ============================================================
模块 文件

// ---------- 模块状态:16 个逐行迭代格 + 临时文件序号 ----------
私有 整数 行流句柄[16];
私有 整数 行流版本[16];
私有 整数 行流在用[16];
私有 字符串 行流余[16];
私有 字符串 行流行[16];
私有 整数 临时序号 = 0;

// ============================================================
// 私有:整数 → 十进制文字(负数带 '-')
// ============================================================
私有 方法 文件整数写文本(整数 值) 返回 字符串
{
    无符号整数 大 = 值;
    逻辑 负 = 假;
    如果 (值 < 0)
    {
        负 = 真;
        大 = 0 - 值;
    }
    字符串 数 = "";
    如果 (大 == 0)
    {
        数 = "0";
    }
    当 (大 > 0)
    {
        字符 字 = 48 + 大 % 10;
        字符串 前 = "";
        拼接到(前, 字);
        拼接到(前, 数);
        数 = 前;
        大 = 大 / 10;
    }
    如果 (负)
    {
        字符串 带号 = "-";
        拼接到(带号, 数);
        返回 带号;
    }
    返回 数;
}

// ---------- 私有:找第一个换行符(没有给 -1) ----------
私有 方法 文件找行(字符串 文本) 返回 整数
{
    整数 i = 0;
    整数 长 = 文本.长度();
    当 (i < 长)
    {
        如果 (文本[i] == '\n')
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// ---------- 私有:取前 `止` 个字(顺带把行尾那个 '\r' 去掉) ----------
私有 方法 文件取前行(字符串 文本, 整数 止) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 0;
    当 (i < 止)
    {
        文字 c = 文本[i];
        如果 (c != '\r')
        {
            拼接到(结果, c);
        }
        i = i + 1;
    }
    返回 结果;
}

// ---------- 私有:取 `起` 之后的全部 ----------
私有 方法 文件取后段(字符串 文本, 整数 起) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 起;
    整数 长 = 文本.长度();
    当 (i < 长)
    {
        文字 c = 文本[i];
        拼接到(结果, c);
        i = i + 1;
    }
    返回 结果;
}

// ---------- 私有:读 / 写某一格的"没拼完的那一段"
//   (字符串数组的元素**不能直接**当"字符串赋值的右边"用 —— 语言面的口径,见帮助《二十七、还没有的写法》;
//    用一层返回字符串的函数 / 一个字符串形参转一手就通了)
私有 方法 文件取余(整数 格) 返回 字符串
{
    返回 行流余[格];
}

私有 方法 文件置余(整数 格, 字符串 文本)
{
    行流余[格] = 文本;
    返回
}

私有 方法 文件取行格(整数 格) 返回 字符串
{
    返回 行流行[格];
}

私有 方法 文件置行(整数 格, 字符串 文本)
{
    行流行[格] = 文本;
    返回
}

// ---------- 私有:找一个空闲的行流格(满了给 -1) ----------
私有 方法 文件找空行格() 返回 整数
{
    整数 i = 0;
    当 (i < 16)
    {
        如果 (行流在用[i] == 0)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// ============================================================
// 1、有没有 / 多大 / 整份读写
// ============================================================

// 这个 `路径` 能不能打开读流(只认文件;目录、不存在、打不开一律给假)
方法 存在(字符串 路径) 返回 逻辑
{
    整数 句柄 = 0;
    整数 丢 = 打开读流(路径, 句柄);            // 返回值那一档是"无符号"字:判失败要看**句柄变量**
    如果 (句柄 < 0)
    {
        返回 假;
    }
    整数 关掉 = 关读流(句柄);
    返回 真;
}

// 一路按 4096 字节读到尾,数出文件多大;打不开给 -1,超过 2GB 会绕
方法 大小(字符串 路径) 返回 整数
{
    整数 句柄 = 0;
    整数 丢 = 打开读流(路径, 句柄);
    如果 (句柄 < 0)
    {
        返回 0 - 1;
    }
    字符串 块 = "";
    整数 合计 = 0;
    整数 块长 = 读一块(句柄, 块, 4096);
    当 (块长 > 0)
    {
        合计 = 合计 + 块长;
        块长 = 读一块(句柄, 块, 4096);
    }
    整数 关掉 = 关读流(句柄);
    返回 合计;
}

// 一次把整份文件读成字符串交回;上限 1MB,读不到(不在 / 太大 / 失败)给空串
方法 读全部(字符串 路径) 返回 字符串
{
    字符串 文本 = "";
    如果 (读文件(路径, 文本, 1048576))
    {
        返回 文本;
    }
    返回 "";
}

// 把 `文本` 整份覆盖写到 `路径` 上(原来那份全换掉);写成给真,写不成给假
方法 写全部(字符串 路径, 字符串 文本) 返回 逻辑
{
    返回 写文件(路径, 文本);
}

// 把 `文本` 接在文件末尾(文件不在就新建),原有内容不动;成不成给真假
方法 追加(字符串 路径, 字符串 文本) 返回 逻辑
{
    返回 追加写文件(路径, 文本);
}

// 给一个临时目录下的新路径(毫秒 + 序号 + `后缀`);只算路径不建文件,同一进程内不重名
方法 临时文件(字符串 后缀) 返回 字符串
{
    字符串 目录 = "";
    如果 (临时目录(目录, 1024) == 假)
    {
        目录 = ".";
    }
    临时序号 = 临时序号 + 1;
    字符串 名 = "";
    拼接到(名, 目录);
    拼接到(名, "/hb");
    拼接到(名, 文件整数写文本(当前毫秒()));
    拼接到(名, "_");
    拼接到(名, 文件整数写文本(临时序号));
    拼接到(名, 后缀);
    返回 名;
}

// 先写临时文件再改名盖上去的整份保存(不会留写一半);盖不上删临时文件给假
方法 安全写全部(字符串 路径, 字符串 文本) 返回 逻辑
{
    字符串 临时 = 临时文件(".tmp");
    如果 (写文件(临时, 文本) == 假)
     {
        返回 假;
    }
    如果 (改名(临时, 路径))
    {
        返回 真;
    }
    整数 丢掉 = 删文件(临时);
    返回 假;
}

// 从第 `偏移` 字节起读一块(最多 4096 字节)
方法 读块(字符串 路径, 整数 偏移, 字符串 出 块) 返回 逻辑
{
    块 = "";
    字符串 文本 = "";
    如果 (读文件块(路径, 偏移, 文本, 4096) == 假)
    {
        返回 假;
    }
    块 = 文本;
    返回 真;
}

// ============================================================
// 2、逐行迭代(跨块拼行)
// ============================================================

// 占一个行流格、按 `路径` 打开读流,给句柄(格 * 65536 + 版本);16 格占满或打不开给 -1
方法 开读(字符串 路径) 返回 整数
{
    整数 格 = 文件找空行格();
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    整数 句柄 = 0;
    整数 丢 = 打开读流(路径, 句柄);
    如果 (句柄 < 0)
    {
        返回 0 - 1;
    }
    行流句柄[格] = 句柄;
    文件置余(格, "");
    行流在用[格] = 1;
    行流版本[格] = 行流版本[格] + 1;
    返回 格 * 65536 + 行流版本[格];
}

// 取下一行(末尾没有换行的那一行也算一行);没有下一行给假。
//   行内容**不往调用方写**,放在本库那一格里,用 `当前行(句柄)` 取 —— 这一形态与
// 往后取该 `句柄` 的下一行(末尾没有换行的也算一行),成不成给真假;那行要用 当前行 取
方法 下一行(整数 句柄) 返回 逻辑
{
    整数 格 = 句柄 / 65536;
    整数 版 = 句柄 % 65536;
    如果 (格 < 0 || 格 > 15)
    {
        返回 假;
    }
    如果 (行流在用[格] == 0 || 行流版本[格] != 版)
    {
        返回 假;
    }
    文件置行(格, "");
    字符串 余 = 文件取余(格);
    当 (真)
    {
        整数 断 = 文件找行(余);
        如果 (断 >= 0)
        {
            字符串 本行 = 文件取前行(余, 断);
            字符串 后半 = 文件取后段(余, 断 + 1);
            文件置余(格, 后半);
            文件置行(格, 本行);
            返回 真;
        }
        字符串 块 = "";
        整数 块长 = 读一块(行流句柄[格], 块, 4096);
        如果 (块长 <= 0)
        {
            文件置余(格, "");
            如果 (余.长度() == 0)
            {
                返回 假;
            }
            文件置行(格, 余);
            返回 真;
        }
        拼接到(余, 块);
    }
    返回 假;
}

// 取该 `句柄` 上一次 下一行 拿到的那行;句柄作废或已经关读给空串
方法 当前行(整数 句柄) 返回 字符串
{
    整数 格 = 句柄 / 65536;
    整数 版 = 句柄 % 65536;
    如果 (格 < 0 || 格 > 15)
    {
        返回 "";
    }
    如果 (行流在用[格] == 0 || 行流版本[格] != 版)
    {
        返回 "";
    }
    返回 文件取行格(格);
}

// 关掉该 `句柄` 的读流并让这个句柄作废(版本 + 1,旧句柄再用给假);关成给真
方法 关读(整数 句柄) 返回 逻辑
{
    整数 格 = 句柄 / 65536;
    整数 版 = 句柄 % 65536;
    如果 (格 < 0 || 格 > 15)
    {
        返回 假;
    }
    如果 (行流在用[格] == 0 || 行流版本[格] != 版)
    {
        返回 假;
    }
    整数 关掉 = 关读流(行流句柄[格]);
    文件置余(格, "");
    行流在用[格] = 0;
    行流版本[格] = 行流版本[格] + 1;
    返回 真;
}

// 数这份文件有几行(照 开读 / 下一行 的口径,末尾没有换行那行也算);打不开给 -1,空文件给 0
方法 行数(字符串 路径) 返回 整数
{
    整数 句柄 = 开读(路径);
    如果 (句柄 < 0)
    {
        返回 0 - 1;
    }
    整数 个数 = 0;
    当 (下一行(句柄))
    {
        个数 = 个数 + 1;
    }
    关读(句柄);
    返回 个数;
}
