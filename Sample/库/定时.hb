// ============================================================
// 定时.hb —— 定时器库(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 用法:文件开头写 包含 "../../库/定时.hb";调用写 `定时.每(...)` / `定时.推进()`
//
// 界面程序的主循环每一轮要知道“有没有到点的事要做”(动画每 16 毫秒动一次、状态栏每 500 毫秒刷一次、三秒后自动收手)。这一库把那张表与“到点算”收在一处。
//
//   **零新宿主能力**:节拍就是语言内建的 `当前毫秒()`(单调钟;回绕那一档如实登记在边界里),定时表住库这边。
//
// 口径(2026-10):
//   · **一格一个定时器**:号从 0 起、**取最小空位**(取消掉的那一格会被后来的复用);
//     取消过的号**不承诺还能用**(可能被下一个登记拿走)。
//   · **每 vs 一次**:`每` 到点后自己排下一次(下一次 = 触发那一刻 + 间隔),`一次` 到点后自己摘掉。
//   · **到点判据用减法、不用比大小**:`当前毫秒() - 下次 >= 0` 看着对,其实错 ——
//     `当前毫秒()` 只给低 32 位、约 49.7 天回绕("这一轮的刻度"比"下一轮"大就会漏掉)。
//     所以库里的判据写成 **(现在 - 上次) 的模 >= 间隔**,回绕那一瞬间照样对。
//   · **回调**收的是 `回调` 那种 4 字节的值(`地址(函数名)`),调用走 `间接调用` ——
//     形参写成 `回调 处理`,调用方写 `定时.每(16, 地址(动一下))`。
//   · **回调只收一个整数**:库把"第几号定时器"交给它 —— 回调里要认是哪一个就用这个号。
//   · **回调里可以再登记 / 取消定时器**(`推进` 不是"边遍历边调",而是先把这一轮要触发的挑出来,
//     再一个个调);但别在回调里 `清空()` 整表 —— 那会把别的定时器一起摘掉。
//   · **间隔 0 也算数**:0 毫秒 = 每一轮 `推进` 都触发一次(自检与"立刻做一次"用得上)。
//   · **不报错、不停机**:号越界 / 没登记过一律给"假 / -1",与 string.hb / map.hb / 排序.hb 一个规矩。
//
// 两个入口分清楚:`定时.推进()` 喂节拍(**生产用法**,内部自己读 `当前毫秒()`);`定时.推进到(刻度)` 喂一个**指定的刻度**(自检 / 固定步长:不读机器钟,结果完全确定)。两个都会触发到点的回调,返回“这一轮触发了几次”。
//
// 提供的函数:逐条的作用见本页末尾那张公开方法表。
//
// 标准用法(界面主循环里):
//   如果 (打开窗口("示例", 320, 200))
//   {
//       定时.每(16, 地址(动一下));
//       定时.一次(3000, 地址(收手));
//       当 (真)
//       {
//           如果 (定时.推进() > 0) { 标脏(面); }
//           如果 (要重画(面)) { 重画(面); }
//           刷新();
//           等待(1);
//       }
//   }
//
// 一处语言面限制(如实记着,不是库偷懒):`回调` **不能进数组 / 结构字段** ⇒ 8 个处理回调只能展开成一排变量 `处理表0 … 处理表7`;表的格数上限(8)也是这么来的。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:逐条见各函数紧上面那行注释(登记 / 取消 / 查询都是扫那一张定长表)。
//
// 边界(如实登记):号不对 / 已经取消的给 假;登记不了给 -1;不报错、不停机。
// ============================================================
模块 定时

// 一屏一张表(与 `界面.hb` 的平行列同一个道理:回调不能进数组,所以一格一个变量)
整数 有效[];        // 1 = 在册,0 = 空位(取消掉 / 还没用过)
整数 间隔表[];      // 间隔毫秒(0 = 每轮都触发)
整数 上次表[];      // 上一次触发时的刻度
整数 下次表[];      // 一次性定时器的目标刻度(每过一段的那种不看它)
整数 一次性表[];    // 1 = 只做一次
回调 处理表0 = 地址(空忙);
回调 处理表1 = 地址(空忙);
回调 处理表2 = 地址(空忙);
回调 处理表3 = 地址(空忙);
回调 处理表4 = 地址(空忙);
回调 处理表5 = 地址(空忙);
回调 处理表6 = 地址(空忙);
回调 处理表7 = 地址(空忙);
整数 表上限 = 8;    // 展开的槽就这几格(与文件头那段"语言面限制"一致)
整数 已登记 = 0;    // 表里有几格在用
整数 当前刻度 = 0;  // 上一次喂进来的刻度

// 占位回调:某几格还没挂上处理时指向它(不然 `间接调用` 没得调)
方法 空忙(整数 号)
{
    返回
}

// ---------- 回调槽:第 号 格挂哪个处理(语言面:回调不能进数组,只能展开成一排) ----------
方法 设处理(整数 号, 回调 处理)
{
    如果 (号 == 0)
    {
        处理表0 = 处理;
        返回
    }
    如果 (号 == 1)
    {
        处理表1 = 处理;
        返回
    }
    如果 (号 == 2)
    {
        处理表2 = 处理;
        返回
    }
    如果 (号 == 3)
    {
        处理表3 = 处理;
        返回
    }
    如果 (号 == 4)
    {
        处理表4 = 处理;
        返回
    }
    如果 (号 == 5)
    {
        处理表5 = 处理;
        返回
    }
    如果 (号 == 6)
    {
        处理表6 = 处理;
        返回
    }
    如果 (号 == 7)
    {
        处理表7 = 处理;
        返回
    }
    返回
}

// 调第 号 格那个处理 —— **没有这个函数**:`间接调用` 的实参必须是**模块级那一格回调**
// (编译器要照它声明的签名摆参数槽;经参数转一手就认不出了),所以那八个调用点直接写在
// `推进到` 里(见那边的说明)。

// 第 号 格(0～7)恢复成空忙:取消 / 清空之后那格不再指向原来的处理函数。
方法 置空处理(整数 号)
{
    如果 (号 == 0)
    {
        处理表0 = 地址(空忙);
        返回
    }
    如果 (号 == 1)
    {
        处理表1 = 地址(空忙);
        返回
    }
    如果 (号 == 2)
    {
        处理表2 = 地址(空忙);
        返回
    }
    如果 (号 == 3)
    {
        处理表3 = 地址(空忙);
        返回
    }
    如果 (号 == 4)
    {
        处理表4 = 地址(空忙);
        返回
    }
    如果 (号 == 5)
    {
        处理表5 = 地址(空忙);
        返回
    }
    如果 (号 == 6)
    {
        处理表6 = 地址(空忙);
        返回
    }
    如果 (号 == 7)
    {
        处理表7 = 地址(空忙);
        返回
    }
    返回
}

// ---------- 登记 ----------
// 内部:找一个空位(取最小空位,号会复用),写进表里,给定时器号;满了给 -1
方法 登记(整数 间隔毫秒, 回调 处理, 整数 只做一次) 返回 整数
{
    整数 个数 = 有效.长度();
    整数 空位 = -1;
    整数 i = 0;
    当 (i < 个数)
    {
        如果 (有效[i] == 0)
        {
            空位 = i;
            跳出;
        }
        i = i + 1;
    }
    如果 (空位 < 0)
    {
        如果 (个数 >= 表上限)
        {
            返回 -1;                     // 表满(展开的槽就 8 格,与文件头写的一致)
        }
        空位 = 个数;
        有效.添加(0);
        间隔表.添加(0);
        上次表.添加(0);
        下次表.添加(0);
        一次性表.添加(0);
    }
    有效[空位] = 1;
    间隔表[空位] = 间隔毫秒;
    上次表[空位] = 当前刻度;
    一次性表[空位] = 只做一次;
    下次表[空位] = 当前刻度 + 间隔毫秒;
    设处理(空位, 处理);
    已登记 = 已登记 + 1;
    返回 空位;
}

// 登记一个"每过这么久做一次",给定时器号;登记不了给 -1
方法 每(整数 间隔毫秒, 回调 处理) 返回 整数
{
    如果 (间隔毫秒 < 0)
    {
        间隔毫秒 = 0;
    }
    返回 登记(间隔毫秒, 处理, 0);
}

// 登记一个"过这么久做一次就完",给定时器号;登记不了给 -1
方法 一次(整数 延时毫秒, 回调 处理) 返回 整数
{
    如果 (延时毫秒 < 0)
    {
        延时毫秒 = 0;
    }
    返回 登记(延时毫秒, 处理, 1);
}

// 摘掉一个(已经取消 / 号不对给 假)
方法 取消(整数 号) 返回 逻辑
{
    整数 个数 = 有效.长度();
    如果 (号 < 0 || 号 >= 个数)
    {
        返回 假;
    }
    如果 (有效[号] == 0)
    {
        返回 假;
    }
    有效[号] = 0;
    置空处理(号);
    已登记 = 已登记 - 1;
    返回 真;
}

// 全摘掉(界面重建那一屏时用)
方法 清空()
{
    有效.清空();
    间隔表.清空();
    上次表.清空();
    下次表.清空();
    一次性表.清空();
    整数 i = 0;
    当 (i < 表上限)
    {
        置空处理(i);
        i = i + 1;
    }
    已登记 = 0;
    当前刻度 = 0;
    返回
}

// 这一号到点没有:一次性看"刻度 − 下次 ≥ 0";每过一段的看"刻度 − 上次"(绕回来了就补一个 2^32)
方法 到点了吗(整数 号, 整数 刻度) 返回 逻辑
{
    如果 (一次性表[号] != 0)
    {
        返回 刻度 - 下次表[号] >= 0;
    }
    如果 (间隔表[号] <= 0)
    {
        返回 真;                          // 间隔 0:每一轮都到点
    }
    整数 差 = 刻度 - 上次表[号];
    如果 (差 < 0)
    {
        差 = 差 + 0xFFFFFFFF;              // 钟绕回来一圈了:补上一个满刻度(差一个不影响判据)
        差 = 差 + 1;
    }
    返回 差 >= 间隔表[号];
}

// ---------- 推进:触发所有到点的(返回触发了几次) ----------
// 为什么要"先挑出来再调":回调自己可能再 `每(...)` 登记一个 / `取消` 别的号 ——
// 边遍历边调会让下标错位(表在变长),所以这一轮要触发哪些**先记在一条待办表上**。
//
// **`间接调用` 为什么写在这一处、而不是抽成一个 `触发第几格(号)`**:
// 语言面的 `回调` 参数进来之后**编译器认不出"它指向哪个函数"**(报"不是编译器认得的回调"),
// 所以回调的调用点必须**直接写模块级那一格**(`处理表0` … `处理表7`)。
// 这一条与那两条语言面限制是一族的(要改语言面才能动)。
方法 推进到(整数 刻度) 返回 整数
{
    当前刻度 = 刻度;
    整数 个数 = 有效.长度();
    整数 待办[];
    整数 待办个数 = 0;
    整数 i = 0;
    当 (i < 个数)
    {
        如果 (有效[i] != 0)
        {
            如果 (到点了吗(i, 刻度))
            {
                待办.添加(i);
                待办个数 = 待办个数 + 1;
            }
        }
        i = i + 1;
    }
    整数 触发 = 0;
    整数 k = 0;
    当 (k < 待办个数)
    {
        整数 号 = 待办[k];
        如果 (有效[号] != 0)
        {
            如果 (一次性表[号] != 0)
            {
                取消(号);                    // 一次性的:触发过就摘掉(摘掉之后回调照样调得到)
            }
            上次表[号] = 刻度;
            如果 (号 == 0)
            {
                间接调用(处理表0, 号);
                触发 = 触发 + 1;
            }
            否则
            {
                如果 (号 == 1)
                {
                    间接调用(处理表1, 号);
                    触发 = 触发 + 1;
                }
                否则
                {
                    如果 (号 == 2)
                    {
                        间接调用(处理表2, 号);
                        触发 = 触发 + 1;
                    }
                    否则
                    {
                        如果 (号 == 3)
                        {
                            间接调用(处理表3, 号);
                            触发 = 触发 + 1;
                        }
                        否则
                        {
                            如果 (号 == 4)
                            {
                                间接调用(处理表4, 号);
                                触发 = 触发 + 1;
                            }
                            否则
                            {
                                如果 (号 == 5)
                                {
                                    间接调用(处理表5, 号);
                                    触发 = 触发 + 1;
                                }
                                否则
                                {
                                    如果 (号 == 6)
                                    {
                                        间接调用(处理表6, 号);
                                        触发 = 触发 + 1;
                                    }
                                    否则
                                    {
                                        如果 (号 == 7)
                                        {
                                            间接调用(处理表7, 号);
                                            触发 = 触发 + 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    返回 触发;
}

// 喂当前刻度(生产用法);返回这一轮触发了几次
方法 推进() 返回 整数
{
    返回 推进到(当前毫秒());
}

// ---------- 查询 ----------
方法 个数() 返回 整数
{
    返回 已登记;
}

// 这一号现在还算数吗
方法 在册(整数 号) 返回 逻辑
{
    整数 个数 = 有效.长度();
    如果 (号 < 0 || 号 >= 个数)
    {
        返回 假;
    }
    返回 有效[号] != 0;
}

// 登记时那个间隔(号不对给 -1)
方法 间隔(整数 号) 返回 整数
{
    如果 (!在册(号))
    {
        返回 -1;
    }
    返回 间隔表[号];
}

// 上一次喂进来的刻度(还没推进过给 0)
方法 刻度() 返回 整数
{
    返回 当前刻度;
}
