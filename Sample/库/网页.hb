// ============================================================
// 网页.hb —— 取一个网页、把 HTML 拆开看(纯 HB 库:不动 ISA、不动关键字、不动机器码)
//
// 用法:
// ```
// 包含 "../库/网页.hb";
// 字符串 主页 = "";
// 如果 (网页.取网页("http://127.0.0.1:8080/首页", 主页))
// {
//     字符串 标题 = "";  网页.取标题(主页, 标题);
//     字符串 正文 = "";  网页.去标签(主页, 正文);         // 标签去掉、实体解开、块级标签变换行
//     整数 起 = 0;  字符串 一条 = "";
//     当 (网页.取链接(主页, 起, 一条, 起)) { 输出行(一条); }   // 一条一条把链接抠出来
//     整数 表起 = 0;
//     如果 (网页.取表格(主页, 0, 表起)) { 输出行(网页.表行数()); }
// }
// 否则 { 输出行(网页.上次状态()); }                        // 没取到:HTTP 码(连不上给 4294967295)
// ```
// 宿主那条 `取网址` 只把响应体交出来 —— 状态码另问一句,地址还得自己拆,拿到的又是一整块 HTML。
//   这一库补齐四件事:① **地址**(`拆网址` / `拼网址`);② **取**(`取网页` / `取网页超时` / `取网页档`,
//   包着 `取网址`,顺手记住 HTTP 状态码);③ **拆 HTML**(`取标题` / `去标签` / `取链接` / `取属性` /
//   **`取表格`(行 / 格两问)**);④ **拆 HTTP 应答**(`解应答`:状态码 / 头 / 正文三段)。
//
// 口径(2026-10;每条都对着实测写):
//   · **一个功能号都不新开**:取的那一路就是宿主能力 `取网址`(同步一次性 GET)+ `取网址状态码`;
//     主机 + 端口要先写进工程文件 `.hbp` 的 `网址` 表(不在表里**连都不连**);
//   · **HTTP 2xx 才算成**:`取网页` 给真/假看的是 2xx,真实状态码问 `上次状态()`
//     (连不上 / 超时 / 还没取过都给 **4294967295**);
//   · **上限是编译期数字** ⇒ 这一库按"档"给:`1` = 8KB · `2` = 64KB · `3` = 256KB · `4` = 1MB;
//     `取网页` / `取网页超时` 走**第 2 档**;**超时不截断**(响应体超过上限给假,不给半页);
//   · **HTML 那几个函数按字节走**:页面先整块搬进库里那块字节区再逐字节扫,代价与页面长度成正比;
//     **一次处理的页面最长 8191 个文字**(字节区按最坏 4 字节/文字留的),超了给假;
//   · **实体表与 `HTML转义.hb` 同一份**:`amp` `lt` `gt` `quot` `apos` `nbsp`(不分大小写)+
//     `&#NN;` / `&#xHH;`;认不出的 `&` 原样留着,不报错、不停机;
//   · **标签名一律按 ASCII 不分大小写认**(`<TITLE>` 与 `<title>` 一样)。
//
// 提供的函数(17 个):取网页那一路 6 个 + 拆 HTML 那一路 8 个 + `表行数` / `行格数` / `格文本`;
//   逐条的参数与返回值见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:取一次网页 O(响应体字节数);`拆网址` / `拼网址` O(网址长度);`取标题` / `去标签` O(页面字节数);
//   `取链接` / `取属性` / `取表格` 一次 O(扫过去的那一段字节数)(要全部就一条条 `下一起` 往下走)。
//
// 内存账:一块 **32KB** 字节区(页面按字节搬进来)+ 一块 32 字节的"针"(要找的名字先收进来)+
//   一条 8191 文字以内的页面串(调用方那份)+ 几条成型短槽;长循环里不涨池。
//
// 边界(如实登记):
//   · **一次 GET、不跟跳转、不上传**(与 `取网址` 同一条:3xx 也算没取到);
//   · **不解析 CSS / 不做 DOM 树**:不建节点、不算层级;**表格也只到"行 / 格"这一层** ——
//     不认 `rowspan` / `colspan`(合并格按它占的那一格算,不铺开)、不认表里套表;
//   · **`去标签` 不解 UTF-8 转义**(`&amp;` 那类解,`\uXXXX` 那类不解);
//   · **`解应答` 认 `\r\n\r\n` 与 `\n\n` 两种空行**:分块传输(chunked)那种正文**不还原**,原样交给你;
//   · **一次一条串 / 一次一张表**:库自己那块字节区是"当下这一页"的 —— `取链接` 抠出来的地址、
//     `取表格` 抠出来的格都要**当场用掉**,下一次调用会把区里换掉(游标 `起` 照旧管用)。
// ============================================================
模块 网页

// ---------- 模块状态:一块页面字节区 + 一根针 + 几格短槽 ----------
私有 字符 网页区[32768];            // 页面按字节住这儿(下标 O(1))
私有 整数 网页区长 = 0;             // 区里现在有多少字节
私有 字符 网页针[32];               // 要找的名字(收成字节,免得在热循环里按下标读串)
私有 整数 网页针长 = 0;
私有 整数 网页值起 = 0;             // 抠属性值时那一段的两头
私有 整数 网页值止 = 0;
私有 整数 网页隔 = 4;               // 应答里"头与正文"之间那个空行隔了几个字节
私有 整数 网页上次码 = 0;           // 最近一次取网页的 HTTP 状态码

// 表格那一档(`取表格`):**一次一张表** —— 行与格的两头都按下标记在这儿(与"一次一条串"同一条口径)
私有 整数 网页表行数 = 0;           // 这一张表有几行
私有 整数 网页表总格 = 0;           // 这几行加起来几格
私有 整数 网页表行首格[64];         // 第 i 行的第一格在格表里的下标
私有 整数 网页表行格数[64];         // 第 i 行有几格
私有 整数 网页表格起[256];          // 第 i 格的文本在区里的两头([起, 止))
私有 整数 网页表格止[256];

// ============================================================
// 1、字节区这一层(页面进区、区里找名字、区里取一段)
// ============================================================

// ---------- 私有:整数转十进制文字(端口要用;不带库外依赖) ----------
私有 方法 网页数文(整数 值) 返回 字符串
{
    字符串 出文 = "";
    如果 (值 < 0)
    {
        拼接到(出文, '-');
        值 = 0 - 值;
    }
    如果 (值 == 0)
    {
        拼接到(出文, '0');
        返回 出文;
    }
    字符 倒[12];
    整数 位 = 0;
    当 (值 > 0 && 位 < 12)
    {
        倒[位] = 48 + (值 % 10);
        值 = 值 / 10;
        位 = 位 + 1;
    }
    当 (位 > 0)
    {
        位 = 位 - 1;
        拼接到(出文, 倒[位]);
    }
    返回 出文;
}

// ---------- 私有:一个字节折成 ASCII 小写(标签名 / 实体名都比这一档) ----------
私有 方法 网页小写(整数 码) 返回 整数
{
    如果 (码 >= 65 && 码 <= 90)
    {
        返回 码 + 32;
    }
    返回 码;
}

// ---------- 私有:一个字节是不是空白(空格 / 制表 / 换行 / 回车) ----------
私有 方法 网页是空白(整数 码) 返回 逻辑
{
    如果 (码 == 32 || 码 == 9 || 码 == 10 || 码 == 13)
    {
        返回 真;
    }
    返回 假;
}

// ---------- 私有:一个字节算不算"名字字符"(字母 / 数字 / `-` / `_`) ----------
//   用来确认找到的属性名是**整个名字**,不是另一个名字的尾巴(`data-href` 里的 `href`)。
私有 方法 网页是名字字符(整数 码) 返回 逻辑
{
    整数 小 = 网页小写(码);
    如果 (小 >= 97 && 小 <= 122)
    {
        返回 真;
    }
    如果 (码 >= 48 && 码 <= 57)
    {
        返回 真;
    }
    如果 (码 == 45 || 码 == 95)
    {
        返回 真;
    }
    返回 假;
}

// ---------- 私有:一个字节在 `基` 进制下值几(认不出给 -1) ----------
私有 方法 网页数位(整数 码, 整数 基) 返回 整数
{
    整数 数 = 0 - 1;
    如果 (码 >= 48 && 码 <= 57)
    {
        数 = 码 - 48;
    }
    否则
    {
        整数 小 = 网页小写(码);
        如果 (小 >= 97 && 小 <= 102)
        {
            数 = 小 - 87;
        }
    }
    如果 (数 >= 基)
    {
        数 = 0 - 1;
    }
    返回 数;
}

// ---------- 私有:区里到第一个 0 为止有几个字节 ----------
私有 方法 网页量长() 返回 整数
{
    整数 i = 0;
    当 (i < 32768)
    {
        如果 (网页区[i] == 0)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 32768;
}

// ---------- 私有:把一整页按**字节**搬进区(太长给假,不写坏内存) ----------
//   文字下标按下标走是"从头数 UTF-8",逐字扫一整页是平方的量级;搬成字节之后每个下标都是 O(1),
//   所以 `去标签` / `取链接` 这一族在大一点的页面上也拉得动。
私有 方法 网页装区(字符串 页面) 返回 逻辑
{
    网页区长 = 0;
    如果 (页面.长度() > 8191)
    {
        返回 假;
    }
    网页区[0] = 0;
    拼接到(网页区, 页面);
    网页区长 = 网页量长();
    返回 真;
}

// ---------- 私有:区里 [起, 止) 这一段原样搬成一条串(逐字节搬,汉字不坏) ----------
私有 方法 网页区取段(整数 起, 整数 止) 返回 字符串
{
    字符串 段 = "";
    如果 (起 < 0)
    {
        起 = 0;
    }
    如果 (止 > 网页区长)
    {
        止 = 网页区长;
    }
    整数 i = 起;
    当 (i < 止)
    {
        拼接到(段, 网页区[i]);
        i = i + 1;
    }
    返回 段;
}

// ---------- 私有:把要找的名字收进针(最多 32 字节;`折` != 0 时按 ASCII 折小写) ----------
私有 方法 网页收针(字符串 子, 整数 折)
{
    整数 长 = 子.长度();
    如果 (长 > 32)
    {
        长 = 32;
    }
    网页针长 = 长;
    整数 i = 0;
    当 (i < 长)
    {
        文字 字 = 子[i];
        整数 码 = 字;
        如果 (码 > 255)
        {
            码 = 63;
        }
        如果 (折 != 0)
        {
            码 = 网页小写(码);
        }
        网页针[i] = 码;
        i = i + 1;
    }
    返回
}

// ---------- 私有:从区里 `起` 往后找 `子`(找着给下标,没找着给 -1) ----------
私有 方法 网页寻(整数 起, 字符串 子, 整数 折) 返回 整数
{
    网页收针(子, 折);
    如果 (网页针长 == 0)
    {
        返回 0 - 1;
    }
    如果 (起 < 0)
    {
        起 = 0;
    }
    整数 i = 起;
    当 (i + 网页针长 <= 网页区长)
    {
        整数 j = 0;
        整数 同 = 1;
        当 (j < 网页针长)
        {
            整数 区码 = 网页区[i + j];
            如果 (折 != 0)
            {
                区码 = 网页小写(区码);
            }
            如果 (区码 != 网页针[j])
            {
                同 = 0;
                j = 网页针长;
            }
            否则
            {
                j = j + 1;
            }
        }
        如果 (同 == 1)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// ---------- 私有:区里从 `起` 那一位开始,是不是正好写着 `名`(不分大小写) ----------
私有 方法 网页同(整数 起, 字符串 名) 返回 逻辑
{
    整数 长 = 名.长度();
    如果 (起 < 0 || 起 + 长 > 网页区长)
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 长)
    {
        文字 字 = 名[i];
        整数 码 = 字;
        如果 (码 > 255)
        {
            返回 假;
        }
        如果 (网页小写(码) != 网页小写(网页区[起 + i]))
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// ============================================================
// 2、实体:把 `&amp;` 这一档解回字符(表与 `HTML转义.hb` 同一份)
// ============================================================

// ---------- 私有:区里 [起, 止) 这一段名字值几号(认不出给 -1) ----------
私有 方法 网页解一个(整数 起, 整数 止) 返回 整数
{
    如果 (止 <= 起)
    {
        返回 0 - 1;
    }
    如果 (网页区[起] == 35)                            // '#':数字实体
    {
        整数 基 = 10;
        整数 p = 起 + 1;
        如果 (p < 止 && (网页区[p] == 120 || 网页区[p] == 88))
        {
            基 = 16;
            p = p + 1;
        }
        如果 (p >= 止)
        {
            返回 0 - 1;
        }
        整数 值 = 0;
        整数 位 = 0;
        当 (p < 止)
        {
            整数 数 = 网页数位(网页区[p], 基);
            如果 (数 < 0)
            {
                返回 0 - 1;
            }
            值 = 值 * 基 + 数;
            位 = 位 + 1;
            p = p + 1;
        }
        如果 (位 == 0)
        {
            返回 0 - 1;
        }
        返回 值;
    }
    // 命名实体:表就这六个(与 `HTML转义.hb` 同一张)
    整数 长 = 止 - 起;
    如果 (长 == 2)
    {
        如果 (网页同(起, "lt"))
        {
            返回 60;
        }
        如果 (网页同(起, "gt"))
        {
            返回 62;
        }
    }
    如果 (长 == 3)
    {
        如果 (网页同(起, "amp"))
        {
            返回 38;
        }
    }
    如果 (长 == 4)
    {
        如果 (网页同(起, "quot"))
        {
            返回 34;
        }
        如果 (网页同(起, "apos"))
        {
            返回 39;
        }
        如果 (网页同(起, "nbsp"))
        {
            返回 160;
        }
    }
    返回 0 - 1;
}

// ---------- 私有:把一条串里的实体解开(认不出的那个 `&` 原样留着) ----------
私有 方法 网页解实体(字符串 文本) 返回 字符串
{
    字符串 出文 = "";
    如果 (!网页装区(文本))
    {
        返回 出文;
    }
    整数 i = 0;
    当 (i < 网页区长)
    {
        如果 (网页区[i] != 38)                         // 不是 '&':原样搬一个字节
        {
            拼接到(出文, 网页区[i]);
            i = i + 1;
            继续;
        }
        整数 止 = 0 - 1;                               // 往后最多 16 字节找 ';'
        整数 k = i + 1;
        当 (k < 网页区长 && k <= i + 16)
        {
            如果 (网页区[k] == 59)
            {
                止 = k;
                跳出;
            }
            k = k + 1;
        }
        如果 (止 < 0)
        {
            拼接到(出文, '&');
            i = i + 1;
            继续;
        }
        整数 号 = 网页解一个(i + 1, 止);
        如果 (号 < 0)
        {
            拼接到(出文, '&');
            i = i + 1;
            继续;
        }
        文字 一个 = 号;
        拼接到(出文, 一个);
        i = 止 + 1;
    }
    返回 出文;
}

// ============================================================
// 3、地址:拆开、拼回
// ============================================================

// ---------- 私有:文本从 `起` 到 `止` 那一段(短串上用,不进字节区) ----------
私有 方法 网页截(字符串 文本, 整数 起, 整数 止) 返回 字符串
{
    字符串 出文 = "";
    整数 长 = 文本.长度();
    如果 (止 > 长)
    {
        止 = 长;
    }
    整数 i = 起;
    当 (i < 止)
    {
        文字 一个 = 文本[i];
        拼接到(出文, 一个);
        i = i + 1;
    }
    返回 出文;
}

// ---------- 私有:文本是不是以 `头` 起头(ASCII 不分大小写) ----------
私有 方法 网页以起头(字符串 文本, 字符串 头) 返回 逻辑
{
    整数 头长 = 头.长度();
    如果 (文本.长度() < 头长 || 头长 == 0)
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 头长)
    {
        文字 文本字 = 文本[i];
        文字 头字 = 头[i];
        整数 文本码 = 文本字;
        整数 头码 = 头字;
        如果 (网页小写(文本码) != 网页小写(头码))
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 把网址拆成三件:`主机` · `端口` · `路径`。认 `http://` / `https://` / `//` 三种起头
// (都不写就按 `http` + 80 算);`https` 的缺省端口是 443。主机空 / 一个字符都没有给假。
方法 拆网址(字符串 网址, 字符串 出 主机, 引用 整数 端口, 字符串 出 路径) 返回 逻辑
{
    主机 = "";
    端口 = 80;
    路径 = "/";
    整数 起点 = 0;
    整数 默认口 = 80;
    如果 (网页以起头(网址, "https://"))
    {
        默认口 = 443;
        起点 = 8;
    }
    否则 如果 (网页以起头(网址, "http://"))
    {
        默认口 = 80;
        起点 = 7;
    }
    否则 如果 (网页以起头(网址, "//"))
    {
        默认口 = 80;
        起点 = 2;
    }
    端口 = 默认口;
    整数 长 = 网址.长度();
    如果 (起点 >= 长)
    {
        返回 假;
    }
    整数 i = 起点;
    整数 主起 = i;
    当 (i < 长)
    {
        文字 字 = 网址[i];
        如果 (字 == ':' || 字 == '/' || 字 == '?' || 字 == '#')
        {
            跳出;
        }
        i = i + 1;
    }
    如果 (i <= 主起)
    {
        返回 假;
    }
    字符串 主本 = 网页截(网址, 主起, i);
    主机 = 主本;
    如果 (i < 长 && 网址[i] == ':')
    {
        i = i + 1;
        整数 口 = 0;
        整数 位 = 0;
        当 (i < 长)
        {
            文字 字 = 网址[i];
            如果 (字 < '0' || 字 > '9')
            {
                跳出;
            }
            口 = 口 * 10 + (字 - '0');
            位 = 位 + 1;
            i = i + 1;
        }
        如果 (位 > 0)
        {
            端口 = 口;
        }
    }
    如果 (i < 长 && 网址[i] == '/')
    {
        字符串 路本 = 网页截(网址, i, 长);
        路径 = 路本;
    }
    返回 真;
}

// 三件拼回一条:`http://主机:端口路径`。`端口` 给 0(或负数)= 不写端口那一截;
// `路径` 给空串按 `/` 算,不以 `/` 起头就自己补一个。
方法 拼网址(字符串 主机, 整数 端口, 字符串 路径) 返回 字符串
{
    字符串 出文 = "http://";
    拼接到(出文, 主机);
    如果 (端口 > 0)
    {
        拼接到(出文, ":");
        拼接到(出文, 网页数文(端口));
    }
    如果 (路径.长度() == 0)
    {
        拼接到(出文, "/");
    }
    否则 如果 (路径[0] == '/')
    {
        拼接到(出文, 路径);
    }
    否则
    {
        拼接到(出文, "/");
        拼接到(出文, 路径);
    }
    返回 出文;
}

// ============================================================
// 4、取:包着 `取网址`(同步一次性 GET),顺手把状态码记住
// ============================================================

// ---------- 私有:按档取一次(档 1 = 8KB / 2 = 64KB / 3 = 256KB / 4 = 1MB) ----------
//   上限在语言那一层要写编译期数字,所以这里只能一档一条分支 —— 这正是"档"这个形状的来由。
私有 方法 网页取到(字符串 网址, 整数 档, 整数 毫秒, 字符串 出 正文) 返回 逻辑
{
    正文 = "";
    逻辑 成 = 假;
    如果 (档 <= 1)
    {
        成 = 取网址(网址, 正文, 8192, 毫秒);
    }
    否则 如果 (档 == 2)
    {
        成 = 取网址(网址, 正文, 65536, 毫秒);
    }
    否则 如果 (档 == 3)
    {
        成 = 取网址(网址, 正文, 262144, 毫秒);
    }
    否则
    {
        成 = 取网址(网址, 正文, 1048576, 毫秒);
    }
    网页上次码 = 取网址状态码();
    返回 成;
}

// 取一个网页(第 2 档 64KB,超时用宿主的缺省 10 秒);正文写进你那一格,成不成看返回值。
// HTTP 2xx 才算成;真实状态码问 `上次状态()`(连不上 / 超时 / 还没取过都是 4294967295)。
方法 取网页(字符串 网址, 字符串 出 正文) 返回 逻辑
{
    正文 = "";
    字符串 本地 = "";
    逻辑 成 = 网页取到(网址, 2, 0, 本地);
    如果 (成)
    {
        正文 = 本地;
    }
    返回 成;
}

// 同上,超时自己给(毫秒;写 0 = 缺省 10000)。
方法 取网页超时(字符串 网址, 整数 毫秒, 字符串 出 正文) 返回 逻辑
{
    正文 = "";
    字符串 本地 = "";
    逻辑 成 = 网页取到(网址, 2, 毫秒, 本地);
    如果 (成)
    {
        正文 = 本地;
    }
    返回 成;
}

// 同上,上限按档换:`1` = 8KB · `2` = 64KB · `3` = 256KB · `4` = 1MB(别的数按 4 算)。
// 响应体超过上限**给假**(不截断 —— 半页文本比"没取到"更容易骗人)。
方法 取网页档(字符串 网址, 整数 档, 整数 毫秒, 字符串 出 正文) 返回 逻辑
{
    正文 = "";
    字符串 本地 = "";
    逻辑 成 = 网页取到(网址, 档, 毫秒, 本地);
    如果 (成)
    {
        正文 = 本地;
    }
    返回 成;
}

// 最近一次 `取网页` 那一族的 HTTP 状态码。
// 还没取过 / 连不上 / 超时都给 **4294967295**(0xFFFFFFFF,与 `取网址状态码()` 一个口径)。
方法 上次状态() 返回 整数
{
    返回 网页上次码;
}

// 200~299 算成功(与 `取网址` 给真/假那一条同一个范围)。
方法 是成功(整数 码) 返回 逻辑
{
    返回 码 >= 200 && 码 <= 299;
}

// 状态码归零(取网页那一路的开关 / 缓冲区不受影响)。
方法 清掉()
{
    网页上次码 = 0;
    返回
}

// ============================================================
// 5、拆 HTML
// ============================================================

// `<title>…</title>` 里那一段(实体已解开)。没有 `<title>` 给假并把那一格清空。
方法 取标题(字符串 页面, 字符串 出 标题) 返回 逻辑
{
    标题 = "";
    如果 (!网页装区(页面))
    {
        返回 假;
    }
    整数 开 = 网页寻(0, "<title", 1);
    如果 (开 < 0)
    {
        返回 假;
    }
    整数 尖 = 网页寻(开, ">", 0);
    如果 (尖 < 0)
    {
        返回 假;
    }
    整数 起 = 尖 + 1;
    整数 止 = 网页寻(起, "</title", 1);
    如果 (止 < 0)
    {
        止 = 网页区长;
    }
    字符串 原样 = 网页区取段(起, 止);
    字符串 本地 = 网页解实体(原样);
    标题 = 本地;
    返回 真;
}

// ---------- 私有:区里 `起` 那个标签是不是"块级 / 换行"那一档 ----------
//   (`br` `p` `div` `li` `tr` `hr` `h1`~`h6`;开头那个 `/` 是闭合标签,一样算。)
私有 方法 网页是断行(整数 起) 返回 逻辑
{
    如果 (网页区[起] == 47)
    {
        起 = 起 + 1;
    }
    如果 (网页同(起, "br"))
    {
        返回 真;
    }
    如果 (网页同(起, "p"))
    {
        返回 真;
    }
    如果 (网页同(起, "div"))
    {
        返回 真;
    }
    如果 (网页同(起, "li"))
    {
        返回 真;
    }
    如果 (网页同(起, "tr"))
    {
        返回 真;
    }
    如果 (网页同(起, "hr"))
    {
        返回 真;
    }
    如果 (网页同(起, "h1"))
    {
        返回 真;
    }
    如果 (网页同(起, "h2"))
    {
        返回 真;
    }
    如果 (网页同(起, "h3"))
    {
        返回 真;
    }
    如果 (网页同(起, "h4"))
    {
        返回 真;
    }
    如果 (网页同(起, "h5"))
    {
        返回 真;
    }
    如果 (网页同(起, "h6"))
    {
        返回 真;
    }
    返回 假;
}

// 去掉标签拿纯文本:标签整段丢掉,块级标签(`br` / `p` / `div` / `li` / `tr` / `hr` / `h1`~`h6`)
// 变成一个换行(`\r` 丢掉,连着几个换行只留一个),`<script>` / `<style>` 的内容与 `<!-- -->` 注释整段跳过,
// 最后把实体解开。
方法 去标签(字符串 页面, 字符串 出 文本) 返回 逻辑
{
    文本 = "";
    如果 (!网页装区(页面))
    {
        返回 假;
    }
    字符串 粗 = "";
    整数 i = 0;
    整数 刚换行 = 0;
    当 (i < 网页区长)
    {
        如果 (网页区[i] != 60)                         // 不是 '<':原样搬一个字节
        {
            如果 (网页区[i] != 13)
            {
                拼接到(粗, 网页区[i]);
            }
            如果 (!网页是空白(网页区[i]))
            {
                刚换行 = 0;
            }
            i = i + 1;
            继续;
        }
        如果 (网页同(i + 1, "!--"))                    // 注释:整段跳过
        {
            整数 完 = 网页寻(i + 4, "-->", 0);
            如果 (完 < 0)
            {
                跳出;
            }
            i = 完 + 3;
            继续;
        }
        如果 (网页同(i + 1, "script") || 网页同(i + 1, "style"))
        {
            整数 尾 = 网页寻(i + 1, "</script", 1);
            如果 (网页同(i + 1, "style"))
            {
                尾 = 网页寻(i + 1, "</style", 1);
            }
            如果 (尾 < 0)
            {
                跳出;
            }
            整数 尖 = 网页寻(尾, ">", 0);
            如果 (尖 < 0)
            {
                跳出;
            }
            i = 尖 + 1;
            继续;
        }
        整数 止 = 网页寻(i + 1, ">", 0);               // 普通标签:整段丢掉
        如果 (止 < 0)
        {
            跳出;
        }
        如果 (网页是断行(i + 1) && 刚换行 == 0)
        {
            拼接到(粗, '\n');
            刚换行 = 1;
        }
        i = 止 + 1;
    }
    字符串 本地 = 网页解实体(粗);
    文本 = 本地;
    返回 真;
}

// ---------- 私有:键从 `键起` 那一位开始找一个值;找到之后两头住在 网页值起 / 网页值止 ----------
//   值的三种写法都认:双引号里 · 单引号里 · 不带引号(到空白或 `>` 为止)。
私有 方法 网页取值(整数 键止, 整数 标签止) 返回 逻辑
{
    网页值起 = 0;
    网页值止 = 0;
    整数 i = 键止;
    当 (i < 标签止 && 网页是空白(网页区[i]))
    {
        i = i + 1;
    }
    如果 (i >= 标签止 || 网页区[i] != 61)              // '='
    {
        返回 假;
    }
    i = i + 1;
    当 (i < 标签止 && 网页是空白(网页区[i]))
    {
        i = i + 1;
    }
    如果 (i >= 标签止)
    {
        返回 假;
    }
    整数 引 = 网页区[i];
    如果 (引 == 34 || 引 == 39)
    {
        i = i + 1;
        网页值起 = i;
        当 (i < 标签止 && 网页区[i] != 引)
        {
            i = i + 1;
        }
        网页值止 = i;
        返回 网页值止 > 网页值起;
    }
    网页值起 = i;
    当 (i < 标签止 && !网页是空白(网页区[i]) && 网页区[i] != 62)
    {
        i = i + 1;
    }
    网页值止 = i;
    返回 网页值止 > 网页值起;
}

// 从 `起` 那一位往后找**第一个** `<a href=…>` 的地址(实体已解开),写进你那一格。
// `下一起` 交出来的是"接着往下找"的位置(从 0 起一条条走完整个页面就靠它)。
// 找不着给假,`下一起` 原样交回 `起`。
方法 取链接(字符串 页面, 整数 起, 字符串 出 地址串, 引用 整数 下一起) 返回 逻辑
{
    地址串 = "";
    如果 (起 < 0)
    {
        起 = 0;
    }
    下一起 = 起;
    如果 (!网页装区(页面))
    {
        返回 假;
    }
    整数 位 = 起;
    当 (真)
    {
        整数 标签起 = 网页寻(位, "<a", 1);
        如果 (标签起 < 0)
        {
            返回 假;
        }
        整数 标签止 = 网页寻(标签起, ">", 0);
        如果 (标签止 < 0)
        {
            返回 假;
        }
        整数 属性位 = 网页寻(标签起, "href", 1);
        如果 (属性位 >= 0 && 属性位 < 标签止 && 网页取值(属性位 + 4, 标签止))
        {
            字符串 原样 = 网页区取段(网页值起, 网页值止);
            字符串 本地 = 网页解实体(原样);
            地址串 = 本地;
            下一起 = 网页值止;
            返回 真;
        }
        位 = 标签止 + 1;
    }
    返回 假;
}

// 从 `起` 那一位往后找**第一个** `属性名="值"`(键名不分大小写,前后必须自成一段 ——
// `data-href` 里的那个 `href` 不算),值写进你那一格(实体已解开),`下一起` 交出来接着找的位置。
方法 取属性(字符串 页面, 整数 起, 字符串 属性名, 字符串 出 值, 引用 整数 下一起) 返回 逻辑
{
    值 = "";
    如果 (起 < 0)
    {
        起 = 0;
    }
    下一起 = 起;
    如果 (!网页装区(页面))
    {
        返回 假;
    }
    整数 键长 = 属性名.长度();
    如果 (键长 <= 0 || 键长 > 32)
    {
        返回 假;
    }
    整数 位 = 起;
    当 (真)
    {
        整数 属性位 = 网页寻(位, 属性名, 1);
        如果 (属性位 < 0)
        {
            返回 假;
        }
        逻辑 边界好 = 真;
        如果 (属性位 > 0 && 网页是名字字符(网页区[属性位 - 1]))
        {
            边界好 = 假;
        }
        如果 (边界好 && 网页取值(属性位 + 键长, 网页区长))
        {
            字符串 原样 = 网页区取段(网页值起, 网页值止);
            字符串 本地 = 网页解实体(原样);
            值 = 本地;
            下一起 = 网页值止;
            返回 真;
        }
        位 = 属性位 + 1;
    }
    返回 假;
}

// ============================================================
// 五点五、拆表格(`<table>` → 行 / 格)
// ============================================================

// ---------- 私有:区里 `起` 那一位起是不是标签名 `名`,而且名字后面紧跟边界(空白 / `>` / `/`) ----------
//   `网页同` 只比名字、不管后面跟什么 ⇒ `<thead` 会被 `<th` 比中、`<track` 会被 `<tr` 比中。
//   表格这一档全靠"名字后面的那一个字节"把标签分开,所以这里补这一道。
私有 方法 网页标签同(整数 起, 字符串 名) 返回 逻辑
{
    如果 (!网页同(起, 名))
    {
        返回 假;
    }
    整数 后 = 起 + 名.长度();
    如果 (后 >= 网页区长)
    {
        返回 真;                        // 名字正好顶到区尾:也算(页面就截在这儿了)
    }
    整数 码 = 网页区[后];
    如果 (网页是空白(码) || 码 == 62 || 码 == 47)
    {
        返回 真;                        // 空白 / `>` / `/`
    }
    返回 假;
}

// ---------- 私有:从 `起` 往 `止` 找 `<名`(名字要自成一段),找着给 `<` 的下标 ----------
私有 方法 网页找标签(整数 起, 整数 止, 字符串 名) 返回 整数
{
    整数 位 = 起;
    当 (位 < 止)
    {
        整数 尖 = 网页寻(位, "<", 0);
        如果 (尖 < 0 || 尖 >= 止)
        {
            返回 0 - 1;
        }
        如果 (尖 + 1 < 网页区长 && 网页标签同(尖 + 1, 名))
        {
            返回 尖;
        }
        位 = 尖 + 1;
    }
    返回 0 - 1;
}

// ---------- 私有:从 `起` 往 `止` 找 `</名`,找着给 `<` 的下标(没找着给 -1) ----------
私有 方法 网页找收尾(整数 起, 整数 止, 字符串 名) 返回 整数
{
    整数 位 = 起;
    当 (位 < 止)
    {
        整数 尖 = 网页寻(位, "</", 0);
        如果 (尖 < 0 || 尖 >= 止)
        {
            返回 0 - 1;
        }
        如果 (尖 + 2 < 网页区长 && 网页标签同(尖 + 2, 名))
        {
            返回 尖;
        }
        位 = 尖 + 2;
    }
    返回 0 - 1;
}

// ---------- 私有:从 `起` 往 `止` 找下一个**格的开始标签**(`<td` / `<th`,谁在前给谁) ----------
私有 方法 网页找格(整数 起, 整数 止) 返回 整数
{
    整数 数据格 = 网页找标签(起, 止, "td");
    整数 表头格 = 网页找标签(起, 止, "th");
    如果 (数据格 < 0)
    {
        返回 表头格;
    }
    如果 (表头格 < 0)
    {
        返回 数据格;
    }
    如果 (表头格 < 数据格)
    {
        返回 表头格;
    }
    返回 数据格;
}

// ---------- 私有:一格的文本(区里 [起, 止) 这一段):内层标签整段跳过、实体解开、两头空白去掉 ----------
//   与 `去标签` 是同一件事,区别只在作用范围 —— `去标签` 走整页,这一条走"区里的一段"(一格就住在一段里)。
私有 方法 网页区取文(整数 起, 整数 止) 返回 字符串
{
    当 (起 < 止 && 网页是空白(网页区[起]))
    {
        起 = 起 + 1;
    }
    当 (止 > 起 && 网页是空白(网页区[止 - 1]))
    {
        止 = 止 - 1;
    }
    字符串 段 = "";
    整数 i = 起;
    当 (i < 止)
    {
        如果 (网页区[i] == 60)                  // '<':一整段标签跳过去
        {
            整数 尖 = i + 1;
            当 (尖 < 止 && 网页区[尖] != 62)    // '>'
            {
                尖 = 尖 + 1;
            }
            i = 尖 + 1;
        }
        否则
        {
            如果 (网页区[i] == 38)              // '&':实体那一小段原样搬走,交给 `网页解实体`
            {
                整数 分 = i + 1;
                当 (分 < 止 && 网页区[分] != 59 && 分 - i <= 12)     // ';'
                {
                    分 = 分 + 1;
                }
                如果 (分 < 止 && 网页区[分] == 59)
                {
                    整数 k = i;
                    当 (k <= 分)
                    {
                        拼接到(段, 网页区[k]);      // 逐字节搬(不拿"返回串的调用"当实参:H84 那条漏)
                        k = k + 1;
                    }
                    i = 分 + 1;
                }
                否则
                {
                    拼接到(段, 网页区[i]);          // 认不出的 `&` 原样留着(与 `网页解实体` 同一条)
                    i = i + 1;
                }
            }
            否则
            {
                拼接到(段, 网页区[i]);
                i = i + 1;
            }
        }
    }
    字符串 本地 = 网页解实体(段);
    返回 本地;
}

// 从 `起` 那一位往后找**第一个** `<table>…</table>`,把它里面的行 / 格抠进模块状态;
// `下一起` 交出来"接着往下找"的位置(`</table>` 之后)。找不着给假、`下一起` 原样交回 `起`。
//
// 抠出来之后用这三个问(与 `Markdown.hb` 的表那一档**同一个问法**,换的是数据来源):
//   表行数() 返回 整数                  这一张表有几行
//   行格数(行) 返回 整数                第 `行` 行有几格(越界给 0)
//   格文本(行, 列, 出 文本) 返回 逻辑   把那一格的文本写进你那一格(越界给假)
//
// 认法(只认这么多,多的一条都不猜 —— 猜出来的表比没有表更难查):
//   · `<tr>…</tr>` 那一档算**一行**;`<td>` / `<th>` 那一档算**一格**(列头与数据格一样对待);
//   · 一格的文本 = 那一格自己的开闭标签**之间**那一段(内层标签整段跳过、实体解开、两头空白去掉);
//   · **上限 64 行 / 256 格**:超了给假、并把这一次的结果清空(**不截断**);
//   · 没有 `</table>` 收尾 ⇒ 不当成一张表(不猜"到页面末尾为止");表里再套表**不认**;
//   · ⚠ 与 `取链接` 同一条口径:**一次一张表** —— 抠出来的格住在区里,下一次调 `网页.*`
//     会把区换掉 ⇒ 要留下的格**当场用掉**(见 `Sample\中间层\示例54_网络与网页`)。
方法 取表格(字符串 页面, 整数 起, 引用 整数 下一起) 返回 逻辑
{
    网页表行数 = 0;
    网页表总格 = 0;
    如果 (起 < 0)
    {
        起 = 0;
    }
    下一起 = 起;
    如果 (!网页装区(页面))
    {
        返回 假;
    }
    整数 表头 = 网页找标签(起, 网页区长, "table");
    如果 (表头 < 0)
    {
        返回 假;
    }
    整数 表头止 = 网页寻(表头, ">", 0);
    如果 (表头止 < 0)
    {
        返回 假;
    }
    整数 表尾 = 网页找收尾(表头止 + 1, 网页区长, "table");
    如果 (表尾 < 0)
    {
        返回 假;
    }
    整数 位 = 表头止 + 1;
    当 (位 < 表尾)
    {
        整数 行头 = 网页找标签(位, 表尾, "tr");
        如果 (行头 < 0)
        {
            跳出;
        }
        如果 (网页表行数 >= 64)
        {
            网页表行数 = 0;
            网页表总格 = 0;
            返回 假;                        // 行太多:不截断(给假,让调用方知道"这一张没抠出来")
        }
        整数 行头止 = 网页寻(行头, ">", 0);
        如果 (行头止 < 0 || 行头止 >= 表尾)
        {
            跳出;
        }
        整数 行尾 = 网页找收尾(行头止 + 1, 表尾, "tr");
        如果 (行尾 < 0)
        {
            行尾 = 表尾;
        }
        整数 本行首格 = 网页表总格;
        整数 本行格数 = 0;
        整数 针 = 行头止 + 1;
        当 (针 < 行尾)
        {
            整数 格头 = 网页找格(针, 行尾);
            如果 (格头 < 0)
            {
                跳出;
            }
            如果 (网页表总格 >= 256)
            {
                网页表行数 = 0;
                网页表总格 = 0;
                返回 假;                    // 格太多:同上
            }
            整数 格头止 = 网页寻(格头, ">", 0);
            如果 (格头止 < 0 || 格头止 >= 行尾)
            {
                跳出;
            }
            整数 格尾 = 网页找收尾(格头止 + 1, 行尾, "td");
            如果 (格尾 < 0)
            {
                格尾 = 网页找收尾(格头止 + 1, 行尾, "th");
            }
            如果 (格尾 < 0)
            {
                格尾 = 行尾;                // 没写收尾标签:到这一行为止(如实,不猜下一格在哪)
            }
            网页表格起[网页表总格] = 格头止 + 1;
            网页表格止[网页表总格] = 格尾;
            网页表总格 = 网页表总格 + 1;
            本行格数 = 本行格数 + 1;
            针 = 格尾;
        }
        网页表行首格[网页表行数] = 本行首格;
        网页表行格数[网页表行数] = 本行格数;
        网页表行数 = 网页表行数 + 1;
        位 = 行尾;
    }
    如果 (网页表行数 == 0)
    {
        返回 假;
    }
    下一起 = 表尾;
    返回 真;
}

// 这一张表有几行(还没 `取表格` 过 / 那一张没抠出来 = 0)
方法 表行数() 返回 整数
{
    返回 网页表行数;
}

// 第 `行` 行有几格(行号从 0 起;越界给 0)
方法 行格数(整数 行) 返回 整数
{
    如果 (行 < 0 || 行 >= 网页表行数)
    {
        返回 0;
    }
    返回 网页表行格数[行];
}

// 第 `行` 行第 `列` 格的文本(都从 0 起;越界给假、那一格给空串)。
// 段里嵌的标签整段跳过(`<td><b>正文</b></td>` 读出来是 `正文`),实体已解开。
方法 格文本(整数 行, 整数 列, 字符串 出 文本) 返回 逻辑
{
    文本 = "";
    如果 (行 < 0 || 行 >= 网页表行数)
    {
        返回 假;
    }
    如果 (列 < 0 || 列 >= 网页表行格数[行])
    {
        返回 假;
    }
    整数 格 = 网页表行首格[行] + 列;
    字符串 本地 = 网页区取文(网页表格起[格], 网页表格止[格]);
    文本 = 本地;
    返回 真;
}

// ============================================================
// 6、拆 HTTP 应答(自己在裸 TCP 上说话时用得上)
// ============================================================

// ---------- 私有:状态行里那个状态码(`HTTP/1.1 200 OK` 里第一个空格之后那几位数字) ----------
//   单拎出来是因为一帧只有 96 字节,`解应答` 放不下这么多中间量。
私有 方法 网页解状态行() 返回 整数
{
    整数 空 = 网页寻(0, " ", 0);
    如果 (空 < 0)
    {
        返回 0;
    }
    整数 i = 空 + 1;
    整数 数 = 0;
    整数 位 = 0;
    当 (i < 网页区长)
    {
        整数 码 = 网页区[i];
        如果 (码 < 48 || 码 > 57)
        {
            跳出;
        }
        数 = 数 * 10 + (码 - 48);
        位 = 位 + 1;
        i = i + 1;
    }
    如果 (位 == 0)
    {
        返回 0;
    }
    返回 数;
}

// ---------- 私有:空行(头与正文的分界)在哪一位;隔开几个字节记在 网页隔 ----------
//   空行认 `\r\n\r\n` 与 `\n\n` 两种,谁在前面认谁。
私有 方法 网页空行() 返回 整数
{
    整数 回车位 = 网页寻(0, "\r\n\r\n", 0);
    整数 换行位 = 网页寻(0, "\n\n", 0);
    网页隔 = 4;
    如果 (回车位 < 0 || (换行位 >= 0 && 换行位 < 回车位))
    {
        回车位 = 换行位;
        网页隔 = 2;
    }
    返回 回车位;
}

// 一条完整的 HTTP 应答拆成三段:`状态码`(整数)/ `头`(状态行之后到空行之前的原文)/ `正文`(空行之后)。
// 空行认 `\r\n\r\n` 与 `\n\n` 两种;分块传输(chunked)那种正文**原样交出来**,不还原。
方法 解应答(字符串 应答, 引用 整数 状态码, 字符串 出 头, 字符串 出 正文)
{
    状态码 = 0;
    头 = "";
    正文 = "";
    如果 (!网页装区(应答))
    {
        返回
    }
    状态码 = 网页解状态行();
    整数 空行位 = 网页空行();
    如果 (空行位 < 0)
    {
        返回
    }
    整数 行止 = 网页寻(0, "\n", 0);
    字符串 本一 = 网页区取段(行止 + 1, 空行位);
    头 = 本一;
    字符串 本二 = 网页区取段(空行位 + 网页隔, 网页区长);
    正文 = 本二;
    返回
}
