// ============================================================
// int64.hb —— 64 位【无符号】整数库(纯软件:不动 ISA、不加类型、不加关键字)
//
// 表示:结构 u长整数 = 4 个 16 位半区,半区0 最低 … 半区3 最高。字段用 `整数`(32 位)存"已经 & 65535 的
//   半区"(窄字段读回来会补符号位);范围:**0 ~ 18446744073709551615**(2^64-1),最高位不是符号位。
//
// 与 int64s.hb 的关系:那个是 64 位【有符号】(补码),本库是**无符号**;比较 / 打印 / 解析全按无符号口径
//   (`18446744073709551615 > 0` 为真)。两个库可以同时 包含:`u长整数` 与 `长整数` 是两个结构,函数名也不同。
//
// 传参规矩(与 int64s.hb 同一套):HB 的结构参数**按地址传**,实参只能是 变量 / 字段 / 数组元素,不能是表达式
//   ⇒ `u长整数乘(左, u长整数加(右, 减数))` 是错的,要先 `u长整数 t = u长整数加(右, 减数);` 再
//   `u长整数乘(左, t)`。
//
// 提供(全部按"结构整体传"):
//   u长整数加 / 减 / 乘(u长整数, u长整数) → u长整数(超出就回绕 = 只留低 64 位)
//   u长整数比较(左, 右) → -1(左小)/ 0(相等)/ 1(左大),**无符号**;相等 / 小于 / 小于等于 / 大于 / 大于等于 → 逻辑
//   u长整数转字符串(值) → 十进制字符串(0 就是 "0";最大打得出 18446744073709551615)
//   字符串转u长整数(文本) → u长整数(可带前导 '+';空串 / 非法字符 / 超出 2^64-1 **返回 0**,不报错)
//   造u长整数(半区0, 半区1, 半区2, 半区3)(每个只取低 16 位)/ u长整数零 / u长整数最大(2^64-1)
//   位运算:u长整数与 / 或 / 异或(左, 右)(四个半区各做一次);u长整数取反(值)(整体效果 = 2^64-1 - 值)
//   u长整数左移 / 右移(值, 位数) → u长整数(逻辑移位,空位补 0):**位数 0 及以下 → 原样,64 及以上 → 全 0,
//     不按 32 / 64 取模**
//
// 用法:
// ```
// 包含 "../库/int64.hb"
// ```
//
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 64 位无符号整数 = 四个 32 位半区(半区3 最高、半区0 最低)
结构 u长整数
{
    整数 半区0;
    整数 半区1;
    整数 半区2;
    整数 半区3;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 1、加 / 减 / 乘:16 位半区逐级进位(最高半区的进位丢掉 = 回绕)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// a + b
方法 u长整数加(u长整数 左, u长整数 右) 返回 u长整数
{
    u长整数 u长整数加果;
    u长整数加果.半区0 = 左.半区0 + 右.半区0;
    u长整数加果.半区1 = 左.半区1 + 右.半区1;
    u长整数加果.半区2 = 左.半区2 + 右.半区2;
    u长整数加果.半区3 = 左.半区3 + 右.半区3;
    如果 (u长整数加果.半区0 > 65535)
    {
        // 第 1 段溢出 → 第 2 段加一
        u长整数加果.半区1 = u长整数加果.半区1 + 1;
    }
    如果 (u长整数加果.半区1 > 65535)
    {
        // 第 2 段(含进位)溢出 → 第 3 段加一
        u长整数加果.半区2 = u长整数加果.半区2 + 1;
    }
    如果 (u长整数加果.半区2 > 65535)
    {
        // 第 3 段溢出 → 第 4 段加一
        u长整数加果.半区3 = u长整数加果.半区3 + 1;
    }
    u长整数加果.半区0 = u长整数加果.半区0 & 65535;
    u长整数加果.半区1 = u长整数加果.半区1 & 65535;
    u长整数加果.半区2 = u长整数加果.半区2 & 65535;
    u长整数加果.半区3 = u长整数加果.半区3 & 65535;
    返回 u长整数加果;
}

// a - b(不够减则逐级借位;0 - 1 回绕成 2^64-1,无符号就该这样)
方法 u长整数减(u长整数 左, u长整数 右) 返回 u长整数
{
    u长整数 u长整数减果;
    u长整数减果.半区0 = 左.半区0 - 右.半区0;   // 负 = 这一段要向下借位
    u长整数减果.半区1 = 左.半区1 - 右.半区1;
    u长整数减果.半区2 = 左.半区2 - 右.半区2;
    u长整数减果.半区3 = 左.半区3 - 右.半区3;
    如果 (u长整数减果.半区0 < 0)
    {
        u长整数减果.半区1 = u长整数减果.半区1 - 1;
    }
    如果 (u长整数减果.半区1 < 0)
    {
        u长整数减果.半区2 = u长整数减果.半区2 - 1;
    }
    如果 (u长整数减果.半区2 < 0)
    {
        u长整数减果.半区3 = u长整数减果.半区3 - 1;
    }
    u长整数减果.半区0 = u长整数减果.半区0 & 65535;
    u长整数减果.半区1 = u长整数减果.半区1 & 65535;
    u长整数减果.半区2 = u长整数减果.半区2 & 65535;
    u长整数减果.半区3 = u长整数减果.半区3 & 65535;
    返回 u长整数减果;
}

// a × b,只留低 64 位 —— 逐位"移位累加"(64 轮)。
// 不追求速度:16 位半区竖式乘法的累加器要 8 个半区(32 字节)+ 两组四半区,帧里放不下,
// 这里改成"被乘数每轮左移一位、按乘数第 i 位决定加不加"(与 int64s.hb 的 长整数乘 同源)。
方法 u长整数乘(u长整数 左, u长整数 右) 返回 u长整数
{
    u长整数 u长整数乘积;
    u长整数乘积.半区0 = 0;
    u长整数乘积.半区1 = 0;
    u长整数乘积.半区2 = 0;
    u长整数乘积.半区3 = 0;
    u长整数 u长整数乘被;
    u长整数乘被.半区0 = 左.半区0;
    u长整数乘被.半区1 = 左.半区1;
    u长整数乘被.半区2 = 左.半区2;
    u长整数乘被.半区3 = 左.半区3;
    整数 u长整数乘i = 0;
    当 (u长整数乘i < 64)
    {
        整数 u长整数乘半号 = u长整数乘i >> 4;          // 乘数第 i 位落在哪个半区
        整数 u长整数乘位号 = u长整数乘i & 15;
        整数 u长整数乘该半 = 右.半区0;
        如果 (u长整数乘半号 == 1)
        {
            u长整数乘该半 = 右.半区1;
        }
        如果 (u长整数乘半号 == 2)
        {
            u长整数乘该半 = 右.半区2;
        }
        如果 (u长整数乘半号 == 3)
        {
            u长整数乘该半 = 右.半区3;
        }
        整数 u长整数乘位值 = (u长整数乘该半 >> u长整数乘位号) & 1;
        如果 (u长整数乘位值 != 0)
        {
            u长整数乘积.半区0 = u长整数乘积.半区0 + u长整数乘被.半区0;
            u长整数乘积.半区1 = u长整数乘积.半区1 + u长整数乘被.半区1;
            u长整数乘积.半区2 = u长整数乘积.半区2 + u长整数乘被.半区2;
            u长整数乘积.半区3 = u长整数乘积.半区3 + u长整数乘被.半区3;
            如果 (u长整数乘积.半区0 > 65535)
            {
                u长整数乘积.半区1 = u长整数乘积.半区1 + 1;
            }
            如果 (u长整数乘积.半区1 > 65535)
            {
                u长整数乘积.半区2 = u长整数乘积.半区2 + 1;
            }
            如果 (u长整数乘积.半区2 > 65535)
            {
                u长整数乘积.半区3 = u长整数乘积.半区3 + 1;
            }
            u长整数乘积.半区0 = u长整数乘积.半区0 & 65535;
            u长整数乘积.半区1 = u长整数乘积.半区1 & 65535;
            u长整数乘积.半区2 = u长整数乘积.半区2 & 65535;
            u长整数乘积.半区3 = u长整数乘积.半区3 & 65535;
        }
        u长整数乘被.半区3 = ((u长整数乘被.半区3 << 1) | (u长整数乘被.半区2 >> 15)) & 65535;   // 被乘数左移一位
        u长整数乘被.半区2 = ((u长整数乘被.半区2 << 1) | (u长整数乘被.半区1 >> 15)) & 65535;
        u长整数乘被.半区1 = ((u长整数乘被.半区1 << 1) | (u长整数乘被.半区0 >> 15)) & 65535;
        u长整数乘被.半区0 = (u长整数乘被.半区0 << 1) & 65535;
        u长整数乘i = u长整数乘i + 1;
    }
    返回 u长整数乘积;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 2、比较(**无符号**:先比最高半区,一路往下;没有符号位这回事)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// a ? b:-1 / 0 / 1
方法 u长整数比较(u长整数 左, u长整数 右) 返回 整数
{
    整数 u长整数比较左 = 左.半区3;
    整数 u长整数比较右 = 右.半区3;
    如果 (u长整数比较左 != u长整数比较右)
    {
        如果 (u长整数比较左 < u长整数比较右)
        {
            返回 -1;
        }
        返回 1;
    }
    u长整数比较左 = 左.半区2;
    u长整数比较右 = 右.半区2;
    如果 (u长整数比较左 != u长整数比较右)
    {
        如果 (u长整数比较左 < u长整数比较右)
        {
            返回 -1;
        }
        返回 1;
    }
    u长整数比较左 = 左.半区1;
    u长整数比较右 = 右.半区1;
    如果 (u长整数比较左 != u长整数比较右)
    {
        如果 (u长整数比较左 < u长整数比较右)
        {
            返回 -1;
        }
        返回 1;
    }
    u长整数比较左 = 左.半区0;
    u长整数比较右 = 右.半区0;
    如果 (u长整数比较左 != u长整数比较右)
    {
        如果 (u长整数比较左 < u长整数比较右)
        {
            返回 -1;
        }
        返回 1;
    }
    返回 0;
}

// 五个关系比较:直接拿 `u长整数比较` 的结果比(它给 -1 / 0 / 1),不用先落局部
方法 u长整数相等(u长整数 左, u长整数 右) 返回 逻辑
{
    返回 u长整数比较(左, 右) == 0;
}
// 无符号 64 位整数比大小:左 < 右 给真。
方法 u长整数小于(u长整数 左, u长整数 右) 返回 逻辑
{
    返回 u长整数比较(左, 右) < 0;
}
// 无符号 64 位整数比大小:左 ≤ 右 给真。
方法 u长整数小于等于(u长整数 左, u长整数 右) 返回 逻辑
{
    返回 u长整数比较(左, 右) <= 0;
}
// 无符号 64 位整数比大小:左 > 右 给真。
方法 u长整数大于(u长整数 左, u长整数 右) 返回 逻辑
{
    返回 u长整数比较(左, 右) > 0;
}
// 无符号 64 位整数比大小:左 ≥ 右 给真。
方法 u长整数大于等于(u长整数 左, u长整数 右) 返回 逻辑
{
    返回 u长整数比较(左, 右) >= 0;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 3、十进制打印与解析
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 4 个半区(无符号 64 位,值 = 2^48·a3 + 2^32·a2 + 2^16·a1 + a0)→ 十进制文字。
// 竖式除以 10:从最高半区往最低半区走,余数带进下一个半区。0 → "0"。
// 注:本库没有 `模块` 头(整库是平铺的),而 `私有` 只许写在 `模块` 里 ⇒ 这个帮手**只能是公开的**;
// 名字带 `int64` 前缀是为了"两个库同时 包含 时不撞"(与 int64s.hb 的 `长整数半区转字符串` 同一套命名)。
方法 int64半区转字符串(无符号整数 半区0, 无符号整数 半区1, 无符号整数 半区2, 无符号整数 半区3) 返回 字符串
{
    无符号整数 int64半区转半[4];
    int64半区转半[0] = 半区0;
    int64半区转半[1] = 半区1;
    int64半区转半[2] = 半区2;
    int64半区转半[3] = 半区3;
    字符 int64半区转倒[20];                      // 2^64-1 是 20 位十进制
    整数 int64半区转个 = 0;
    当 (int64半区转半[0] != 0 || int64半区转半[1] != 0 || int64半区转半[2] != 0 || int64半区转半[3] != 0)
    {
        无符号整数 int64半区转余 = 0;
        整数 int64半区转k = 3;
        当 (int64半区转k >= 0)
        {
            无符号整数 int64半区转部 = (int64半区转余 << 16) | int64半区转半[int64半区转k];
            int64半区转半[int64半区转k] = int64半区转部 / 10;
            int64半区转余 = int64半区转部 % 10;
            int64半区转k = int64半区转k - 1;
        }
        int64半区转倒[int64半区转个] = int64半区转余 + '0';
        int64半区转个 = int64半区转个 + 1;
    }
    字符串 int64半区转果 = "";
    如果 (int64半区转个 == 0)
    {
        拼接到(int64半区转果, '0');
    }
    整数 int64半区转i = int64半区转个 - 1;
    当 (int64半区转i >= 0)
    {
        拼接到(int64半区转果, int64半区转倒[int64半区转i]);
        int64半区转i = int64半区转i - 1;
    }
    返回 int64半区转果;
}

// a 的十进制文字(无符号:没有负号这回事)
方法 u长整数转字符串(u长整数 值) 返回 字符串
{
    返回 int64半区转字符串(值.半区0, 值.半区1, 值.半区2, 值.半区3);
}

// 十进制文字 → u长整数(无符号)。可带前导 '+'。
// 约定(与 int64s.hb 的 字符串转长整数 同一套):空串 / 非法字符 / 超出 2^64-1 **返回 0**(不报错);
// 前导 '-' 当非法 —— 无符号不表示负数(想要有符号就用 `库\int64s.hb`)。
方法 字符串转u长整数(字符串 文本) 返回 u长整数
{
    u长整数 字符串转u长整数果;
    字符串转u长整数果.半区0 = 0;
    字符串转u长整数果.半区1 = 0;
    字符串转u长整数果.半区2 = 0;
    字符串转u长整数果.半区3 = 0;
    整数 字符串转u长整数长 = 文本.长度();
    整数 字符串转u长整数位 = 0;
    逻辑 字符串转u长整数越 = 假;
    逻辑 字符串转u长整数有 = 假;
    如果 (字符串转u长整数长 > 0)
    {
        如果 (文本[0] == '+')
        {
            字符串转u长整数位 = 1;
        }
    }
    当 (字符串转u长整数位 < 字符串转u长整数长)
    {
        文字 字符串转u长整数字 = 文本[字符串转u长整数位];
        整数 字符串转u长整数码 = 字符串转u长整数字;
        如果 (字符串转u长整数码 < 48 || 字符串转u长整数码 > 57)
        {
            字符串转u长整数越 = 真;
            跳出;
        }
        字符串转u长整数有 = 真;
        整数 字符串转u长整数c = 字符串转u长整数果.半区0 * 10 + (字符串转u长整数码 - 48);
        字符串转u长整数果.半区0 = 字符串转u长整数c & 65535;
        字符串转u长整数c = 字符串转u长整数c >> 16;
        字符串转u长整数c = 字符串转u长整数果.半区1 * 10 + 字符串转u长整数c;
        字符串转u长整数果.半区1 = 字符串转u长整数c & 65535;
        字符串转u长整数c = 字符串转u长整数c >> 16;
        字符串转u长整数c = 字符串转u长整数果.半区2 * 10 + 字符串转u长整数c;
        字符串转u长整数果.半区2 = 字符串转u长整数c & 65535;
        字符串转u长整数c = 字符串转u长整数c >> 16;
        字符串转u长整数c = 字符串转u长整数果.半区3 * 10 + 字符串转u长整数c;
        字符串转u长整数果.半区3 = 字符串转u长整数c & 65535;
        字符串转u长整数c = 字符串转u长整数c >> 16;
        如果 (字符串转u长整数c != 0)
        {
            // 第 4 段还有进位 = 超过 2^64-1
            字符串转u长整数越 = 真;
        }
        字符串转u长整数位 = 字符串转u长整数位 + 1;
    }
    如果 (!字符串转u长整数有)
    {
        字符串转u长整数越 = 真;
    }
    如果 (字符串转u长整数越)
    {
        字符串转u长整数果.半区0 = 0;
        字符串转u长整数果.半区1 = 0;
        字符串转u长整数果.半区2 = 0;
        字符串转u长整数果.半区3 = 0;
        返回 字符串转u长整数果;
    }
    返回 字符串转u长整数果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 4、常用值 / 打包
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 从 4 个半区打包一个 u长整数(每个只取低 16 位)—— 写常量或边界测试时不用每次从字符串解析。
// 例:`造u长整数(65535, 0, 0, 0)` 就是 0x0000_0000_0000_FFFF。
方法 造u长整数(整数 半区0, 整数 半区1, 整数 半区2, 整数 半区3) 返回 u长整数
{
    u长整数 造u长整数果;
    造u长整数果.半区0 = 半区0 & 65535;
    造u长整数果.半区1 = 半区1 & 65535;
    造u长整数果.半区2 = 半区2 & 65535;
    造u长整数果.半区3 = 半区3 & 65535;
    返回 造u长整数果;
}

// 值为 0 的 u长整数(四个半区全是 0),当“零”的起点用。
方法 u长整数零() 返回 u长整数
{
    u长整数 u长整数零果;
    u长整数零果.半区0 = 0;
    u长整数零果.半区1 = 0;
    u长整数零果.半区2 = 0;
    u长整数零果.半区3 = 0;
    返回 u长整数零果;
}

// 2^64-1 = 18446744073709551615
方法 u长整数最大() 返回 u长整数
{
    u长整数 u长整数最大果;
    u长整数最大果.半区0 = 65535;
    u长整数最大果.半区1 = 65535;
    u长整数最大果.半区2 = 65535;
    u长整数最大果.半区3 = 65535;
    返回 u长整数最大果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 5、位运算:与 / 或 / 异或 / 取反 / 左移 / 右移
//
// 64 位就是 4 个 16 位半区,逐半区做一遍即可(半区之间没有进位这回事)。
// 移位是**逻辑**移位(空位补 0)—— 无符号数本来就该这样,与有符号的算术右移无关。
// 位数口径见文件头:0 及以下原样返回,64 及以上全 0,不按 32 / 64 取模。
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 左 & 右(逐半区)
方法 u长整数与(u长整数 左, u长整数 右) 返回 u长整数
{
    u长整数 结果;
    结果.半区0 = 左.半区0 & 右.半区0;
    结果.半区1 = 左.半区1 & 右.半区1;
    结果.半区2 = 左.半区2 & 右.半区2;
    结果.半区3 = 左.半区3 & 右.半区3;
    返回 结果;
}

// 左 | 右(逐半区)
方法 u长整数或(u长整数 左, u长整数 右) 返回 u长整数
{
    u长整数 结果;
    结果.半区0 = 左.半区0 | 右.半区0;
    结果.半区1 = 左.半区1 | 右.半区1;
    结果.半区2 = 左.半区2 | 右.半区2;
    结果.半区3 = 左.半区3 | 右.半区3;
    返回 结果;
}

// 左 ^ 右(逐半区)
方法 u长整数异或(u长整数 左, u长整数 右) 返回 u长整数
{
    u长整数 结果;
    结果.半区0 = 左.半区0 ^ 右.半区0;
    结果.半区1 = 左.半区1 ^ 右.半区1;
    结果.半区2 = 左.半区2 ^ 右.半区2;
    结果.半区3 = 左.半区3 ^ 右.半区3;
    返回 结果;
}

// 按位取反:`~` 是 32 位整体取反,`& 65535` 之后才是这个半区的 16 位结果。
// 64 位全取反 = 2^64-1 - 值(同一个值的 `u长整数减(u长整数最大(), 值)` 结果一样,下面自检里对过)。
方法 u长整数取反(u长整数 值) 返回 u长整数
{
    u长整数 结果;
    结果.半区0 = (~值.半区0) & 65535;
    结果.半区1 = (~值.半区1) & 65535;
    结果.半区2 = (~值.半区2) & 65535;
    结果.半区3 = (~值.半区3) & 65535;
    返回 结果;
}

// 值 << 位数(逻辑左移,空位补 0)
方法 u长整数左移(u长整数 值, 整数 位数) 返回 u长整数
{
    u长整数 结果;
    整数 i;
    结果.半区0 = 值.半区0;
    结果.半区1 = 值.半区1;
    结果.半区2 = 值.半区2;
    结果.半区3 = 值.半区3;
    如果 (位数 <= 0)
    {
        返回 结果;
    }
    如果 (位数 >= 64)
    {
        结果.半区0 = 0;
        结果.半区1 = 0;
        结果.半区2 = 0;
        结果.半区3 = 0;
        返回 结果;
    }
    i = 0;
    当 (i < 位数)
    {
        结果.半区3 = ((结果.半区3 << 1) | (结果.半区2 >> 15)) & 65535;   // 高半区先挪:它要吃掉低半区顶上来的那一位
        结果.半区2 = ((结果.半区2 << 1) | (结果.半区1 >> 15)) & 65535;
        结果.半区1 = ((结果.半区1 << 1) | (结果.半区0 >> 15)) & 65535;
        结果.半区0 = (结果.半区0 << 1) & 65535;
        i = i + 1;
    }
    返回 结果;
}

// 值 >> 位数(逻辑右移,空位补 0 —— 无符号数不补符号位)
方法 u长整数右移(u长整数 值, 整数 位数) 返回 u长整数
{
    u长整数 结果;
    整数 i;
    结果.半区0 = 值.半区0;
    结果.半区1 = 值.半区1;
    结果.半区2 = 值.半区2;
    结果.半区3 = 值.半区3;
    如果 (位数 <= 0)
    {
        返回 结果;
    }
    如果 (位数 >= 64)
    {
        结果.半区0 = 0;
        结果.半区1 = 0;
        结果.半区2 = 0;
        结果.半区3 = 0;
        返回 结果;
    }
    i = 0;
    当 (i < 位数)
    {
        结果.半区0 = ((结果.半区0 >> 1) | ((结果.半区1 & 1) << 15)) & 65535;   // 低半区先挪:它要接住高半区掉下来的那一位
        结果.半区1 = ((结果.半区1 >> 1) | ((结果.半区2 & 1) << 15)) & 65535;
        结果.半区2 = ((结果.半区2 >> 1) | ((结果.半区3 & 1) << 15)) & 65535;
        结果.半区3 = (结果.半区3 >> 1) & 65535;
        i = i + 1;
    }
    返回 结果;
}
