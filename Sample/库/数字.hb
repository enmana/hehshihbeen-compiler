// ============================================================
// 数字.hb —— 数字 ↔ 文字的几个"格式化"档(纯 HB,零依赖)
//
// 用法:包含 "../库/数字.hb";调用写 `数字.千分位(1234567)`。
//
// **不另开 `转字符串`**(那名字归 `string.hb`);这一库管的是"别的进制 / 位数 / 千分位"。
//
// 口径(2026-10):
//   · **进制一律 2~36**:10 以上用大写 `A`~`Z`;进制越界(或 < 2)一律给空串 / 假,不停机;
//   · **负号在最前面**:`-255` 的十六进制是 `-FF`(不是补码);**位数的单位是"文字数"**:`补零(-7, 4)` 给 `-007`(负号也算一位),不够就原样给,不截断;
//   · **`千分位` 每三位一撇**,撇从右边数起;负号不算在分组里(`-1234` → `-1,234`);
//   · **`按进制解析` 认大小写**(`ff` 与 `FF` 一样)与**前导负号**;认不出的字符 / 空串 / 进制越界一律给假并清零;**溢出按 32 位回绕**;
//   · **不报错、不停机**。
//
// 英文对照:按进制转字符串 toBase · 按进制解析 parseBase · 补零 padZero · 千分位 groupThousands
//
// 边界(如实登记):
//   · **`金额大写` 不在这一库**(归 `中文.hb`);**不做小数**(归 `float64.hb`);
//   · **`按进制解析` 不做"容错解析"**:串里有一个字符认不出就整条给假(要"尽量读一段"用 `安全解析整数`);
//   · **36 进制的 `Z` 与大小写无关**;但 `按进制转字符串` 只吐大写。这一库只吃 `整数`。
// 提供的函数(4 个):逐个见下面那张公开方法表。
// 复杂度:都是 O(位数)(十进制最多 11 位、36 进制最多 7 位);空间 O(位数)。
// ============================================================
模块 数字

// ---------- 私有:0~35 → 一个字符('0'~'9' / 'A'~'Z') ----------
私有 方法 数字位符(整数 位) 返回 字符
{
    如果 (位 < 10)
    {
        返回 48 + 位;
    }
    返回 65 + (位 - 10);
}

// ---------- 私有:一个码点 → 0~35(认大小写;认不出给 -1) ----------
私有 方法 数字位值(整数 码) 返回 整数
{
    如果 (码 >= 48 && 码 <= 57)
    {
        返回 码 - 48;
    }
    如果 (码 >= 65 && 码 <= 90)
    {
        返回 码 - 65 + 10;
    }
    如果 (码 >= 97 && 码 <= 122)
    {
        返回 码 - 97 + 10;
    }
    返回 -1;
}

// ---------- 私有:这个码点是不是减号('-') ----------
私有 方法 数字是减号(整数 码) 返回 逻辑
{
    返回 码 == 45;
}

// ---------- 值 → 文字(按进制) ----------

// 数学值 → 2~36 进制文字(负号在前);进制越界给空串。
方法 按进制转字符串(整数 值, 整数 进制) 返回 字符串
{
    如果 (进制 < 2 || 进制 > 36)
    {
        返回 "";
    }
    无符号整数 大 = 值;
    整数 负 = 0;
    如果 (值 < 0)
    {
        大 = 0 - 值;                        // 走无符号:`-2147483648` 也不会回绕
        负 = 1;
    }
    无符号整数 无进制 = 进制;
    字符 位表[40];
    整数 位数 = 0;
    如果 (大 == 0)
    {
        位表[0] = 48;
        位数 = 1;
    }
    当 (大 > 0)
    {
        位表[位数] = 数字位符(大 % 无进制);
        位数 = 位数 + 1;
        大 = 大 / 无进制;
    }
    字符串 结果 = "";
    如果 (负 == 1)
    {
        拼接到(结果, '-');
    }
    整数 k = 位数 - 1;                     // 从最高位往回拼
    当 (k >= 0)
    {
        拼接到(结果, 位表[k]);
        k = k - 1;
    }
    返回 结果;
}

// ---------- 文字 → 值(按进制) ----------

// 文字 → 值(认大小写与前导负号);认不出给假并把 `值` 清零。
方法 按进制解析(字符串 文本, 整数 进制, 引用 整数 值) 返回 逻辑
{
    值 = 0;
    如果 (进制 < 2 || 进制 > 36)
    {
        返回 假;
    }
    整数 个数 = 文本.长度();
    如果 (个数 == 0)
    {
        返回 假;
    }
    整数 起 = 0;
    整数 负 = 0;
    如果 (数字是减号(文本[0]))
    {
        负 = 1;
        起 = 1;
    }
    如果 (起 >= 个数)
    {
        返回 假;                            // 只有一个负号:不算数
    }
    整数 累 = 0;
    整数 i = 起;
    当 (i < 个数)
    {
        整数 位 = 数字位值(文本[i]);
        如果 (位 < 0 || 位 >= 进制)
        {
            值 = 0;
            返回 假;
        }
        累 = 累 * 进制 + 位;                // 溢出按 32 位回绕(见头注释)
        i = i + 1;
    }
    如果 (负 == 1)
    {
        累 = 0 - 累;
    }
    值 = 累;
    返回 真;
}

// ---------- 位数与分组 ----------

// 十进制;不够就在负号后补 '0' 到 `位数` 位(不截断)。
方法 补零(整数 值, 整数 位数) 返回 字符串
{
    字符串 数字部分 = 按进制转字符串(值, 10);
    整数 现有 = 数字部分.长度();
    如果 (位数 <= 现有)
    {
        返回 数字部分;                      // 够了就原样(不截断)
    }
    整数 差 = 位数 - 现有;
    字符串 结果 = "";
    整数 i = 0;
    如果 (值 < 0)
    {
        拼接到(结果, '-');                  // 负号最先,零补在负号后面
        i = 0;
        当 (i < 差)
        {
            拼接到(结果, '0');
            i = i + 1;
        }
        i = 1;                              // 跳过 `数字部分` 的负号
        当 (i < 现有)
        {
            拼接到(结果, 数字部分[i]);
            i = i + 1;
        }
        返回 结果;
    }
    i = 0;
    当 (i < 差)
    {
        拼接到(结果, '0');
        i = i + 1;
    }
    拼接到(结果, 数字部分);
    返回 结果;
}

// 十进制;每三位一撇(负号不参与分组)。
方法 千分位(整数 值) 返回 字符串
{
    字符串 数字部分 = 按进制转字符串(值, 10);
    整数 长 = 数字部分.长度();
    字符串 结果 = "";
    如果 (值 < 0)
    {
        拼接到(结果, '-');                  // 负号不参与分组
    }
    整数 起 = 0;
    如果 (值 < 0)
    {
        起 = 1;
    }
    整数 i = 起;
    当 (i < 长)
    {
        整数 剩 = 长 - i;                  // 从这一位起到末尾一共几位(含这一位)
        如果 (剩 % 3 == 0 && i > 起)        // 正好剩 3 的整数倍 ⇒ 这一位前面该有一撇
        {
            拼接到(结果, ',');
        }
        拼接到(结果, 数字部分[i]);
        i = i + 1;
    }
    返回 结果;
}
