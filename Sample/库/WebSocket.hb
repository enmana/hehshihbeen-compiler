// ============================================================
// WebSocket.hb —— WebSocket 客户端(RFC 6455;纯 HB)
//
// 用法:
// ```
// 包含 "../库/WebSocket.hb";
// 整数 句 = 0;
// 句 = 连到("127.0.0.1", 9222, 句);          // 主机 + 端口要先写进 .hbp 的 `网址` 表
// 字符串 说明 = "";
// 如果 (WebSocket.握手(句, "127.0.0.1", 9222, "/devtools/page/XXXX", 说明))
// {
//     WebSocket.发文本(句, "{\"id\":1,\"method\":\"Runtime.enable\"}");
//     字符串 回话 = "";
//     如果 (WebSocket.收文本(句, 帧块, 65536, 回话)) { 输出行(回话); }
// }
// ```
// 在裸 TCP 上把 WebSocket 客户端那一半做出来:握手(含 `Sec-WebSocket-Accept` 的 SHA-1 校验)+ 帧的收发
//   (掩码 / 长度三档)。当下最要紧的用途是接 Chrome DevTools Protocol(见 `页面调试.hb`)。
//
// ★ 为什么处处都在"块 ↔ 串"之间倒一手:语言里 `字符串` 是**文本**容器 —— `拼接到(串, 字节变量)` 写进去的
//   是**码点**(`字节 200` 存成 `U+0200` 两个字节),`名字[下标]` 读出来的也是**解码后的码点**。⇒ 报文字节
//   一律住**块**里(`申请` 回来的内存,`取字` / `存字` 逐字节读写),过 TCP 走 `发送块` / `接收块`。串与块
//   之间那一手是**真的 UTF-8 编解码**(不是逐字节搬):编出来 / 解回来逐字节同,汉字与 ASCII 一视同仁。
//
// 口径(2026-10;每条都对着实测写):
//   · 只做**客户端**那一半(连出去、掩码发);服务端那一半(接受连接、不掩码)不做;
//   · **分片不做**:收帧时只认 FIN=1 的完整帧;碰上分片给 `假`;
//   · **控制帧不算载荷**:收到 ping 自动回 pong,收到 pong 跳过,收到 close 给 `假`;
//   · 一次收帧要求**整帧不超过 `帧容量`**(超了给 `假`,不静默截断)—— 容量由调用方说了算。
//
// 提供的函数(6 个):握手 / 发文本 / 发字节 / 收一帧 / 收文本 / 关掉;
//   逐条的参数与返回值见本页末尾那张公开方法表。
//
// 英文对照:握手 handshake · 发文本 sendText · 发字节 sendBinary · 收一帧 recvFrame · 收文本 recvText
//
// 复杂度:O(报文字节数)。
//
// 边界(如实登记):
//   · **帧容量是硬上限**:收一帧要整帧放得下,超了给 `假`;
//   · **不做分片 / 不做扩展**(permessage-deflate 一律不协商);
//   · **握手只校验 `Sec-WebSocket-Accept`**:应答里别的头(子协议 / 扩展)一律不看;
//   · **掩码用本库自己的随机数**(`随机.hb` 的 xorshift32,拿 `当前时间()` 当种子)—— 协议只要求"不可预测",
//     不要求密码学强度,**别拿它当密钥用**;
//   · 一帧文本里若不是合法 UTF-8,那段字节按替换字符(U+FFFD)解出来。
// ============================================================
模块 WebSocket

包含 "../库/随机.hb"
包含 "../库/散列.hb"
包含 "../库/编码.hb"

// ---------- 私有:从块里读第 `位` 个字节 ----------
私有 方法 WebSocket取字节(地址 块, 整数 位) 返回 整数
{
    整数 字起 = 位 - 位 % 4;
    整数 移位量 = (位 % 4) * 8;
    返回 (取字(块, 字起) >> 移位量) & 255;
}

// ---------- 私有:往块里写第 `位` 个字节 ----------
私有 方法 WebSocket存字节(地址 块, 整数 位, 整数 值)
{
    整数 字起 = 位 - 位 % 4;
    整数 移位量 = (位 % 4) * 8;
    整数 整字 = 取字(块, 字起) & (~(255 << 移位量));
    存字(块, 字起, 整字 | ((值 & 255) << 移位量));
    返回
}

// ---------- 私有:在 `主` 里找 `子`,给起始下标;找不到给 -1 ----------
私有 方法 WebSocket找子串(字符串 主, 字符串 子) 返回 整数
{
    整数 主长 = 主.长度();
    整数 子长 = 子.长度();
    如果 (子长 <= 0 || 子长 > 主长)
    {
        返回 -1;
    }
    整数 i = 0;
    当 (i <= 主长 - 子长)
    {
        整数 j = 0;
        整数 同 = 1;
        当 (j < 子长)
        {
            如果 (主[i + j] != 子[j])
            {
                同 = 0;
                j = 子长;
            }
            否则
            {
                j = j + 1;
            }
        }
        如果 (同 == 1)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// ---------- 私有:把块里 `起` 开始的 `长` 个字节按 UTF-8 解成文字 ----------
//   非法序列按替换字符(U+FFFD,65533)解 —— 与 `接收` 那一族的读法同口径
私有 方法 WebSocket块转串(地址 块, 整数 起, 整数 长, 字符串 出 文本)
{
    文本 = "";
    整数 i = 0;
    当 (i < 长)
    {
        整数 首 = WebSocket取字节(块, 起 + i);
        整数 码 = 65533;
        整数 用掉 = 1;
        如果 (首 < 128)
        {
            码 = 首;
        }
        否则 如果 (首 >= 192 && 首 < 224 && i + 1 < 长)
        {
            整数 二 = WebSocket取字节(块, 起 + i + 1);
            如果 (二 >= 128 && 二 < 192)
            {
                码 = ((首 & 31) << 6) | (二 & 63);
                用掉 = 2;
            }
        }
        否则 如果 (首 >= 224 && 首 < 240 && i + 2 < 长)
        {
            整数 二 = WebSocket取字节(块, 起 + i + 1);
            整数 三 = WebSocket取字节(块, 起 + i + 2);
            如果 (二 >= 128 && 二 < 192 && 三 >= 128 && 三 < 192)
            {
                码 = ((首 & 15) << 12) | ((二 & 63) << 6) | (三 & 63);
                用掉 = 3;
            }
        }
        否则 如果 (首 >= 240 && i + 3 < 长)
        {
            整数 二 = WebSocket取字节(块, 起 + i + 1);
            整数 三 = WebSocket取字节(块, 起 + i + 2);
            整数 四 = WebSocket取字节(块, 起 + i + 3);
            如果 (二 >= 128 && 二 < 192 && 三 >= 128 && 三 < 192 && 四 >= 128 && 四 < 192)
            {
                码 = ((首 & 7) << 18) | ((二 & 63) << 12) | ((三 & 63) << 6) | (四 & 63);
                用掉 = 4;
            }
        }
        文字 一个文字 = 码;                 // ⚠ 必须是 `文字`(码点),`字符` 只有 8 位 —— 装码点会被截成低字节
        拼接到(文本, 一个文字);
        i = i + 用掉;
    }
    返回
}

// ---------- 私有:把文字按 UTF-8 写进块(从 `起` 开始),给写出的字节数 ----------
私有 方法 WebSocket串转块(字符串 文本, 地址 块, 整数 起) 返回 整数
{
    整数 个数 = 文本.长度();
    整数 写 = 0;
    整数 i = 0;
    当 (i < 个数)
    {
        整数 码 = 文本[i];
        如果 (码 < 128)
        {
            WebSocket存字节(块, 起 + 写, 码);
            写 = 写 + 1;
        }
        否则 如果 (码 < 2048)
        {
            WebSocket存字节(块, 起 + 写, 192 | (码 >> 6));
            WebSocket存字节(块, 起 + 写 + 1, 128 | (码 & 63));
            写 = 写 + 2;
        }
        否则 如果 (码 < 65536)
        {
            WebSocket存字节(块, 起 + 写, 224 | (码 >> 12));
            WebSocket存字节(块, 起 + 写 + 1, 128 | ((码 >> 6) & 63));
            WebSocket存字节(块, 起 + 写 + 2, 128 | (码 & 63));
            写 = 写 + 3;
        }
        否则
        {
            WebSocket存字节(块, 起 + 写, 240 | (码 >> 18));
            WebSocket存字节(块, 起 + 写 + 1, 128 | ((码 >> 12) & 63));
            WebSocket存字节(块, 起 + 写 + 2, 128 | ((码 >> 6) & 63));
            WebSocket存字节(块, 起 + 写 + 3, 128 | (码 & 63));
            写 = 写 + 4;
        }
        i = i + 1;
    }
    返回 写;
}

// ---------- 私有:整数转十进制文字(端口那一格要用;不带库外的依赖) ----------
私有 方法 WebSocket整数转字符串(整数 值) 返回 字符串
{
    字符串 出文 = "";
    如果 (值 < 0)
    {
        拼接到(出文, '-');
        值 = 0 - 值;
    }
    如果 (值 == 0)
    {
        拼接到(出文, '0');
        返回 出文;
    }
    字符 倒[12];
    整数 位 = 0;
    当 (值 > 0 && 位 < 12)
    {
        倒[位] = 48 + (值 % 10);
        值 = 值 / 10;
        位 = 位 + 1;
    }
    当 (位 > 0)
    {
        位 = 位 - 1;
        拼接到(出文, 倒[位]);
    }
    返回 出文;
}

// ---------- 私有:算一遍应有的 Sec-WebSocket-Accept = Base64(SHA1(键 + 魔术串)) ----------
//   (抽成小函数:握手那一帧只有 96 字节,放不下这么多中间量)
私有 方法 WebSocket算应答(字符串 键) 返回 字符串
{
    字符串 魔术 = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    地址 待算 = 申请(128);
    如果 (待算 == 0)
    {
        返回 "";
    }
    地址 摘要块 = 申请(20);
    如果 (摘要块 == 0)
    {
        释放(待算);
        返回 "";
    }
    整数 算长 = WebSocket串转块(键, 待算, 0);
    算长 = 算长 + WebSocket串转块(魔术, 待算, 算长);
    算长 = 算长 + (4 - 算长 % 4) % 4;              // `取字` 按整字查边界,补到 4 的整数倍
    字符串 出文 = "";
    如果 (散列.摘要(待算, 算长, 摘要块))
    {
        出文 = 编码.转Base64(摘要块, 20);
    }
    释放(待算);
    释放(摘要块);
    返回 出文;
}

// ---------- 私有:从 HTTP 头里抠出一行的值(读到 CR 为止,跳过前导空格) ----------
私有 方法 WebSocket抠头(字符串 应答, 字符串 头名, 字符串 出 值) 返回 逻辑
{
    值 = "";
    整数 头起 = WebSocket找子串(应答, 头名);
    如果 (头起 < 0)
    {
        返回 假;
    }
    整数 位 = 头起 + 头名.长度();
    当 (位 < 应答.长度() && 应答[位] == ' ')
    {
        位 = 位 + 1;
    }
    当 (位 < 应答.长度() && 应答[位] != 13)
    {
        文字 一个 = 应答[位];
        拼接到(值, 一个);
        位 = 位 + 1;
    }
    返回 值.长度() > 0;
}

// ---------- 私有:16 字节随机 → Base64,那就是 `Sec-WebSocket-Key` ----------
私有 方法 WebSocket造键(字符串 出 键) 返回 逻辑
{
    键 = "";
    地址 键块 = 申请(16);
    如果 (键块 == 0)
    {
        返回 假;
    }
    随机.设种子((当前时间() & 2147483647) | 1);
    整数 i = 0;
    当 (i < 16)
    {
        WebSocket存字节(键块, i, 随机.下一个() & 255);
        i = i + 1;
    }
    字符串 本地 = 编码.转Base64(键块, 16);
    键 = 本地;
    释放(键块);
    返回 键.长度() == 24;
}

// ---------- 私有:发 HTTP 升级请求(纯 ASCII,可以住字符串里;字符串只能 `拼接到`,没有 `+`) ----------
私有 方法 WebSocket发升级(整数 句柄, 字符串 主机, 整数 端口, 字符串 路径, 字符串 键) 返回 逻辑
{
    字符串 请求 = "GET ";
    拼接到(请求, 路径);
    拼接到(请求, " HTTP/1.1\r\nHost: ");
    拼接到(请求, 主机);
    拼接到(请求, ":");
    拼接到(请求, WebSocket整数转字符串(端口));
    拼接到(请求, "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ");
    拼接到(请求, 键);
    拼接到(请求, "\r\nSec-WebSocket-Version: 13\r\n\r\n");
    返回 发送(句柄, 请求) > 0;
}

// ---------- 私有:收 HTTP 应答(收到空行 `\r\n\r\n` 为止) ----------
//   头是纯 ASCII;头后面的帧字节也在这一串里,但本函数只找空行,不碰它们
私有 方法 WebSocket收应答(整数 句柄, 字符串 出 应答) 返回 逻辑
{
    应答 = "";
    字符串 块 = "";
    整数 已收 = 0;
    当 (已收 < 16384)
    {
        整数 这次 = 接收(句柄, 块, 4096);
        如果 (这次 <= 0)
        {
            跳出;
        }
        拼接到(应答, 块);
        已收 = 已收 + 这次;
        如果 (WebSocket找子串(应答, "\r\n\r\n") >= 0)
        {
            返回 真;
        }
    }
    返回 假;
}

// 在 `主` 里找 `子`,给起始下标;找不到给 -1(公开:自己拼协议 / 对 id 时也用得上)
方法 找子串(字符串 主, 字符串 子) 返回 整数
{
    返回 WebSocket找子串(主, 子);
}

// ============================================================
// 握手(客户端那一半)
// ============================================================
//
// 为什么拆成两半:`握手` 是"发请求 + 读应答"一体的,**同步阻塞** ——
// 自己连自己(同一份程序里既当客户端又当服务端,标准工程示例50 就是这么做的)时,
// 服务端要插在"发完请求"与"读应答"中间回话,一体式那一版会当场死锁。
// ⇒ 拆成 `发升级请求`(把键交出来)+ `验应答`;正式用法直接调 `握手`(它就是这两半合体)。

// 第一半:造键 + 发 HTTP 升级请求;`键` 交出来,后面 `验应答` 与 `回升级` 都要用
方法 发升级请求(整数 句柄, 字符串 主机, 整数 端口, 字符串 路径, 字符串 出 键) 返回 逻辑
{
    键 = "";
    WebSocket帧起 = 0;                 // 新连接:接收游标从头来
    WebSocket帧末 = 0;
    字符串 本地 = "";
    如果 (!WebSocket造键(本地))
    {
        返回 假;
    }
    键 = 本地;
    返回 WebSocket发升级(句柄, 主机, 端口, 路径, 键);
}

// 第二半:收应答 + 校验 `Sec-WebSocket-Accept`
方法 验应答(整数 句柄, 字符串 键, 字符串 出 说明) 返回 逻辑
{
    说明 = "";
    字符串 应答 = "";
    如果 (!WebSocket收应答(句柄, 应答))
    {
        说明 = "没收到完整的 HTTP 应答";
        返回 假;
    }
    如果 (WebSocket找子串(应答, " 101 ") < 0)
    {
        说明 = "服务端没回 101(不是一次成功的升级)";
        返回 假;
    }
    字符串 应有 = WebSocket算应答(键);
    如果 (应有.长度() != 28)
    {
        说明 = "算不出应有的 Sec-WebSocket-Accept";
        返回 假;
    }
    字符串 实得 = "";
    如果 (!WebSocket抠头(应答, "Sec-WebSocket-Accept:", 实得))
    {
        说明 = "应答里没有 Sec-WebSocket-Accept";
        返回 假;
    }
    如果 (实得 != 应有)
    {
        说明 = "Sec-WebSocket-Accept 对不上";
        返回 假;
    }
    说明 = "升级成功";
    返回 真;
}

// 发 HTTP Upgrade 并校验应答里的 `Sec-WebSocket-Accept`
方法 握手(整数 句柄, 字符串 主机, 整数 端口, 字符串 路径, 字符串 出 说明) 返回 逻辑
{
    说明 = "";
    字符串 键 = "";
    如果 (!发升级请求(句柄, 主机, 端口, 路径, 键))
    {
        说明 = "升级请求发不出去";
        返回 假;
    }
    返回 验应答(句柄, 键, 说明);
}

// ============================================================
// 握手(服务端那一半)
// ============================================================
//
// 有了这两条,HB 自己就能当一个小 WebSocket 服务端 ——
// `Sample\中间层\示例50_页面调试` 那个标准工程正是拿它们**自己连自己**,
// 不碰外网、也不需要真有浏览器在跑。

// 读一条 HTTP 升级请求,把 `Sec-WebSocket-Key` 抠出来
方法 读升级键(整数 句柄, 字符串 出 键) 返回 逻辑
{
    键 = "";
    WebSocket帧起 = 0;                 // 新连接:接收游标从头来
    WebSocket帧末 = 0;
    字符串 请求 = "";
    字符串 块 = "";
    整数 已收 = 0;
    当 (已收 < 16384)
    {
        整数 这次 = 接收(句柄, 块, 4096);
        如果 (这次 <= 0)
        {
            跳出;
        }
        拼接到(请求, 块);
        已收 = 已收 + 这次;
        如果 (WebSocket找子串(请求, "\r\n\r\n") >= 0)
        {
            跳出;
        }
    }
    返回 WebSocket抠头(请求, "Sec-WebSocket-Key:", 键);
}

// 算一遍 `Sec-WebSocket-Accept`,回一条 101
方法 回升级(整数 句柄, 字符串 键) 返回 逻辑
{
    字符串 应有 = WebSocket算应答(键);
    如果 (应有.长度() != 28)
    {
        返回 假;
    }
    字符串 应答 = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ";
    拼接到(应答, 应有);
    拼接到(应答, "\r\n\r\n");
    返回 发送(句柄, 应答) > 0;
}

// ============================================================
// 发帧
// ============================================================

// ---------- 私有:按 RFC 6455 组一帧发出去;`掩` = 1 掩码(客户端)/ 0 不掩(服务端) ----------
私有 方法 WebSocket发帧(整数 句柄, 地址 数据, 整数 字节数, 整数 类型, 整数 掩) 返回 逻辑
{
    如果 (字节数 < 0)
    {
        返回 假;
    }

    整数 头长 = 2;
    如果 (字节数 > 125)
    {
        头长 = 4;
    }
    如果 (字节数 > 65535)
    {
        头长 = 10;
    }
    整数 掩长 = 0;
    如果 (掩 == 1)
    {
        掩长 = 4;
    }

    地址 帧块 = 申请(头长 + 掩长 + 字节数 + 4);
    如果 (帧块 == 0)
    {
        返回 假;
    }

    // ① 头两个字节(bit7 = FIN,bit0~3 = 操作码;第二个字节 bit7 = 掩码位)
    整数 位七 = 0;
    如果 (掩 == 1)
    {
        位七 = 128;
    }
    WebSocket存字节(帧块, 0, 128 | (类型 & 15));
    如果 (头长 == 2)
    {
        WebSocket存字节(帧块, 1, 位七 | 字节数);
    }
    否则 如果 (头长 == 4)
    {
        WebSocket存字节(帧块, 1, 位七 | 126);
        WebSocket存字节(帧块, 2, (字节数 >> 8) & 255);
        WebSocket存字节(帧块, 3, 字节数 & 255);
    }
    否则
    {
        WebSocket存字节(帧块, 1, 位七 | 127);
        WebSocket存字节(帧块, 2, 0);
        WebSocket存字节(帧块, 3, 0);
        WebSocket存字节(帧块, 4, 0);
        WebSocket存字节(帧块, 5, 0);
        WebSocket存字节(帧块, 6, (字节数 >> 24) & 255);
        WebSocket存字节(帧块, 7, (字节数 >> 16) & 255);
        WebSocket存字节(帧块, 8, (字节数 >> 8) & 255);
        WebSocket存字节(帧块, 9, 字节数 & 255);
    }

    整数 i = 0;
    如果 (掩 == 1)
    {
        // ② 4 字节掩码。掩码就写在帧块里,用的时候再读回来(少一个局部数组:帧上限 96 字节)
        随机.设种子((随机.看种子() + 字节数) | 1);
        整数 k = 0;
        当 (k < 4)
        {
            WebSocket存字节(帧块, 头长 + k, 随机.下一个() & 255);
            k = k + 1;
        }
        // ③ 载荷:逐字节异或
        当 (i < 字节数)
        {
            整数 掩位 = WebSocket取字节(帧块, 头长 + i % 4);
            WebSocket存字节(帧块, 头长 + 4 + i, WebSocket取字节(数据, i) ^ 掩位);
            i = i + 1;
        }
    }
    否则
    {
        // 服务端发出的帧**不掩码**(RFC 6455 明令),原样搬
        当 (i < 字节数)
        {
            WebSocket存字节(帧块, 头长 + i, WebSocket取字节(数据, i));
            i = i + 1;
        }
    }

    整数 总长 = 头长 + 掩长 + 字节数;
    整数 发了 = 发送块(句柄, 帧块, 总长);
    释放(帧块);
    返回 发了 == 总长;
}

// 发一帧(类型 1 = 文本 / 2 = 二进制)
方法 发字节(整数 句柄, 地址 数据, 整数 字节数, 整数 类型) 返回 逻辑
{
    返回 WebSocket发帧(句柄, 数据, 字节数, 类型, 1);
}

// 回一帧(与 `发字节` 同形)。**服务端**那一半:按 RFC 6455 **不掩码**
方法 回字节(整数 句柄, 地址 数据, 整数 字节数, 整数 类型) 返回 逻辑
{
    返回 WebSocket发帧(句柄, 数据, 字节数, 类型, 0);
}

// 回一帧文本(服务端用;不掩码)
方法 回文本(整数 句柄, 字符串 文本) 返回 逻辑
{
    地址 数据 = 申请(文本.长度() * 4 + 8);
    如果 (数据 == 0)
    {
        返回 假;
    }
    整数 字节数 = WebSocket串转块(文本, 数据, 0);
    逻辑 成 = 回字节(句柄, 数据, 字节数, 1);
    释放(数据);
    返回 成;
}

// 发一帧文本(自动掩码)
方法 发文本(整数 句柄, 字符串 文本) 返回 逻辑
{
    地址 数据 = 申请(文本.长度() * 4 + 8);
    如果 (数据 == 0)
    {
        返回 假;
    }
    整数 字节数 = WebSocket串转块(文本, 数据, 0);
    逻辑 成 = 发字节(句柄, 数据, 字节数, 1);
    释放(数据);
    返回 成;
}

// ============================================================
// 收帧
// ============================================================
//
// ★ 接收游标(本库最要紧的一处实现口径)
//   TCP 是**字节流**:一次 `接收块` 很可能一口气收到**两三帧**(实测:连发 9 条小命令时必现)。
//   所以帧块里 `[WebSocket帧起, WebSocket帧末)` 是"已经收下来、还没解过"的那一段;
//   解一帧只把 `起` 往后推,**一个字节都不丢**。
//   (早一版每帧都从块头重新收 —— 多帧挤在一次接收里时,后面那几帧被直接扔掉,
//    下一次 `接收` 就永远等不到数据,整条链路静默卡死。小测试只有一帧,所以没露出来。)
//   ⚠ 代价如实登记:两个游标是**模块级**的 ⇒ 本库同一时刻只服务**一条连接**。
//   要同时开两条,就各写一个包装封在独立文件里(与 `float32.hb` / `float64.hb` 那条边界同一套办法)。

整数 WebSocket帧起 = 0;
整数 WebSocket帧末 = 0;

// ---------- 私有:把块里 `从` 到 `到` 那一段搬到块头,给搬完后的"末" ----------
私有 方法 WebSocket搬余(地址 帧块, 整数 从, 整数 到) 返回 整数
{
    整数 剩 = 到 - 从;
    整数 i = 0;
    当 (i < 剩)
    {
        WebSocket存字节(帧块, i, WebSocket取字节(帧块, 从 + i));
        i = i + 1;
    }
    返回 剩;
}

// ---------- 私有:保证"还没解过"的那一段至少有 `要` 个字节 ----------
私有 方法 WebSocket凑够(整数 句柄, 地址 帧块, 整数 帧容量, 整数 要) 返回 逻辑
{
    当 (WebSocket帧末 - WebSocket帧起 < 要)
    {
        WebSocket帧末 = WebSocket搬余(帧块, WebSocket帧起, WebSocket帧末);
        WebSocket帧起 = 0;
        如果 (WebSocket帧末 >= 帧容量)
        {
            返回 假;                    // 攒不下了(帧容量给得太小)
        }
        整数 补 = 接收块(句柄, 帧块 + WebSocket帧末, 帧容量 - WebSocket帧末);
        如果 (补 <= 0)
        {
            返回 假;
        }
        WebSocket帧末 = WebSocket帧末 + 补;
    }
    返回 真;
}

// 收**一整帧**(要求 FIN=1、整帧放得进 `帧容量`);
// `类型` 给操作码(1 文本 / 2 二进制 / 8 close / 9 ping / 10 pong),
// `载荷起` 给载荷在帧块里的起始偏移,`载荷长` 给载荷字节数。
// 收一帧;类型 / 载荷起 / 载荷长 写进你给的那三格
方法 收一帧(整数 句柄, 地址 帧块, 整数 帧容量, 引用 整数 类型, 引用 整数 载荷起, 引用 整数 载荷长) 返回 逻辑
{
    类型 = 0;
    载荷起 = 0;
    载荷长 = 0;

    如果 (!WebSocket凑够(句柄, 帧块, 帧容量, 2))
    {
        返回 假;
    }

    整数 首 = WebSocket取字节(帧块, WebSocket帧起);
    类型 = 首 & 15;
    如果 ((首 & 128) == 0)
    {
        返回 假;                       // 分片不做
    }

    整数 第二 = WebSocket取字节(帧块, WebSocket帧起 + 1);
    整数 头长 = 2;
    整数 要收 = 第二 & 127;
    如果 (要收 == 126)
    {
        头长 = 4;
        如果 (!WebSocket凑够(句柄, 帧块, 帧容量, 4))
        {
            返回 假;
        }
        要收 = (WebSocket取字节(帧块, WebSocket帧起 + 2) << 8) | WebSocket取字节(帧块, WebSocket帧起 + 3);
    }
    否则 如果 (要收 == 127)
    {
        头长 = 10;
        如果 (!WebSocket凑够(句柄, 帧块, 帧容量, 10))
        {
            返回 假;
        }
        要收 = 0;
        整数 k = 2;
        当 (k < 10)
        {
            要收 = (要收 << 8) | WebSocket取字节(帧块, WebSocket帧起 + k);
            k = k + 1;
        }
    }

    // 服务端发来的帧**不掩码**;万一掩了,这里如实多算 4 字节
    整数 掩长 = 0;
    如果 ((第二 & 128) != 0)
    {
        掩长 = 4;
    }
    整数 整帧 = 头长 + 掩长 + 要收;
    如果 (整帧 > 帧容量)
    {
        返回 假;                       // 放不下就如实说,不静默截断
    }
    如果 (!WebSocket凑够(句柄, 帧块, 帧容量, 整帧))
    {
        返回 假;
    }

    载荷起 = WebSocket帧起 + 头长 + 掩长;
    载荷长 = 要收;
    WebSocket帧起 = WebSocket帧起 + 整帧;      // ← 只推进游标,一个字节都不丢

    如果 (类型 == 9)                   // ping → 回一个 pong,不算载荷
    {
        发字节(句柄, 帧块, 0, 10);
        类型 = 9;
        载荷长 = 0;
        返回 真;
    }
    如果 (类型 == 10)                  // pong
    {
        载荷长 = 0;
        返回 真;
    }
    如果 (类型 == 8)                   // close
    {
        返回 假;
    }
    返回 真;
}

// 收一帧文本,载荷解成文字
方法 收文本(整数 句柄, 地址 帧块, 整数 帧容量, 字符串 出 文本) 返回 逻辑
{
    文本 = "";
    整数 类型 = 0;
    整数 载荷起 = 0;
    整数 载荷长 = 0;
    整数 轮 = 0;
    当 (轮 < 8)
    {
        如果 (!收一帧(句柄, 帧块, 帧容量, 类型, 载荷起, 载荷长))
        {
            返回 假;
        }
        如果 (类型 == 1 || 类型 == 2)
        {
            WebSocket块转串(帧块, 载荷起, 载荷长, 文本);
            返回 真;
        }
        轮 = 轮 + 1;
    }
    返回 假;
}

// 发 close 帧再关 TCP
方法 关掉(整数 句柄) 返回 逻辑
{
    地址 空块 = 申请(8);
    如果 (空块 != 0)
    {
        发字节(句柄, 空块, 0, 8);
        释放(空块);
    }
    返回 关闭(句柄) == 0;
}
