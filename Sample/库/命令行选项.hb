// ============================================================
// 命令行选项.hb —— `--键 值` / `-k` / 位置参数(纯 HB)
//
// 用法:
// ```
// 包含 "../库/命令行选项.hb";
// 命令行选项.解析("--端口 8080 -v 输入.txt");
// 整数 端口 = 命令行选项.取整数("端口", 80);      // 8080
// 如果 (命令行选项.开关("v")) { 详细输出 = 真; }
// 字符串 文件 = 命令行选项.位置(0);               // 输入.txt
// ```
//
// 治的是**小工具开头那十行**:把一条命令行拆成"开关 / 键值 / 剩下那几个位置参数"。语言里**没有"读 argv"
//   的内建能力**,所以本库收的是**一整条字符串** —— 命令行怎么来由调用方决定(从 `读取行()` 读、从配置里拿、
//   或用 `从环境` 读环境变量)。
//
// 认哪些写法(写死了、不再改):
//   · `--键 值` / `-键 值`:下一个记号**不以 `-` 开头**时它就是值;否则这个键是**纯开关**(值为空串);
//   · `--键=值` / `-键=值`:等号后面的(可以是空串)就是值 —— `--键=` 给的是"空值",与"没这个键"不同;
//   · `--开关` / `-开关`:在册,值是空串;
//   · **不以 `-` 开头的记号 = 位置参数**(`位置(0)` / `位置(1)` …);
//   · **`--` 之后一律是位置参数**(后面就算写着 `--键`,也只是个位置参数);
//   · **引号**:双引号或单引号包起来的一整段算**一个**记号(里面可以有空格),
//     引号本身不进结果;引号里**没有转义**(想要一个字面引号就换另一种引号包);
//   · **键名统一口径**:前导的 `-` 全部去掉再比 ⇒ `有("端口")` 与 `有("--端口")` 是一回事;
//   · 记号里的空白 = 空格与制表符(换行不用管:一条命令行本来就该是一行)。
//
// 提供的函数(12 个):逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:解析是 O(整条的字符数)(一趟扫完,每个字符看一次);取 / 有 那一族 O(具名项数)(最多 32 项)。
//
// 内存账:模块级那一摞定长数组(名 / 值 / 位置各 32 条字符串,加一块 4KB 的字节区和 80 个记号的
//   令牌表)**总共几 KB 静态数据**;每次 `解析` 会现造几条短串(键 / 值 / 记号,住在池里,由编译器按水位收)
//   ⇒ **别在一个循环里拿同一份配置反复 `解析`**(解析一次,结果留着用)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **一条命令行最多 1024 个文字**(汉字那种 3 字节的算 1 个文字,但占 3 个字节 ⇒ 顶到 4KB 缓冲),
//     超了 `解析` 给 -1 并且**一条都不收**;记号最多 80 个、具名项最多 32 个、位置参数最多 32 个
//     (超出的丢掉,`解析` 的返回值照实报收下了几个);
//   · **键名不认大小写以外的花样**:不做前缀缩写(`--po 80` 不等于 `--port`)——
//     缩写要查一整套键名表,那一档留给调用方自己写;
//   · **值是"一条整串"**:没有数组 / 没有重复键合并 —— 同一个键写两次,`取` 给**第一次**那一个
//     (要看全部就按 `名字(序号)` / `值(序号)` 遍历);
//   · **`从环境` 是唯一碰宿主能力的一条**:宿主没挂这项能力时它给假(与"这个变量没设"同一个返回值),
//     要分清楚就先 `有环境变量(变名)`(`环境.hb`);
//   · **不做子命令 / 不做参数分组**(`git commit -m x` 那种两级结构):`commit` 会落成位置参数,
//     要分支就自己看 `位置(0)`。
//
// 口径(2026-10;每条都对着实测写):认哪些写法见上面那一栏,逐条见各函数紧上面那行注释。
// ============================================================
模块 命令行选项

// ---------- 一份解析结果(模块级:一次只留最近解析的那一条) ----------
私有 字符串 命令行选项名[32];
私有 字符串 命令行选项值[32];
私有 字符串 命令行选项位置[32];
私有 整数 命令行选项名数 = 0;
私有 整数 命令行选项位数 = 0;
私有 字符 命令行选项区[4096];
私有 字符串 命令行选项令牌[80];
私有 整数 命令行选项记号数 = 0;
私有 整数 命令行选项多少 = 0;

// ============================================================
// 私有:切记号
// ============================================================

// 这个字节是不是空白(空格 / 制表符)
私有 方法 命令行选项是空白(整数 码) 返回 逻辑
{
    返回 码 == 32 || 码 == 9;
}

// 把整条搬进字节区,再按空白与引号切成记号(引号里的整段算一个记号)。
// 记号太多给假(前 80 个照收)。
私有 方法 命令行选项切记号() 返回 逻辑
{
    命令行选项记号数 = 0;
    整数 i = 0;
    当 (i < 命令行选项多少)
    {
        当 (i < 命令行选项多少 && 命令行选项是空白(命令行选项区[i]))
        {
            i = i + 1;
        }
        如果 (i >= 命令行选项多少)
        {
            跳出;
        }
        如果 (命令行选项记号数 >= 80)
        {
            返回 假;
        }
        字符串 一个 = "";
        整数 引号 = 0;
        当 (i < 命令行选项多少)
        {
            整数 码 = 命令行选项区[i];
            如果 (引号 != 0)
            {
                如果 (码 == 引号)
                {
                    引号 = 0;
                }
                否则
                {
                    字符 字 = 码;
                    拼接到(一个, 字);
                }
                i = i + 1;
            }
            否则
            {
                如果 (码 == 34 || 码 == 39)
                {
                    引号 = 码;
                    i = i + 1;
                }
                否则
                {
                    如果 (命令行选项是空白(码))
                    {
                        跳出;
                    }
                    字符 字 = 码;
                    拼接到(一个, 字);
                    i = i + 1;
                }
            }
        }
        命令行选项令牌[命令行选项记号数] = 一个;
        命令行选项记号数 = 命令行选项记号数 + 1;
    }
    返回 真;
}

// ============================================================
// 私有:键名与切分
// ============================================================

// 去掉前导的 '-'(`--端口` / `-端口` / `端口` 都成 `端口`)
私有 方法 命令行选项净名(字符串 键) 返回 字符串
{
    整数 个数 = 键.长度();
    整数 i = 0;
    当 (i < 个数 && 键[i] == 45)
    {
        i = i + 1;
    }
    如果 (i == 0)
    {
        返回 键;
    }
    字符串 结果 = "";
    当 (i < 个数)
    {
        拼接到(结果, 键[i]);
        i = i + 1;
    }
    返回 结果;
}

// 第一个 '=' 的位置(没有给 -1)
私有 方法 命令行选项找等号(字符串 记号) 返回 整数
{
    整数 i = 0;
    当 (i < 记号.长度())
    {
        如果 (记号[i] == 61)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// 取前 `止` 个文字
私有 方法 命令行选项取左(字符串 记号, 整数 止) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 0;
    当 (i < 止)
    {
        拼接到(结果, 记号[i]);
        i = i + 1;
    }
    返回 结果;
}

// 从第 `起` 个文字取到末尾
私有 方法 命令行选项取右(字符串 记号, 整数 起) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 起;
    当 (i < 记号.长度())
    {
        拼接到(结果, 记号[i]);
        i = i + 1;
    }
    返回 结果;
}

// 这个记号能不能当"值"(不以 '-' 开头;空串不算)
私有 方法 命令行选项是值(字符串 记号) 返回 逻辑
{
    如果 (记号.长度() == 0)
    {
        返回 假;
    }
    返回 记号[0] != 45;
}

// ============================================================
// 私有:收进结果表
// ============================================================
私有 方法 命令行选项放具名(字符串 名, 字符串 值) 返回 逻辑
{
    如果 (命令行选项名数 >= 32)
    {
        返回 假;
    }
    命令行选项名[命令行选项名数] = 名;
    命令行选项值[命令行选项名数] = 值;
    命令行选项名数 = 命令行选项名数 + 1;
    返回 真;
}

私有 方法 命令行选项放位置(字符串 记号) 返回 逻辑
{
    如果 (命令行选项位数 >= 32)
    {
        返回 假;
    }
    命令行选项位置[命令行选项位数] = 记号;
    命令行选项位数 = 命令行选项位数 + 1;
    返回 真;
}

// 收第 `k` 个记号;返回"下一个该看第几个"(吃了值就 +2)。
私有 方法 命令行选项收记号(整数 k, 引用 逻辑 只剩位置) 返回 整数
{
    如果 (命令行选项令牌[k] == "--")
    {
        只剩位置 = 真;
        返回 1;
    }
    逻辑 是位置 = 只剩位置;
    如果 (是位置 == 假)
    {
        是位置 = 命令行选项是位置样(命令行选项令牌[k]);
    }
    如果 (是位置)
    {
        命令行选项放位置(命令行选项令牌[k]);
        返回 1;
    }
    整数 等号 = 命令行选项找等号(命令行选项令牌[k]);
    如果 (等号 >= 0)
    {
        命令行选项放具名(命令行选项净名(命令行选项取左(命令行选项令牌[k], 等号)), 命令行选项取右(命令行选项令牌[k], 等号 + 1));
        返回 1;
    }
    如果 (k + 1 < 命令行选项记号数 && 命令行选项是值(命令行选项令牌[k + 1]))
    {
        命令行选项放具名(命令行选项净名(命令行选项令牌[k]), 命令行选项令牌[k + 1]);
        返回 2;
    }
    命令行选项放具名(命令行选项净名(命令行选项令牌[k]), "");
    返回 1;
}

// 这个记号是不是位置参数(不以 '-' 开头;空串算)
私有 方法 命令行选项是位置样(字符串 记号) 返回 逻辑
{
    如果 (记号.长度() == 0)
    {
        返回 真;
    }
    返回 记号[0] != 45;
}

// 找第 `键` 个具名项的下标(没有给 -1)
私有 方法 命令行选项找(字符串 键) 返回 整数
{
    字符串 干净 = 命令行选项净名(键);
    整数 i = 0;
    当 (i < 命令行选项名数)
    {
        如果 (命令行选项名[i] == 干净)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// 私有:整串(去首尾空白)是不是一个十进制整数
私有 方法 命令行选项是整数(字符串 文本) 返回 逻辑
{
    整数 个数 = 文本.长度();
    整数 i = 0;
    当 (i < 个数 && 命令行选项是空白(文本[i]))
    {
        i = i + 1;
    }
    整数 止 = 个数;
    当 (止 > i && 命令行选项是空白(文本[止 - 1]))
    {
        止 = 止 - 1;
    }
    如果 (i >= 止)
    {
        返回 假;
    }
    如果 (文本[i] == 43 || 文本[i] == 45)
    {
        i = i + 1;
    }
    如果 (i >= 止)
    {
        返回 假;
    }
    当 (i < 止)
    {
        整数 码 = 文本[i];
        如果 (码 < 48 || 码 > 57)
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 私有:读一个十进制整数(调用方先 `命令行选项是整数` 判过)
私有 方法 命令行选项读整数(字符串 文本) 返回 整数
{
    整数 个数 = 文本.长度();
    整数 i = 0;
    当 (i < 个数 && 命令行选项是空白(文本[i]))
    {
        i = i + 1;
    }
    整数 号 = 1;
    如果 (文本[i] == 45)
    {
        号 = -1;
        i = i + 1;
    }
    否则
    {
        如果 (文本[i] == 43)
        {
            i = i + 1;
        }
    }
    整数 值 = 0;
    当 (i < 个数)
    {
        整数 码 = 文本[i];
        如果 (码 < 48 || 码 > 57)
        {
            跳出;
        }
        值 = 值 * 10 + (码 - 48);
        i = i + 1;
    }
    返回 值 * 号;
}

// ============================================================
// 公开:解析与取值
// ============================================================

// 丢掉上一次解析的结果(名表、位置表、记号表都清空)
方法 清掉()
{
    命令行选项名数 = 0;
    命令行选项位数 = 0;
    命令行选项记号数 = 0;
    命令行选项多少 = 0;
    命令行选项区[0] = 0;
    返回
}

// 拆一条命令行:返回收了几个具名项 + 几个位置参数;-1 = 太长或记号太多
方法 解析(字符串 整条) 返回 整数
{
    清掉();
    如果 (整条.长度() > 1024)
    {
        返回 -1;
    }
    拼接到(命令行选项区, 整条);
    当 (命令行选项多少 < 4096 && 命令行选项区[命令行选项多少] != 0)
    {
        命令行选项多少 = 命令行选项多少 + 1;
    }
    如果 (命令行选项切记号() == 假)
    {
        返回 -1;
    }
    逻辑 只剩位置 = 假;
    整数 k = 0;
    当 (k < 命令行选项记号数)
    {
        k = k + 命令行选项收记号(k, 只剩位置);
    }
    返回 命令行选项名数 + 命令行选项位数;
}

// 收了几个具名项(纯开关也算一个),最多 32
方法 个数() 返回 整数
{
    返回 命令行选项名数;
}

// 第 `序号` 个具名项的键(前导的 `-` 已经去掉);越界给空串
方法 名字(整数 序号) 返回 字符串
{
    如果 (序号 < 0 || 序号 >= 命令行选项名数)
    {
        返回 "";
    }
    返回 命令行选项名[序号];
}

// 第 `序号` 个具名项的值(纯开关是空串);越界给空串
方法 值(整数 序号) 返回 字符串
{
    如果 (序号 < 0 || 序号 >= 命令行选项名数)
    {
        返回 "";
    }
    返回 命令行选项值[序号];
}

// 这个键在不在(键名带不带前导 `-` 都一样);纯开关也算在
方法 有(字符串 键) 返回 逻辑
{
    返回 命令行选项找(键) >= 0;
}

// 这个键在,而且它的值正好是空串才给真;键不在或带着值给假
方法 开关(字符串 键) 返回 逻辑
{
    整数 位 = 命令行选项找(键);
    如果 (位 < 0)
    {
        返回 假;
    }
    返回 命令行选项值[位].长度() == 0;
}

// 有就给它的值,没有就给 `缺省`;同一个键写两次给第一次那个
方法 取(字符串 键, 字符串 缺省) 返回 字符串
{
    整数 位 = 命令行选项找(键);
    如果 (位 < 0)
    {
        返回 缺省;
    }
    返回 命令行选项值[位];
}

// 把值整串当十进制整数读(带 +/- 号也认);键不在或读不成给 `缺省`
方法 取整数(字符串 键, 整数 缺省) 返回 整数
{
    整数 位 = 命令行选项找(键);
    如果 (位 < 0)
    {
        返回 缺省;
    }
    如果 (命令行选项是整数(命令行选项值[位]) == 假)
    {
        返回 缺省;
    }
    返回 命令行选项读整数(命令行选项值[位]);
}

// 收了几个位置参数(`--` 之后的也算在内),最多 32
方法 位置个数() 返回 整数
{
    返回 命令行选项位数;
}

// 第 `序号` 个位置参数(引号已经摘掉);越界给空串
方法 位置(整数 序号) 返回 字符串
{
    如果 (序号 < 0 || 序号 >= 命令行选项位数)
    {
        返回 "";
    }
    返回 命令行选项位置[序号];
}

// 把环境变量当一条命令行来解析(宿主能力 `环境变量`;没设给假)
方法 从环境(字符串 变名) 返回 逻辑
{
    字符串 一条 = "";
    如果 (环境变量(变名, 一条, 4096) == 假)
    {
        清掉();
        返回 假;
    }
    解析(一条);
    返回 真;
}
