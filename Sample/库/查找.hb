// ============================================================
// 查找.hb —— 查找库(纯 HB,不动语言面)
//
// 用法:包含 "../库/查找.hb";调用写 `查找.二分找(表, 值)`。
//
// 口径(2026-09):
//   · **找不到一律给 -1**(下标不会是负数);
//   · "空表给 假"的分支**实际到不了**(语言层造不出长度 0 的数组);
//   · **只收固定数组**(`整数 表[10]` 这种):动态列表传不了(报"列表的地址不能取");
//   · **`二分找` 要求表已经升序**(先 `排序.整数升序(表)`,或先问一句 `是升序(表)`);表没序时**不报错**,只是可能找不到;
//   · **`第k小` 不挑输入**(内部复制一份再选择),算完**不动调用方那张表**;代价是复制一份 O(n) 的临时表;
//   · **有重复值时**:`线性找` 给**第一个**、`二分找` 给"撞上的那一个"(不作保证)、`第k小` 按**有序位置**数(k 从 1 开始)。
//
// 英文对照:线性找 linearFind · 二分找 binaryFind · 是升序 isAscending · 第k小 kthSmallest · 最大最小 minMax
//
// 复杂度:线性找 O(n);二分找 O(log n);其余都是 O(表长)。
// 提供的函数(5 个):逐个见下面那张公开方法表。
// 边界(如实登记):只收固定数组;`二分找` 要先升序。
// ============================================================
模块 查找

// 从头比到尾;给下标,没有给 -1。
方法 线性找(整数 表[], 整数 值) 返回 整数
{
    整数 i = 0;
    当 (i < 表.长度())
    {
        如果 (表[i] == 值)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// 表**必须先升序**;给下标,没有给 -1(表没序也不报错,只是可能找不到)。
方法 二分找(整数 表[], 整数 值) 返回 整数
{
    整数 低 = 0;
    整数 高 = 表.长度() - 1;
    当 (低 <= 高)
    {
        整数 中 = 低 + (高 - 低) / 2;
        如果 (表[中] == 值)
        {
            返回 中;
        }
        如果 (表[中] < 值)
        {
            低 = 中 + 1;
        }
        否则
        {
            高 = 中 - 1;
        }
    }
    返回 -1;
}

// 逐对检查 `表[i-1] <= 表[i]`(一个元素也给 真)。
方法 是升序(整数 表[]) 返回 逻辑
{
    整数 i = 1;
    当 (i < 表.长度())
    {
        如果 (表[i] < 表[i - 1])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// k 从 **1** 开始;越界给 假 且不动 `收值`;算完不动调用方那张表。
方法 第k小(整数 表[], 整数 k, 引用 整数 收值) 返回 逻辑
{
    整数 个数 = 表.长度();
    如果 (k < 1 || k > 个数)
    {
        返回 假;
    }
    整数 副本[];
    整数 i = 0;
    当 (i < 个数)
    {
        副本.添加(表[i]);
        i = i + 1;
    }
    整数 轮 = 0;
    当 (轮 < k)
    {
        整数 最小位 = 轮;
        整数 j = 轮 + 1;
        当 (j < 个数)
        {
            如果 (副本[j] < 副本[最小位])
            {
                最小位 = j;
            }
            j = j + 1;
        }
        如果 (最小位 != 轮)
        {
            整数 暂 = 副本[轮];
            副本[轮] = 副本[最小位];
            副本[最小位] = 暂;
        }
        轮 = 轮 + 1;
    }
    收值 = 副本[k - 1];
    返回 真;
}

// 有就给 真 并把两个值写进引用参数。
方法 最大最小(整数 表[], 引用 整数 收最大, 引用 整数 收最小) 返回 逻辑
{
    如果 (表.长度() == 0)
    {
        返回 假;
    }
    整数 大 = 表[0];
    整数 小 = 表[0];
    整数 i = 1;
    当 (i < 表.长度())
    {
        如果 (表[i] > 大)
        {
            大 = 表[i];
        }
        如果 (表[i] < 小)
        {
            小 = 表[i];
        }
        i = i + 1;
    }
    收最大 = 大;
    收最小 = 小;
    返回 真;
}
