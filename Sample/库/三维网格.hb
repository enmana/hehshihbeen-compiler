// ============================================================
// 三维网格.hb —— 顶点 / 边 / 变换 / 透视投影 / 画线框(纯 HB,依赖 `三维数学.hb`)
//
//   定位:**素体与衣服都只是"一串网格"**,这一份不认识人体 —— 它只管
//   "顶点怎么进数组、怎么转、怎么投到屏幕上、怎么连成线画出来"。
//
// 三条口径(2026-10):
//   ① **顶点与边都放平数组**:顶点是三条并行的浮点数组(`顶点x/y/z`),边是两条整数数组
//      (`边起点/边终点`,存顶点下标)。**数组参数只收基础类型**(`整数 a[]` 行、`点 p[]` 不行)。
//   ② **横截面造形**(`加一圈`):给横截面的位置 / 方向 / 半宽 / 半深 / 方圆度,就长出一圈顶点;
//      `接圈` 再把相邻两圈纵着连成四边形线框。人体就是"一串横截面"堆出来的。
//   ③ **面数**:`接圈` 一次算一个面。
//
//   起名:帮手带 `三维网格` 前缀,没有以 `地址` 收尾的名字(以 `地址` 收尾再跟 `(` 会被当成内建的取地址)。
//   **声明与表达式都不能跨行**(跨行声明会被误报成 `地址() 缺少 ')'`)。
//
// 提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
模块 三维网格

// ---------- 网格大小上限(定长数组 ⇒ 编译期常量) ----------
//   ⚠ 定长数组**多要一点不花运行期代价**(只是静态数据段大一点)⇒ 宁可给宽:
//   加密到"细"那一档(躯干每圈 32 点、肢体 8 段)时,顶点约 2300、边约 9500 ——
//   边数**正好卡在旧的 8000 上限**上,于是后面的边被静默丢掉、模型上出现洞(实测踩过)。
方法 顶点上限() 返回 整数
{
    返回 8000;
}

// 本库边数组的容量:最多收 20000 条边(超过了就丢)。
方法 边上限() 返回 整数
{
    返回 20000;
}

// ---------- 网格本体:顶点 / 边 / 计数 ----------
浮点 顶点x[8000];
浮点 顶点y[8000];
浮点 顶点z[8000];
整数 边起点[20000];
整数 边终点[20000];
整数 顶点数 = 0;
整数 边数 = 0;
整数 面数 = 0;

// ---------- 面(实心填充那一档要的)----------
//   为什么单独一组:`边` 只能画线框;要**实心**就得知道"哪三个顶点围成一个三角"。
//   `读取模型`(宿主能力 56)现在**只给顶点 + 边** ⇒ 面要么由调用方自己补,
//   要么走下面那条 `加面`。容量与 `三维网格.hb` 的其它数组一个量级。
整数 面顶点0[12000];
整数 面顶点1[12000];
整数 面顶点2[12000];

// 加一个三角面(三个顶点下标),返回它的下标;满了给 -1
方法 加面(整数 顶点0, 整数 顶点1, 整数 顶点2) 返回 整数
{
    如果 (面数 >= 12000)
    {
        返回 -1;
    }
    面顶点0[面数] = 顶点0;
    面顶点1[面数] = 顶点1;
    面顶点2[面数] = 顶点2;
    面数 = 面数 + 1;
    返回 面数 - 1;
}

// ---------- 每 360 度 / 每圈份数(存下来省一次除法) ----------
浮点 单位角 = 0.0;
// 定位开关:置真就**不做背面剔除**(查实心画不出来时用;平时保持假)
逻辑 网格不剔除 = 假;

// 渲染观测值(给判据用;每次 画实心* 开头会归零)
整数 上次扫描线 = 0;
// 定位:投影之后面积三种符号各多少个面(定死退化面还是投影错)
整数 上次面积正 = 0;
整数 上次面积零 = 0;
整数 上次面积负 = 0;
整数 上次投不出 = 0;
整数 上次覆盖像素 = 0;

// ---------- 清空 ----------
//   ⚠ 这里**只把计数归零,不擦数组内容**(擦两万个格子要好几万条指令,而这门语言没有
//   `memset` 那一档)。后果是"没用过的格子"里留着上一回的残值 —— 本来无所谓(没人读它),
//   但它会让**两条腿的对拍**差出孤儿字节:实测 `示例56` 的内存对拍报
//   `0x1D018 虚拟机 0x01 / 原生 0x00`,而那个格子从头到尾没被写过(两个进程的堆布局不同)。
//   ⇒ **要逐字节比两边的内存,先调一次 `清数组()`**(它慢慢擦,只在自检 / 对拍里用得起)。
方法 清空() 返回 整数
{
    顶点数 = 0;
    边数 = 0;
    面数 = 0;
    返回 0;
}

// ---------- 把两个大数组**真擦干净**(顶点 / 边)----------
//   给"逐字节对拍"用的:擦完两边就没有"孤儿字节"了。**别放进每帧的路** ——
//   八千颗顶点 + 两万条边 = 五万六千个格子,要几万条指令,一帧里做一次就够呛。
方法 清数组() 返回 整数
{
    整数 i = 0;
    当 (i < 8000)
    {
        顶点x[i] = 0.0;
        顶点y[i] = 0.0;
        顶点z[i] = 0.0;
        i = i + 1;
    }
    i = 0;
    当 (i < 20000)
    {
        边起点[i] = 0;
        边终点[i] = 0;
        i = i + 1;
    }
    清空();
    返回 0;
}

// ---------- 把**外部读进来的模型**装进网格 ----------
//   口径与宿主能力 56 `读取模型` 的出口对齐:
//   · `装顶点(块地址, 几颗)`:块里是紧排的三个单精度浮点(x,y,z);
//   · `装边(块地址, 几条)`:块里是紧排的两个整型下标。
//   为什么分两步而不是一条"装模型":读模型那一步还要归一化、还要按上限判"装不下",
//   条数与容量对不对得上**只有调用方知道**(它申请的块多大自己清楚)⇒ 这里只做搬运,不猜。
//   返回真正装进去的条数(被上限截断时给的是截断后的数)。
//
//   ✅ **那条已修**(2026-10-11):调用方在**顶层**用 `顶点数` / `边数` 当自己的变量名
//   **不再出事**。根因是 `中间层C.结构与引用.cs` 的 `查变量` **先按裸名一路找到底** ——
//   库(`包含` 进来的 `模块`)内部的裸名字会命中调用方顶层的同名变量,于是 `清空()` 把调用方那个
//   变量抹成 0、当实参传进来就是 0,而编译器一声不响;现在改成"模块里**本模块自己那一份优先**"
//   (局部/参数 → 模块自己 → 顶层)。
//   (旧口径留在这里当记录:函数里收到的 `几颗` 会是 0,一颗都装不进去,且不报错。)
方法 装顶点(地址 块, 整数 几颗) 返回 整数
{
    整数 i = 0;
    当 (i < 几颗 && 顶点数 < 8000)
    {
        顶点x[顶点数] = 三维网格取浮点(块, i * 12);
        顶点y[顶点数] = 三维网格取浮点(块, i * 12 + 4);
        顶点z[顶点数] = 三维网格取浮点(块, i * 12 + 8);
        顶点数 = 顶点数 + 1;
        i = i + 1;
    }
    返回 i;
}

// 把块里 几条 边(每条两个下标,8 字节)搬进网格;返回真装进去的条数(顶到 20000 截断)。
方法 装边(地址 块, 整数 几条) 返回 整数
{
    整数 i = 0;
    当 (i < 几条 && 边数 < 20000)
    {
        边起点[边数] = 整数(取字(块, i * 8));
        边终点[边数] = 整数(取字(块, i * 8 + 4));
        边数 = 边数 + 1;
        i = i + 1;
    }
    返回 i;
}

// ---------- 把**外部读进来的面**装进网格 ----------
//   块里是紧排的三个整数下标(每条面 12 字节)—— 与宿主能力 56 的"面块"同一个排法。
//   **绕向照原样搬**(不重排):`画实心` 的背面剔除要用它。
方法 装面(地址 块, 整数 几个) 返回 整数
{
    整数 i = 0;
    整数 面下标 = 0;
    当 (i < 几个 && 面数 < 12000)
    {
        面下标 = 面数;
        面顶点0[面下标] = 整数(取字(块, i * 12));
        面顶点1[面下标] = 整数(取字(块, i * 12 + 4));
        面顶点2[面下标] = 整数(取字(块, i * 12 + 8));
        面数 = 面数 + 1;
        i = i + 1;
    }
    返回 i;
}

// ---------- 私有:从一个块里读一个单精度浮点(位模式 → 整数 → 浮点) ----------
//   为什么要过一手:`取字` 给的是**位模式**(32 位整数),直接当浮点用会把 1.5 读成 1069547520。
//   这门语言没有"位模式转浮点"的内建 ⇒ 这里按符号 / 指数 / 尾数自己拼(与 `float32.hb` 同一套算法)。
私有 方法 三维网格取浮点(地址 块, 整数 偏移) 返回 浮点
{
    无符号整数 位 = 取字(块, 偏移);
    整数 符号 = 0;
    无符号整数 指数 = (位 >> 23) % 256;
    无符号整数 尾数 = 位 % 8388608;
    如果 (指数 == 0 && 尾数 == 0)
    {
        返回 0.0;                                  // ±0
    }
    如果 (指数 == 255)
    {
        返回 0.0;                                  // Inf / NaN 一律给 0(3D 里当"没有这个点")
    }
    浮点 值 = 1.0 + 浮点(尾数) / 8388608.0;        // 1.尾数
    整数 幂 = 整数(指数) - 127;
    当 (幂 > 0)
    {
        值 = 值 * 2.0;
        幂 = 幂 - 1;
    }
    当 (幂 < 0)
    {
        值 = 值 / 2.0;
        幂 = 幂 + 1;
    }
    如果 (位 >= 2147483648)
    {
        值 = 0.0 - 值;                             // 最高位是符号位
    }
    返回 值;
}

// ---------- 加一个顶点,返回它的下标 ----------
方法 加顶点(浮点 px, 浮点 py, 浮点 pz) 返回 整数
{
    如果 (顶点数 >= 8000)
    {
        返回 -1;
    }
    顶点x[顶点数] = px;
    顶点y[顶点数] = py;
    顶点z[顶点数] = pz;
    顶点数 = 顶点数 + 1;
    返回 顶点数 - 1;
}

// ---------- 加一条边 ----------
方法 加边(整数 起点, 整数 终点) 返回 整数
{
    如果 (起点 < 0 || 终点 < 0)
    {
        返回 -1;
    }
    如果 (起点 == 终点)
    {
        返回 -1;
    }
    如果 (边数 >= 20000)
    {
        返回 -1;
    }
    边起点[边数] = 起点;
    边终点[边数] = 终点;
    边数 = 边数 + 1;
    返回 边数 - 1;
}

// ---------- `加一圈` 的草稿变量(模块级:帧里放不下) ----------
浮点 环_轴长 = 0.0;
浮点 环_ux = 0.0;
浮点 环_uy = 0.0;
浮点 环_uz = 0.0;
浮点 环_sx = 0.0;
浮点 环_sy = 0.0;
浮点 环_sz = 0.0;
浮点 环_fx = 0.0;
浮点 环_fy = 0.0;
浮点 环_fz = 0.0;
浮点 环_侧长 = 0.0;
浮点 环_角 = 0.0;
浮点 环_余 = 0.0;
浮点 环_正 = 0.0;
浮点 环_压 = 0.0;
浮点 环_侧 = 0.0;
浮点 环_前 = 0.0;
整数 环_首 = 0;
整数 环_k = 0;

// ---------- 加一圈横截面(这一圈自己首尾相接) ----------
//   `中心x/中心y/中心z` 横截面中心;`向x/向y/向z` 轴向(先归一化,零向量按 +Y);
//   `半宽` 沿侧向、`半深` 沿前后向;`方圆` 0 = 椭圆、1 = 圆角矩形;`每圈` 这一圈几个顶点。
//   返回这一圈**第 0 个顶点的下标**。
方法 加一圈(浮点 中心x, 浮点 中心y, 浮点 中心z, 浮点 向x, 浮点 向y, 浮点 向z, 浮点 半宽, 浮点 半深, 浮点 方圆, 整数 每圈) 返回 整数
{
    环_轴长 = 三维数学.开方(向x * 向x + 向y * 向y + 向z * 向z);
    如果 (环_轴长 < 0.000001)
    {
        向x = 0.0;
        向y = 1.0;
        向z = 0.0;
        环_轴长 = 1.0;
    }
    环_ux = 向x / 环_轴长;
    环_uy = 向y / 环_轴长;
    环_uz = 向z / 环_轴长;
    // 侧向 = 轴 × 世界Y;轴接近竖直时退化 ⇒ 改用世界X
    环_sx = 0.0 - 环_uz;
    环_sy = 0.0;
    环_sz = 环_ux;
    环_侧长 = 三维数学.开方(环_sx * 环_sx + 环_sy * 环_sy + 环_sz * 环_sz);
    如果 (环_侧长 < 0.0001)
    {
        环_sx = 1.0;
        环_sy = 0.0;
        环_sz = 0.0;
        环_侧长 = 1.0;
    }
    环_sx = 环_sx / 环_侧长;
    环_sy = 环_sy / 环_侧长;
    环_sz = 环_sz / 环_侧长;
    // 前后向 = 侧向 × 轴
    环_fx = 环_sy * 环_uz - 环_sz * 环_uy;
    环_fy = 环_sz * 环_ux - 环_sx * 环_uz;
    环_fz = 环_sx * 环_uy - 环_sy * 环_ux;
    环_首 = 顶点数;
    单位角 = 6.28318531 / 浮点(每圈);
    环_k = 0;
    当 (环_k < 每圈)
    {
        环_角 = 单位角 * 浮点(环_k);
        环_正 = 三维数学.正弦(环_角);
        环_余 = 三维数学.余弦(环_角);
        // 方圆:按 |cos| 压一格 ⇒ 0 = 椭圆、1 = 圆角矩形
        环_压 = 1.0 - 方圆;
        如果 (环_余 < 0.0)
        {
            环_压 = 环_压 + 方圆 * (0.0 - 环_余);
        }
        否则
        {
            环_压 = 环_压 + 方圆 * 环_余;
        }
        环_侧 = 半宽 * 环_余 * 环_压;
        环_前 = 半深 * 环_正 * 环_压;
        加顶点(中心x + 环_sx * 环_侧 + 环_fx * 环_前, 中心y + 环_sy * 环_侧 + 环_fy * 环_前, 中心z + 环_sz * 环_侧 + 环_fz * 环_前);
        环_k = 环_k + 1;
    }
    // 环向的边(首尾相接)
    环_k = 0;
    当 (环_k < 每圈)
    {
        整数 本 = 环_首 + 环_k;
        整数 下 = 环_首 + 环_k + 1;
        如果 (下 >= 环_首 + 每圈)
        {
            下 = 环_首;
        }
        加边(本, 下);
        环_k = 环_k + 1;
    }
    面数 = 面数 + 1;
    返回 环_首;
}

// ---------- 接圈:把相邻两圈纵着连成四边形线框 ----------
//   两个参数各自是那一圈的第 0 个顶点下标(见 `加一圈` 的返回值)。
方法 接圈(整数 上圈首, 整数 下圈首, 整数 每圈) 返回 整数
{
    整数 k = 0;
    整数 上圈邻 = 0;
    整数 下圈邻 = 0;
    当 (k < 每圈)
    {
        上圈邻 = 上圈首 + k + 1;
        下圈邻 = 下圈首 + k + 1;
        如果 (上圈邻 >= 上圈首 + 每圈)
        {
            上圈邻 = 上圈首;
        }
        如果 (下圈邻 >= 下圈首 + 每圈)
        {
            下圈邻 = 下圈首;
        }
        加边(上圈首 + k, 下圈首 + k);
        加边(上圈首 + k, 下圈邻);
        加边(上圈邻, 下圈首 + k);
        k = k + 1;
    }
    面数 = 面数 + 每圈;
    返回 0;
}

// ---------- `加管` 的草稿变量 ----------
浮点 管_步x = 0.0;
浮点 管_步y = 0.0;
浮点 管_步z = 0.0;
浮点 管_比 = 0.0;
浮点 管_半 = 0.0;
浮点 管_本x = 0.0;
浮点 管_本y = 0.0;
浮点 管_本z = 0.0;
浮点 管_扁深 = 0.0;
整数 管_上圈 = 0;
整数 管_首 = 0;
整数 管_i = 0;
整数 管_圈首 = 0;

// ---------- 加一根"管":一串横截面从起点长到终点,半径可变化 ----------
//   四肢 / 颈 / 手指都用它。`扁` = 深度方向的半径比(1 = 圆截面)。
方法 加管(浮点 起x, 浮点 起y, 浮点 起z, 浮点 止x, 浮点 止y, 浮点 止z, 浮点 起半径, 浮点 止半径, 浮点 扁, 整数 每圈, 整数 分几段) 返回 整数
{
    如果 (分几段 < 1)
    {
        分几段 = 1;
    }
    管_步x = (止x - 起x) / 浮点(分几段);
    管_步y = (止y - 起y) / 浮点(分几段);
    管_步z = (止z - 起z) / 浮点(分几段);
    管_首 = 顶点数;
    管_上圈 = -1;
    管_i = 0;
    当 (管_i <= 分几段)
    {
        管_比 = 浮点(管_i) / 浮点(分几段);
        管_半 = 起半径 + (止半径 - 起半径) * 管_比;
        管_扁深 = 管_半 * 扁;
        管_本x = 起x + 管_步x * 浮点(管_i);
        管_本y = 起y + 管_步y * 浮点(管_i);
        管_本z = 起z + 管_步z * 浮点(管_i);
        管_圈首 = 加一圈(管_本x, 管_本y, 管_本z, 管_步x, 管_步y, 管_步z, 管_半, 管_扁深, 0.0, 每圈);
        如果 (管_上圈 >= 0)
        {
            接圈(管_上圈, 管_圈首, 每圈);
        }
        管_上圈 = 管_圈首;
        管_i = 管_i + 1;
    }
    返回 管_首;
}

// ---------- 变换与投影 ----------
//   旋转矩阵九个元素(先绕 X、再绕 Y、最后绕 Z;右乘列向量,与 `三维数学` 同一个约定)。
//   ⚠ 放模块级:九个浮点 36 字节,放局部就把 96 字节的帧吃掉一半。
浮点 矩00 = 1.0;
浮点 矩01 = 0.0;
浮点 矩02 = 0.0;
浮点 矩10 = 0.0;
浮点 矩11 = 1.0;
浮点 矩12 = 0.0;
浮点 矩20 = 0.0;
浮点 矩21 = 0.0;
浮点 矩22 = 1.0;

// 按弧度定下旋转矩阵(先绕 X、再绕 Y、后绕 Z);矩阵摆好,顶点用 投点 转。
方法 摆角(浮点 绕x, 浮点 绕y, 浮点 绕z) 返回 整数
{
    浮点 cx = 三维数学.余弦(绕x);
    浮点 sx = 三维数学.正弦(绕x);
    浮点 cy = 三维数学.余弦(绕y);
    浮点 sy = 三维数学.正弦(绕y);
    浮点 cz = 三维数学.余弦(绕z);
    浮点 sz = 三维数学.正弦(绕z);
    矩00 = cy * cz;
    矩01 = 0.0 - cy * sz;
    矩02 = sy;
    矩10 = sx * sy * cz + cx * sz;
    矩11 = cx * cz - sx * sy * sz;
    矩12 = 0.0 - sx * cy;
    矩20 = sx * sz - cx * sy * cz;
    矩21 = sx * cz + cx * sy * sz;
    矩22 = cx * cy;
    返回 0;
}

// 只绕 y 转(最常用;少算四个三角函数)
方法 摆偏航(浮点 绕y) 返回 整数
{
    浮点 cy = 三维数学.余弦(绕y);
    浮点 sy = 三维数学.正弦(绕y);
    矩00 = cy;
    矩01 = 0.0;
    矩02 = sy;
    矩10 = 0.0;
    矩11 = 1.0;
    矩12 = 0.0;
    矩20 = 0.0 - sy;
    矩21 = 0.0;
    矩22 = cy;
    返回 0;
}

// ---------- 相机 / 视口参数 ----------
//   口径按**厘米**定(模型本身就是厘米:身高约 172)⇒ 眼距 900、焦距 2400,
//   于是"172 高的身子"在 520 高的窗口里占约 172 × 2400/900 ≈ 459 像素(**留一圈边**,头脚都不裁)。
浮点 眼距 = 900.0;                      // 相机离原点多远(厘米)
浮点 焦距 = 2400.0;                     // 焦距(像素)
浮点 画心x = 240.0;                     // 视口中心(与窗口同口径)
浮点 画心y = 260.0;
浮点 画宽 = 480.0;
浮点 画高 = 520.0;
浮点 留白 = 50.0;                       // 出屏多少像素以内还算"该画"

// ---------- 投影的产出口 ----------
//   ⚠ 这一门语言的 `出` 只认基础类型("引用指向的类型不认识: '出'")⇒ 投影结果走模块级变量。
整数 屏x = 0;
整数 屏y = 0;
// 调试口径:最近一次 `投点` 的中间量(排查投影时直接看它们;平时不用)
浮点 探rx = 0.0;
浮点 探ry = 0.0;
浮点 探rz = 0.0;
浮点 探深 = 0.0;
浮点 探大小 = 0.0;
浮点 探sx = 0.0;
浮点 探sy = 0.0;
浮点 探远近 = 0.0;
浮点 探正x = 0.0;
浮点 探正y = 0.0;
浮点 探上x = 0.0;
浮点 探上y = 0.0;
整数 探越x = 0;
整数 探越y = 0;

// ---------- 把一个顶点投到屏幕 ----------
//   返回 **> 0 可以画**(值 = 屏幕上的大小系数),**<= 0 不该画**(相机后面 / 出视口);
//   屏幕坐标在 `屏x` / `屏y`。
//
//   ⚠⚠ **这一段的写法是被缺陷逼出来的,别顺手改成"正常写法"**:
//   这门语言的浮点条件跳转曾经只发整数比较(已修:任一边是浮点就走 `浮点比较` 0x3D),
//   但**浮点常数折叠对负数仍然错**(`0.0 - 50.0` 会折成 49.0)⇒
//   这里**一个负的浮点常量都不写**:视口判断用
//     `探sx + 留白 > 画宽 + 留白 + 留白`(出右)与 `探sx + 留白 < 0.0`(出左),
//   两边都落在非负数上 —— 于是那一处折叠缺陷不会咬到。
方法 投点(浮点 px, 浮点 py, 浮点 pz) 返回 浮点
{
    探rx = 矩00 * px + 矩01 * py + 矩02 * pz;
    探ry = 矩10 * px + 矩11 * py + 矩12 * pz;
    探rz = 矩20 * px + 矩21 * py + 矩22 * pz;
    探深 = 眼距 - 探rz;
    探远近 = 探深 - 0.2;                       // >= 0 才在相机前面
    如果 (探远近 >= 0.0)
    {
        探大小 = 焦距 / 探深;
        探sx = 画心x + 探rx * 探大小;
        探sy = 画心y - 探ry * 探大小;
        // 平移到"以 0 为左下角"的坐标系里,再用两个正数比
        探正x = 探sx + 留白;
        探正y = 探sy + 留白;
        探上x = 画宽 + 留白 + 留白;
        探上y = 画高 + 留白 + 留白;
        探越x = 0;
        探越y = 0;
        如果 (探正x > 探上x)
        {
            探越x = 1;
        }
        如果 (探正y > 探上y)
        {
            探越y = 1;
        }
        如果 (探正x < 0.0)
        {
            探越x = 1;
        }
        如果 (探正y < 0.0)
        {
            探越y = 1;
        }
        如果 (探越x == 0 && 探越y == 0)
        {
            屏x = 整数(探sx);
            屏y = 整数(探sy);
            返回 探大小;
        }
    }
    返回 0.0 - 1.0;
}

// ---------- 画线框:整张网格的边逐条投出来画掉 ----------
//   返回真正画出来的边数。
方法 画线框(整数 颜色) 返回 整数
{
    整数 画了 = 0;
    整数 i = 0;
    整数 起点 = 0;
    整数 终点 = 0;
    浮点 起系数 = 0.0;
    浮点 终系数 = 0.0;
    整数 ax = 0;
    整数 ay = 0;
    当 (i < 边数)
    {
        起点 = 边起点[i];
        终点 = 边终点[i];
        起系数 = 投点(顶点x[起点], 顶点y[起点], 顶点z[起点]);
        如果 (起系数 > 0.0)
        {
            ax = 屏x;
            ay = 屏y;
            终系数 = 投点(顶点x[终点], 顶点y[终点], 顶点z[终点]);
            如果 (终系数 > 0.0)
            {
                画线(ax, ay, 屏x, 屏y, 颜色);
                画了 = 画了 + 1;
            }
        }
        i = i + 1;
    }
    返回 画了;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// **实心填充**(画家算法 + 扫描线)
//
//   口径说清:
//   · **画家算法**(远→近):不建 z 缓冲(那要一整屏的内存 + 每像素比较),
//     而是把三角按**平均深度**排序,远的先画、近的后画 —— 对"凸的、不太自遮挡的"
//     模型(人体、器物、地形块)够用;真要严格遮挡得等位图那一档的 z 缓冲。
//   · **背面剔除**:法线朝外的面不画(既要不到、又省一半填充)。
//     判断用屏幕空间的有向面积(叉积符号)—— 不算法线、不用开方。
//   · **扫描线**:一条水平线一次 `画线`,不是逐像素画。`画线` 是宿主能力,
//     一次调用画一整条 ⇒ 一帧的往返次数 = 屏幕高度那个量级,不是像素数那个量级。
//   · 深度用**顶点 z 的平均**(透视前的相机空间 z)当排序键。
//
//   ⚠ 帧只有 96 字节 ⇒ 所有草稿变量放**模块级**(这一份库从头到尾都这个规矩)。
//   ⚠ 要实心得先有**面**:`读取模型`(宿主能力 56)现在只给顶点 + 边,
//     面要调用方自己用 `加面` 补(或者以后给 `读取模型` 加"要面"那一档)。
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// ---- 填充用的草稿(全模块级)----
整数 填_i = 0;
整数 填_j = 0;
整数 填_序[12000];          // 按深度排好的面序(远→近)
浮点 填_深[12000];          // 每个面的平均深度
浮点 填_ax = 0.0;
浮点 填_ay = 0.0;
浮点 填_az = 0.0;
浮点 填_bx = 0.0;
浮点 填_by = 0.0;
浮点 填_bz = 0.0;
浮点 填_cx = 0.0;
浮点 填_cy = 0.0;
浮点 填_cz = 0.0;
整数 填_sx1 = 0;
整数 填_sy1 = 0;
整数 填_sx2 = 0;
整数 填_sy2 = 0;
整数 填_sx3 = 0;
整数 填_sy3 = 0;
浮点 填_面积 = 0.0;
整数 填_画了 = 0;
// ⚠ 面的三个顶点下标也要草稿:这门语言**不认嵌套的数组下标**(`顶点z[面顶点0[面]]` 报
//   "数组下标须为 常量/寄存器/变量/字段/表达式")⇒ 必须先取到一个变量里再用(实测踩过)。
整数 填_v1 = 0;
整数 填_v2 = 0;
整数 填_v3 = 0;

// 投一个点并把屏幕坐标记进 (x, y);返回"投得出来吗"
私有 方法 三维网格填投(浮点 px, 浮点 py, 浮点 pz, 整数 槽) 返回 逻辑
{
    浮点 可 = 投点(px, py, pz);
    如果 (可 <= 0.0)
    {
        返回 假;
    }
    如果 (槽 == 0)
    {
        填_sx1 = 屏x;
        填_sy1 = 屏y;
    }
    如果 (槽 == 1)
    {
        填_sx2 = 屏x;
        填_sy2 = 屏y;
    }
    如果 (槽 == 2)
    {
        填_sx3 = 屏x;
        填_sy3 = 屏y;
    }
    返回 真;
}

// 一个三角:**真扫描线**填 —— 逐行算出左右两个交点,每行画一整条横线
//   ⚠ 第一版把三条边各自"当极扁三角"逐行画**一个点** —— 那不是实心,是一圈点
//   (实测:一帧只有 52 条 `画线`,而线框是 620 条 ⇒ 一眼看出没填上)。
//   真填法的往返次数 = **三角形在屏幕上的高度**,与宽度无关 —— 那才是省往返的地方。
私有 方法 三维网格填三角(整数 颜色) 返回 整数
{
    整数 上y = 填_sy1;
    整数 下y = 填_sy1;
    整数 画了 = 0;
    // 三点的 y 范围
    如果 (填_sy2 < 上y)
    {
        上y = 填_sy2;
    }
    如果 (填_sy3 < 上y)
    {
        上y = 填_sy3;
    }
    如果 (填_sy2 > 下y)
    {
        下y = 填_sy2;
    }
    如果 (填_sy3 > 下y)
    {
        下y = 填_sy3;
    }
    填_本y = 上y;
    当 (填_本y <= 下y)
    {
        // 三条边各并一次 ⇒ 这一行的左右边界
        填_左 = 999999;
        填_右 = 0 - 999999;
        填_边x1 = 填_sx1;
        填_边y1 = 填_sy1;
        填_边x2 = 填_sx2;
        填_边y2 = 填_sy2;
        三维网格填并边();
        填_边x1 = 填_sx2;
        填_边y1 = 填_sy2;
        填_边x2 = 填_sx3;
        填_边y2 = 填_sy3;
        三维网格填并边();
        填_边x1 = 填_sx3;
        填_边y1 = 填_sy3;
        填_边x2 = 填_sx1;
        填_边y2 = 填_sy1;
        三维网格填并边();
        如果 (填_左 <= 填_右)
        {
            画线(填_左, 填_本y, 填_右, 填_本y, 颜色);
            画了 = 画了 + 1;
            // **两个观测值** —— 实心到底盖了多少用它们当中立判据(不靠肉眼看图):
            //   上次扫描线 = 一共画了几条横线;上次覆盖像素 = 这些横线**覆盖的格子数**。
            //   实心:后者远大于前者(每条线横跨几十上百格);线框/点:两者差不多。
            上次扫描线 = 上次扫描线 + 1;
            上次覆盖像素 = 上次覆盖像素 + (填_右 - 填_左) + 1;
        }
        填_本y = 填_本y + 1;
    }
    返回 画了;
}

// 求"某条边在 y 这一行的 x",并把它并进 (填_左, 填_右)
//   ⚠ 参数不能多:第一版写了 7 个参数 + 一个相乘的表达式 ⇒ **临时寄存器用光**
//   (实测报"这一句太复杂了")⇒ 改成"边进模块变量、结果进模块变量",一个参数都不传。
整数 填_边x1 = 0;
整数 填_边y1 = 0;
整数 填_边x2 = 0;
整数 填_边y2 = 0;
整数 填_本y = 0;
整数 填_左 = 0;
整数 填_右 = 0;

私有 方法 三维网格填并边() 返回 整数
{
    整数 上y = 填_边y1;
    整数 下y = 填_边y2;
    整数 上x = 填_边x1;
    整数 下x = 填_边x2;
    整数 本x = 0;
    浮点 比 = 0.0;
    如果 (填_边y1 > 填_边y2)
    {
        上y = 填_边y2;
        下y = 填_边y1;
        上x = 填_边x2;
        下x = 填_边x1;
    }
    如果 (填_本y < 上y || 填_本y > 下y)
    {
        返回 0;
    }
    如果 (上y == 下y)
    {
        本x = 上x;
    }
    否则
    {
        比 = 浮点(填_本y - 上y) / 浮点(下y - 上y);
        本x = 上x + 整数(浮点(下x - 上x) * 比);
    }
    如果 (本x < 填_左)
    {
        填_左 = 本x;
    }
    如果 (本x > 填_右)
    {
        填_右 = 本x;
    }
    返回 0;
}

// ---------- 一个面的"取下标 → 投三次 → 算面积" —— 两条实心共用这一段 ----------
//   ⚠ **为什么要提出来**:`画实心` 与 `画实心带光` 原来是**两份各自实现的循环**,逐行几乎一样。
//   我(第 33 轮)插取证时插进了其中一份、却拿另一份测 ⇒ 白查两轮。
//   在这块地方,**重复代码就是骗自己的地方** —— 合成一处,改一处就是两处都改。
//
//   返回:1 = 该画这个面(面积符号对,或调用方开了 `网格不剔除`);0 = 不画。
//   ⚠ 顺带把面积那**一个长表达式拆成几步**、每步落一个具名变量 ——
//   这门语言有 F-6/F-8 那一族"变量/参数被串"的已知缺陷,长表达式拆开才好定位。
私有 方法 三维网格填备面(整数 面号) 返回 整数
{
    填_v1 = 面顶点0[面号];
    填_v2 = 面顶点1[面号];
    填_v3 = 面顶点2[面号];
    填_az = 顶点z[填_v1];
    填_bz = 顶点z[填_v2];
    填_cz = 顶点z[填_v3];
    如果 (三维网格填投(顶点x[填_v1], 顶点y[填_v1], 填_az, 0) == 假)
    {
        上次投不出 = 上次投不出 + 1;
        返回 0;
    }
    如果 (三维网格填投(顶点x[填_v2], 顶点y[填_v2], 填_bz, 1) == 假)
    {
        上次投不出 = 上次投不出 + 1;
        返回 0;
    }
    如果 (三维网格填投(顶点x[填_v3], 顶点y[填_v3], 填_cz, 2) == 假)
    {
        上次投不出 = 上次投不出 + 1;
        返回 0;
    }
    填_e1x = 填_sx2 - 填_sx1;
    填_e1y = 填_sy3 - 填_sy1;
    填_e2x = 填_sx3 - 填_sx1;
    填_e2y = 填_sy2 - 填_sy1;
    填_面积 = 浮点(填_e1x * 填_e1y - 填_e2x * 填_e2y);
    如果 (填_面积 > 0.0)
    {
        上次面积正 = 上次面积正 + 1;
    }
    如果 (填_面积 == 0.0)
    {
        上次面积零 = 上次面积零 + 1;
    }
    如果 (填_面积 < 0.0)
    {
        上次面积负 = 上次面积负 + 1;
    }
    如果 (填_面积 > 0.0 || 网格不剔除)
    {
        返回 1;
    }
    返回 0;
}

// 面积拆开用的中间量(模块级:帧只有 96 字节)
整数 填_e1x = 0;
整数 填_e1y = 0;
整数 填_e2x = 0;
整数 填_e2y = 0;

// ---------- 画实心:整张网格的面按深度排序后逐个填 ----------
//   `颜色` 是面的颜色;返回真正填出来的面数。
方法 画实心(整数 颜色) 返回 整数
{
    整数 面 = 0;
    浮点 深 = 0.0;
    整数 排 = 0;
    整数 从 = 0;
    整数 换 = 0;
    浮点 换深 = 0.0;
    整数 填了 = 0;
    上次扫描线 = 0;
    上次覆盖像素 = 0;
    上次面积正 = 0;
    上次面积零 = 0;
    上次面积负 = 0;
    上次投不出 = 0;
    上次亮最小 = 999999;
    上次亮最大 = 0 - 999999;
    如果 (面数 == 0)
    {
        返回 0;
    }
    // ① 每个面的平均深度(z 越大越远)
    面 = 0;
    当 (面 < 面数)
    {
        填_v1 = 面顶点0[面];
        填_v2 = 面顶点1[面];
        填_v3 = 面顶点2[面];
        填_az = 顶点z[填_v1];
        填_bz = 顶点z[填_v2];
        填_cz = 顶点z[填_v3];
        填_深[面] = (填_az + 填_bz + 填_cz) / 3.0;
        填_序[面] = 面;
        面 = 面 + 1;
    }
    // ② 按深度**从远到近**排(简单插入排序:面数上千时也够快,而且不占额外内存)
    //   ⚠ 内层那句 `填_深[填_序[从]]` 是**嵌套下标**,这门语言不认 ⇒ 先把下标取到变量里。
    排 = 1;
    当 (排 < 面数)
    {
        换 = 填_序[排];
        换深 = 填_深[换];
        从 = 排 - 1;
        当 (从 >= 0)
        {
            填_j = 填_序[从];
            如果 (填_深[填_j] >= 换深)
            {
                从 = 0 - 1;
            }
            否则
            {
                填_序[从 + 1] = 填_j;
                从 = 从 - 1;
            }
        }
        填_序[从 + 1] = 换;
        排 = 排 + 1;
    }
    // ③ 远的先画
    填_i = 0;
    当 (填_i < 面数)
    {
        面 = 填_序[填_i];
        // 取下标 / 投三次 / 算面积 / 剔除 —— 全在 `三维网格填备面` 里(**两条实心共用**)
        如果 (三维网格填备面(面) == 1)
        {
            三维网格填三角(颜色);
            填了 = 填了 + 1;
        }
        填_i = 填_i + 1;
    }
    返回 填了;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// **明暗着色**(面法线 · 点积 · 明暗)
//
//   口径:一个**方向光**(不是点光源 —— 点光源要算"每点到光源的方向",那是逐顶点的事)。
//   逐面算一次:
//     ① 面的**法线** = (顶点1−顶点0) × (顶点2−顶点0)(右手叉积,三个分量都要);
//     ② **朗伯** = |法线 · 光方向| —— ⚠ 取**绝对值**:面朝里朝外都能被照到,
//        省掉"绕向要对"这件麻烦事(代价是背面也亮,但没有背面朝向光的时候它无所谓);
//     ③ **明暗系数** = 环境光 + (1 − 环境光) × 朗伯,夹在 [0,1];
//     ④ 颜色 = 基色 × 系数(三个通道各乘一次)。
//
//   ⚠ 法线**不归一化**也行(点积只差一个长度因子)—— 但那样亮度会随三角形大小变,
//     所以要除以它自己的长度。开方用 `三维数学.开方`(那是自己写的牛顿迭代,不用宿主)。
//
//   ⚠ 颜色是 `0xAARRGGBB` 的整数 ⇒ 拆成三个分量、各乘一次、再拼回去;
//     高位保留原来的 alpha(不参与着色)。
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 光方向(默认从左上前方照过来;要改就改这三个数,不必归一化)
浮点 光x = 0.4;
浮点 光y = 0.6;
浮点 光z = 0.7;
// 环境光占的比例(0 = 全黑背光面,1 = 全是平的) —— 0.25 看着有立体感又不死黑
浮点 环境光 = 0.25;

// 着色用的草稿(模块级:帧只有 96 字节)
浮点 着_nx = 0.0;
浮点 着_ny = 0.0;
浮点 着_nz = 0.0;
浮点 着_长 = 0.0;
浮点 着_亮 = 0.0;
浮点 着_系数 = 0.0;
整数 着_r = 0;
整数 着_g = 0;
整数 着_b = 0;
整数 着_a = 0;
无符号整数 着_色 = 0;
整数 着色_i = 0;            // 基色的位模式(按 `整数` 解释 —— 整除必须是整数运算)
整数 着色_余 = 0;
整数 着_千分 = 1000;
// 观测"亮度到底有没有随朝向变" —— 记下系数的最小/最大
整数 上次亮最小 = 999999;
整数 上次亮最大 = 0 - 999999;        // 明暗系数 × 1000(整数,避开浮点截断)

// 把当前这个面(填_v1/v2/v3 那三个下标)的明暗系数算进 `着_系数`
私有 方法 三维网格着算亮度() 返回 整数
{
    浮点 ux = 顶点x[填_v2] - 顶点x[填_v1];
    浮点 uy = 顶点y[填_v2] - 顶点y[填_v1];
    浮点 uz = 顶点z[填_v2] - 顶点z[填_v1];
    浮点 vx = 顶点x[填_v3] - 顶点x[填_v1];
    浮点 vy = 顶点y[填_v3] - 顶点y[填_v1];
    浮点 vz = 顶点z[填_v3] - 顶点z[填_v1];
    着_nx = uy * vz - uz * vy;
    着_ny = uz * vx - ux * vz;
    着_nz = ux * vy - uy * vx;
    着_长 = 三维数学.开方(着_nx * 着_nx + 着_ny * 着_ny + 着_nz * 着_nz);
    如果 (着_长 < 0.000001)
    {
        着_系数 = 环境光;                      // 退化成一条线:给个环境光,别让它是黑的
        返回 0;
    }
    着_亮 = (着_nx * 光x + 着_ny * 光y + 着_nz * 光z) / 着_长;
    着_亮 = 搬符号(着_亮, 1.0);             // 取绝对值:背面也照到(见上面口径)
    着_亮 = 取较小(着_亮, 1.0);             // 三条都是语言内建的浮点指令(各一条,零分支)
    着_系数 = 环境光 + (1.0 - 环境光) * 着_亮;
    // ⚠⚠ **必须钳死**:不钳的话 `着_千分` 会溢出成 -2147483648(实测),
    //   于是每个通道乘出来都是垃圾 —— 这是"颜色塌成一个"的第二半原因。
    着_系数 = 取较小(着_系数, 1.0);
    着_系数 = 取较大(着_系数, 0.0);
    着_千分 = 整数(着_系数 * 1000.0);        // 换成正整数给 `三维网格着上色` 用
    如果 (着_千分 < 上次亮最小)
    {
        上次亮最小 = 着_千分;
    }
    如果 (着_千分 > 上次亮最大)
    {
        上次亮最大 = 着_千分;
    }
    返回 0;
}

// 把基色乘上 `着_系数`,结果放进 `着_色`
私有 方法 三维网格着上色(无符号整数 基色) 返回 整数
{
    // ⚠⚠ **别对"无符号整数"做整除/取模** —— 实测它走了浮点,大数会静默算错:
    //   `无符号整数 x = 4290705640; x / 65536` 给 **65470**(应当 65464)、
    //   `x % 256` 给 **184**(应当 232)。原因:float32 存不下这个数,被舍入成 4290705664。
    //   ⇒ 位模式与 `整数` 一模一样,所以**先用 `整数` 把位接过来**再做整除,最后按位拼回。
    着色_i = 整数(基色);
    着_a = 着色_i / 16777216;
    着色_余 = 着色_i - 着_a * 16777216;
    着_r = 着色_余 / 65536;
    着色_余 = 着色_余 - 着_r * 65536;
    着_g = 着色_余 / 256;
    着_b = 着色_余 - 着_g * 256;
    // 亮度:先乘后除,避免浮点截断掉 1(0.5 × 191 要给 95,不是 95 少 1)
    着_a = 着_a * 着_千分 / 1000;
    着_r = 着_r * 着_千分 / 1000;
    着_g = 着_g * 着_千分 / 1000;
    着_b = 着_b * 着_千分 / 1000;
    着_色 = 着_a * 16777216 + 着_r * 65536 + 着_g * 256 + 着_b;
    返回 0;
}

// ---------- 画带明暗的实心 ----------
//   与 `画实心` 同一条路,只是**每个面按自己的法线算一次亮度**再填。
//   多出来的成本:每面一次叉积 + 一次开方 + 几次乘法 —— 与"扫描线填充"比可以忽略。
方法 画实心带光(无符号整数 基色) 返回 整数
{
    整数 面 = 0;
    浮点 深 = 0.0;
    整数 排 = 0;
    整数 从 = 0;
    整数 换 = 0;
    浮点 换深 = 0.0;
    整数 填了 = 0;
    上次扫描线 = 0;
    上次覆盖像素 = 0;
    上次面积正 = 0;
    上次面积零 = 0;
    上次面积负 = 0;
    上次投不出 = 0;
    上次亮最小 = 999999;
    上次亮最大 = 0 - 999999;
    如果 (面数 == 0)
    {
        返回 0;
    }
    面 = 0;
    当 (面 < 面数)
    {
        填_v1 = 面顶点0[面];
        填_v2 = 面顶点1[面];
        填_v3 = 面顶点2[面];
        填_az = 顶点z[填_v1];
        填_bz = 顶点z[填_v2];
        填_cz = 顶点z[填_v3];
        填_深[面] = (填_az + 填_bz + 填_cz) / 3.0;
        填_序[面] = 面;
        面 = 面 + 1;
    }
    排 = 1;
    当 (排 < 面数)
    {
        换 = 填_序[排];
        换深 = 填_深[换];
        从 = 排 - 1;
        当 (从 >= 0)
        {
            填_j = 填_序[从];
            如果 (填_深[填_j] >= 换深)
            {
                从 = 0 - 1;
            }
            否则
            {
                填_序[从 + 1] = 填_j;
                从 = 从 - 1;
            }
        }
        填_序[从 + 1] = 换;
        排 = 排 + 1;
    }
    填_i = 0;
    当 (填_i < 面数)
    {
        面 = 填_序[填_i];
        // 取下标 / 投三次 / 算面积 / 剔除 —— 与 `画实心` 共用 `三维网格填备面`
        如果 (三维网格填备面(面) == 1)
        {
            三维网格着算亮度();
            三维网格着上色(基色);
            三维网格填三角(着_色);
            填了 = 填了 + 1;
        }
        填_i = 填_i + 1;
    }
    返回 填了;
}

// ---------- `归一` 的草稿变量 ----------
浮点 归_最高 = 0.0;
浮点 归_最低 = 0.0;
浮点 归_最左 = 0.0;
浮点 归_最右 = 0.0;
浮点 归_最前 = 0.0;
浮点 归_最后 = 0.0;
浮点 归_倍 = 0.0;
浮点 归_中x = 0.0;
浮点 归_中y = 0.0;
浮点 归_中z = 0.0;
浮点 归_原高 = 0.0;
整数 归_i = 0;

// ---------- 居中:把模型摆到原点(不缩放) ----------
//   口径:x/z 的中线对到 0、y 的**中高**对到 0(于是模型从 -高/2 长到 +高/2)。
//   为什么不在这儿缩放:`归一` 那条路在这门语言的浮点上量出来不可靠(实测),
//   缩放拆成两个**显式常量**写(`素体.hb` 里那两句)反而一眼看得清、也好调。
方法 居中() 返回 整数
{
    如果 (顶点数 <= 0)
    {
        返回 -1;
    }
    归_最高 = 顶点y[0];
    归_最低 = 顶点y[0];
    归_最左 = 顶点x[0];
    归_最右 = 顶点x[0];
    归_最前 = 顶点z[0];
    归_最后 = 顶点z[0];
    归_i = 1;
    当 (归_i < 顶点数)
    {
        如果 (顶点y[归_i] > 归_最高)
        {
            归_最高 = 顶点y[归_i];
        }
        如果 (顶点y[归_i] < 归_最低)
        {
            归_最低 = 顶点y[归_i];
        }
        如果 (顶点x[归_i] > 归_最右)
        {
            归_最右 = 顶点x[归_i];
        }
        如果 (顶点x[归_i] < 归_最左)
        {
            归_最左 = 顶点x[归_i];
        }
        如果 (顶点z[归_i] > 归_最前)
        {
            归_最前 = 顶点z[归_i];
        }
        如果 (顶点z[归_i] < 归_最后)
        {
            归_最后 = 顶点z[归_i];
        }
        归_i = 归_i + 1;
    }
    归_中x = (归_最左 + 归_最右) * 0.5;
    归_中y = (归_最高 + 归_最低) * 0.5;
    归_中z = (归_最前 + 归_最后) * 0.5;
    归_i = 0;
    当 (归_i < 顶点数)
    {
        探0 = 顶点y[归_i];
        探1 = 探0 - 归_中y;
        顶点y[归_i] = 探1;
        探2 = 顶点y[归_i];
        如果 (归_i == 0)
        {
            居中零0 = 探0;
            居中零1 = 探1;
            居中零2 = 探2;
        }
        顶点x[归_i] = 顶点x[归_i] - 归_中x;
        顶点z[归_i] = 顶点z[归_i] - 归_中z;
        归_i = 归_i + 1;
    }
    居中高 = 归_最高;
    居中低 = 归_最低;
    居中中 = 归_中y;
    返回 0;
}

// `居中` 算出来的三个数(排查用,平时不用)
浮点 居中高 = 0.0;
浮点 居中低 = 0.0;
浮点 居中中 = 0.0;
浮点 居中零0 = 0.0;
浮点 居中零1 = 0.0;
浮点 居中零2 = 0.0;
浮点 探0 = 0.0;
浮点 探1 = 0.0;
浮点 探2 = 0.0;

// ---------- 整体缩放与**居中**(建完模型调一次) ----------
//   ⚠ 这条路实测**量出来不准**(缩放的倍数会偏),留着当"粗调"用;
//   要准就用 `居中` 之后再自己乘一个显式常量(见 `素体.hb` 末尾那两句)。
方法 归一(浮点 目标高) 返回 整数
{
    如果 (顶点数 <= 0)
    {
        返回 -1;
    }
    归_最高 = 顶点y[0];
    归_最低 = 顶点y[0];
    归_最左 = 顶点x[0];
    归_最右 = 顶点x[0];
    归_最前 = 顶点z[0];
    归_最后 = 顶点z[0];
    归_i = 1;
    当 (归_i < 顶点数)
    {
        如果 (顶点y[归_i] > 归_最高)
        {
            归_最高 = 顶点y[归_i];
        }
        如果 (顶点y[归_i] < 归_最低)
        {
            归_最低 = 顶点y[归_i];
        }
        如果 (顶点x[归_i] > 归_最右)
        {
            归_最右 = 顶点x[归_i];
        }
        如果 (顶点x[归_i] < 归_最左)
        {
            归_最左 = 顶点x[归_i];
        }
        如果 (顶点z[归_i] > 归_最前)
        {
            归_最前 = 顶点z[归_i];
        }
        如果 (顶点z[归_i] < 归_最后)
        {
            归_最后 = 顶点z[归_i];
        }
        归_i = 归_i + 1;
    }
    归_原高 = 归_最高 - 归_最低;
    如果 (归_原高 < 0.000001)
    {
        返回 -1;
    }
    归_倍 = 目标高 / 归_原高;
    归_中x = (归_最左 + 归_最右) * 0.5;
    归_中y = (归_最高 + 归_最低) * 0.5;
    归_中z = (归_最前 + 归_最后) * 0.5;
    归_i = 0;
    当 (归_i < 顶点数)
    {
        顶点x[归_i] = (顶点x[归_i] - 归_中x) * 归_倍;
        顶点y[归_i] = (顶点y[归_i] - 归_中y) * 归_倍;
        顶点z[归_i] = (顶点z[归_i] - 归_中z) * 归_倍;
        归_i = 归_i + 1;
    }
    返回 0;
}

// ---------- 按一个倍数整体缩放(倍数由调用方给,自己不猜) ----------
方法 缩(浮点 倍) 返回 整数
{
    整数 i = 0;
    当 (i < 顶点数)
    {
        顶点x[i] = 顶点x[i] * 倍;
        顶点y[i] = 顶点y[i] * 倍;
        顶点z[i] = 顶点z[i] * 倍;
        i = i + 1;
    }
    返回 0;
}

// ---------- 摆到画幅中间:把模型整体平移到相机看得见的位置 ----------
// 名字按 `命名规则.md` §1 禁令③ / §8.1 那张表取的:土话动词那一档一律写正式说法
// (同族:移位那一档写 `移位量` / `粘位`,移动这一档写 `移动到`)。名字带 `整体` 是为了
// 与 `数组.hb` 那个"循环左移"的 `平移` 分开(跨库同名是台账 §8 第 ① 条那条报告项) —— 两者是
// 不一样的语义,不该共用一个名字。取这个名字时全仓还没有调用方 ⇒ 不留别名(硬规矩 16)。
// 把模型整体平移 dx / dy / dz(就地改顶点;返回 0)
方法 整体平移(浮点 dx, 浮点 dy, 浮点 dz) 返回 整数
{
    整数 i = 0;
    当 (i < 顶点数)
    {
        顶点x[i] = 顶点x[i] + dx;
        顶点y[i] = 顶点y[i] + dy;
        顶点z[i] = 顶点z[i] + dz;
        i = i + 1;
    }
    返回 0;
}
