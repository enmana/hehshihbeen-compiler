// ============================================================
// 异步.hb —— 任务队列库(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 用法:文件开头写 包含 "../../库/异步.hb";调用写 `异步.排任务(...)` / `异步.跑一轮()`
//
// 管的是"排着的活":排进去、轮到时做一次、做不做得了由你取消。与 `定时.hb` 分工不重叠 ——
//   `定时.hb` 管**按钟点重复**的事(号是"定时器号"),这一库管**排着的活**(号是"任务号")。
//
// 口径(2026-10,每条都对着实测写):
//   · **号形如 `下标 * 65536 + 版本`**:下标是那一格(0 起、取最小空位),版本是**那一格的第几代** ——
//     排上 / 取消 / 收走各 +1,只增不减 ⇒ **旧号当场作废**。第一个任务的号是 **1**(0 留给"从来没排过",
//     而 `排任务` 排不上给的是 -1,三者分得开);没排过的号 / 取消过的号一律当"不认得"。
//   · **8 格**:同时在册的任务最多 8 个,满了 `排任务` 给 -1。
//   · **回调收一个整数**:库把"第几号任务"交给它;回调的调用点必须**直接写模块级那一格**
//     (`处理任务0` … `处理任务7`)。
//   · **排 = 登记,不执行**:真要它跑,得由主循环每一轮调一次 `跑一轮`;**一格活只跑一次**(轮到时先摘号、
//     再调处理函数 ⇒ 跑完就出册);回调想再排一次就自己再 `排任务` 一次(每轮循环的活请用 `定时.hb`)。
//   · **取消**:还没轮到的,`撤销任务` 摘掉并**当场作废号**(给真);已经跑过的给假(结果留着)。
//   · **虚拟刻度 = 跑一轮的次数**:`排延时任务(毫秒)` 说的就是这个刻度("延时 5" = 再过 5 个 `跑一轮`
//     轮到时做),**不是墙上的毫秒**;要按真时间排用 `定时.一次(毫秒, …)`。
//   · **实时等待有两条上界**:`等待任务` / `等待到` 一边看真时间(`当前毫秒()`,每轮看一次),一边把**轮数**
//     也卡在 `超时毫秒` 以内 —— 先到哪个算哪个 ⇒ 同一份程序跑两次结果一样,机器忙时早一点收手。
//   · **不报错、不停机**:号不对 / 越界 / 表满一律给 -1 / 假。
//
// 提供的函数(16 个):排 / 取消 / 查询 / 等待那几族;逐条见本页末尾那张公开方法表。
//
// 一处语言面限制(如实记着,不是库偷懒):`回调` **不能进数组 / 结构字段** ⇒ 8 个处理回调只能展开成一排
//   变量 `处理任务0 … 处理任务7`;回调的调用点也不能抽成 `做第几格(号)` —— `间接调用` 的第一个实参必须是
//   **编译器认得的**模块级那一格(与 `定时.hb` 同一个形状)。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// ⚠ 名字上的讲究:这一库"摘掉还没轮到的那一件"叫 **`撤销任务`**,不叫 `取消任务` —— 后者**已经是语言的
//   内建函数**(宿主那侧的异步输入输出),重名会被顶掉,而且「中英切换」会把它连带翻成 `canceltask`,
//   整篇当场编不过(实测:本库配的标准工程切英文报 3 处「未定义的函数」)。写库定名要照 `命名规则.md` §6 第 5 条**先避开内建函数名**。
//
// 复杂度:排 / 取消 / 查询都是 O(格数)= O(8);跑一轮 O(格数²)(先把到点的挑出来再逐件做,为的是
//   "回调里可以再排活 / 再取消"时下标不错位)。
// 内存账:模块级三张定长小表(有效任务 / 到点任务 / 号表)+ 一排处理槽,一共几百字节;一个字符串都不造、
//   一次宿主能力都不调。
//
// 边界(如实登记):号不对 / 越界 / 表满一律给 -1 / 假;没有异常、没有停机。
// ============================================================
模块 异步

// 一屏一张表(与 `定时.hb` 的平行列同一个道理:回调不能进数组,所以一格一个变量)
整数 有效任务[];        // 1 = 在册(还没轮到),0 = 空位(取消掉 / 跑完 / 还没用过)
整数 到点任务[];        // 到点那一刻的刻度(排延时用;排任务 = 当前刻度)
整数 版本任务[];        // 这一格的第几代(只增:排上 / 取消 / 收走各 +1)⇒ 号 = 下标 * 65536 + 版本
回调 处理任务0 = 地址(空转任务);
回调 处理任务1 = 地址(空转任务);
回调 处理任务2 = 地址(空转任务);
回调 处理任务3 = 地址(空转任务);
回调 处理任务4 = 地址(空转任务);
回调 处理任务5 = 地址(空转任务);
回调 处理任务6 = 地址(空转任务);
回调 处理任务7 = 地址(空转任务);
整数 槽任务 = 8;        // 展开的槽就这几格(与文件头那段"语言面限制"一致)
整数 在册任务 = 0;      // 表里有几格在用
整数 刻度任务 = 0;      // 跑过几轮

// 占位回调:某几格还没挂上处理时指向它(不然 `间接调用` 没得调)
方法 空转任务(整数 号)
{
    返回
}

// ---------- 回调槽:第 号 格挂哪个处理(语言面:回调不能进数组,只能展开成一排) ----------
// 私有:外面走 `排任务` / `排延时任务` 那两个入口(它们自己挑空位)
私有 方法 异步装处理(整数 号, 回调 处理)
{
    如果 (号 == 0)
    {
        处理任务0 = 处理;
        返回
    }
    如果 (号 == 1)
    {
        处理任务1 = 处理;
        返回
    }
    如果 (号 == 2)
    {
        处理任务2 = 处理;
        返回
    }
    如果 (号 == 3)
    {
        处理任务3 = 处理;
        返回
    }
    如果 (号 == 4)
    {
        处理任务4 = 处理;
        返回
    }
    如果 (号 == 5)
    {
        处理任务5 = 处理;
        返回
    }
    如果 (号 == 6)
    {
        处理任务6 = 处理;
        返回
    }
    如果 (号 == 7)
    {
        处理任务7 = 处理;
        返回
    }
    返回
}

// 把第 号 格的处理槽还原成占位回调(取消 / 跑完时用)
私有 方法 异步卸处理(整数 号)
{
    如果 (号 == 0)
    {
        处理任务0 = 地址(空转任务);
        返回
    }
    如果 (号 == 1)
    {
        处理任务1 = 地址(空转任务);
        返回
    }
    如果 (号 == 2)
    {
        处理任务2 = 地址(空转任务);
        返回
    }
    如果 (号 == 3)
    {
        处理任务3 = 地址(空转任务);
        返回
    }
    如果 (号 == 4)
    {
        处理任务4 = 地址(空转任务);
        返回
    }
    如果 (号 == 5)
    {
        处理任务5 = 地址(空转任务);
        返回
    }
    如果 (号 == 6)
    {
        处理任务6 = 地址(空转任务);
        返回
    }
    如果 (号 == 7)
    {
        处理任务7 = 地址(空转任务);
        返回
    }
    返回
}

// 号 → 下标(不认得给 -1)。判据两条:**下标在表里** + **那一格的版本就是号里那半**。
// 版本在那一格上只增不减(排上 / 取消 / 收走各 +1),所以
// 「取消过 / 收走过 / 同一格后来又被排上」这三种旧号在这一条上一次性全部作废。
私有 方法 异步取下标(整数 号) 返回 整数
{
    整数 个数 = 有效任务.长度();
    整数 位 = 号 / 65536;
    如果 (位 < 0 || 位 >= 个数)
    {
        返回 -1;
    }
    如果 (有效任务[位] == 0)
    {
        返回 -1;
    }
    如果 (版本任务[位] != (号 % 65536))
    {
        返回 -1;
    }
    返回 位;
}

// 这一号到点没有(不认得的号给假)
私有 方法 异步到点(整数 号) 返回 逻辑
{
    整数 位 = 异步取下标(号);
    如果 (位 < 0)
    {
        返回 假;
    }
    返回 刻度任务 >= 到点任务[位];
}

// 造一个新号:`下标 * 65536 + 版本`。**版本从 1 起、在那一格上只增不减** ——
// 空格子第一次排上先抬到 1,所以第一个任务的号是 `0 * 65536 + 1` = **1**(不是 0 ——
// 0 那一档留给"从来没排过",而 `排任务` 排不上给的是 -1,三者分得开);
// 取消 / 收走各再 +1 ⇒ 同一格前后两次拿到的号**一定不同**,旧号当场作废。
私有 方法 异步造号(整数 位) 返回 整数
{
    版本任务[位] = 版本任务[位] + 1;
    返回 位 * 65536 + 版本任务[位];
}

// 找一个空位;表没满就先长一格。给槽号,满了给 -1
私有 方法 异步找空槽() 返回 整数
{
    整数 个数 = 有效任务.长度();
    整数 空位 = -1;
    整数 i = 0;
    当 (i < 个数)
    {
        如果 (有效任务[i] == 0)
        {
            空位 = i;
            跳出;
        }
        i = i + 1;
    }
    如果 (空位 < 0)
    {
        如果 (个数 >= 槽任务)
        {
            返回 -1;                     // 8 格全占着(与文件头写的一致)
        }
        空位 = 个数;
        有效任务.添加(0);
        到点任务.添加(0);
        版本任务.添加(0);
    }
    返回 空位;
}

// ---------- 登记 ----------
// 内部:找一个空位、挂上处理、记下到点刻度,给任务号;满了给 -1
私有 方法 异步登记(回调 处理, 整数 到点刻度) 返回 整数
{
    整数 位 = 异步找空槽();
    如果 (位 < 0)
    {
        返回 -1;
    }
    有效任务[位] = 1;
    到点任务[位] = 到点刻度;
    异步装处理(位, 处理);
    在册任务 = 在册任务 + 1;
    返回 异步造号(位);          // 造号里把 `号表[位]` 一起写好(旧号到这一刻就作废了)
}

// 排一件"下一轮做"的活;给任务号(排不上给 -1)
方法 排任务(回调 处理) 返回 整数
{
    返回 异步登记(处理, 刻度任务);
}

// 排一件"再过 `毫秒` 个轮次做"的活;给任务号(排不上给 -1)
方法 排延时任务(整数 毫秒, 回调 处理) 返回 整数
{
    如果 (毫秒 <= 0)
    {
        返回 异步登记(处理, 刻度任务);
    }
    返回 异步登记(处理, 刻度任务 + 毫秒);
}

// 摘掉还没轮到的那一件(号当场作废);已经跑过 / 号不对给假
方法 撤销任务(整数 号) 返回 逻辑
{
    整数 位 = 异步取下标(号);
    如果 (位 < 0)
     {
        返回 假;
     }
    有效任务[位] = 0;
    版本任务[位] = 版本任务[位] + 1;      // 取消也抬一代 ⇒ 旧号当场作废
    在册任务 = 在册任务 - 1;
    异步卸处理(位);
    返回 真;
}

// ---------- 执行 ----------
// 刻度 +1,把到点的活一件件做掉;返回这一轮做了几件
方法 跑一轮() 返回 整数
{
    刻度任务 = 刻度任务 + 1;
    整数 个数 = 有效任务.长度();
    整数 待办[];
    整数 待办数 = 0;
    整数 i = 0;
    当 (i < 个数)
    {
        如果 (有效任务[i] != 0)
        {
            如果 (刻度任务 >= 到点任务[i])
            {
                待办.添加(i);
                待办数 = 待办数 + 1;
            }
        }
        i = i + 1;
    }
    整数 做了 = 0;
    整数 k = 0;
    当 (k < 待办数)
    {
        整数 位 = 待办[k];
        如果 (有效任务[位] != 0)
        {
            整数 号 = 位 * 65536 + 版本任务[位];   // 用**发出去的那一代号**调回调(不再抬一代)
            有效任务[位] = 0;              // 先摘号再调:回调里问 `任务在册` 已经是"做完出册"了
            版本任务[位] = 版本任务[位] + 1;       // 收走也抬一代 ⇒ 旧号当场作废
            在册任务 = 在册任务 - 1;
            如果 (位 == 0)
            {
                间接调用(处理任务0, 号);
                异步卸处理(位);
                做了 = 做了 + 1;
            }
            否则
            {
                如果 (位 == 1)
                {
                    间接调用(处理任务1, 号);
                    异步卸处理(位);
                    做了 = 做了 + 1;
                }
                否则
                {
                    如果 (位 == 2)
                    {
                        间接调用(处理任务2, 号);
                        异步卸处理(位);
                        做了 = 做了 + 1;
                    }
                    否则
                    {
                        如果 (位 == 3)
                        {
                            间接调用(处理任务3, 号);
                            异步卸处理(位);
                            做了 = 做了 + 1;
                        }
                        否则
                        {
                            如果 (位 == 4)
                            {
                                间接调用(处理任务4, 号);
                                异步卸处理(位);
                                做了 = 做了 + 1;
                            }
                            否则
                            {
                                如果 (位 == 5)
                                {
                                    间接调用(处理任务5, 号);
                                    异步卸处理(位);
                                    做了 = 做了 + 1;
                                }
                                否则
                                {
                                    如果 (位 == 6)
                                    {
                                        间接调用(处理任务6, 号);
                                        异步卸处理(位);
                                        做了 = 做了 + 1;
                                    }
                                    否则
                                    {
                                        如果 (位 == 7)
                                        {
                                            间接调用(处理任务7, 号);
                                            异步卸处理(位);
                                            做了 = 做了 + 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    返回 做了;
}

// 反复跑一轮,直到没有"现在就能做"的活;返回一共做了几件
// 反复跑一轮,直到没有"现在就能做"的活;返回一共做了几件
方法 跑到空() 返回 整数
{
    整数 一共 = 0;
    当 (还有任务吗())
    {
        整数 这一轮 = 跑一轮();
        如果 (这一轮 == 0)
        {
            跳出;
        }
        一共 = 一共 + 这一轮;
    }
    返回 一共;
}

// ---------- 查询 ----------
// 队列里还有没做的吗
方法 还有任务吗() 返回 逻辑
{
    返回 在册任务 > 0;
}

// 在册几件
方法 任务个数() 返回 整数
{
    返回 在册任务;
}

// 还排得下几件
方法 空闲格数() 返回 整数
{
    返回 槽任务 - 在册任务;
}

// 这一号现在还算数吗
方法 任务在册(整数 号) 返回 逻辑
{
    返回 异步取下标(号) >= 0;
}

// 这一号做完了吗(做完就出册)
方法 任务已跑(整数 号) 返回 逻辑
{
    整数 位 = 号 / 65536;
    整数 个数 = 有效任务.长度();
    如果 (位 < 0 || 位 >= 个数)
    {
        返回 假;
    }
    如果 (有效任务[位] != 0)
    {
        返回 假;                        // 还在册:没轮到它
    }
    // 出册之后版本又抬了一代 ⇒ 那一代的号 = 号 + 65536;取消抬的那一代也在同一档上,
    // 所以"取消过"这里同样给假(`取消 ≠ 跑过`)。
    返回 版本任务[位] == (号 % 65536) + 1;
}

// 至今跑过几轮
方法 现在刻度() 返回 整数
{
    返回 刻度任务;
}

// 把刻度摆到指定值(界面换一屏 / 自检要固定起点)
方法 设刻度(整数 刻度)
{
    刻度任务 = 刻度;
    返回
}

// ---------- 边跑边等 ----------
// 一边跑一边等这一号做完:做完给真;取消 / 号不对 / 超时给假
// **两条上界**:① 真时间(`当前毫秒()`,每轮看一次)② 轮数 —— 一条活最多等 超时毫秒 轮。
// 拿轮数当上界是为了**结果可复现**:同一份程序跑两次轮数一样,不看机器忙不忙;
// 边跑边等这一号做完(做完给真;取消 / 号不对 / 超时给假)
方法 等待任务(整数 号, 整数 超时毫秒) 返回 逻辑
{
    整数 起 = 当前毫秒();
    整数 限 = 超时毫秒;
    如果 (限 < 1)
    {
        限 = 1;
    }
    整数 轮 = 0;
    当 (轮 < 限)
    {
        如果 (任务已跑(号))
        {
            返回 真;
        }
        如果 (!任务在册(号))
        {
            返回 假;                        // 从来没排过 / 取消过
        }
        跑一轮();
        轮 = 轮 + 1;
        如果 (当前毫秒() - 起 >= 超时毫秒)
        {
            跳出;                          // 真时间到了:收手(给调用方"没等到")
        }
    }
    返回 任务已跑(号);
}

// 边跑边等队列空(空给真;超时给假)
方法 等待到(整数 超时毫秒) 返回 逻辑
{
    整数 起 = 当前毫秒();
    整数 限 = 超时毫秒;
    如果 (限 < 1)
    {
        限 = 1;
    }
    整数 轮 = 0;
    当 (轮 < 限)
    {
        如果 (!还有任务吗())
        {
            返回 真;
        }
        跑一轮();
        轮 = 轮 + 1;
        如果 (当前毫秒() - 起 >= 超时毫秒)
        {
            跳出;
        }
    }
    返回 !还有任务吗();
}

// ---------- 清空 ----------
// 全摘掉,刻度与序号一起归零
方法 清空任务()
{
    有效任务.清空();
    到点任务.清空();
    版本任务.清空();
    整数 i = 0;
    当 (i < 槽任务)
    {
        异步卸处理(i);
        i = i + 1;
    }
    在册任务 = 0;
    刻度任务 = 0;
    返回
}
