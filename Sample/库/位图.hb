// ============================================================
// 位图.hb —— 离屏位图库(建图 / 画点 / 画线 / 画矩形 / 贴到窗口 / 取像素)
//
// 用法:包含 "../../库/位图.hb";建图 → 画 → `贴(句柄, x, y)` 贴到窗口。
//
// 一句最要紧的话(整族的地基,别记反):
//   **位图活在宿主那一侧,不占 HB 的运行内存**;HB 这边拿到的只是一个**整数句柄**,
//   像素在宿主手里 ⇒ 一屏几万像素也只发**一条** `贴`。
//
// 口径(2026-10):
//   · **句柄从 1 起、只增不减,旧号永不复用**:释放之后再拿那个号来用一律"句柄不认"
//     (给 `假` / 给 0),**不会**悄悄画到别人的图上;
//   · **不报错、不停机**:句柄不认 / 坐标越界 / 尺寸非法各给一个确定值。越界**画**什么都不做,
//     越界**取**给 0;
//   · ⚠ **"句柄不认"与"坐标越界"要分得开**:`宽` / `高` / `释放` / `同图` 与画那几档在句柄不认时
//     给 `假` / `-1`(**有承诺**);而 `取像素` 在句柄不认时**那一格不做承诺** ⇒ 想判"图还在不在"
//     用 `宽(句柄) >= 0`,别用"取像素给 0";
//   · **颜色一律 `0xAARRGGBB`**;建出来是空的(全 0 = 全透明黑),想有底色先来一句 `填底`;
//     贴上去是不透明的 —— 半透明像素按它自己的 alpha 与前缀颜色混。
//
// 英文对照:建 make · 释放 free · 宽 width · 高 height · 填底 fill · 点 dot · 取像素 pixel
//   线 line · 横线 hline · 竖线 vline · 块 rect · 框 frame · 贴 blit · 同图 same · 字宽 cellW · 字高 lineH
//
// 复杂度:点 / 取像素 O(1);线 O(两点之间的格数);块 / 填底 O(面积);框 O(周长);
//   贴 O(1)(一次命令,**与图多大无关**)。
//
// 边界(如实登记):
//   · ⚠ **图上画字那一档要平台**(`字`):无头那条腿(`hbcc --run`)/ 没挂呈现口 / C 后端
//     都给 假,**图一个像素都不动**;两套字体栈也不保证同一行字逐字节相同;
//   · **图上没有裁剪区**(坐标都是整张图的,越界部分直接丢);**没有透明色 / 没有 `载图`**;
//   · **一张图只能整张贴**,想"只贴一块"要等 `贴位图块`;
//   · **上限由宿主定**:宽高各 ≤ 8192、总格数 ≤ 1600 万(约 64MB);超了 `建` 给 -1,不抛异常。
// 提供的函数(18 个):逐个见下面那张公开方法表。
// ============================================================
模块 位图

// 一个字符格子 / 一行多高(与 `界面.hb` 那套等宽口径一致)

// 等宽字体下一个 ASCII 字符的宽度(汉字按两格算)
方法 字宽() 返回 整数
{
    返回 9;
}

// 一行文字占多高。
方法 字高() 返回 整数
{
    返回 18;
}

// 建 / 释放 / 问尺寸

// 建一张离屏图,给句柄(≥1);建不出给 -1(宽高 ≤ 0 / 超过上限)。图能随便画,要看见它得先 `打开窗口` 再 `贴`。
方法 建(整数 宽, 整数 高) 返回 整数
{
    整数 图 = 0;
    建位图(宽, 高, 图);
    返回 图;
}

// 还给宿主。没这个号 / 已经释放过都给 `假`(旧号永不复用)
方法 释放(整数 句柄) 返回 逻辑
{
    返回 释放位图(句柄);
}

// 问宽;句柄不认给 -1(0 是"合法但空"的意思,两者分得开)
方法 宽(整数 句柄) 返回 整数
{
    整数 宽格 = 0;
    整数 高格 = 0;
    如果 (!位图尺寸(句柄, 宽格, 高格))
    {
        返回 -1;
    }
    返回 宽格;
}

// 问高;句柄不认给 -1
方法 高(整数 句柄) 返回 整数
{
    整数 宽格 = 0;
    整数 高格 = 0;
    如果 (!位图尺寸(句柄, 宽格, 高格))
    {
        返回 -1;
    }
    返回 高格;
}

// 两个句柄是不是同一张图(句柄只增不减、永不复用 ⇒ 直接比号)
方法 同图(整数 句柄左, 整数 句柄右) 返回 逻辑
{
    返回 句柄左 == 句柄右;
}

// 画

// 整张刷成一个颜色(建出来是全 0 = 全透明黑,想有底色就先来这一句)
方法 填底(整数 句柄, 整数 颜色) 返回 逻辑
{
    返回 块(句柄, 0, 0, 宽(句柄), 高(句柄), 颜色);
}

// 画一个像素;越界什么都不做(与宿主那条 `画点到图` 同口径)
方法 点(整数 句柄, 整数 x, 整数 y, 整数 颜色) 返回 逻辑
{
    返回 画点到图(句柄, x, y, 颜色);
}

// 读一个像素(`0xAARRGGBB`);坐标越界给 **0**。⚠ **句柄不认时这一格不做承诺** ——
//   要判"图还在不在"就先问 `位图.宽(句柄) >= 0`(那一条有承诺:不认给 -1)。
方法 取像素(整数 句柄, 整数 x, 整数 y) 返回 整数
{
    返回 取图像素(句柄, x, y);
}

// 一条直线:两个端点**都画**(闭区间)。
方法 线(整数 句柄, 整数 x1, 整数 y1, 整数 x2, 整数 y2, 整数 颜色) 返回 逻辑
{
    返回 画线到图(句柄, x1, y1, x2, y2, 颜色);
}

// 水平线:`线` 的偷懒写法(长度 ≤ 0 什么都不做)
方法 横线(整数 句柄, 整数 x, 整数 y, 整数 长度, 整数 颜色) 返回 逻辑
{
    如果 (长度 <= 0)
    {
        返回 真;
    }
    返回 线(句柄, x, y, x + 长度 - 1, y, 颜色);
}

// 竖线
方法 竖线(整数 句柄, 整数 x, 整数 y, 整数 长度, 整数 颜色) 返回 逻辑
{
    如果 (长度 <= 0)
    {
        返回 真;
    }
    返回 线(句柄, x, y, x, y + 长度 - 1, 颜色);
}

// 实心矩形(宽高 ≤ 0 什么都不做)。
方法 块(整数 句柄, 整数 x, 整数 y, 整数 宽格, 整数 高格, 整数 颜色) 返回 逻辑
{
    返回 画矩形到图(句柄, x, y, 宽格, 高格, 颜色);
}

// 空心矩形:四条边拼出来;⚠ 宽或高**小于 2** 时四条边会重叠 ⇒ 直接落成一个 `块`。
方法 框(整数 句柄, 整数 x, 整数 y, 整数 宽格, 整数 高格, 整数 颜色) 返回 逻辑
{
    如果 (宽格 <= 0 || 高格 <= 0)
    {
        返回 真;
    }
    如果 (宽格 < 2 || 高格 < 2)
    {
        返回 块(句柄, x, y, 宽格, 高格, 颜色);
    }
    // 上边与下边整条画;左边与右边夹在中间那几行(四角已经由上下边画过了,别重复)
    横线(句柄, x, y, 宽格, 颜色);
    横线(句柄, x, y + 高格 - 1, 宽格, 颜色);
    如果 (高格 > 2)
    {
        竖线(句柄, x, y + 1, 高格 - 2, 颜色);
        竖线(句柄, x + 宽格 - 1, y + 1, 高格 - 2, 颜色);
    }
    返回 真;
}

// 贴到窗口 / 把字画进图

// 把整张图**一次**贴到窗口的 (x, y);**要开过窗**(没挂呈现口 / 没开窗给 `假`);每贴一次是一条命令。
方法 贴(整数 句柄, 整数 x, 整数 y) 返回 逻辑
{
    返回 贴位图(句柄, x, y);
}

// 图上写字默认用的白(要别的颜色直接给 `字(...)` 第五个实参)
方法 字色() 返回 整数
{
    返回 4294967295;
}

// 把一行字**画进这张图**;⚠ 这一条**要呈现口**(字形光栅化只有平台有)⇒ 无头那条腿(`hbcc --run`)
//   给 假、一个像素都不动。想先有底色就 `填底` 再 `字`(字的像素是盖上去的)。
方法 字(整数 句柄, 整数 x, 整数 y, 字符串 文本, 整数 颜色) 返回 逻辑
{
    返回 贴文字到位图(句柄, x, y, 文本, 颜色);
}
