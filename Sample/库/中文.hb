// ============================================================
// 中文.hb —— 中文文本的三件事:UTF-8 一字、汉字、中文数字(纯 HB,零依赖)
//
// 用法:
// ```
// 包含 "../库/中文.hb";
// 如果 (中文.是汉字(名字[0])) { … }
// 整数 宽 = 0;
// 无符号整数 码 = 中文.UTF8解码一字(文本, 字节位, 宽);   // 宽 写回这个字占几个字节
// 输出行(中文.汉字个数("张三丰 2026"));                  // 3
// 输出行(中文.转半角("ＡＢＣ１２３"));                     // ABC123
// 整数 值 = 0;
// 如果 (中文.中文数字转整数("一万零五", 值)) { 输出行(值); }   // 10005
// 输出行(中文.整数转中文数字(20261005));                  // 二千零二十六万一千零五
// 输出行(中文.金额大写(12345));                            // 壹佰贰拾叁元肆角伍分
// ```
// 这门语言是中文优先的,而"中文"在字节那一层是**变长**的(一个汉字 3 个字节),在语义那一层是
//   **一个字一个码点**。这中间的活分三族:① UTF-8 一字(按**字节**定位到字边界、码点编回字节串);
//   ② 汉字(是不是、几个、滤掉非汉字);③ 中文数字(与整数互转,外加票据那套金额大写)。
//
// 口径(2026-10;每条都对着实测写):
//   · **长度与下标一律按"文字"(Unicode 码点)算**:`文本[i]` 取出来是一个 `文字`,不是字节 ——
//     "第几个字节"这件事得走 `UTF8解码一字`;
//   · **`UTF8解码一字` 的 `起` 是"第几个字节"(0 起),必须落在某个文字的起始字节上**:正好落在字边界上
//     就给那个字的码点、`宽` 写成它占几个字节(1~4);越过末尾 / 落在字中间一律给 **4294967295**
//     (`0xFFFFFFFF`;`输出行` 打出来是 `-1`)、`宽` 给 0,不停机;
//   · **`UTF8编码一字` 收任何数字都不报错**:码点越界(> 1114111)或落在**代理区**(0xD800~0xDFFF)
//     给**空串**;1~4 字节按 UTF-8 正常装;
//   · **`是汉字` 认这六段**(其余一律假):`0x3400~0x4DBF`、`0x4E00~0x9FFF`、`0xF900~0xFAFF`、
//     `0x20000~0x2FA1F`、`0x30000~0x3134F`,外加 `0x3007`(**〇**);**段里的空档照算汉字**(整段口径);
//   · **全角半角只做 ASCII 那一档**:`0xFF01~0xFF5E` 与 `0x21~0x7E` 一一对应(差 `0xFEE0`),全角空格
//     `0x3000` 与半角空格互换;**半角片假名那一档(`0xFF61~0xFF9F`)不换**;
//   · **中文数字**:小写(`一二三…十百千万亿` 与 `〇○两`)与**大写**(`壹贰叁…拾佰仟萬億`)都认,可以带
//     `负` / `正`(或 `-` / `+`)前缀;两种形态各读各的;认不出就整条给假(不猜、不跳过);不报错、不停机。
//
// 提供的函数(13 个):UTF-8 三件 + 汉字四件 + 全角半角三件 + 中文数字三件;
//   逐条的参数与返回值见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:UTF-8 三件 O(文字数);`汉字个数` / `只留汉字` / `转全角` / `转半角` 一趟扫完;
//   `中文数字转整数` O(文字数);`整数转中文数字` / `金额大写` O(结果的字数)。
//
// 边界(如实登记):
//   · **中文数字有两条读法**(按整串里**有没有单位字**分):① **有单位** ⇒ 按"数位 + 单位"读,并且按汉语
//     语法校形:同一段里单位须**严格递减**(`十百` / `千千` 给假)、`万` / `亿` 前面必须有东西(`万亿` 给假)、
//     `零` 只能当占位(`零十` 给假,连写两个 `零` 也给假)、段内**数字不能连着写**(`一万二` 可以,`一万二三`
//     给假),`十` 前面可以没有数字(`十五` = 15);② **没有单位** ⇒ 按"逐位"读(`二零二六` = 2026、`零零一` = 1);
//   · **口语省略单位的形态按字面读**:`一万五` 读成 10005(不猜成 15000)、`一亿五` 读成 100000005 ——
//     要口语意思就把单位写全;**不做"上下文猜数位"**;
//   · **`廿` / `卅` / `半` 不认**(要它们自己先换写);
//   · **超出 32 位按回绕**(与语言里 `+ - *` 同一个口径);要按值域校验请在调用方自己看范围;
//   · **`整数转中文数字` 出小写那一套**(负数写 `负`);十位那个"一"只在**整串最高那一段**省(`十` / `十五` /
//     `十万` / `十二万`),底下照写(`10010` ⇒ `一万零一十`);要票据那种大写用 `金额大写`;
//   · **`金额大写` 收的是"分"**(`12345` = 123.45 元):`分` 是 32 位有符号 ⇒ 能表示到 **21474836.47 元**为止;
//     **元位为 0 时也写成 `零元X角X分`**;`分` 为 0 时末尾写 `整`(`角` 有、`分` 没有也写 `整`);`拾` **不省**;
//   · **只出人民币那一套字**(元 / 角 / 分 / 整),不认"人民币"前缀、不管繁体(`萬` / `億` 只认不写);
//   · **不碰 `宽度.hb` 那份"占几格"的表**:一个汉字占两格是排版口径,这里只管"是不是汉字"。
// ============================================================
模块 中文

// ============================================================
// 私有:一个码点按 UTF-8 占几个字节
// ============================================================
私有 方法 中文码点字节数(文字 某字) 返回 整数
{
    整数 码 = 某字;
    如果 (码 < 0x80)
    {
        返回 1;
    }
    如果 (码 < 0x800)
    {
        返回 2;
    }
    如果 (码 < 0x10000)
    {
        返回 3;
    }
    返回 4;
}

// ---------- 私有:把一个字节接进字符串(`拼接到` 收一个字节变量) ----------
私有 方法 中文接字节(字符串 出 结果, 整数 值)
{
    字符 一个字节 = 值 & 255;
    拼接到(结果, 一个字节);
    返回
}

// ---------- 私有:接一个数字字 / 一个单位字(`拼接到` 只收变量与字面量,不收"文字"的返回值) ----------
私有 方法 中文接数(字符串 出 结果, 整数 位, 逻辑 大写)
{
    文字 字 = 中文字符(位, 大写);
    拼接到(结果, 字);
    返回
}

私有 方法 中文接单位(字符串 出 结果, 整数 单位, 逻辑 大写)
{
    文字 字 = 中文单位字符(单位, 大写);
    拼接到(结果, 字);
    返回
}

// ============================================================
// 1、UTF-8:一字
// ============================================================

// 整串占几个字节(UTF-8)
方法 UTF8字节数(字符串 文本) 返回 整数
{
    整数 合计 = 0;
    整数 个数 = 文本.长度();
    整数 i = 0;
    当 (i < 个数)
    {
        合计 = 合计 + 中文码点字节数(文本[i]);
        i = i + 1;
    }
    返回 合计;
}

// 按字节位置取一个字:`起` 是第几个字节(0 起,必须是某个字的起始字节);
// 给这个字的码点、并把 `宽` 写成它占几个字节;越界 / 落在字中间给 4294967295、`宽` 给 0
方法 UTF8解码一字(字符串 文本, 整数 起, 引用 整数 宽) 返回 无符号整数
{
    宽 = 0;
    如果 (起 < 0)
    {
        返回 0 - 1;
    }
    整数 个数 = 文本.长度();
    整数 偏移 = 0;
    整数 i = 0;
    当 (i < 个数)
    {
        整数 长 = 中文码点字节数(文本[i]);
        如果 (偏移 == 起)
        {
            宽 = 长;
            返回 文本[i];
        }
        偏移 = 偏移 + 长;
        i = i + 1;
    }
    返回 0 - 1;                             // 起 越过了末尾(或落在字中间:那样永远等不到 偏移 == 起)
}

// 一个码点 → 它的 UTF-8 字节串(1~4 字节);码点越界 / 落在代理区给空串
方法 UTF8编码一字(无符号整数 码点) 返回 字符串
{
    字符串 结果 = "";
    如果 (码点 > 0x10FFFF)
    {
        返回 结果;
    }
    如果 (码点 >= 0xD800 && 码点 <= 0xDFFF)
    {
        返回 结果;                          // 代理区:那一段不成字
    }
    整数 码 = 码点;
    如果 (码 < 0x80)
    {
        中文接字节(结果, 码);
        返回 结果;
    }
    如果 (码 < 0x800)
    {
        中文接字节(结果, 0xC0 | (码 >> 6));
        中文接字节(结果, 0x80 | (码 & 63));
        返回 结果;
    }
    如果 (码 < 0x10000)
    {
        中文接字节(结果, 0xE0 | (码 >> 12));
        中文接字节(结果, 0x80 | ((码 >> 6) & 63));
        中文接字节(结果, 0x80 | (码 & 63));
        返回 结果;
    }
    中文接字节(结果, 0xF0 | (码 >> 18));
    中文接字节(结果, 0x80 | ((码 >> 12) & 63));
    中文接字节(结果, 0x80 | ((码 >> 6) & 63));
    中文接字节(结果, 0x80 | (码 & 63));
    返回 结果;
}

// ============================================================
// 2、汉字
// ============================================================

// 一个字是不是汉字(六段 + 〇)
方法 是汉字(文字 某字) 返回 逻辑
{
    整数 码 = 某字;
    如果 (码 == 0x3007)
    {
        返回 真;                            // 〇:中文数字里那个圈
    }
    如果 (码 >= 0x3400 && 码 <= 0x4DBF)
    {
        返回 真;
    }
    如果 (码 >= 0x4E00 && 码 <= 0x9FFF)
    {
        返回 真;
    }
    如果 (码 >= 0xF900 && 码 <= 0xFAFF)
    {
        返回 真;
    }
    如果 (码 >= 0x20000 && 码 <= 0x2FA1F)
    {
        返回 真;
    }
    如果 (码 >= 0x30000 && 码 <= 0x3134F)
    {
        返回 真;
    }
    返回 假;
}

// 整串里有几个汉字
方法 汉字个数(字符串 文本) 返回 整数
{
    整数 个数 = 0;
    整数 长度 = 文本.长度();
    整数 i = 0;
    当 (i < 长度)
    {
        如果 (是汉字(文本[i]))
        {
            个数 = 个数 + 1;
        }
        i = i + 1;
    }
    返回 个数;
}

// 把非汉字滤掉(剩下的按原顺序接起来)
方法 只留汉字(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    整数 长度 = 文本.长度();
    整数 i = 0;
    当 (i < 长度)
    {
        文字 某字 = 文本[i];
        如果 (是汉字(某字))
        {
            拼接到(结果, 某字);
        }
        i = i + 1;
    }
    返回 结果;
}

// ============================================================
// 3、全角 / 半角(只做 ASCII 那一档)
// ============================================================

// 一个字是不是全角(全角 ASCII 档 0xFF01~0xFF5E,或全角空格 0x3000)
方法 是全角(文字 某字) 返回 逻辑
{
    整数 码 = 某字;
    如果 (码 == 0x3000)
    {
        返回 真;
    }
    如果 (码 >= 0xFF01 && 码 <= 0xFF5E)
    {
        返回 真;
    }
    返回 假;
}

// 全角 → 半角(其余文字原样搬)
方法 转半角(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    整数 长度 = 文本.长度();
    整数 i = 0;
    当 (i < 长度)
    {
        文字 某字 = 文本[i];
        整数 码 = 某字;
        如果 (码 == 0x3000)
        {
            拼接到(结果, ' ');
        }
        否则
        {
            如果 (码 >= 0xFF01 && 码 <= 0xFF5E)
            {
                文字 新字 = 码 - 0xFEE0;
                拼接到(结果, 新字);
            }
            否则
            {
                拼接到(结果, 某字);
            }
        }
        i = i + 1;
    }
    返回 结果;
}

// 半角 → 全角(其余文字原样搬)
方法 转全角(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    整数 长度 = 文本.长度();
    整数 i = 0;
    当 (i < 长度)
    {
        文字 某字 = 文本[i];
        整数 码 = 某字;
        如果 (码 == ' ')
        {
            文字 新字 = 0x3000;
            拼接到(结果, 新字);
        }
        否则
        {
            如果 (码 >= 0x21 && 码 <= 0x7E)
            {
                文字 新字 = 码 + 0xFEE0;
                拼接到(结果, 新字);
            }
            否则
            {
                拼接到(结果, 某字);
            }
        }
        i = i + 1;
    }
    返回 结果;
}

// ============================================================
// 4、中文数字:读(中文数字 → 整数)
// ============================================================

// ---------- 私有:一个字是几(不是数字给 -1;小写 / 大写两套都认) ----------
私有 方法 中文字符数值(文字 某字) 返回 整数
{
    如果 (某字 == '零' || 某字 == '〇' || 某字 == '○')
    {
        返回 0;
    }
    如果 (某字 == '一' || 某字 == '壹' || 某字 == '幺')
    {
        返回 1;
    }
    如果 (某字 == '二' || 某字 == '贰' || 某字 == '貳' || 某字 == '两' || 某字 == '兩')
    {
        返回 2;
    }
    如果 (某字 == '三' || 某字 == '叁' || 某字 == '参' || 某字 == '參')
    {
        返回 3;
    }
    如果 (某字 == '四' || 某字 == '肆')
    {
        返回 4;
    }
    如果 (某字 == '五' || 某字 == '伍')
    {
        返回 5;
    }
    如果 (某字 == '六' || 某字 == '陆' || 某字 == '陸')
    {
        返回 6;
    }
    如果 (某字 == '七' || 某字 == '柒')
    {
        返回 7;
    }
    如果 (某字 == '八' || 某字 == '捌')
    {
        返回 8;
    }
    如果 (某字 == '九' || 某字 == '玖')
    {
        返回 9;
    }
    返回 -1;
}

// ---------- 私有:一个字是哪个单位(不是单位给 0;小写 / 大写两套都认) ----------
私有 方法 中文单位数值(文字 某字) 返回 整数
{
    如果 (某字 == '十' || 某字 == '拾')
    {
        返回 10;
    }
    如果 (某字 == '百' || 某字 == '佰')
    {
        返回 100;
    }
    如果 (某字 == '千' || 某字 == '仟')
    {
        返回 1000;
    }
    如果 (某字 == '万' || 某字 == '萬')
    {
        返回 10000;
    }
    如果 (某字 == '亿' || 某字 == '億')
    {
        返回 100000000;
    }
    返回 0;
}

// ---------- 私有:逐位读(`二零二六` = 2026;有一个字不是数字就给假) ----------
私有 方法 中文按位读(字符串 文本, 整数 起, 引用 整数 数) 返回 逻辑
{
    整数 合计 = 0;
    整数 长度 = 文本.长度();
    整数 i = 起;
    当 (i < 长度)
    {
        整数 位 = 中文字符数值(文本[i]);
        如果 (位 < 0)
        {
            返回 假;
        }
        合计 = 合计 * 10 + 位;
        i = i + 1;
    }
    数 = 合计;
    返回 真;
}

// ---------- 私有:数位 + 单位读(整串里出现过单位字才走这一支;校形规则见库头注释) ----------
//   状态:`小计` = 当前这一段(万以下)里已经算出来的数;`待用` = 手里那个还没乘单位的数字
//   (-1 = 手上没有、0 = 上一个是"零"占位);`上单位` = 这一段里上一个单位(段内必须严格递减)
私有 方法 中文按单位读(字符串 文本, 整数 起, 引用 整数 数) 返回 逻辑
{
    整数 长度 = 文本.长度();
    整数 总计 = 0;
    整数 小计 = 0;
    整数 待用 = 0 - 1;
    整数 上单位 = 10000;
    逻辑 刚零 = 假;
    整数 i = 起;
    当 (i < 长度)
    {
        文字 本字 = 文本[i];
        整数 位 = 中文字符数值(本字);
        整数 单位 = 中文单位数值(本字);
        如果 (位 == 0)
        {
            如果 (待用 > 0 || 刚零)
            {
                返回 假;                    // `一零`(数字后面跟零而那个数字还没配单位)/ 连着两个零
            }
            如果 (i + 1 < 长度 && 中文单位数值(文本[i + 1]) > 0)
            {
                返回 假;                    // `零十` / `零万`:零后面不能跟单位
            }
            待用 = 0;
            刚零 = 真;
        }
        否则
        {
            如果 (位 > 0)
            {
                如果 (待用 > 0)
                {
                    返回 假;                // 段内数字连着写(`一二`)
                }
                待用 = 位;
                刚零 = 假;
            }
            否则
            {
                如果 (单位 == 0)
                {
                    返回 假;                // 既不是数字也不是单位
                }
                如果 (单位 == 10000 || 单位 == 100000000)
                {
                    如果 (待用 <= 0 && 小计 == 0)
                    {
                        返回 假;            // `万亿` / `万` 打头:段单位前面必须有东西
                    }
                    整数 段值 = 小计;
                    如果 (待用 > 0)
                    {
                        段值 = 段值 + 待用;     // 待用 = -1(手上没有)时不能算进这一段
                    }
                    如果 (单位 == 10000)
                    {
                        总计 = 总计 + 段值 * 10000;
                    }
                    否则
                    {
                        总计 = (总计 + 段值) * 100000000;
                    }
                    小计 = 0;
                    待用 = 0 - 1;
                    上单位 = 10000;
                    刚零 = 假;
                }
                否则
                {
                    如果 (单位 >= 上单位)
                    {
                        返回 假;            // 段内单位必须严格递减(`十百` / `千千`)
                    }
                    如果 (待用 < 0)
                    {
                        如果 (单位 != 10)
                        {
                            返回 假;        // 只有 `十` 允许省掉前面那个"一"(`十五`)
                        }
                        待用 = 1;
                    }
                    如果 (待用 == 0)
                    {
                        返回 假;                // 零 后面跟单位(上面那条已经挡过,这里兜底)
                    }
                    小计 = 小计 + 待用 * 单位;
                    待用 = 0 - 1;
                    上单位 = 单位;
                    刚零 = 假;
                }
            }
        }
        i = i + 1;
    }
    如果 (待用 > 0)
    {
        小计 = 小计 + 待用;
    }
    数 = 总计 + 小计;
    返回 真;
}

// ---------- 中文数字 → 整数:认得出给真(值写回),认不出给假(值清零) ----------
方法 中文数字转整数(字符串 文本, 引用 整数 值) 返回 逻辑
{
    值 = 0;
    整数 长度 = 文本.长度();
    如果 (长度 == 0)
    {
        返回 假;
    }
    整数 起 = 0;
    逻辑 负 = 假;
    文字 头字 = 文本[0];
    如果 (头字 == '负' || 头字 == '-')
    {
        负 = 真;
        起 = 1;
    }
    否则
    {
        如果 (头字 == '正' || 头字 == '+')
        {
            起 = 1;
        }
    }
    如果 (起 >= 长度)
    {
        返回 假;
    }
    逻辑 有单位 = 假;
    整数 k = 起;
    当 (k < 长度)
    {
        如果 (中文单位数值(文本[k]) > 0)
        {
            有单位 = 真;
        }
        k = k + 1;
    }
    整数 数 = 0;
    逻辑 读成了 = 假;
    如果 (有单位)
    {
        读成了 = 中文按单位读(文本, 起, 数);
    }
    否则
    {
        读成了 = 中文按位读(文本, 起, 数);
    }
    如果 (!读成了)
    {
        值 = 0;
        返回 假;
    }
    如果 (负)
    {
        数 = 0 - 数;
    }
    值 = 数;
    返回 真;
}

// 形态对不对(与 中文数字转整数 同一套判据,只是不要那个值)
方法 是中文数字(字符串 文本) 返回 逻辑
{
    整数 值 = 0;
    返回 中文数字转整数(文本, 值);
}

// ============================================================
// 5、中文数字:写(整数 → 中文数字 / 金额大写)
// ============================================================

// ---------- 私有:0~9 → 数字字(大写 = 零壹贰…玖;越界一律当 0) ----------
私有 方法 中文字符(整数 位, 逻辑 大写) 返回 文字
{
    字符串 表 = "零一二三四五六七八九";
    如果 (大写)
    {
        表 = "零壹贰叁肆伍陆柒捌玖";
    }
    整数 位号 = 位;
    如果 (位号 < 0 || 位号 > 9)
    {
        位号 = 0;
    }
    返回 表[位号];
}

// ---------- 私有:10 / 100 / 1000 / 10000 / 100000000 → 单位字(大写 = 拾佰仟;万 / 亿 两套同形) ----------
私有 方法 中文单位字符(整数 单位, 逻辑 大写) 返回 文字
{
    字符串 表 = "十百千万亿";
    如果 (大写)
    {
        表 = "拾佰仟万亿";
    }
    整数 位号 = 0;
    如果 (单位 == 100)
    {
        位号 = 1;
    }
    如果 (单位 == 1000)
    {
        位号 = 2;
    }
    如果 (单位 == 10000)
    {
        位号 = 3;
    }
    如果 (单位 == 100000000)
    {
        位号 = 4;
    }
    返回 表[位号];
}

// ---------- 私有:1~9999 那一段读成文字(千 / 百 / 十 缺位时补一个"零") ----------
//   小写那一套:这一段**正好是整串最高的一段**、又只有十位、又是 1 时省掉"一"
//   (`十` / `十五` / `十万` / `十二万` 都省);别的段照写(`一万零一十` 不写成一万零十)——
//   大写那一套(金额)一律不省(`壹拾`,票据要求)
私有 方法 中文读一段(整数 值, 逻辑 大写, 逻辑 允许省一) 返回 字符串
{
    整数 千 = 值 / 1000;
    整数 百 = 值 / 100 % 10;
    整数 十 = 值 / 10 % 10;
    整数 个 = 值 % 10;
    字符串 结果 = "";
    逻辑 需零 = 假;
    如果 (千 > 0)
    {
        中文接数(结果, 千, 大写);
        中文接单位(结果, 1000, 大写);
    }
    如果 (百 > 0)
    {
        如果 (需零)
        {
            中文接数(结果, 0, 大写);
            需零 = 假;
        }
        中文接数(结果, 百, 大写);
        中文接单位(结果, 100, 大写);
    }
    否则
    {
        如果 (千 > 0)
        {
            需零 = 真;
        }
    }
    如果 (十 > 0)
    {
        如果 (需零)
        {
            中文接数(结果, 0, 大写);
            需零 = 假;
        }
        如果 (千 == 0 && 百 == 0 && 十 == 1 && 允许省一)
        {
            中文接单位(结果, 10, 大写);               // 十五 / 十万:省"一"
        }
        否则
        {
            中文接数(结果, 十, 大写);
            中文接单位(结果, 10, 大写);
        }
    }
    否则
    {
        如果 (千 > 0 || 百 > 0)
        {
            需零 = 真;
        }
    }
    如果 (个 > 0)
    {
        如果 (需零)
        {
            中文接数(结果, 0, 大写);
        }
        中文接数(结果, 个, 大写);
    }
    返回 结果;
}

// ---------- 私有:整段数(亿 / 万 / 个 三段)读成文字;0 给"零" ----------
//   段之间该补"零"就补:下面那一段的千位为空(`万 < 1000` / `个 < 1000`)就要补一个;
//   "省掉十位那个一"只给**最高的那一段**(小写那一套:`十万` 省、`一万零一十` 不省)
私有 方法 中文三段文字(无符号整数 数, 逻辑 大写) 返回 字符串
{
    如果 (数 == 0)
    {
        返回 "零";
    }
    无符号整数 亿 = 数 / 100000000;
    整数 万 = 数 / 10000 % 10000;
    整数 个 = 数 % 10000;
    逻辑 小写 = 真;
    如果 (大写)
    {
        小写 = 假;
    }
    字符串 结果 = "";
    如果 (亿 > 0)
    {
        拼接到(结果, 中文读一段(亿, 大写, 小写), '亿');
    }
    如果 (万 > 0)
    {
        如果 (亿 > 0 && 万 < 1000)
        {
            拼接到(结果, '零');
        }
        逻辑 万段可省 = 假;
        如果 (小写 && 亿 == 0)
        {
            万段可省 = 真;
        }
        拼接到(结果, 中文读一段(万, 大写, 万段可省), '万');
    }
    如果 (个 > 0)
    {
        如果 ((亿 > 0 || 万 > 0) && 个 < 1000)
        {
            拼接到(结果, '零');
        }
        逻辑 个段可省 = 假;
        如果 (小写 && 亿 == 0 && 万 == 0)
        {
            个段可省 = 真;
        }
        拼接到(结果, 中文读一段(个, 大写, 个段可省));
    }
    返回 结果;
}

// 整数 → 小写中文数字(负数写"负";0 给"零")
方法 整数转中文数字(整数 值) 返回 字符串
{
    如果 (值 == 0)
    {
        返回 "零";
    }
    逻辑 负 = 假;
    无符号整数 数 = 值;
    如果 (值 < 0)
    {
        负 = 真;
        数 = 0 - 值;
    }
    字符串 结果 = "";
    如果 (负)
    {
        拼接到(结果, '负');
    }
    拼接到(结果, 中文三段文字(数, 假));
    返回 结果;
}

// 金额大写:以"分"为单位的金额 → 票据那一套(零壹贰叁肆伍陆柒捌玖 + 拾佰仟万亿 + 元角分整)
方法 金额大写(整数 分) 返回 字符串
{
    逻辑 负 = 假;
    无符号整数 总 = 分;
    如果 (分 < 0)
    {
        负 = 真;
        总 = 0 - 分;
    }
    无符号整数 元 = 总 / 100;
    整数 角 = 总 / 10 % 10;
    整数 分位 = 总 % 10;
    字符串 结果 = "";
    如果 (负)
    {
        拼接到(结果, '负');
    }
    如果 (元 == 0)
    {
        拼接到(结果, "零元");
    }
    否则
    {
        拼接到(结果, 中文三段文字(元, 真), '元');
    }
    如果 (角 > 0)
    {
        中文接数(结果, 角, 真);
        拼接到(结果, '角');
    }
    否则
    {
        如果 (分位 > 0)
        {
            拼接到(结果, '零');             // 角位是 0 而分位不是:票据要在"元 / 角"后写一个"零"
        }
    }
    如果 (分位 > 0)
    {
        中文接数(结果, 分位, 真);
        拼接到(结果, '分');
    }
    否则
    {
        拼接到(结果, '整');
    }
    返回 结果;
}
