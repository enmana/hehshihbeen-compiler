// ============================================================
// 大数.hb —— 任意精度整数库(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 用法:一份大数 = **一张定长数组 + 两个数**(`用` = 用了几格,`负` = 符号):
// ```
// 包含 "../库/大数.hb";
// 整数 左[64];  整数 左用 = 0;  整数 左负 = 0;
// 大数.从文字(左, 左用, 左负, "123456789012345678901234567890");
// 整数 右[64];  整数 右用 = 0;  整数 右负 = 0;
// 大数.从整数(右, 右用, 右负, 2);
// 整数 积[128]; 整数 积用 = 0;  整数 积负 = 0;
// 大数.乘(积, 积用, 积负, 左, 左用, 左负, 右, 右用, 右负);
// 输出行(大数.转字符串(积, 积用, 积负));
// ```
//
// ★ 一份大数长什么样(这一库的内存账):`表[]` 是**低位在前**的一串 limb,**每格一个 16 位无符号数**(0~65535);`用` 是
//   "有效的 limb 个数"(`用 = 0` 就是零);`负` 是符号。**规范形**三条:① `用 = 0` ⇒ 一律是零且 `负` 必须是 0;
//   ② 高位不许留 0 limb;③ 零只有一种写法。
//   16 位 limb 的理由:一条乘积最大 `65535 × 65535 + 65535 + 65535 = 4294967295 = 2³² − 1`,**正好装进一个
//   32 位 `无符号整数`** ⇒ 乘法一个别的库都不用引(零依赖)。
//
// ★ 容量(定长数组 + 有效 limb 个数,不是堆上动态长):`表.长度()` 就是这一份能装几格,**N 格 = 16N 位 ≈
//   4.8N 位十进制**;常用档 64 格 ≈ 308 位、128 格 ≈ 616 位、256 格 ≈ 1232 位。运算时**目标表不够大就给
//   `假`**(并把目标置零),不静默截断。不做动态长是因为语言里**列表取不出地址** ⇒ 状态只能在调用方那张表上。
//
// 口径(2026-10;每条都对着实测写):
//   · **零依赖**:一个别的库都不引(`长整数` 那套不碰);只用 `拼接到` 这一个内建;
//   · **所有函数都不停机**:容量不够 / 除数得零 / 文本不合法 ⇒ 给 `假` 或 0,不写错误槽;
//   · **`除余` 的语义照 x86 那一套**:`商` 写进你给的 `商` 表,**余数留在被除数 `左` 里**(想留原值先
//     `拷到` 一份);除数为零给 `假`;
//   · **试商用二分**:每一位商在 `0~65535` 上二分 16 轮,**简单、显然正确**,代价是比 Knuth 那套慢约 16 倍;
//   · **`结果` 可以与 `左` / `右` 是同一张表**(加 / 减 / 乘都支持就地;`乘` 先算进草稿纸再拷回来);
//   · **本库不可重入**:`除余` / `转字符串` 借的是模块里三张 256 格的草稿纸;
//   · **符号规则**:零一律 `负 = 0`;`谁大` 是带符号比较(-1 / 0 / 1);**除法是截断除法**(商的符号 = 被除数
//     符号异或除数符号,余数的符号 = 被除数的符号,且 `|余| < |除数|`)。
//
// 提供的函数(12 个):清零 / 是零 / 从整数 / 从文字 / 转字符串 / 谁大 / 加 / 减 / 乘 / 除余 / 取负 / 拷到;
//   逐条的参数与返回值见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:按"有效 limb 个数 = n" 算 —— 清零 / 从整数 / 是零 / 取负 / 拷到 / 谁大 / 加 / 减 O(n);
//   从文字 / 转字符串 O(数字位数 × n);**乘 O(n²)**(教科书竖式);**除余 O(16 n²)**(每位商二分 16 轮)。
//
// 边界(如实登记):
//   · **位数由 `表.长度()` 封顶**:不是"真任意精度",是"你要多大就开多大";
//   · **`除余` 的余数留在被除数里**(x86 语义):要留被除数先 `拷到`;
//   · **`从文字` 只认十进制**(不认 `0x` / 下划线 / 空白):不合法给 `假` 且置零;
//   · **不做模幂 / 最大公约数 / 开方 / 素性 / 浮点**:那些是"用大数写的算法",不是大数本身;
//   · **`结果` 可与 `左` / `右` 是同一张表**;**本库不可重入**。
// ============================================================
模块 大数

// 一格的位宽:16 位 ⇒ 65536
私有 整数 格 = 65536;
// 草稿纸(局部数组要占帧,96 字节的帧装不下 256 格 ⇒ 只能住模块级)
私有 整数 余纸[256];      // 长除法里的余数
私有 整数 试纸[256];      // 长除法里的"右 × 试商"
私有 整数 文纸[256];      // 转字符串时拷的那一份
私有 整数 乘纸[256];      // 乘法先算在这里(结果表可能与被乘数是同一张)

// ---------- 私有:把 `值` 夹进 [0, 上界] ----------
私有 方法 大数夹回(整数 值, 整数 上界) 返回 整数
{
    如果 (值 < 0)
    {
        返回 0;
    }
    如果 (值 > 上界)
    {
        返回 上界;
    }
    返回 值;
}

// ---------- 私有:大数整理(高位零 limb 去掉;用 == 0 时负必须归 0) ----------
私有 方法 大数整理(整数 表[], 引用 整数 用, 引用 整数 负)
{
    整数 剩 = 大数夹回(用, 表.长度());
    当 (剩 > 0 && 表[剩 - 1] == 0)
    {
        剩 = 剩 - 1;
    }
    用 = 剩;
    如果 (剩 == 0)
    {
        负 = 0;
    }
}

// ---------- 私有:大数整理"只给用"的那一份(草稿纸用) ----------
私有 方法 大数整理草稿(整数 用) 返回 整数
{
    整数 剩 = 用;
    当 (剩 > 0 && 余纸[剩 - 1] == 0)
    {
        剩 = 剩 - 1;
    }
    返回 剩;
}

// ---------- 私有:两张表的绝对值比大小(不带符号):-1 / 0 / 1 ----------
私有 方法 大数比绝对(整数 左[], 整数 左用, 整数 右[], 整数 右用) 返回 整数
{
    整数 左长度 = 大数夹回(左用, 左.长度());
    整数 右长度 = 大数夹回(右用, 右.长度());
    当 (左长度 > 0 && 左[左长度 - 1] == 0)
    {
        左长度 = 左长度 - 1;
    }
    当 (右长度 > 0 && 右[右长度 - 1] == 0)
    {
        右长度 = 右长度 - 1;
    }
    如果 (左长度 != 右长度)
    {
        如果 (左长度 < 右长度)
        {
            返回 -1;
        }
        返回 1;
    }
    整数 i = 左长度 - 1;
    当 (i >= 0)
    {
        如果 (左[i] != 右[i])
        {
            如果 (左[i] < 右[i])
            {
                返回 -1;
            }
            返回 1;
        }
        i = i - 1;
    }
    返回 0;
}

// ---------- 私有:绝对值相加(结果 = |左| + |右|) ----------
私有 方法 大数加绝对(整数 结果[], 引用 整数 结果用, 整数 左[], 整数 左用, 整数 右[], 整数 右用) 返回 逻辑
{
    整数 长 = 左用;
    如果 (右用 > 长)
    {
        长 = 右用;
    }
    如果 (长 + 1 > 结果.长度())
    {
        结果用 = 0;
        返回 假;
    }
    无符号整数 进位 = 0;
    整数 i = 0;
    当 (i < 长)
    {
        无符号整数 项 = 进位;
        如果 (i < 左用)
        {
            项 = 项 + 左[i];
        }
        如果 (i < 右用)
        {
            项 = 项 + 右[i];
        }
        结果[i] = 项 & 65535;
        进位 = 项 >> 16;
        i = i + 1;
    }
    结果用 = 长;
    如果 (进位 > 0)
    {
        结果[长] = 进位;
        结果用 = 长 + 1;
    }
    返回 真;
}

// ---------- 私有:绝对值相减(要求 |左| ≥ |右|;结果 = |左| − |右|) ----------
私有 方法 大数减绝对(整数 结果[], 引用 整数 结果用, 整数 左[], 整数 左用, 整数 右[], 整数 右用) 返回 逻辑
{
    如果 (左用 > 结果.长度())
    {
        结果用 = 0;
        返回 假;
    }
    整数 借 = 0;
    整数 i = 0;
    当 (i < 左用)
    {
        整数 项 = 左[i] - 借;
        如果 (i < 右用)
        {
            项 = 项 - 右[i];
        }
        如果 (项 < 0)
        {
            项 = 项 + 格;
            借 = 1;
        }
        否则
        {
            借 = 0;
        }
        结果[i] = 项;
        i = i + 1;
    }
    结果用 = 左用;
    返回 真;
}

// ---------- 私有:乘一个小整数并加一个小整数(`表 = 表 × 乘 + 加`;乘 ≤ 32767) ----------
私有 方法 大数乘加小(整数 表[], 引用 整数 用, 整数 乘, 整数 加) 返回 逻辑
{
    无符号整数 进位 = 加;
    整数 i = 0;
    当 (i < 用)
    {
        无符号整数 项 = 表[i] * 乘 + 进位;
        表[i] = 项 & 65535;
        进位 = 项 >> 16;
        i = i + 1;
    }
    整数 位 = 用;
    当 (进位 > 0)
    {
        如果 (位 >= 表.长度())
        {
            返回 假;
        }
        表[位] = 进位 & 65535;
        进位 = 进位 >> 16;
        位 = 位 + 1;
    }
    用 = 位;
    返回 真;
}

// ---------- 私有:除以一个小整数(`表 = 表 / 小`,返回余数;小 ≤ 32767) ----------
私有 方法 大数除小(整数 表[], 引用 整数 用, 整数 小) 返回 整数
{
    整数 余 = 0;
    整数 i = 用 - 1;
    当 (i >= 0)
    {
        整数 项 = 余 * 格 + 表[i];
        表[i] = 项 / 小;
        余 = 项 % 小;
        i = i - 1;
    }
    整数 剩 = 用;
    当 (剩 > 0 && 表[剩 - 1] == 0)
    {
        剩 = 剩 - 1;
    }
    用 = 剩;
    返回 余;
}

// ============================================================
// 1、装进来 / 送出去
// ============================================================

// 置成零
方法 清零(整数 表[], 引用 整数 用, 引用 整数 负)
{
    用 = 0;
    负 = 0;
}

// 规范形下 `用 = 0` 就是零
方法 是零(整数 用) 返回 逻辑
{
    返回 用 <= 0;
}

// `整数` 装进来(负号照收)
方法 从整数(整数 表[], 引用 整数 用, 引用 整数 负, 整数 值) 返回 逻辑
{
    用 = 0;
    负 = 0;
    如果 (值 == 0)
    {
        返回 真;
    }
    无符号整数 摸 = 值;
    如果 (值 < 0)
    {
        负 = 1;
        摸 = 0 - 值;
    }
    整数 位 = 0;
    当 (摸 > 0)
    {
        如果 (位 >= 表.长度())
        {
            用 = 0;
            负 = 0;
            返回 假;
        }
        表[位] = 摸 & 65535;
        摸 = 摸 >> 16;
        位 = 位 + 1;
    }
    用 = 位;
    返回 真;
}

// 十进制文字装进来(可带 + / -;不合法给 假)
方法 从文字(整数 表[], 引用 整数 用, 引用 整数 负, 字符串 文本) 返回 逻辑
{
    用 = 0;
    负 = 0;
    整数 起 = 0;
    如果 (文本.长度() > 0 && 文本[0] == '-')
    {
        负 = 1;
        起 = 1;
    }
    否则 如果 (文本.长度() > 0 && 文本[0] == '+')
    {
        起 = 1;
    }
    如果 (起 >= 文本.长度())
    {
        负 = 0;
        返回 假;
    }
    整数 i = 起;
    当 (i < 文本.长度())
    {
        整数 字 = 文本[i];
        如果 (字 < '0' || 字 > '9')
        {
            用 = 0;
            负 = 0;
            返回 假;
        }
        如果 (大数乘加小(表, 用, 10, 字 - '0') == 假)
        {
            用 = 0;
            负 = 0;
            返回 假;
        }
        i = i + 1;
    }
    大数整理(表, 用, 负);
    返回 真;
}

// 十进制文字(零给 "0",负数带 -)
方法 转字符串(整数 表[], 整数 用, 整数 负) 返回 字符串
{
    整数 有效长度 = 大数夹回(用, 表.长度());
    当 (有效长度 > 0 && 表[有效长度 - 1] == 0)
    {
        有效长度 = 有效长度 - 1;
    }
    如果 (有效长度 == 0)
    {
        返回 "0";
    }
    整数 i = 0;
    当 (i < 有效长度)
    {
        文纸[i] = 表[i];
        i = i + 1;
    }
    整数 剩 = 有效长度;
    字符串 倒 = "";
    当 (剩 > 0)
    {
        // **一位一位地除**(不是四位一组):四位一组要把"最高那一组不许补零"单独处理,
        // 逐位就不会有"补零补到前面去"这回事(实测四位一组那版把 12345 打成了 10005432)。
        整数 字 = 大数除小(文纸, 剩, 10);
        拼接到(倒, 大数一位(字));
    }
    字符串 成果 = "";
    整数 j = 倒.长度() - 1;
    当 (j >= 0)
    {
        拼接到(成果, 倒[j]);
        j = j - 1;
    }
    如果 (负 == 1)
    {
        字符串 带负 = "-";
        拼接到(带负, 成果);
        返回 带负;
    }
    返回 成果;
}

// ---------- 私有:一位数字 → 一个字符的串 ----------
私有 方法 大数一位(整数 位) 返回 字符串
{
    如果 (位 == 0)
    {
        返回 "0";
    }
    如果 (位 == 1)
    {
        返回 "1";
    }
    如果 (位 == 2)
    {
        返回 "2";
    }
    如果 (位 == 3)
    {
        返回 "3";
    }
    如果 (位 == 4)
    {
        返回 "4";
    }
    如果 (位 == 5)
    {
        返回 "5";
    }
    如果 (位 == 6)
    {
        返回 "6";
    }
    如果 (位 == 7)
    {
        返回 "7";
    }
    如果 (位 == 8)
    {
        返回 "8";
    }
    返回 "9";
}


// ============================================================
// 2、比大小
// ============================================================

// 带符号比大小:-1 / 0 / 1
方法 谁大(整数 左[], 整数 左用, 整数 左负, 整数 右[], 整数 右用, 整数 右负) 返回 整数
{
    整数 左零 = 0;
    整数 右零 = 0;
    如果 (大数夹回(左用, 左.长度()) == 0)
    {
        左零 = 1;
    }
    如果 (大数夹回(右用, 右.长度()) == 0)
    {
        右零 = 1;
    }
    如果 (左零 == 1 && 右零 == 1)
    {
        返回 0;
    }
    如果 (左零 == 1)
    {
        如果 (右负 == 1)
        {
            返回 1;
        }
        返回 -1;
    }
    如果 (右零 == 1)
    {
        如果 (左负 == 1)
        {
            返回 -1;
        }
        返回 1;
    }
    如果 (左负 != 右负)
    {
        如果 (左负 == 1)
        {
            返回 -1;
        }
        返回 1;
    }
    整数 比 = 大数比绝对(左, 左用, 右, 右用);
    如果 (左负 == 1)
    {
        返回 0 - 比;
    }
    返回 比;
}

// ============================================================
// 3、加减乘
// ============================================================

// 结果 = 左 + 右(支持就地)
方法 加(整数 结果[], 引用 整数 结果用, 引用 整数 结果负, 整数 左[], 整数 左用, 整数 左负, 整数 右[], 整数 右用, 整数 右负) 返回 逻辑
{
    整数 左长度 = 大数夹回(左用, 左.长度());
    整数 右长度 = 大数夹回(右用, 右.长度());
    结果用 = 0;
    结果负 = 0;
    如果 (左长度 == 0 && 右长度 == 0)
    {
        返回 真;
    }
    如果 (左长度 == 0)
    {
        返回 拷到(结果, 结果用, 结果负, 右, 右长度, 右负);
    }
    如果 (右长度 == 0)
    {
        返回 拷到(结果, 结果用, 结果负, 左, 左长度, 左负);
    }
    如果 (左负 == 右负)
    {
        如果 (大数加绝对(结果, 结果用, 左, 左长度, 右, 右长度) == 假)
        {
            返回 假;
        }
        结果负 = 左负;
        返回 真;
    }
    整数 比 = 大数比绝对(左, 左长度, 右, 右长度);
    如果 (比 == 0)
    {
        结果用 = 0;
        结果负 = 0;
        返回 真;
    }
    如果 (比 > 0)
    {
        如果 (大数减绝对(结果, 结果用, 左, 左长度, 右, 右长度) == 假)
        {
            返回 假;
        }
        结果负 = 左负;
    }
    否则
    {
        如果 (大数减绝对(结果, 结果用, 右, 右长度, 左, 左长度) == 假)
        {
            返回 假;
        }
        结果负 = 右负;
    }
    大数整理(结果, 结果用, 结果负);
    返回 真;
}

// 结果 = 左 - 右(支持就地)
方法 减(整数 结果[], 引用 整数 结果用, 引用 整数 结果负, 整数 左[], 整数 左用, 整数 左负, 整数 右[], 整数 右用, 整数 右负) 返回 逻辑
{
    整数 反 = 0;
    如果 (大数夹回(右用, 右.长度()) > 0)
    {
        如果 (右负 == 0)
        {
            反 = 1;
        }
    }
    返回 加(结果, 结果用, 结果负, 左, 左用, 左负, 右, 右用, 反);
}

// 结果 = 左 × 右(支持就地;先算进草稿纸再拷回来)
方法 乘(整数 结果[], 引用 整数 结果用, 引用 整数 结果负, 整数 左[], 整数 左用, 整数 左负, 整数 右[], 整数 右用, 整数 右负) 返回 逻辑
{
    整数 左长度 = 大数夹回(左用, 左.长度());
    整数 右长度 = 大数夹回(右用, 右.长度());
    结果用 = 0;
    结果负 = 0;
    如果 (左长度 == 0 || 右长度 == 0)
    {
        返回 真;
    }
    如果 (左长度 + 右长度 > 结果.长度() || 左长度 + 右长度 > 256)
    {
        返回 假;
    }
    // **先算进草稿纸,最后再拷回结果表**:`结果` 允许跟 `左` / `右` 是同一张表
    // (实测:`乘(数0, …, 数0, …, 数1, …)` 那条,就地算会先把被乘数冲成 0 —— 结果悄悄变成零)。
    整数 k = 0;
    当 (k < 左长度 + 右长度)
    {
        乘纸[k] = 0;
        k = k + 1;
    }
    整数 i = 0;
    当 (i < 左长度)
    {
        无符号整数 进位 = 0;
        整数 j = 0;
        当 (j < 右长度)
        {
            无符号整数 项 = 左[i] * 右[j] + 乘纸[i + j] + 进位;
            乘纸[i + j] = 项 & 65535;
            进位 = 项 >> 16;
            j = j + 1;
        }
        乘纸[i + 右长度] = 进位;
        i = i + 1;
    }
    k = 0;
    当 (k < 左长度 + 右长度)
    {
        结果[k] = 乘纸[k];
        k = k + 1;
    }
    结果用 = 左长度 + 右长度;
    如果 (左负 == 右负)
    {
        结果负 = 0;
    }
    否则
    {
        结果负 = 1;
    }
    大数整理(结果, 结果用, 结果负);
    返回 真;
}

// ============================================================
// 4、除余(商给出去,余数留在被除数里 —— x86 那一套)
// ============================================================

// 试商:`右 × 试 ≤ 余纸(用余个 limb)` 就给真(试纸里留下乘积)。
私有 方法 大数试乘(整数 右[], 整数 右用, 整数 试, 整数 余个) 返回 逻辑
{
    整数 需 = 右用 + 1;
    如果 (试 == 0)
    {
        整数 z = 0;
        当 (z < 需)
        {
            试纸[z] = 0;
            z = z + 1;
        }
        返回 假;
    }
    无符号整数 进位 = 0;
    整数 i = 0;
    当 (i < 右用)
    {
        无符号整数 项 = 右[i] * 试 + 进位;
        试纸[i] = 项 & 65535;
        进位 = 项 >> 16;
        i = i + 1;
    }
    试纸[右用] = 进位 & 65535;
    整数 试长 = 右用 + 1;        // ⚠ 从 `右用 + 1` 起:乘积最高那一格落在 试纸[右用] 上(从 `右用` 起会把进位那一格漏掉)
    当 (试长 > 0 && 试纸[试长 - 1] == 0)
    {
        试长 = 试长 - 1;
    }
    如果 (试长 > 余个)
    {
        返回 假;
    }
    如果 (试长 < 余个)
    {
        返回 真;
    }
    整数 j = 试长 - 1;
    当 (j >= 0)
    {
        如果 (试纸[j] != 余纸[j])
        {
            如果 (试纸[j] < 余纸[j])
            {
                返回 真;
            }
            返回 假;
        }
        j = j - 1;
    }
    返回 真;
}

// 余纸(用余个 limb)−= 试纸(用试长个 limb)
私有 方法 大数减草稿(整数 余个, 整数 试长)
{
    整数 借 = 0;
    整数 i = 0;
    当 (i < 余个)
     {
        整数 项 = 余纸[i] - 借;
        如果 (i < 试长)
        {
            项 = 项 - 试纸[i];
        }
        如果 (项 < 0)
        {
            项 = 项 + 格;
            借 = 1;
        }
        否则
        {
            借 = 0;
        }
        余纸[i] = 项;
        i = i + 1;
    }
}

// 试商:在 0~65535 上**二分 16 轮**,找最大的 `试` 使 `右 × 试 ≤ 余纸(用余个 limb)`。
// 为什么不用 Knuth 那套"估商 + 修正":那一套要 64 位中间值(16 位 limb 下拿不到),
// 二分的写法**简单、显然正确**,代价是每位商多花 16 倍时间(头注释的"复杂度"一节如实写了)。
私有 方法 大数试一位(整数 右[], 整数 右用, 整数 余个) 返回 整数
{
    整数 低 = 0;
    整数 高 = 65535;
    整数 好 = 0;
    当 (低 <= 高)
    {
        整数 中 = (低 + 高) / 2;
        如果 (大数试乘(右, 右用, 中, 余个) == 真)
        {
            好 = 中;
            低 = 中 + 1;
        }
        否则
        {
            高 = 中 - 1;
        }
    }
    返回 好;
}

// 余纸 −= 右 × 试(乘出来的乘积在 `大数试乘` 里落进 试纸)
私有 方法 大数减掉试(整数 右[], 整数 右用, 整数 试, 整数 余个) 返回 整数
{
    大数试乘(右, 右用, 试, 余个);
    整数 试长 = 右用 + 1;
    当 (试长 > 0 && 试纸[试长 - 1] == 0)
    {
        试长 = 试长 - 1;
    }
    大数减草稿(余个, 试长);
    整数 剩 = 余个;
    当 (剩 > 0 && 余纸[剩 - 1] == 0)
    {
        剩 = 剩 - 1;
    }
    返回 剩;
}

// `商` 写进 `商` 表,**余数留在 `左` 里**;除数为零给 假
方法 除余(整数 左[], 引用 整数 左用, 引用 整数 左负, 整数 右[], 整数 右用, 整数 右负, 整数 商[], 引用 整数 商用, 引用 整数 商负) 返回 逻辑
{
    整数 左长度 = 大数夹回(左用, 左.长度());
    整数 右长度 = 大数夹回(右用, 右.长度());
    商用 = 0;
    商负 = 0;
    如果 (右长度 == 0)
    {
        返回 假;
    }
    如果 (左长度 == 0)
    {
        左用 = 0;
        左负 = 0;
        返回 真;
    }
    如果 (左长度 > 商.长度() || 左长度 > 256 || 右长度 > 255)
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 左长度)
    {
        余纸[i] = 0;
        i = i + 1;
    }
    整数 余个 = 0;
    整数 k = 左长度 - 1;
    当 (k >= 0)
    {
        // 余 = 余 × 65536 + 左[k]:整体左移一格,再把这一格放到最低位
        i = 余个;
        当 (i > 0)
        {
            余纸[i] = 余纸[i - 1];
            i = i - 1;
        }
        余纸[0] = 左[k];
        余个 = 余个 + 1;
        当 (余个 > 0 && 余纸[余个 - 1] == 0)
        {
            余个 = 余个 - 1;
        }
        整数 好 = 大数试一位(右, 右长度, 余个);
        商[k] = 好;
        如果 (好 > 0)
        {
            余个 = 大数减掉试(右, 右长度, 好, 余个);
        }
        k = k - 1;
    }
    商用 = 左长度;
    // 商的符号 = 被除数符号 **异或** 除数符号(截断除法,C / x86 那一套);
    // 余数的符号 = 被除数的符号(上面那几个 `左负` 没动就是它)。
    如果 (左负 == 右负)
    {
        商负 = 0;
    }
    否则
    {
        商负 = 1;
    }
    大数整理(商, 商用, 商负);
    // 余数写回被除数(x86 那一套:余数留在被除数里)
    i = 0;
    当 (i < 余个)
    {
        左[i] = 余纸[i];
        i = i + 1;
    }
    左用 = 余个;
    如果 (余个 == 0)
    {
        左负 = 0;
    }
    返回 真;
}


// ============================================================
// 5、零碎
// ============================================================

// 就地翻符号(零不变)
方法 取负(整数 表[], 整数 用, 引用 整数 负)
{
    如果 (大数夹回(用, 表.长度()) == 0)
    {
        负 = 0;
        返回;
    }
    如果 (负 == 1)
    {
        负 = 0;
        返回;
    }
    负 = 1;
}

// 把 `源` 拷进 `结果`
方法 拷到(整数 结果[], 引用 整数 结果用, 引用 整数 结果负, 整数 源[], 整数 源用, 整数 源负) 返回 逻辑
{
    整数 有效长度 = 大数夹回(源用, 源.长度());
    当 (有效长度 > 0 && 源[有效长度 - 1] == 0)
    {
        有效长度 = 有效长度 - 1;
    }
    结果用 = 0;
    结果负 = 0;
    如果 (有效长度 == 0)
    {
        返回 真;
    }
    如果 (有效长度 > 结果.长度())
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 有效长度)
    {
        结果[i] = 源[i];
        i = i + 1;
    }
    结果用 = 有效长度;
    结果负 = 源负;
    返回 真;
}
