// ============================================================
// 流.hb —— 块读写 + 行读的大文件那一层(零依赖)
//
// 用法:
// ```
// 包含 "../库/流.hb";
// 整数 句 = 流.开读("日志/大文件.log");
// 当 (流.读块(句) > 0)
// {
//     输出行(流.当前块(句).长度());          // 一块一块吃,不整份进内存
// }
// 流.关(句);
// 整数 写句 = 流.开写("数据/结果.txt");
// 流.写行(写句, "第一行");
// 流.写块(写句, "接在后面的一段");
// 流.关(写句);                                // 关写流会先落盘
// 整数 读句 = 流.开读("数据/结果.txt");
// 当 (流.读行(读句))                          // 按行读(跨块拼行)
// {
//     输出行(流.当前行(读句));
// }
// 流.关(读句);
// ```
//
// 真实数据(日志 / CSV / JSON 导出)动辄几 MB,而运行内存默认 1MB。内建那七条已经是"分块"的形状了,
//   但要你自己数句柄、自己拼行、自己分辨读流与写流;这一库把它们收成"开一条流、要一块给一块、要一行给一行":
//   ① **块**:`读块` 一次要 4KB 进本库那一格,用 `当前块` 取;② **行**:`读行` 跨块拼行(`\n` 断行、行尾 `\r`
//   去掉、末行没有换行也算一行);③ **写**:`写块` / `写行` 往后写,`关` 之前先落盘(`冲刷` 那一档)。
//
// 口径(2026-10;每条都对着实测写):
//   · **块大小固定 4096 字节**(内建 `读一块` 的上限要编译期常量)⇒ 一次最多拿 4KB;
//     `读块` 的返回值才是"真拿到几个字节"(0 = 到末尾,-1 = 句柄无效);末尾那一块也照实给长度;
//   · **读内容不往调用方写**:`读块` / `读行` 之后用 `当前块` / `当前行` 取 —— 与 `文件.hb` 的
//     `下一行` + `当前行` 同一套写法(也是 `基础库框架.md` §8.4 那条拉模式约定里的后一种);
//   · **长跑不吃池(2026-10-11 修)**:块 / 行 / 正在吃的那一块 / 半行这几格**全是模块级持久串**,
//     每次调用都**就地复用**(函数体里一条"造新串"的局部声明都没有 —— 每调用一次造一条,两万行就把池吃光);
//     `写行` 连拼都不拼:文本与换行**分两块直接写下去**(写流本来就是顺序缓冲,两块与一块等价);
//     找换行、切行这些逐字节的活走模块级 `字符 区[]`(下标 O(1);`字符串[i]` 是 O(下标),整段扫会变平方);
//     判据 = 同一个两万行文件"写得完 + 逐行读得完",且池不涨(自检 `流与CSV库 长跑不吃池` 那一条);
//   · **一条流同时只能有一种方向**:开读 / 开写各占一格,`关` 按方向关(`关读流` / `关写流`);
//     **关写流会把缓冲冲刷到盘上**(这是内建的口径,不是本库另加的);
//   · **16 格**:同时开 16 条;句柄 = `格子 * 65536 + 版本`,关掉之后版本 +1 ⇒ **旧句柄当场作废**
//     (拿它再调一律给假 / -1,不会串到别人的流上);`读行` 的进度记在格子上,两条流交错着读互不干扰;
//   · **`写行` 的换行是 `\n`**(与 `读行` 的断行口径对称;要别的行尾就自己 `写块`);
//   · **失败给假 / -1,不停机**:打不开、句柄作废、写到关闭的流上都有确定结果。
//
// 提供的函数:逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:开 / 关 O(1);读块 / 写块 O(这一块);读行 O(这一行)(每一块只往扫描区搬一次 ——
//   不按行重复搬,长行跨块那一趟也是每块一次);落盘 O(缓冲里的字节)。
//
// 内存账:静态**一个 4224 字节的扫描区**(`字符`)+ 每格**三条串**(当前块 / 当前行 / 正在吃的那一块,
//   都在池里**反复用同一格**)+ 两条模块级暂存串 ⇒ 常驻与文件多大无关,只与"同时开几条流"有关。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **不做"随机读写"**:要挪位置得自己调内建 `定位(句柄, 偏移)` —— 本库只暴露"顺序读写"这一档
//     (排到 `大文件工具.hb` / `CSV 流` 那一层的需求都够用);
//   · **16 格是硬的**:超了给 -1(不排队、不抢占);一格一条流,和 `文件.hb` 那 16 格**各算各的**;
//   · **写流不建目录**(内建 `打开写流` 就是这个口径):要建目录自己先 `建目录`;
//   · **一次最多 4KB**:要更大的块请自己在外面套一层(或者调内建的 `读一块` 给更大的编译期上限);
//   · **不做"取文件大小"**:要长度就 `当 (读块(句) > 0) { 合计 = 合计 + … }` 数一遍
//     (`大文件工具.hb.数行` / `拷到` 就是这么写的);
//   · **行里的 `\r` 一律去掉**(不只是行尾那一个;本库从第一版起就是这个口径,`读行` 那一趟整行过一遍);
//     要原样的字节请用 `读块`;
//   · **夹着 0 字节(`\0`)的行**:那个字节**不进这一行**(当"文本里不该有的字节"跳过),这一行其余字节照给、
//     后面的行接着走 —— 要原样的二进制请用 `读块` + `字符 区[]`(⚠ 每格留的那份"正在吃的块"经
//     `字符串数组元素 = 串` 一转会被 0 截断,那是语言面的口径;`读行` 这一条路的扫描区是**从刚读回的
//     那条串直搬**的,一个字节不少;`当前块` 那一份只经元素这一条路,夹 0 的块它会短一截;
//     同一格连着读不受影响,两条流交错着读回来时才可能要重搬那一截)。
// ============================================================
模块 流

// ---------- 模块状态:16 格 ----------
私有 整数 流句柄[16];
私有 整数 流版本[16];
私有 整数 流在用[16];
私有 整数 流是写[16];
私有 字符串 流块[16];              // 上一次 `读块` 拿到的那一块(给 `当前块` 取)
私有 字符串 流行[16];              // 上一次 `读行` 拿到的那一行(给 `当前行` 取)
私有 字符串 流行块[16];            // `读行` 正在吃的那一块(与 `流块` 分开:读行不动"当前块")
私有 整数 流行块长[16];            // 那一块里真有几个字节
私有 整数 流位[16];                // 下一行从那一块的哪个字节接着找

// ---------- 模块级暂存:每次调用就地复用(不新造字符串) ----------
私有 字符 流扫区[4224];            // 当前吃的那一块搬在这儿,按字节走(下标 O(1))
私有 整数 流扫是格 = 0 - 1;        // 扫描区里放的是哪一格的块(-1 = 里面那份不算数)
私有 字符串 流读暂;                // `读一块` 的落地格(内容当场搬走,不存第二处)
私有 字符串 流半行;                // 跨块拼行时已经攒下的那半行

// ============================================================
// 私有:格子的读 / 写帮手
//   (`字符串` 数组的元素**不能直接当"字符串赋值的右边"**,也不能拿它当 `清空()` / `拼接到()` 的落点
//    —— `行[3].清空();` 单独成句当场报"未知指令: 行";所以**置**那一头走"字符串形参"、
//    **取**那一头走"整元素直接返回 / 直接当实参";
//    ⚠ 别在这儿套一层"返回字符串的帮手"再拿去当实参 —— 那种写法每调用一次从池里漏一块,
//    短串长跑也会把池吃光:实测 `拼接到(区, 取串())` 两万轮就停,而 `拼接到(区, 表[格])` 不停)
// ============================================================
私有 方法 流置块(整数 格, 字符串 文本)
{
    流块[格] = 文本;
    返回
}

私有 方法 流置行(整数 格, 字符串 文本)
{
    流行[格] = 文本;
    返回
}

私有 方法 流置行块(整数 格, 字符串 文本)
{
    流行块[格] = 文本;
    返回
}

// ---------- 私有:查一个句柄 → 格子号(-1 = 不成形) ----------
私有 方法 流查格(整数 句柄) 返回 整数
{
    整数 格 = 句柄 / 65536;
    整数 版 = 句柄 % 65536;
    如果 (格 < 0 || 格 > 15)
    {
        返回 0 - 1;
    }
    如果 (流在用[格] == 0 || 流版本[格] != 版)
    {
        返回 0 - 1;
    }
    返回 格;
}

// ---------- 私有:找一个空流格(满了给 -1) ----------
私有 方法 流空格() 返回 整数
{
    整数 i = 0;
    当 (i < 16)
    {
        如果 (流在用[i] == 0)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// ---------- 私有:一格的读行状态清干净(开 / 关 都走它) ----------
私有 方法 流清读(整数 格)
{
    流置块(格, "");
    流置行(格, "");
    流置行块(格, "");
    流行块长[格] = 0;
    流位[格] = 0;
    流扫是格 = 0 - 1;              // 扫描区里那份作废(别的格可能正在吃它那一块)
    返回
}

// ---------- 私有:把这一格正在吃的那一块搬进扫描区(一块只搬一次) ----------
//   `块` 由调用方当实参递进来 —— 本库这一层不声明任何新串
私有 方法 流铺扫描区(整数 格, 字符串 块)
{
    流扫区[0] = 0;
    拼接到(流扫区, 块);
    流扫是格 = 格;
    返回
}

// ---------- 私有:要下一块(读进 `流读暂`,交进格子、也当场铺进扫描区;返回真读到几个字节) ----------
//   ⚠ 扫描区**从刚读回来那条串搬**(不是从格子搬):`字符串数组元素 = 串` 那一步按 0 截断(语言面口径),
//     夹着 0 字节的块经格子一转就短了 —— 从 `流读暂` 直搬,这一趟的字节一个不少
私有 方法 流读一块进(整数 格) 返回 整数
{
    整数 块长 = 读一块(流句柄[格], 流读暂, 4096);
    流置行块(格, 流读暂);
    流行块长[格] = 块长;
    流位[格] = 0;
    流扫是格 = 0 - 1;
    如果 (块长 > 0)
    {
        流铺扫描区(格, 流读暂);
    }
    返回 块长;
}

// ---------- 私有:扫 [流位, 块长) 找 `\n`(给了它的字节下标;没有给 -1) ----------
私有 方法 流扫找换行(整数 格) 返回 整数
{
    整数 i = 流位[格];
    整数 长 = 流行块长[格];
    当 (i < 长)
    {
        如果 (流扫区[i] == '\n')
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// ---------- 私有:把扫描区里 [流位, 块长) 这一段接到半行后面(这一块没换行,整段都是半行) ----------
//   ⚠ 取出来那一格是 `字符`(**一个字节**)不是 `文字`(一个码点):写成 `文字` 会把每个字节当成码点
//   重新 UTF-8 编码一遍(实测:中文整篇变成乱码、`长度()` 也翻倍)
//   `\r` 与 `\0` 都不进这一行:`\0` 是"文本里不该有的字节",而且**往串上接一个 0 字节会把那格搅坏**
//   (下一个字节接不上去)⇒ 一律跳过,顺带让夹着 0 的日志也照常往下走
私有 方法 流接半行(整数 格)
{
    整数 i = 流位[格];
    整数 长 = 流行块长[格];
    当 (i < 长)
    {
        字符 字 = 流扫区[i];
        整数 码 = 字;
        如果 (码 == 13 || 码 == 0)
        {
            i = i + 1;
            继续;
        }
        拼接到(流半行, 字);
        i = i + 1;
    }
    流位[格] = 长;
    返回
}

// ---------- 私有:把扫描区里 [流位, 止) 这一段接到半行后面,并把 流位 挪到 `止` 之后 ----------
私有 方法 流收一行(整数 格, 整数 止)
{
    整数 i = 流位[格];
    当 (i < 止)
    {
        字符 字 = 流扫区[i];
        整数 码 = 字;
        如果 (码 == 13 || 码 == 0)
        {
            i = i + 1;
            继续;
        }
        拼接到(流半行, 字);
        i = i + 1;
    }
    流位[格] = 止 + 1;
    返回
}

// ============================================================
// 1、开 / 关
// ============================================================

// 开一条读流(文件得已经存在),给句柄;打不开或 16 格占满给 -1
方法 开读(字符串 路径) 返回 整数
{
    整数 格 = 流空格();
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    整数 句柄 = 0;
    整数 丢 = 打开读流(路径, 句柄);
    如果 (句柄 < 0)
    {
        返回 0 - 1;
    }
    流句柄[格] = 句柄;
    流是写[格] = 0;
    流清读(格);
    流在用[格] = 1;
    流版本[格] = 流版本[格] + 1;
    返回 格 * 65536 + 流版本[格];
}

// 开一条写流(不存在就新建、已存在从头写起;路径上的目录不建),开不出来给 -1
方法 开写(字符串 路径) 返回 整数
{
    整数 格 = 流空格();
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    整数 句柄 = 0;
    整数 丢 = 打开写流(路径, 句柄);
    如果 (句柄 < 0)
    {
        返回 0 - 1;
    }
    流句柄[格] = 句柄;
    流是写[格] = 1;
    流清读(格);
    流在用[格] = 1;
    流版本[格] = 流版本[格] + 1;
    返回 格 * 65536 + 流版本[格];
}

// 按方向关掉这条流,写流先落盘;句柄不成形给假,关完旧句柄作废
方法 关(整数 句柄) 返回 逻辑
{
    整数 格 = 流查格(句柄);
    如果 (格 < 0)
    {
        返回 假;
    }
    整数 状态 = 0;
    如果 (流是写[格] == 1)
    {
        状态 = 关写流(流句柄[格]);
    }
    否则
    {
        状态 = 关读流(流句柄[格]);
    }
    流清读(格);
    流是写[格] = 0;
    流在用[格] = 0;
    流版本[格] = 流版本[格] + 1;
    返回 状态 == 0;
}

// ============================================================
// 2、读
// ============================================================

// 读一块(最多 4096 字节),给真读到的字节数;0 = 到末尾,-1 = 句柄不成形或写流
方法 读块(整数 句柄) 返回 整数
{
    整数 格 = 流查格(句柄);
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    如果 (流是写[格] == 1)
    {
        返回 0 - 1;
    }
    整数 块长 = 读一块(流句柄[格], 流读暂, 4096);
    流置块(格, 流读暂);
    返回 块长;
}

// 给上一次 `读块` 拿到的那一块(不读文件);句柄不成形给空串
方法 当前块(整数 句柄) 返回 字符串
{
    整数 格 = 流查格(句柄);
    如果 (格 < 0)
    {
        返回 "";
    }
    返回 流块[格];
}

// 跨块拼出下一行(行里 `\r` 一律去掉,末尾没换行的也算一行);到末尾、句柄不成形或写流给假
方法 读行(整数 句柄) 返回 逻辑
{
    整数 格 = 流查格(句柄);
    如果 (格 < 0)
    {
        返回 假;
    }
    如果 (流是写[格] == 1)
    {
        返回 假;
    }
    流置行(格, "");
    流半行.清空();
    当 (真)
    {
        如果 (流位[格] >= 流行块长[格])
        {
            // 这一块吃完了(或还没读过):再要一块
            整数 块长 = 流读一块进(格);
            如果 (块长 <= 0)
            {
                如果 (流半行.长度() == 0)
                {
                    返回 假;
                }
                流置行(格, 流半行);           // 末行没有换行,也算一行
                流半行.清空();
                返回 真;
            }
            继续;
        }
        如果 (流扫是格 != 格)
        {
            流铺扫描区(格, 流行块[格]);
        }
        整数 断 = 流扫找换行(格);
        如果 (断 < 0)
        {
            流接半行(格);                    // 整块都没换行:全归半行,再要一块
            继续;
        }
        流收一行(格, 断);
        流置行(格, 流半行);
        流半行.清空();
        返回 真;
    }
    返回 假;
}

// 给上一次 `读行` 拼出的那一行(不读文件);句柄不成形给空串
方法 当前行(整数 句柄) 返回 字符串
{
    整数 格 = 流查格(句柄);
    如果 (格 < 0)
    {
        返回 "";
    }
    返回 流行[格];
}

// ============================================================
// 3、写
// ============================================================

// 把整串写进写流;给真写下去的字节数,句柄不成形或读流给 -1
方法 写块(整数 句柄, 字符串 文本) 返回 整数
{
    整数 格 = 流查格(句柄);
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    如果 (流是写[格] == 0)
    {
        返回 0 - 1;
    }
    返回 写一块(流句柄[格], 文本, 0);
}

// 把文本 + 一个 `\n` 分两块写下去(不拼整串);给写掉的字节数,句柄不成形给 -1
方法 写行(整数 句柄, 字符串 文本) 返回 整数
{
    整数 格 = 流查格(句柄);
    如果 (格 < 0)
    {
        返回 0 - 1;
    }
    如果 (流是写[格] == 0)
    {
        返回 0 - 1;
    }
    // 分两块写下去(文本 + 换行),**不在库里拼那一条新串** —— 拼一次就得把整行再抄一遍,
    // 长循环里那一趟白抄既费时又是池的老病根(内建的写流本来就是顺序缓冲,两块与一块等价)
    整数 写掉 = 写一块(流句柄[格], 文本, 0);
    如果 (写掉 < 0)
    {
        返回 写掉;
    }
    整数 换行掉 = 写一块(流句柄[格], "\n", 0);
    如果 (换行掉 < 0)
    {
        返回 换行掉;
    }
    返回 写掉 + 换行掉;
}

// 把写流的缓冲冲下去(流还开着);0 = 成功,句柄不成形给 22、读流给 9
方法 落盘(整数 句柄) 返回 整数
{
    整数 格 = 流查格(句柄);
    如果 (格 < 0)
    {
        返回 22;                       // 句柄无效(与内建同一套号)
    }
    如果 (流是写[格] == 0)
    {
        返回 9;                        // 参数不合法:读流没有"落盘"这回事
    }
    返回 冲刷(流句柄[格]);
}
