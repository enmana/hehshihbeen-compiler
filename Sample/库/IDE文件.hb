// ============================================================
// IDE文件.hb —— **打开 / 编辑 / 存盘那个闭环**(纯 HB 库:不动 ISA、不动关键字、不动机器码)
//
// 用法:
// ```
// 包含 "../库/编辑器.hb";
// 包含 "../库/IDE文件.hb";
//
// 编辑器.编辑缓冲 编;
// 编辑器.建编辑器(编, 20);
// IDE文件.档 档;
// IDE文件.建库(档, "Sample\\中间层\\示例01_类型与字面量\\主程序.hb");
// 如果 (IDE文件.打开(档, 编)) { ...改... IDE文件.存盘(档, 编); }
// ```
//
// 治的是**"手上这份文件从盘上来、改完还能回盘上去"**这件事:读 / 写 / 改没改 / 工程文件表 /
// 换文件名。**它不管界面**(文件栏与输出区是 4-3 `IDE布局.hb` 的活),也不管编译(那是 4-6 的活)。
//
// 口径(每条都对着实测写):
//   · **打开 = 读全部 + 灌进缓冲**(`编辑器.装入文本` 会先把缓冲清空)⇒ 打开之后**光标在末尾**、
//     **改动标记是假**(刚读进来的不算改过);失败(文件不在 / 读不出来)给假、**缓冲不动**;
//   · **存盘 = 把缓冲的 `全部文本()` 写回原路径**(走 `文件.安全写全部`:先写临时文件再改名 ——
//     与 `文件.hb` 同一把尺子)⇒ 成功之后**改动标记清掉**;没打开过任何文件给假;
//   · **`改动过(档, 编)`** 就是问编辑器自己那个标记(档里不另存一份,免得两边说法不一样);
//   · **工程文件表**:`加工程文件` 逐条登记 `.hbp` 里那份文件表(调用方自己从 `.hbp` 里读出来),
//     `工程文件数` / `工程文件` 按号问;`打开工程` 把每一条都试一遍、回来的是**成了几条**;
//   · **另存为**:`另存(档, 编, 新路径)` 写新路径、写完把"当前文件"换成新路径(与原路径无关);
//   · **不报错、不停机**:路径不存在 / 读不出来一律给假;下标越界给空串。
//
// 提供的函数(10 个):逐条的作用见每个函数紧上面那行注释。
//
// 英文对照:**没有英文别名**(与现有几个库同一口径)。
//
// 复杂度:`打开` / `存盘` 都是 O(文件大小)(读一次 / 写一次);其余 O(1) 或 O(条数)。
//
// 边界(如实登记):
//   · **不做"最近打开"**(那是界面的状态,归调用方);
//   · **`打开工程` 只登记文件表、不解析 `.hbp` 的 JSON** —— 调用方拿到那份表自己喂进来
//     (`.hbp` 是几行固定格式,4-5 的示例里就是这么读的);
//   · **不做二进制**(`文件.hb` 那一层是文本读;要二进制走 `申请` + `读文件块`)。
// ============================================================

模块 IDE文件

包含 "文件.hb"

// ⚠⚠ **本库的状态一律放模块级变量,不用 `结构`、也不收"档"当参数**(实测踩了一整轮):
//   ① 结构一大(哪怕只是"1 条串 + 16 条串的数组" = 140 字节),函数一收它当参数就在**帧里拷一份**
//      ⇒ 96 字节的帧当场顶穿(`放不下局部变量 .路径`);加 `引用` 也躲不过全部情形;
//   ② 更硬的一条是**结构字段赋值**:`档.字段 = 表达式` / `档.字段 = 1` 一律不收 ——
//      只有"整体清 0"或"同结构整份拷过来"才收;连"先算局部再赋"都不行;
//   ③ 结构里的**字符串字段**还不能直接赋字面量或另一个串(要 `拼接到` 进去)。
//   ⇒ 口径:**"一堆可变状态"的库,状态放模块级变量** —— 与 `界面.hb` 的"一屏一表"同一个思路
//      (那里用并行数组,这里状态少就直接具名。⚠ 模块级变量一律带库名前缀)。
字符串 IDE文件_当前路径;
整数 IDE文件_工程数;
字符串 IDE文件_工程表[16];

// 建一个档(不打开任何文件)
方法 建库()
{
    IDE文件_当前路径 = "";
    IDE文件_工程数 = 0;
    整数 i = 0;
    当 (i < 16)
    {
        IDE文件_工程表[i] = "";
        i = i + 1;
    }
    返回
}

// 这份文件现在在不在盘上
方法 存在(字符串 路径) 返回 逻辑
{
    返回 文件.存在(路径);
}

// 打开一份文件:读全部 → 灌进缓冲(成功给真;读不出来 / 文件不在给假,缓冲不动)
方法 打开(引用 编辑器.编辑缓冲 编, 字符串 路径) 返回 逻辑
{
    如果 (!文件.存在(路径))
    {
        返回 假;
    }
    字符串 文 = 文件.读全部(路径);
    如果 (文.长度() == 0 && 文件.大小(路径) > 0)
    {
        返回 假;                                     // 有内容却读成空串 = 读失败
    }
    如果 (!编辑器.装入文本(编, 文))
    {
        返回 假;                                     // 行数超上限那一档
    }
    编辑器.清改动(编);                              // 刚读进来的不算"改过"
    拼接到(IDE文件_当前路径, 路径);
    返回 真;
}

// 打开"当前档里那份文件"(没打开过给假)
方法 重开(引用 编辑器.编辑缓冲 编) 返回 逻辑
{
    如果 (IDE文件_当前路径.长度() == 0)
    {
        返回 假;
    }
    返回 打开(编, IDE文件_当前路径);
}

// 存盘:把缓冲整篇写回原路径(走 `文件.安全写全部`),成功之后清掉改动标记
方法 存盘(引用 编辑器.编辑缓冲 编) 返回 逻辑
{
    如果 (IDE文件_当前路径.长度() == 0)
    {
        返回 假;
    }
    字符串 全篇 = 编辑器.全部文本(编);
    如果 (!文件.安全写全部(IDE文件_当前路径, 全篇))
    {
        返回 假;
    }
    编辑器.清改动(编);
    返回 真;
}

// 另存为:写到新路径,并把"当前文件"换成新路径(成不成都给结论)
方法 另存(引用 编辑器.编辑缓冲 编, 字符串 新路径) 返回 逻辑
{
    字符串 全篇 = 编辑器.全部文本(编);
    如果 (!文件.安全写全部(新路径, 全篇))
    {
        返回 假;
    }
    拼接到(IDE文件_当前路径, 新路径);
    编辑器.清改动(编);
    返回 真;
}

// 改过没有(问的就是编辑器自己那个标记 —— 档里不另存一份)
方法 改动过(引用 编辑器.编辑缓冲 编) 返回 逻辑
{
    返回 编辑器.改动过(编);
}

// 当前打开的是哪一份文件("" = 还没打开)
方法 当前路径() 返回 字符串
{
    返回 IDE文件_当前路径;
}

// 这份文件在不在当前打开的那个目录里(给"文件栏选中某一项"用)
方法 同一目录(字符串 路径甲, 字符串 路径乙) 返回 逻辑
{
    返回 目录段(路径甲) == 目录段(路径乙);
}

// 私有:取路径里"目录"那一段(最后一个分隔符之前;没有分隔符给空串)
方法 目录段(字符串 路径) 返回 字符串
{
    字符串 结果 = "";
    整数 位 = 0 - 1;
    整数 i = 0;
    整数 总 = 路径.长度();
    当 (i < 总)
     {
        字符 一 = 路径[i];
        如果 (一 == '\\' || 一 == '/')
        {
            位 = i;
        }
        i = i + 1;
     }
    如果 (位 < 0)
     {
        返回 结果;
    }
    返回 "";
}

// ---------------- 工程文件表 ----------------

// 往工程表里登记一条(满了给假)
方法 加工程文件(字符串 路径) 返回 逻辑
{
    整数 位 = IDE文件_工程数;
    如果 (位 >= 16)
    {
        返回 假;
    }
    拼接施工表(位, 路径);
    整数 新数 = 位 + 1;
    IDE文件_工程数 = 新数;
    返回 真;
}


// 私有:往工程表的第 `位` 格写一条
方法 拼接施工表(整数 位, 字符串 路径)
{
    拼接到(IDE文件_工程表[位], 路径);
    返回
}

// 工程表里登记了几条
方法 工程文件数() 返回 整数
{
    返回 IDE文件_工程数;
}

// 第几条登记的是什么("" = 没这一条)
方法 工程文件(整数 第几条) 返回 字符串
{
    如果 (第几条 < 0 || 第几条 >= IDE文件_工程数)
    {
        返回 "";
    }
    返回 IDE文件_工程表[第几条];
}

// 把工程表清空
方法 清工程()
{
    IDE文件_工程数 = 0;
    整数 i = 0;
    当 (i < 16)
     {
        IDE文件_工程表[i] = "";
        i = i + 1;
    }
    返回
}

// 把工程表里每一条都打开试一遍(每一条都读进来、比一比能不能读);回来的是**成了几条**
// (⚠ 它**不改变当前档**:一条条读着试,试完把 `IDE文件_当前路径` 复位 —— 调用方要真打开就用 `打开`)
方法 打开工程(引用 编辑器.编辑缓冲 编) 返回 整数
{
    字符串 原路径;
    拼接到(原路径, IDE文件_当前路径);
    整数 成 = 0;
    整数 i = 0;
    当 (i < IDE文件_工程数)
     {
        如果 (打开(编, IDE文件_工程表[i]))
        {
            成 = 成 + 1;
        }
        i = i + 1;
     }
    拼接到(IDE文件_当前路径, 原路径);
    返回 成;
}
