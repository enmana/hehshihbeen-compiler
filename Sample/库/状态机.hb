// ============================================================
// 状态机.hb —— **显式状态转移表**(纯 HB 库:不动 ISA、不动关键字、不机机器码)
//
// 用法:
// ```
// 包含 "../库/状态机.hb";
//
// 方法 开门了(整数 旧, 整数 新) { 输出行("开门"); 返回 }
// 方法 关门了(整数 旧, 整数 新) { 输出行("关门"); 返回 }
//
// 状态机.清掉();
// 状态机.建(3, 2);                                  // 3 个状态、2 种事件
// 状态机.设转移(0, 0, 1, 地址(开门了));              // 状态 0 --事件 0--> 状态 1
// 状态机.设转移(1, 1, 0, 地址(关门了));              // 状态 1 --事件 1--> 状态 0
// 状态机.设初始(0);
//
// 输出行(状态机.当前());                            // 0
// 输出行(状态机.喂(0));                              // 1(转到状态 1,顺手调了 `开门了`)
// 输出行(状态机.喂(0));                              // 1(没有这条转移 ⇒ 原地不动)
// 输出行(状态机.喂(1));                              // 0
// ```
//
// 治的是**“一坨 `如果`”** 那件事:协议解析 / 界面流程 / 游戏动画都是同一个形状 ——“现在是哪个状态 + 来了哪件事 ⇒ 变成哪个状态、顺手做点什么”。本库把它收成一张**写死的表**,转移表一眼看得完。
//
// 口径(2026-10-10;每条都对着实测写):
//   · **表是写死的**:状态 **4 个**(0~3)、事件 **4 种**(0~3)⇒ 最多 **16 条转移**;
//     超过就自己加一层"状态分组"(或者等本库出第二版)。`建(状态数, 事件数)` 会把表清空;
//   · **没设过的格子 = "不做任何事"**:`喂` 上去**原地不动**(返回当前状态),不报错、不停机 ——
//     这是状态机最要紧的默认值(不然"这一类事件在这个状态下没有定义"就变成了崩溃);
//   · **每个格子一个回调槽**:没设过转移的格子指到本库的空处理(什么都不做);
//   · **`喂` 的顺序**:先按"当前状态 + 事件"找到那一条 ⇒ 调它的处理函数(实参是**旧状态、新状态**)
//     ⇒ 再把当前状态改成新状态。**处理函数里看到的是"还没改"的旧状态**(要"改完之后再看"
//     就等 `喂` 返回之后再 `当前()`);
//   · **处理函数不许再 `喂` 同一个状态机**(重入会把当前状态改乱)—— 本库不拦,如实写在这儿;
//   · **`喂` 只认 0~3**:越界给"原点不动"(返回当前状态);
//   · **不报错、不停机**:`建` / `设转移` / `喂` 越界一律给确定结果(假 / 不改),与 `string.hb` 一个规矩;
//   · **`清掉`** 把转移表与当前状态一并复位(= 刚 `包含` 进来那一刻的样子),`清句柄表` 那一套的对拍要用它。
//
// 提供的函数(11 个):逐条的作用见本页末尾那张公开方法表。
//                                           设一条转移;下标越界给假
//   清转移(整数 旧, 整数 事件) 返回 逻辑      撤掉一条转移(那一格回到"什么都不做")
//   有转移(整数 旧, 整数 事件) 返回 逻辑      那一格设过吗
//   喂(整数 事件) 返回 整数                   喂一个事件;返回**喂完之后**的状态
//   当前() 返回 整数                          现在是哪个状态
//   设初始(整数 状态) 返回 逻辑               把当前状态设成这个(不触发任何处理函数)
//   目标(整数 旧, 整数 事件) 返回 整数         只看表:这一格会转到哪("原样" = 没有这条转移)
//   清掉()                                    转移表与当前状态一起复位
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:三个动作全是 O(转移表 16 格)—— 与"跑过多少事件"无关。
//
// 内存账:**一次都不申请堆**(整张表就是 16 个整数 + 16 个回调槽,全是模块级定长)。
//   **模块级变量一律带 `状态机` 前缀**(语言现状:模块级私有变量会与调用方的顶层同名变量共用一格)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **4 × 4 是上限**:要更大的表就自己拿 `map.hb` 按"旧状态 × 4 + 事件"当键存转移;
//   · **处理函数的签名是 `(整数 旧, 整数 新)` 且没有返回值** —— 要往别处写结果就在处理函数里写;
//   · **转移表与当前状态是"全进程一份"**:两个状态机要并行跑(比如两个连接),就得各建一张 ——
//     本库只提供一张(做成"一个状态机一个句柄"要动态申请,与"零申请"这条口径冲突);
//   · **不做"进入 / 退出动作"**:只有"转移时的动作"那一档;要进入动作就在处理函数里判 `新`.
// ============================================================

模块 状态机

// ---- 转移表:4 × 4 = 16 格,每格一个"新状态 + 处理函数" ----
// ⚠ 回调**不能放数组**(实测:`回调 表[4]` 报"要写清指向哪个函数")⇒ 一格一个具名槽。
回调 状态机_槽0 = 地址(状态机_空);
回调 状态机_槽1 = 地址(状态机_空);
回调 状态机_槽2 = 地址(状态机_空);
回调 状态机_槽3 = 地址(状态机_空);
回调 状态机_槽4 = 地址(状态机_空);
回调 状态机_槽5 = 地址(状态机_空);
回调 状态机_槽6 = 地址(状态机_空);
回调 状态机_槽7 = 地址(状态机_空);
回调 状态机_槽8 = 地址(状态机_空);
回调 状态机_槽9 = 地址(状态机_空);
回调 状态机_槽10 = 地址(状态机_空);
回调 状态机_槽11 = 地址(状态机_空);
回调 状态机_槽12 = 地址(状态机_空);
回调 状态机_槽13 = 地址(状态机_空);
回调 状态机_槽14 = 地址(状态机_空);
回调 状态机_槽15 = 地址(状态机_空);

整数 状态机_新[16];
逻辑 状态机_有[16];
整数 状态机_当前 = 0;

// 空处理:没设过转移的格子指到它,两个实参都不看,调用时什么都不做。
方法 状态机_空(整数 旧, 整数 新)
{
    返回
}

// 格子号 = 旧 * 4 + 事件
方法 状态机_号(整数 旧, 整数 事件) 返回 整数
{
    返回 旧 * 4 + 事件;
}

// 把处理函数存进第 号 格(号 0～15);这一格以后触发就用它,号不对不写。
方法 状态机_存槽(整数 号, 回调 状态机_存_处理(整数, 整数))
{
    如果 (号 == 0)
    {
        状态机_槽0 = 状态机_存_处理;
    }
    如果 (号 == 1)
    {
        状态机_槽1 = 状态机_存_处理;
    }
    如果 (号 == 2)
    {
        状态机_槽2 = 状态机_存_处理;
    }
    如果 (号 == 3)
    {
        状态机_槽3 = 状态机_存_处理;
    }
    如果 (号 == 4)
    {
        状态机_槽4 = 状态机_存_处理;
    }
    如果 (号 == 5)
    {
        状态机_槽5 = 状态机_存_处理;
    }
    如果 (号 == 6)
    {
        状态机_槽6 = 状态机_存_处理;
    }
    如果 (号 == 7)
    {
        状态机_槽7 = 状态机_存_处理;
    }
    如果 (号 == 8)
    {
        状态机_槽8 = 状态机_存_处理;
    }
    如果 (号 == 9)
    {
        状态机_槽9 = 状态机_存_处理;
    }
    如果 (号 == 10)
    {
        状态机_槽10 = 状态机_存_处理;
    }
    如果 (号 == 11)
    {
        状态机_槽11 = 状态机_存_处理;
    }
    如果 (号 == 12)
    {
        状态机_槽12 = 状态机_存_处理;
    }
    如果 (号 == 13)
    {
        状态机_槽13 = 状态机_存_处理;
    }
    如果 (号 == 14)
    {
        状态机_槽14 = 状态机_存_处理;
    }
    如果 (号 == 15)
    {
        状态机_槽15 = 状态机_存_处理;
    }
    返回
}

// 第 号 格(0～15)恢复成空处理:那一格回到“什么都不做”。
方法 状态机_清槽(整数 号)
{
    如果 (号 == 0)
    {
        状态机_槽0 = 地址(状态机_空);
    }
    如果 (号 == 1)
    {
        状态机_槽1 = 地址(状态机_空);
    }
    如果 (号 == 2)
    {
        状态机_槽2 = 地址(状态机_空);
    }
    如果 (号 == 3)
    {
        状态机_槽3 = 地址(状态机_空);
    }
    如果 (号 == 4)
    {
        状态机_槽4 = 地址(状态机_空);
    }
    如果 (号 == 5)
    {
        状态机_槽5 = 地址(状态机_空);
    }
    如果 (号 == 6)
    {
        状态机_槽6 = 地址(状态机_空);
    }
    如果 (号 == 7)
    {
        状态机_槽7 = 地址(状态机_空);
    }
    如果 (号 == 8)
    {
        状态机_槽8 = 地址(状态机_空);
    }
    如果 (号 == 9)
    {
        状态机_槽9 = 地址(状态机_空);
    }
    如果 (号 == 10)
    {
        状态机_槽10 = 地址(状态机_空);
    }
    如果 (号 == 11)
    {
        状态机_槽11 = 地址(状态机_空);
    }
    如果 (号 == 12)
    {
        状态机_槽12 = 地址(状态机_空);
    }
    如果 (号 == 13)
    {
        状态机_槽13 = 地址(状态机_空);
    }
    如果 (号 == 14)
    {
        状态机_槽14 = 地址(状态机_空);
    }
    如果 (号 == 15)
    {
        状态机_槽15 = 地址(状态机_空);
    }
    返回
}

// 调某格的处理:实参是"旧状态、新状态"
方法 状态机_调一格(整数 号, 整数 旧, 整数 新)
{
    如果 (号 == 0)
    {
        间接调用(状态机_槽0, 旧, 新);
    }
    如果 (号 == 1)
    {
        间接调用(状态机_槽1, 旧, 新);
    }
    如果 (号 == 2)
    {
        间接调用(状态机_槽2, 旧, 新);
    }
    如果 (号 == 3)
    {
        间接调用(状态机_槽3, 旧, 新);
    }
    如果 (号 == 4)
    {
        间接调用(状态机_槽4, 旧, 新);
    }
    如果 (号 == 5)
    {
        间接调用(状态机_槽5, 旧, 新);
    }
    如果 (号 == 6)
    {
        间接调用(状态机_槽6, 旧, 新);
    }
    如果 (号 == 7)
    {
        间接调用(状态机_槽7, 旧, 新);
    }
    如果 (号 == 8)
    {
        间接调用(状态机_槽8, 旧, 新);
    }
    如果 (号 == 9)
    {
        间接调用(状态机_槽9, 旧, 新);
    }
    如果 (号 == 10)
    {
        间接调用(状态机_槽10, 旧, 新);
    }
    如果 (号 == 11)
    {
        间接调用(状态机_槽11, 旧, 新);
    }
    如果 (号 == 12)
    {
        间接调用(状态机_槽12, 旧, 新);
    }
    如果 (号 == 13)
    {
        间接调用(状态机_槽13, 旧, 新);
    }
    如果 (号 == 14)
    {
        间接调用(状态机_槽14, 旧, 新);
    }
    如果 (号 == 15)
    {
        间接调用(状态机_槽15, 旧, 新);
    }
    返回
}

// ---- 对外 ----

// 几个状态(4)
方法 状态上限() 返回 整数
{
    返回 4;
}

// 几种事件(4)
方法 事件上限() 返回 整数
{
    返回 4;
}

// 清空转移表;两个数都在 1~4 内才给真
方法 建(整数 状态数, 整数 事件数) 返回 逻辑
{
    如果 (状态数 < 1 || 状态数 > 4 || 事件数 < 1 || 事件数 > 4)
    {
        返回 假;
    }
    清掉();
    返回 真;
}

// 设一条转移;下标越界给假
方法 设转移(整数 旧, 整数 事件, 整数 新, 回调 设_处理(整数, 整数)) 返回 逻辑
{
    如果 (旧 < 0 || 旧 > 3 || 事件 < 0 || 事件 > 3 || 新 < 0 || 新 > 3)
    {
        返回 假;
    }
    整数 号 = 状态机_号(旧, 事件);
    状态机_新[号] = 新;
    状态机_有[号] = 真;
    状态机_存槽(号, 设_处理);
    返回 真;
}

// 撤掉一条转移(那一格回到"什么都不做")
方法 清转移(整数 旧, 整数 事件) 返回 逻辑
{
    如果 (旧 < 0 || 旧 > 3 || 事件 < 0 || 事件 > 3)
    {
        返回 假;
    }
    整数 号 = 状态机_号(旧, 事件);
    状态机_有[号] = 假;
    状态机_新[号] = 0;
    状态机_清槽(号);
    返回 真;
}

// 那一格设过吗
方法 有转移(整数 旧, 整数 事件) 返回 逻辑
{
    如果 (旧 < 0 || 旧 > 3 || 事件 < 0 || 事件 > 3)
    {
        返回 假;
    }
    返回 状态机_有[状态机_号(旧, 事件)];
}

// 只看表:这一格会转到哪("原样" = 没有这条转移)
方法 目标(整数 旧, 整数 事件) 返回 整数
{
    如果 (旧 < 0 || 旧 > 3 || 事件 < 0 || 事件 > 3)
    {
        返回 旧;
    }
    整数 号 = 状态机_号(旧, 事件);
    如果 (状态机_有[号] == 假)
    {
        返回 旧;
    }
    返回 状态机_新[号];
}

// 喂一个事件;返回**喂完之后**的状态
方法 喂(整数 事件) 返回 整数
{
    如果 (事件 < 0 || 事件 > 3)
    {
        返回 状态机_当前;
    }
    整数 旧 = 状态机_当前;
    整数 号 = 状态机_号(旧, 事件);
    如果 (状态机_有[号])
    {
        整数 新 = 状态机_新[号];
        状态机_调一格(号, 旧, 新);
        状态机_当前 = 新;
    }
    返回 状态机_当前;
}

// 现在是哪个状态
方法 当前() 返回 整数
{
    返回 状态机_当前;
}

// 把当前状态设成这个(不触发任何处理函数)
方法 设初始(整数 状态) 返回 逻辑
{
    如果 (状态 < 0 || 状态 > 3)
    {
        返回 假;
    }
    状态机_当前 = 状态;
    返回 真;
}

// 转移表与当前状态一起复位
方法 清掉()
{
    整数 i = 0;
    当 (i < 16)
    {
        状态机_有[i] = 假;
        状态机_新[i] = 0;
        状态机_清槽(i);
        i = i + 1;
    }
    状态机_当前 = 0;
    返回
}
