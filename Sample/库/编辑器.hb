// ============================================================
// 编辑器.hb —— **文本编辑器内核**(纯 HB 库:不动 ISA、不动关键字、不动机器码)
//
// 用法:
// ```
// 包含 "../库/编辑器.hb";
//
// 编辑缓冲 编;
// 编辑器.建编辑器(编, 20);                 // 20 = 一屏画得下几行(可视行数 ⇒ 滚屏要它)
// 编辑器.插入文本(编, "第一行");
// 编辑器.编辑键(编, 编辑器.键回车());      // 拆行
// 编辑器.插入文本(编, "第二行");
// 编辑器.移动键(编, 编辑器.键上());        // 光标上移一行
// 输出行(编辑器.行文本(编, 编辑器.光标行(编)));
// ```
//
// 治的是**"一块文本 + 一个光标"这件事本身**:行怎么拆怎么并、光标按**一个字**走、
// 上下移动要记住"想去的列"、光标跑出可视区要滚屏 —— 全在这一库,与"画出来"无关
// (画是 `编辑器视图.hb` 的事,主循环是工程自己的事)。
//
// 口径(每条都对着实测写;探针 `工具\临时\` 下那份"串口径"):
//   · **一切都是"字",不是"字节"**:下标 `文本[i]` 取出来是**一个字**、`长度()` 数的是**字数**
//     (实测:`"A中B".长度()` = 3、`文本[1]` = 20013 = `中`)⇒ **光标与列号一律按字算**,
//     中文与 ASCII 在"第几列"这件事上**一样算一格**(占几格是"画"那一层的事:`取文字宽度`)。
//   · **行表是定长数组** `编辑器行[256]`,每格一条池串(堆里的块)⇒ **上限 256 行**,满了给假;
//     **行里的字没有上限**(一条串能多长就多长,受堆的约束)。
//   · **光标列是"想去的列"**:上下移动时记下当时的列,遇到短行贴在行尾;列没变(左右移动 /
//     编辑过)就重新按当前列算 —— 这是所有编辑器的老规矩(不然"过长行再回来"就丢列)。
//   · **`回车` 拆行 / 行首 `退格` 并回上一行**:并的时候光标停在**接缝**上(上一行原来的长度)。
//   · **`删除` 在行尾** = 把下一行并上来(`退格` 的镜像);**`制表` 键插 4 个空格**(不是 `\t`:
//     等宽口径下 `\t` 占几格由终端说了算,而这一库不许有"看环境才知道"的行为)。
//   · **滚屏**:光标**掉到可视区上边** ⇒ 首行跟着挪到光标那一行;掉到下边 ⇒ 先一行一行往下推,
//     推不动了(首行 + 可视行数 - 1 < 光标行)就把光标顶到**末可视行**。`可视行数` 给 0 或负数
//     按 1 算(不然除零 / 空视区).
//   · **不报错、不停机**:行号越界给空串、光标不动;插不进去(行满了)给假;删不动给假。
//
// 边界(如实登记,不写"绕法"):
//   · **256 行是上限**(定长数组)。要开大文件得改本库那一行 —— 或者等"行表分块"那一版
//     (与 `字符串数组长度上限 8192` 同一个道理:先给确定的上限,不假装无限)。
//   · **不做撤销 / 重做**(UNDO 要留整篇快照,1MB 内存下那是另一档活);
//   · **不做选区**(选区的两端、拖选、词选都要与"画"和鼠标联动 ⇒ 归 4-2 / 4-4 那一层);
//   · **`插入文本` 里的 `\n` 当拆行处理**(一次可以塞进多行文本 —— 粘贴就是这么用的);
//     `\r` 一律丢掉(Windows 换行粘进来不会多出一个怪字符)。
//
// 提供的函数(26 个):逐条的作用见每个函数紧上面那行注释。
//
// 英文对照:**没有英文别名**(与现有几个库同一口径:中英切换只管关键字与内建函数名)。
//
// 复杂度:插入 / 退格是 O(本行长度);上下移动 O(1);拆行 / 并行的代价在"抄一条串"(O(行长));
//   滚屏 O(1)(只挪一个整数)。空间:每行一条池串;模块级状态是定长数组,不进堆。
//
// 内存账:**每次改行会造 1~2 条新串**(池串的规矩:赋值给"堆串"字段是把内容拷进那一块)——
//   长跑编辑同一个文件时,老块由堆回收,不在这儿管。
//
// 依赖:`中文.hb`(只借 `UTF8编码一字` 一个函数 —— 插一个码点要把它编成那个字)。
// ============================================================

模块 编辑器

包含 "E:\Codes\CSharp\hehshihbeen-compiler\Sample\库\中文.hb"

// 一份编辑缓冲的全部状态:一个定长行表 + 光标 + 视口 + "改过没有"
// (定长数组是语言现状:结构里放数组要写死长度;上限写在 `编辑器_行上限` 那一处)
//
// ⚠ **类型名为什么要带模块前缀**(实测,别改回去):结构声明在 `模块 编辑器` 里面 ⇒ **对外的名字是
//   `编辑器.编辑缓冲`**,调用方写 `编辑器.编辑缓冲 编;` 才能用。写成裸 `编辑缓冲 编;` 时,编译器
//   可能**当它是一条指令**(报 `未知指令: 编辑缓冲`)—— 或者更坏:声明过得去、但一传给函数就报
//   `地址() 需要变量/字段/数组元素或函数名`。所以库里**不**另起一个裸名字,对外只认带前缀那一个。
结构 编辑缓冲
{
    字符串 行[256];    // 行表:每格一条池串(一条空串 = 空行)
    整数 行数;         // 现在有几行(至少 1)
    整数 光标行;       // 光标在第几行(0 起)
    整数 光标列;       // 光标在本行第几个字(0 起)
    整数 想去列;       // 上下移动"想去的列"(短行贴行尾,列不丢)
    整数 可视行数;     // 一屏画得下几行
    整数 可视首行;     // 可视区第一行是第几行(滚屏的落点)
    逻辑 改动过;       // 建好之后动过内容没有(存盘提示要用)
}

// 行表上限(定长数组;见头上"边界"那一条)
整数 编辑器_行上限 = 256;

// ---------------- 键码常量(编号沿用宿主那一套 `图形键C`) ----------------
// 为什么要在这儿再写一遍:`界面.hb` 只给了回车 / 退格 / 制表 / 空格 / 退出五个,
// 而编辑器要用的是**编辑键那一整族**(方向 / 首页 / 末页 / 翻页 / 删除)——
// 库不引库(引了就要用户把两份都包含进去),所以这一份编号在本库里自成一处。
// 改宿主编号时**两处一起看**(编号本身是对外接口,只加不改)。

// 回车:拆行(行尾就是"下一行";在行中间拆成两行)
方法 键回车() 返回 整数
{
    返回 13;
}
// 退格:删光标左边那个字(行首并回上一行)
方法 键退格() 返回 整数
{
    返回 8;
}
// 制表:插 4 个空格(等宽口径下不用 `\t`)
方法 键制表() 返回 整数
{
    返回 9;
}
// 删除:删光标右边那个字(行尾把下一行并上来)
方法 键删除() 返回 整数
{
    返回 46;
}
// 左:光标左移一个字(行首跳到上一行行尾)
方法 键左() 返回 整数
{
    返回 37;
}
// 上:光标上移一行(记着列)
方法 键上() 返回 整数
{
    返回 38;
}
// 右:光标右移一个字(行尾跳到下一行行首)
方法 键右() 返回 整数
{
    返回 39;
}
// 下:光标下移一行(记着列)
方法 键下() 返回 整数
{
    返回 40;
}
// 首页:光标到本行行首(再按一次到整篇开头 —— 与 `末页` 对称)
方法 键首页() 返回 整数
{
    返回 36;
}
// 末页:光标到本行行尾(再按一次到整篇末尾)
方法 键末页() 返回 整数
{
    返回 35;
}
// 上一页:光标上翻一屏
方法 键上一页() 返回 整数
{
    返回 33;
}
// 下一页:光标下翻一屏
方法 键下一页() 返回 整数
{
    返回 34;
}

// ---------------- 建 / 查 ----------------

// 建一个空编辑器(一条空行、光标在 0,0);`一屏行数` = 可视行数,给 0 或负数按 1 算
方法 建编辑器(编辑缓冲 编, 整数 一屏行数)
{
    整数 i = 0;
    当 (i < 编辑器_行上限)
    {
        编.行[i] = "";
        i = i + 1;
    }
    编.行数 = 1;
    编.光标行 = 0;
    编.光标列 = 0;
    编.想去列 = 0;
    编.可视行数 = 编辑器_一屏至少(一屏行数);
    编.可视首行 = 0;
    编.改动过 = 假;
    返回
}

// 现在有几行(空编辑器给 1 —— 永远至少有一条空行)
方法 行数(编辑缓冲 编) 返回 整数
{
    返回 编.行数;
}

// 光标在第几行(0 起)
方法 光标行(编辑缓冲 编) 返回 整数
{
    返回 编.光标行;
}

// 光标在本行第几个字(0 起;0 = 贴着行首)
方法 光标列(编辑缓冲 编) 返回 整数
{
    返回 编.光标列;
}

// 光标在本行占几**格**(ASCII 1 格 / 中文 2 格 —— 画光标方块要用它)
方法 光标格(编辑缓冲 编) 返回 整数
{
    字符串 前段 = 编辑器_左段(编辑器_行取(编, 编.光标行), 编.光标列);
    返回 取文字宽度(前段);
}

// 第 `行号` 行的原文("" = 没有这一行)
方法 行文本(编辑缓冲 编, 整数 行号) 返回 字符串
{
    返回 编辑器_行取(编, 行号);
}

// 第 `行号` 行占几格(画的时候用)
方法 行格数(编辑缓冲 编, 整数 行号) 返回 整数
{
    返回 取文字宽度(编辑器_行取(编, 行号));
}

// 整篇是不是一个字都没改过
方法 改动过(编辑缓冲 编) 返回 逻辑
{
    返回 编.改动过;
}

// 改过没有这个标记清掉(存盘之后调用方要清它)
方法 清改动(编辑缓冲 编)
{
    编.改动过 = 假;
    返回
}

// ---------------- 可视区 / 滚屏 ----------------

// 一屏画得下几行
方法 可视行数(编辑缓冲 编) 返回 整数
{
    返回 编.可视行数;
}

// 改一屏画得下几行(改了会重算滚屏:光标必须还在可视区里)
方法 设可视行数(编辑缓冲 编, 整数 行数)
{
    编.可视行数 = 编辑器_一屏至少(行数);
    编辑器_保证可见(编);
    返回
}

// 可视区第一行是第几行(画的时候从这一行起)
方法 可视首行(编辑缓冲 编) 返回 整数
{
    返回 编.可视首行;
}

// ---------------- 光标移动 ----------------

// 光标挪到第 `行号` 行第 `列号` 个字(越界一律夹进合法范围;会重算滚屏)
方法 设光标(编辑缓冲 编, 整数 行号, 整数 列号)
{
    编.光标行 = 编辑器_夹行(编, 行号);
    编.光标列 = 编辑器_夹列(编, 编.光标行, 列号);
    编.想去列 = 编.光标列;
    编辑器_保证可见(编);
    返回
}

// 按一个**移动键**挪光标(方向 / 首页 / 末页 / 翻页);不是移动键给假、光标不动
方法 移动键(编辑缓冲 编, 整数 键码) 返回 逻辑
{
    如果 (键码 == 37)
    {
        编辑器_左移(编);
        返回 真;
    }
    如果 (键码 == 39)
    {
        编辑器_右移(编);
        返回 真;
    }
    如果 (键码 == 38)
    {
        编辑器_上移(编);
        返回 真;
    }
    如果 (键码 == 40)
    {
        编辑器_下移(编);
        返回 真;
    }
    如果 (键码 == 36)
    {
        编辑器_首页(编);
        返回 真;
    }
    如果 (键码 == 35)
    {
        编辑器_末页(编);
        返回 真;
    }
    如果 (键码 == 33)
    {
        编辑器_翻页(编, 0 - 编.可视行数);
        返回 真;
    }
    如果 (键码 == 34)
    {
        编辑器_翻页(编, 编.可视行数);
        返回 真;
    }
    返回 假;
}

// ---------------- 编辑 ----------------

// 在光标处插一段文本(`\n` 拆行、`\r` 丢掉);行满了给假
//
// ⚠ **帧账(实测,别改回去)**:这一条原来是一整段"扫字面量 + 逐段插 + 拆行"的循环,局部一多,
//   帧就吃到 **96/96** —— 编译器当场报 `表达式太复杂(函数 '编辑器.插入文本' 的帧超出)`。
//   ⇒ 拆成三层:**本函数只做"最后那一段"**、逐行扫描归 `编辑器_插入一段`、拆行归 `插入新行`。
//   以后往里加局部变量之前先看帧(96 字节是上限,参数 + 局部 + 表达式临时槽共用那一块)。
方法 插入文本(编辑缓冲 编, 字符串 文本) 返回 逻辑
{
    如果 (编辑器_插一段(编, 文本, 0) == 假)
    {
        返回 假;
    }
    编.改动过 = 真;
    返回 真;
}

// 私有:从 `起` 那一个字起,把 `文本` 一段一段插进去,碰到换行就拆行;
// 返回真 = 全插完,假 = 中途行满了
方法 编辑器_插一段(编辑缓冲 编, 字符串 文本, 整数 起) 返回 逻辑
{
    字符串 左 = 编辑器_左段(编辑器_行取(编, 编.光标行), 编.光标列);
    整数 个数 = 文本.长度();
    整数 i = 起;
    整数 段起 = 起;
    当 (i < 个数)
     {
        如果 (文本[i] == 10)
         {
            如果 (编辑器_接一行(编, 左, 编辑器_段取(文本, 段起, i)) == 假)
            {
                返回 假;
            }
            左 = "";
            段起 = i + 1;
        }
        i = i + 1;
    }
    返回 编辑器_接尾(编, 左, 编辑器_段取(文本, 段起, 个数));
}

// 私有:把 `左 + 段` 换成光标那一行、再在下面开一条新行,光标落到新行行首(拆行那一步)
方法 编辑器_接一行(编辑缓冲 编, 字符串 左, 字符串 段) 返回 逻辑
{
    字符串 快照 = 编辑器_行取(编, 编.光标行);
    整数 位 = 编.光标列;
    字符串 合 = 编辑器_左段(左, 左.长度());
    拼接到(合, 段);
    如果 (编辑器_改行(编, 编.光标行, 合) == 假)
    {
        返回 假;
    }
    如果 (编辑器_插行(编, 编.光标行 + 1, 编辑器_右段(快照, 位)) == 假)
    {
        返回 假;
    }
    编.光标行 = 编.光标行 + 1;
    编.光标列 = 0;
    编.想去列 = 0;
    编辑器_保证可见(编);
    返回 真;
}

// 私有:把 `左 + 尾段` 接在光标右边那一半前面,光标落在接缝上(整段文本的最后一步)
方法 编辑器_接尾(编辑缓冲 编, 字符串 左, 字符串 尾段) 返回 逻辑
{
    字符串 快照 = 编辑器_行取(编, 编.光标行);
    整数 位 = 编.光标列;
    字符串 合 = 编辑器_左段(左, 左.长度());
    拼接到(合, 尾段);
    拼接到(合, 编辑器_右段(快照, 位));
    如果 (编辑器_改行(编, 编.光标行, 合) == 假)
    {
        返回 假;
    }
    编.光标列 = 左.长度() + 尾段.长度();
    编.想去列 = 编.光标列;
    编辑器_保证可见(编);
    返回 真;
}

// 在光标处插一个字的码点(键盘打进来的 ASCII 走这条);码点越界给假
方法 插入码点(编辑缓冲 编, 整数 码点) 返回 逻辑
{
    如果 (码点 < 32 || 码点 > 1114111)
    {
        返回 假;
    }
    字符串 一字 = 编辑器_字(码点);
    如果 (一字.长度() == 0)
    {
        返回 假;
    }
    返回 插入文本(编, 一字);
}

// 插一个新行(把本行从光标处拆开);行满了给假
方法 插入新行(编辑缓冲 编) 返回 逻辑
{
    字符串 行 = 编辑器_行取(编, 编.光标行);
    字符串 左 = 编辑器_左段(行, 编.光标列);
    字符串 右 = 编辑器_右段(行, 编.光标列);
    如果 (编辑器_改行(编, 编.光标行, 左) == 假)
    {
        返回 假;
    }
    如果 (编辑器_插行(编, 编.光标行 + 1, 右) == 假)
    {
        返回 假;
    }
    编.光标行 = 编.光标行 + 1;
    编.光标列 = 0;
    编.想去列 = 0;
    编.改动过 = 真;
    编辑器_保证可见(编);
    返回 真;
}

// 退格:删光标左边那个字;在行首把本行并回上一行(并到接缝上);没得删给假
方法 退格(编辑缓冲 编) 返回 逻辑
{
    字符串 行 = 编辑器_行取(编, 编.光标行);
    如果 (编.光标列 > 0)
     {
        字符串 左 = 编辑器_左段(行, 编.光标列 - 1);
        字符串 右 = 编辑器_右段(行, 编.光标列);
        字符串 合;
        拼接到(合, 左);
        拼接到(合, 右);
        如果 (编辑器_改行(编, 编.光标行, 合) == 假)
        {
            返回 假;
        }
        编.光标列 = 编.光标列 - 1;
        编.想去列 = 编.光标列;
        编.改动过 = 真;
        编辑器_保证可见(编);
        返回 真;
    }
    如果 (编.光标行 == 0)
     {
        返回 假;
    }
    返回 编辑器_并回上一行(编);
}

// 删除:删光标右边那个字;在行尾把下一行并上来;没得删给假
方法 删除(编辑缓冲 编) 返回 逻辑
{
    字符串 行 = 编辑器_行取(编, 编.光标行);
    如果 (编.光标列 < 行.长度())
     {
        字符串 左 = 编辑器_左段(行, 编.光标列);
        字符串 右 = 编辑器_右段(行, 编.光标列 + 1);
        字符串 合;
        拼接到(合, 左);
        拼接到(合, 右);
        如果 (编辑器_改行(编, 编.光标行, 合) == 假)
        {
            返回 假;
        }
        编.想去列 = 编.光标列;
        编.改动过 = 真;
        编辑器_保证可见(编);
        返回 真;
    }
    如果 (编.光标行 >= 编.行数 - 1)
     {
        返回 假;
    }
    字符串 下行 = 编辑器_行取(编, 编.光标行 + 1);
    字符串 合2;
    拼接到(合2, 行);
    拼接到(合2, 下行);
    如果 (编辑器_改行(编, 编.光标行, 合2) == 假)
     {
        返回 假;
    }
    编辑器_删行(编, 编.光标行 + 1);
    编.改动过 = 真;
    编辑器_保证可见(编);
    返回 真;
}

// 按一个**编辑键**(回车 / 退格 / 制表 / 删除);不是编辑键给假
方法 编辑键(编辑缓冲 编, 整数 键码) 返回 逻辑
{
    如果 (键码 == 13)
    {
        返回 插入新行(编);
    }
    如果 (键码 == 8)
    {
        返回 退格(编);
    }
    如果 (键码 == 46)
    {
        返回 删除(编);
    }
    如果 (键码 == 9)
    {
        返回 插入文本(编, "    ");
    }
    返回 假;
}

// 换行那一个字的串 —— 调用方自己拼多行文本时用它(语言里不写"裸字节字面量")
方法 换行符() 返回 字符串
{
    返回 编辑器_字(10);
}

// 整篇文本(每行之间补 `\n`;存盘 / 比较用)
方法 全部文本(编辑缓冲 编) 返回 字符串
{
    字符串 结果;
    整数 i = 0;
    当 (i < 编.行数)
     {
        如果 (i > 0)
        {
            拼接到(结果, 换行符());
        }
        拼接到(结果, 编辑器_行取(编, i));
        i = i + 1;
    }
    返回 结果;
}

// 把整篇文本灌进来(`\n` 拆行;先清空再灌);行太多给假、已经灌进去的那部分留着
方法 装入文本(编辑缓冲 编, 字符串 文本) 返回 逻辑
{
    建编辑器(编, 编.可视行数);
    返回 插入文本(编, 文本);
}

// ---------------- 私有:行表 ----------------

// 行号夹进 [0, 行数-1]
方法 编辑器_夹行(编辑缓冲 编, 整数 行号) 返回 整数
{
    如果 (行号 < 0)
     {
        返回 0;
     }
    如果 (行号 > 编.行数 - 1)
     {
        返回 编.行数 - 1;
     }
    返回 行号;
}

// 列号夹进 [0, 本行字数]
方法 编辑器_夹列(编辑缓冲 编, 整数 行号, 整数 列号) 返回 整数
{
    整数 长 = 编辑器_行取(编, 行号).长度();
    如果 (列号 < 0)
     {
        返回 0;
     }
    如果 (列号 > 长)
     {
        返回 长;
     }
    返回 列号;
}

// 一屏至少一行(0 / 负数按 1 算)
方法 编辑器_一屏至少(整数 行数) 返回 整数
{
    如果 (行数 < 1)
     {
        返回 1;
     }
    返回 行数;
}

// 取第 `行号` 行的原文(越界给空串)
方法 编辑器_行取(编辑缓冲 编, 整数 行号) 返回 字符串
{
    如果 (行号 < 0 || 行号 >= 编.行数)
    {
        返回 "";
    }
    返回 编.行[行号];
}

// 改写第 `行号` 行(越界给假);行内容**原样存下去**(调用方自己保证长度)
方法 编辑器_改行(编辑缓冲 编, 整数 行号, 字符串 文本) 返回 逻辑
{
    如果 (行号 < 0 || 行号 >= 编.行数)
    {
        返回 假;
    }
    编.行[行号] = 文本;
    返回 真;
}

// 在第 `行号` 行**前面**插一条(行满了给假;后面的行整体往下挪一格)
方法 编辑器_插行(编辑缓冲 编, 整数 行号, 字符串 文本) 返回 逻辑
{
    如果 (编.行数 >= 编辑器_行上限)
    {
        返回 假;
    }
    如果 (行号 < 0 || 行号 > 编.行数)
    {
        返回 假;
    }
    整数 i = 编.行数;
    当 (i > 行号)
    {
        编.行[i] = 编.行[i - 1];
        i = i - 1;
    }
    编.行[行号] = 文本;
    编.行数 = 编.行数 + 1;
    返回 真;
}

// 删掉第 `行号` 行(后面的行整体往上挪一格);行号越界什么也不做
方法 编辑器_删行(编辑缓冲 编, 整数 行号)
{
    如果 (行号 < 0 || 行号 >= 编.行数)
    {
        返回
    }
    整数 i = 行号;
    当 (i < 编.行数 - 1)
    {
        编.行[i] = 编.行[i + 1];
        i = i + 1;
    }
    编.行[编.行数 - 1] = "";
    编.行数 = 编.行数 - 1;
    返回
}

// 本行并回上一行(光标停在接缝上 = 上一行原来的长度)
方法 编辑器_并回上一行(编辑缓冲 编) 返回 逻辑
{
    字符串 上一行 = 编辑器_行取(编, 编.光标行 - 1);
    字符串 本行 = 编辑器_行取(编, 编.光标行);
    整数 缝 = 上一行.长度();
    字符串 合;
    拼接到(合, 上一行);
    拼接到(合, 本行);
    如果 (编辑器_改行(编, 编.光标行 - 1, 合) == 假)
    {
        返回 假;
    }
    编辑器_删行(编, 编.光标行);
    编.光标行 = 编.光标行 - 1;
    编.光标列 = 缝;
    编.想去列 = 缝;
    编.改动过 = 真;
    编辑器_保证可见(编);
    返回 真;
}

// ---------------- 私有:一段串的三种取法 ----------------

// 前 `几个字` 那一段(越界夹回来)
方法 编辑器_左段(字符串 文本, 整数 几个字) 返回 字符串
{
    返回 编辑器_段取(文本, 0, 几个字);
}

// 从第 `几个字` 起到末尾
方法 编辑器_右段(字符串 文本, 整数 几个字) 返回 字符串
{
    返回 编辑器_段取(文本, 几个字, 文本.长度());
}

// 第 `起` ~ 第 `止`(不含)那一截 —— **按字切,不按字节**(中文切一半这种事不会发生)
方法 编辑器_段取(字符串 文本, 整数 起, 整数 止) 返回 字符串
{
    字符串 结果;
    整数 总 = 文本.长度();
    如果 (起 < 0)
    {
        起 = 0;
    }
    如果 (止 > 总)
    {
        止 = 总;
    }
    整数 i = 起;
    当 (i < 止)
    {
        拼接到(结果, 文本[i]);
        i = i + 1;
    }
    返回 结果;
}

// 一个码点 → 它那个字(越界 / 代理区给空串;编码走 `中文.hb`,本库不重写一遍)
方法 编辑器_字(整数 码点) 返回 字符串
{
    如果 (码点 < 0 || 码点 > 1114111)
    {
        返回 "";
    }
    如果 (码点 >= 55296 && 码点 <= 57343)
    {
        返回 "";
    }
    返回 中文.UTF8编码一字(码点);
}

// 换行那一个字的串(`全部文本` 用;写成函数是为了不出现"裸字节字面量")
方法 编辑器_换行() 返回 字符串
{
    字符串 结果;
    拼接到(结果, 编辑器_字(10));
    返回 结果;
}

// ---------------- 私有:光标与滚屏 ----------------

// 左移一个字;已经在行首就跳到上一行行尾(整篇开头不动)
方法 编辑器_左移(编辑缓冲 编)
{
    如果 (编.光标列 > 0)
    {
        编.光标列 = 编.光标列 - 1;
        编.想去列 = 编.光标列;
        编辑器_保证可见(编);
        返回
    }
    如果 (编.光标行 > 0)
    {
        编.光标行 = 编.光标行 - 1;
        编.光标列 = 编辑器_行取(编, 编.光标行).长度();
        编.想去列 = 编.光标列;
        编辑器_保证可见(编);
    }
    返回
}

// 右移一个字;已经在行尾就跳到下一行行首(整篇末尾不动)
方法 编辑器_右移(编辑缓冲 编)
{
    字符串 行 = 编辑器_行取(编, 编.光标行);
    如果 (编.光标列 < 行.长度())
    {
        编.光标列 = 编.光标列 + 1;
        编.想去列 = 编.光标列;
        编辑器_保证可见(编);
        返回
    }
    如果 (编.光标行 < 编.行数 - 1)
    {
        编.光标行 = 编.光标行 + 1;
        编.光标列 = 0;
        编.想去列 = 0;
        编辑器_保证可见(编);
    }
    返回
}

// 上移一行:列按 `想去列` 算(短行贴在行尾)
方法 编辑器_上移(编辑缓冲 编)
{
    如果 (编.光标行 == 0)
    {
        返回
    }
    编.光标行 = 编.光标行 - 1;
    编.光标列 = 编辑器_夹列(编, 编.光标行, 编.想去列);
    编辑器_保证可见(编);
    返回
}

// 下移一行:列按 `想去列` 算(短行贴在行尾)
方法 编辑器_下移(编辑缓冲 编)
{
    如果 (编.光标行 >= 编.行数 - 1)
    {
        返回
    }
    编.光标行 = 编.光标行 + 1;
    编.光标列 = 编辑器_夹列(编, 编.光标行, 编.想去列);
    编辑器_保证可见(编);
    返回
}

// 首页:先到本行行首;已经在行首就到整篇开头
方法 编辑器_首页(编辑缓冲 编)
{
    如果 (编.光标列 > 0)
    {
        编.光标列 = 0;
        编.想去列 = 0;
        编辑器_保证可见(编);
        返回
    }
    编.光标行 = 0;
    编.光标列 = 0;
    编.想去列 = 0;
    编辑器_保证可见(编);
    返回
}

// 末页:先到本行行尾;已经在行尾就到整篇末尾
方法 编辑器_末页(编辑缓冲 编)
{
    字符串 行 = 编辑器_行取(编, 编.光标行);
    如果 (编.光标列 < 行.长度())
    {
        编.光标列 = 行.长度();
        编.想去列 = 编.光标列;
        编辑器_保证可见(编);
        返回
    }
    编.光标行 = 编.行数 - 1;
    编.光标列 = 编辑器_行取(编, 编.光标行).长度();
    编.想去列 = 编.光标列;
    编辑器_保证可见(编);
    返回
}

// 光标挪 `几行`(翻页用;上下夹在整篇范围内)
方法 编辑器_翻页(编辑缓冲 编, 整数 几行)
{
    编.光标行 = 编辑器_夹行(编, 编.光标行 + 几行);
    编.光标列 = 编辑器_夹列(编, 编.光标行, 编.想去列);
    编辑器_保证可见(编);
    返回
}

// 滚屏:光标必须落在 [可视首行, 可视首行 + 可视行数 - 1] 里
方法 编辑器_保证可见(编辑缓冲 编)
{
    如果 (编.光标行 < 编.可视首行)
    {
        编.可视首行 = 编.光标行;
        返回
    }
    整数 末行 = 编.可视首行 + 编.可视行数 - 1;
    如果 (编.光标行 > 末行)
    {
        编.可视首行 = 编.光标行 - 编.可视行数 + 1;
    }
    如果 (编.可视首行 > 编.行数 - 编.可视行数)
    {
        编.可视首行 = 编.行数 - 编.可视行数;
    }
    如果 (编.可视首行 < 0)
    {
        编.可视首行 = 0;
    }
    返回
}
