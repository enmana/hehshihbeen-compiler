// ============================================================
// 链表.hb —— 双向链表(堆上节点)库(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 用法:一份链表 = **一个句柄**(堆上一小块控制块):
// ```
// 包含 "../库/链表.hb";
// 整数 名单 = 链表.新建();
// 链表.后插(名单, 10);
// 链:整数 游标 = 链表.从头(名单);      // 拉模式:先要一个"游标"
// 整数 值 = 0;
// 当 (链表.下一项(游标, 值)) { 输出行(值); }
// 链表.销毁(名单);                      // 节点与控制块一起还回堆里
// ```
//
// ★ 内存账:**节点 12 字节**(`值 [+0]` · `前 [+4]` · `后 [+8]`)、**控制块 12 字节**(`头 [+0]` · `尾 [+4]` ·
//   `个数 [+8]`,就是 `新建()` 交出来的那个句柄)⇒ "尾插"不用走一遍、`个数` 也不用现数,都是 O(1)。
//   地址一律装着不放:`0` 就是"没有"(空链表 / 到头的下一个)。
//
// ★ 迭代器口径(**拉模式** = 调用方攥着一个游标,自己一句一句地要):`从头 / 从尾` 交出游标 →
//   `当 (下一项(游标, 值)) { … }` → 到头给 `假`。三条:① **游标是"下一个要读的那个节点"**(`下一项` 先把
//   当前节点的值写进 `收值`,**再把游标往前挪**);② **越过头就是 `0`**(立刻给 `假`,不再动 `收值`);
//   ③ **`当前(游标)` 只读一眼**(不推进)。这一库按**节点**走(链表本来就没有下标)。
//
// 口径(2026-10;每条都对着实测写):
//   · **一律 32 位有符号 `整数`**(值、句柄、游标、节点地址都是);
//   · **`新建()` 从堆里要块**(默认 64KB 堆 ⇒ 连控制块一起约 5460 个节点);**要不到会当场停下**;
//   · **`销毁` 与 `清掉` 的区别**:`销毁` = 节点 + 控制块**全还回**,句柄当场作废;`清掉` = 只把节点还回,
//     控制块留着(还能接着插);
//   · **`按值删` 删掉"所有"等于 `值` 的节点**,返回删了几个(与 `列表.删掉值` 一条口径);
//   · **越界 / 空表一律不报错**:`取第几个` 序号越界给 `假`(不动 `收值`)、`按值找` 没有给 **-1**、
//     `从头 / 从尾` 空表给 **0**(于是 `当 (下一项(…))` 一次都不进);
//   · **本库不做"环"**:一插一删都是单链,`下一项` 一定走得完;
//   · **不做排序 / 按下标查找**:要按值找有 `按值找`,要排序把值 `到数组` 出来交给 `排序.hb`。
//
// 提供的函数(16 个):新建 / 销毁 / 清掉 / 是空 / 个数 / 前插 / 后插 / 按值删 / 按值找 / 取第几个 / 到数组 +
//   拉模式六个(从头 / 从尾 / 下一项 / 上一项 / 当前);逐条见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:新建 O(1);销毁 / 清掉 O(节点数)(一个一个还);是空 / 个数 / 前插 / 后插 / 从头 / 从尾 / 当前 /
//   下一项 / 上一项 O(1);按值删 / 按值找 / 取第几个 / 到数组 O(节点数)。
//
// 边界(如实登记):
//   · **句柄与游标都是"堆地址"**:`销毁` 之后再用那个句柄会**被当场拦住**(语言的堆会认出来);
//   · **节点不自动回收**:语言没有 GC ⇒ 用完了自己 `销毁` / `清掉`;
//   · **`按值删` 是"全删"**(与 `列表.删掉值` 一致):要"只删第一个"就 `按值找` 拿到序号再自己走;
//   · **不做"环 / 跳表 / 有序插入"**:这一库就是最朴素的双向链表。
// ============================================================
模块 链表

// 控制块三格:头 / 尾 / 个数
// 节点三格:值 / 前 / 后(前 = 0 就是头,后 = 0 就是尾)

// ---------- 私有:要一个节点(值 / 前 / 后 都写好) ----------
私有 方法 链表造节点(整数 值, 整数 前, 整数 后) 返回 整数
{
    整数 节点 = 申请(12);
    存字(节点, 0, 值);
    存字(节点, 4, 前);
    存字(节点, 8, 后);
    返回 节点;
}

// ============================================================
// 1、建与收拾
// ============================================================

// 从堆里要一小块当"链表的家"(头 / 尾 / 个数);要不到会当场停下
方法 新建() 返回 整数
{
    整数 表 = 申请(12);
    存字(表, 0, 0);
    存字(表, 4, 0);
    存字(表, 8, 0);
    返回 表;
}

// 节点与控制块**全还回堆里**(句柄当场作废)
方法 销毁(整数 表)
{
    清掉(表);
    释放(表);
}

// 只还节点(控制块留着,还能接着插)
方法 清掉(整数 表)
{
    整数 走 = 取字(表, 0);
    当 (走 != 0)
    {
        整数 下一个 = 取字(走, 8);
        释放(走);
        走 = 下一个;
    }
    存字(表, 0, 0);
    存字(表, 4, 0);
    存字(表, 8, 0);
}

// ============================================================
// 2、问
// ============================================================

// 一个节点都没有
方法 是空(整数 表) 返回 逻辑
{
    返回 取字(表, 8) == 0;
}

// 控制块里记着的那个数(O(1))
方法 个数(整数 表) 返回 整数
{
    返回 取字(表, 8);
}

// ============================================================
// 3、插与删
// ============================================================

// 插在头一个之前(新节点成为新的头)
方法 前插(整数 表, 整数 值) 返回 逻辑
{
    整数 老头 = 取字(表, 0);
    整数 新 = 链表造节点(值, 0, 老头);
    如果 (老头 != 0)
    {
        存字(老头, 4, 新);
    }
    否则
    {
        存字(表, 4, 新);                  // 本来是空表:尾也是它
    }
    存字(表, 0, 新);
    存字(表, 8, 取字(表, 8) + 1);
    返回 真;
}

// 插在最后一个之后(新节点成为新的尾)
方法 后插(整数 表, 整数 值) 返回 逻辑
{
    整数 老尾 = 取字(表, 4);
    整数 新 = 链表造节点(值, 老尾, 0);
    如果 (老尾 != 0)
    {
        存字(老尾, 8, 新);
    }
    否则
    {
        存字(表, 0, 新);                  // 本来是空表:头也是它
    }
    存字(表, 4, 新);
    存字(表, 8, 取字(表, 8) + 1);
    返回 真;
}

// 删掉**所有**等于 `值` 的;返回删了几个
方法 按值删(整数 表, 整数 值) 返回 整数
{
    整数 删了 = 0;
    整数 走 = 取字(表, 0);
    当 (走 != 0)
    {
        整数 下一个 = 取字(走, 8);        // 先记下:马上要把 `走` 还回堆里
        如果 (取字(走, 0) == 值)
        {
            整数 前 = 取字(走, 4);
            如果 (前 != 0)
            {
                存字(前, 8, 下一个);
            }
            否则
            {
                存字(表, 0, 下一个);
            }
            如果 (下一个 != 0)
            {
                存字(下一个, 4, 前);
            }
            否则
            {
                存字(表, 4, 前);
            }
            释放(走);
            存字(表, 8, 取字(表, 8) - 1);
            删了 = 删了 + 1;
        }
        走 = 下一个;
    }
    返回 删了;
}

// ============================================================
// 4、按序号取(链表没有下标,只能一步一步走)
// ============================================================

// 第一个等于 `值` 的**序号**(0 起);没有给 -1
方法 按值找(整数 表, 整数 值) 返回 整数
{
    整数 走 = 取字(表, 0);
    整数 序号 = 0;
    当 (走 != 0)
    {
        如果 (取字(走, 0) == 值)
        {
            返回 序号;
        }
        走 = 取字(走, 8);
        序号 = 序号 + 1;
    }
    返回 -1;
}

// 第 `序号` 个的值(0 起);越界给 假
方法 取第几个(整数 表, 整数 序号, 引用 整数 收值) 返回 逻辑
{
    整数 用了 = 取字(表, 8);
    如果 (序号 < 0 || 序号 >= 用了)
    {
        返回 假;
    }
    整数 走 = 取字(表, 0);
    整数 i = 0;
    当 (i < 序号)
    {
        走 = 取字(走, 8);
        i = i + 1;
    }
    收值 = 取字(走, 0);
    返回 真;
}

// 从前往后铺进 `出去`;返回铺了几个
方法 到数组(整数 表, 整数 出去[]) 返回 整数
{
    整数 走 = 取字(表, 0);
    整数 铺 = 0;
    当 (走 != 0 && 铺 < 出去.长度())
    {
        出去[铺] = 取字(走, 0);
        铺 = 铺 + 1;
        走 = 取字(走, 8);
    }
    返回 铺;
}

// ============================================================
// 5、迭代器(拉模式:调用方攥着游标,自己一句一句地要)
// ============================================================

// 拉模式游标 = 第一个节点;空表给 0
方法 从头(整数 表) 返回 整数
{
    返回 取字(表, 0);
}

// 拉模式游标 = 最后一个节点(配合 `上一项` 倒着走)
方法 从尾(整数 表) 返回 整数
{
    返回 取字(表, 4);
}

// 读当前、游标往前挪;到头给 假
方法 下一项(引用 整数 游标, 引用 整数 收值) 返回 逻辑
{
    如果 (游标 == 0)
    {
        返回 假;
    }
    收值 = 取字(游标, 0);
    游标 = 取字(游标, 8);
    返回 真;
}

// 倒着走那一半(配合 `从尾`)
方法 上一项(引用 整数 游标, 引用 整数 收值) 返回 逻辑
{
    如果 (游标 == 0)
    {
        返回 假;
    }
    收值 = 取字(游标, 0);
    游标 = 取字(游标, 4);
    返回 真;
}

// 只看一眼游标那个节点的值(不动游标);游标是 0 给 0
方法 当前(整数 游标) 返回 整数
{
    如果 (游标 == 0)
    {
        返回 0;
    }
    返回 取字(游标, 0);
}
