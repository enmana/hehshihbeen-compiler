// ============================================================
// 散列.hb —— SHA-1 安全散列(纯 HB,零依赖)
//
// 用法:
// ```
// 包含 "../库/散列.hb";
// 字符串 指纹 = 散列.摘要串十六进制("abc");
// ```
//
// 要算一段数据的 SHA-1 指纹时用。当下最要紧的用途是 **WebSocket 握手**:服务端要求 `Sec-WebSocket-Accept = Base64(SHA1(客户端随机键 + 固定魔术串))`,而 `编码.hb` 已经有 Base64,缺的就是这里的 SHA1。
//
// 口径(2026-10;每条都对着实测写):
//   · 标准 SHA-1(FIPS 180-4):512 位分组、80 轮、大端;输出 20 字节(160 位);
//   · **全程按 32 位无符号算** —— 这是本库最要紧的一条:语言的 `取字` 给的是
//     **有符号**值(`存字(块,0,0x80000000)` 之后 `取字` 读回来是 -2147483648),
//     所以库内每个中间量都声明成 `无符号整数`,左旋与加法才按 32 位回绕;
//   · **零依赖**:十六进制自己编,不 `包含 编码.hb`;
//   · **不报错、不停机**:入参不合理(负字节数 / 空地址)一律给 `假`,不写目标一个字节。
//
// ⚠ 排程表 / 状态 / 尾块三块住在全局(共 372 字节静态区)—— 因为语言的帧上限是 96 字节,写成本地数组会当场报帧超出。两处代价如实登记:**不可重入**(同一条调用链里不能嵌套算第二份摘要);**全局数组不能当 `地址` 传**。
//   ⚠ 两处代价如实登记:
//     ① **不可重入** —— 同一条调用链里不能嵌套算第二份摘要(语言单线程,正常用法不撞);
//     ② **全局数组不能当 `地址` 传**(编译器会说"数组必须带下标使用")⇒
//        尾巴那一支只能逐字节读写 `散列尾块`,不能复用"从地址读"的那条路。
//
// 提供的函数(6 个):逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:摘要 digest · 摘要十六进制 digestHex · 摘要字节数 digestSize
//
// 复杂度:O(字节数);空间 O(1)(三块全局草稿;`摘要串` 会申请一块 UTF-8 字节区,用完就释放)。
//
// 边界(如实登记):
//   · **不可重入**(见上);**全局数组不能取地址**(见上);
//   · `字节数` 为负、或 `数据` 为 0,给 `假` 且不写目标;
//   · `出` 那个块**不自己查容量**:调用方保证 >= 20 字节(给不够由语言的堆检查兜);
//   · `摘要串` 按**文字(码点)逐字 UTF-8 编字节**,与 `编码.hb` 的串那一半同一口径
//     (一个汉字 3 个字节);
//   · 只做**一次性摘要**(整段数据一次给全),没有增量/分片接口 —— 1MB 内存的定位下用不着。
// ============================================================
模块 散列

// ---------- 全局草稿区(帧放不下,见文件头) ----------
无符号整数 散列排程[80];
无符号整数 散列状态[5];
字节 散列尾块[128];

// ---------- 私有:32 位左旋 ----------
私有 方法 散列左旋(无符号整数 值, 整数 位数) 返回 无符号整数
{
    如果 (位数 == 0)
    {
        返回 值;
    }
    返回 (值 << 位数) | (值 >> (32 - 位数));
}

// ---------- 私有:从块里读第 `位置` 个字节 ----------
私有 方法 散列读字节(地址 块, 整数 位置) 返回 无符号整数
{
    整数 字起 = 位置 - 位置 % 4;
    整数 移位量 = (位置 % 4) * 8;
    返回 (取字(块, 字起) >> 移位量) & 255;
}

// ---------- 私有:往块里写第 `位置` 个字节 ----------
私有 方法 散列写字节(地址 块, 整数 位置, 整数 值)
{
    整数 字起 = 位置 - 位置 % 4;
    整数 移位量 = (位置 % 4) * 8;
    整数 整字 = 取字(块, 字起) & (~(255 << 移位量));
    整字 = 整字 | ((值 & 255) << 移位量);
    存字(块, 字起, 整字);
    返回
}

// ---------- 私有:读一个 4 字节大端字 ----------
私有 方法 散列读大端(地址 块, 整数 位置) 返回 无符号整数
{
    无符号整数 b0 = 散列读字节(块, 位置);
    无符号整数 b1 = 散列读字节(块, 位置 + 1);
    无符号整数 b2 = 散列读字节(块, 位置 + 2);
    无符号整数 b3 = 散列读字节(块, 位置 + 3);
    返回 (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

// ---------- 私有:写一个 4 字节大端字 ----------
// 每个字节都用语言内建的 `取字节(值, 第几段)`(一条指令);以前是 `(值 >> k) & 255` 两条。
私有 方法 散列写大端(地址 块, 整数 位置, 无符号整数 值)
{
    散列写字节(块, 位置, 取字节(值, 3));
    散列写字节(块, 位置 + 1, 取字节(值, 2));
    散列写字节(块, 位置 + 2, 取字节(值, 1));
    散列写字节(块, 位置 + 3, 取字节(值, 0));
    返回
}

// ---------- 私有:状态置 SHA-1 初值 ----------
私有 方法 散列置初值()
{
    散列状态[0] = 0x67452301;
    散列状态[1] = 0xEFCDAB89;
    散列状态[2] = 0x98BADCFE;
    散列状态[3] = 0x10325476;
    散列状态[4] = 0xC3D2E1F0;
    返回
}

// ---------- 私有:排程[0..15] 已摆好 ⇒ 扩展到 80 并跑 80 轮 ----------
// (`散列压分组` 与 `散列压尾巴块` 共用这一段,免得两份 80 轮各写一遍)
私有 方法 散列扩展并压缩()
{
    整数 i = 16;
    当 (i < 80)
    {
        散列排程[i] = 散列左旋(散列排程[i - 3] ^ 散列排程[i - 8] ^ 散列排程[i - 14] ^ 散列排程[i - 16], 1);
        i = i + 1;
    }

    无符号整数 a = 散列状态[0];
    无符号整数 b = 散列状态[1];
    无符号整数 c = 散列状态[2];
    无符号整数 d = 散列状态[3];
    无符号整数 e = 散列状态[4];
    无符号整数 f = 0;
    无符号整数 k = 0;
    无符号整数 临时 = 0;
    整数 j = 0;

    当 (j < 80)
    {
        如果 (j < 20)
        {
            f = (b & c) | ((~b) & d);
            k = 0x5A827999;
        }
        否则 如果 (j < 40)
        {
            f = b ^ c ^ d;
            k = 0x6ED9EBA1;
        }
        否则 如果 (j < 60)
        {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8F1BBCDC;
        }
        否则
        {
            f = b ^ c ^ d;
            k = 0xCA62C1D6;
        }

        临时 = 散列左旋(a, 5) + f + e + k + 散列排程[j];
        e = d;
        d = c;
        c = 散列左旋(b, 30);
        b = a;
        a = 临时;
        j = j + 1;
    }

    散列状态[0] = 散列状态[0] + a;
    散列状态[1] = 散列状态[1] + b;
    散列状态[2] = 散列状态[2] + c;
    散列状态[3] = 散列状态[3] + d;
    散列状态[4] = 散列状态[4] + e;
    返回
}

// ---------- 私有:从地址压一个整分组 ----------
私有 方法 散列压分组(地址 数据, 整数 起)
{
    整数 i = 0;
    当 (i < 16)
    {
        散列排程[i] = 散列读大端(数据, 起 + i * 4);
        i = i + 1;
    }
    散列扩展并压缩();
    返回
}

// ---------- 私有:从 `散列尾块` 压第 `起` 字节起的 64 字节 ----------
// 全局数组不能当 `地址` 传,所以这一支只能逐字节读
私有 方法 散列压尾巴块(整数 起)
{
    整数 i = 0;
    当 (i < 16)
    {
        无符号整数 b0 = 散列尾块[起 + i * 4];
        无符号整数 b1 = 散列尾块[起 + i * 4 + 1];
        无符号整数 b2 = 散列尾块[起 + i * 4 + 2];
        无符号整数 b3 = 散列尾块[起 + i * 4 + 3];
        散列排程[i] = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
        i = i + 1;
    }
    散列扩展并压缩();
    返回
}

// ---------- 私有:补位 + 位长,压完最后 1~2 个分组 ----------
// 余数 0~63 ⇒ 补一个 0x80 + 若干 0 + 8 字节位长,总长 9~72 ⇒ 64 或 128
私有 方法 散列压尾巴(地址 数据, 整数 起, 整数 余数, 整数 总字节数)
{
    整数 i = 0;
    当 (i < 128)
    {
        散列尾块[i] = 0;
        i = i + 1;
    }

    i = 0;
    当 (i < 余数)
    {
        散列尾块[i] = 散列读字节(数据, 起 + i);
        i = i + 1;
    }
    散列尾块[余数] = 0x80;

    整数 尾长 = 64;
    如果 (余数 >= 56)
    {
        尾长 = 128;
    }

    无符号整数 位长低 = 总字节数 * 8;
    无符号整数 位长高 = 总字节数 / 536870912;

    散列尾块[尾长 - 8] = (位长高 >> 24) & 255;
    散列尾块[尾长 - 7] = (位长高 >> 16) & 255;
    散列尾块[尾长 - 6] = (位长高 >> 8) & 255;
    散列尾块[尾长 - 5] = 位长高 & 255;
    散列尾块[尾长 - 4] = (位长低 >> 24) & 255;
    散列尾块[尾长 - 3] = (位长低 >> 16) & 255;
    散列尾块[尾长 - 2] = (位长低 >> 8) & 255;
    散列尾块[尾长 - 1] = 位长低 & 255;

    散列压尾巴块(0);
    如果 (尾长 == 128)
    {
        散列压尾巴块(64);
    }
    返回
}

// ---------- 私有:0~15 → 一个大写十六进制字符 ----------
私有 方法 散列十六进制位(整数 值) 返回 字符
{
    字符 出位 = 48 + 值;
    如果 (值 >= 10)
    {
        出位 = 65 + (值 - 10);
    }
    返回 出位;
}

// ============================================================
// 公开接口
// ============================================================

// SHA-1 摘要的字节数(定长 20,不是十六进制字符数)
方法 摘要字节数() 返回 整数
{
    返回 20;
}

// 一个十六进制字符的值;不是十六进制位给 -1
方法 十六进制值(文字 某字) 返回 整数
{
    如果 (某字 >= '0' && 某字 <= '9')
    {
        返回 某字 - '0';
    }
    如果 (某字 >= 'a' && 某字 <= 'f')
    {
        返回 某字 - 'a' + 10;
    }
    如果 (某字 >= 'A' && 某字 <= 'F')
    {
        返回 某字 - 'A' + 10;
    }
    返回 -1;
}

// 算一段数据的 SHA-1,20 字节写进出块;地址 0 或字节数为负给假
方法 摘要(地址 数据, 整数 字节数, 地址 出块) 返回 逻辑
{
    如果 (数据 == 0 || 出块 == 0 || 字节数 < 0)
    {
        返回 假;
    }

    散列置初值();

    整数 完整组数 = 字节数 / 64;
    整数 余数 = 字节数 - 完整组数 * 64;
    整数 i = 0;

    当 (i < 完整组数)
    {
        散列压分组(数据, i * 64);
        i = i + 1;
    }

    散列压尾巴(数据, 完整组数 * 64, 余数, 字节数);

    i = 0;
    当 (i < 5)
    {
        散列写大端(出块, i * 4, 散列状态[i]);
        i = i + 1;
    }
    返回 真;
}

// 算一段数据的 SHA-1,给 40 个字符的大写十六进制;参数不合法或内存不够给空串
方法 摘要十六进制(地址 数据, 整数 字节数) 返回 字符串
{
    字符串 结果 = "";
    如果 (数据 == 0 || 字节数 < 0)
    {
        返回 结果;
    }

    地址 摘要块 = 申请(20);
    如果 (摘要块 == 0)
    {
        返回 结果;
    }
    如果 (摘要(数据, 字节数, 摘要块))
    {
        整数 i = 0;
        当 (i < 20)
        {
            整数 一个字节 = 散列读字节(摘要块, i);
            字符 高位 = 散列十六进制位(一个字节 >> 4);
            字符 低位 = 散列十六进制位(一个字节 & 15);
            拼接到(结果, 高位);
            拼接到(结果, 低位);
            i = i + 1;
        }
    }
    释放(摘要块);
    返回 结果;
}

// 文本按 UTF-8 逐字编字节再算 SHA-1,十六进制写出参;够 40 字符给真
方法 摘要串(字符串 文本, 字符串 出 十六进制) 返回 逻辑
{
    十六进制 = "";
    整数 个数 = 文本.长度();

    // 第一遍:量出 UTF-8 要几个字节
    整数 需要 = 0;
    整数 i = 0;
    当 (i < 个数)
    {
        整数 码 = 文本[i];
        如果 (码 < 128)
        {
            需要 = 需要 + 1;
        }
        否则 如果 (码 < 2048)
        {
            需要 = 需要 + 2;
        }
        否则 如果 (码 < 65536)
        {
            需要 = 需要 + 3;
        }
        否则
        {
            需要 = 需要 + 4;
        }
        i = i + 1;
    }

    // 补到 4 的整数倍:`取字` 按整字查边界,不补齐最后那个字会越出块
    需要 = 需要 + (4 - 需要 % 4) % 4;
    如果 (需要 == 0)
    {
        需要 = 4;
    }

    地址 字节区 = 申请(需要);
    如果 (字节区 == 0)
    {
        返回 假;
    }

    整数 真长度 = 0;
    i = 0;
    当 (i < 个数)
    {
        整数 码 = 文本[i];
        如果 (码 < 128)
        {
            散列写字节(字节区, 真长度, 码);
            真长度 = 真长度 + 1;
        }
        否则 如果 (码 < 2048)
        {
            散列写字节(字节区, 真长度, 192 | (码 >> 6));
            散列写字节(字节区, 真长度 + 1, 128 | (码 & 63));
            真长度 = 真长度 + 2;
        }
        否则 如果 (码 < 65536)
        {
            散列写字节(字节区, 真长度, 224 | (码 >> 12));
            散列写字节(字节区, 真长度 + 1, 128 | ((码 >> 6) & 63));
            散列写字节(字节区, 真长度 + 2, 128 | (码 & 63));
            真长度 = 真长度 + 3;
        }
        否则
        {
            散列写字节(字节区, 真长度, 240 | (码 >> 18));
            散列写字节(字节区, 真长度 + 1, 128 | ((码 >> 12) & 63));
            散列写字节(字节区, 真长度 + 2, 128 | ((码 >> 6) & 63));
            散列写字节(字节区, 真长度 + 3, 128 | (码 & 63));
            真长度 = 真长度 + 4;
        }
        i = i + 1;
    }

    // 结果先接进一个局部变量再写出参(本库统一写法:出参只接"已经在手上的串")
    字符串 本地 = 摘要十六进制(字节区, 真长度);
    十六进制 = 本地;
    释放(字节区);
    返回 十六进制.长度() == 40;
}

// 文本按 UTF-8 逐字编字节,给 40 字符大写十六进制;编不出来给空串
方法 摘要串十六进制(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    摘要串(文本, 结果);
    返回 结果;
}
