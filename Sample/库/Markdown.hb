}

// 私有:把 [起, 止) 这一段按字节接进缓冲
私有 方法 Markdown写区(整数 起, 整数 止)
{
    整数 i = 起;
    当 (i < 止)
    {
        字符 本字节 = Markdown字节区[i];
        拼接到(Markdown缓冲, 本字节);
        i = i + 1;
    }
    返回
}

// 私有:把一整行按 `|` 切成格(起 / 止 两表;空行给 0 格)
私有 方法 Markdown切格(字符串 文本)
{
    Markdown表格数 = 0;
    整数 长 = 文本.长度();
    整数 i = 0;
    当 (i < 长 && Markdown表格数 < 32)
    {
        整数 起 = i;
        整数 止 = i;
        当 (止 < 长 && 文本[止] != '|')
        {
            止 = 止 + 1;
        }
        Markdown表格起[Markdown表格数] = 起;
        Markdown表格止[Markdown表格数] = 止;
        Markdown表格数 = Markdown表格数 + 1;
        如果 (止 < 长)
        {
            止 = 止 + 1;
        }
        i = 止;
    }
    返回
}

// 私有:把一整行 `张三|李四|王五` 写成 `| 张三 | 李四 | 王五 |`,并把格数记进 `Markdown表格数`
私有 方法 Markdown写表行(字符串 文本) 返回 逻辑
{
    Markdown切格(文本);
    如果 (Markdown表格数 == 0)
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < Markdown表格数)
    {
        拼接到(Markdown缓冲, "| ");
        Markdown写格文本(Markdown切一段(文本, Markdown表格起[i], Markdown表格止[i]));
        拼接到(Markdown缓冲, ' ');
        i = i + 1;
    }
    拼接到(Markdown缓冲, '|');
    拼接到(Markdown缓冲, "\n");
    返回 真;
}

// 表格:第一行当列头,一行一条(`\n` 分行、`|` 分格);写一个表头分隔行
方法 表格(字符串 列头表, 字符串 行表) 返回 逻辑
{
    Markdown补换行();
    逻辑 丢一 = Markdown写表行(列头表);
    如果 (Markdown表格数 == 0)
    {
        返回 假;
    }
    整数 列数 = Markdown表格数;
    拼接到(Markdown缓冲, '|');
    整数 i = 0;
    当 (i < 列数)
    {
        拼接到(Markdown缓冲, " --- |");
        i = i + 1;
    }
    拼接到(Markdown缓冲, "\n");
    整数 起 = 0;
    整数 长 = 行表.长度();
    当 (起 <= 长)
    {
        整数 止 = Markdown下个换行(行表, 起, 长);
        如果 (止 > 起)
        {
            逻辑 丢二 = Markdown收表行(行表, 起, 止);
        }
        如果 (止 >= 长)
        {
            跳出;
        }
        起 = 止 + 1;
    }
    Markdown补换行();
    返回 真;
}

// 私有:把 `文本` 的 [起, 止) 这一段按表行的规矩收下(切格 → 一格一格写)
私有 方法 Markdown收表行(字符串 文本, 整数 起, 整数 止) 返回 逻辑
{
    Markdown表格数 = 0;
    整数 i = 起;
    整数 本起 = 起;
    当 (i < 止)
    {
        如果 (文本[i] == '|')
        {
            如果 (Markdown表格数 < 32)
            {
                Markdown表格起[Markdown表格数] = 本起;
                Markdown表格止[Markdown表格数] = i;
                Markdown表格数 = Markdown表格数 + 1;
            }
            本起 = i + 1;
        }
        i = i + 1;
    }
    如果 (Markdown表格数 < 32)
    {
        Markdown表格起[Markdown表格数] = 本起;
        Markdown表格止[Markdown表格数] = 止;
        Markdown表格数 = Markdown表格数 + 1;
    }
    如果 (Markdown表格数 == 0)
    {
        返回 假;
    }
    整数 k = 0;
    当 (k < Markdown表格数)
    {
        拼接到(Markdown缓冲, "| ");
        Markdown写格文本(Markdown切一段(文本, Markdown表格起[k], Markdown表格止[k]));
        拼接到(Markdown缓冲, ' ');
        k = k + 1;
    }
    拼接到(Markdown缓冲, '|');
    拼接到(Markdown缓冲, "\n");
    返回 真;
}

// 取结果:把攒好的整份 `.md` 写进你那一格
方法 取结果(字符串 出 文) 返回 逻辑
{
    Markdown交串(Markdown缓冲, 文);
    返回 真;
}

// ============================================================
// 3、读:解析成"块 + 行内"两层(文本收进字节区,节点只记起 / 长)
// ============================================================

// 清空:八份文档一起放掉(字节区归零)
方法 清空()
{
    Markdown文档轮 = 0;
    Markdown文档用 = 0;
    Markdown块数表 = 0;
    Markdown内数表 = 0;
    Markdown行数表 = 0;
    Markdown错处 = 0;
    Markdown字节用 = 0;
    Markdown档起 = 0;
    返回
}

// 错处位置:上一次 `解析` 停在第几个字节(成功给 0)
方法 错处位置() 返回 整数
{
    返回 Markdown错处;
}

// 私有:文档号合不合法
私有 方法 Markdown档在(整数 文档) 返回 逻辑
{
    如果 (文档 >= 1 && 文档 <= 8)
    {
        返回 真;
    }
    返回 假;
}

// 私有:一段字节里第 `位` 个字节是不是空白(空格 / 制表)
私有 方法 Markdown是空白(整数 位) 返回 逻辑
{
    整数 值 = Markdown字节区[位];
    如果 (值 == 32 || 值 == 9)
    {
        返回 真;
    }
    返回 假;
}

// 私有:把块表里第 `块` 块的收尾定下来(末尾空白去掉)
私有 方法 Markdown收块(整数 块, 整数 类值, 整数 始, 整数 到)
{
    Markdown块类[块] = 类值;
    Markdown块起[块] = 始;
    Markdown块止[块] = 到;
    当 (Markdown块止[块] > Markdown块起[块] && Markdown是空白(Markdown块止[块] - 1) == 真)
    {
        Markdown块止[块] = Markdown块止[块] - 1;
    }
    返回
}

// 私有:这一行是不是分隔线(`---` / `***` / `___`,中间可以有空格;至少三个)
私有 方法 Markdown是横线(整数 始, 整数 止) 返回 逻辑
{
    整数 i = 始;
    整数 数 = 0;
    整数 记号 = 0;
    当 (i < 止)
    {
        整数 值 = Markdown字节区[i];
        如果 (值 == 32 || 值 == 9)
        {
            i = i + 1;
            继续;
        }
        如果 (记号 == 0)
        {
            如果 (值 != 45 && 值 != 42 && 值 != 95)
            {
                返回 假;
            }
            记号 = 值;
        }
        如果 (值 != 记号)
        {
            返回 假;
        }
        数 = 数 + 1;
        i = i + 1;
    }
    如果 (数 >= 3)
    {
        返回 真;
    }
    返回 假;
}

// 私有:围栏那一串反引号有几个(不是围栏给 0)
私有 方法 Markdown围栏数(整数 起, 整数 到) 返回 整数
{
    整数 数 = 0;
    整数 i = 起;
    当 (i < 到 && Markdown字节区[i] == 96)
    {
        数 = 数 + 1;
        i = i + 1;
    }
    如果 (数 < 3)
    {
        返回 0;
    }
    返回 数;
}

// 私有:这一行里有 `|` 吗(表格的初步判据)
私有 方法 Markdown有竖线(整数 始, 整数 止) 返回 逻辑
{
    整数 i = 始;
    当 (i < 止)
    {
        如果 (Markdown字节区[i] == 124)
        {
            返回 真;
        }
        i = i + 1;
    }
    返回 假;
}

// 私有:块类型(2 = 普通段落行)
私有 方法 Markdown块类(整数 始, 整数 止) 返回 整数
{
    如果 (始 >= 止)
    {
        返回 0;
    }
    如果 (Markdown围栏数(始, 止) >= 3)
    {
        返回 6;
    }
    如果 (Markdown字节区[始] == 35)
    {
        整数 i = 始;
        整数 级 = 0;
        当 (i < 止 && Markdown字节区[i] == 35 && 级 < 7)
        {
            级 = 级 + 1;
            i = i + 1;
        }
        如果 (级 >= 1 && 级 <= 6 && i < 止 && Markdown是空白(i) == 真)
        {
            返回 1;
        }
    }
    如果 (Markdown是横线(始, 止) == 真)
    {
        返回 8;
    }
    如果 (Markdown有竖线(始, 止) == 真)
    {
        返回 7;
    }
    整数 首 = Markdown字节区[始];
    如果 (首 == 62)
    {
        返回 5;
    }
    如果 (首 == 45 || 首 == 42 || 首 == 43)
    {
        如果 (始 + 1 < 止 && Markdown是空白(始 + 1) == 真)
        {
            返回 3;
        }
    }
    如果 (首 >= 48 && 首 <= 57)
    {
        整数 i = 始;
        当 (i < 止 && Markdown字节区[i] >= 48 && Markdown字节区[i] <= 57)
        {
            i = i + 1;
        }
        如果 (i + 1 < 止 && Markdown字节区[i] == 46 && Markdown是空白(i + 1) == 真)
        {
            返回 4;
        }
    }
    返回 2;
}

// 私有:一行的文字是不是只剩 `-` `:` 与空白 / 竖线(表格的分隔行就是它)
私有 方法 Markdown是格线行(整数 始, 整数 止) 返回 逻辑
{
    整数 i = 始;
    整数 有横 = 0;
    当 (i < 止)
    {
        整数 值 = Markdown字节区[i];
        如果 (值 == 45)
        {
            有横 = 1;
        }
        否则 如果 (值 == 58 || 值 == 32 || 值 == 9 || 值 == 124)
        {
            有横 = 有横;
        }
        否则
        {
            返回 假;
        }
        i = i + 1;
    }
    如果 (有横 == 1)
    {
        返回 真;
    }
    返回 假;
}

// 私有:把 [起, 止) 这一段按 `|` 切成格(起 / 止 写进两表);给格数
私有 方法 Markdown切格区(整数 起, 整数 止, 整数 起表[], 整数 止表[]) 返回 整数
{
    整数 数 = 0;
    整数 位 = 起;
    当 (位 <= 止)
    {
        如果 (数 >= 32)
        {
            返回 数;
        }
        整数 本起 = 位;
        整数 本止 = 位;
        当 (本止 < 止 && Markdown字节区[本止] != 124)
        {
            本止 = 本止 + 1;
        }
        起表[数] = 本起;
        止表[数] = 本止;
        数 = 数 + 1;
        如果 (本止 >= 止)
        {
            返回 数;
        }
        位 = 本止 + 1;
    }
    返回 数;
}

// 私有:一格的两头去空白
私有 方法 Markdown格去空(引用 整数 起, 引用 整数 止)
{
    当 (起 < 止 && Markdown是空白(起) == 真)
    {
        起 = 起 + 1;
    }
    当 (止 > 起 && Markdown是空白(止 - 1) == 真)
    {
        止 = 止 - 1;
    }
    返回
}

// 私有:收一个表格(从 `位` 那一行起,含表头与分隔行);`位` 走到下一行的行首。给 7
私有 方法 Markdown收表(整数 块, 引用 整数 位, 整数 档止)
{
    Markdown块类[块] = 7;
    Markdown块起[块] = 位;
    Markdown块止[块] = 位;
    Markdown行基数 = Markdown行数表;
    整数 列数 = 0;
    整数 行数 = 0;
    当 (位 < 档止 && 行数 < 32 && Markdown行数表 < 256)
    {
        整数 行止 = Markdown下个行(位, 档止);
        整数 行终 = 行止;
        当 (行终 > 位 && Markdown字节区[行终 - 1] == 13)
        {
            行终 = 行终 - 1;
        }
        如果 (行终 == 位)
        {
            跳出;
        }
        如果 (Markdown是格线行(位, 行终) == 真)
        {
            如果 (Markdown块止[块] < 行止)
            {
                Markdown块止[块] = 行止;
            }
            如果 (行止 >= 档止)
            {
                位 = 档止;
                跳出;
            }
            位 = 行止 + 1;
            继续;
        }
        整数 格数 = Markdown切格区(位, 行终, Markdown收起, Markdown收止);

        如果 (行数 == 0)
        {
            列数 = 格数;
        }
        整数 取数 = 格数;
        如果 (取数 > 列数)
        {
            取数 = 列数;
        }
        Markdown行首[Markdown行数表] = Markdown内数表;
        整数 k = 0;
        当 (k < 取数 && Markdown内数表 < 512)
        {
            整数 本起 = Markdown收起[k];
            整数 本止 = Markdown收止[k];
            Markdown格去空(本起, 本止);
            如果 (本起 < 本止)
            {
                Markdown记行内(Markdown内数表, 1, 本起, 本止, 0, 0);
                Markdown内数表 = Markdown内数表 + 1;
            }
            k = k + 1;
        }
        Markdown行末[Markdown行数表] = Markdown内数表;
        Markdown行数表 = Markdown行数表 + 1;
        行数 = 行数 + 1;
        如果 (Markdown块止[块] < 行止)
        {
            Markdown块止[块] = 行止;
        }
        如果 (行止 >= 档止)
        {
            位 = 档止;
            跳出;
        }
        位 = 行止 + 1;
    }
    Markdown块行数[块] = 行数;
    Markdown表格基[块] = Markdown行基数;
    Markdown块内数[块] = Markdown内数表 - Markdown行首[Markdown行基数];
    Markdown块内头[块] = Markdown行首[Markdown行基数];
    返回
}

// 私有:收一个围栏代码块(从 `位` 那一行起);`位` 走到下一行的行首
私有 方法 Markdown收码(整数 块, 引用 整数 位, 整数 档止)
{
    整数 始 = 位;
    整数 行止 = Markdown下个行(位, 档止);
    整数 内容始 = 行止 + 1;
    如果 (内容始 > 档止)
    {
        内容始 = 档止;
    }
    整数 走 = 内容始;
    整数 内容止 = 内容始;
    当 (走 < 档止)
    {
        整数 本止 = Markdown下个行(走, 档止);
        如果 (Markdown围栏数(走, 本止) >= 3)
        {
            内容止 = 走;
            如果 (内容止 > 内容始 && Markdown字节区[内容止 - 1] == 10)
            {
                内容止 = 内容止 - 1;
            }
            走 = 本止 + 1;
            跳出;
        }
        如果 (本止 >= 档止)
        {
            内容止 = 档止;
            走 = 档止;
            跳出;
        }
        走 = 本止 + 1;
    }
    Markdown块类[块] = 6;
    Markdown块起[块] = 内容始;
    Markdown块止[块] = 内容止;
    位 = 走;
    返回
}

// 私有:从 `位` 起收一个段落(连着几行;`尾` 给段落之后的行首);给段落的字节长
私有 方法 Markdown收段(整数 位, 整数 档止, 引用 整数 尾) 返回 整数
{
    整数 首 = 位;
    整数 长 = 0;
    整数 走 = 位;
    当 (走 < 档止)
    {
        整数 行止 = Markdown下个行(走, 档止);
        整数 行终 = 行止;
        当 (行终 > 走 && Markdown字节区[行终 - 1] == 13)
        {
            行终 = 行终 - 1;
        }
        如果 (行终 == 走)
        {
            跳出;
        }
        如果 (走 != 首)
        {
            如果 (Markdown块类(走, 行终) != 2)
            {
                跳出;
            }
        }
        长 = 行止 - 首;
        走 = 行止 + 1;
        如果 (行止 >= 档止)
        {
            走 = 档止;
            跳出;
        }
    }
    尾 = 走;
    返回 长;
}

// 私有:找字节 `值` 在 [起, 止) 里第一次出现的位;没有给 -1
私有 方法 Markdown找字节(整数 起, 整数 止, 整数 值) 返回 整数
{
    整数 i = 起;
    当 (i < 止)
    {
        如果 (Markdown字节区[i] == 值)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 0 - 1;
}

// 私有:记一个行内节点
私有 方法 Markdown记行内(整数 内, 整数 类值, 整数 起, 整数 止, 整数 址起, 整数 址止)
{

    Markdown内类[内] = 类值;
    Markdown内起[内] = 起;
    Markdown内止[内] = 止;
    Markdown内址起[内] = 址起;
    Markdown内址止[内] = 址止;
    Markdown内下个[内] = 内 + 1;
    返回
}

// 私有:认这一块里"从 `位` 起的下一条行内";找到给 `尾`(这一条之后从哪继续)与 `种`
私有 方法 Markdown认行内(整数 位, 整数 止, 引用 整数 尾, 引用 整数 种) 返回 逻辑
{
    种 = 0;
    尾 = 位;
    如果 (位 >= 止)
    {
        返回 假;
    }
    整数 值 = Markdown字节区[位];
    // 行内代码
    如果 (值 == 96)
    {
        整数 找 = 位 + 1;
        当 (找 < 止 && Markdown字节区[找] != 96)
        {
            找 = 找 + 1;
        }
        如果 (找 < 止)
        {
            种 = 4;
            尾 = 找 + 1;
            返回 真;
        }
    }
    // 图片
    如果 (值 == 33 && 位 + 1 < 止 && Markdown字节区[位 + 1] == 91)
    {
        整数 闭 = Markdown找字节(位 + 2, 止, 93);
        如果 (闭 > 0 && 闭 + 1 < 止 && Markdown字节区[闭 + 1] == 40)
        {
            整数 括 = Markdown找字节(闭 + 2, 止, 41);
            如果 (括 > 0)
            {
                种 = 6;
                尾 = 括 + 1;
                返回 真;
            }
        }
    }
    // 链接
    如果 (值 == 91)
    {
        整数 闭 = Markdown找字节(位 + 1, 止, 93);
        如果 (闭 > 0 && 闭 + 1 < 止 && Markdown字节区[闭 + 1] == 40)
        {
            整数 括 = Markdown找字节(闭 + 2, 止, 41);
            如果 (括 > 0)
            {
                种 = 5;
                尾 = 括 + 1;
                返回 真;
            }
        }
    }
    // 粗体 ** / __
    如果 (值 == 42 || 值 == 95)
    {
        如果 (位 + 1 < 止 && Markdown字节区[位 + 1] == 值)
        {
            整数 找 = 位 + 2;
            当 (找 + 1 < 止)
            {
                如果 (Markdown字节区[找] == 值 && Markdown字节区[找 + 1] == 值)
                {
                    // 空的那一对(`****`)不算粗体:那样收出来的段是空的
                    如果 (找 > 位 + 2)
                    {
                        种 = 2;
                        尾 = 找 + 2;
                        返回 真;
                    }
                    返回 假;
                }
                找 = 找 + 1;
            }
        }
        否则
        {
            整数 找 = 位 + 1;
            当 (找 < 止)
            {
                如果 (Markdown字节区[找] == 值)
                {
                    // 空的那一对(`**`)不算斜体(与粗体同一条口径)
                    如果 (找 > 位 + 1)
                    {
                        种 = 3;
                        尾 = 找 + 1;
                        返回 真;
                    }
                    返回 假;
                }
                找 = 找 + 1;
            }
        }
    }
    返回 假;
}

// 私有:把 [起, 止) 里的行内认出来,平铺进行内表;返回这一块的行内数(写进块表)
//   ⚠ 口径:每认出一条**先把前面攒着的正文落一条**,再把这条记下去 —— 正文那一段只到
//   "这一条的开头"为止。(老写法是"两条之间凑正文",那会让下一条的起点留在上一条里。)
私有 方法 Markdown扫块(整数 块) 返回 整数
{
    整数 头 = Markdown内数表;
    整数 起 = Markdown块起[块];
    整数 止 = Markdown块止[块];
    整数 位 = 起;

    当 (位 < 止 && Markdown内数表 < 511)
    {
        整数 尾 = 位;
        整数 种 = 0;
        如果 (Markdown认行内(位, 止, 尾, 种) == 假)
        {
            位 = 位 + 1;
            继续;
        }

        如果 (位 > 起 && Markdown内数表 < 512)
        {
            Markdown记行内(Markdown内数表, 1, 起, 位, 0, 0);
            Markdown内数表 = Markdown内数表 + 1;
        }
        如果 (种 == 4)
        {
            Markdown记行内(Markdown内数表, 4, 位 + 1, 尾 - 1, 0, 0);
        }
        否则 如果 (种 == 2)
        {
            Markdown记行内(Markdown内数表, 2, 位 + 2, 尾 - 2, 0, 0);
        }
        否则 如果 (种 == 3)
        {
            Markdown记行内(Markdown内数表, 3, 位 + 1, 尾 - 1, 0, 0);
        }
        否则 如果 (种 == 5)
        {
            整数 闭 = 尾 - 2;
            当 (闭 > 位 && Markdown字节区[闭] != 93)
            {
                闭 = 闭 - 1;
            }
            Markdown记行内(Markdown内数表, 5, 位 + 1, 闭, 闭 + 2, 尾 - 1);
        }
        否则 如果 (种 == 6)
        {
            整数 闭 = 尾 - 2;
            当 (闭 > 位 && Markdown字节区[闭] != 93)
            {
                闭 = 闭 - 1;
            }
            Markdown记行内(Markdown内数表, 6, 位 + 2, 闭, 闭 + 2, 尾 - 1);
        }
        Markdown内数表 = Markdown内数表 + 1;
        起 = 尾;
        位 = 尾;
    }
    如果 (起 < 止 && Markdown内数表 < 512)
    {
        Markdown记行内(Markdown内数表, 1, 起, 止, 0, 0);
        Markdown内数表 = Markdown内数表 + 1;
    }
    返回 Markdown内数表 - 头;
}

// 解析:整段文本按字节收进字节区,认成"块 + 行内"两层;给文档号(0 = 空 / 收不下)
方法 解析(字符串 文本) 返回 整数
{
    整数 共 = Markdown字节长(文本);
    Markdown错处 = 0;
    Markdown块数表 = 0;
    Markdown内数表 = 0;
    Markdown行数表 = 0;
    如果 (共 <= 0)
    {
        返回 0;
    }
    整数 档 = Markdown文档轮 + 1;
    如果 (档 > 8)
    {
        档 = 1;
    }
    Markdown文档轮 = 档;
    整数 档起 = (档 - 1) * 8192;
    整数 收 = Markdown收字节(档起, 文本);
    如果 (收 < 0)
    {
        Markdown错处 = 8192;
        返回 0;
    }
    Markdown文档起[档] = 档起;
    Markdown文档长[档] = 收;
    Markdown档起 = 档起;
    Markdown字节用 = 档起 + 收;
    如果 (Markdown文档用 < 8)
    {
        Markdown文档用 = Markdown文档用 + 1;
    }
    整数 档止 = 档起 + 收;
    整数 i = 档起;
    当 (i < 档止)
    {
        整数 行止 = Markdown下个行(i, 档止);
        整数 行终 = 行止;
        当 (行终 > i && Markdown字节区[行终 - 1] == 13)
        {
            行终 = 行终 - 1;
        }
        如果 (行终 == i)
        {
            i = 行止 + 1;
            继续;
        }
        如果 (Markdown块数表 >= 64)
        {
            Markdown错处 = i - 档起;
            返回 档;
        }
        整数 块 = Markdown块数表;
        整数 类值 = Markdown块类(i, 行终);
        如果 (类值 == 1)
        {
            整数 k = i;
            整数 级 = 0;
            当 (k < 行终 && Markdown字节区[k] == 35 && 级 < 7)
            {
                级 = 级 + 1;
                k = k + 1;
            }
            当 (k < 行终 && Markdown是空白(k) == 真)
            {
                k = k + 1;
            }
            Markdown收块(块, 1, k, 行终);
            Markdown块级表[块] = 级;
            Markdown块数表 = Markdown块数表 + 1;
            i = 行止 + 1;
            继续;
        }
        如果 (类值 == 6)
        {
            Markdown收码(块, i, 档止);
            Markdown块数表 = Markdown块数表 + 1;
            继续;
        }
        如果 (类值 == 7)
        {
            Markdown收表(块, i, 档止);
            Markdown块数表 = Markdown块数表 + 1;
            继续;
        }
        如果 (类值 == 8)
        {
            Markdown收块(块, 8, i, 行终);
            Markdown块数表 = Markdown块数表 + 1;
            i = 行止 + 1;
            继续;
        }
        如果 (类值 == 3 || 类值 == 4)
        {
            整数 k = i;
            如果 (类值 == 3)
            {
                k = k + 1;
            }
            否则
            {
                当 (k < 行终 && Markdown字节区[k] >= 48 && Markdown字节区[k] <= 57)
                {
                    k = k + 1;
                }
                k = k + 1;
            }
            当 (k < 行终 && Markdown是空白(k) == 真)
            {
                k = k + 1;
            }
            Markdown收块(块, 类值, k, 行终);
            Markdown块数表 = Markdown块数表 + 1;
            i = 行止 + 1;
            继续;
        }
        如果 (类值 == 5)
        {
            Markdown收块(块, 5, i + 1, 行终);
            Markdown块数表 = Markdown块数表 + 1;
            i = 行止 + 1;
            继续;
        }
        // 剩下的当段落:连着几行一起收(到空行 / 另一个块为止)
        整数 尾 = i;
        整数 长 = Markdown收段(i, 档止, 尾);
        如果 (长 > 0)
        {
            Markdown块类[块] = 2;
            Markdown块起[块] = i;
            Markdown块止[块] = i + 长;
            逻辑 丢 = Markdown平段落(块);
            Markdown块数表 = Markdown块数表 + 1;
        }
        i = 尾;
        继续;
    }
    整数 块 = 0;
    当 (块 < Markdown块数表)
    {
        如果 (Markdown块类[块] == 7)
        {
            块 = 块 + 1;
            继续;
        }
        如果 (Markdown块类[块] == 6)
        {
            Markdown块内头[块] = Markdown内数表;
            Markdown块内数[块] = 0;
            块 = 块 + 1;
            继续;
        }
        Markdown块内头[块] = Markdown内数表;
        Markdown块内数[块] = Markdown扫块(块);
        块 = 块 + 1;
    }
    返回 档;
}

// 私有:把一段(可能跨行的)段落里的换行换成空格
私有 方法 Markdown平段落(整数 块) 返回 逻辑
{
    整数 i = Markdown块起[块];
    整数 止 = Markdown块止[块];
    当 (i < 止)
    {
        如果 (Markdown字节区[i] == 10)
        {
            Markdown字节区[i] = 32;
        }
        i = i + 1;
    }
    返回 真;
}

// 块数:这份文档有几个块
方法 块数(整数 文档) 返回 整数
{
    如果 (Markdown档在(文档) == 假)
    {
        返回 0;
    }
    返回 Markdown块数表;
}

// 取块:第 i 块(从 0 起);种类与文本写进你给的那两格
方法 取块(整数 文档, 整数 i, 引用 整数 种类, 字符串 出 文本) 返回 逻辑
{
    种类 = 0;
    文本.清空();
    如果 (Markdown档在(文档) == 假)
    {
        返回 假;
    }
    如果 (i < 0 || i >= Markdown块数表)
    {
        返回 假;
    }
    种类 = Markdown块类[i];
    Markdown搬文本(Markdown块起[i], Markdown块止[i], 文本);
    返回 真;
}

// 块级:标题的级(不是标题给 0;越界给 -1)
方法 块级(整数 文档, 整数 i) 返回 整数
{
    如果 (Markdown档在(文档) == 假)
    {
        返回 0 - 1;
    }
    如果 (i < 0 || i >= Markdown块数表)
    {
        返回 0 - 1;
    }
    返回 Markdown块级表[i];
}

// 行内数:第 i 块里认出行内几个
方法 行内数(整数 文档, 整数 i) 返回 整数
{
    如果 (Markdown档在(文档) == 假)
    {
        返回 0;
    }
    如果 (i < 0 || i >= Markdown块数表)
    {
        返回 0;
    }
    返回 Markdown块内数[i];
}

// 取行内:第 i 块里第 k 个行内;种类 / 文本 / 地址写进你给的那三格
方法 取行内(整数 文档, 整数 i, 整数 k, 引用 整数 种类, 字符串 出 文本, 字符串 出 网址) 返回 逻辑
{
    种类 = 0;
    文本.清空();
    网址.清空();
    如果 (Markdown档在(文档) == 假)
    {
        返回 假;
    }
    如果 (i < 0 || i >= Markdown块数表)
    {
        返回 假;
    }
    如果 (k < 0 || k >= Markdown块内数[i])
    {
        返回 假;
    }
    整数 内 = Markdown块内头[i] + k;
    整数 本类 = Markdown内类[内];
    // 两格结果都先在库里成型(见头注释那条口径),最后才一起交给调用方
    Markdown搬文本(Markdown内起[内], Markdown内止[内], 文本);
    Markdown中段.清空();
    拼接到(Markdown中段, Markdown搬槽);
    如果 (本类 == 5 || 本类 == 6)
    {
        Markdown搬文本(Markdown内址起[内], Markdown内址止[内], 网址);
    }
    否则
    {
        Markdown交串("", 网址);
    }
    种类 = 本类;
    Markdown交串(Markdown中段, 文本);
    返回 真;
}


// 表行数:表格块有几行(别的块给 0)
方法 表行数(整数 文档, 整数 i) 返回 整数
{
    如果 (Markdown档在(文档) == 假)
    {
        返回 0;
    }
    如果 (i < 0 || i >= Markdown块数表)
    {
        返回 0;
    }
    如果 (Markdown块类[i] != 7)
    {
        返回 0;
    }
    返回 Markdown块行数[i];
}

// 行首格:表格块第 `行` 行的第一格是行内那一层的第几个(越界给 -1)
方法 行首格(整数 文档, 整数 i, 整数 行) 返回 整数
{
    如果 (Markdown档在(文档) == 假)
    {
        返回 0 - 1;
    }
    如果 (i < 0 || i >= Markdown块数表)
    {
        返回 0 - 1;
    }
    如果 (行 < 0 || 行 >= Markdown块行数[i])
    {
        返回 0 - 1;
    }
    返回 Markdown行首[Markdown表格基[i] + 行] - Markdown块内头[i];
}

// 行格数:表格块第 `行` 行有几格(越界给 0)
方法 行格数(整数 文档, 整数 i, 整数 行) 返回 整数
{
    如果 (Markdown档在(文档) == 假)
    {
        返回 0;
    }
    如果 (i < 0 || i >= Markdown块数表)
    {
        返回 0;
    }
    如果 (行 < 0 || 行 >= Markdown块行数[i])
    {
        返回 0;
    }
    整数 基 = Markdown表格基[i] + 行;
    返回 Markdown行末[基] - Markdown行首[基];
}

// 转纯文本:整份去掉标记的正文,写进你那一格
方法 转纯文本(整数 文档, 字符串 出 文) 返回 逻辑
{
    Markdown交串("", 文);
    如果 (Markdown档在(文档) == 假)
    {
        返回 假;
    }
    字符串 全 = "";
    整数 块 = 0;
    当 (块 < Markdown块数表)
    {
        Markdown转纯块(块);
        拼接到(全, Markdown写槽);
        如果 (块 + 1 < Markdown块数表)
        {
            拼接到(全, "\n");
        }
        块 = 块 + 1;
    }
    Markdown交串(全, 文);
    返回 真;
}

// 私有:一块转成纯文本,结果落在写槽里
私有 方法 Markdown转纯块(整数 块)
{
    Markdown写槽.清空();
    整数 类值 = Markdown块类[块];
    如果 (类值 == 7)
    {
        Markdown转纯表(块);
        返回
    }
    如果 (类值 == 6)
    {
        Markdown搬文本(Markdown块起[块], Markdown块止[块], Markdown中段);
        拼接到(Markdown写槽, Markdown中段);
        返回
    }
    如果 (类值 == 1)
    {
        拼接到(Markdown写槽, "# ");
    }
    否则 如果 (类值 == 3)
    {
        拼接到(Markdown写槽, "- ");
    }
    否则 如果 (类值 == 4)
    {
        拼接到(Markdown写槽, "1. ");
    }
    字符串 段 = "";
    整数 k = 0;
    整数 共 = Markdown块内数[块];
    当 (k < 共)
    {
        整数 内 = Markdown块内头[块] + k;
        Markdown搬文本(Markdown内起[内], Markdown内止[内], Markdown中段);
        拼接到(Markdown写槽, Markdown中段);
        k = k + 1;
    }
    返回
}

// 私有:表格转成纯文本,结果落在写槽里
私有 方法 Markdown转纯表(整数 块)
{
    整数 基 = Markdown表格基[块];
    整数 行 = 0;
    当 (行 < Markdown块行数[块])
    {
        如果 (行 > 0)
        {
            拼接到(Markdown写槽, "\n");
        }
        拼接到(Markdown写槽, "| ");
        整数 首 = Markdown行首[基 + 行];
        整数 尾 = Markdown行末[基 + 行];
        整数 格 = 首;
        当 (格 < 尾)
        {
            如果 (格 > 首)
            {
                拼接到(Markdown写槽, " | ");
            }
            Markdown搬文本(Markdown内起[格], Markdown内止[格], Markdown中段);
            拼接到(Markdown写槽, Markdown中段);
            格 = 格 + 1;
        }
        拼接到(Markdown写槽, " |");
        行 = 行 + 1;
    }
    返回
}

// 转HTML:整份转成一段 HTML 片断,写进你那一格
方法 转HTML(整数 文档, 字符串 出 文) 返回 逻辑
{
    Markdown交串("", 文);
    如果 (Markdown档在(文档) == 假)
    {
        返回 假;
    }
    Markdown缓冲.清空();
    整数 块 = 0;
    当 (块 < Markdown块数表)
    {
        Markdown转标签块(块);
        块 = 块 + 1;
    }
    Markdown交串(Markdown缓冲, 文);
    返回 真;
}

// 私有:把一个字节照 HTML 五个字符转义着写进缓冲
私有 方法 Markdown写HTML字节(整数 值)
{
    如果 (值 == 38)
    {
        拼接到(Markdown缓冲, "&amp;");
        返回
    }
    如果 (值 == 60)
    {
        拼接到(Markdown缓冲, "&lt;");
        返回
    }
    如果 (值 == 62)
    {
        拼接到(Markdown缓冲, "&gt;");
        返回
    }
    如果 (值 == 34)
    {
        拼接到(Markdown缓冲, "&quot;");
        返回
    }
    如果 (值 == 39)
    {
        拼接到(Markdown缓冲, "&#39;");
        返回
    }
    字符 本字节 = 值;
    拼接到(Markdown缓冲, 本字节);
    返回
}

// 私有:把字节区 [起, 止) 这一段转义着写进缓冲
私有 方法 Markdown写HTML文(整数 起, 整数 止)
{
    如果 (起 < 0)
    {
        起 = 0;
    }
    如果 (止 > Markdown字节用)
    {
        止 = Markdown字节用;
    }
    整数 i = 起;
    当 (i < 止)
    {
        Markdown写HTML字节(Markdown字节区[i]);
        i = i + 1;
    }
    返回
}

// 私有:一块转成 HTML
私有 方法 Markdown转标签块(整数 块)
{
    整数 类值 = Markdown块类[块];
    如果 (类值 == 8)
    {
        拼接到(Markdown缓冲, "<hr>\n");
        返回
    }
    如果 (类值 == 6)
    {
        拼接到(Markdown缓冲, "<pre><code>");
        Markdown写HTML文(Markdown块起[块], Markdown块止[块]);
        拼接到(Markdown缓冲, "</code></pre>\n");
        返回
    }
    如果 (类值 == 7)
    {
        Markdown转标签表(块);
        返回
    }
    如果 (类值 == 1)
    {
        拼接到(Markdown缓冲, "<h");
        拼接到(Markdown缓冲, Markdown号文(Markdown块级表[块]));
        拼接到(Markdown缓冲, '>');
        Markdown走行内链(块);
        拼接到(Markdown缓冲, "</h");
        拼接到(Markdown缓冲, Markdown号文(Markdown块级表[块]));
        拼接到(Markdown缓冲, ">\n");
        返回
    }
    如果 (类值 == 5)
    {
        拼接到(Markdown缓冲, "<blockquote>\n");
        Markdown包行内(块, "p");
        拼接到(Markdown缓冲, "</blockquote>\n");
        返回
    }
    如果 (类值 == 3 || 类值 == 4)
    {
        字符串 标 = "ul";
        如果 (类值 == 4)
        {
            标 = "ol";
        }
        拼接到(Markdown缓冲, "<");
        拼接到(Markdown缓冲, 标);
        拼接到(Markdown缓冲, ">\n<li>");
        Markdown走行内链(块);
        拼接到(Markdown缓冲, "</li>\n</");
        拼接到(Markdown缓冲, 标);
        拼接到(Markdown缓冲, ">\n");
        返回
    }
    Markdown包行内(块, "p");
    返回
}

// 私有:一块里的行内用 `标签` 包起来
私有 方法 Markdown包行内(整数 块, 字符串 标签)
{
    拼接到(Markdown缓冲, "<");
    拼接到(Markdown缓冲, 标签);
    拼接到(Markdown缓冲, ">");
    Markdown走行内链(块);
    拼接到(Markdown缓冲, "</");
    拼接到(Markdown缓冲, 标签);
    拼接到(Markdown缓冲, ">\n");
    返回
}

// 私有:一块里的行内按种类摆 HTML
私有 方法 Markdown走行内链(整数 块)
{
    整数 k = 0;
    整数 共 = Markdown块内数[块];
    当 (k < 共)
    {
        整数 内 = Markdown块内头[块] + k;
        整数 类值 = Markdown内类[内];
        如果 (类值 == 1)
        {
            Markdown写HTML文(Markdown内起[内], Markdown内止[内]);
        }
        否则 如果 (类值 == 2)
        {
            拼接到(Markdown缓冲, "<strong>");
            Markdown写HTML文(Markdown内起[内], Markdown内止[内]);
            拼接到(Markdown缓冲, "</strong>");
        }
        否则 如果 (类值 == 3)
        {
            拼接到(Markdown缓冲, "<em>");
            Markdown写HTML文(Markdown内起[内], Markdown内止[内]);
            拼接到(Markdown缓冲, "</em>");
        }
        否则 如果 (类值 == 4)
        {
            拼接到(Markdown缓冲, "<code>");
            Markdown写HTML文(Markdown内起[内], Markdown内止[内]);
            拼接到(Markdown缓冲, "</code>");
        }
        否则 如果 (类值 == 6)
        {
            拼接到(Markdown缓冲, "<img src=\"");
            Markdown写HTML文(Markdown内址起[内], Markdown内址止[内]);
            拼接到(Markdown缓冲, "\" alt=\"");
            Markdown写HTML文(Markdown内起[内], Markdown内止[内]);
            拼接到(Markdown缓冲, "\">");
        }
        否则 如果 (类值 == 5)
        {
            拼接到(Markdown缓冲, "<a href=\"");
            Markdown写HTML文(Markdown内址起[内], Markdown内址止[内]);
            拼接到(Markdown缓冲, "\">");
            Markdown写HTML文(Markdown内起[内], Markdown内止[内]);
            拼接到(Markdown缓冲, "</a>");
        }
        k = k + 1;
    }
    返回
}

// 私有:表格摆成 HTML(第一行当表头)
私有 方法 Markdown转标签表(整数 块)
{
    拼接到(Markdown缓冲, "<table>\n");
    整数 基 = Markdown表格基[块];
    整数 行 = 0;
    当 (行 < Markdown块行数[块])
    {
        如果 (行 == 0)
        {
            拼接到(Markdown缓冲, "<thead>\n<tr>\n");
        }
        否则 如果 (行 == 1)
        {
            拼接到(Markdown缓冲, "</tr>\n</thead>\n<tbody>\n<tr>\n");
        }
        否则
        {
            拼接到(Markdown缓冲, "</tr>\n<tr>\n");
        }
        整数 格 = Markdown行首[基 + 行];
        整数 尾 = Markdown行末[基 + 行];
        当 (格 < 尾)
        {
            如果 (行 == 0)
            {
                拼接到(Markdown缓冲, "<th>");
            }
            否则
            {
                拼接到(Markdown缓冲, "<td>");
            }
            Markdown写HTML文(Markdown内起[格], Markdown内止[格]);
            如果 (行 == 0)
            {
                拼接到(Markdown缓冲, "</th>\n");
            }
            否则
            {
                拼接到(Markdown缓冲, "</td>\n");
            }
            格 = 格 + 1;
        }
        行 = 行 + 1;
    }
    如果 (Markdown块行数[块] > 0)
    {
        拼接到(Markdown缓冲, "</tr>\n");
    }
    如果 (Markdown块行数[块] > 1)
    {
        拼接到(Markdown缓冲, "</tbody>\n");
    }
    拼接到(Markdown缓冲, "</table>\n");
    返回
}
