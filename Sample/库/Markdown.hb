    返回 真;
}

// 私有:一个整数写成文字(不引 `string.hb`:这一库零依赖)
私有 方法 Markdown号文(整数 值) 返回 字符串
{
    字符串 结果 = "";
    如果 (值 == 0)
    {
        拼接到(结果, '0');
        返回 结果;
    }
    整数 正 = 值;
    如果 (正 < 0)
    {
        正 = 0 - 正;
    }
    整数 位[12];
    整数 几个 = 0;
    当 (正 > 0 && 几个 < 12)
    {
        位[几个] = 正 % 10;
        正 = 正 / 10;
        几个 = 几个 + 1;
    }
    如果 (值 < 0)
    {
        拼接到(结果, '-');
    }
    整数 i = 几个 - 1;
    当 (i >= 0)
    {
        整数 数 = 位[i];
        字符 数文 = Markdown数字字(数);
        拼接到(结果, 数文);
        i = i - 1;
    }
    返回 结果;
}

// 私有:一个 0~9 的数字写成字符
私有 方法 Markdown数字字(整数 数) 返回 字符
{
    如果 (数 == 0)
    {
        返回 '0';
    }
    如果 (数 == 1)
    {
        返回 '1';
    }
    如果 (数 == 2)
    {
        返回 '2';
    }
    如果 (数 == 3)
    {
        返回 '3';
    }
    如果 (数 == 4)
    {
        返回 '4';
    }
    如果 (数 == 5)
    {
        返回 '5';
    }
    如果 (数 == 6)
    {
        返回 '6';
    }
    如果 (数 == 7)
    {
        返回 '7';
    }
    如果 (数 == 8)
    {
        返回 '8';
    }
    返回 '9';
}

