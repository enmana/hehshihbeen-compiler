    {
        拼接到(Markdown写槽, '\\');
    }
    Markdown写躲掉(文本);
    拼接到(Markdown缓冲, Markdown写槽);
    Markdown补换行();
    返回 真;
}

// 要点:`- 文本`
方法 要点(字符串 文本) 返回 逻辑
