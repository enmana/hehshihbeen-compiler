// ============================================================
// 目录.hb —— 目录与路径库(纯 HB,不动语言面)
//
// 用法:包含 "../库/目录.hb";调用写 `目录.路径拼接(根, 名字)`。
//
// 口径(2026-09):
//   · **分隔符同时认 '/' 与 '\'**;库**只做字符串上的加减**、不查盘 —— 除 `列出` / `数出` 以外全是纯函数;
//   · `数出(路径)` = `列目录` + `条目数` 一次做完:成功给**条目数**,失败给 **-1**;
//   · 两个"列"的口径里**上限写死 65536 字节**(`列目录` 那个参数要编译期常量)——
//     目录大到超过这个数就得直接用语言内建的 `列目录`、自己写上限;
//   · 清单这一族(`条目数` / `取条目` / `条目到表`)只认"名字按行排"的清单:
//     **条目之间一个换行,末尾不带换行**(末尾真带了一个换行时,那个空段不算条目);
//   · **不报错、不停机**:路径怪、清单空、序号越界一律给"空串 / 0 / 假"。
//
// 英文对照:路径拼接 joinPath · 去尾分隔 trimEndSlash · 取文件名 fileNameOf · 取目录 dirNameOf
//   取后缀 extOf · 是绝对路径 isAbsolute · 列出 listDir · 数出 countDir
//   条目数 entryCount · 取条目 entryAt · 条目到表 entriesToTable
//
// 边界(如实登记):
//   · **`引用 字符串` 编不过**(报"引用指向的类型不认识: `字符串`";`引用` 现在只认数字类型与结构)⇒ 清单走**返回值**:
//     要文字就 `列出`,要条数就 `数出`,两个入口各做一件事;
//   · **不做递归遍历**:`列目录` 只给名字,**分不出哪一条是文件、哪一条是目录** ⇒ 没法定下钻
//     (要递归得先给宿主能力加一格"这一条是不是目录");这一库只做**本层**;
//   · **不做一键清空 / 递归删**:要清就 `列出` 之后自己 `删文件` 逐个删。
// 提供的函数(12 个):逐个见下面那张公开方法表。
// 复杂度:路径那几条 O(路径长度);`列出` / `数出` 一次系统调用,`条目数` / `取条目` O(清单长度)。
// ============================================================
模块 目录

包含 "string.hb"

// 一个文字是不是路径分隔符('/' 与 '\' 都算)
方法 是分隔(文字 某字) 返回 逻辑
{
    如果 (某字 == '/' || 某字 == '\\')
    {
        返回 真;
    }
    返回 假;
}

// 去掉末尾多余的 '/' 与 '\';整个路径都是分隔符时留一个(那是根)
方法 去尾分隔(字符串 路径) 返回 字符串
{
    整数 末 = 路径.长度();
    当 (末 > 1 && 是分隔(路径[末 - 1]))
    {
        末 = 末 - 1;
    }
    返回 取子串(路径, 0, 末);
}

// 最后一段(以分隔符结尾给空串)
方法 取文件名(字符串 路径) 返回 字符串
{
    整数 长 = 路径.长度();
    整数 切点 = 长;
    当 (切点 > 0 && !是分隔(路径[切点 - 1]))
    {
        切点 = 切点 - 1;
    }
    返回 取子串(路径, 切点, 长 - 切点);
}

// 最后一段之前的部分:没有分隔符给空串;分隔符就在开头(根)给那一个分隔符
方法 取目录(字符串 路径) 返回 字符串
{
    整数 长 = 路径.长度();
    整数 切点 = 长;
    当 (切点 > 0 && !是分隔(路径[切点 - 1]))
    {
        切点 = 切点 - 1;
    }
    如果 (切点 == 0)
    {
        返回 "";
    }
    如果 (切点 == 1)
    {
        返回 取子串(路径, 0, 1);
    }
    返回 取子串(路径, 0, 切点 - 1);
}

// 文件名的最后一个 '.' 之后的文字(不含那个点);没有点、点在末尾、点在开头(隐藏文件)一律给空串。
方法 取后缀(字符串 路径) 返回 字符串
{
    字符串 名字 = 取文件名(路径);
    整数 长 = 名字.长度();
    整数 点 = -1;
    整数 i = 0;
    当 (i < 长)
    {
        如果 (名字[i] == '.')
        {
            点 = i;
        }
        i = i + 1;
    }
    如果 (点 <= 0 || 点 == 长 - 1)
    {
        返回 "";
    }
    返回 取子串(名字, 点 + 1, 长 - 点 - 1);
}

// 绝对路径:'/' 或 '\' 开头,或者第二个字符是 ':'(如 `C:/数据`)
方法 是绝对路径(字符串 路径) 返回 逻辑
{
    如果 (路径.长度() == 0)
    {
        返回 假;
    }
    如果 (是分隔(路径[0]))
    {
        返回 真;
    }
    如果 (路径.长度() >= 2 && 路径[1] == ':')
    {
        返回 真;
    }
    返回 假;
}

// 把两段接成一条路径(中间的斜杠正好一个,名字开头带的斜杠也去掉);名字为空给原目录,目录为空给名字。
方法 路径拼接(字符串 目录, 字符串 名字) 返回 字符串
{
    如果 (名字.长度() == 0)
    {
        返回 目录;
    }
    如果 (目录.长度() == 0)
    {
        返回 名字;
    }
    字符串 拼好 = 去尾分隔(目录);
    拼接到(拼好, '/');
    整数 起 = 0;
    整数 名字长 = 名字.长度();
    当 (起 < 名字长 && 是分隔(名字[起]))
    {
        起 = 起 + 1;
    }
    拼接到(拼好, 取子串(名字, 起, 名字长 - 起));
    返回 拼好;
}

// 数清单里的条目数:空串给 0;末尾真带一个换行时那个空段不算条目
方法 条目数(字符串 清单) 返回 整数
{
    整数 长 = 清单.长度();
    如果 (长 == 0)
    {
        返回 0;
    }
    整数 条 = 段数(清单, "\n");
    如果 (清单[长 - 1] == '\n')
    {
        条 = 条 - 1;
    }
    返回 条;
}

// 取第 序号 条(从 0 起);越界与负数给空串
方法 取条目(字符串 清单, 整数 序号) 返回 字符串
{
    如果 (序号 < 0 || 序号 >= 条目数(清单))
    {
        返回 "";
    }
    返回 取段(清单, "\n", 序号);
}

// 把每条写进调用方那两条并排数组,返回**实际写下的条数**(空清单给 0;表装不下只写能放的)。
方法 条目到表(字符串 清单, 整数 起表[], 整数 长表[]) 返回 整数
{
    整数 条 = 条目数(清单);
    如果 (条 == 0)
    {
        返回 0;
    }
    整数 写下 = 切分(清单, "\n", 起表, 长表);
    如果 (写下 > 条)
    {
        写下 = 条;                 // 末尾那个空段不算条目
    }
    返回 写下;
}

// 列本层:成功给清单(名字按行排,末尾不带换行),失败与"空目录"都给空串(要区分就问 `数出`);上限写死 65536 字节。
方法 列出(字符串 路径) 返回 字符串
{
    字符串 清单 = "";
    如果 (列目录(路径, 清单, 65536))
    {
        返回 清单;
    }
    返回 "";
}

// 列本层并数条数:成功给条目数(空目录给 0),失败给 -1
方法 数出(字符串 路径) 返回 整数
{
    字符串 清单 = "";
    如果 (列目录(路径, 清单, 65536))
    {
        返回 条目数(清单);
    }
    返回 -1;
}
