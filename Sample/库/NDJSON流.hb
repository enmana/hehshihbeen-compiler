// ============================================================
// NDJSON流.hb —— 一行一个 JSON 的日志/导出文件,一条一条吃(依赖 `JSON.hb`)
//
// 用法:
// ```
// 包含 "../库/JSON.hb"
// 包含 "../库/NDJSON流.hb"
// 如果 (NDJSON流.开读("数据/日志.ndjson"))
// {
//     当 (NDJSON流.下一条())                 // 坏行自己跳过(条数记在 `坏几条`)
//     {
//         整数 条 = NDJSON流.当前();          // 这一条解析出来的根节点(交给 JSON.*)
//         字符串 级别 = "";
//         JSON.取文本(条, "级别", 级别);
//         输出行(JSON.取整数(条, "耗时", 0));
//     }
//     NDJSON流.关读();
// }
// // 写:一个节点一行
// NDJSON流.开写("数据/出.ndjson");
// 整数 新根 = JSON.新建对象();
// JSON.放文本(新根, "级别", "信息");
// JSON.放整数(新根, "耗时", 12);
// NDJSON流.写一条(新根);
// NDJSON流.关写();
// ```
//
// **几 MB 的日志 / 导出**(一行一个 JSON)内存里装不下 —— 一条一条读、读完一条当场解析,常驻只占
//   **一行 + 一份文档**的份。解析与取值全归 `JSON.hb`(这一库只管"一行一行"这一层)。
//
// 口径(2026-10;每条都对着实测写):
//   · **块级读写**:库自己开读写流,一次读一块(4096 字节)进**一个持久的串变量**(反复用同一格),
//     逐字节的活走 `字符` 缓冲(下标 O(1))—— 所以"一条一条吃"**不吃字符串池**;
//   · **坏行跳过**:不是合法 JSON 的那一行**不打断循环**(只记个数):`坏几条` 问得出跳了几条;
//     末尾那个空行不算一条;
//   · **一条 = 一行**:行尾的 `\r` 去掉(Windows 换行也认);末行没有换行也算一条;
//   · **节点只在"当前这一条"里有效**:每读一条都会把 `JSON` 的"当前那一份"换掉 ⇒ 上一条的节点号当场作废
//     (要留什么,读完那一条当场拷进自己的变量);
//   · **一次一条流**:读一条、写一条,各占一个"当前流";要同时开两条就自己交错 `关读` / `开读`;
//   · **失败给假 / 0**:打不开、没开着、行太长都有确定结果,不报错、不停机。
//
// 提供的函数:逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:开 / 关 O(1);`下一条` O(这一条的字节数 + 解析量);`写一条` O(这一条的字节数)。
//
// 内存账:静态**一个 8KB 的行缓冲** + **一个 4KB 的块缓冲**(串变量);一条最长 **8000 字节**
//   (含它解析出来的那些节点 —— 上限由 `JSON.hb` 的节点池与字节区定)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **不做"数组形式的整份 JSON"**:那是 `JSON.解析` 的活(这一库只认"一行一个");
//   · **不做"压缩 / 加密 / 按时间切文件"**:要那些自己在外面套一层(`流.hb` 的块读写都在);
//   · **不做"随机定位 / 跳行"**:只能从头一条条往下走;
//   · **写流不建目录**(内建就是这口径):路径上的目录要自己先建。
// ============================================================
模块 NDJSON流

包含 "JSON.hb"

// ---------- 模块状态:一条读流 + 一条写流 ----------
私有 字符串 NDJSON流块;
私有 字符 NDJSON流行区[8192];
私有 整数 NDJSON流行长 = 0;
私有 整数 NDJSON流位 = 0;
私有 整数 NDJSON流行起 = 0;
私有 整数 NDJSON流行止 = 0;
私有 整数 NDJSON流读完 = 0;
私有 整数 NDJSON流读句 = 0 - 1;
私有 整数 NDJSON流写句 = 0 - 1;
私有 字符串 NDJSON流行槽;            // 当前这条的原文(给 `JSON.解析` 用,反复用这一格)
私有 字符串 NDJSON流写槽;            // 拼输出行的那一格(反复用)
私有 整数 NDJSON流当前 = 0;
私有 整数 NDJSON流坏数 = 0;

// ============================================================
// 1、读
// ============================================================

// 打开 `路径` 的读流(先关掉旧的),行缓冲、坏行数与当前节点都清零;打不开给假
方法 开读(字符串 路径) 返回 逻辑
{
    如果 (NDJSON流读句 >= 0)
    {
        逻辑 先关 = 关读();
    }
    NDJSON流行长 = 0;
    NDJSON流位 = 0;
    NDJSON流行起 = 0;
    NDJSON流行止 = 0;
    NDJSON流读完 = 0;
    NDJSON流坏数 = 0;
    NDJSON流当前 = 0;
    NDJSON流块 = "";
    NDJSON流行槽 = "";
    整数 句 = 0;
    如果 (打开读流(路径, 句) == 假)
    {
        NDJSON流读句 = 0 - 1;
        返回 假;
    }
    NDJSON流读句 = 句;
    返回 真;
}

// 关掉读流并让句柄作废(没开着直接给真);关失败给假
方法 关读() 返回 逻辑
{
    如果 (NDJSON流读句 < 0)
    {
        返回 真;
    }
    整数 状 = 关读流(NDJSON流读句);
    NDJSON流读句 = 0 - 1;
    返回 状 == 0;
}

// 私有:读下一条的原文进 `NDJSON流行区`(跨块拼行、行尾 `\r` 去掉);没有了给假
私有 方法 NDJSON流读一行() 返回 逻辑
{
    当 (真)
     {
        整数 断 = 0 - 1;
        整数 i = NDJSON流位;
        当 (i < NDJSON流行长)
         {
            如果 (NDJSON流行区[i] == '\n')
            {
                断 = i;
                跳出;
            }
            i = i + 1;
        }
        如果 (断 >= 0)
        {
            NDJSON流行起 = NDJSON流位;
            NDJSON流行止 = 断;
            NDJSON流位 = 断 + 1;
            NDJSON流去回车();
            返回 真;
        }
        如果 (NDJSON流位 > 0)
        {
            整数 k = 0;
            整数 j = NDJSON流位;
            当 (j < NDJSON流行长)
             {
                NDJSON流行区[k] = NDJSON流行区[j];
                k = k + 1;
                j = j + 1;
            }
            NDJSON流行长 = k;
            NDJSON流位 = 0;
        }
        如果 (NDJSON流读完 == 1)
        {
            如果 (NDJSON流行长 == 0)
            {
                返回 假;
            }
            NDJSON流行起 = 0;
            NDJSON流行止 = NDJSON流行长;
            NDJSON流位 = NDJSON流行长;
            NDJSON流去回车();
            返回 真;
        }
        整数 长 = 读一块(NDJSON流读句, NDJSON流块, 4096);
        如果 (长 <= 0)
        {
            NDJSON流读完 = 1;
            如果 (NDJSON流行长 == 0)
            {
                返回 假;
            }
            继续;
        }
        如果 (NDJSON流行长 + 长 >= 8192)
        {
            返回 假;
        }
        NDJSON流行区[NDJSON流行长] = 0;
        拼接到(NDJSON流行区, NDJSON流块);
        NDJSON流行长 = NDJSON流行长 + 长;
    }
    返回 假;
}
// 私有:去掉行尾的 `\r`
私有 方法 NDJSON流去回车()
{
    当 (NDJSON流行止 > NDJSON流行起 && NDJSON流行区[NDJSON流行止 - 1] == '\r')
    {
        NDJSON流行止 = NDJSON流行止 - 1;
    }
    返回
}

// 私有:把行区这一段搬进"当前这条原文"那一格
私有 方法 NDJSON流收进槽()
{
    NDJSON流行槽.清空();
    整数 i = NDJSON流行起;
    当 (i < NDJSON流行止)
     {
        拼接到(NDJSON流行槽, NDJSON流行区[i]);
        i = i + 1;
    }
    返回
}

// 私有:往行区尾巴上接一个码点的 UTF-8 字节(放不下给假)
私有 方法 NDJSON流行区加码点(整数 码) 返回 逻辑
{
    如果 (码 < 128)
    {
        如果 (NDJSON流行长 + 1 > 8192)
        {
            返回 假;
        }
        NDJSON流行区[NDJSON流行长] = 码;
        NDJSON流行长 = NDJSON流行长 + 1;
        返回 真;
    }
    如果 (码 < 2048)
    {
        如果 (NDJSON流行长 + 2 > 8192)
        {
            返回 假;
        }
        NDJSON流行区[NDJSON流行长] = 192 + 码 / 64;
        NDJSON流行区[NDJSON流行长 + 1] = 128 + 码 % 64;
        NDJSON流行长 = NDJSON流行长 + 2;
        返回 真;
    }
    如果 (码 < 65536)
    {
        如果 (NDJSON流行长 + 3 > 8192)
        {
            返回 假;
        }
        NDJSON流行区[NDJSON流行长] = 224 + 码 / 4096;
        NDJSON流行区[NDJSON流行长 + 1] = 128 + 码 / 64 % 64;
        NDJSON流行区[NDJSON流行长 + 2] = 128 + 码 % 64;
        NDJSON流行长 = NDJSON流行长 + 3;
        返回 真;
    }
    如果 (NDJSON流行长 + 4 > 8192)
    {
        返回 假;
    }
    NDJSON流行区[NDJSON流行长] = 240 + 码 / 262144;
    NDJSON流行区[NDJSON流行长 + 1] = 128 + 码 / 4096 % 64;
    NDJSON流行区[NDJSON流行长 + 2] = 128 + 码 / 64 % 64;
    NDJSON流行区[NDJSON流行长 + 3] = 128 + 码 % 64;
    NDJSON流行长 = NDJSON流行长 + 4;
    返回 真;
}

// 读下一条:空行跳过,解析不成的记一条接着走;到头给假、当前节点清零
方法 下一条() 返回 逻辑
{
    如果 (NDJSON流读句 < 0)
    {
        返回 假;
    }
    当 (真)
     {
        如果 (NDJSON流读一行() == 假)
        {
            NDJSON流当前 = 0;
            返回 假;
        }
        如果 (NDJSON流行止 == NDJSON流行起)
        {
            继续;                    // 空行不算一条
        }
        NDJSON流收进槽();
        NDJSON流当前 = JSON.解析(NDJSON流行槽);
        如果 (NDJSON流当前 == 0)
        {
            NDJSON流坏数 = NDJSON流坏数 + 1;
            继续;                    // 坏行跳过
        }
        返回 真;
    }
    返回 假;
}

// 刚读进来的那条解析出的根节点号(交给 `JSON.*`);下一条一到就作废
方法 当前() 返回 整数
{
    返回 NDJSON流当前;
}

// 把最近读到的那一行原文写进 `行`;还没读到或读到的是空行,给假并清空
方法 当前行(字符串 出 行) 返回 逻辑
{
    如果 (NDJSON流行止 == NDJSON流行起)
    {
        行 = "";
        返回 假;
    }
    行 = NDJSON流行槽;
    返回 真;
}

// 开读以来解析不成、被跳过的那几条的条数
方法 坏几条() 返回 整数
{
    返回 NDJSON流坏数;
}

// ============================================================
// 2、写
// ============================================================

// 打开 `路径` 的写流(先关掉旧的);打不开给假,目录不会替你建
方法 开写(字符串 路径) 返回 逻辑
{
    如果 (NDJSON流写句 >= 0)
    {
        逻辑 先关 = 关写();
    }
    NDJSON流写槽 = "";
    整数 句 = 0;
    如果 (打开写流(路径, 句) == 假)
    {
        NDJSON流写句 = 0 - 1;
        返回 假;
    }
    NDJSON流写句 = 句;
    返回 真;
}

// 关掉写流(先落盘)
方法 关写() 返回 逻辑
{
    如果 (NDJSON流写句 < 0)
    {
        返回 真;
    }
    整数 状 = 关写流(NDJSON流写句);
    NDJSON流写句 = 0 - 1;
    返回 状 == 0;
}

// 把节点生成一行 JSON 落到写流(末尾补换行);没开着或生成不成给假
方法 写一条(整数 节点) 返回 逻辑
{
    如果 (NDJSON流写句 < 0)
    {
        返回 假;
    }
    如果 (JSON.生成到(节点, NDJSON流写槽) == 假)
    {
        返回 假;
    }
    拼接到(NDJSON流写槽, "\n");
    整数 写掉 = 写一块(NDJSON流写句, NDJSON流写槽, 0);
    NDJSON流写槽.清空();
    返回 写掉 >= 0;
}

// 把一段现成文本当一行写出(不做转义,内容自己保证是合法 JSON);没开着给假
方法 写文本(字符串 文本) 返回 逻辑
{
    如果 (NDJSON流写句 < 0)
    {
        返回 假;
    }
    NDJSON流写槽.清空();
    拼接到(NDJSON流写槽, 文本);
    拼接到(NDJSON流写槽, "\n");
    整数 写掉 = 写一块(NDJSON流写句, NDJSON流写槽, 0);
    NDJSON流写槽.清空();
    返回 写掉 >= 0;
}
