// ============================================================
// 数组.hb —— 定长数组算法库(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 调用写 `数组.反转(表)`
// 用法:
// ```
// 包含 "../库/数组.hb";
// ```
//
// 治的是每个程序都要手写一遍的那些动作(数一数有几个 / 倒过来 / 去掉重复 / 切一段 / 填充 / 取集合)。语言给数组的只有“取元素 / 改元素 / `.长度()`”,没有“整表搬一段”这种写法 ⇒ 这些函数一律**自己走下标循环**。
//
// 口径(2026-10;每条都对着实测写):
//   · **一律 32 位有符号 `整数`**:与语言内建的 `整数` 同一档;求和这一类会溢出的函数不在本库
//     (那是 `统计.hb` 的事,它按 64 位累加),本库只做"搬 / 比 / 数",不产生新的数。
//   · **只收定长数组**(`整数 表[10]` 这种):动态**列表**(`整数 表[]`)传不进来 ——
//     报"列表的地址不能取"(与 `排序.hb` / `查找.hb` / `测试助手.hb` 同一条语言面边界)。
//     列表那一半见 `列表.hb`(**也不收列表形参**,原因与做法写在那边的头注释里)。
//   · **就地改 / 往外出,两条路分清**:
//     `反转 / 交换 / 平移 / 填充 / 按位取反` **就地改**调用方那张表(传的是地址,没有副本);
//     `段拷 / 去重 / 造并集 / 造交集 / 造差集 / 合并 / 找全部 / 累计和` **往**另一张表**写**,
//     返回值是**写出去几个**。
//   · **容量不够不报错**:**能写几个写几个**,返回值就是实际写出去的那个个数(调用方自己比对)。
//     这一条是全库统一的 —— 没有一个函数会因为"目标表小了"而停机。
//   · **越界下标一律夹回合法范围**:`段拷(表, 起, 个数, 出去)` 里 `起` 是负的当 0、
//     超过表长就当"这一趟没有可拷的" ⇒ 返回 0(不崩、不停机,与 `查找.hb` 一个规矩)。
//   · **去重 / 集合那一族出来的表是升序的**(不是"原来的先后"):去重要先复制一份再排
//     (不然会打乱调用方的表),排完从前往后扫,相同的只留第一个。要"保持原有先后"的调用方
//     自己另想办法(语言里没有哈希表内建,那件事要 `map.hb` 配合,不在本库)。
//   · **`合并` 要求两张输入表各已升序**(先用 `排序.整数升序(表)`),这一库不替调用方检查 ——
//     没序也不会报错,只是结果不是有序表(如实登记,不静默排一遍:那是 O(n log n) 的额外开销)。
//   · **空表 / 单元素表**都给结果:个数 0 的段拷给 0、长度 1 的表反转后还是它自己。
//   · **本库不可重入**:去重 / 集合那一族借的是模块里两张 256 格的草稿纸(语言里"局部数组"
//     也要占帧,96 字节的帧装不下 256 格)⇒ 同一时刻只能有一个 `数组.*` 在算。
//     单线程程序不受影响;别把"本库函数的调用"套进另一个"本库函数的实参"里
//     (那会让里层把外层的草稿纸盖掉 —— 本库没有一处这么写,示例与自检也没有)。
//
// 提供的函数(17 个):逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:计数 / 包含 / 下标 / 是相同 / 填充 / 累计和 / 段拷 / 找全部 O(表长);
//   反转 O(表长)(每个元素挪一次);交换 O(1);平移 O(表长);按位取反 O(段长);
//   去重 / 造并集 / 造交集 / 造差集 O(n²)(临时表上那一趟插入排序是 `排序.hb` 的同一套写法:
//   实现短、稳定、小表最快;上万条的表别用这一族);合并 O(表左 + 表右)(两边都已有序)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **不下标越界**:所有下标参数先夹回合法范围,越界给"什么都没做"而不是停程序;
//   · **目标表小了就只写一部分**(见上面口径),调用方要的是"有没有写全"就看返回值;
//   · **草稿纸 256 格**:去重 / 集合那一族只看前 256 个元素(返回值会如实小于表长);
//     要处理更长的表请分段调用 —— "定长数组不能动态要临时表"的直接后果,不是漏做;
//   · **`合并` 不检查两表是否有序**(要真有序先自己排;有序性检查是 `查找.是升序`);
//   · **不做"整表赋值"**:语言里数组不能整块赋值,本库的"拷"一律是逐元素循环;
//   · **不做排序 / 查找 / 求和**:前两件在 `排序.hb` / `查找.hb`,求和那一族在 `统计.hb`。
// ============================================================
模块 数组

// ---------- 模块级草稿纸(局部数组占帧,256 格 = 1024 字节,96 字节的帧装不下) ----------
//   `左纸` / `右纸` 分别是集合运算的两侧,**不许把同一个模块级数组同时当实参与本库的目标**。
私有 整数 左纸[256];
私有 整数 右纸[256];
私有 整数 平移纸[256];
私有 整数 草稿格数 = 256;

// ---------- 私有:把 `值` 压进 [0, 上界];给所有"下标 / 个数"参数当护栏 ----------
私有 方法 数组夹回(整数 值, 整数 上界) 返回 整数
{
    如果 (值 < 0)
    {
        返回 0;
    }
    如果 (值 > 上界)
    {
        返回 上界;
    }
    返回 值;
}

// ---------- 私有:把 `来源` 的前 `几个` 个元素拷进 `去向` ----------
私有 方法 数组搬一段(整数 来源[], 整数 去向[], 整数 几个)
{
    整数 i = 0;
    当 (i < 几个)
    {
        去向[i] = 来源[i];
        i = i + 1;
    }
}

// ---------- 私有:插入排序(带个数参数的那一份 —— `排序.整数升序` 只认整表,草稿纸要按段排) ----------
私有 方法 数组排一段(整数 表[], 整数 有效个数)
{
    整数 i = 1;
    当 (i < 有效个数)
    {
        整数 值 = 表[i];
        整数 j = i;
        当 (j > 0 && 表[j - 1] > 值)
        {
            表[j] = 表[j - 1];
            j = j - 1;
        }
        表[j] = 值;
        i = i + 1;
    }
}

// ---------- 私有:两个表里较小的那个长度(配对遍历用) ----------
私有 方法 数组较短的那份(整数 表左[], 整数 表右[]) 返回 整数
{
    如果 (表左.长度() < 表右.长度())
    {
        返回 表左.长度();
    }
    返回 表右.长度();
}

// ---------- 私有:升序表里有几个不同的值 ----------
私有 方法 数组数不同(整数 表[], 整数 有效个数) 返回 整数
{
    如果 (有效个数 <= 0)
    {
        返回 0;
    }
    整数 不同 = 1;
    整数 i = 1;
    当 (i < 有效个数)
    {
        如果 (表[i] != 表[i - 1])
        {
            不同 = 不同 + 1;
        }
        i = i + 1;
    }
    返回 不同;
}

// ---------- 私有:把升序表里每个值的第一个写出去(返回写了几个) ----------
私有 方法 数组写不同(整数 表[], 整数 有效个数, 整数 出去[]) 返回 整数
{
    如果 (有效个数 <= 0 || 出去.长度() <= 0)
    {
        返回 0;
    }
    整数 可写 = 出去.长度();
    出去[0] = 表[0];
    整数 写了 = 1;
    整数 i = 1;
    当 (i < 有效个数)
    {
        如果 (表[i] != 表[i - 1])
        {
            如果 (写了 >= 可写)
            {
                返回 写了;
            }
            出去[写了] = 表[i];
            写了 = 写了 + 1;
        }
        i = i + 1;
    }
    返回 写了;
}

// ---------- 私有:两张升序表归并(每个值只出一份);返回写了几个 ----------
私有 方法 数组归并去重(整数 左表[], 整数 左个数, 整数 右表[], 整数 右个数, 整数 出去[]) 返回 整数
{
    整数 可写 = 出去.长度();
    整数 写了 = 0;
    整数 i = 0;
    整数 j = 0;
    当 (i < 左个数 || j < 右个数)
    {
        如果 (写了 >= 可写)
        {
            返回 写了;
        }
        整数 落 = 0;
        如果 (i >= 左个数)
        {
            落 = 右表[j];
            j = j + 1;
        }
        否则 如果 (j >= 右个数)
        {
            落 = 左表[i];
            i = i + 1;
        }
        否则 如果 (左表[i] <= 右表[j])
        {
            落 = 左表[i];
            i = i + 1;
        }
        否则
        {
            落 = 右表[j];
            j = j + 1;
        }
        如果 (写了 == 0 || 出去[写了 - 1] != 落)
        {
            出去[写了] = 落;
            写了 = 写了 + 1;
        }
    }
    返回 写了;
}

// ---------- 私有:两张升序表取共同值;返回写了几个 ----------
私有 方法 数组归并取共(整数 左表[], 整数 左个数, 整数 右表[], 整数 右个数, 整数 出去[]) 返回 整数
{
    整数 可写 = 出去.长度();
    整数 写了 = 0;
    整数 i = 0;
    整数 j = 0;
    当 (i < 左个数 && j < 右个数)
    {
        如果 (左表[i] == 右表[j])
        {
            如果 (写了 < 可写)
            {
                出去[写了] = 左表[i];
                写了 = 写了 + 1;
            }
            i = i + 1;
            j = j + 1;
        }
        否则 如果 (左表[i] < 右表[j])
        {
            i = i + 1;
        }
        否则
        {
            j = j + 1;
        }
    }
    返回 写了;
}

// ---------- 私有:在左不在右(两边都已升序去重);返回写了几个 ----------
私有 方法 数组归并取差(整数 左表[], 整数 左个数, 整数 右表[], 整数 右个数, 整数 出去[]) 返回 整数
{
    整数 可写 = 出去.长度();
    整数 写了 = 0;
    整数 i = 0;
    整数 j = 0;
    当 (i < 左个数)
    {
        如果 (j >= 右个数 || 左表[i] < 右表[j])
        {
            如果 (写了 < 可写)
            {
                出去[写了] = 左表[i];
                写了 = 写了 + 1;
            }
            i = i + 1;
        }
        否则 如果 (左表[i] == 右表[j])
        {
            i = i + 1;
        }
        否则
        {
            j = j + 1;
        }
    }
    返回 写了;
}

// ============================================================
// 1、数一数 / 找位置(只读,不改表)
// ============================================================

// 数出 `值` 在表里出现几次;空表给 0,整表都数(不受 256 格限制)
方法 计数(整数 表[], 整数 值) 返回 整数
{
    整数 次数 = 0;
    整数 i = 0;
    当 (i < 表.长度())
    {
        如果 (表[i] == 值)
        {
            次数 = 次数 + 1;
        }
        i = i + 1;
    }
    返回 次数;
}

// 找第一个等于 `值` 的格号;一个都没有给 -1(不是 0)
方法 下标(整数 表[], 整数 值) 返回 整数
{
    整数 i = 0;
    当 (i < 表.长度())
    {
        如果 (表[i] == 值)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// 问表里有没有 `值`:有给真、没有给假(内部看 `下标` 是否非负)
方法 包含(整数 表[], 整数 值) 返回 逻辑
{
    返回 下标(表, 值) >= 0;
}

// 把 `值` 出现的每个格号依次写进 `出去`;返回写了几个,写满就停
方法 找全部(整数 表[], 整数 值, 整数 出去[]) 返回 整数
{
    整数 全部 = 表.长度();
    整数 可写 = 出去.长度();
    整数 写了 = 0;
    整数 i = 0;
    当 (i < 全部)
    {
        如果 (表[i] == 值)
        {
            如果 (写了 >= 可写)
            {
                返回 写了;
            }
            出去[写了] = i;
            写了 = 写了 + 1;
        }
        i = i + 1;
    }
    返回 写了;
}

// ============================================================
// 2、就地改(传的是地址,改的就是调用方那张表)
// ============================================================

// 就地把整表首尾对调(第 0 格与最后一格换);空表和单格表原样不动
方法 反转(整数 表[])
{
    整数 全部 = 表.长度();
    整数 左 = 0;
    整数 右 = 全部 - 1;
    当 (左 < 右)
    {
        整数 暂 = 表[左];
        表[左] = 表[右];
        表[右] = 暂;
        左 = 左 + 1;
        右 = 右 - 1;
    }
}

// 就地对调 `左` `右` 两格;任一下标越界或两下标相同都直接返回
方法 交换(整数 表[], 整数 左, 整数 右)
{
    整数 全部 = 表.长度();
    如果 (左 < 0 || 左 >= 全部 || 右 < 0 || 右 >= 全部)
    {
        返回
    }
    如果 (左 == 右)
    {
        返回
    }
    整数 暂 = 表[左];
    表[左] = 表[右];
    表[右] = 暂;
}

// 循环平移:`左移几个` 是正数就往左挪那么多(左边出去的从右边绕回来),负数就往右挪。
// 就地循环左移 `左移几个` 格(负数右移);多于 256 格只挪前 256 格
方法 平移(整数 表[], 整数 左移几个)
{
    整数 全部 = 表.长度();
    如果 (全部 <= 1)
    {
        返回
    }
    整数 移位量 = 左移几个 % 全部;
    如果 (移位量 < 0)
    {
        移位量 = 移位量 + 全部;
    }
    如果 (移位量 == 0)
    {
        返回
    }
    整数 几个 = 全部;
    如果 (几个 > 草稿格数)
    {
        几个 = 草稿格数;
    }
    数组搬一段(表, 平移纸, 几个);
    整数 i = 0;
    当 (i < 几个)
    {
        整数 来源 = i + 移位量;
        如果 (来源 >= 几个)
        {
            来源 = 来源 - 几个;
        }
        表[i] = 平移纸[来源];
        i = i + 1;
    }
}

// 就地把每一格都改成 `值`;返回一共填了几格(空表给 0)
方法 填充(整数 表[], 整数 值) 返回 整数
{
    整数 全部 = 表.长度();
    整数 i = 0;
    当 (i < 全部)
    {
        表[i] = 值;
        i = i + 1;
    }
    返回 全部;
}

// 就地把 `起点` 起 `个数` 格逐格按位取反(`~`);越出表尾的自动截掉
方法 按位取反(整数 表[], 整数 起点, 整数 个数)
{
    整数 表长 = 表.长度();
    如果 (个数 <= 0)
    {
        返回
    }
    整数 开始 = 数组夹回(起点, 表长);
    整数 止 = 开始 + 个数;
    如果 (止 > 表长)
    {
        止 = 表长;
    }
    整数 i = 开始;
    当 (i < 止)
    {
        表[i] = ~表[i];
        i = i + 1;
    }
}

// ============================================================
// 3、往另一张表写(返回值 = 实际写出去几个)
// ============================================================

// 从 `起` 拷 `个数` 格到 `出去`;返回实际拷了几个,`起` 越界给 0
方法 段拷(整数 表[], 整数 起, 整数 个数, 整数 出去[]) 返回 整数
{
    整数 表长 = 表.长度();
    如果 (个数 <= 0)
    {
        返回 0;
    }
    整数 开始 = 数组夹回(起, 表长);
    如果 (开始 >= 表长)
    {
        返回 0;
    }
    整数 可拷 = 表长 - 开始;
    如果 (个数 < 可拷)
    {
        可拷 = 个数;
    }
    如果 (可拷 > 出去.长度())
    {
        可拷 = 出去.长度();
    }
    如果 (可拷 > 表长)
    {
        可拷 = 表长;                           // 双保险:可拷恒不超过来源表长
    }
    整数 i = 0;
    当 (i < 可拷)
    {
        出去[i] = 表[开始 + i];
        i = i + 1;
    }
    返回 可拷;
}

// 前缀和(`出去[i]` = 表[0] + … + 表[i]);取两表较短的长度
方法 累计和(整数 表[], 整数 出去[]) 返回 整数
{
    整数 全部 = 数组较短的那份(表, 出去);
    整数 累计 = 0;
    整数 i = 0;
    当 (i < 全部)
    {
        累计 = 累计 + 表[i];
        出去[i] = 累计;
        i = i + 1;
    }
    返回 全部;
}

// 相同的值只留一个,按升序写进 `出去`;返回写了几个,只看前 256 格
方法 去重(整数 表[], 整数 出去[]) 返回 整数
{
    整数 有效 = 表.长度();
    如果 (有效 <= 0)
    {
        返回 0;
    }
    如果 (有效 > 草稿格数)
    {
        有效 = 草稿格数;
    }
    数组搬一段(表, 左纸, 有效);
    数组排一段(左纸, 有效);
    返回 数组写不同(左纸, 有效, 出去);
}

// 两张表合起来的全部不同值升序写进 `出去`;各取前 256 格,返回写了几个
方法 造并集(整数 表左[], 整数 表右[], 整数 出去[]) 返回 整数
{
    整数 左张数 = 表左.长度();
    如果 (左张数 > 草稿格数)
    {
        左张数 = 草稿格数;
    }
    整数 右张数 = 表右.长度();
    如果 (右张数 > 草稿格数)
    {
        右张数 = 草稿格数;
    }
    数组搬一段(表左, 左纸, 左张数);
    数组搬一段(表右, 右纸, 右张数);
    数组排一段(左纸, 左张数);
    数组排一段(右纸, 右张数);
    返回 数组归并去重(左纸, 左张数, 右纸, 右张数, 出去);
}

// 两张表都有的值升序写进 `出去`;各取前 256 格,没有共同值给 0
方法 造交集(整数 表左[], 整数 表右[], 整数 出去[]) 返回 整数
{
    整数 左张数 = 表左.长度();
    如果 (左张数 > 草稿格数)
    {
        左张数 = 草稿格数;
    }
    整数 右张数 = 表右.长度();
    如果 (右张数 > 草稿格数)
    {
        右张数 = 草稿格数;
    }
    数组搬一段(表左, 左纸, 左张数);
    数组搬一段(表右, 右纸, 右张数);
    数组排一段(左纸, 左张数);
    数组排一段(右纸, 右张数);
    整数 左个数 = 数组数不同(左纸, 左张数);
    整数 右个数 = 数组数不同(右纸, 右张数);
    返回 数组归并取共(左纸, 左个数, 右纸, 右个数, 出去);
}

// 只在 `表左` 有、`表右` 没有的值升序写进 `出去`;各取前 256 格
方法 造差集(整数 表左[], 整数 表右[], 整数 出去[]) 返回 整数
{
    整数 左张数 = 表左.长度();
    如果 (左张数 > 草稿格数)
    {
        左张数 = 草稿格数;
    }
    整数 右张数 = 表右.长度();
    如果 (右张数 > 草稿格数)
    {
        右张数 = 草稿格数;
    }
    数组搬一段(表左, 左纸, 左张数);
    数组搬一段(表右, 右纸, 右张数);
    数组排一段(左纸, 左张数);
    数组排一段(右纸, 右张数);
    整数 左个数 = 数组数不同(左纸, 左张数);
    整数 右个数 = 数组数不同(右纸, 右张数);
    返回 数组归并取差(左纸, 左个数, 右纸, 右个数, 出去);
}

// 归并两张**已升序**的表(重复的照样各出一份 —— 这是"归并"不是"并集")。
// 做法与 `去重` / 集合那一族同一条:**两张表并排摊进草稿纸,数组排一段**,再整段写出去。
// 为什么不写成"双指针一路比大小"那套教科书归并:同一张草稿纸 + 同一趟排序,
// 把两张已升序的表归并写进 `出去`;重复值各出一份,不查有序性,合看前 256 格
方法 合并(整数 表左[], 整数 表右[], 整数 出去[]) 返回 整数
{
    整数 左张数 = 表左.长度();
    如果 (左张数 > 草稿格数)
    {
        左张数 = 草稿格数;
    }
    整数 右张数 = 表右.长度();
    如果 (右张数 + 左张数 > 草稿格数)
    {
        右张数 = 草稿格数 - 左张数;
    }
    整数 可写 = 出去.长度();
    数组搬一段(表左, 左纸, 左张数);
    数组搬一段(表右, 右纸, 右张数);
    整数 i = 0;
    当 (i < 右张数)
    {
        左纸[左张数 + i] = 右纸[i];
        i = i + 1;
    }
    整数 共 = 左张数 + 右张数;
    数组排一段(左纸, 共);
    如果 (共 > 可写)
    {
        共 = 可写;
    }
    数组搬一段(左纸, 出去, 共);
    返回 共;
}

// 逐格比对两张表是否完全一样(格数也要一样);两张空表算相同
方法 是相同(整数 表左[], 整数 表右[]) 返回 逻辑
{
    整数 左长 = 表左.长度();
    如果 (左长 != 表右.长度())
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 左长)
    {
        如果 (表左[i] != 表右[i])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}
