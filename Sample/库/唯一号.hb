// ============================================================
// 唯一号.hb —— 不重复的号 / 会话号(依赖 `时间.hb` + `随机.hb`)
//
// 用法:包含 "../库/唯一号.hb";`字符串 号 = 唯一号.唯一号()` —— 例如 `68f3a1c2-4b7d90e1-0012ab34-00000001`。
//
// 口径(2026-10):
//   · **32 个小写十六进制字符,中间三个减号**(`8-8-8-8`,总共 35 个字符):四段依次是**当前秒 / 随机数 / 开机毫秒 / 计数**;
//   · **计数是本库自己的(从 1 起)**:同一秒里连着要几个号靠它区分 ⇒ **同一进程里连要两次一定不同**;
//   · **`短号` 是 32 位那一档**(时间戳 异或 随机 异或 计数):给"短、能进整数表"的场合用,不是"全球唯一";
//   · **`是唯一号` 只认自己这一版格式**(`8-8-8-8`、全小写十六进制),不是"通用 UUID 校验";
//   · **号里没有机器标识**:换一台机器、同一秒、同一个随机种子,**号可能撞** ——
//     要跨机器不撞就得自己再加一段(工程名 / 用户名);
//   · **随机走 `随机.hb` 那一条确定性的流**(xorshift32)⇒ 要"不可预测"就得自己先换种子。
//
// 英文对照:唯一号 uniqueId · 带前缀 withPrefix · 短号 shortId · 计数 count · 清零 resetCount · 是唯一号 isUniqueId
//
// 复杂度:O(1)(四段各一次取数 + 8 轮十六进制);`是唯一号` O(字符数)(最多 35 个字)。
//
// 边界(如实登记):
//   · **不是密码学随机** ⇒ 别拿它当令牌 / 口令用;**一秒之内最多 2^32 个号**(实际上远到不了);
// 内存账:**每一号都新造一条 35 字符的串** ⇒ **长循环里反复取号会一路吃池**;
//   · **不写盘**:没有目录锁 / 没有 PID 文件(要跨进程不撞,自己加一段进程标识)。
// 提供的函数(6 个):逐个见下面那张公开方法表。
// ============================================================
模块 唯一号

包含 "时间.hb"
包含 "随机.hb"

// 本库自己的发号计数(从 0 起)
私有 无符号整数 唯一号计数 = 0;

// 私有:0~15 → 一个小写十六进制字符
私有 方法 唯一号位符(整数 位) 返回 字符
{
    如果 (位 < 10)
    {
        返回 48 + 位;
    }
    返回 97 + (位 - 10);
}

// 私有:一个 32 位数 → 8 个小写十六进制字符
私有 方法 唯一号十六(无符号整数 数) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 7;
    当 (i >= 0)
    {
        字符 位字 = 唯一号位符((数 >> (i * 4)) & 15);
        拼接到(结果, 位字);
        i = i - 1;
    }
    返回 结果;
}

// 私有:一个文字是不是小写十六进制
私有 方法 唯一号是十六位(文字 某字) 返回 逻辑
{
    整数 码 = 某字;
    如果 (码 >= 48 && 码 <= 57)
    {
        返回 真;
    }
    如果 (码 >= 97 && 码 <= 102)
    {
        返回 真;
    }
    返回 假;
}

// ============================================================
// 1、取号
// ============================================================

// 一个新的唯一号(35 个字符:`8-8-8-8` 小写十六进制;四段 = 当前秒 / 随机 / 开机毫秒 / 计数)。
方法 唯一号() 返回 字符串
{
    唯一号计数 = 唯一号计数 + 1;
    字符串 结果 = "";
    字符串 段 = 唯一号十六(时间.现在秒());
    拼接到(结果, 段);
    拼接到(结果, "-");
    段 = 唯一号十六(随机.下一个());
    拼接到(结果, 段);
    拼接到(结果, "-");
    段 = 唯一号十六(时间.开机毫秒());
    拼接到(结果, 段);
    拼接到(结果, "-");
    段 = 唯一号十六(唯一号计数);
    拼接到(结果, 段);
    返回 结果;
}

// 前缀 + "-" + 唯一号(给文件名 / 键名用)。
方法 带前缀(字符串 前缀) 返回 字符串
{
    字符串 尾 = 唯一号();
    字符串 结果 = "";
    拼接到(结果, 前缀);
    拼接到(结果, "-");
    拼接到(结果, 尾);
    返回 结果;
}

// 32 位那一档(短号):时间戳 异或 随机 异或 计数。
方法 短号() 返回 无符号整数
{
    唯一号计数 = 唯一号计数 + 1;
    无符号整数 值 = 时间.现在秒();
    值 = 值 ^ 随机.下一个();
    值 = 值 ^ 唯一号计数;
    值 = 值 ^ 时间.开机毫秒();
    返回 值;
}

// 本库已经发过几个号(从 0 起)。
方法 计数() 返回 无符号整数
{
    返回 唯一号计数;
}

// 计数归零(下一号从 1 再起;没有返回值,单独成句用)。
方法 清零()
{
    唯一号计数 = 0;
    返回
}

// ============================================================
// 2、看一眼格式
// ============================================================

// 这一条是不是本库那种格式(`8-8-8-8`,全小写十六进制)。
方法 是唯一号(字符串 文本) 返回 逻辑
{
    如果 (文本.长度() != 35)
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 35)
    {
        文字 某字 = 文本[i];
        如果 (i == 8 || i == 17 || i == 26)
        {
            如果 (某字 != 45)
            {
                返回 假;
            }
        }
        否则
        {
            如果 (唯一号是十六位(某字) == 假)
            {
                返回 假;
            }
        }
        i = i + 1;
    }
    返回 真;
}
