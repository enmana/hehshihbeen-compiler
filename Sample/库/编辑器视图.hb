// ============================================================
// 编辑器视图.hb —— **把编辑缓冲画出来**(纯 HB 库:不动 ISA、不动关键字、不动机器码)
//
// 用法:
// ```
// 包含 "../库/编辑器.hb";
// 包含 "../库/编辑器视图.hb";
//
// 编辑器.编辑缓冲 编;
// 编辑器.建编辑器(编, 20);
// 编辑器视图.面板 屏;
// 编辑器视图.建面板(屏, 12, 12, 600, 20, 52, 20);   // 左 / 上 / 宽 / 高 / 行号栏宽 / 行高
// ...
// 编辑器视图.画一屏(屏, 编);                        // 发这一帧的绘制命令,回来的是条数
// ```
//
// 治的是**"这一份缓冲在这一块地方长什么样"**:按可视区裁剪行、行号栏(右对齐)、当前行底色、
// 光标方块、滚动条、以及"长行往右移"那一格 —— 全在这一库。**它不开窗、不清屏、不 `刷新()`**
// (那是主循环的事):`画一屏` 只发"内容"那一批命令,回来的是**发了几条**。
//
// 口径(每条都对着实测写):
//   · **列宽按"格"算,不按像素也不按字节**:一格 = `每格宽` 像素;一个 ASCII 字一格、一个中文两格
//     (`取文字宽度`,与窗口画字那张表同一条)。所以光标方块落在 `左 + 文本左 + 光标格 × 每格宽`;
//   · **行号栏宽度由调用方给**,行号**右对齐**排在栏里(位数多了自动靠左挤);
//   · **裁剪**:只画 `可视首行` 起 `可视行数` 行;行里的字超出面板右边**不画**(整条 `画文字` 不发),
//     不是"画出去让它被裁" —— 省命令,也让无头那一路的输出干净;
//   · **光标**:当前行底色 + 一个竖着的方块(宽 = `每格宽`,高 = `行高 - 4`)。光标停在行尾(列 = 行字数)时,
//     方块照落在"最后一个字右边那一格"—— 与真编辑器一样;
//   · **滚动条**:`行数 <= 可视行数` 不画;**滑块高度按比例**、最少 8 像素;滑块位置按 `可视首行`;
//   · **`水平偏移`**:长行往右移几格(4-3 / 4-4 的水平滚动用它);移过头(整行都在左边看不见)就什么都不画;
//   · **不报错、不停机**:行号越界给空串,面板宽高给 0 / 负数就当"这条不画"。
//
// 提供的函数(11 个):逐条的作用见每个函数紧上面那行注释。
//
// 英文对照:**没有英文别名**(与现有几个库同一口径)。
//
// 复杂度:`画一屏` 是 O(可视行数 × 行长)(每一行都要按格累到面板右边为止);
//   空间:不申请堆,只造每条 `画文字` / `画线` 那点参数(池串)。
//
// 边界(如实登记):
//   · **不画"选中区"**(选区那一档归 4-2 之后:选区的两端要鼠标联动,先由主循环定下来再给本库);
//   · **行号栏不画分隔线**(要就自己 `画线`;本库只画内容那一批,免得命令表里混进装饰);
//   · **`水平偏移` 的单位是"格"**,不是像素 —— 与列号同一口径(不然中文行会越滚越歪)。
// ============================================================

模块 编辑器视图

// 一块"编辑器面板"的样子:落在哪、行号栏多宽、一行多高、一屏几行,外加一套配色
结构 面板
{
    整数 左;             // 面板左上角(x)
    整数 上;             // 面板左上角(y)
    整数 宽;             // 面板一共多宽(含行号栏)
    整数 高;             // 面板一共多高
    整数 行号栏宽;       // 左边这一条留给行号(像素)
    整数 行高;           // 一行多高(像素)
    整数 每格宽;         // 一"格"多宽(ASCII 一格 / 中文两格)
    整数 文字左留白;     // 正文区左边留几像素
    整数 可视行数;       // 一屏画得下几行(与 `编辑器.可视行数` 同一个数)
    整数 水平偏移;       // 长行往右移几"格"(0 = 不移)
    整数 帧;             // 画过几屏(调用方看节拍用)
    整数 命令数;         // 上一屏发了几条绘制命令
    整数 底色;           // 整块面板的底
    整数 当前行底;       // 光标那一行的底色
    整数 文字色;         // 正文
    整数 行号色;         // 行号栏
    整数 光标色;         // 光标方块
    整数 滚动条槽;       // 滚动条槽的颜色
    整数 滚动条块;       // 滚动条滑块的颜色
}

// 建一块面板(配色用库内写死的那一套;要换色就改那八个字段)
方法 建面板(编辑器视图.面板 屏, 整数 左, 整数 上, 整数 宽, 整数 高, 整数 行号栏宽, 整数 行高)
{
    屏.左 = 左;
    屏.上 = 上;
    屏.宽 = 宽;
    屏.高 = 高;
    屏.行号栏宽 = 行号栏宽;
    屏.行高 = 行高;
    屏.每格宽 = 8;
    屏.文字左留白 = 6;
    屏.可视行数 = 编辑器视图_算行数(屏);
    屏.水平偏移 = 0;
    屏.帧 = 0;
    屏.命令数 = 0;
    屏.底色 = 0xFF14141C;
    屏.当前行底 = 0xFF23233A;
    屏.文字色 = 0xFFE8E8F0;
    屏.行号色 = 0xFF6A6A80;
    屏.光标色 = 0xFF2A6EF0;
    屏.滚动条槽 = 0xFF1C1C26;
    屏.滚动条块 = 0xFF3A3A55;
    返回
}

// 正文区左边界(行号栏右边)
方法 正文左(编辑器视图.面板 屏) 返回 整数
{
    返回 屏.左 + 屏.行号栏宽 + 屏.文字左留白;
}

// 正文区宽度(面板右边减掉行号栏 / 左右留白 / **滚动条那一条** —— 长行不许钻到滚动条底下;实测踩过)
方法 正文宽(编辑器视图.面板 屏) 返回 整数
{
    整数 宽 = 屏.宽 - 屏.行号栏宽 - 屏.文字左留白 - 编辑器视图_滚动条宽();
    如果 (宽 < 0)
    {
        返回 0;
    }
    返回 宽;
}

// 一屏画得下几行(由面板高度与行高算;不足一行算一行)
方法 一屏行数(编辑器视图.面板 屏) 返回 整数
{
    返回 编辑器视图_算行数(屏);
}

// 面板高 / 行高 → 一屏几行(行高给 0 / 负数按 1 算)
方法 编辑器视图_算行数(编辑器视图.面板 屏) 返回 整数
{
    整数 高 = 屏.行高;
    如果 (高 < 1)
    {
        高 = 1;
    }
    整数 行数 = 屏.高 / 高;
    如果 (行数 < 1)
     {
        返回 1;
     }
    返回 行数;
}

// 滚动条槽 / 滑块一共占几像素(面板右边那一条)
方法 编辑器视图_滚动条宽() 返回 整数
{
    返回 8;
}

// 画一屏:整块底色 + 一条一条行,再把光标与滚动条叠上去;返回**这一屏发了几条命令**
方法 画一屏(编辑器视图.面板 屏, 编辑器.编辑缓冲 编) 返回 整数
{
    整数 条 = 0;
    如果 (屏.宽 <= 0 || 屏.高 <= 0)
    {
        屏.命令数 = 0;
        返回 0;
    }
    编辑器.设可视行数(编, 编辑器视图_算行数(屏));      // 视口与面板对齐(滚屏那头要这个数)
    画矩形(屏.左, 屏.上, 屏.宽, 屏.高, 屏.底色);
    条 = 条 + 1;
    条 = 条 + 编辑器视图_画行(屏, 编);
    条 = 条 + 编辑器视图_画光标(屏, 编);
    条 = 条 + 编辑器视图_画滚动条(屏, 编);
    屏.命令数 = 条;
    屏.帧 = 屏.帧 + 1;
    返回 条;
}

// ---------------- 私有:一小段工具 ----------------

// 取第 `下标` 个字(越界给空串;写成函数是为了"函数结果不能直接点字段"那条规矩不挡路)
方法 编辑器视图_一字(字符串 文本, 整数 下标) 返回 字符串
{
    如果 (下标 < 0 || 下标 >= 文本.长度())
    {
        返回 "";
    }
    字符串 结果;
    拼接到(结果, 文本[下标]);
    返回 结果;
}

// 0~9 → 那个数字的字
方法 编辑器视图_数字字(整数 位) 返回 字符串
{
    如果 (位 == 0)
    {
        返回 "0";
    }
    如果 (位 == 1)
    {
        返回 "1";
    }
    如果 (位 == 2)
    {
        返回 "2";
    }
    如果 (位 == 3)
    {
        返回 "3";
    }
    如果 (位 == 4)
    {
        返回 "4";
    }
    如果 (位 == 5)
    {
        返回 "5";
    }
    如果 (位 == 6)
    {
        返回 "6";
    }
    如果 (位 == 7)
    {
        返回 "7";
    }
    如果 (位 == 8)
    {
        返回 "8";
    }
    返回 "9";
}

// 非负整数 → 文本(行号要用;本库自带一份,不引 `string.hb`)
方法 编辑器视图_整数文本(整数 值) 返回 字符串
{
    如果 (值 == 0)
    {
        返回 "0";
    }
    字符串 倒;
    整数 n = 值;
    当 (n > 0)
     {
        拼接到(倒, 编辑器视图_数字字(n % 10));
        n = n / 10;
    }
    字符串 结果;
    整数 i = 倒.长度() - 1;
    当 (i >= 0)
     {
        拼接到(结果, 编辑器视图_一字(倒, i));
        i = i - 1;
    }
    返回 结果;
}

// 从 `水平偏移` 那一**格**起、最多画到正文区右边那么多格 —— 返回能画的那一段字
// (超出右边的整条不画;一个字会把右边顶出去就**停在它前面**,不切半个)
方法 编辑器视图_可见段(编辑器视图.面板 屏, 字符串 行) 返回 字符串
{
    字符串 结果 = "";
    整数 总 = 行.长度();
    整数 起 = 屏.水平偏移;
    如果 (起 >= 总)
    {
        返回 结果;
    }
    整数 最多格 = 正文宽(屏) / 屏.每格宽;
    整数 用了 = 0;
    整数 i = 起;
    当 (i < 总)
     {
        字符串 一字 = 编辑器视图_一字(行, i);
        整数 格 = 取文字宽度(一字);
        如果 (用了 + 格 > 最多格)
         {
            返回 结果;
        }
        拼接到(结果, 一字);
        用了 = 用了 + 格;
        i = i + 1;
    }
    返回 结果;
}

// ---------------- 私有:一屏的行 ----------------

// 每一条可见行(行号栏 + 正文;当前行先铺一条底色);返回发了几条
方法 编辑器视图_画行(编辑器视图.面板 屏, 编辑器.编辑缓冲 编) 返回 整数
{
    整数 条 = 0;
    整数 首行 = 编辑器.可视首行(编);
    整数 行数 = 编辑器.可视行数(编);
    整数 i = 0;
    当 (i < 行数)
     {
        整数 行号 = 首行 + i;
        如果 (行号 >= 编辑器.行数(编))
        {
            返回 条;
        }
        整数 行y = 屏.上 + i * 屏.行高;
        如果 (行号 == 编辑器.光标行(编))
        {
            画矩形(屏.左 + 1, 行y, 屏.宽 - 编辑器视图_滚动条宽() - 1, 屏.行高, 屏.当前行底);
            条 = 条 + 1;
        }
        条 = 条 + 编辑器视图_画行号(屏, 行号, 行y);
        条 = 条 + 编辑器视图_画正文(屏, 编辑器.行文本(编, 行号), 行y);
        i = i + 1;
    }
    返回 条;
}

// 行号那一格(右对齐排在行号栏里;挤到栏外就不画,给 0 条)
方法 编辑器视图_画行号(编辑器视图.面板 屏, 整数 行号, 整数 行y) 返回 整数
{
    字符串 号文 = 编辑器视图_整数文本(行号 + 1);
    整数 号格 = 取文字宽度(号文);
    整数 号x = 屏.左 + 屏.行号栏宽 - 号格 * 屏.每格宽;
    如果 (号x < 屏.左)
    {
        返回 0;
    }
    画文字(号x, 行y + 3, 号文, 屏.行号色);
    返回 1;
}

// 一行的正文(从 `水平偏移` 那一格起、画到面板右边为止);没字可画给 0 条
方法 编辑器视图_画正文(编辑器视图.面板 屏, 字符串 行, 整数 行y) 返回 整数
{
    字符串 可见 = 编辑器视图_可见段(屏, 行);
    如果 (可见.长度() == 0)
    {
        返回 0;
    }
    画文字(编辑器视图_正文起点(屏), 行y + 3, 可见, 屏.文字色);
    返回 1;
}

// ---------------- 私有:光标 / 滚动条 ----------------

// 光标方块:落在 `正文左 + 光标格 × 每格宽`(按"格"算,中文两格)
方法 编辑器视图_画光标(编辑器视图.面板 屏, 编辑器.编辑缓冲 编) 返回 整数
{
    整数 行内 = 编辑器.光标行(编) - 编辑器.可视首行(编);
    如果 (行内 < 0 || 行内 >= 编辑器.可视行数(编))
    {
        返回 0;
    }
    整数 格 = 编辑器.光标格(编) - 屏.水平偏移;          // 水平偏移按"格"移
    如果 (格 < 0)
    {
        返回 0;                                        // 光标滚到左边看不见了
    }
    整数 x = 编辑器视图_正文左(屏) + 格 * 屏.每格宽;
    整数 右 = 屏.左 + 屏.宽 - 编辑器视图_滚动条宽();
    如果 (x + 屏.每格宽 > 右)
    {
        返回 0;                                        // 光标在面板右边外
    }
    整数 y = 屏.上 + 行内 * 屏.行高 + 2;
    画矩形(x, y, 屏.每格宽, 屏.行高 - 4, 屏.光标色);
    返回 1;
}

// 滚动条:行数比可视行数多才画(槽一条 + 滑块一条);不然给 0 条
方法 编辑器视图_画滚动条(编辑器视图.面板 屏, 编辑器.编辑缓冲 编) 返回 整数
{
    整数 总 = 编辑器.行数(编);
    整数 可见 = 编辑器.可视行数(编);
    如果 (总 <= 可见)
    {
        返回 0;
    }
    整数 宽 = 编辑器视图_滚动条宽();
    整数 x = 屏.左 + 屏.宽 - 宽;
    画矩形(x, 屏.上, 宽, 屏.高, 屏.滚动条槽);
    整数 块高 = 屏.高 * 可见 / 总;
    如果 (块高 < 8)
    {
        块高 = 8;
    }
    整数 块y = 屏.上 + (屏.高 - 块高) * 编辑器.可视首行(编) / (总 - 可见);
    画矩形(x + 1, 块y, 宽 - 2, 块高, 屏.滚动条块);
    返回 2;
}

// 正文区左边界(行号栏右边;`画正文` 与 `画光标` 两处共用同一个口径)
方法 编辑器视图_正文左(编辑器视图.面板 屏) 返回 整数
{
    返回 屏.左 + 屏.行号栏宽 + 屏.文字左留白;
}

// 正文起点(正文区左边界再减去水平偏移换算出来的像素)
方法 编辑器视图_正文起点(编辑器视图.面板 屏) 返回 整数
{
    返回 编辑器视图_正文左(屏) - 屏.水平偏移 * 屏.每格宽;
}
