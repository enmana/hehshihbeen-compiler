// ============================================================
// 网络.hb —— TCP 上"按条说话"(纯 HB 库:不动 ISA、不动关键字、不动机器码)
//
// 用法:
// ```
// 包含 "../库/网络.hb";
// 字符串 本机 = "127.0.0.1";
// 整数 端口 = 45217;                       // 主机 + 端口要先写进 .hbp 的 `网址` 表
// 整数 听 = 0;
// 如果 (网络.开监听(本机, 端口, 听))
// {
//     整数 客 = 0;
//     整数 服 = 0;
//     网络.连上(本机, 端口, 客);           // 自己连自己:两头都在同一个程序里
//     网络.等连接(听, 服);
//     网络.发一行(客, "你好");
//     字符串 行 = "";
//     如果 (网络.收一行(服, 行)) { 输出行(行); }     // 你好
//     网络.关掉(客);
//     网络.关掉(服);
//     网络.关掉(听);
// }
// ```
//
// **TCP 给的是字节流,不是消息**。裸 socket 那九条原语只做"把字节递过去、把字节拿回来",于是每个写协议
//   的人都要自己重写同一批东西(句柄用 -1 说失败、一次接收收到几个字节由网络说了算、文本容器里汉字跨块
//   会被切断)。这一库把这三件都收了:句柄判成败给 `逻辑`、**按 `\n` 切行**(跨块自己拼)、收下来的字节
//   原样住字节区(汉字跨块不坏)。
//
// 口径(2026-10;每条都对着实测写):
//   · **一个库一套收缓冲**:收行 / 收满用的是库自己那**一个 8KB 字节区** ⇒
//     同一时刻只服务**一条连接**;两条连接交错收要各写一个包装封在独立文件里
//     (与 `float32.hb` / `float64.hb` 那条边界同一套办法);
//   · **收行按字节找 `\n`**(10),行尾那个 `\r`(13)顺手去掉 ⇒ 与 Windows / Unix 两种换行都对得上;
//   · **一行最长 8191 字节**(去掉换行之后);超了 `收一行` 给假,**不截断、不猜**;
//   · **收下来的字节一个都不经文本解码**:汉字跨两次接收也是同一个字(收满按字节数给);
//   · **发一行** = 发送(行 + `\n`)一下发完(`发送` 自己会一路发到底);
//   · **全同步阻塞**:收发 / 等连接都是等到底(与那九条原语同一档;异步那一档见 `异步.hb`);
//   · **不报错、不停机**:连不上 / 对端关掉 / 句柄作废都给 `假` 或 `0`(与其它库同一个规矩)。
//
// 提供的函数(13 个):逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:发 / 收一行 O(这一行的字节数);`收满` O(要的字节数);`收一块` 一趟 4KB 封顶;
//   找换行是**按字节**扫的(下标 O(1)),所以一行的代价与行里的汉字个数无关。
//
// 内存账:一个 **8KB** 的收字节区(栈外的模块级定长数组)+ **一块 4KB 的收块**
//   (第一次真收时向堆要,之后一直复用)+ 两条串(行槽 / 发槽,反复用同一格)——
//   所以长循环里连收发**不吃字符串池**。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **一次一条连接**:见上面第一条口径(两个游标是模块级的);
//   · **不做超时**:`收一行` 会一直等着(要"别堵在这儿"就用 `发起异步` 那一族);
//   · **不做消息框架**:没有长度前缀 / 没有校验 / 没有心跳(这一库只管"按 `\n` 切"与"按字节数收满");
//   · **不做 UDP / 不做 TLS**:底下那九条原语就是裸 TCP(加密那一层要自己接);
//   · **手机端与独立 exe 没有这一族能力**:它们带不了 `.hbp` 的 `网址` 白名单,整族一律给假 / 0;
//   · **收缓冲是"一次一份"的**:`收一行` 还没交出去的行会被下一次 `收一块` 压掉 ——
//     拿到一行就当场用掉(或自己拷走)。
// ============================================================
模块 网络

// ---------- 模块状态:一个字节区 + 一个块 + 两条串槽 ----------
私有 字符 网络收区[8192];           // 收下来的字节(跨块拼行就靠它)
私有 整数 网络收长 = 0;             // 区里现在有多少字节
私有 整数 网络收位 = 0;             // 下一条从头几个字节开始(前面那些已经交出去了)
私有 地址 网络块址 = 0;             // 收块(第一次真收时才向堆要)
私有 字符串 网络行槽;               // 一行 / 一段成型的地方(反复用同一格)
私有 字符串 网络发槽;               // 发一行时拼的那一格(反复用同一格)
私有 整数 网络共收 = 0;
私有 整数 网络共发 = 0;

// ============================================================
// 1、小工具
// ============================================================

// ---------- 私有:整数转十进制文字(端口要用;不带库外依赖) ----------
私有 方法 网络数文(整数 值) 返回 字符串
{
    字符串 出文 = "";
    如果 (值 < 0)
    {
        拼接到(出文, '-');
        值 = 0 - 值;
    }
    如果 (值 == 0)
    {
        拼接到(出文, '0');
        返回 出文;
    }
    字符 倒[12];
    整数 位 = 0;
    当 (值 > 0 && 位 < 12)
    {
        倒[位] = 48 + (值 % 10);
        值 = 值 / 10;
        位 = 位 + 1;
    }
    当 (位 > 0)
    {
        位 = 位 - 1;
        拼接到(出文, 倒[位]);
    }
    返回 出文;
}

// ---------- 私有:块里第 `位` 个字节(块按整字取,再移位切出来) ----------
私有 方法 网络取字节(地址 块, 整数 位) 返回 整数
{
    整数 字起 = 位 - 位 % 4;
    整数 移位量 = (位 % 4) * 8;
    返回 (取字(块, 字起) >> 移位量) & 255;
}

// ---------- 私有:把已经交出去的那一段前缀从区里挪掉 ----------
私有 方法 网络压实()
{
    如果 (网络收位 <= 0)
    {
        返回
    }
    整数 剩 = 网络收长 - 网络收位;
    整数 i = 0;
    当 (i < 剩)
    {
        网络收区[i] = 网络收区[网络收位 + i];
        i = i + 1;
    }
    网络收长 = 剩;
    网络收位 = 0;
    返回
}

// ---------- 私有:收一块进区;给收到几个字节(0 = 对端关掉了;-1 = 出错;-2 = 区满了) ----------
//   一次最多 4KB;区快满时按"还差多少格"收(不多收一个字节,收多了就没地方放)。
私有 方法 网络收一块(整数 句柄) 返回 整数
{
    如果 (网络块址 == 0)
    {
        网络块址 = 申请(4096);
        如果 (网络块址 == 0)
        {
            返回 -2;
        }
    }
    网络压实();
    整数 让 = 8192 - 网络收长;
    如果 (让 > 4096)
    {
        让 = 4096;
    }
    如果 (让 <= 0)
    {
        返回 -2;
    }
    整数 得 = 接收块(句柄, 网络块址, 让);
    如果 (得 <= 0)
    {
        返回 得;
    }
    整数 k = 0;
    当 (k < 得)
    {
        网络收区[网络收长 + k] = 网络取字节(网络块址, k);
        k = k + 1;
    }
    网络收长 = 网络收长 + 得;
    网络共收 = 网络共收 + 得;
    返回 得;
}

// ---------- 私有:收到一整行为止(跨块自己拼);成型在 `网络行槽` 里 ----------
私有 方法 网络读一行(整数 句柄) 返回 逻辑
{
    网络行槽 = "";
    整数 断 = 0 - 1;
    当 (真)
    {
        整数 i = 网络收位;
        当 (i < 网络收长)
        {
            如果 (网络收区[i] == 10)
            {
                断 = i;
                跳出;
            }
            i = i + 1;
        }
        如果 (断 >= 0)
        {
            跳出;
        }
        整数 得 = 网络收一块(句柄);
        如果 (得 <= 0)
        {
            返回 假;
        }
    }
    整数 止 = 断;
    如果 (止 > 网络收位 && 网络收区[止 - 1] == 13)
    {
        止 = 止 - 1;
    }
    整数 i = 网络收位;
    当 (i < 止)
    {
        拼接到(网络行槽, 网络收区[i]);
        i = i + 1;
    }
    网络收位 = 断 + 1;
    返回 真;
}

// ---------- 私有:按字节数收满;成型在 `网络行槽` 里 ----------
私有 方法 网络读满(整数 句柄, 整数 字节数) 返回 逻辑
{
    网络行槽 = "";
    如果 (字节数 < 0)
    {
        返回 假;
    }
    当 (网络收长 - 网络收位 < 字节数)
    {
        整数 得 = 网络收一块(句柄);
        如果 (得 <= 0)
        {
            返回 假;
        }
    }
    整数 i = 网络收位;
    整数 止 = 网络收位 + 字节数;
    当 (i < 止)
    {
        拼接到(网络行槽, 网络收区[i]);
        i = i + 1;
    }
    网络收位 = 止;
    返回 真;
}

// ---------- 私有:问一次主机解析,结果写进那一格 ----------
私有 方法 网络查主机(字符串 主机, 字符串 出 地址串) 返回 逻辑
{
    地址串 = "";
    返回 主机解析(主机, 地址串);
}

// ============================================================
// 2、开门与关门(把那九条原语的 -1 判成败收成 `逻辑`)
// ============================================================

// 绑一块网卡 + 一个端口等着别人来连。
// `网卡` 要写 **IP 字面量**(`127.0.0.1` 只收本机、`0.0.0.0` 哪块网卡都收);端口被占 / 没权限给假。
// (`句柄` 是基础类型,不能写 `出` ⇒ 按语言规矩写成 `引用`,调用处照旧写变量名)
方法 开监听(字符串 网卡, 整数 端口, 引用 整数 句柄) 返回 逻辑
{
    句柄 = 0;
    // 里面必须用一个局部变量接:`监听` 那一句要的是**一个真正的变量槽**
    整数 本地 = 0;
    本地 = 监听(网卡, 端口, 本地);
    句柄 = 本地;
    返回 本地 > 0;
}

// 在监听句柄上等一条新连接(**同步阻塞**:有人来连才往下走)。
方法 等连接(整数 听, 引用 整数 句柄) 返回 逻辑
{
    句柄 = 0;
    整数 本地 = 0;
    本地 = 接受(听, 本地);
    句柄 = 本地;
    返回 本地 > 0;
}

// 连一台主机(同步:最多等 5 秒)。主机 + 端口要先写进 `.hbp` 的 `网址` 表,不在表里连试都不试。
方法 连上(字符串 主机, 整数 端口, 引用 整数 句柄) 返回 逻辑
{
    句柄 = 0;
    整数 本地 = 0;
    本地 = 连到(主机, 端口, 本地);
    句柄 = 本地;
    返回 本地 > 0;
}

// 关一条连接 / 一个监听(0 = 成功);关掉之后那个句柄一律作废。
方法 关掉(整数 句柄) 返回 逻辑
{
    返回 关闭(句柄) == 0;
}

// ============================================================
// 3、地址
// ============================================================

// `主机:端口` 那一串 —— 与工程文件 `.hbp` 的 `网址` 表同一种写法(写日志 / 报错都用得上)。
方法 地址文本(字符串 主机, 整数 端口) 返回 字符串
{
    字符串 出文 = "";
    拼接到(出文, 主机);
    拼接到(出文, ":");
    拼接到(出文, 网络数文(端口));
    返回 出文;
}

// 主机名 → 地址(写进你那一格;主机名没在 `网址` 表里声明过给假)。
// 优先给 IPv4(4 字节定长地址最省事)。
方法 解析主机(字符串 主机, 字符串 出 地址串) 返回 逻辑
{
    地址串 = "";
    字符串 本地 = "";
    逻辑 成 = 网络查主机(主机, 本地);
    如果 (成)
    {
        地址串 = 本地;
    }
    返回 成;
}

// ============================================================
// 4、说一条、听一条
// ============================================================

// 发一行(自己补一个 `\n`;`发送` 会一路发到底)。
// 要发"里面有任意字节"的报文用 `发送块`,要发不带换行的一段用 `发送` 本身。
方法 发一行(整数 句柄, 字符串 行文本) 返回 逻辑
{
    网络发槽 = "";
    拼接到(网络发槽, 行文本);
    拼接到(网络发槽, "\n");
    整数 发 = 发送(句柄, 网络发槽);
    如果 (发 > 0)
    {
        网络共发 = 网络共发 + 发;
    }
    返回 发 > 0;
}

// 收一行(按 `\n` 切、跨块自己拼、行尾那个 `\r` 去掉)。
// 对端关掉 / 出错 / 一行超过 8191 字节都给假(那一格清空)。
方法 收一行(整数 句柄, 字符串 出 行) 返回 逻辑
{
    行 = "";
    逻辑 成 = 网络读一行(句柄);
    如果 (成)
    {
        行 = 网络行槽;
    }
    返回 成;
}

// 按**字节数**收满(`字节数` 可以是变量)。
// 定长报文 / 二进制帧走它 —— 收下来的字节原样进字符串,汉字跨几次接收也不坏。
// 对端提前关掉给假(那一格给已经收到的那部分)。
方法 收满(整数 句柄, 整数 字节数, 字符串 出 数据) 返回 逻辑
{
    数据 = "";
    逻辑 成 = 网络读满(句柄, 字节数);
    数据 = 网络行槽;
    返回 成;
}

// 一来一回:发一行问、收一行答(同一个连接上)。
方法 问答(整数 句柄, 字符串 问, 字符串 出 答) 返回 逻辑
{
    答 = "";
    如果 (!发一行(句柄, 问))
    {
        返回 假;
    }
    逻辑 成 = 网络读一行(句柄);
    如果 (成)
    {
        答 = 网络行槽;
    }
    返回 成;
}

// ============================================================
// 5、计数与复位
// ============================================================

// 从上次 `清掉` 起,这条连接上收下来几个字节(收缓冲里还没交出去的那些也算)。
方法 收到字节数() 返回 整数
{
    返回 网络共收;
}

// 从上次 `清掉` 起发出去几个字节。
方法 发出字节数() 返回 整数
{
    返回 网络共发;
}

// 收缓冲与两个计数归零(换一条连接时用;块留着复用,不还给堆)。
方法 清掉()
{
    网络收长 = 0;
    网络收位 = 0;
    网络共收 = 0;
    网络共发 = 0;
    网络行槽 = "";
    网络发槽 = "";
    返回
}
