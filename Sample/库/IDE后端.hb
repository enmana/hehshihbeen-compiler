// ============================================================
// IDE后端.hb —— **把手上这份工程交给后端编译器,再把它的输出收回来**(纯 HB 库)
//
// 用法:
// ```
// 包含 "../库/IDE后端.hb";
// IDE后端.建后端();
// IDE后端.设命令("hbcc");                                  // 工程文件 `可执行文件` 表里的名字
// 逻辑 起了 = IDE后端.编译并跑("-p\nSample\\中间层\\示例01_类型与字面量\n--run\n--无头");
// 输出行(格式化("起了={0} 退出码={1} 输出{2}行", 起了, IDE后端.退出码(), IDE后端.输出行数()));
// ```
//
// 治的是**IDE 里那个"编译 + 跑"按钮背后的事**:拼命令行 → 交给宿主能力 `运行进程` → 收 stdout →
// 拆成一行一行(好灌进输出区)。**它不开窗、不画图**(输出区是 `IDE布局.hb` 的活)。
//
// 口径(每条都对着实测写):
//   · **参数"每行一个"**:`运行进程` 那一族的规矩是**不做 shell 解析** —— 参数串里一行一个实参,
//     原样进 argv ⇒ 本库也只是把调用方给的串原样递下去(不替它转义、不替它拼引号);
//   · **`设命令` 给的是"名字"**:HB 侧**给不了路径** —— 只能按名字取工程文件 `可执行文件` 表里
//     声明过的那几个(表空 / 没挂白名单 ⇒ `运行进程` 一律给假、状态码 `0xFFFFFFFF`);
//   · **输出是一整段串**:回来之后拆成行(`输出行数` / `第几行`),空行也占一行;
//   · **退出码**:起都没起来给 **-1**(这样"没挂能力"与"跑完非 0"分得清);
//   · **不报错、不停机**:没设命令就起 = 假;下标越界给空串。
//
// 提供的函数(10 个):逐条的作用见每个函数紧上面那行注释。
//
// 英文对照:**没有英文别名**(与现有几个库同一口径)。
//
// 边界(如实登记):
//   · **不做"增量编译 / 只编译不跑"**:现成的后端(`hbcc`)一次调用就是"编 + 跑",本库照它的形状;
//     要"只编译"就自己在参数串里换旗标(`--asm` 那条路);
//   · **不解析报错格式**:回来的每一行原样给调用方(要标红 / 要跳行号是界面那一层的事);
//   · **一次一份**:上一次的输出会被这一次盖掉(不排队、不留历史)。
// ============================================================

模块 IDE后端

// 上一次跑的结果(状态放模块级 —— 与 `IDE文件.hb` 同一条口径:
// 结构一大,函数一收它当参数就在帧里拷一份,96 字节的帧当场顶穿)
字符串 IDE后端_命令;
字符串 IDE后端_输出;
整数 IDE后端_退出码;
整数 IDE后端_行数;
字符串 IDE后端_行[256];
逻辑 IDE后端_用假;
字符串 IDE后端_假输出;



// 建一个后端(清掉上一次的结果;命令留空 = 还没设)
方法 建后端()
{
    IDE后端_命令 = "";
    IDE后端_输出 = "";
    IDE后端_假输出 = "";
    IDE后端_行数 = 0;
    清行();
    IDE后端_退出码 = 0 - 1;
    IDE后端_用假 = 假;
    返回
}

// 私有:把"行表"清空(按上一次的条数清)
方法 清行()
{
    整数 i = 0;
    当 (i < 256)
    {
        IDE后端_行[i] = "";
        i = i + 1;
    }
    IDE后端_行数 = 0;
    返回
}

// 挂一个**假后端**(自检 / 没有工程白名单时用):`编译并跑` 不再真起进程,直接把 `假输出` 收下来
// —— 这样"命令行怎么拼 / 输出怎么拆行 / 退出码怎么给"三条**照样能逐条对**(与"假前端"那条自检同一个思路)
方法 挂假后端(字符串 假输出, 整数 假退出码)
{
    IDE后端_假输出 = "";
    拼接到(IDE后端_假输出, 假输出);
    IDE后端_退出码 = 假退出码;
    IDE后端_用假 = 真;
    清行();
    拼接到(IDE后端_输出, 假输出);
    拆行();
    返回
}

// 现在挂的是不是假后端
方法 是假后端() 返回 逻辑
{
    返回 IDE后端_用假;
}

// 设要起哪个后端(工程文件 `可执行文件` 表里的**名字**,不是路径)
方法 设命令(字符串 名字)
{
    拼接到(IDE后端_命令, 名字);
    返回
}

// 现在设的是哪个命令("" = 还没设)
方法 命令() 返回 字符串
{
    返回 IDE后端_命令;
}

// 编译并跑:参数串**一行一个实参**;回来的是"起没起来"
// (`超时毫秒` 给 0 就是 `运行进程` 自己的默认 10000)
方法 编译并跑(字符串 参数, 整数 超时毫秒) 返回 逻辑
{
    如果 (IDE后端_命令.长度() == 0)
    {
        返回 假;
    }
    字符串 收 = "";
    如果 (IDE后端_用假)
    {
        IDE后端_输出 = "";
        拼接到(IDE后端_输出, IDE后端_假输出);
        拆行();
        返回 真;
    }
    IDE后端_输出 = "";          // 先清空(⚠ `拼接` 是往后接、不截断 ⇒ 不清就会把上一次的行接在后面)
    逻辑 起了 = 运行进程(IDE后端_命令, 参数, 收, 超时毫秒);
    IDE后端_退出码 = 取退出码();
    // ⚠⚠ **`运行进程` 只在"退出码 0"时给真**(实测:`hbcc --version` 这种非法旗标那趟
    //   给的是 **假**、可输出有 5060 字节、退出码 2)⇒ 这里**不能拿它当"起没起来"**。
    //    判据改成看**退出码**:`-1` 才是"根本没起来"(没挂白名单 / 名字不对 / 超时),
    //    非 0 的其它码 = 起来了、只是那趟跑砸了(编译错误 / 跑完没通过)。
    如果 (IDE后端_退出码 == 0 - 1)
    {
        拼接到(IDE后端_输出, "没起来:这个工程没给 `可执行文件` 白名单,或者名字不对,或者超时了");
        拆行();
        返回 假;
    }
    拼接到(IDE后端_输出, 收);
    拆行();
    返回 真;
}

// 上一次跑完的退出码(-1 = 起都没起来)
方法 退出码() 返回 整数
{
    返回 IDE后端_退出码;
}

// 上一次收回来几行(空行也占一行)
方法 输出行数() 返回 整数
{
    返回 IDE后端_行数;
}

// 第几行("" = 没这一行)
方法 取输出行(整数 第几行) 返回 字符串
{
    如果 (第几行 < 0 || 第几行 >= IDE后端_行数)
    {
        返回 "";
    }
    返回 IDE后端_行[第几行];
}

// 私有:把整段输出拆成行(按换行走;`\r` 丢掉;最多留 256 行)
方法 拆行()
{
    清行();
    整数 总 = IDE后端_输出.长度();
    整数 i = 0;
    整数 段起 = 0;
    当 (i < 总)
     {
        整数 码 = IDE后端_输出[i];
        如果 (码 == 13)
        {
            i = i + 1;
        }
        否则
        {
            如果 (码 == 10)
            {
                收一行(段起, i);
                段起 = i + 1;
            }
            i = i + 1;
        }
    }
    如果 (段起 < 总)
    {
        收一行(段起, 总);
    }
    返回
}

// 私有:把第 `起` ~ 第 `止`(不含)那一截收成一行
方法 收一行(整数 起, 整数 止)
{
    如果 (IDE后端_行数 >= 256)
    {
        返回
    }
    整数 i = 起;
    当 (i < 止)
     {
        拼接到(IDE后端_行[IDE后端_行数], IDE后端_输出[i]);
        i = i + 1;
    }
    IDE后端_行数 = IDE后端_行数 + 1;
    返回
}

// 把上一次的输出灌进 IDE 的输出区(`IDE布局.写输出` 那样一行一条);
// ⚠ 本库**不引** `IDE布局.hb`(免得两个库互相绑死)⇒ 这里只给"第几行",灌进哪儿由调用方决定
方法 输出段(整数 起, 整数 止, 字符串 出 块)
{
    块 = "";
    整数 i = 起;
    当 (i < 止 && i < IDE后端_行数)
     {
        拼接到(块, IDE后端_行[i]);

        i = i + 1;
     }
    返回
}
