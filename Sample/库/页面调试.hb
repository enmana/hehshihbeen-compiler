// ============================================================
// 页面调试.hb —— Chrome DevTools Protocol 客户端(纯 HB)
//
// 用法:包含 "../库/页面调试.hb";`找页面(主机, 端口, 片段, 路径)` 定位调试路径,
//   `开口(主机, 端口, 路径, 句, 说明)` 连上并握手,然后 `求值(句, 帧块, 帧容量, 1, 表达式, 回话)`,
//   收尾 `释放(帧块)` + `收线(句)`。
//
// 底下那一层是 `WebSocket.hb`(握手 / 收发 / UTF-8);本库只做 CDP 这一层:
//   列页面(`/json/list`)、按号发命令收应答(事件帧自动跳掉)、`求值` / `重载` / `取版本`。
//
// ★ 两条口径(2026-10)
//   · **主机 + 端口要写进工程文件 `.hbp` 的 `网址` 表**(与 `取网址` / `连到` 同一条白名单);
//   · **命令与回话都是 JSON 文本**:本库只**拼**不**解**,回话原样给你(要取字段自己抠,
//     或者 `包含 "../库/JSON.hb"`)。
//
// 英文对照:找页面 findPage · 开口 open · 发命令 send · 等回话 waitReply · 求值 evaluate
//
// 复杂度:一次命令 O(回话字节数)。
//
// 边界(如实登记):
//   · **`表达式` / `参数段` 里别夹裸引号**(本库只把名字拼进 JSON,不做转义)⇒
//     要写字符串字面量,自己把 `"` 写成 `\\\"`,或者用单引号写 JS;
//   · **`求值` 默认不带 `returnByValue`**:页面回的是 CDP 的"远程对象引用";要看值就把
//     `"returnByValue":true` 拼进 `参数段`,自己走 `发命令`;
//   · **不做分帧 / 不做事件订阅**:`等回话` 最多跳 64 条事件帧;
//   · **一次只服务一条连接**(`WebSocket.hb` 的接收游标是模块级的)。
// 提供的函数(8 个):逐个见下面那张公开方法表。
// ============================================================
模块 页面调试

包含 "../库/WebSocket.hb"

// 私有:整数转十进制文字(端口 / 命令号要用)
私有 方法 页面调试数文(整数 值) 返回 字符串
{
    字符串 出文 = "";
    如果 (值 < 0)
    {
        拼接到(出文, '-');
        值 = 0 - 值;
    }
    如果 (值 == 0)
    {
        拼接到(出文, '0');
        返回 出文;
    }
    字符 倒[12];
    整数 位 = 0;
    当 (值 > 0 && 位 < 12)
    {
        倒[位] = 48 + (值 % 10);
        值 = 值 / 10;
        位 = 位 + 1;
    }
    当 (位 > 0)
    {
        位 = 位 - 1;
        拼接到(出文, 倒[位]);
    }
    返回 出文;
}

// 私有:从 `从` 这个位置起找 `子`(找不到给 -1)
私有 方法 页面调试找起(字符串 主, 字符串 子, 整数 从) 返回 整数
{
    整数 主长 = 主.长度();
    整数 子长 = 子.长度();
    如果 (子长 <= 0 || 从 < 0)
    {
        返回 -1;
    }
    整数 i = 从;
    当 (i <= 主长 - 子长)
    {
        整数 j = 0;
        整数 同 = 1;
        当 (j < 子长)
        {
            如果 (主[i + j] != 子[j])
            {
                同 = 0;
                j = 子长;
            }
            否则
            {
                j = j + 1;
            }
        }
        如果 (同 == 1)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// 私有:从 `起` 取到碰见码点 `止` 为止(不含);`止` 给 -1 = 取到末尾
私有 方法 页面调试截到(字符串 文本, 整数 起, 整数 止) 返回 字符串
{
    字符串 出文 = "";
    整数 长 = 文本.长度();
    整数 i = 起;
    当 (i < 长)
    {
        如果 (止 >= 0 && 文本[i] == 止)
        {
            返回 出文;
        }
        文字 一个 = 文本[i];                // ⚠ `文字`(码点)不是 `字符`(8 位)
        拼接到(出文, 一个);
        i = i + 1;
    }
    返回 出文;
}

// ============================================================
// 公开接口
// ============================================================

// 私有:问一次 /json/list,把应答正文写进 `清单`
私有 方法 页面调试取清单(字符串 主机, 整数 端口, 字符串 出 清单) 返回 逻辑
{
    清单 = "";
    字符串 网址 = "http://";
    拼接到(网址, 主机);
    拼接到(网址, ":");
    拼接到(网址, 页面调试数文(端口));
    拼接到(网址, "/json/list");
    返回 取网址(网址, 清单, 65536, 5000);
}

// 私有:从清单里抠出含 `片段` 那个页面的调试路径(先找键名再找 `ws://`,带不带空白都认)。
私有 方法 页面调试抠路径(字符串 清单, 字符串 片段, 字符串 出 路径) 返回 逻辑
{
    路径 = "";
    整数 命中 = 0;
    如果 (片段.长度() > 0)
    {
        命中 = 页面调试找起(清单, 片段, 0);
        如果 (命中 < 0)
        {
            返回 假;
        }
    }
    整数 键起 = 页面调试找起(清单, "webSocketDebuggerUrl", 命中);
    如果 (键起 < 0)
    {
        返回 假;
    }
    字符串 协议头 = "ws://";
    整数 址起 = 页面调试找起(清单, 协议头, 键起);
    如果 (址起 < 0)
    {
        返回 假;
    }
    整数 斜 = 页面调试找起(清单, "/", 址起 + 协议头.长度());
    如果 (斜 < 0)
    {
        返回 假;
    }
//   把返回值先接进局部变量再写出参(本库与 `散列.hb` 统一的写法;别直接写回出参)。
    字符串 本地 = 页面调试截到(清单, 斜, 34);   // 34 = 双引号:路径到这儿为止
    路径 = 本地;
    返回 路径.长度() > 0;
}

// 问 `/json/list`,找 URL 里含 `片段` 的那个页面,把调试路径写进 `路径`(`片段` 给空串 = 拿第一个页面)。
方法 找页面(字符串 主机, 整数 端口, 字符串 片段, 字符串 出 路径) 返回 逻辑
{
    字符串 清单 = "";
    如果 (!页面调试取清单(主机, 端口, 清单))
    {
        路径 = "";
        返回 假;
    }
    返回 页面调试抠路径(清单, 片段, 路径);
}

// 连上调试口 + WebSocket 握手;`句柄` 是基础类型 ⇒ 按语言规矩写成 `引用`,调用处照旧写变量名。
方法 开口(字符串 主机, 整数 端口, 字符串 路径, 引用 整数 句柄, 字符串 出 说明) 返回 逻辑
{
    句柄 = 0;
    说明 = "";
    整数 本地句 = 0;
    本地句 = 连到(主机, 端口, 本地句);
    如果 (本地句 <= 0)
    {
        说明 = "连不上调试口";
        返回 假;
    }
    句柄 = 本地句;
    如果 (!WebSocket.握手(本地句, 主机, 端口, 路径, 说明))
    {
        返回 假;
    }
    返回 真;
}

// 发一条 CDP 命令(`参数段` 是自己拼好的 JSON,没有参数就给空串)
方法 发命令(整数 句柄, 整数 号, 字符串 方法名, 字符串 参数段) 返回 逻辑
{
    字符串 命令 = "{\"id\":";
    拼接到(命令, 页面调试数文(号));
    拼接到(命令, ",\"method\":\"");
    拼接到(命令, 方法名);
    拼接到(命令, "\"");
    如果 (参数段.长度() > 0)
    {
        拼接到(命令, ",\"params\":");
        拼接到(命令, 参数段);
    }
    拼接到(命令, "}");
    返回 WebSocket.发文本(句柄, 命令);
}

// 收到"号对得上"的那一条为止(中间的事件帧自动跳过;最多跳 64 条)
方法 等回话(整数 句柄, 地址 帧块, 整数 帧容量, 整数 号, 字符串 出 回话) 返回 逻辑
{
    回话 = "";
    字符串 找号 = "\"id\":";
    拼接到(找号, 页面调试数文(号));
    拼接到(找号, ",");
    整数 轮 = 0;
    当 (轮 < 64)
    {
        如果 (!WebSocket.收文本(句柄, 帧块, 帧容量, 回话))
        {
            返回 假;
        }
        如果 (WebSocket.找子串(回话, 找号) >= 0)
        {
            返回 真;
        }
        轮 = 轮 + 1;
    }
    返回 假;
}

// `Runtime.evaluate`:把 `表达式` 在页面里跑一遍
方法 求值(整数 句柄, 地址 帧块, 整数 帧容量, 整数 号, 字符串 表达式, 字符串 出 回话) 返回 逻辑
{
    字符串 参数段 = "{\"expression\":\"";
    拼接到(参数段, 表达式);
    拼接到(参数段, "\"}");
    如果 (!发命令(句柄, 号, "Runtime.evaluate", 参数段))
    {
        回话 = "";
        返回 假;
    }
    返回 等回话(句柄, 帧块, 帧容量, 号, 回话);
}

// `Page.reload`:让页面重载一次
方法 重载(整数 句柄, 地址 帧块, 整数 帧容量, 整数 号, 字符串 出 回话) 返回 逻辑
{
    如果 (!发命令(句柄, 号, "Page.reload", ""))
    {
        回话 = "";
        返回 假;
    }
    返回 等回话(句柄, 帧块, 帧容量, 号, 回话);
}

// `Browser.getVersion`:问一句调试口是谁(应答里带 Browser 与 User-Agent)
方法 取版本(整数 句柄, 地址 帧块, 整数 帧容量, 整数 号, 字符串 出 回话) 返回 逻辑
{
    如果 (!发命令(句柄, 号, "Browser.getVersion", ""))
    {
        回话 = "";
        返回 假;
    }
    返回 等回话(句柄, 帧块, 帧容量, 号, 回话);
}

// 发一帧 close 再把 TCP 关掉
方法 收线(整数 句柄) 返回 逻辑
{
    返回 WebSocket.关掉(句柄);
}
