// ============================================================
// float64.hb —— IEEE754 双精度浮点库(**纯软件**;不动指令集、不动语言面)
//
//   值 = `双精度` 位模式(64 位 = 高 32 + 低 32):
//     高 = (号 << 31) | (阶 << 20) | 尾数的高 20 位;低 = 尾数的低 32 位
//   阶 0 = 零/次正规;阶 1..2046 = 正规(隐含位 1);阶 2047 = Inf/非数;
//   尾数 52 位(正规数的实际尾数 53 位,隐含的最高位 1)。
//
//   与 `float32.hb` 各自独立(都能单独 包含),但两库的 `宽整数*` 帮手**重名** ⇒ 同时 包含 时
//   会被后解析的那个顶掉,要一起用就自己给其中一个加前缀。
//
//   口径(2026-10;与 IEEE754 一致,除非特别注明):
//     · 加 / 减 / 乘 / 除 / 开方 / 比较 / 取负 / 绝对值一律"就近连偶";负数、-0.0、±Inf、
//       非数(安静 非数 一律 0x7FF8000000000000)全按 IEEE754;
//     · 打印最短且能原样读回;|二进指数| > 53(约 1e-16 以下、9.0e15 以上)退回精确二进制写法;
//     · 解析收 16 位有效数字;|十进指数| ≤ 22 一步算准,更大按 22 一段算(可能差 1~2 个最小单位)。
//
//   用法:在文件开头 包含 "../库/float64.hb"
//   性能:`字符串转双精度` 是运行期解析(几十~几百条指令),热循环里别调 —— 常量写位模式
//   (`0x400921FB54442D18`)或用 `双精度常量圆周率()`(零运行期开销)。
//
// 提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// 依赖:string.hb(用它的 转字符串 / 取子串)
包含 "string.hb"

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 1、内部:宽整数(64 位 = 高 32 + 低 32)与基本多字运算
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 64 位宽整数 = 无符号整数 高 + 无符号整数 低(高半区在前)
结构 宽整数
{
    无符号整数 高;
    无符号整数 低;
}

// 无符号 32 位 → 宽整数(高半区 0)。
方法 宽整数从32(无符号整数 低) 返回 宽整数
{
    宽整数 r;
    r.高 = 0;
    r.低 = 低;
    返回 r;
}

// 两个 32 位半区拼成宽整数:第一参数进高半区,第二参数进低半区。
方法 宽整数从64(无符号整数 高, 无符号整数 低) 返回 宽整数
{
    宽整数 r;
    r.高 = 高;
    r.低 = 低;
    返回 r;
}

// 宽整数 → 低 32 位(高半区丢掉,不做溢出检查)。
方法 宽整数到32(宽整数 x) 返回 无符号整数
{
    返回 x.低;
}

// 高、低两个半区都为 0 才是零。
方法 宽整数是零(宽整数 x) 返回 逻辑
{
    返回 x.高 == 0 && x.低 == 0;
}

// v 的二进制位数(0 → 0)
方法 整数位长(无符号整数 值) 返回 整数
{
    无符号整数 v = 值;
    整数 n = 0;
    如果 (v >= 0x10000)
    {
        v = v >> 16;
        n = n + 16;
    }
    如果 (v >= 0x100)
    {
        v = v >> 8;
        n = n + 8;
    }
    如果 (v >= 0x10)
    {
        v = v >> 4;
        n = n + 4;
    }
    如果 (v >= 4)
    {
        v = v >> 2;
        n = n + 2;
    }
    如果 (v >= 2)
    {
        v = v >> 1;
        n = n + 1;
    }
    如果 (v >= 1)
    {
        n = n + 1;
    }
    返回 n;
}

// 二进制位数(0 → 0;高半区非零时是 32 + 高半区位数)。
方法 宽整数位长(宽整数 x) 返回 整数
{
    如果 (x.高 != 0)
    {
        返回 32 + 整数位长(x.高);
    }
    返回 整数位长(x.低);
}

// 宽整数 逻辑左移 n 位(0 ≤ n ≤ 63;溢出的高位丢掉)
方法 宽整数左移(宽整数 x, 整数 n) 返回 宽整数
{
    宽整数 结果;
    如果 (n <= 0)
    {
        结果.高 = x.高;
        结果.低 = x.低;
        返回 结果;
    }
    如果 (n >= 64)
    {
        结果.高 = 0;
        结果.低 = 0;
        返回 结果;
    }
    如果 (n >= 32)
    {
        结果.高 = x.低 << (n - 32);
        结果.低 = 0;
        返回 结果;
    }
    结果.高 = (x.高 << n) | (x.低 >> (32 - n));
    结果.低 = x.低 << n;
    返回 结果;
}

// 宽整数 逻辑右移 n 位(0 ≤ n ≤ 63)
方法 宽整数右移(宽整数 x, 整数 n) 返回 宽整数
{
    宽整数 结果;
    如果 (n <= 0)
    {
        结果.高 = x.高;
        结果.低 = x.低;
        返回 结果;
    }
    如果 (n >= 64)
    {
        结果.高 = 0;
        结果.低 = 0;
        返回 结果;
    }
    如果 (n >= 32)
    {
        结果.高 = 0;
        结果.低 = x.高 >> (n - 32);
        返回 结果;
    }
    结果.低 = (x.低 >> n) | (x.高 << (32 - n));
    结果.高 = x.高 >> n;
    返回 结果;
}

// x 的"第 n 位以下还有没有 1"(粘位)
方法 宽整数低位有1(宽整数 x, 整数 n) 返回 逻辑
{
    如果 (n <= 0)
    {
        返回 假;
    }
    如果 (n >= 64)
    {
        返回 !宽整数是零(x);
    }
    如果 (n >= 32)
    {
        如果 (x.低 != 0)
        {
            返回 真;
        }
        返回 (x.高 & ((1 << (n - 32)) - 1)) != 0;
    }
    返回 (x.低 & ((1 << n) - 1)) != 0;
}

// 取第 i 位(0 = 最低位);越界给 0
方法 宽整数位取位(宽整数 x, 整数 i) 返回 整数
{
    如果 (i >= 64 || i < 0)
    {
        返回 0;
    }
    如果 (i >= 32)
    {
        返回 (x.高 >> (i - 32)) & 1;
    }
    返回 (x.低 >> i) & 1;
}

// a - b(调用方保证 a ≥ b)
方法 宽整数减(宽整数 a, 宽整数 b) 返回 宽整数
{
    无符号整数 借 = 0;
    如果 (a.低 < b.低)
    {
        借 = 1;
    }
    宽整数 结果;
    结果.低 = a.低 - b.低;
    结果.高 = a.高 - b.高 - 借;
    返回 结果;
}

// a + b(丢掉最高位溢出的那一位;调用方保证用不着)
方法 宽整数加(宽整数 a, 宽整数 b) 返回 宽整数
{
    宽整数 结果;
    无符号整数 c = a.低 + b.低;
    无符号整数 进 = 0;
    如果 (c < a.低)
    {
        进 = 1;
    }
    结果.低 = c;
    结果.高 = a.高 + b.高 + 进;
    返回 结果;
}

// 比较:与 `双精度比较` 一个口径 —— -1 = 左小 / 0 = 相等 / 1 = 左大 / 2 = 不可比。
// 宽整数是精确整数 ⇒ **永不返回 2**(那一档留给"不可比"的将来)。
// ⚠ 调用点注意:**"比大小"问的是 `!= -1`(即 ≥),不是 `!= 1`** ——
//   `!= 1` 在旧口径里等于"≥",新口径里却是"< 或 =";写成 `!= 1` 再紧接相减会无符号下溢。
方法 宽整数比较(宽整数 a, 宽整数 b) 返回 整数
{
    如果 (a.高 > b.高)
    {
        返回 1;
    }
    如果 (a.高 < b.高)
    {
        返回 -1;
    }
    如果 (a.低 > b.低)
    {
        返回 1;
    }
    如果 (a.低 < b.低)
    {
        返回 -1;
    }
    返回 0;
}

// 32 位 × 32 位 → 64 位(16 位半区竖式)
方法 宽整数乘32位(无符号整数 a, 无符号整数 b) 返回 宽整数
{
    无符号整数 al = a & 0xFFFF;
    无符号整数 ah = a >> 16;
    无符号整数 bl = b & 0xFFFF;
    无符号整数 bh = b >> 16;
    无符号整数 lo = al * bl;
    无符号整数 m1 = ah * bl + (lo >> 16);
    无符号整数 m2 = al * bh + (m1 & 0xFFFF);
    无符号整数 hi = ah * bh + (m1 >> 16) + (m2 >> 16);
    宽整数 结果;
    结果.低 = ((m2 & 0xFFFF) << 16) | (lo & 0xFFFF);
    结果.高 = hi;
    返回 结果;
}

// 宽整数 × m(m ≤ 65535;调用方保证 x×m 不进位丢位)
方法 宽整数乘半区(宽整数 x, 无符号整数 m) 返回 宽整数
{
    无符号整数 a0 = x.低 & 0xFFFF;
    无符号整数 a1 = (x.低 >> 16) & 0xFFFF;
    无符号整数 a2 = x.高 & 0xFFFF;
    无符号整数 a3 = (x.高 >> 16) & 0xFFFF;
    无符号整数 t = a0 * m;
    无符号整数 段0 = t & 0xFFFF;
    无符号整数 进 = t >> 16;
    t = a1 * m + 进;
    无符号整数 段1 = t & 0xFFFF;
    进 = t >> 16;
    t = a2 * m + 进;
    无符号整数 段2 = t & 0xFFFF;
    进 = t >> 16;
    t = a3 * m + 进;
    无符号整数 段3 = t & 0xFFFF;
    宽整数 结果;
    结果.低 = (段1 << 16) | 段0;
    结果.高 = (段3 << 16) | 段2;
    返回 结果;
}

// 宽整数 逻辑右移 n 位,把丢掉的位**或进最低位**(粘位合并;加法对齐用)
//   n ≥ 64:非零 → 1,零 → 0
方法 宽整数右移记粘(宽整数 x, 整数 n) 返回 宽整数
{
    宽整数 结果;
    如果 (n <= 0)
    {
        结果.高 = x.高;
        结果.低 = x.低;
        返回 结果;
    }
    如果 (n >= 64)
    {
        如果 (宽整数是零(x))
        {
            结果.高 = 0;
            结果.低 = 0;
            返回 结果;
        }
        结果.高 = 0;
        结果.低 = 1;
        返回 结果;
    }
    整数 粘位 = 0;
    如果 (宽整数低位有1(x, n))
    {
        粘位 = 1;
    }
    宽整数 移位量 = 宽整数右移(x, n);
    结果 = 移位量;
    如果 (粘位 == 1)
    {
        结果.低 = 结果.低 | 1;
    }
    返回 结果;
}

// 宽整数 × 2^n(n ≥ 0;调用方保证不丢有效位)
方法 宽整数左移保位(宽整数 x, 整数 n) 返回 宽整数
{
    宽整数 结果 = 宽整数左移(x, n);
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 1之2、十六进制写法(核对位模式/内部调试用)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 宽整数转 16 个字符的大写十六进制(高位补 0,够核对位模式)
方法 宽整数转十六进制(宽整数 x) 返回 字符串
{
    字符 表[16];
    表[0] = '0';
    表[1] = '1';
    表[2] = '2';
    表[3] = '3';
    表[4] = '4';
    表[5] = '5';
    表[6] = '6';
    表[7] = '7';
    表[8] = '8';
    表[9] = '9';
    表[10] = 'A';
    表[11] = 'B';
    表[12] = 'C';
    表[13] = 'D';
    表[14] = 'E';
    表[15] = 'F';
    字符串 结果 = "";
    整数 i = 15;
    当 (i >= 0)
    {
        整数 半 = 0;
        如果 (i >= 8)
        {
            半 = (x.高 >> ((i - 8) * 4)) & 0xF;
        }
        否则
        {
            半 = (x.低 >> (i * 4)) & 0xF;
        }
        拼接到(结果, 表[半]);
        i = i - 1;
    }
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 1之3、宽整数的十进制文字(精确;x < 2^64 时最多 20 位数字)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 宽整数的十进制文字(精确,无前导零;2^64 以内最多 20 位数字)
方法 宽整数转字符串(宽整数 x) 返回 字符串
{
    如果 (宽整数是零(x))
    {
        返回 "0";
    }
    无符号整数 l0 = x.低 & 0xFFFF;
    无符号整数 l1 = (x.低 >> 16) & 0xFFFF;
    无符号整数 l2 = x.高 & 0xFFFF;
    无符号整数 l3 = (x.高 >> 16) & 0xFFFF;
    字符 倒[24];
    整数 个 = 0;
    当 (l0 != 0 || l1 != 0 || l2 != 0 || l3 != 0)
    {
        无符号整数 t = l3;
        无符号整数 q3 = t / 10;
        无符号整数 余 = t % 10;
        t = (余 << 16) | l2;
        无符号整数 q2 = t / 10;
        余 = t % 10;
        t = (余 << 16) | l1;
        无符号整数 q1 = t / 10;
        余 = t % 10;
        t = (余 << 16) | l0;
        无符号整数 q0 = t / 10;
        余 = t % 10;
        l3 = q3;
        l2 = q2;
        l1 = q1;
        l0 = q0;
        倒[个] = 余 + '0';
        个 = 个 + 1;
    }
    字符串 结果 = "";
    整数 i = 个 - 1;
    当 (i >= 0)
    {
        拼接到(结果, 倒[i]);
        i = i - 1;
    }
    返回 结果;
}

// 无符号整数的十进制文字
方法 u数转字符串(无符号整数 v) 返回 字符串
{
    如果 (v == 0)
    {
        返回 "0";
    }
    字符 倒[12];
    整数 个 = 0;
    无符号整数 剩 = v;
    当 (剩 > 0)
    {
        倒[个] = (剩 % 10) + '0';
        个 = 个 + 1;
        剩 = 剩 / 10;
    }
    字符串 结果 = "";
    整数 i = 个 - 1;
    当 (i >= 0)
    {
        拼接到(结果, 倒[i]);
        i = i - 1;
    }
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 2、内部:超宽整数(128 位 = 4 个 32 位字;段3 最高,段0 最低)
//   乘法/开方两处要用 106 位以上的中间值,别处不用
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 128 位超宽整数 = 段3 ~ 段0(段3 最高);乘法与开方要 106 位以上中间值时用
结构 超宽整数
{
    无符号整数 段3;
    无符号整数 段2;
    无符号整数 段1;
    无符号整数 段0;
}

// 零常量:四个 32 位段全 0。
方法 超宽整数零() 返回 超宽整数
{
    超宽整数 r;
    r.段3 = 0;
    r.段2 = 0;
    r.段1 = 0;
    r.段0 = 0;
    返回 r;
}

// 无符号 32 位 → 超宽整数(段3、段2、段1 都 0,v 进段0)。
方法 超宽整数从32(无符号整数 v) 返回 超宽整数
{
    超宽整数 r;
    r.段3 = 0;
    r.段2 = 0;
    r.段1 = 0;
    r.段0 = v;
    返回 r;
}

// 宽整数 → 超宽整数(高半区进段1、低半区进段0,段3 与段2 为 0)。
方法 超宽整数从64(宽整数 x) 返回 超宽整数
{
    超宽整数 r;
    r.段3 = 0;
    r.段2 = 0;
    r.段1 = x.高;
    r.段0 = x.低;
    返回 r;
}

// 四个 32 位段全为 0 才是零。
方法 超宽整数是零(超宽整数 x) 返回 逻辑
{
    返回 x.段3 == 0 && x.段2 == 0 && x.段1 == 0 && x.段0 == 0;
}

// 二进制位数(0 → 0;从段3 往下找第一个非零段)。
方法 超宽整数位长(超宽整数 x) 返回 整数
{
    如果 (x.段3 != 0)
    {
        返回 96 + 整数位长(x.段3);
    }
    如果 (x.段2 != 0)
    {
        返回 64 + 整数位长(x.段2);
    }
    如果 (x.段1 != 0)
    {
        返回 32 + 整数位长(x.段1);
    }
    返回 整数位长(x.段0);
}

// 超宽整数(128 位)取第 i 位,0 = 最低位;越界给 0
方法 超宽整数取位(超宽整数 x, 整数 i) 返回 整数
{
    如果 (i >= 128 || i < 0)
    {
        返回 0;
    }
    如果 (i >= 96)
    {
        返回 (x.段3 >> (i - 96)) & 1;
    }
    如果 (i >= 64)
    {
        返回 (x.段2 >> (i - 64)) & 1;
    }
    如果 (i >= 32)
    {
        返回 (x.段1 >> (i - 32)) & 1;
    }
    返回 (x.段0 >> i) & 1;
}

// x 的"第 n 位以下还有没有 1"
方法 超宽整数低位有1(超宽整数 x, 整数 n) 返回 逻辑
{
    如果 (n <= 0)
    {
        返回 假;
    }
    如果 (n >= 128)
    {
        返回 !超宽整数是零(x);
    }
    如果 (n >= 96)
    {
        如果 (x.段0 != 0 || x.段1 != 0 || x.段2 != 0)
        {
            返回 真;
        }
        返回 (x.段3 & ((1 << (n - 96)) - 1)) != 0;
    }
    如果 (n >= 64)
    {
        如果 (x.段0 != 0 || x.段1 != 0)
        {
            返回 真;
        }
        返回 (x.段2 & ((1 << (n - 64)) - 1)) != 0;
    }
    如果 (n >= 32)
    {
        如果 (x.段0 != 0)
        {
            返回 真;
        }
        返回 (x.段1 & ((1 << (n - 32)) - 1)) != 0;
    }
    返回 (x.段0 & ((1 << n) - 1)) != 0;
}

// 超宽整数 逻辑左移 n 位(0 ≤ n ≤ 127;溢出的高位丢掉)
方法 超宽整数左移(超宽整数 x, 整数 n) 返回 超宽整数
{
    超宽整数 结果;
    如果 (n <= 0)
    {
        结果 = x;
        返回 结果;
    }
    如果 (n < 32)
    {
        结果.段3 = (x.段3 << n) | (x.段2 >> (32 - n));
        结果.段2 = (x.段2 << n) | (x.段1 >> (32 - n));
        结果.段1 = (x.段1 << n) | (x.段0 >> (32 - n));
        结果.段0 = x.段0 << n;
        返回 结果;
    }
    如果 (n == 32)
    {
        结果.段3 = x.段2;
        结果.段2 = x.段1;
        结果.段1 = x.段0;
        结果.段0 = 0;
        返回 结果;
    }
    如果 (n < 64)
    {
        整数 k = n - 32;
        结果.段3 = (x.段2 << k) | (x.段1 >> (32 - k));
        结果.段2 = (x.段1 << k) | (x.段0 >> (32 - k));
        结果.段1 = x.段0 << k;
        结果.段0 = 0;
        返回 结果;
    }
    如果 (n == 64)
    {
        结果.段3 = x.段1;
        结果.段2 = x.段0;
        结果.段1 = 0;
        结果.段0 = 0;
        返回 结果;
    }
    如果 (n < 96)
    {
        整数 k2 = n - 64;
        结果.段3 = (x.段1 << k2) | (x.段0 >> (32 - k2));
        结果.段2 = x.段0 << k2;
        结果.段1 = 0;
        结果.段0 = 0;
        返回 结果;
    }
    如果 (n == 96)
    {
        结果.段3 = x.段0;
        结果.段2 = 0;
        结果.段1 = 0;
        结果.段0 = 0;
        返回 结果;
    }
    如果 (n < 128)
    {
        结果.段3 = x.段0 << (n - 96);
        结果.段2 = 0;
        结果.段1 = 0;
        结果.段0 = 0;
        返回 结果;
    }
    结果.段3 = 0;
    结果.段2 = 0;
    结果.段1 = 0;
    结果.段0 = 0;
    返回 结果;
}

// 超宽整数 逻辑右移 n 位(0 ≤ n ≤ 127)
方法 超宽整数右移(超宽整数 x, 整数 n) 返回 超宽整数
{
    超宽整数 结果;
    如果 (n <= 0)
    {
        结果 = x;
        返回 结果;
    }
    如果 (n < 32)
    {
        结果.段0 = (x.段0 >> n) | (x.段1 << (32 - n));
        结果.段1 = (x.段1 >> n) | (x.段2 << (32 - n));
        结果.段2 = (x.段2 >> n) | (x.段3 << (32 - n));
        结果.段3 = x.段3 >> n;
        返回 结果;
    }
    如果 (n == 32)
    {
        结果.段0 = x.段1;
        结果.段1 = x.段2;
        结果.段2 = x.段3;
        结果.段3 = 0;
        返回 结果;
    }
    如果 (n < 64)
    {
        整数 k = n - 32;
        结果.段0 = (x.段1 >> k) | (x.段2 << (32 - k));
        结果.段1 = (x.段2 >> k) | (x.段3 << (32 - k));
        结果.段2 = x.段3 >> k;
        结果.段3 = 0;
        返回 结果;
    }
    如果 (n == 64)
    {
        结果.段0 = x.段2;
        结果.段1 = x.段3;
        结果.段2 = 0;
        结果.段3 = 0;
        返回 结果;
    }
    如果 (n < 96)
    {
        整数 k2 = n - 64;
        结果.段0 = (x.段2 >> k2) | (x.段3 << (32 - k2));
        结果.段1 = x.段3 >> k2;
        结果.段2 = 0;
        结果.段3 = 0;
        返回 结果;
    }
    如果 (n == 96)
    {
        结果.段0 = x.段3;
        结果.段1 = 0;
        结果.段2 = 0;
        结果.段3 = 0;
        返回 结果;
    }
    如果 (n < 128)
    {
        结果.段0 = x.段3 >> (n - 96);
        结果.段1 = 0;
        结果.段2 = 0;
        结果.段3 = 0;
        返回 结果;
    }
    结果.段3 = 0;
    结果.段2 = 0;
    结果.段1 = 0;
    结果.段0 = 0;
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 2之2、53 位 × 53 位 → 128 位 精确乘积
//   尾数是 53 位,乘出来的 106 位必须一位不丢(要拿后面 3 位做舍入)
//   拆成 4 个 32×32 → 64 的乘积:左 = a1·2^32 + a0,右 = b1·2^32 + b0
//     值 = a1b1·2^64 + (a1b0 + a0b1)·2^32 + a0b0
//   a1、b1 < 2^21 ⇒ a1b1 < 2^42,(a1b0+a0b1) < 2^54,都不会溢出
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 两个宽整数相乘的 128 位积 = 高 + 低
结构 乘积
{
    宽整数 高;      // 值 = 高 × 2^64 + 低
    宽整数 低;
}

// 宽整数 × 宽整数 → 128 位全积(高 64 位 / 低 64 位,不截断)。
方法 宽整数全乘(宽整数 左, 宽整数 右) 返回 乘积
{
    乘积 结果;
    宽整数 低 = 宽整数乘取低(左, 右);
    宽整数 高 = 宽整数乘取高(左, 右);
    结果.低 = 低;
    结果.高 = 高;
    返回 结果;
}

// 53 位 × 53 位 的低 64 位:J + (M 的低半)<<32
//   拆成两个函数是**帧**的问题:一个函数里塞 8 个宽整数局部 + 结构返回,帧会顶到 96 上限
方法 宽整数乘取低(宽整数 左, 宽整数 右) 返回 宽整数
{
    宽整数 J = 宽整数乘32位(左.低, 右.低);
    宽整数 M1 = 宽整数乘32位(左.高, 右.低);
    宽整数 M2 = 宽整数乘32位(左.低, 右.高);
    宽整数 M = 宽整数加(M1, M2);
    宽整数 结果;
    结果.低 = J.低;
    结果.高 = J.高 + (M.低 & 0xFFFFFFFF);
    返回 结果;
}

// 53 位 × 53 位 的高 64 位:a1b1 + (M>>32) + 低位的进位
//   注意 进 与比较都必须是**无符号**:`结果.低 < 进` 若有符号比,0xA0000000 会被当负数,
//   误判成"回绕了" → 高位平白 +1(写浮点乘时栽过一次)
方法 宽整数乘取高(宽整数 左, 宽整数 右) 返回 宽整数
{
    宽整数 J = 宽整数乘32位(左.低, 右.低);
    宽整数 M1 = 宽整数乘32位(左.高, 右.低);
    宽整数 M2 = 宽整数乘32位(左.低, 右.高);
    宽整数 M = 宽整数加(M1, M2);
    宽整数 低 = 宽整数从32(0);
    低.低 = J.低;
    低.高 = J.高 + (M.低 & 0xFFFFFFFF);
    无符号整数 进 = 0;
    如果 (低.高 < J.高)
    {
        进 = 1;
    }
    宽整数 上 = 宽整数乘32位(左.高, 右.高);
    宽整数 移位量 = 宽整数右移(M, 32);
    宽整数 结果 = 宽整数加(上, 移位量);
    结果.低 = 结果.低 + 进;
    如果 (结果.低 < 进)
    {
        结果.高 = 结果.高 + 1;
    }
    返回 结果;
}
// 乘积的高 128 位里取第 i 位(0 = 最低位)
方法 乘积取位(乘积 P, 整数 i) 返回 整数
{
    如果 (i < 0)
    {
        返回 0;
    }
    如果 (i >= 64)
    {
        返回 宽整数位取位(P.高, i - 64);
    }
    返回 宽整数位取位(P.低, i);
}

// 乘积的二进制位数(最多 106)
方法 乘积位长(乘积 P) 返回 整数
{
    如果 (!宽整数是零(P.高))
    {
        返回 64 + 宽整数位长(P.高);
    }
    返回 宽整数位长(P.低);
}

// 乘积右移 移位量 位,把丢掉的位**或进最低位**(移位量 可正可负)
方法 乘积右移记粘(乘积 P, 整数 移位量) 返回 宽整数
{
    宽整数 结果;
    如果 (移位量 <= 0)
    {
        结果 = 宽整数左移(P.低, 0 - 移位量);
        返回 结果;
    }
    如果 (移位量 >= 64)
    {
        宽整数 上 = 宽整数右移(P.高, 移位量 - 64);
        整数 粘位 = 0;
        如果 (!宽整数是零(P.低))
        {
            粘位 = 1;
        }
        如果 (宽整数低位有1(P.高, 移位量 - 64))
        {
            粘位 = 1;
        }
        如果 (粘位 == 1)
        {
            上.低 = 上.低 | 1;
        }
        返回 上;
    }
    宽整数 左 = 宽整数左移(P.高, 64 - 移位量);
    宽整数 右 = 宽整数右移(P.低, 移位量);
    宽整数 和 = 宽整数加(左, 右);
    如果 (宽整数低位有1(P.低, 移位量))
    {
        和.低 = 和.低 | 1;
    }
    返回 和;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 3、双精度位模式:64 位 = 高 32 位 + 低 32 位
//   高 = (号 << 31) | (阶 << 20) | 尾数高 20 位;低 = 尾数低 32 位
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 双精度位模式 = 高 32 位 + 低 32 位(号 << 31 | 阶 << 20 | 尾数高 20 位;低半是尾数低 32 位)
结构 双精度
{
    无符号整数 高;
    无符号整数 低;
}

// 两个 32 位半区原样拼成 64 位位模式(不判值,非数 / 无穷也能拼)。
方法 双精度从64(无符号整数 高, 无符号整数 低) 返回 双精度
{
    双精度 r;
    r.高 = 高;
    r.低 = 低;
    返回 r;
}

// +0 与 -0 都算零(只看除符号位以外的 63 位)。
方法 双精度是零(双精度 位) 返回 逻辑
{
    返回 (位.高 & 0x7FFFFFFF) == 0 && 位.低 == 0;
}

// 非数:11 位阶域全 1 且尾数非 0(尾数全 0 那一档是无穷,不算)。
方法 双精度是非数(双精度 位) 返回 逻辑
{
    返回 (位.高 & 0x7FF00000) == 0x7FF00000 && ((位.高 & 0xFFFFF) != 0 || 位.低 != 0);
}

// 无穷:11 位阶域全 1 且尾数全 0(不分正负)。
方法 双精度是无穷(双精度 位) 返回 逻辑
{
    返回 (位.高 & 0x7FFFFFFF) == 0x7FF00000 && 位.低 == 0;
}

// 符号位是 1(只问符号位,不看大小;-0 也算有负号)。
方法 双精度有负号(双精度 位) 返回 逻辑
{
    返回 (位.高 & 0x80000000) != 0;
}

// 取符号位,给 0(正)或 1(负)。
方法 双精度取符号(双精度 位) 返回 整数
{
    返回 位.高 >> 31;
}

// 取 11 位阶域原值(0 ~ 2047;0 = 零 / 次正规,2047 = 无穷 / 非数)。
方法 双精度取指数域(双精度 位) 返回 整数
{
    返回 (位.高 >> 20) & 0x7FF;
}

// 翻转符号位(位数不变;0 → -0、无穷变号、非数还是非数)。
方法 双精度取负(双精度 位) 返回 双精度
{
    双精度 r;
    r.高 = 位.高 ^ 0x80000000;
    r.低 = 位.低;
    返回 r;
}

// 清掉符号位(位数不变;-0 → +0、无穷与非数原样)。
方法 双精度绝对值(双精度 位) 返回 双精度
{
    双精度 r;
    r.高 = 位.高 & 0x7FFFFFFF;
    r.低 = 位.低;
    返回 r;
}

// 常量:安静 非数(位模式 0x7FF8000000000000;谓词是 双精度是非数)
方法 双精度非数() 返回 双精度
{
    双精度 r = 双精度从64(0x7FF80000, 0);
    返回 r;
}

// 常量:+0(+0.0 的位模式 0x0000000000000000)。
方法 双精度正零() 返回 双精度
{
    双精度 r = 双精度从64(0, 0);
    返回 r;
}

// 号的位(0 或 0x80000000)
方法 双精度零高位(整数 号) 返回 无符号整数
{
    返回 (号 & 1) << 31;
}

// ±Inf 的高 32 位
方法 双精度无穷高位(整数 号) 返回 无符号整数
{
    如果 (号 == 1)
    {
        返回 0xFFF00000;
    }
    返回 0x7FF00000;
}

// 按 号 造零:号 为 1 给 -0,否则给 +0(只用 号 的最低位)。
方法 双精度带符号零(整数 号) 返回 双精度
{
    双精度 r = 双精度从64(双精度零高位(号), 0);
    返回 r;
}

// 按 号 造无穷:号 为 1 给 -Inf,否则给 +Inf(只用 号 的最低位)。
方法 双精度带符号无穷(整数 号) 返回 双精度
{
    双精度 r = 双精度从64(双精度无穷高位(号), 0);
    返回 r;
}

// 十六进制写法(核对位模式用)
方法 双精度转十六进制(双精度 位) 返回 字符串
{
    宽整数 x = 宽整数从64(位.高, 位.低);
    字符串 结果 = 宽整数转十六进制(x);
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 3之2、拆:位模式 → (号, 指数, 53 位尾数)
//   值 = (-1)^号 × 尾数 × 2^指数(正规尾数带隐含位 1;次正规 尾数 < 2^52)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 从双精度位模式取 53 位尾数:正规数补隐含的 1,次正规数不补
方法 双精度取尾数(双精度 位) 返回 宽整数
{
    宽整数 尾 = 宽整数从64(位.高 & 0xFFFFF, 位.低);
    如果 ((位.高 & 0x7FF00000) != 0)
    {
        尾.高 = 尾.高 | 0x100000;
    }
    返回 尾;
}

// 有效指数(值 = 尾数 × 2^指数):正常阶域减 1075,阶域 0 一律给 -1074。
方法 双精度取指数(双精度 位) 返回 整数
{
    整数 域 = (位.高 >> 20) & 0x7FF;
    如果 (域 == 0)
    {
        返回 -1074;
    }
    返回 域 - 1075;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 4、加减:对齐(尾数左移 3 位,低 3 位留给保护/舍/粘位) + 就近连偶
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 指数对齐的结果:和 + 指基 + 号 + 粘位(低 3 位留给保护位 / 舍位 / 粘位)
结构 对齐结果
{
    宽整数 和;         // 值 = 和 × 2^指基
    整数 指基;
    整数 号;         // 结果的号(相减大到小时会翻)
    整数 粘位;         // 对齐时丢掉的位里有没有 1
}

// 调用方保证 左 的指数大(或同指数且尾数大);左、右 都带隐含位
方法 双精度对齐(宽整数 尾左, 整数 指左, 宽整数 尾右, 整数 指右, 整数 号左, 整数 号右) 返回 对齐结果
{
    整数 指基 = 指左 - 3;
    整数 移位量 = 指基 - 指右;
    宽整数 左移量 = 宽整数左移(尾左, 3);
    对齐结果 Q;
    Q.指基 = 指基;
    Q.号 = 号左;
    Q.粘位 = 0;
    宽整数 右移量 = 宽整数从32(0);
    如果 (移位量 <= 0)
    {
        右移量 = 宽整数左移(尾右, 0 - 移位量);
    }
    否则
    {
        如果 (宽整数低位有1(尾右, 移位量))
        {
            Q.粘位 = 1;
        }
        右移量 = 宽整数右移(尾右, 移位量);
    }
    如果 (号左 == 号右)
    {
        Q.和 = 宽整数加(左移量, 右移量);
    }
    否则
    {
        // 契约(见函数头注释)保证 左移量 ≥ 右移量,所以这里只会走"左移量 - 右移量"那一支;
        //   收口:哨兵从 `!= 2`(旧口径"不小于")翻成 `!= -1` —— 这一批曾误翻成 `!= 1`。
        如果 (宽整数比较(左移量, 右移量) != -1)
        {
            Q.和 = 宽整数减(左移量, 右移量);
        }
        否则
        {
            Q.和 = 宽整数减(右移量, 左移量);
            Q.号 = 号右;
        }
    }
    返回 Q;
}

// 收尾:规格化 + 就近连偶 + 编码(和 的位长拉到 56 = 53 + 保护/舍/粘位)
方法 双精度收尾(宽整数 和, 整数 指基, 整数 粘位入, 整数 号) 返回 双精度
{
    整数 最高 = 宽整数位长(和) - 1;
    整数 二进指 = 最高 + 指基;
    双精度 结果 = 双精度从64(0, 0);
    如果 (二进指 >= -1022)
    {
        结果 = 双精度收尾规格化(和, 指基, 粘位入, 号, 最高, 二进指);
        返回 结果;
    }
    结果 = 双精度收尾次正规(和, 指基, 粘位入, 号);
    返回 结果;
}

// 规格化收尾:和 拉到 56 位后按就近连偶舍入,再编码成位模式(阶 ≥ 2047 → 无穷)。
方法 双精度收尾规格化(宽整数 和, 整数 指基, 整数 粘位入, 整数 号, 整数 最高, 整数 二进指) 返回 双精度
{
    整数 剩余位 = 粘位入;              // 更低位还有没有 1(规格化时一路累积)
    如果 (最高 < 55)
    {
        和 = 宽整数左移(和, 55 - 最高);
    }
    否则
    {
        如果 (最高 > 55)
        {
            整数 移位量 = 最高 - 55;
            如果 (宽整数低位有1(和, 移位量))
            {
                剩余位 = 1;
            }
            和 = 宽整数右移(和, 移位量);
        }
    }
    整数 阶 = 二进指 + 1023;
    宽整数 尾 = 宽整数右移(和, 3);
    如果 (宽整数位取位(和, 2) == 1 && (宽整数位取位(和, 1) == 1 || 宽整数位取位(和, 0) == 1 || 剩余位 == 1 || (尾.低 & 1) == 1))
    {
        尾.低 = 尾.低 + 1;
        如果 (尾.低 == 0)
        {
            尾.高 = 尾.高 + 1;
        }
    }
    如果 (尾.高 >= 0x200000)
    {
        尾 = 宽整数右移(尾, 1);
        阶 = 阶 + 1;
    }
    无符号整数 果高 = (号 << 31) | (阶 << 20) | (尾.高 & 0xFFFFF);
    无符号整数 果低 = 尾.低;
    如果 (阶 >= 2047)
    {
        果高 = 双精度无穷高位(号);
        果低 = 0;
    }
    双精度 结果 = 双精度从64(果高, 果低);
    返回 结果;
}

// 次正规收尾:以 2^-1074 为单位就近连偶舍入,舍到 0 时按 号 给 ±0。
方法 双精度收尾次正规(宽整数 和, 整数 指基, 整数 粘位入, 整数 号) 返回 双精度
{
    整数 剩余位 = 粘位入;              // 更低位还有没有 1(规格化时一路累积)
    整数 移 = 0 - (指基 + 1074);
    宽整数 m = 宽整数从32(0);
    如果 (移 <= 0)
    {
        // 值本身就是 2^-1074 的整数倍(能走到这儿的都是精确的,粘位为 0)
        m = 宽整数左移(和, 0 - 移);
    }
    否则
    {
        如果 (移 >= 64)
        {
            如果 (!宽整数是零(和))
            {
                剩余位 = 1;
            }
        }
        否则
        {
            m = 宽整数右移(和, 移);
            整数 保护位 = 宽整数位取位(和, 移 - 1);
            整数 舍入位 = 0;
            如果 (移 >= 2)
            {
                舍入位 = 宽整数位取位(和, 移 - 2);
            }
            如果 (移 >= 3)
            {
                如果 (宽整数低位有1(和, 移 - 2))
                {
                    剩余位 = 1;
                }
            }
            如果 (保护位 == 1 && (舍入位 == 1 || 剩余位 == 1 || (m.低 & 1) == 1))
            {
                m.低 = m.低 + 1;
                如果 (m.低 == 0)
                {
                    m.高 = m.高 + 1;
                }
            }
        }
    }
    无符号整数 果高 = (号 << 31) | m.高;
    无符号整数 果低 = m.低;
    如果 (宽整数是零(m))
    {
        果高 = 双精度零高位(号);
        果低 = 0;
    }
    如果 (m.高 >= 0x100000)
    {
        果高 = (号 << 31) | 0x100000;
        果低 = 0;
    }
    双精度 结果 = 双精度从64(果高, 果低);
    返回 结果;
}

// 双精度加法(就近连偶):异号无穷与 Inf + (-Inf) 给安静非数,零的号按 IEEE754。
方法 双精度加(双精度 A, 双精度 B) 返回 双精度
{
    双精度 结果 = A;
    如果 (双精度是非数(A) || 双精度是非数(B))
    {
        结果 = 双精度从64(0x7FF80000, 0);
        返回 结果;
    }
    如果 (双精度是无穷(A) || 双精度是无穷(B))
    {
        如果 (双精度是无穷(A) && 双精度是无穷(B) && 双精度取符号(A) != 双精度取符号(B))
        {
            结果 = 双精度从64(0x7FF80000, 0);
            返回 结果;
        }
        如果 (双精度是无穷(A))
        {
            结果 = A;
            返回 结果;
        }
        结果 = B;
        返回 结果;
    }
    如果 (双精度是零(A) && 双精度是零(B))
    {
        如果 (双精度取符号(A) == 1 && 双精度取符号(B) == 1)
        {
            结果 = A;
            返回 结果;
        }
        结果 = 双精度从64(0, 0);
        返回 结果;
    }
    如果 (双精度是零(A))
    {
        结果 = B;
        返回 结果;
    }
    如果 (双精度是零(B))
    {
        结果 = A;
        返回 结果;
    }
    宽整数 尾左 = 双精度取尾数(A);
    宽整数 尾右 = 双精度取尾数(B);
    整数 指左 = 双精度取指数(A);
    整数 指右 = 双精度取指数(B);
    整数 号 = 双精度取符号(A);
    整数 号右 = 双精度取符号(B);
    如果 (指左 < 指右 || (指左 == 指右 && 宽整数比较(尾左, 尾右) == -1))
    {
        宽整数 换尾 = 尾左;
        尾左 = 尾右;
        尾右 = 换尾;
        整数 换 = 指左;
        指左 = 指右;
        指右 = 换;
        换 = 号;
        号 = 号右;
        号右 = 换;
    }
    对齐结果 Q = 双精度对齐(尾左, 指左, 尾右, 指右, 号, 号右);
    如果 (宽整数是零(Q.和))
    {
        结果 = 双精度从64(0, 0);
        返回 结果;
    }
    结果 = 双精度收尾(Q.和, Q.指基, Q.粘位, Q.号);
    返回 结果;
}

// 双精度减法(就近连偶):B 取负后走加法,同号无穷相减给安静非数。
方法 双精度减(双精度 A, 双精度 B) 返回 双精度
{
    双精度 负右 = 双精度取负(B);
    双精度 结果 = 双精度加(A, 负右);
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 6、乘除开方
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 双精度乘:两个 53 位尾数相乘取 56 位和,再归一与就近连偶;Inf×0 给非数
方法 双精度乘(双精度 A, 双精度 B) 返回 双精度
{
    双精度 结果 = A;
    如果 (双精度是非数(A) || 双精度是非数(B))
    {
        结果 = 双精度从64(0x7FF80000, 0);
        返回 结果;
    }
    整数 号 = 双精度取符号(A) ^ 双精度取符号(B);
    如果 (双精度是无穷(A) || 双精度是无穷(B))
    {
        如果 (双精度是零(A) || 双精度是零(B))
        {
            结果 = 双精度从64(0x7FF80000, 0);
            返回 结果;
        }
        结果 = 双精度从64(双精度无穷高位(号), 0);
        返回 结果;
    }
    如果 (双精度是零(A) || 双精度是零(B))
    {
        结果 = 双精度从64(双精度零高位(号), 0);
        返回 结果;
    }
    宽整数 尾左 = 双精度取尾数(A);
    宽整数 尾右 = 双精度取尾数(B);
    结果 = 双精度乘法核心(尾左, 尾右, 双精度取指数(A), 双精度取指数(B), 号);
    返回 结果;
}

// 乘法核(拆出来是为了帧):尾数相乘 → 56 位和(丢掉的位并进最低位) → 收尾
方法 双精度乘法核心(宽整数 尾左, 宽整数 尾右, 整数 指左, 整数 指右, 整数 号) 返回 双精度
{
    乘积 P = 宽整数全乘(尾左, 尾右);
    整数 移位量 = 乘积位长(P) - 56;
    宽整数 和 = 乘积右移记粘(P, 移位量);
    双精度 结果 = 双精度收尾(和, 指左 + 指右 + 移位量, 0, 号);
    返回 结果;
}

// 两个 53 位尾数相除:商 = floor(尾左/尾右 × 2^53)(54 位),粘位 = 还有余数
//   调用方保证 尾右 ≤ 尾左 < 2×尾右(商落在 [2^53, 2^54))
结构 除法结果
{
    宽整数 商;
    整数 粘位;
}

// 两个尾数相除:返回 54 位商与"除不尽"标记(调用方保证 尾右 ≤ 尾左 < 2×尾右)。
方法 双精度除尾数(宽整数 尾左, 宽整数 尾右) 返回 除法结果
{
    宽整数 余 = 宽整数减(尾左, 尾右);
    宽整数 商 = 宽整数从32(1);
    整数 i = 0;
    当 (i < 53)
    {
        余 = 宽整数左移(余, 1);
        商 = 宽整数左移(商, 1);
        如果 (宽整数比较(余, 尾右) != -1)
        {
            余 = 宽整数减(余, 尾右);
            商.低 = 商.低 | 1;
        }
        i = i + 1;
    }
    除法结果 Q;
    Q.商 = 商;
    Q.粘位 = 0;
    如果 (!宽整数是零(余))
    {
        Q.粘位 = 1;
    }
    返回 Q;
}

// A / B(就近连偶):x/0 给 ±Inf,0/0 与无穷相除给安静非数。
方法 双精度除(双精度 A, 双精度 B) 返回 双精度
{
    双精度 结果 = A;
    如果 (双精度是非数(A) || 双精度是非数(B) || 双精度是无穷(A) || 双精度是无穷(B) || 双精度是零(A) || 双精度是零(B))
    {
        结果 = 双精度除特殊值(A, B);
        返回 结果;
    }
    宽整数 尾左 = 双精度取尾数(A);
    宽整数 尾右 = 双精度取尾数(B);
    结果 = 双精度除法核心(尾左, 尾右, 双精度取指数(A) - 双精度取指数(B), 双精度取符号(A) ^ 双精度取符号(B));
    返回 结果;
}

// 除法的特殊值(非数 / ±Inf / 零)分流(冷路径;拆出来是帧的问题)
方法 双精度除特殊值(双精度 A, 双精度 B) 返回 双精度
{
    双精度 结果 = A;
    整数 号 = 双精度取符号(A) ^ 双精度取符号(B);
    如果 (双精度是非数(A) || 双精度是非数(B))
    {
        结果 = 双精度从64(0x7FF80000, 0);
        返回 结果;
    }
    如果 (双精度是无穷(A))
    {
        如果 (双精度是无穷(B))
        {
            结果 = 双精度从64(0x7FF80000, 0);
            返回 结果;
        }
        结果 = 双精度从64(双精度无穷高位(号), 0);
        返回 结果;
    }
    如果 (双精度是无穷(B))
    {
        结果 = 双精度从64(双精度零高位(号), 0);
        返回 结果;
    }
    如果 (双精度是零(B))
    {
        如果 (双精度是零(A))
        {
            结果 = 双精度从64(0x7FF80000, 0);
            返回 结果;
        }
        结果 = 双精度从64(双精度无穷高位(号), 0);
        返回 结果;
    }
    结果 = 双精度从64(双精度零高位(号), 0);
    返回 结果;
}

// 除法核:归一(保证 尾左 ≥ 尾右)→ 53 位商 + 粘位 → 56 位和 → 收尾
//   注意:次正规的尾数可以比正规的小得多(最小到 1),所以要一直挪到 尾左 ≥ 尾右,
//     不是只挪一位 —— 两位操作数都正规时它们都在 [2^52,2^53),循环最多转 1 次。
方法 双精度除法核心(宽整数 尾左, 宽整数 尾右, 整数 指, 整数 号) 返回 双精度
{
    当 (宽整数比较(尾左, 尾右) == -1)
    {
        尾左 = 宽整数左移(尾左, 1);
        指 = 指 - 1;
    }
    除法结果 Q = 双精度除尾数(尾左, 尾右);
    宽整数 和 = 宽整数左移(Q.商, 2);
    如果 (Q.粘位 == 1)
    {
        和.低 = 和.低 | 1;
    }
    双精度 结果 = 双精度收尾(和, 指 - 55, 0, 号);
    返回 结果;
}

// 106 位整数开方(逐位复原法;N 的位长 ≤ 106 ⇒ 根 ≤ 53 位)
//   返回 floor(sqrt(N)) 和余数 —— 余数 > 根 就是"该进位"
//   **算法一个字没换**(所以位模式必然逐个相同),换的是"每一步怎么算":
//     · 取下一对二进制位:以前一轮两次 `超宽整数取位`(通用版,带越界分支 + 函数调用);
//       现在把 N 左移 22 位放进 64 位"剩"寄存器,每轮 `位 = 剩.段3 >> 30` 再整体左移 2 位;
//     · 余/根 的 ×4、×2:以前每次调 `宽整数左移`;现在高半低半就地拼(余 ≤ 2·根+1 < 2^54、4·余+3 < 2^56,
//       全在 64 位内,不会溢);
//     · 比大小 / 相减:以前调 `宽整数比较` / `宽整数减`;现在就地"高半比高半、按借位相减"。
//   实测一次开方 **28857 → 4559 条指令**(1116 例语料与 .NET 位模式逐个相同,见 `工具\临时\e3\对拍64.ps1`)。
结构 开方结果
{
    宽整数 根;
    宽整数 余;
}

// 整数开方:根 取 √N 的整数部分(≤ 53 位),另给余数;余 > 根 表示该进位。
方法 超宽整数整开方(超宽整数 N) 返回 开方结果
{
    // 剩 = N 的高 54 位(P = N >> 52)左移 10:最高两位就是第一对
    宽整数 剩;
    剩.低 = ((N.段1 >> 20) | (N.段2 << 12)) << 10;
    剩.高 = (((N.段2 >> 20) | (N.段3 << 12)) << 10) | (((N.段1 >> 20) | (N.段2 << 12)) >> 22);

    宽整数 余;
    余.高 = 0;
    余.低 = 0;
    宽整数 根;
    根.高 = 0;
    根.低 = 0;

    // 上半段 27 轮:这半段的根 < 2^27、余 < 2^28,**全在 32 位里**(只用 宽整数的低半),
    //   于是每轮就是几条整数加移 —— 不必动高半。跑完的状态与"从第一轮一路跑 27 轮"**完全一样**
    //   (逐位复原法的性质:处理完 N 的高 52 位后 根 = floor(sqrt(N >> 52))、余 = 根² 的差)。
    整数 i = 26;
    当 (i >= 0)
    {
        无符号整数 位 = 剩.高 >> 30;
        剩.高 = (剩.高 << 2) | (剩.低 >> 30);
        剩.低 = 剩.低 << 2;
        余.低 = 余.低 * 4 + 位;
        无符号整数 试 = 根.低 * 4 + 1;
        根.低 = 根.低 * 2;
        如果 (余.低 >= 试)
        {
            余.低 = 余.低 - 试;
            根.低 = 根.低 + 1;
        }
        i = i - 1;
    }

    // 下半段 26 轮:剩 换成 N 的低 52 位(左移 12 顶到最高);这时根会长到 53 位、余到 54 位,
    //   所以要 64 位算术 —— 但仍是就地拼高半低半,不再调 `宽整数左移` / `宽整数比较` / `宽整数减`
    剩.高 = (N.段1 << 12) | (N.段0 >> 20);
    剩.低 = N.段0 << 12;
    宽整数 试2;
    试2.高 = 0;
    试2.低 = 0;
    整数 j = 25;
    当 (j >= 0)
    {
        无符号整数 位 = 剩.高 >> 30;
        剩.高 = (剩.高 << 2) | (剩.低 >> 30);
        剩.低 = 剩.低 << 2;

        // 余 = 4 * 余 + 位(余 < 2^54 ⇒ 4*余+3 < 2^56,64 位内)
        余.高 = (余.高 << 2) | (余.低 >> 30);
        余.低 = (余.低 << 2) | 位;

        // 试 = 4 * 根 + 1(根 < 2^53 ⇒ 试 < 2^55,64 位内)
        试2.高 = (根.高 << 2) | (根.低 >> 30);
        试2.低 = (根.低 << 2) | 1;

        // 根 = 2 * 根(先移位;够了再把最低位置 1)
        根.高 = (根.高 << 1) | (根.低 >> 31);
        根.低 = 根.低 << 1;

        // 余 >= 试2 ?(**无符号**比较:高半比高半,相等才看低半)
        逻辑 够 = 假;
        如果 (余.高 > 试2.高)
        {
            够 = 真;
        }
        否则
        {
            如果 (余.高 == 试2.高 && 余.低 >= 试2.低)
            {
                够 = 真;
            }
        }
        如果 (够)
        {
            无符号整数 借 = 0;
            如果 (余.低 < 试2.低)
            {
                借 = 1;
            }
            余.低 = 余.低 - 试2.低;
            余.高 = 余.高 - 试2.高 - 借;
            根.低 = 根.低 | 1;
        }
        j = j - 1;
    }
    开方结果 R;
    R.根 = 根;
    R.余 = 余;
    返回 R;
}

// 平方根(就近连偶):负数给安静非数,±0 原样返回,+Inf 给 +Inf。
方法 双精度开方(双精度 A) 返回 双精度
{
    双精度 结果 = A;
    如果 (双精度是非数(A))
    {
        结果 = 双精度从64(0x7FF80000, 0);
        返回 结果;
    }
    如果 (双精度是零(A))
    {
        结果 = A;
        返回 结果;
    }
    如果 (双精度取符号(A) == 1)
    {
        结果 = 双精度从64(0x7FF80000, 0);
        返回 结果;
    }
    如果 (双精度是无穷(A))
    {
        结果 = A;
        返回 结果;
    }
    宽整数 尾 = 双精度取尾数(A);
    整数 指 = 双精度取指数(A);
    如果 ((指 & 1) == 1)
    {
        尾 = 宽整数左移(尾, 1);
        指 = 指 - 1;
    }
    // 把 尾 挪成 106 位左右再开方:这样 floor(sqrt(N)) 本身就是 53 位的尾数,
    //   一次舍入就到位(挪少了会先丢精度再舍入,次正规输入尤其明显)。
    //   挪位取偶数,保证 (指-移位量)/2 是整数。
    整数 尾位 = 宽整数位长(尾);
    整数 移位量 = 105 - 尾位;
    如果 ((移位量 & 1) == 1)
    {
        移位量 = 移位量 + 1;
    }
    超宽整数 N = 超宽整数从64(尾);
    N = 超宽整数左移(N, 移位量);
    开方结果 R = 超宽整数整开方(N);
    宽整数 根 = R.根;
    如果 (宽整数比较(R.余, R.根) == 1)
    {
        根.低 = 根.低 + 1;
        如果 (根.低 == 0)
        {
            根.高 = 根.高 + 1;
        }
    }
    宽整数 和 = 宽整数左移(根, 3);
    结果 = 双精度收尾(和, (指 - 移位量) / 2 - 3, 0, 0);
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 5、比较
//   双精度比较 → -1(左小) / 0(相等,含 +0 与 -0) / 1(左大) / 2(不可比:有 非数)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 比两个双精度:左小 -1 / 相等(含 +0 = -0) / 左大 1;有非数给 2
方法 双精度比较(双精度 A, 双精度 B) 返回 整数
{
    如果 (双精度是非数(A) || 双精度是非数(B))
    {
        返回 2;
    }
    逻辑 左零 = 双精度是零(A);
    逻辑 右零 = 双精度是零(B);
    如果 (左零 && 右零)
    {
        返回 0;
    }
    如果 (左零)
    {
        如果 (双精度有负号(B))
        {
            返回 1;
        }
        返回 -1;
    }
    如果 (右零)
    {
        如果 (双精度有负号(A))
        {
            返回 -1;
        }
        返回 1;
    }
    整数 号左 = 双精度取符号(A);
    整数 号右 = 双精度取符号(B);
    如果 (号左 != 号右)
    {
        如果 (号左 == 1)
        {
            返回 -1;
        }
        返回 1;
    }
    无符号整数 绝左高 = A.高 & 0x7FFFFFFF;
    无符号整数 绝右高 = B.高 & 0x7FFFFFFF;
    整数 大小 = 0;
    如果 (绝左高 > 绝右高)
    {
        大小 = 1;
    }
    否则
    {
        如果 (绝左高 < 绝右高)
        {
            大小 = -1;
        }
        否则
        {
            如果 (A.低 > B.低)
            {
                大小 = 1;
            }
            否则
            {
                如果 (A.低 < B.低)
                {
                    大小 = -1;
                }
            }
        }
    }
    如果 (大小 == 0)
    {
        返回 0;
    }
    如果 (号左 == 1)
    {
        返回 0 - 大小;
    }
    返回 大小;
}

// A == B:+0 与 -0 算相等;任一方是非数给假(比数值,不比位模式)。
方法 双精度相等(双精度 A, 双精度 B) 返回 逻辑
{
    返回 双精度比较(A, B) == 0;
}

// A < B:比较给 -1 才算真;任一方是非数给假(-0 与 +0 算相等,不给真)。
方法 双精度小于(双精度 A, 双精度 B) 返回 逻辑
{
    返回 双精度比较(A, B) == -1;
}

// A ≤ B:比较给 -1 或 0 都算真;任一方是非数给假(-0 ≤ +0 成立)。
方法 双精度小于等于(双精度 A, 双精度 B) 返回 逻辑
{
    整数 c = 双精度比较(A, B);
    返回 c == -1 || c == 0;
}

// A > B:比较给 1 才算真;任一方是非数给假(-0 > +0 不成立)。
方法 双精度大于(双精度 A, 双精度 B) 返回 逻辑
{
    返回 双精度比较(A, B) == 1;
}

// A ≥ B:比较给 1 或 0 都算真;任一方是非数给假(-0 ≥ +0 成立)。
方法 双精度大于等于(双精度 A, 双精度 B) 返回 逻辑
{
    整数 c = 双精度比较(A, B);
    返回 c == 1 || c == 0;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 7、打印:位模式 → 十进制文字
//
// 口径(文档里的一串承诺):
//   · **最短且能原样读回**(就近连偶):先算 17 位有效数字,再一位一位试着少打,
//     每少一位都用 `字符串转双精度` 的核**回读一遍比对位模式**,回得来才真少打 ——
//     所以 `0.1` 打成 "0.1"、`0.1+0.2` 打成 "0.30000000000000004",两位都对得上。
//   · 特殊值:`0` / `-0` / `Inf` / `-Inf` / `NaN`
//   · 整数值(尾数 << 指 装得进 64 位,即 |值| ≲ 9.0e15 的整数值)打**精确整数**
//   · 十进制区间:|二进指数| ≤ 53(约 1e-16 ~ 9.0e15)用十进制;其余打**精确的二进制写法**
//     `尾数*2^指数`(1e-300、1e300 这种不猜十进制 —— 要打 300 位十进制得上大整数,
//     本库走纯软件路线,不为了好看把准确度丢了)
//   · 冷路径:打印一次要跑十几趟解析核,热循环里别打
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 去掉字符串末尾的 '0'
方法 双精度去尾零(字符串 s) 返回 字符串
{
    整数 n = s.长度();
    当 (n > 0)
    {
        如果 (s[n - 1] == '0')
        {
            n = n - 1;
        }
        否则
        {
            跳出;
        }
    }
    字符串 结果 = 取子串(s, 0, n);
    返回 结果;
}

// 把"有效数字 N + 首位十进指数 d"(值 ≈ N × 10^(d-位数+1))排成定点写法
//   例:N=3141592653589793, d=0 → "3.141592653589793";N=1, d=8 → "100000000"
方法 双精度定点串转字符串(宽整数 N, 整数 d) 返回 字符串
{
    字符串 数 = 宽整数转字符串(N);
    整数 位 = 数.长度();
    字符串 结果 = "";
    如果 (d >= 位 - 1)
    {
        拼接到(结果, 数);
        整数 补 = d - 位 + 1;
        当 (补 > 0)
        {
            拼接到(结果, '0');
            补 = 补 - 1;
        }
        返回 结果;
    }
    如果 (d >= 0)
    {
        字符串 整段 = 取子串(数, 0, d + 1);
        拼接到(结果, 整段);
        字符串 小段 = 取子串(数, d + 1, 位 - d - 1);
        小段 = 双精度去尾零(小段);
        如果 (小段.长度() > 0)
        {
            拼接到(结果, '.');
            拼接到(结果, 小段);
        }
        返回 结果;
    }
    拼接到(结果, "0.");
    整数 零数 = 0 - d - 1;
    当 (零数 > 0)
    {
        拼接到(结果, '0');
        零数 = 零数 - 1;
    }
    字符串 尾段 = 双精度去尾零(数);
    拼接到(结果, 尾段);
    返回 结果;
}

// 宽整数 除 10(商与余数)
结构 除十结果
{
    宽整数 商;
    整数 余;
}

// 宽整数 / 10:给商与余数(0~9);64 位全宽精确,不丢位、不舍入。
方法 宽整数除十(宽整数 x) 返回 除十结果
{
    无符号整数 h = x.高 / 10;
    无符号整数 r = x.高 % 10;
    无符号整数 A = (r << 16) + (x.低 >> 16);
    无符号整数 q1 = A / 10;
    无符号整数 余高 = A % 10;
    无符号整数 B = (余高 << 16) + (x.低 & 0xFFFF);
    无符号整数 q0 = B / 10;
    除十结果 结果;
    结果.商 = 宽整数从64(h, (q1 << 16) | q0);
    结果.余 = B % 10;
    返回 结果;
}

// 宽整数 除 10^次数,就近连偶
方法 宽整数除十舍入(宽整数 x, 整数 次数) 返回 宽整数
{
    宽整数 结果 = x;
    整数 i = 1;
    当 (i < 次数)
    {
        除十结果 Q = 宽整数除十(结果);
        结果 = Q.商;
        i = i + 1;
    }
    除十结果 末 = 宽整数除十(结果);
    宽整数 商 = 末.商;
    如果 (末.余 > 5 || (末.余 == 5 && (商.低 & 1) == 1))
    {
        商.低 = 商.低 + 1;
        如果 (商.低 == 0)
        {
            商.高 = 商.高 + 1;
        }
    }
    返回 商;
}

// 宽整数 和 (高, 低) 这对常量比大小
方法 宽整数比常量(宽整数 a, 无符号整数 高, 无符号整数 低) 返回 整数
{
    宽整数 b = 宽整数从64(高, 低);
    整数 结果 = 宽整数比较(a, b);
    返回 结果;
}

// 超宽整数 乘一个小整数(≤ 65535;16 位半区竖式,只要低 128 位)
方法 超宽整数乘半区(超宽整数 x, 无符号整数 m) 返回 超宽整数
{
    无符号整数 t = (x.段0 & 0xFFFF) * m;
    无符号整数 段0 = t & 0xFFFF;
    无符号整数 进 = t >> 16;
    t = ((x.段0 >> 16) & 0xFFFF) * m + 进;
    无符号整数 段1 = t & 0xFFFF;
    进 = t >> 16;
    t = (x.段1 & 0xFFFF) * m + 进;
    无符号整数 段2 = t & 0xFFFF;
    进 = t >> 16;
    t = ((x.段1 >> 16) & 0xFFFF) * m + 进;
    无符号整数 段3 = t & 0xFFFF;
    进 = t >> 16;
    t = (x.段2 & 0xFFFF) * m + 进;
    无符号整数 w4 = t & 0xFFFF;
    进 = t >> 16;
    t = ((x.段2 >> 16) & 0xFFFF) * m + 进;
    无符号整数 w5 = t & 0xFFFF;
    进 = t >> 16;
    t = (x.段3 & 0xFFFF) * m + 进;
    无符号整数 w6 = t & 0xFFFF;
    进 = t >> 16;
    t = ((x.段3 >> 16) & 0xFFFF) * m + 进;
    无符号整数 w7 = t & 0xFFFF;
    超宽整数 结果;
    结果.段0 = (段1 << 16) | 段0;
    结果.段1 = (段3 << 16) | 段2;
    结果.段2 = (w5 << 16) | w4;
    结果.段3 = (w7 << 16) | w6;
    返回 结果;
}

// 超宽整数 右移 n 位后取低 64 位(结果一定 < 2^57,高位用不着)
方法 超宽整数右移取低(超宽整数 x, 整数 n) 返回 宽整数
{
    超宽整数 移 = 超宽整数右移(x, n);
    宽整数 结果 = 宽整数从64(移.段1, 移.段0);
    返回 结果;
}

// 超宽整数左移 n 位后取低 64 位;溢出的高位丢掉(调用方保证结果装得下)。
方法 超宽整数左移取低(超宽整数 x, 整数 n) 返回 宽整数
{
    超宽整数 移 = 超宽整数左移(x, n);
    宽整数 结果 = 宽整数从64(移.段1, 移.段0);
    返回 结果;
}

// 把 N 拉回刚好 17 位(10^16 ≤ N < 10^17),同时改十进指数 d
方法 宽整数缩到17位(宽整数 N, 引用 整数 d) 返回 宽整数
{
    宽整数 结果 = N;
    当 (宽整数比常量(结果, 0x002386F2, 0x6FC10000) != 1)
    {
        结果 = 宽整数乘半区(结果, 10);
        d = d - 1;
    }
    当 (宽整数比常量(结果, 0x01634578, 0x5D8A0000) == 1)
    {
        除十结果 Q = 宽整数除十(结果);
        结果 = Q.商;
        d = d + 1;
    }
    返回 结果;
}

// 17 位有效数字 + 首位十进指数
结构 有效数字
{
    宽整数 数;
    整数 d;
}

//   值 = 尾 × 2^指;先估 d = floor(二进 × log10 2),再取 k = 16 - d 位小数,
//   把 尾×5^k 一次乘出来(窗口卡在 |二进| ≤ 53 就是为了 5^k 装得进 128 位)
方法 双精度取有效数字(宽整数 尾, 整数 指, 整数 二进) 返回 有效数字
{
    整数 积 = 二进 * 30103;
    整数 d = 积 / 100000;
    如果 (积 < 0 && d * 100000 != 积)
    {
        d = d - 1;
    }
    整数 k = 16 - d;
    超宽整数 P = 超宽整数从64(尾);
    当 (k > 0)
    {
        P = 超宽整数乘半区(P, 5);
        k = k - 1;
    }
    整数 移位量 = 0 - (指 + (16 - d));
    宽整数 N = 宽整数从32(0);
    如果 (移位量 <= 0)
    {
        N = 超宽整数左移取低(P, 0 - 移位量);
    }
    否则
    {
        N = 超宽整数右移取低(P, 移位量);
        如果 (超宽整数取位(P, 移位量 - 1) == 1 && (超宽整数取位(P, 移位量 - 2) == 1 || 超宽整数低位有1(P, 移位量 - 2) || (N.低 & 1) == 1))
        {
            N.低 = N.低 + 1;
            如果 (N.低 == 0)
            {
                N.高 = N.高 + 1;
            }
        }
    }
    有效数字 结果;
    结果.数 = 宽整数缩到17位(N, d);
    结果.d = d;
    返回 结果;
}

// 一位一位试着少打:每少一位都回读一遍比对位模式,回得来才真少打
方法 双精度缩到最短(宽整数 N, 整数 d, 双精度 位) 返回 有效数字
{
    宽整数 好 = N;
    整数 好d = d;
    整数 少 = 1;
    当 (少 <= 16)
    {
        宽整数 试 = 宽整数除十舍入(N, 少);
        双精度 回 = 双精度从十进制(试, d - 16 + 少, 0);
        如果 (回.高 == 位.高 && 回.低 == 位.低)
        {
            好 = 试;
            字符串 试串 = 宽整数转字符串(试);
            好d = d - 16 + 少 + 试串.长度() - 1;     // 少打几位后位数会变(四舍五入可能进位)
        }
        否则
        {
            跳出;
        }
        少 = 少 + 1;
    }
    有效数字 结果;
    结果.数 = 好;
    结果.d = 好d;
    返回 结果;
}

// 整值档:尾 × 2^指 左移成整数再打十进制(精确、无小数点;指 在 0~11 时才用)。
方法 双精度整值转字符串(宽整数 尾, 整数 指) 返回 字符串
{
    宽整数 大 = 宽整数左移(尾, 指);
    字符串 结果 = 宽整数转字符串(大);
    返回 结果;
}

// 二进制档:打“尾数*2^指”(|二进指数| > 53 时用,1e300 这类不猜十进制)。
方法 双精度二进制转字符串(宽整数 尾, 整数 指) 返回 字符串
{
    字符串 结果 = 宽整数转字符串(尾);
    拼接到(结果, "*2^");
    字符串 指串 = 转字符串(指);
    拼接到(结果, 指串);
    返回 结果;
}

// 定点档:|二进指数| ≤ 53 时用;先取 17 位有效数字,再缩到能原样读回的最短写法。
方法 双精度定点转字符串(宽整数 尾, 整数 指, 整数 二进, 双精度 绝对值) 返回 字符串
{
    有效数字 P = 双精度取有效数字(尾, 指, 二进);
    有效数字 好 = 双精度缩到最短(P.数, P.d, 绝对值);
    字符串 结果 = 双精度定点串转字符串(好.数, 好.d);
    返回 结果;
}

// 打印入口:先分流 NaN / ±Inf / ±0,其余按 整值、定点、二进制 三档挑最短且能读回的写法。
方法 双精度转字符串(双精度 位) 返回 字符串
{
    整数 号 = 双精度取符号(位);
    如果 (双精度是非数(位))
    {
        返回 "NaN";
    }
    如果 (双精度是无穷(位))
    {
        如果 (号 == 1)
        {
            返回 "-Inf";
        }
        返回 "Inf";
    }
    如果 (双精度是零(位))
    {
        如果 (号 == 1)
        {
            返回 "-0";
        }
        返回 "0";
    }
    宽整数 尾 = 双精度取尾数(位);
    整数 指 = 双精度取指数(位);
    整数 二进 = 宽整数位长(尾) - 1 + 指;
    双精度 绝 = 双精度绝对值(位);
    字符串 数值串 = "";
    如果 (指 >= 0 && 指 <= 11)
    {
        数值串 = 双精度整值转字符串(尾, 指);
    }
    否则
    {
        如果 (二进 >= -53 && 二进 <= 53)
        {
            数值串 = 双精度定点转字符串(尾, 指, 二进, 绝);
        }
        否则
        {
            数值串 = 双精度二进制转字符串(尾, 指);
        }
    }
    字符串 结果 = "";
    如果 (号 == 1)
    {
        拼接到(结果, '-');
    }
    拼接到(结果, 数值串);
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 8、解析:十进制文字 → 位模式
//
// 口径:
//   · 收 `[+-]数字[.数字][eE[+-]数字]`;首尾空白自动去掉;空串 / 看不懂 / 尾巴有杂物 → **NaN**
//     也认 `NaN` / `Inf` / `-Inf`
//   · 有效数字最多收 16 位(第 16 位之后只用来决定"要不要把第 16 位抬一")
//   · |十进指数| ≤ 22 **一步算准**(10^22 在双精度里是精确数,一次乘法只有一次舍入);
//     更大按 22 一段一段乘除(可能有 1~2 个最小单位的误差)
//   · 溢出 → ±Inf;小到 0 → ±0
//   · **性能提醒**:热循环里别调它 —— 常量请写位模式(`0x400921FB54442D18`)或用 `双精度常量圆周率()`
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 宽整数整数(< 2^53 时精确)→ 双精度
方法 双精度从整数(宽整数 D) 返回 双精度
{
    宽整数 底 = 宽整数左移(D, 3);
    双精度 结果 = 双精度收尾(底, -3, 0, 0);
    返回 结果;
}

// 10^p(0 ≤ p ≤ 22;每步都精确)
方法 双精度十的幂(整数 p) 返回 双精度
{
    双精度 结果 = 双精度从64(0x3FF00000, 0);
    双精度 十 = 双精度从64(0x40240000, 0);
    整数 i = 0;
    当 (i < p)
    {
        结果 = 双精度乘(结果, 十);
        i = i + 1;
    }
    返回 结果;
}

// 值 = (-1)^号 × D × 10^十次
方法 双精度从十进制(宽整数 D, 整数 十次, 整数 号) 返回 双精度
{
    双精度 结果 = 双精度从64(0, 0);
    如果 (宽整数是零(D))
    {
        结果 = 双精度带符号零(号);
        返回 结果;
    }
    双精度 数 = 双精度从整数(D);
    整数 剩 = 十次;
    当 (剩 > 0)
    {
        整数 步 = 22;
        如果 (剩 < 22)
        {
            步 = 剩;
        }
        双精度 幂 = 双精度十的幂(步);
        数 = 双精度乘(数, 幂);
        剩 = 剩 - 步;
    }
    当 (剩 < 0)
    {
        整数 步2 = 22;
        如果 (0 - 剩 < 22)
        {
            步2 = 0 - 剩;
        }
        双精度 幂2 = 双精度十的幂(步2);
        数 = 双精度除(数, 幂2);
        剩 = 剩 + 步2;
    }
    如果 (号 == 1)
    {
        数 = 双精度取负(数);
    }
    结果 = 数;
    返回 结果;
}

// 十进制数字判定直接用 string.hb 的 是数字(本库已经 包含 "string.hb",不再自带一份)
方法 字符串转双精度(字符串 文本) 返回 双精度
{
    双精度 结果 = 双精度从64(0x7FF80000, 0);
    字符串 s = 去空白(文本);
    整数 n = s.长度();
    如果 (n == 0)
    {
        返回 结果;
    }
    如果 (s == "NaN" || s == "nan")
    {
        返回 结果;
    }
    如果 (s == "Inf" || s == "Infinity" || s == "inf")
    {
        结果 = 双精度从64(0x7FF00000, 0);
        返回 结果;
    }
    如果 (s == "-Inf" || s == "-Infinity" || s == "-inf")
    {
        结果 = 双精度从64(0xFFF00000, 0);
        返回 结果;
    }
    整数 i = 0;
    整数 号 = 0;
    如果 (s[0] == '+' || s[0] == '-')
    {
        如果 (s[0] == '-')
        {
            号 = 1;
        }
        i = 1;
    }
    宽整数 D = 宽整数从32(0);
    整数 位数 = 0;
    整数 十次 = 0;
    整数 有数 = 0;
    整数 有更多 = 0;
    整数 下一位 = 0;
    当 (i < n && 是数字(s[i]))
    {
        有数 = 1;
        如果 (位数 < 16)
        {
            D = 宽整数乘半区(D, 10);
            D.低 = D.低 + (s[i] - '0');
            位数 = 位数 + 1;
        }
        否则
        {
            有更多 = 1;
            十次 = 十次 + 1;                    // 整数位被丢掉一位:量级得补上
            如果 (下一位 == 0)
            {
                下一位 = s[i] - '0';
            }
        }
        i = i + 1;
    }
    如果 (i < n && s[i] == '.')
    {
        i = i + 1;
        当 (i < n && 是数字(s[i]))
        {
            有数 = 1;
            如果 (位数 < 16)
            {
                D = 宽整数乘半区(D, 10);
                D.低 = D.低 + (s[i] - '0');
                位数 = 位数 + 1;
                十次 = 十次 - 1;
            }
            否则
            {
                有更多 = 1;
                如果 (下一位 == 0)
                {
                    下一位 = s[i] - '0';
                }
            }
            i = i + 1;
        }
    }
    如果 (有数 == 0)
    {
        // 一个数字都没有(例如只有 "-" 或 ".")→ 看不懂
        返回 结果;
    }
    如果 (i < n && (s[i] == 'e' || s[i] == 'E'))
    {
        整数 j = i + 1;
        整数 指号 = 0;
        如果 (j < n && (s[j] == '+' || s[j] == '-'))
        {
            如果 (s[j] == '-')
            {
                指号 = 1;
            }
            j = j + 1;
        }
        整数 指值 = 0;
        整数 有指 = 0;
        当 (j < n && 是数字(s[j]))
        {
            有指 = 1;
            如果 (指值 < 100000)
            {
                指值 = 指值 * 10 + (s[j] - '0');
            }
            j = j + 1;
        }
        如果 (有指 == 1)
        {
            如果 (指号 == 1)
            {
                十次 = 十次 - 指值;
            }
            否则
            {
                十次 = 十次 + 指值;
            }
            i = j;
        }
    }
    如果 (i != n)
    {
        返回 结果;
    }
    如果 (有更多 == 1 && 下一位 >= 5)
    {
        D.低 = D.低 + 1;
        如果 (D.低 == 0)
        {
            D.高 = D.高 + 1;
        }
    }
    如果 (宽整数是零(D))
    {
        结果 = 双精度带符号零(号);
        返回 结果;
    }
    结果 = 双精度从十进制(D, 十次, 号);
    返回 结果;
}

// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================
// 9、命名常量(零运行期解析开销)
//   用法:`双精度 圆周率 = 双精度常量圆周率();`
//   (语言层的容器字段只让放基础类型,结构放不进去 —— 所以做成一组取常量的函数;
//    返回的是现成的位模式,零运行期解析开销)
// 口径(2026-10)/提供的函数/英文对照/复杂度:/边界(如实登记):依次见上面那一栏、本页末尾那张公开方法表与各函数紧上面那行注释;越界 / 装不下 / 认不出都不报错、不停机。
// ============================================================

// +0.0 的位模式(0x00000000_00000000):现成常量,省掉一次解析。
方法 双精度常量零() 返回 双精度
{
    双精度 r = 双精度从64(0x00000000, 0x00000000);
    返回 r;
}

// -0.0:只有符号位是 1,阶与尾数全 0(0x80000000_00000000),位模式写死。
方法 双精度常量负零() 返回 双精度
{
    双精度 r = 双精度从64(0x80000000, 0x00000000);
    返回 r;
}

// 1.0:阶域 1023、尾数全 0(0x3FF00000_00000000),返回现成位模式,不做运算。
方法 双精度常量一() 返回 双精度
{
    双精度 r = 双精度从64(0x3FF00000, 0x00000000);
    返回 r;
}

// -1.0:1.0 翻个符号位(0xBFF00000_00000000),取常量不花运行期开销。
方法 双精度常量负一() 返回 双精度
{
    双精度 r = 双精度从64(0xBFF00000, 0x00000000);
    返回 r;
}

// 2.0:阶域 1024、尾数全 0(0x40000000_00000000);现成位模式,零运行期解析。
方法 双精度常量二() 返回 双精度
{
    双精度 r = 双精度从64(0x40000000, 0x00000000);
    返回 r;
}

// 3.0 = 1.5 × 2^1(0x40080000_00000000):位模式预置,小整数常量不用现算。
方法 双精度常量三() 返回 双精度
{
    双精度 r = 双精度从64(0x40080000, 0x00000000);
    返回 r;
}

// 0.5 = 2^-1(0x3FE00000_00000000):阶域 1022、尾数全 0;直接返回这一档位模式。
方法 双精度常量半() 返回 双精度
{
    双精度 r = 双精度从64(0x3FE00000, 0x00000000);
    返回 r;
}

// -0.5 = -2^-1(0xBFE00000_00000000):符号位为 1、其余与 0.5 同,常量现成。
方法 双精度常量负半() 返回 双精度
{
    双精度 r = 双精度从64(0xBFE00000, 0x00000000);
    返回 r;
}

// 10.0(0x40240000_00000000):十进一位的底数;常量现成,零运行期解析。
方法 双精度常量十() 返回 双精度
{
    双精度 r = 双精度从64(0x40240000, 0x00000000);
    返回 r;
}

// 100.0(0x40590000_00000000):位模式写死,省掉 10 × 10 那一乘。
方法 双精度常量百() 返回 双精度
{
    双精度 r = 双精度从64(0x40590000, 0x00000000);
    返回 r;
}

// 1000.0(0x408F4000_00000000):常量位模式现成,省掉 10 的三连乘。
方法 双精度常量千() 返回 双精度
{
    双精度 r = 双精度从64(0x408F4000, 0x00000000);
    返回 r;
}

// 10000.0(0x40C38800_00000000):常用量级的预置常量,零运行期开销。
方法 双精度常量万() 返回 双精度
{
    双精度 r = 双精度从64(0x40C38800, 0x00000000);
    返回 r;
}

// 1e8 = 100000000.0(0x4197D784_00000000):位模式直接给,不必连乘八次十。
方法 双精度常量一亿() 返回 双精度
{
    双精度 r = 双精度从64(0x4197D784, 0x00000000);
    返回 r;
}

// 圆周率 π 最近可表示的双精度值(3.141592653589793):现成常量,不靠解析。
方法 双精度常量圆周率() 返回 双精度
{
    双精度 r = 双精度从64(0x400921FB, 0x54442D18);
    返回 r;
}

// -π:圆周率那条位模式翻个符号位(0xC00921FB_54442D18),零运行期开销。
方法 双精度常量负圆周率() 返回 双精度
{
    双精度 r = 双精度从64(0xC00921FB, 0x54442D18);
    返回 r;
}

// 自然对数的底 e ≈ 2.718281828459045:位模式预置(0x4005BF0A_8B145769)。
方法 双精度常量e() 返回 双精度
{
    双精度 r = 双精度从64(0x4005BF0A, 0x8B145769);
    返回 r;
}

// √2 ≈ 1.4142135623730951:现成位模式(0x3FF6A09E_667F3BCD),不用现开方。
方法 双精度常量根号二() 返回 双精度
{
    双精度 r = 双精度从64(0x3FF6A09E, 0x667F3BCD);
    返回 r;
}

// 最大有限值 ≈ 1.7976931348623157e308:阶域 2046、尾数 52 位全 1,位模式直接给。
方法 双精度常量最大有限() 返回 双精度
{
    双精度 r = 双精度从64(0x7FEFFFFF, 0xFFFFFFFF);
    返回 r;
}

// 最小规格化正数 2^-1022 ≈ 2.2250738585072014e-308:阶域 1、尾数全 0,常量现成。
方法 双精度常量最小规格化() 返回 双精度
{
    双精度 r = 双精度从64(0x00100000, 0x00000000);
    返回 r;
}

// 最小非零正数 = 2^-1074 ≈ 4.9e-324:最低位为 1 的次正规数,位模式写死。
方法 双精度常量最小非零() 返回 双精度
{
    双精度 r = 双精度从64(0x00000000, 0x00000001);
    返回 r;
}

// +Inf:阶域全 1、尾数全 0(0x7FF00000_00000000);常量现成,不必靠除零造。
方法 双精度常量正无穷() 返回 双精度
{
    双精度 r = 双精度从64(0x7FF00000, 0x00000000);
    返回 r;
}

// -Inf:阶域全 1、尾数全 0、符号位 1(0xFFF00000_00000000),零运行期开销。
方法 双精度常量负无穷() 返回 双精度
{
    双精度 r = 双精度从64(0xFFF00000, 0x00000000);
    返回 r;
}

// 非数 NaN:指数全 1、尾数最高位 1(安静非数),位模式现成,零运行期开销。
方法 双精度常量非数() 返回 双精度
{
    双精度 r = 双精度从64(0x7FF80000, 0x00000000);
    返回 r;
}
