// ============================================================
// CSV流.hb —— 大表一行一行吃(不整表进内存;CSV / TSV 共用一套)
//
// 用法:
// ```
// 包含 "../库/CSV流.hb"
// 如果 (CSV流.开读("数据/大表.csv", ","))
// {
//     当 (CSV流.下一条())
//     {
//         整数 i = 0;
//         当 (i < CSV流.字段数())
//         {
//             字符串 一格 = "";
//             CSV流.当前字段(i, 一格);          // 结果写进你那一格(反复用同一格,不涨池)
//             输出行(一格);
//             i = i + 1;
//         }
//     }
//     CSV流.关读();
// }
// // 写:一个字段一个字段地放(带分隔符 / 引号的字段也能如实表达)
// CSV流.开写("数据/结果.csv");
// CSV流.写字段("张三");
// CSV流.写字段("7,5");                         // 会自动包引号
// CSV流.写字段("说\"好\"");
// CSV流.写条尾();                              // 补 `\n` 并写下去
// CSV流.写行("李四,28,杭州");                  // 方便档:简单行(字段里不带分隔符)
// CSV流.关写();
// ```
//
// **几 MB 的表**(日志导出 / 数据清洗)内存里装不下 —— 一条一条读、读完一条就地切好,常驻只占**一行**的份。
//   切段口径与 `CSV.hb` / `string.hb.切分` 那一套对齐(引号里那个分隔符不算分隔、两个连着写的引号算一个引号);
//   分隔串传 `,` 就是 CSV,传 `\t` 就是 TSV。
//
// 口径(2026-10;每条都对着实测写):
//   · **块级读写**:库自己开读写流,一次读一块(4096 字节)进**一个持久的串变量**(反复用同一格),
//     逐字节的活走 `字符` 缓冲(下标 O(1))—— 所以"一行一行吃"**不吃字符串池**;
//   · **一次一条流**:读一条、写一条,各占一个"当前流"(不是 16 格句柄那一档);
//     要同时开两条就自己交错 `关读` / `开读`;
//   · **引号只在"字段开头"才算引号**:中间出现的引号是普通字符;引号包着一段、后面又跟着东西的,
//     以引号里为准、后面到分隔符之间的字节丢掉(与 `CSV.hb` 同一套);
//   · **末尾那个空段照给**:`账号,姓名,` 给 3 段(最后一个是空串);**空行给 1 段**(一个空字段);
//   · **行尾的 `\r` 去掉**(Windows 换行读进来不带 `\r`);末行没有换行也算一条;
//   · **`当前字段` / `当前行` 把结果写进你那一格**(返回值只说"这一段有没有")—— 反复取时那一格是
//     **就地复用**的,长循环里不会一路吃池;`字段数` 是这一条有几段;
//   · **分隔串认单个字节**:`,` / `\t` / `;` 都对;多字节的(比如 `||`)收不下,按 `?` 算(要那种请用 `迭代器.hb`);
//   · **失败给假 / 0**:打不开、没开着、越界都有确定结果,不报错、不停机。
//
// 提供的函数:逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:开 / 关 O(1);`下一条` O(这一条的字节数)(跨块时多一遍块搬动);`当前字段` O(这一段的字节数);
//   `写字段` / `写行` / `写条尾` O(这一条的字节数)。
//
// 内存账:静态**一个 8KB 的行缓冲**(`字符`)+ **一个 4KB 的块缓冲**(串变量)+ 一个 8KB 的写区;
//   一条最长 **8000 字节**、最多 **32 段** —— 超了给假(不截断、不猜)。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **不做"表头 / 列名映射"**:要按列名取就自己记住第几列(第一行当表头自己收下);
//   · **不做"宽松模式"**:引号没配对时当作一直到行尾都是引号里(与 `CSV.hb` 同一条);
//   · **不认"分号 / 制表符自动猜"**:分隔串是你传进来的那一个;
//   · **不做"随机定位"**:只能从头一条条往下走(要跳就 `下一条()` 空转);
//   · **写流不建目录**(内建就是这口径):路径上的目录要自己先建。
// ============================================================
模块 CSV流

// ---------- 模块状态:一条读流 + 一条写流 ----------
私有 字符串 CSV流块;                 // 块缓冲(每次读一块,反复用这一格)
私有 字符 CSV流行区[8192];           // 一条一条吃的缓冲(块读进来就接在这后面)
私有 整数 CSV流行长 = 0;             // 缓冲里现在有多少字节
私有 整数 CSV流位 = 0;               // 下一条从这儿开始
私有 整数 CSV流行起 = 0;
私有 整数 CSV流行止 = 0;
私有 整数 CSV流读完 = 0;             // 读到文件末尾了
私有 字符 CSV流分隔区[8];
私有 整数 CSV流分隔长 = 0;
私有 整数 CSV流段起[32];
私有 整数 CSV流段长[32];
私有 整数 CSV流段引[32];
私有 整数 CSV流段数 = 0;
私有 整数 CSV流读句 = 0 - 1;
私有 整数 CSV流写句 = 0 - 1;
私有 字符串 CSV流行槽;               // 拼输出行的那一格(反复用)
私有 字符串 CSV流片段;               // `写行` 切段时那一片(反复用)
私有 整数 CSV流行有段 = 0;
私有 字符 CSV流字符区[4];            // 一个码点的 UTF-8 字节(拿它与分隔串比)

// ============================================================
// 1、小工具:分隔串 / 字节搬运
// ============================================================

// 把分隔串收进定长区(比较走字节,O(1);多字节的收不下,按 `?` 算)
私有 方法 CSV流收分隔(字符串 分隔)
{
    整数 长 = 分隔.长度();
    如果 (长 == 0)
    {
        CSV流分隔长 = 1;
        CSV流分隔区[0] = ',';
        返回;
    }
    如果 (长 > 8)
    {
        长 = 8;
    }
    CSV流分隔长 = 长;
    整数 i = 0;
    当 (i < CSV流分隔长)
     {
        文字 字 = 分隔[i];
        整数 码 = 字;
        如果 (码 > 255)
        {
            码 = 63;
        }
        CSV流分隔区[i] = 码;
        i = i + 1;
    }
    返回
}

// 行区里第 `位` 个字节起是不是那条分隔串
私有 方法 CSV流是分隔(整数 位) 返回 逻辑
{
    如果 (CSV流分隔长 == 0 || 位 + CSV流分隔长 > CSV流行长)
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < CSV流分隔长)
     {
        如果 (CSV流行区[位 + i] != CSV流分隔区[i])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 把 [起, 止) 这一段搬进"出"参数字符串(引号里那种:两个连着写的引号收成一个)
私有 方法 CSV流搬进槽(整数 起, 整数 止, 逻辑 解引号, 字符串 出 字段)
{
    字段 = "";
    整数 i = 起;
    当 (i < 止)
     {
        如果 (解引号 == 真 && CSV流行区[i] == '"' && i + 1 < 止 && CSV流行区[i + 1] == '"')
        {
            拼接到(字段, '"');
            i = i + 2;
            继续;
        }
        拼接到(字段, CSV流行区[i]);
        i = i + 1;
    }
    返回
}

// ============================================================
// 2、读:一条一条来,来一条就地切好
// ============================================================

// 开一条读流,分隔串空串按 `,` 算(先关掉上一条);打不开给假
方法 开读(字符串 路径, 字符串 分隔) 返回 逻辑
{
    如果 (CSV流读句 >= 0)
    {
        逻辑 先关 = 关读();
    }
    CSV流收分隔(分隔);
    CSV流行长 = 0;
    CSV流位 = 0;
    CSV流行起 = 0;
    CSV流行止 = 0;
    CSV流读完 = 0;
    CSV流段数 = 0;
    CSV流块 = "";
    整数 句 = 0;
    如果 (打开读流(路径, 句) == 假)
    {
        CSV流读句 = 0 - 1;
        返回 假;
    }
    CSV流读句 = 句;
    返回 真;
}

// 关掉读流;本来就没开着也给真,关失败给假
方法 关读() 返回 逻辑
{
    如果 (CSV流读句 < 0)
    {
        返回 真;
    }
    整数 状 = 关读流(CSV流读句);
    CSV流读句 = 0 - 1;
    返回 状 == 0;
}

// 往下取一条并切好段(行尾 `\r` 去掉,末条没换行也算);没有下一条或一条超 8000 字节给假
方法 下一条() 返回 逻辑
{
    如果 (CSV流读句 < 0)
    {
        返回 假;
    }
    当 (真)
     {
        整数 断 = 0 - 1;
        整数 i = CSV流位;
        当 (i < CSV流行长)
         {
            如果 (CSV流行区[i] == '\n')
            {
                断 = i;
                跳出;
            }
            i = i + 1;
        }
        如果 (断 >= 0)
        {
            CSV流行起 = CSV流位;
            CSV流行止 = 断;
            CSV流位 = 断 + 1;
            CSV流收尾();
            CSV流切段();
            返回 真;
        }
        如果 (CSV流位 > 0)
        {
            整数 k = 0;
            整数 j = CSV流位;
            当 (j < CSV流行长)
             {
                CSV流行区[k] = CSV流行区[j];
                k = k + 1;
                j = j + 1;
            }
            CSV流行长 = k;
            CSV流位 = 0;
        }
        如果 (CSV流读完 == 1)
        {
            如果 (CSV流行长 == 0)
            {
                CSV流段数 = 0;
                返回 假;
            }
            CSV流行起 = 0;
            CSV流行止 = CSV流行长;
            CSV流位 = CSV流行长;
            CSV流收尾();
            CSV流切段();
            返回 真;
        }
        整数 长 = 读一块(CSV流读句, CSV流块, 4096);
        如果 (长 <= 0)
        {
            CSV流读完 = 1;
            如果 (CSV流行长 == 0)
            {
                CSV流段数 = 0;
                返回 假;
            }
            继续;
        }
        如果 (CSV流行长 + 长 >= 8192)
        {
            CSV流段数 = 0;
            返回 假;
        }
        CSV流行区[CSV流行长] = 0;
        拼接到(CSV流行区, CSV流块);
        CSV流行长 = CSV流行长 + 长;
    }
    返回 假;
}

// 私有:去掉行尾的 `\r`
私有 方法 CSV流收尾()
{
    当 (CSV流行止 > CSV流行起 && CSV流行区[CSV流行止 - 1] == '\r')
     {
        CSV流行止 = CSV流行止 - 1;
    }
    返回
}

// 私有:把这一条切成段(引号只在字段开头算引号;末尾那个空段照给)
私有 方法 CSV流切段()
{
    CSV流段数 = 0;
    整数 i = CSV流行起;
    当 (i <= CSV流行止)
     {
        如果 (CSV流段数 >= 32)
        {
            返回
        }
        整数 本起 = i;
        整数 本止 = i;
        整数 引号 = 0;
        如果 (i < CSV流行止 && CSV流行区[i] == '"')
         {
            引号 = 1;
            i = i + 1;
            本起 = i;
            当 (i < CSV流行止)
             {
                如果 (CSV流行区[i] == '"')
                 {
                    如果 (i + 1 < CSV流行止 && CSV流行区[i + 1] == '"')
                     {
                        i = i + 2;
                        继续;
                    }
                    跳出;
                }
                i = i + 1;
            }
            本止 = i;
            如果 (i < CSV流行止)
            {
                i = i + 1;
            }
            当 (i < CSV流行止 && CSV流是分隔(i) == 假)
            {
                i = i + 1;
            }
        }
        否则
        {
            当 (i < CSV流行止 && CSV流是分隔(i) == 假)
             {
                i = i + 1;
            }
            本止 = i;
        }
        CSV流段起[CSV流段数] = 本起;
        CSV流段长[CSV流段数] = 本止 - 本起;
        CSV流段引[CSV流段数] = 引号;
        CSV流段数 = CSV流段数 + 1;
        如果 (i >= CSV流行止)
        {
            返回
        }
        i = i + CSV流分隔长;
        如果 (i == CSV流行止)
        {
            如果 (CSV流段数 < 32)
            {
                CSV流段起[CSV流段数] = i;
                CSV流段长[CSV流段数] = 0;
                CSV流段引[CSV流段数] = 0;
                CSV流段数 = CSV流段数 + 1;
            }
            返回
        }
    }
    返回
}
// 把这一条整行(不含换行与行尾 `\r`)写进你那格,引号原样留着;没取到条给假
方法 当前行(字符串 出 行) 返回 逻辑
{
    如果 (CSV流段数 == 0 && CSV流行止 == CSV流行起)
    {
        行 = "";
        返回 假;
    }
    CSV流搬进槽(CSV流行起, CSV流行止, 假, 行);
    返回 真;
}

// 给这一条切出几段(最多 32);没取到条给 0
方法 字段数() 返回 整数
{
    返回 CSV流段数;
}

// 把第 `第几` 段(从 0 起,带引号的解掉引号)写进你那格;越界给假
方法 当前字段(整数 第几, 字符串 出 字段) 返回 逻辑
{
    如果 (第几 < 0 || 第几 >= CSV流段数)
    {
        字段 = "";
        返回 假;
    }
    CSV流搬进槽(CSV流段起[第几], CSV流段起[第几] + CSV流段长[第几], CSV流段引[第几] == 1, 字段);
    返回 真;
}

// ============================================================
// 3、写:一个字段一个字段地放(要引号自己加)
// ============================================================

// 把一个码点的 UTF-8 字节收进小缓冲;返回几个字节
私有 方法 CSV流码点字节(整数 码) 返回 整数
{
    如果 (码 < 128)
    {
        CSV流字符区[0] = 码;
        返回 1;
    }
    如果 (码 < 2048)
    {
        CSV流字符区[0] = 192 + 码 / 64;
        CSV流字符区[1] = 128 + 码 % 64;
        返回 2;
    }
    如果 (码 < 65536)
    {
        CSV流字符区[0] = 224 + 码 / 4096;
        CSV流字符区[1] = 128 + 码 / 64 % 64;
        CSV流字符区[2] = 128 + 码 % 64;
        返回 3;
    }
    CSV流字符区[0] = 240 + 码 / 262144;
    CSV流字符区[1] = 128 + 码 / 4096 % 64;
    CSV流字符区[2] = 128 + 码 / 64 % 64;
    CSV流字符区[3] = 128 + 码 % 64;
    返回 4;
}

// 这个码点在字节上等于分隔串吗
私有 方法 CSV流码点是分隔(整数 码) 返回 逻辑
{
    整数 几个 = CSV流码点字节(码);
    如果 (几个 != CSV流分隔长)
    {
        返回 假;
    }
    整数 i = 0;
    当 (i < 几个)
     {
        如果 (CSV流字符区[i] != CSV流分隔区[i])
        {
            返回 假;
        }
        i = i + 1;
    }
    返回 真;
}

// 这个字段要包引号吗(里面有分隔串 / 引号 / 换行 / 回车)
私有 方法 CSV流字段要引号(字符串 字段) 返回 逻辑
{
    整数 i = 0;
    整数 文字数 = 字段.长度();
    当 (i < 文字数)
     {
        文字 字 = 字段[i];
        整数 码 = 字;
        如果 (码 == 34 || 码 == 10 || 码 == 13)
        {
            返回 真;
        }
        如果 (CSV流码点是分隔(码) == 真)
        {
            返回 真;
        }
        i = i + 1;
    }
    返回 假;
}

// 开一条写流(已存在就从头写起),记下分隔串(先关掉上一条);打不开给假
方法 开写(字符串 路径, 字符串 分隔) 返回 逻辑
{
    如果 (CSV流写句 >= 0)
    {
        逻辑 先关 = 关写();
    }
    CSV流收分隔(分隔);
    CSV流行槽 = "";
    CSV流片段 = "";
    CSV流行有段 = 0;
    整数 句 = 0;
    如果 (打开写流(路径, 句) == 假)
    {
        CSV流写句 = 0 - 1;
        返回 假;
    }
    CSV流写句 = 句;
    返回 真;
}

// 先把没结束的那条补上条尾,再关掉写流落盘;没开着给真,关不掉给假
方法 关写() 返回 逻辑
{
    如果 (CSV流写句 < 0)
    {
        返回 真;
    }
    如果 (CSV流行有段 == 1)
    {
        逻辑 先收 = 写条尾();
    }
    整数 状 = 关写流(CSV流写句);
    CSV流写句 = 0 - 1;
    返回 状 == 0;
}

// 往这一条里放一个字段(该加分隔串与引号的自己加);写流没开着给假
方法 写字段(字符串 字段) 返回 逻辑
{
    如果 (CSV流写句 < 0)
    {
        返回 假;
    }
    如果 (CSV流行有段 == 1)
    {
        逻辑 丢 = CSV流槽加分隔();
    }
    如果 (CSV流字段要引号(字段) == 真)
    {
        拼接到(CSV流行槽, '"');
        整数 i = 0;
        整数 文字数 = 字段.长度();
        当 (i < 文字数)
         {
            文字 字 = 字段[i];
            整数 码 = 字;
            如果 (码 == 34)
            {
                拼接到(CSV流行槽, '"');
            }
            拼接到(CSV流行槽, 字);
            i = i + 1;
        }
        拼接到(CSV流行槽, '"');
    }
    否则
    {
        拼接到(CSV流行槽, 字段);
    }
    CSV流行有段 = 1;
    返回 真;
}

// 给这一条补一个 `\n` 写下去,并清空输出槽;写流没开着给假
方法 写条尾() 返回 逻辑
{
    如果 (CSV流写句 < 0)
    {
        返回 假;
    }
    拼接到(CSV流行槽, "\n");
    整数 写掉 = 写一块(CSV流写句, CSV流行槽, 0);
    CSV流行槽.清空();
    CSV流行有段 = 0;
    返回 写掉 >= 0;
}

// 方便档:整行按分隔串切段逐段写下去(字段里不能带分隔符);没开着给假
方法 写行(字符串 行文本) 返回 逻辑
{
    如果 (CSV流写句 < 0)
    {
        返回 假;
    }
    CSV流片段.清空();
    整数 i = 0;
    整数 文字数 = 行文本.长度();
    当 (i < 文字数)
     {
        文字 字 = 行文本[i];
        整数 码 = 字;
        如果 (CSV流码点是分隔(码) == 真)
        {
            逻辑 丢 = 写字段(CSV流片段);
            CSV流片段.清空();
        }
        否则
        {
            拼接到(CSV流片段, 字);
        }
        i = i + 1;
    }
    逻辑 丢二 = 写字段(CSV流片段);
    CSV流片段.清空();
    返回 写条尾();
}

// 私有:往输出槽里接一个分隔串
私有 方法 CSV流槽加分隔() 返回 逻辑
{
    整数 i = 0;
    当 (i < CSV流分隔长)
     {
        拼接到(CSV流行槽, CSV流分隔区[i]);
        i = i + 1;
    }
    返回 真;
}


// 私有:往行区尾巴上接一个码点的 UTF-8 字节(放不下给假)
私有 方法 CSV流行区加码点(整数 码) 返回 逻辑
{
    如果 (码 < 128)
    {
        如果 (CSV流行长 + 1 > 8192)
        {
            返回 假;
        }
        CSV流行区[CSV流行长] = 码;
        CSV流行长 = CSV流行长 + 1;
        返回 真;
    }
    如果 (码 < 2048)
    {
        如果 (CSV流行长 + 2 > 8192)
        {
            返回 假;
        }
        CSV流行区[CSV流行长] = 192 + 码 / 64;
        CSV流行区[CSV流行长 + 1] = 128 + 码 % 64;
        CSV流行长 = CSV流行长 + 2;
        返回 真;
    }
    如果 (码 < 65536)
    {
        如果 (CSV流行长 + 3 > 8192)
        {
            返回 假;
        }
        CSV流行区[CSV流行长] = 224 + 码 / 4096;
        CSV流行区[CSV流行长 + 1] = 128 + 码 / 64 % 64;
        CSV流行区[CSV流行长 + 2] = 128 + 码 % 64;
        CSV流行长 = CSV流行长 + 3;
        返回 真;
    }
    如果 (CSV流行长 + 4 > 8192)
    {
        返回 假;
    }
    CSV流行区[CSV流行长] = 240 + 码 / 262144;
    CSV流行区[CSV流行长 + 1] = 128 + 码 / 4096 % 64;
    CSV流行区[CSV流行长 + 2] = 128 + 码 / 64 % 64;
    CSV流行区[CSV流行长 + 3] = 128 + 码 % 64;
    CSV流行长 = CSV流行长 + 4;
    返回 真;
}
