// ============================================================
// 列表.hb —— 列表算法库(纯 HB;不动 ISA、不动关键字、不动语言面)
//
// 用法:包含 "../库/列表.hb";调用写 `有效 = 列表.插入到(名单, 有效, 2, 9)`
//
// ★ 这一库收的是**"定长数组 + 有效个数"**(不是语言内建的动态列表):语言里列表的地址**取不出来**
//   (编译器当场报"长大时数据会迁移"),所以**传不进函数**、**不能当模块级变量**。⇒ 本库的函数收
//   "数组 + 有效个数"两个实参,返回值是**做完之后的那个有效个数**;要真动态长缩的列表就用内建的
//   `.添加()` / `.清空()`(那是堆里的容器,不用库)。
//
// 口径(2026-10;每条都对着实测写):
//   · **一律 32 位有符号 `整数`**(语言里列表的元素就是 4 字节);`有效个数` 一律夹回 `[0, 表长]` 再说 ——
//     传大了、传负了都不会越界(不报错、不停机,与 `数组.hb` 一个规矩);
//   · **越界一律"什么都不做"**:`改元素 / 插入到 / 删掉` 的 `下标` 越界就给原样的 `有效个数`
//     (不悄悄夹回边界);要校验写 `是否有效(表, 有效个数, 下标)`;
//   · **`接到尾` 满了给 -1**(表长就是容量,调用方自己判断扩容);
//   · **返回值统一是"做完之后的有效个数"**;`满` 那一档单列一个 -1;
//   · **`去重复` 保持原有先后**(每个值只留**第一次**出现的那一份,后面的整段往前顶;代价 O(n²));
//   · **`拷到` 是整体替换**(把这份表变成那一份),不是追加;要追加用 `合并`;
//   · **空表处处合法**:有效个数 0 时这些动作都给"什么都没做"或 0,不停机;
//   · **不做排序 / 查找 / 集合**:排序在 `排序.hb`、查找在 `查找.hb`、集合运算在 `数组.hb`。
//
// 提供的函数(14 个):是否有效 / 取元素 / 改元素 / 接到尾 / 插入到 / 删掉 / 删掉值 / 查找 / 计数 /
//   反转 / 去重复 / 填充 / 拷到 / 合并;逐条见本页末尾那张公开方法表。
//
// ⚠ **为什么不叫 `添加` / `清空`**:语言把 `.添加(…)` / `.清空()` 当**内建容器方法**(那样的调用会被拦下:
//   "要单独成句,不能写在表达式里")⇒ 库函数叫这两个名字连 `用了 = 列表.添加(…)` 都编不过。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:是否有效 / 取元素 / 改元素 / 接到尾 O(1);插入到 / 删掉 O(有效个数);删掉值 O(有效个数²);
//   查找 / 计数 / 反转 / 填充 / 拷到 / 合并 O(有效个数);去重复 O(有效个数²)。
//
// 边界(如实登记):
//   · **动态列表传不进函数** —— 那是语言面的边界(见文件头那一段);
//   · **元素类型只认 `整数`**(语言里数组 / 列表的元素就是 4 字节整数);
//   · **`满` 只由 `接到尾` 报(-1)**;`插入到 / 合并` 装不下时**能放几格放几格**,返回值是真实的"有效个数";
//   · **不做"整表赋值"**(语言里数组不能整块赋值,所以 `拷到` 是逐格循环)。
// ============================================================
模块 列表

// ---------- 私有:把 `值` 压进 [0, 上界];"有效个数"参数一律先过它 ----------
私有 方法 列表夹回(整数 值, 整数 上界) 返回 整数
{
    如果 (值 < 0)
    {
        返回 0;
    }
    如果 (值 > 上界)
    {
        返回 上界;
    }
    返回 值;
}

// ============================================================
// 1、读写单格
// ============================================================

// 下标在 [0, 有效个数) 里
方法 是否有效(整数 表[], 整数 有效个数, 整数 下标) 返回 逻辑
{
    整数 用了 = 列表夹回(有效个数, 表.长度());
    返回 下标 >= 0 && 下标 < 用了;
}

// 越界给 0(要区分就先问 `是否有效`)
方法 取元素(整数 表[], 整数 有效个数, 整数 下标) 返回 整数
{
    如果 (是否有效(表, 有效个数, 下标) == 假)
    {
        返回 0;
    }
    返回 表[下标];
}

// 越界给 假、什么都不动
方法 改元素(整数 表[], 整数 有效个数, 整数 下标, 整数 值) 返回 逻辑
{
    如果 (是否有效(表, 有效个数, 下标) == 假)
    {
        返回 假;
    }
    表[下标] = 值;
    返回 真;
}

// ============================================================
// 2、增与删(改变"有效个数"的那一半)
// ============================================================

// 接在末尾;返回新的有效个数,装不下给 -1
方法 接到尾(整数 表[], 整数 有效个数, 整数 值) 返回 整数
{
    整数 表长 = 表.长度();
    整数 用了 = 列表夹回(有效个数, 表长);
    如果 (用了 >= 表长)
    {
        返回 -1;
    }
    表[用了] = 值;
    返回 用了 + 1;
}

// 插在 `下标` **之前**;`下标 == 有效个数` 就是"接在末尾"(合法)。越界给原样的有效个数。
// 插在 `下标` 之前(下标 == 有效个数 即接在末尾);越界给原个数
方法 插入到(整数 表[], 整数 有效个数, 整数 下标, 整数 值) 返回 整数
{
    整数 表长 = 表.长度();
    整数 用了 = 列表夹回(有效个数, 表长);
    如果 (下标 < 0 || 下标 > 用了)
    {
        返回 用了;
    }
    如果 (用了 >= 表长)
    {
        返回 用了;                            // 满了:一格都插不进去
    }
    整数 i = 用了;
    当 (i > 下标)
    {
        表[i] = 表[i - 1];
        i = i - 1;
    }
    表[下标] = 值;
    返回 用了 + 1;
}

// 删掉那一格,后面的往前顶;越界给原个数
方法 删掉(整数 表[], 整数 有效个数, 整数 下标) 返回 整数
{
    整数 用了 = 列表夹回(有效个数, 表.长度());
    如果 (下标 < 0 || 下标 >= 用了)
    {
        返回 用了;
    }
    整数 i = 下标;
    当 (i < 用了 - 1)
    {
        表[i] = 表[i + 1];
        i = i + 1;
    }
    返回 用了 - 1;
}

// 删掉所有等于 `值` 的元素;返回新的有效个数
方法 删掉值(整数 表[], 整数 有效个数, 整数 值) 返回 整数
{
    整数 用了 = 列表夹回(有效个数, 表.长度());
    整数 i = 用了 - 1;
    当 (i >= 0)
    {
        如果 (表[i] == 值)
        {
            用了 = 删掉(表, 用了, i);
        }
        i = i - 1;
    }
    返回 用了;
}

// ============================================================
// 3、查 / 数 / 整表动作
// ============================================================

// 第一个等于 `值` 的下标;没有给 -1
方法 查找(整数 表[], 整数 有效个数, 整数 值) 返回 整数
{
    整数 用了 = 列表夹回(有效个数, 表.长度());
    整数 i = 0;
    当 (i < 用了)
    {
        如果 (表[i] == 值)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// `值` 出现几次
方法 计数(整数 表[], 整数 有效个数, 整数 值) 返回 整数
{
    整数 用了 = 列表夹回(有效个数, 表.长度());
    整数 次数 = 0;
    整数 i = 0;
    当 (i < 用了)
    {
        如果 (表[i] == 值)
        {
            次数 = 次数 + 1;
        }
        i = i + 1;
    }
    返回 次数;
}

// 就地倒过来(不动有效个数)
方法 反转(整数 表[], 整数 有效个数)
{
    整数 用了 = 列表夹回(有效个数, 表.长度());
    整数 左 = 0;
    整数 右 = 用了 - 1;
    当 (左 < 右)
    {
        整数 暂 = 表[左];
        表[左] = 表[右];
        表[右] = 暂;
        左 = 左 + 1;
        右 = 右 - 1;
    }
}

// 前 `有效个数` 格写成一个值;返回原有效个数
方法 填充(整数 表[], 整数 有效个数, 整数 值) 返回 整数
{
    整数 用了 = 列表夹回(有效个数, 表.长度());
    整数 i = 0;
    当 (i < 用了)
    {
        表[i] = 值;
        i = i + 1;
    }
    返回 用了;
}

// 去重复:每个值只留**第一次**出现的那一份(保持原有先后);返回新的有效个数。
// 每个值只留第一次出现的那一份;返回新的有效个数
方法 去重复(整数 表[], 整数 有效个数) 返回 整数
{
    整数 用了 = 列表夹回(有效个数, 表.长度());
    整数 i = 用了 - 1;
    当 (i > 0)
    {
        整数 j = 0;
        当 (j < i)
        {
            如果 (表[j] == 表[i])
            {
                用了 = 删掉(表, 用了, i);
                跳出;
            }
            j = j + 1;
        }
        i = i - 1;
    }
    返回 用了;
}

// **整体替换**:把 `来源` 的前 `来源个数` 格抄进 `表`
方法 拷到(整数 表[], 整数 来源[], 整数 来源个数) 返回 整数
{
    整数 来源用了 = 列表夹回(来源个数, 来源.长度());
    整数 可抄 = 来源用了;
    如果 (可抄 > 表.长度())
    {
        可抄 = 表.长度();
    }
    整数 i = 0;
    当 (i < 可抄)
    {
        表[i] = 来源[i];
        i = i + 1;
    }
    返回 可抄;
}

// 把 `另一个` 接在末尾;返回新的有效个数
方法 合并(整数 表[], 整数 有效个数, 整数 另一个[], 整数 另一个个数) 返回 整数
{
    整数 表长 = 表.长度();
    整数 用了 = 列表夹回(有效个数, 表长);
    整数 来源用了 = 列表夹回(另一个个数, 另一个.长度());
    整数 i = 0;
    当 (i < 来源用了)
    {
        如果 (用了 >= 表长)
        {
            返回 用了;
        }
        表[用了] = 另一个[i];
        用了 = 用了 + 1;
        i = i + 1;
    }
    返回 用了;
}
