// ============================================================
// 配置.hb —— 键=值 / INI 配置的读改写回(纯 HB,零依赖,只用文件能力)
//
// 用法:
// ```
// 包含 "../库/配置.hb";
// 整数 本 = 配置.读("配置.ini");
// 字符串 站 = 配置.取(本, "server.host", "127.0.0.1");
// 整数 口 = 配置.取整数(本, "server.port", 8080);
// 配置.设(本, "server.port", "9090");
// 配置.存(本, "配置.ini");
// ```
//
// 治的是小工具第一件事:读配置 —— 语言里只有“读一整个文件”,没有“按段按键取”。
//
// 口径(2026-10;每条都对着实测写):
//   · **一格配置 = 一份键值表**,`读` 给一个**句柄**(`(下标 << 16) | 版本`),同一个进程里最多
//     **2 份**同时在手:`读` 先挑**没用过的那一格**;两格都用过之后才**复用"上一次用过的那一格"**
//     并把它的版本 +1 ⇒ **只有那一格的老句柄**当场作废(查它一律当成"没有"),另一格不受影响;
//   · **每份最多 64 条**:超过就**一条都不进**(`读` 给 -2,不是悄悄丢几条)—— 这是"不留半成品"那条;
//   · **INI 的写法**:`[段]` 开一行 ⇒ 后面的键都归这一段;`#` / `;` 开头的行是注释;
//     空行跳过;`键 = 值` 两边空白都去掉;**没有 `=` 的行忽略**;
//   · **键怎么寻**:`取(本, "host", …)` 找"没有段"的那些键;`取(本, "server.host", …)`
//     找 `[server]` 段里的 `host`(键里带 `.` 就按"段.键"拆)⇒ **段名里不能有 `.`**;
//   · **`读` 的上限 64KB**(`读文件` 的上限要编译期字面量)⇒ 更大的配置这一版读不动(给 -1);
//   · **`存` 按"条数顺序"写回**:没有段的键写在**最前面**(它们不属于任何一段),其余按顺序写,
//     段一变就补一行 `[段]`(同一个段分两处出现就补两次 —— INI 允许,读回来仍是同一段);
//     值里的换行 / `[` 不做转义(配置文件本来就是给人看的);
//   · **不报错、不停机**:打不开给 -1、满了给 -2 / 假,`取` 找不到给默认值。
//
// 提供的函数(7 个):逐条的作用见本页末尾那张公开方法表。
//
// 英文对照:库里不另立英文函数(中英切换只管关键字与内建函数名,现有几个库也都只有中文名)⇒ **没有英文别名**。
//
// 复杂度:`读` O(文件大小 + `取`/`设` 的条数 × 键长);`取` / `设` 是**线性找**(最多 64 条)——
//   配置就几十条,够用;要快的键值查找用 `map.hb`。
//
// 边界(如实登记,不写"编译器的毛病 + 绕法"):
//   · **不做"改一行、留格式"的写回**:`存` 是**整份重写**(注释与键的原始顺序不保留)——
//     要保留注释请把注释写在文件头、或者自己拼文本(那不是配置库的事);
//   · **不做默认值文件 / 不做嵌套段 / 不做数组值**:要这几档自己按"段.键"多写几行;
//   · **同一份配置不许两个人同时用**:这一库不带锁,单线程用。
// ============================================================
模块 配置

私有 整数 份数 = 2;
私有 整数 每份 = 64;
私有 字符串 段表[128];                  // 按 份 * 每份 + 序号 排
私有 字符串 键表[128];
私有 字符串 值表[128];
私有 整数 条数表[2];
私有 整数 版本表[2];
私有 整数 当前份 = 0;

// 解析 / 拆键用的中间量(单线程;不来回传字符串,免得撞上"出参数"那条边界)
私有 字符串 临时[3];                  // [0] 段 / [1] 键 / [2] 值(模块级标量字符串那一档不稳,用数组)

// ---------- 私有:空白与去空白 ----------
私有 方法 配置是空白(整数 码) 返回 逻辑
{
    返回 码 == 32 || 码 == 9 || 码 == 13;
}

// 去首尾空白(单线程:借 `临时[2]` 里先攒起来再返回)
私有 方法 配置去空白(字符串 文本) 返回 字符串
{
    整数 个数 = 文本.长度();
    整数 起 = 0;
    整数 止 = 个数;
    当 (起 < 止 && 配置是空白(文本[起]))
    {
        起 = 起 + 1;
    }
    当 (止 > 起 && 配置是空白(文本[止 - 1]))
    {
        止 = 止 - 1;
    }
    字符串 结果 = "";
    整数 i = 起;
    当 (i < 止)
    {
        拼接到(结果, 文本[i]);
        i = i + 1;
    }
    返回 结果;
}

// ---------- 私有:按码点切一段(起 含、止 不含) ----------
私有 方法 配置取段(字符串 文本, 整数 起, 整数 止) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 起;
    当 (i < 止 && i < 文本.长度())
    {
        拼接到(结果, 文本[i]);
        i = i + 1;
    }
    返回 结果;
}

// ---------- 私有:`[段]` 那种行 ----------
私有 方法 配置是段行(字符串 行) 返回 逻辑
{
    整数 个数 = 行.长度();
    如果 (个数 < 2)
    {
        返回 假;
    }
    返回 行[0] == 91 && 行[个数 - 1] == 93;
}

// ---------- 私有:行里第一个 '=' 的位置(没有给 -1) ----------
私有 方法 配置找等号(字符串 行) 返回 整数
{
    整数 i = 0;
    当 (i < 行.长度())
    {
        如果 (行[i] == 61)
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

// ---------- 私有:把一行拆成 段 / 键 / 值(填那三个模块级临时量) ----------
//   行已经去过首尾空白。`[段]` 那种行:临时[0] = 段名,临时[1] = ""(空 = 这一行不是键值)
// ---------- 私有:`#` / `;` 开头的注释行 ----------
私有 方法 配置是注释行(字符串 行) 返回 逻辑
{
    返回 行[0] == 35 || 行[0] == 59;
}

// ---------- 私有:下面四个都是"一条语句一个帮手" ----------
//   ⚠ 帧是"参数 / 局部 / 表达式临时槽共用的一块"(96 字节)⇒ 嵌套调用一多就报「帧超出」,
//     所以 `配置去空白(配置取段(…))` 这种算式一个帮手只放一条。
私有 方法 配置设段(字符串 行)
{
    临时[0] = 配置去空白(配置取段(行, 1, 行.长度() - 1));
}

私有 方法 配置填键(字符串 行, 整数 等号)
{
    临时[1] = 配置去空白(配置取段(行, 0, 等号));
}

私有 方法 配置填值(字符串 行, 整数 等号)
{
    临时[2] = 配置去空白(配置取段(行, 等号 + 1, 行.长度()));
}

// ---------- 私有:把一行拆成 段 / 键 / 值(填那三个模块级临时量) ----------
//   行已经去过首尾空白。`[段]` 那种行:临时[0] = 段名,临时[1] = ""(空 = 这一行不是键值)
私有 方法 配置拆行(字符串 行)
{
    临时[1] = "";
    临时[2] = "";
    如果 (行.长度() == 0)
    {
        返回;
    }
    如果 (配置是注释行(行))
    {
        返回;
    }
    如果 (配置是段行(行))
    {
        配置设段(行);
        返回;
    }
    整数 等号 = 配置找等号(行);
    如果 (等号 < 0)
    {
        返回;
    }
    配置填键(行, 等号);
    配置填值(行, 等号);
}

// ---------- 私有:句柄 → 当前份(认不出给假) ----------
私有 方法 配置验句柄(整数 句柄) 返回 逻辑
{
    整数 下标 = 句柄 >> 16;
    整数 版本 = 句柄 & 65535;
    如果 (下标 < 0 || 下标 >= 份数 || 版本 == 0)
    {
        返回 假;
    }
    如果 (版本表[下标] != 版本)
    {
        返回 假;
    }
    当前份 = 下标;
    返回 真;
}

// ---------- 私有:配置找一条(找到填 `当前条`,找不到给假) ----------
私有 整数 当前条 = 0;

私有 方法 配置找一条(整数 份号, 字符串 段, 字符串 键) 返回 逻辑
{
    整数 i = 0;
    当 (i < 条数表[份号])
    {
        整数 格 = 份号 * 每份 + i;
        如果 (段表[格] == 段 && 键表[格] == 键)
        {
            当前条 = i;
            返回 真;
        }
        i = i + 1;
    }
    返回 假;
}

// ---------- 私有:把 `段.键` 拆成两截(填 临时[0] / 临时[1]) ----------
私有 方法 配置拆键(字符串 全键)
{
    整数 个数 = 全键.长度();
    整数 i = 0;
    当 (i < 个数)
    {
        如果 (全键[i] == 46)            // '.'
        {
            临时[0] = 配置取段(全键, 0, i);
            临时[1] = 配置取段(全键, i + 1, 个数);
            返回;
        }
        i = i + 1;
    }
    临时[0] = "";
    临时[1] = 全键;
}

// ---------- 私有:十进制文本 → 整数(认不出给假) ----------
私有 方法 配置文本转整数(字符串 文本, 引用 整数 值) 返回 逻辑
{
    值 = 0;
    整数 个数 = 文本.长度();
    如果 (个数 == 0)
    {
        返回 假;
    }
    整数 起 = 0;
    整数 负 = 0;
    如果 (文本[0] == 45)                // '-'
    {
        负 = 1;
        起 = 1;
    }
    如果 (起 >= 个数)
    {
        返回 假;
    }
    整数 累 = 0;
    整数 i = 起;
    当 (i < 个数)
    {
        整数 码 = 文本[i];
        如果 (码 < 48 || 码 > 57)
        {
            返回 假;
        }
        累 = 累 * 10 + (码 - 48);
        i = i + 1;
    }
    如果 (负 == 1)
    {
        累 = 0 - 累;
    }
    值 = 累;
    返回 真;
}

// ---------- 公开:读 / 取 / 设 / 存 ----------

// 读一份 INI 给句柄:打不开给 -1,超过 64 条一条不进给 -2
方法 读(字符串 路径) 返回 整数
{
    整数 空位 = -1;
    整数 i = 0;
    当 (i < 份数)
    {
        整数 版本 = 版本表[i] & 65535;
        如果 (版本 == 0)
        {
            空位 = i;
            跳出;
        }
        i = i + 1;
    }
    如果 (空位 < 0)
    {
        空位 = 当前份;                      // 没有空位:重读当前那一份
    }
    字符串 内容 = "";
    如果 (读文件(路径, 内容, 65536) == 假)
    {
        返回 -1;                            // 不在 / 太大 / 读不动
    }
    整数 个数 = 内容.长度();
    整数 起 = 0;
    整数 行起 = 0;
    临时[0] = "";
    整数 条 = 0;
    当 (行起 <= 个数)
    {
        // 一行的范围 = [行起, 行末)
        整数 行末 = 行起;
        当 (行末 < 个数 && 内容[行末] != 10)
        {
            行末 = 行末 + 1;
        }
        配置拆行(配置去空白(配置取段(内容, 行起, 行末)));
        如果 (临时[1].长度() > 0)
        {
            如果 (条 >= 每份)
            {
                返回 -2;                    // 超过 64 条:一条都没进
            }
            段表[空位 * 每份 + 条] = 临时[0];
            键表[空位 * 每份 + 条] = 临时[1];
            值表[空位 * 每份 + 条] = 临时[2];
            条 = 条 + 1;
        }
        如果 (行末 >= 个数)
        {
            跳出;
        }
        行起 = 行末 + 1;
    }
    条数表[空位] = 条;
    版本表[空位] = (版本表[空位] & 65535) + 1;
    如果 (版本表[空位] == 0)
    {
        版本表[空位] = 1;
    }
    当前份 = 空位;
    返回 (空位 << 16) | (版本表[空位] & 65535);
}

// 按 段.键 取字符串值;没有这一条或句柄作废都给默认值
方法 取(整数 句柄, 字符串 键, 字符串 默认值) 返回 字符串
{
    如果 (配置验句柄(句柄) == 假)
    {
        返回 默认值;
    }
    配置拆键(键);
    如果 (配置找一条(当前份, 临时[0], 临时[1]) == 假)
    {
        返回 默认值;
    }
    返回 值表[当前份 * 每份 + 当前条];
}

// 按 段.键 取整数:文本不是十进制整数也给默认值
方法 取整数(整数 句柄, 字符串 键, 整数 默认值) 返回 整数
{
    如果 (配置验句柄(句柄) == 假)
    {
        返回 默认值;
    }
    配置拆键(键);
    如果 (配置找一条(当前份, 临时[0], 临时[1]) == 假)
    {
        返回 默认值;
    }
    整数 值 = 0;
    如果 (配置文本转整数(值表[当前份 * 每份 + 当前条], 值) == 假)
    {
        返回 默认值;
    }
    返回 值;
}

// 按 段.键 取逻辑:1 / 真 / true / 是 给真,0 / 假 / false / 否 给假,其余给默认值
方法 取逻辑(整数 句柄, 字符串 键, 逻辑 默认值) 返回 逻辑
{
    字符串 文本 = 取(句柄, 键, "");
    如果 (文本 == "1" || 文本 == "真" || 文本 == "true" || 文本 == "是")
    {
        返回 真;
    }
    如果 (文本 == "0" || 文本 == "假" || 文本 == "false" || 文本 == "否")
    {
        返回 假;
    }
    返回 默认值;
}

// 改一条已有配置或新增一条;空键、句柄作废、满了(64 条)都给假
方法 设(整数 句柄, 字符串 键, 字符串 值) 返回 逻辑
{
    如果 (配置验句柄(句柄) == 假)
    {
        返回 假;
    }
    配置拆键(键);
    如果 (临时[1].长度() == 0)
    {
        返回 假;                            // 空键不收
    }
    如果 (配置找一条(当前份, 临时[0], 临时[1]))
    {
        值表[当前份 * 每份 + 当前条] = 值;
        返回 真;
    }
    如果 (条数表[当前份] >= 每份)
    {
        返回 假;                            // 满了
    }
    整数 格 = 当前份 * 每份 + 条数表[当前份];
    段表[格] = 临时[0];
    键表[格] = 临时[1];
    值表[格] = 值;
    条数表[当前份] = 条数表[当前份] + 1;
    返回 真;
}

// 整份写回文件:无段的键写最前,段一变补一行 [段];不保留原注释
方法 存(整数 句柄, 字符串 路径) 返回 逻辑
{
    如果 (配置验句柄(句柄) == 假)
    {
        返回 假;
    }
    字符串 全文 = "";
    字符 换行符 = 10;
    整数 i = 0;
    当 (i < 条数表[当前份])                  // 第一趟:没有段的键写在**最前面**(它们不属于任何一段)
    {
        整数 格 = 当前份 * 每份 + i;
        如果 (段表[格].长度() == 0)
        {
            拼接到(全文, 键表[格]);
            拼接到(全文, '=');
            拼接到(全文, 值表[格]);
            拼接到(全文, 换行符);
        }
        i = i + 1;
    }
    // 第二趟:带段的键按"条数顺序"写,段一变就补一行 `[段]` —— 字符串数组元素不能赋给标量字符串
    // (语言口径),所以这里拿"上一次真写出去的格"比,不另存一个"上一段"的标量。
    整数 上次 = 0 - 1;
    i = 0;
    当 (i < 条数表[当前份])
    {
        整数 格2 = 当前份 * 每份 + i;
        如果 (段表[格2].长度() > 0)
        {
            整数 换段 = 0;
            如果 (上次 < 0)
            {
                换段 = 1;
            }
            如果 (上次 >= 0 && 段表[格2] != 段表[上次])
            {
                换段 = 1;
            }
            如果 (换段 == 1)
            {
                拼接到(全文, '[');
                拼接到(全文, 段表[格2]);
                拼接到(全文, ']');
                拼接到(全文, 换行符);
            }
            拼接到(全文, 键表[格2]);
            拼接到(全文, '=');
            拼接到(全文, 值表[格2]);
            拼接到(全文, 换行符);
            上次 = i;
        }
        i = i + 1;
    }
    返回 写文件(路径, 全文);
}

// 这一份现在有几条(句柄无效给 -1)
方法 条数(整数 句柄) 返回 整数
{
    如果 (配置验句柄(句柄) == 假)
    {
        返回 -1;
    }
    返回 条数表[当前份];
}


