// ============================================================
// map.hb —— 哈希表库(字符串 → 整数 的映射;纯 HB 库,不动 ISA、不动关键字)
//
// 用法:包含 "../库/map.hb";一张表就是一个 `哈希表` 结构(桶 + 三份条目数组)。
//
// 口径(2026-09):
//   · **键**住全库共用的 `字符串 哈希表键池`,条目里的 `键号` 就是键池下标 ⇒
//     一份键池给所有 `哈希表` 共用;**键池只增不减**(删掉的键还留着,`清空表` 也不回收);
//   · **值是 32 位整数**;冲突用**拉链**,桶数按需翻倍(头一次 8 个桶,永远是 2 的幂,装载因子到 1/2 就翻倍);落桶用 `& (桶数 - 1)` 而不是 `%`(桶数是 2 的幂;`%` 是有符号取余,哈希值超过 2^31 会算出负数下标);
//   · **不报错、不停机、不写错误槽**:没有就是 假,删不掉就是 假;
//   · **删除不还地方**:链上摘掉、读不到了,条目还在那三个数组里留着 ⇒ 长期"删了又加"要自己盯内存,
//     要重新开始就 `清空表`(块留着接着用);
//
// 遍历:游标在调用方手里(库不留任何全局状态)—— `遍历开始(表, 走)` 之后
//   写 `当 (遍历下一个(表, 走))`,用 `条目键(表, 走.条目)` / `条目值(表, 走.条目)` 取当前这一条。
//
// 英文对照:清空表 clear · 存放 put · 取出 get · 有键 hasKey · 删除 remove · 条目数 count
//   桶数 buckets · 字符串哈希 hash · 遍历开始 / 遍历下一个 / 条目键 / 条目值 walk
// ============================================================

// 提供的函数(14 个):逐个见下面那张公开方法表。
// 复杂度:查 / 存 / 删平均 O(1)(拉链 + 桶数翻倍);桶数翻倍那一次 O(条目数)。
// 边界(如实登记):键池只增不减;一条目 12 字节、一个桶 4 字节,一万条实测要 `堆 640KB` + `池 192KB`,默认 `堆 64KB` 只够几百条。
// 一张哈希表:桶 + 三份条目数组 + 活着的个数(一份键池给所有表共用)。
结构 哈希表
{
    整数 桶[];       // 桶位 → 第一条目号 + 1(0 = 空桶)
    整数 键号[];     // 条目 → 键池下标
    整数 值[];       // 条目 → 值
    整数 下一项[];   // 条目 → 同桶下一条目号 + 1(0 = 链尾)
    整数 个数;       // 活着的条目数(删掉的不算)
}

// 遍历游标(在调用方手里,库不留全局状态)。
结构 哈希遍历器
{
    整数 桶位;       // 下一个要看的桶位
    整数 条目;       // 最近给出的条目号(-1 = 还没给出)
}

字符串 哈希表键池[];

// 哈希:FNV-1a,按**文字**(Unicode 码点)算;相等字符串必得同一个值(只用来分桶)。
方法 字符串哈希(字符串 键) 返回 无符号整数
{
    无符号整数 结果 = 2166136261;
    整数 长 = 键.长度();
    整数 i = 0;
    当 (i < 长)
    {
        文字 某字 = 键[i];
        无符号整数 码 = 某字;
        结果 = (结果 ^ 码) * 16777619;
        i = i + 1;
    }
    返回 结果;
}

// 清空:把表的四份状态清掉(块留着,不还堆 —— 反复用不折腾堆)。
方法 清空表(哈希表 表)
{
    表.桶.清空();
    表.键号.清空();
    表.值.清空();
    表.下一项.清空();
    表.个数 = 0;
    返回
}

// 桶数翻倍:只重挂链(条目数组一个不动)。
方法 桶数翻倍(哈希表 表) 返回 整数
{
    整数 旧桶数 = 表.桶.长度();
    整数 k = 0;
    当 (k < 旧桶数)
    {
        表.桶.添加(0);
        k = k + 1;
    }
    整数 新桶数 = 表.桶.长度();
    整数 位 = 0;
    当 (位 < 旧桶数)
    {
        整数 当前 = 表.桶[位];
        整数 前一 = 0;
        当 (当前 != 0)
        {
            整数 条目 = 当前 - 1;
            整数 键号 = 表.键号[条目];
            整数 后继 = 表.下一项[条目];
            整数 新位 = 字符串哈希(哈希表键池[键号]) & (新桶数 - 1);
            如果 (新位 != 位)
            {
                如果 (前一 == 0)
                {
                    表.桶[位] = 后继;
                }
                否则
                {
                    // 注意:`当前`/`前一`都是"条目号 + 1"(0 当空),取条目要减 1 —— 摘链时写的是
                // `下一项[前一 - 1]`,写成 `下一项[前一]` 会摘掉**后一个**条目(链条静悄悄断掉)。
                表.下一项[前一 - 1] = 后继;
                }
                表.下一项[条目] = 表.桶[新位];
                表.桶[新位] = 当前;
            }
            否则
            {
                前一 = 当前;
            }
            当前 = 后继;
        }
        位 = 位 + 1;
    }
    返回 新桶数;
}

// 私有:找条目;找到给条目号,没有给 -1。
方法 找条目(哈希表 表, 字符串 键) 返回 整数
{
    如果 (表.桶.长度() == 0)
    {
        返回 -1;
    }
    整数 码 = 字符串哈希(键);
    整数 位 = 码 & (表.桶.长度() - 1);
    整数 当前 = 表.桶[位];
    当 (当前 != 0)
    {
        整数 条目 = 当前 - 1;
        整数 键号 = 表.键号[条目];
        如果 (哈希表键池[键号] == 键)
        {
            返回 条目;
        }
        当前 = 表.下一项[条目];
    }
    返回 -1;
}

// 存放:有就改值,没有就新添(不返回值;要问"本来是哪一个"用 `有键`)。
方法 存放(哈希表 表, 字符串 键, 整数 值)
{
    如果 (表.桶.长度() == 0)
    {
        整数 k = 0;
        当 (k < 8)
        {
            表.桶.添加(0);
            k = k + 1;
        }
    }
    整数 码 = 字符串哈希(键);
    整数 位 = 码 & (表.桶.长度() - 1);
    整数 当前 = 表.桶[位];
    当 (当前 != 0)
    {
        整数 条目 = 当前 - 1;
        整数 键号 = 表.键号[条目];
        如果 (哈希表键池[键号] == 键)
        {
            表.值[条目] = 值;
            返回
        }
        当前 = 表.下一项[条目];
    }
    如果 ((表.个数 + 1) * 2 > 表.桶.长度())
    {
        桶数翻倍(表);
        位 = 码 & (表.桶.长度() - 1);
    }
    哈希表键池.添加(键);
    表.键号.添加(哈希表键池.长度() - 1);
    表.值.添加(值);
    表.下一项.添加(表.桶[位]);
    表.桶[位] = 表.键号.长度();
    表.个数 = 表.个数 + 1;
    返回
}

// 取出:有就给 真 并把值写进 `收值`;没有给 假(不动 `收值`)。
方法 取出(哈希表 表, 字符串 键, 引用 整数 收值) 返回 逻辑
{
    整数 条目 = 找条目(表, 键);
    如果 (条目 < 0)
    {
        返回 假;
    }
    收值 = 表.值[条目];
    返回 真;
}

// 有键:这个键在不在。
方法 有键(哈希表 表, 字符串 键) 返回 逻辑
{
    返回 找条目(表, 键) >= 0;
}

// 删除:从链上摘掉(条目数组里那份留着,读不到了);真 = 删掉了一个。
方法 删除(哈希表 表, 字符串 键) 返回 逻辑
{
    如果 (表.桶.长度() == 0)
    {
        返回 假;
    }
    整数 码 = 字符串哈希(键);
    整数 位 = 码 & (表.桶.长度() - 1);
    整数 当前 = 表.桶[位];
    整数 前一 = 0;
    当 (当前 != 0)
    {
        整数 条目 = 当前 - 1;
        整数 键号 = 表.键号[条目];
        整数 后继 = 表.下一项[条目];
        如果 (哈希表键池[键号] == 键)
        {
            如果 (前一 == 0)
            {
                表.桶[位] = 后继;
            }
            否则
            {
                // 注意:`当前`/`前一`都是"条目号 + 1"(0 当空),取条目要减 1 —— 摘链时写的是
                // `下一项[前一 - 1]`,写成 `下一项[前一]` 会摘掉**后一个**条目(链条静悄悄断掉)。
                表.下一项[前一 - 1] = 后继;
            }
            表.个数 = 表.个数 - 1;
            返回 真;
        }
        前一 = 当前;
        当前 = 后继;
    }
    返回 假;
}

// 活着的条目数(删掉的不算)。
方法 条目数(哈希表 表) 返回 整数
{
    返回 表.个数;
}

// 现在有几个桶(看装载因子 / 撞冲突用)。
方法 桶数(哈希表 表) 返回 整数
{
    返回 表.桶.长度();
}

// 遍历:一条链走完再走下一个桶(游标在调用方手里)。
方法 遍历开始(哈希表 表, 哈希遍历器 走)
{
    走.桶位 = 0;
    走.条目 = -1;
    返回
}

// 走到下一条;走完给 假。
方法 遍历下一个(哈希表 表, 哈希遍历器 走) 返回 逻辑
{
    如果 (走.条目 >= 0)
    {
        整数 上个条目 = 走.条目;
        整数 后继 = 表.下一项[上个条目];
        如果 (后继 != 0)
        {
            走.条目 = 后继 - 1;
            返回 真;
        }
    }
    当 (走.桶位 < 表.桶.长度())
    {
        整数 位 = 走.桶位;
        走.桶位 = 位 + 1;
        整数 头 = 表.桶[位];
        如果 (头 != 0)
        {
            走.条目 = 头 - 1;
            返回 真;
        }
    }
    走.条目 = -1;
    返回 假;
}

// 这一条的键(条目号从 `遍历下一个` 来)。
方法 条目键(哈希表 表, 整数 条目) 返回 字符串
{
    字符串 结果;
    整数 键号 = 表.键号[条目];
    拼接到(结果, 哈希表键池[键号]);
    返回 结果;
}

// 这一条的值。
方法 条目值(哈希表 表, 整数 条目) 返回 整数
{
    返回 表.值[条目];
}
