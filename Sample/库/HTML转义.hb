// ============================================================
// HTML转义.hb —— HTML / XML 的五个字符转义与反转义(纯 HB,零依赖)
//
// 用法:包含 "../库/HTML转义.hb";然后 `HTML转义.转义(用户输入)` / `HTML转义.反转义(实体)`。
//
// 口径(2026-10):
//   · **转义只认五个**:`&` → `&amp;` · `<` → `&lt;` · `>` → `&gt;` · `"` → `&quot;` ·
//     `'` → `&#39;`;`&` **先换**;其余字符一个都不动(中文 / emoji / 换行照旧),不做"把非 ASCII 换实体"。
//   · **反转义认六个名字**:`amp` `lt` `gt` `quot` `apos` `nbsp`(不区分大小写),外加数字实体
//     `&#NN;` 与 `&#xHH;`;**必须带结尾的 `;`**,没写 `;` 的照原样搬过去。
//   · **认不出的照原样搬**(`&foo;` 还是 `&foo;`):不报错、不停机、不吞字符;解出来的文字按码点拼。
//
// 英文对照:转义 escapeHtml · 反转义 unescapeHtml
// 复杂度:O(文本长度);空间 O(结果长度)。
//
// 边界(如实登记):
//   · 不做"属性专用"的 `转义属性` —— 属性值与正文是同一套五个字符;
//   · **不认 HTML5 那一千多个命名实体**(`&copy;` `&mdash;` 这类),只有上面六个 + 数字实体;
//   · **`&#99999999;` 这种超范围的数字实体照码点拼**,合不合法由语言自己管,这一库不拦;
//   · 结果边长边拼,十几兆的页面请配合 `缓冲.hb` 自己写。
// 提供的函数(2 个):逐个见下面那张公开方法表。
// ============================================================
模块 HTML转义

// 私有:一个文字是不是十进制数字
私有 方法 HTML转义是十进制位(文字 某字) 返回 逻辑
{
    如果 (某字 >= '0' && 某字 <= '9')
    {
        返回 真;
    }
    返回 假;
}

// 私有:一个文字的值(十六进制位);不是给 -1
私有 方法 HTML转义十六进制值(文字 某字) 返回 整数
{
    如果 (某字 >= '0' && 某字 <= '9')
    {
        返回 某字 - '0';
    }
    如果 (某字 >= 'a' && 某字 <= 'f')
    {
        返回 某字 - 'a' + 10;
    }
    如果 (某字 >= 'A' && 某字 <= 'F')
    {
        返回 某字 - 'A' + 10;
    }
    返回 -1;
}

// 文本 → 转义后的文本:五个字符换成实体(`&` 先换)
方法 转义(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    整数 长 = 文本.长度();
    整数 i = 0;
    当 (i < 长)
    {
        文字 某字 = 文本[i];
        如果 (某字 == '&')
        {
            拼接到(结果, "&amp;");
        }
        否则 如果 (某字 == '<')
        {
            拼接到(结果, "&lt;");
        }
        否则 如果 (某字 == '>')
        {
            拼接到(结果, "&gt;");
        }
        否则 如果 (某字 == '"')
        {
            拼接到(结果, "&quot;");
        }
        否则 如果 (某字 == '\'')
        {
            拼接到(结果, "&#39;");
        }
        否则
        {
            拼接到(结果, 某字);
        }
        i = i + 1;
    }
    返回 结果;
}

// 私有:命名实体那张小表(不区分大小写);认不出给 -1
私有 方法 HTML转义命名实体(字符串 名字) 返回 整数
{
    整数 长 = 名字.长度();
    如果 (长 == 2)
    {
        如果 ((名字[0] == 'l' || 名字[0] == 'L') && (名字[1] == 't' || 名字[1] == 'T'))
        {
            返回 60;                            // <
        }
        如果 ((名字[0] == 'g' || 名字[0] == 'G') && (名字[1] == 't' || 名字[1] == 'T'))
        {
            返回 62;                            // >
        }
    }
    如果 (长 == 3)
    {
        如果 ((名字[0] == 'a' || 名字[0] == 'A') && (名字[1] == 'm' || 名字[1] == 'M') && (名字[2] == 'p' || 名字[2] == 'P'))
        {
            返回 38;                            // &
        }
    }
    如果 (长 == 4)
    {
        如果 ((名字[0] == 'q' || 名字[0] == 'Q') && (名字[1] == 'u' || 名字[1] == 'U') && (名字[2] == 'o' || 名字[2] == 'O') && (名字[3] == 't' || 名字[3] == 'T'))
        {
            返回 34;                            // "
        }
        如果 ((名字[0] == 'a' || 名字[0] == 'A') && (名字[1] == 'p' || 名字[1] == 'P') && (名字[2] == 'o' || 名字[2] == 'O') && (名字[3] == 's' || 名字[3] == 'S'))
        {
            返回 39;                            // '
        }
        如果 ((名字[0] == 'n' || 名字[0] == 'N') && (名字[1] == 'b' || 名字[1] == 'B') && (名字[2] == 's' || 名字[2] == 'S') && (名字[3] == 'p' || 名字[3] == 'P'))
        {
            返回 160;                           // 不换行空格
        }
    }
    返回 -1;
}

// 实体换回字符;认不出的(含光一个 `&`)照原样搬过去
方法 反转义(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    整数 长 = 文本.长度();
    整数 i = 0;
    当 (i < 长)
    {
        如果 (文本[i] != '&')
        {
            拼接到(结果, 文本[i]);
            i = i + 1;
        }
        否则
        {
            // 先看 `;` 在哪(最多往后 16 个字符 —— 实体没那么长);没写 `;` 也认(`&amp` 这种)
            整数 止 = -1;
            整数 找 = i + 1;
            当 (找 < 长 && 找 <= i + 16)
            {
                如果 (文本[找] == ';')
                {
                    止 = 找;
                    跳出;
                }
                找 = 找 + 1;
            }
            整数 名止 = 长;
            如果 (止 >= 0)
            {
                名止 = 止;
            }
            如果 (名止 > i + 16)
            {
                名止 = i + 16;
            }
            // ⚠ 这一段是实测修出来的一处真缺陷:名字那一支**必须只取到 `;` 为止** ——
            //   第一版拿"越过 `;` 的 `名止`"往前试最长前缀,`&lt;b&gt;` 里第一个 `&` 后面被看成
            //   `lt;b`(含 `;` 与后面那个 `b`),`HTML转义命名实体` 认不出 ⇒ 那个 `&` 照原样留着、
            //   后面几个字符跟着一个个搬过去 —— 输出就变成"实体没解、字符还在,但整体错位"的样子
                        //   修法:**`名止` = `;` 的位置**(名字只取到 `;` 前);数字那一支从 `名止` **再往前收**到最后一个数字。
            逻辑 认出来了 = 假;
            整数 号码 = 0;                          // 解出来的码点(命名实体与数字实体共用一格;
            // **要用 `整数` 收**:用一个 `文字` 收的话
            // `HTML转义命名实体` 返回的 -1 会当成码点编成一段乱字节)
            文字 码 = 0;
            如果 (止 >= 0 && i + 1 < 名止)
            {
                如果 (文本[i + 1] == '#')
                {
                    // 数字实体:`&#NN` 十进制 / `&#xHH` 十六进制
                    整数 起 = i + 2;
                    整数 基 = 10;
                    如果 (起 < 名止 && (文本[起] == 'x' || 文本[起] == 'X'))
                    {
                        基 = 16;
                        起 = 起 + 1;
                    }
                    整数 位 = 0;
                    当 (起 + 位 <= 名止)
                    {
                        文字 某字 = 文本[起 + 位];
                        整数 数 = -1;
                        如果 (HTML转义是十进制位(某字))
                        {
                            数 = 某字 - '0';
                        }
                        如果 (基 == 16)
                        {
                            数 = HTML转义十六进制值(某字);
                        }
                        如果 (数 < 0)
                        {
                            跳出;
                        }
                        号码 = 号码 * 基 + 数;
                        位 = 位 + 1;
                    }
                    如果 (位 > 0)
                    {
                        码 = 号码;
                        拼接到(结果, 码);
                        认出来了 = 真;
                        如果 (止 < 0)
                        {
                            名止 = 起 + 位;             // 没写 `;` 时吃到最后一个数字为止
                        }
                    }
                }
                否则
                {
                    // HTML转义命名实体:**先试长的再试短的**(`&ampx` 要认成 `&amp` + `x`)
                    // ⚠ 这一段是实测修出来的第二处真缺陷:名字后面还跟着普通字符时(最早那一版)
                    //   "吃了名字继续往下走"会输出一段乱字节(实测 `FF`)并把后面的字吃掉
                    //   ⇒ **只认"名字后面就是 `;`"这一档**;`;` 与名字之间不许多余字符。
                    整数 长试 = 名止 - i - 1;
                    当 (长试 > 0 && !认出来了)
                    {
                        逻辑 收尾干净 = 长试 == 名止 - i - 1;
                        如果 (收尾干净)
                        {
                            字符串 名字 = "";
                            整数 k = i + 1;
                            当 (k < i + 1 + 长试)
                            {
                                拼接到(名字, 文本[k]);
                                k = k + 1;
                            }
                            号码 = HTML转义命名实体(名字);
                            如果 (号码 >= 0)
                            {
                                码 = 号码;                    // 判过非负再当 `文字`:负数会编成乱字节
                                拼接到(结果, 码);
                                认出来了 = 真;
                            }
                        }
                        长试 = 长试 - 1;
                    }
                }
            }
            如果 (!认出来了)
            {
                拼接到(结果, '&');            // 认不出(含压根没写 `;`):那个 `&` 原样留着
                i = i + 1;
            }
            否则
            {
                i = 止 + 1;                        // 整段实体吃掉了
            }
        }
    }
    返回 结果;
}
