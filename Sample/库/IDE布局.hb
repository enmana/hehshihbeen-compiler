// ============================================================
// IDE布局.hb —— **三格一隔条**:文件栏(左)/ 编辑器格(右上)/ 输出区(右下)+ 一条可拖的隔条
//              (纯 HB 库:不动 ISA、不动关键字、不动机器码)
//
// 用法:
// ```
// 包含 "../库/编辑器.hb";
// 包含 "../库/编辑器视图.hb";
// 包含 "../库/IDE布局.hb";
//
// 编辑器.编辑缓冲 编;
// 编辑器.建编辑器(编, 20);
// 编辑器视图.面板 屏;
// IDE布局.布局 台;
// IDE布局.建布局(台, 编, 屏, 0, 0, 640, 400, 140, 120);
// ...(喂事件)...
// IDE布局.送鼠标(台, 1, x, y);                 // 1 = 按下 / 2 = 抬起 / 0 = 移动
// IDE布局.标脏(台);
// 整数 条 = IDE布局.重画(台);                  // 清屏 + 三格 + 隔条,回来的是条数
// ```
//
// 治的是**"三格怎么摆、鼠标落在哪一格、隔条怎么拖"**这件事:三格的矩形全从
// (左, 上, 宽, 高, 左栏宽, 下栏高) 现算,命中测试按矩形从后往前判 —— 与 `界面.hb` 的列表控件
// 同一套口径(库不引库:`界面.hb` 是"一屏一表"的通用控件库,这里只要"摆三格 + 一条隔条")。
//
// 口径(每条都对着实测写):
//   · **四格算得出来就问得到**:`编辑器格` / `文件栏` / `输出区` / `隔条` 各给一个矩形(左, 上, 宽, 高),
//     越界 / 窄到负数一律夹成 0 ⇒ 不报错、不停机;
//   · **焦点 = 鼠标按下落在哪一格**(`焦点格`):0 文件栏 / 1 编辑器格 / 2 输出区 / -1 没有;
//     **焦点格 / 当前文件 / 输出行**这三样是"主循环要的读数"(4-4 接线就照这三个);
//   · **隔条拖动**:按下落在隔条上就开始拖;拖的时候**水平那一半挪左栏宽、竖直那一半挪下栏高**
//     (两半各管一个数—— 隔条是个十字);抬起就停。拖动中被拖的那一边有**最小尺寸**(`最小左栏` /
//     `最小下栏`),不会把格子拖成负的;
//   · **重画**:`清屏` 一条 + 三格底色各一条 + 输出区标题一条 + 输出区里那几行字(每行一条)+
//     隔条一条 + 焦点框一条("焦点在哪一格"要看得见)。回来的是**这一屏发了几条命令**;
//   · **输出区是一个"环形行池"**:`写输出(串)` 往末尾加一行,满了从头盖(上限 64 行)——
//     IDE 的输出区本来就不该无限长;
//   · **不报错、不停机**:行号 / 下标越界一律给空串或假。
//
// 提供的函数(16 个):逐条的作用见每个函数紧上面那行注释。
//
// 英文对照:**没有英文别名**(与现有几个库同一口径)。
//
// 复杂度:四格与命中都是 O(1);`重画` 是 O(输出区行数 + 文件条数);空间:输出区 64 条池串,不另申请堆。
//
// 边界(如实登记):
//   · **不做"滚动"**(输出区与文件栏都只画能放下的那些行;滚动条归 4-4 之后按需要加);
//   · **文件栏只画名字**(不画图标 / 不改色;选中态用一条底色);
//   · **不自己收事件**:`送鼠标` / `送键盘` 由主循环喂(自检那条路靠事件脚本喂)。
// ============================================================

模块 IDE布局

// 三格一隔条的全部状态:每个格子的矩形现算,这里只存"整数与读数"
结构 布局
{
    整数 左;             // 整块区域的左上角(x)
    整数 上;             // 整块区域的左上角(y)
    整数 宽;             // 整块区域一共多宽
    整数 高;             // 整块区域一共多高
    整数 左栏宽;         // 左边那一格(文件栏)多宽
    整数 下栏高;         // 下面那一格(输出区)多高
    整数 隔条粗;         // 隔条多粗(像素)
    整数 最小左栏;       // 拖动时左栏最小多宽
    整数 最小下栏;       // 拖动时下栏最小多高
    整数 焦点格;         // 0 文件栏 / 1 编辑器格 / 2 输出区 / -1 没有
    整数 正拖着;         // 0 没拖 / 1 拖水平那一半 / 2 拖竖直那一半
    整数 脏;             // 0 干净 / 非 0 要重画
    整数 帧;             // 重画过几屏
    整数 命令数;         // 上一屏发了几条绘制命令
    整数 底色;           // 三格的底
    整数 分隔色;         // 隔条
    整数 焦点色;         // 焦点框
    整数 文字色;         // 正文
    整数 标题色;         // 格子标题(输出区那一行)
}

// 输出区那一池行(环形:写满了从头盖)+ 文件栏那几条名字
字符串 IDE布局_输出[64];
整数 IDE布局_输出现有;
整数 IDE布局_输出起;
字符串 IDE布局_文件名[64];
整数 IDE布局_文件数;
整数 IDE布局_当前文件;

// 建一个布局:四格由这几个数现算(格子 / 隔条位置一律问函数,不在这里存)
方法 建布局(IDE布局.布局 台, 整数 左, 整数 上, 整数 宽, 整数 高, 整数 左栏宽, 整数 下栏高)
{
    台.左 = 左;
    台.上 = 上;
    台.宽 = 宽;
    台.高 = 高;
    台.左栏宽 = 左栏宽;
    台.下栏高 = 下栏高;
    台.隔条粗 = 4;
    台.最小左栏 = 60;
    台.最小下栏 = 40;
    台.焦点格 = 1;                                    // 一上来焦点在编辑器格(与真 IDE 一样)
    台.正拖着 = 0;
    台.脏 = 1;
    台.帧 = 0;
    台.命令数 = 0;
    台.底色 = 0xFF14141C;
    台.分隔色 = 0xFF2A2A3A;
    台.焦点色 = 0xFF2A6EF0;
    台.文字色 = 0xFFE8E8F0;
    台.标题色 = 0xFF6A6A80;
    IDE布局_输出现有 = 0;
    IDE布局_输出起 = 0;
    IDE布局_文件数 = 0;
    IDE布局_当前文件 = -1;
    返回
}

// 把编辑器视图按"编辑器格"重新摆一遍(改过左栏宽 / 下栏高之后要再调一次)
方法 编辑格挂上(IDE布局.布局 台, 编辑器.编辑缓冲 编, 编辑器视图.面板 屏)
{
    整数 格左 = IDE布局_编辑器格左(台);
    整数 格上 = IDE布局_编辑器格上(台);
    整数 格宽 = IDE布局_编辑器格宽(台);
    整数 格高 = IDE布局_编辑器格高(台);
    屏.左 = 格左;
    屏.上 = 格上;
    屏.宽 = 格宽;
    屏.高 = 格高;
    屏.行号栏宽 = 32;
    屏.行高 = 18;
    屏.每格宽 = 8;
    屏.文字左留白 = 6;
    屏.可视行数 = 编辑器视图.一屏行数(屏);
    屏.水平偏移 = 0;
    屏.帧 = 0;
    屏.命令数 = 0;
    屏.底色 = 0xFF14141C;
    屏.当前行底 = 0xFF23233A;
    屏.文字色 = 0xFFE8E8F0;
    屏.行号色 = 0xFF6A6A80;
    屏.光标色 = 0xFF2A6EF0;
    屏.滚动条槽 = 0xFF1C1C26;
    屏.滚动条块 = 0xFF3A3A55;
    整数 几行 = 编辑器视图.一屏行数(屏);
    编辑器.设可视行数(编, 几行);
    返回
}

// ---------------- 四格的矩形(现算;窄到负数一律夹成 0) ----------------

// 文件栏左边界
方法 IDE布局_文件栏左(IDE布局.布局 台) 返回 整数
{
    返回 台.左;
}
// 文件栏上边界
方法 IDE布局_文件栏上(IDE布局.布局 台) 返回 整数
{
    返回 台.上;
}
// 文件栏宽度(夹在 0 ~ 整块宽)
方法 IDE布局_文件栏宽(IDE布局.布局 台) 返回 整数
{
    整数 宽 = 台.左栏宽;
    如果 (宽 < 0)
    {
        宽 = 0;
    }
    如果 (宽 > 台.宽)
    {
        宽 = 台.宽;
    }
    返回 宽;
}
// 文件栏高度 = 整块高(左栏是通高的)
方法 IDE布局_文件栏高(IDE布局.布局 台) 返回 整数
{
    如果 (台.高 < 0)
    {
        返回 0;
    }
    返回 台.高;
}

// 编辑器格左边界(文件栏右边 + 隔条)
方法 IDE布局_编辑器格左(IDE布局.布局 台) 返回 整数
{
    整数 栏宽 = IDE布局_文件栏宽(台);
    整数 x = 台.左 + 栏宽 + 台.隔条粗;
    如果 (x > 台.左 + 台.宽)
    {
        返回 台.左 + 台.宽;
    }
    返回 x;
}
// 编辑器格上边界
方法 IDE布局_编辑器格上(IDE布局.布局 台) 返回 整数
{
    返回 台.上;
}
// 编辑器格宽度(夹成 0 起)
方法 IDE布局_编辑器格宽(IDE布局.布局 台) 返回 整数
{
    整数 格左 = IDE布局_编辑器格左(台);
    整数 宽 = 台.左 + 台.宽 - 格左;
    如果 (宽 < 0)
    {
        宽 = 0;
    }
    返回 宽;
}
// 编辑器格高度(要减掉下面那两格与隔条)
方法 IDE布局_编辑器格高(IDE布局.布局 台) 返回 整数
{
    整数 下高 = IDE布局_下栏高夹(台);
    整数 高 = 台.高 - 下高 - 台.隔条粗;
    如果 (高 < 0)
     {
        高 = 0;
    }
    返回 高;
}

// 下栏高(夹在 0 ~ 整块高)
方法 IDE布局_下栏高夹(IDE布局.布局 台) 返回 整数
{
    整数 高 = 台.下栏高;
    如果 (高 < 0)
     {
        高 = 0;
    }
    如果 (高 > 台.高)
    {
        高 = 台.高;
    }
    返回 高;
}

// 输出区左边界
方法 IDE布局_输出区左(IDE布局.布局 台) 返回 整数
{
    返回 台.左;
}
// 输出区上边界(整块底往上量)
方法 IDE布局_输出区上(IDE布局.布局 台) 返回 整数
{
    整数 下高 = IDE布局_下栏高夹(台);
    返回 台.上 + 台.高 - 下高;
}
// 输出区宽度 = 整块宽
方法 IDE布局_输出区宽(IDE布局.布局 台) 返回 整数
{
    如果 (台.宽 < 0)
     {
        返回 0;
    }
    返回 台.宽;
}
// 输出区高度
方法 IDE布局_输出区高(IDE布局.布局 台) 返回 整数
{
    返回 IDE布局_下栏高夹(台);
}

// 横隔条(左右方向上那一条,分隔文件栏与编辑器格):x 起、宽 = 隔条粗、通高
方法 IDE布局_横隔条x(IDE布局.布局 台) 返回 整数
{
    返回 台.左 + IDE布局_文件栏宽(台);
}
// 竖隔条(上下方向上那一条,分隔编辑器格与输出区):y 起、高 = 隔条粗、从编辑器格左边到右边
方法 IDE布局_竖隔条y(IDE布局.布局 台) 返回 整数
{
    整数 下高 = IDE布局_下栏高夹(台);
    返回 台.上 + 台.高 - 下高 - 台.隔条粗;
}

// ---------------- 命中测试 ----------------

// 一个点落在哪一格(0 文件栏 / 1 编辑器格 / 2 输出区 / -1 空白)
方法 命中格(IDE布局.布局 台, 整数 x, 整数 y) 返回 整数
{
    如果 (在矩形里(IDE布局_输出区左(台), IDE布局_输出区上(台), IDE布局_输出区宽(台), IDE布局_输出区高(台), x, y))
    {
        返回 2;
    }
    如果 (在矩形里(IDE布局_编辑器格左(台), IDE布局_编辑器格上(台), IDE布局_编辑器格宽(台), IDE布局_编辑器格高(台), x, y))
    {
        返回 1;
    }
    如果 (在矩形里(IDE布局_文件栏左(台), IDE布局_文件栏上(台), IDE布局_文件栏宽(台), IDE布局_文件栏高(台), x, y))
    {
        返回 0;
    }
    返回 0 - 1;
}

// 一个点落在不在隔条上(1 = 横隔条那一半 / 2 = 竖隔条那一半 / 0 = 不在)
方法 命中隔条(IDE布局.布局 台, 整数 x, 整数 y) 返回 整数
{
    如果 (x >= IDE布局_横隔条x(台) && x < IDE布局_横隔条x(台) + 台.隔条粗 && y >= 台.上 && y < 台.上 + 台.高)
    {
        返回 1;
    }
    如果 (y >= IDE布局_竖隔条y(台) && y < IDE布局_竖隔条y(台) + 台.隔条粗 && x >= IDE布局_编辑器格左(台) && x < IDE布局_编辑器格左(台) + IDE布局_编辑器格宽(台))
    {
        返回 2;
    }
    返回 0;
}

// 一个点在不在矩形里(公开的判据:命中测试与自检都用它)
方法 在矩形里(整数 左, 整数 上, 整数 宽, 整数 高, 整数 x, 整数 y) 返回 逻辑
{
    如果 (宽 <= 0 || 高 <= 0)
    {
        返回 假;
    }
    返回 x >= 左 && x < 左 + 宽 && y >= 上 && y < 上 + 高;
}

// ---------------- 事件(由主循环喂过来) ----------------

// 送一个鼠标事件:`动作` 0 = 移动 / 1 = 按下 / 2 = 抬起;回的是"这一下有没有改变什么"
方法 送鼠标(IDE布局.布局 台, 整数 动作, 整数 x, 整数 y) 返回 逻辑
{
    如果 (动作 == 1)
    {
        整数 条 = 命中隔条(台, x, y);
        如果 (条 != 0)
        {
            台.正拖着 = 条;                            // 按在隔条上:开始拖
            台.脏 = 1;
            返回 真;
        }
        整数 格 = 命中格(台, x, y);
        逻辑 变过 = 假;
        如果 (格 != 台.焦点格)
        {
            台.焦点格 = 格;
            台.脏 = 1;
            变过 = 真;
        }
        如果 (格 == 0)
        {
            整数 第几条 = 命中文件第几(台, x, y);
            如果 (第几条 >= 0 && 第几条 != IDE布局_当前文件)
            {
                IDE布局_当前文件 = 第几条;
                台.脏 = 1;
                变过 = 真;
            }
        }
        返回 变过;
    }
    如果 (动作 == 2)
    {
        如果 (台.正拖着 != 0)
        {
            台.正拖着 = 0;
            台.脏 = 1;
            返回 真;
        }
        返回 假;
    }
    // 移动
    如果 (台.正拖着 == 1)
    {
        整数 差 = x - (台.左 + 台.左栏宽);
        整数 新宽 = 台.左栏宽 + 差;
        整数 上限宽 = 台.宽 - 台.最小左栏;
        台.左栏宽 = 夹(新宽, 台.最小左栏, 上限宽);
        台.脏 = 1;
        返回 真;
    }
    如果 (台.正拖着 == 2)
    {
        整数 新下 = 台.上 + 台.高 - y - 台.隔条粗;
        整数 上限下 = 台.高 - 台.最小下栏;
        台.下栏高 = 夹(新下, 台.最小下栏, 上限下);
        台.脏 = 1;
        返回 真;
    }
    返回 假;
}

// 夹在 [低, 高] 里(低比高大就给低)
方法 夹(整数 值, 整数 低, 整数 高) 返回 整数
{
    如果 (高 < 低)
    {
        返回 低;
    }
    如果 (值 < 低)
    {
        返回 低;
    }
    如果 (值 > 高)
    {
        返回 高;
    }
    返回 值;
}

// 一个点落在文件栏第几条上(-1 = 没落在任何一条上)
方法 命中文件第几(IDE布局.布局 台, 整数 x, 整数 y) 返回 整数
{
    如果 (IDE布局_文件数 <= 0)
    {
        返回 0 - 1;
    }
    整数 条高 = 20;
    整数 起点 = 台.上 + 24;                             // 顶上留一条标题
    整数 i = 0;
    当 (i < IDE布局_文件数)
     {
        如果 (在矩形里(台.左, 起点 + i * 条高, IDE布局_文件栏宽(台), 条高, x, y))
        {
            返回 i;
         }
        i = i + 1;
     }
    返回 0 - 1;
}

// 键盘:方向键在文件栏里上下换当前文件、`回车` 当"打开";不在文件栏一律给假
方法 送键盘(IDE布局.布局 台, 整数 键码) 返回 逻辑
{
    如果 (台.焦点格 != 0)
    {
        返回 假;
    }
    如果 (IDE布局_文件数 <= 0)
    {
        返回 假;
    }
    如果 (键码 == 40)
    {
        IDE布局_当前文件 = 夹(IDE布局_当前文件 + 1, 0, IDE布局_文件数 - 1);
        台.脏 = 1;
        返回 真;
    }
    如果 (键码 == 38)
    {
        IDE布局_当前文件 = 夹(IDE布局_当前文件 - 1, 0, IDE布局_文件数 - 1);
        台.脏 = 1;
        返回 真;
    }
    返回 假;
}

// ---------------- 内容(文件栏 / 输出区) ----------------

// 文件栏清空
方法 清文件(IDE布局.布局 台)
{
    IDE布局_文件数 = 0;
    IDE布局_当前文件 = 0 - 1;
    台.脏 = 1;
    返回
}

// 往文件栏加一条(满了给假)
方法 加文件(IDE布局.布局 台, 字符串 名字) 返回 逻辑
{
    如果 (IDE布局_文件数 >= 64)
    {
        返回 假;
    }
    IDE布局_文件名[IDE布局_文件数] = 名字;
    IDE布局_文件数 = IDE布局_文件数 + 1;
    如果 (IDE布局_当前文件 < 0)
    {
        IDE布局_当前文件 = 0;
    }
    台.脏 = 1;
    返回 真;
}

// 文件栏现在几条
方法 文件条数(IDE布局.布局 台) 返回 整数
{
    返回 IDE布局_文件数;
}

// 第几条的名字("" = 没这一条)
方法 文件名(IDE布局.布局 台, 整数 第几条) 返回 字符串
{
    如果 (第几条 < 0 || 第几条 >= IDE布局_文件数)
    {
        返回 "";
    }
    返回 IDE布局_文件名[第几条];
}

// 当前选中的是第几条(-1 = 没选中)
方法 当前文件(IDE布局.布局 台) 返回 整数
{
    返回 IDE布局_当前文件;
}

// 选第几条(越界夹回来)
方法 选文件(IDE布局.布局 台, 整数 第几条)
{
    IDE布局_当前文件 = 夹(第几条, 0, IDE布局_文件数 - 1);
    台.脏 = 1;
    返回
}

// 往输出区写一行(满了从头盖;环形)
方法 写输出(IDE布局.布局 台, 字符串 行)
{
    整数 位 = IDE布局_输出起 + IDE布局_输出现有;
    如果 (位 >= 64)
    {
        位 = 位 - 64;
    }
    如果 (IDE布局_输出现有 < 64)
    {
        IDE布局_输出[位] = 行;
        IDE布局_输出现有 = IDE布局_输出现有 + 1;
    }
    否则
    {
        IDE布局_输出[IDE布局_输出起] = 行;
        IDE布局_输出起 = (IDE布局_输出起 + 1) % 64;
    }
    台.脏 = 1;
    返回
}

// 输出区现在几行
方法 输出行数(IDE布局.布局 台) 返回 整数
{
    返回 IDE布局_输出现有;
}

// 输出区第几行("" = 没这一行)
方法 输出行(IDE布局.布局 台, 整数 第几行) 返回 字符串
{
    如果 (第几行 < 0 || 第几行 >= IDE布局_输出现有)
    {
        返回 "";
    }
    整数 位 = (IDE布局_输出起 + 第几行) % 64;
    返回 IDE布局_输出[位];
}

// 输出区清空
方法 清输出(IDE布局.布局 台)
{
    IDE布局_输出现有 = 0;
    IDE布局_输出起 = 0;
    台.脏 = 1;
    返回
}

// ---------------- 重画调度 ----------------

// 焦点在第几格(0 文件栏 / 1 编辑器格 / 2 输出区 / -1 没有)
方法 焦点格(IDE布局.布局 台) 返回 整数
{
    返回 台.焦点格;
}

// 标脏(下一次 `要重画` 给真)
方法 标脏(IDE布局.布局 台)
{
    台.脏 = 1;
    返回
}

// 要不要重画
方法 要重画(IDE布局.布局 台) 返回 逻辑
{
    返回 台.脏 != 0;
}

// 重画:清屏 + 三格 + 输出区那几行 + 隔条 + 焦点框;回来的是条数(顺手把脏清掉)
方法 重画(IDE布局.布局 台) 返回 整数
{
    整数 条 = 0;
    清屏(台.底色);
    条 = 1;
    整数 一段 = 画文件栏(台);
    条 = 条 + 一段;
    一段 = 画输出区(台);
    条 = 条 + 一段;
    一段 = 画隔条(台);
    条 = 条 + 一段;
    一段 = 画焦点框(台);
    条 = 条 + 一段;
    台.命令数 = 条;
    台.帧 = 台.帧 + 1;
    台.脏 = 0;
    返回 条;
}

// 文件栏:一块底 + 一条标题 + 每一条名字(选中的那一条先铺底色)
方法 画文件栏(IDE布局.布局 台) 返回 整数
{
    整数 条 = 0;
    画矩形(IDE布局_文件栏左(台), IDE布局_文件栏上(台), IDE布局_文件栏宽(台), IDE布局_文件栏高(台), 台.底色);
    条 = 条 + 1;
    画文字(台.左 + 6, 台.上 + 6, "文件", 台.标题色);
    条 = 条 + 1;
    整数 i = 0;
    当 (i < IDE布局_文件数)
     {
        整数 y = 台.上 + 24 + i * 20;
        如果 (y + 20 > 台.上 + 台.高)
         {
            返回 条;
        }
        如果 (i == IDE布局_当前文件)
        {
            画矩形(台.左, y, IDE布局_文件栏宽(台), 20, 台.焦点色);
            条 = 条 + 1;
        }
        字符串 这一条 = IDE布局_文件名[i];
        画文字(台.左 + 8, y + 3, 这一条, 台.文字色);
        条 = 条 + 1;
        i = i + 1;
     }
    返回 条;
}

// 输出区:一块底 + 一条标题 + 能放下的那几行(从末尾往上留,新的在下面)
方法 画输出区(IDE布局.布局 台) 返回 整数
{
    整数 条 = 0;
    画矩形(IDE布局_输出区左(台), IDE布局_输出区上(台), IDE布局_输出区宽(台), IDE布局_输出区高(台), 台.底色);
    条 = 条 + 1;
    画文字(台.左 + 6, IDE布局_输出区上(台) + 4, "输出", 台.标题色);
    条 = 条 + 1;
    整数 能放 = (IDE布局_输出区高(台) - 26) / 18;
    如果 (能放 < 1)
     {
        返回 条;
    }
    整数 少画 = 0;
    如果 (IDE布局_输出现有 > 能放)
    {
        少画 = IDE布局_输出现有 - 能放;
    }
    整数 i = 少画;
    当 (i < IDE布局_输出现有)
     {
        整数 y = IDE布局_输出区上(台) + 24 + (i - 少画) * 18;
        整数 位 = (IDE布局_输出起 + i) % 64;
        字符串 这一行 = IDE布局_输出[位];
        画文字(台.左 + 8, y, 这一行, 台.文字色);
        条 = 条 + 1;
        i = i + 1;
     }
    返回 条;
}

// 隔条:横竖各一条(同一格)
方法 画隔条(IDE布局.布局 台) 返回 整数
{
    画矩形(IDE布局_横隔条x(台), 台.上, 台.隔条粗, 台.高, 台.分隔色);
    画矩形(IDE布局_编辑器格左(台), IDE布局_竖隔条y(台), IDE布局_编辑器格宽(台), 台.隔条粗, 台.分隔色);
    返回 2;
}

// 焦点框:焦点那一格描一圈(四条线)
方法 画焦点框(IDE布局.布局 台) 返回 整数
{
    如果 (台.焦点格 == 1)
    {
        整数 左1 = IDE布局_编辑器格左(台);
        整数 上1 = IDE布局_编辑器格上(台);
        画矩形(左1, 上1, IDE布局_编辑器格宽(台), IDE布局_编辑器格高(台), 台.焦点色);
        返回 1;
    }
    如果 (台.焦点格 == 2)
    {
        整数 左2 = IDE布局_输出区左(台);
        整数 上2 = IDE布局_输出区上(台);
        画矩形(左2, 上2, IDE布局_输出区宽(台), IDE布局_输出区高(台), 台.焦点色);
        返回 1;
    }
    如果 (台.焦点格 == 0)
    {
        画矩形(IDE布局_文件栏左(台), IDE布局_文件栏上(台), IDE布局_文件栏宽(台), IDE布局_文件栏高(台), 台.焦点色);
        返回 1;
    }
    返回 0;
}
