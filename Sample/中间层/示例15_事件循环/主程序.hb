// ============================================================
// 示例15:事件循环(R1-6 批 2)—— 输入与时钟
//
//   即时模式的主循环就这四步:**收事件 → 改状态 → 重画 → 刷新**。
//   这一批补的是"输入从哪儿来、时间怎么走":
//     · 事件**轮询**:`取事件(类型, 键码, x, y)` 有就给 真(四个变量写满),没有给 假(不阻塞);
//     · 类型:1 关窗 / 2 按键 / 3 移动 / 4 按下 / 5 抬起(按下 + 抬起 = 一次"点一下");
//     · 关窗请求:用户点标题栏的叉 ⇒ 投一个 类型 == 1 的事件,程序自己收手(宿主不替你结束进程);
//     · 时钟:`等待(毫秒)` = 让出一帧(桌面壳上真睡;无头跑不真等)。
//
//   本工程旁边的 `事件脚本.txt` 是一份**写死的输入**:第几帧投哪个事件。
//   自检与 `hbcc --run --事件脚本 …` 按它喂事件 ⇒ 不开窗也能把这条循环跑得**一模一样**
//   (硬规矩 6:不许开窗验证)。跑满脚本里那个 `帧数`(4)帧之后,宿主投一个关窗请求,循环收手。
//
//   真窗口那两条路(WPF IDE 里按 F5 / `HB宿主`)不用脚本:事件来自真的键盘与鼠标
//   —— IDE 那条是第224批接的线:IDE 自己挂呈现口(不走子进程),按 F5 就出窗口、断点单步照旧;
//   这个循环在 IDE 里会一直转,直到你把窗口关掉(关窗请求 → `收手`)。
//   第225批按用户实测补:窗口上**画出了事件数与最近一条事件** ——
//   按任意键 / 点一下鼠标,屏上当场变(以前只往控制台打,窗口看着像"没反应")。
// ============================================================

包含 "../../库/string.hb"        // `格式化(...)` 把数字拼成文字要它(库里那族 `转字符串`)

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;

整数 帧 = 0;            // 已经刷新过几帧(= 当前在第几帧,帧号从 0 起)
整数 事件数 = 0;        // 一共收到几条真事件(不含那个关窗请求)
整数 最近类型 = 0;      // 最近一条事件的类型(画在屏上,所以按键 / 点鼠标**看得见**)
整数 最近键码 = 0;      // 最近一条事件的键码

逻辑 开着 = 打开窗口("HB 事件演示", 360, 200);
如果 (开着)
{
    逻辑 收手 = 假;
    当 (!收手)
    {
        // ---- ① 收事件:这一帧投进来的全取出来(取空了给 假,不阻塞)----
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                      // 关窗请求:这一帧之后不再画
            }
            否则
            {
                事件数 = 事件数 + 1;
                最近类型 = 类型;                  // 屏上那两行画的就是它 —— 按任意键 / 点一下鼠标,画面当场变
                最近键码 = 键码;
                测试输出(帧);                    // 这条事件是在第几帧收到的
                测试输出(类型);
                测试输出(键码);
                测试输出(鼠标x);
                测试输出(鼠标y);
            }
        }

        如果 (!收手)
        {
            // ---- ② 重画:即时模式,每帧从头画一遍 ----
            清屏(0xFF101018);
            画文字(8, 8, "HB 事件循环:按任意键 / 点一下鼠标", 0xFFD0D0D8);
            画矩形(8, 40, 120, 28, 0xFF2A6EF0);
            画文字(24, 48, "按钮", 0xFFFFFFFF);
            画文字(8, 80, 格式化("事件数 {0} / 已刷新 {1} 帧", 事件数, 帧), 0xFFB0B0B8);
            画文字(8, 100, 格式化("最近事件:类型 {0} 键码 {1}", 最近类型, 最近键码), 0xFFE8E8F0);

            // ---- ③ 刷新:不调用就一直不显示 ----
            刷新();

            帧 = 帧 + 1;
            等待(16);                            // 让出一帧,别把 CPU 烧满(无头不真等)
        }
    }

    测试输出(帧);                                // 跑满了多少帧(事件脚本里写的是 4)
    测试输出(事件数);
    关闭窗口();
}

停止
// 预期输出: 打开窗口 标题="HB 事件演示" 宽=360 高=200|0|2|13|0|0|清屏 颜色=0xFF101018|画文字 x=8 y=8 文本="HB 事件循环:按任意键 / 点一下鼠标" 颜色=0xFFD0D0D8|画矩形 x=8 y=40 宽=120 高=28 颜色=0xFF2A6EF0|画文字 x=24 y=48 文本="按钮" 颜色=0xFFFFFFFF|画文字 x=8 y=80 文本="事件数 1 / 已刷新 0 帧" 颜色=0xFFB0B0B8|画文字 x=8 y=100 文本="最近事件:类型 2 键码 13" 颜色=0xFFE8E8F0|刷新 命令=6|1|3|0|120|55|清屏 颜色=0xFF101018|画文字 x=8 y=8 文本="HB 事件循环:按任意键 / 点一下鼠标" 颜色=0xFFD0D0D8|画矩形 x=8 y=40 宽=120 高=28 颜色=0xFF2A6EF0|画文字 x=24 y=48 文本="按钮" 颜色=0xFFFFFFFF|画文字 x=8 y=80 文本="事件数 2 / 已刷新 1 帧" 颜色=0xFFB0B0B8|画文字 x=8 y=100 文本="最近事件:类型 3 键码 0" 颜色=0xFFE8E8F0|刷新 命令=6|2|4|1|40|52|2|5|1|40|52|清屏 颜色=0xFF101018|画文字 x=8 y=8 文本="HB 事件循环:按任意键 / 点一下鼠标" 颜色=0xFFD0D0D8|画矩形 x=8 y=40 宽=120 高=28 颜色=0xFF2A6EF0|画文字 x=24 y=48 文本="按钮" 颜色=0xFFFFFFFF|画文字 x=8 y=80 文本="事件数 4 / 已刷新 2 帧" 颜色=0xFFB0B0B8|画文字 x=8 y=100 文本="最近事件:类型 5 键码 1" 颜色=0xFFE8E8F0|刷新 命令=6|3|2|65|0|0|清屏 颜色=0xFF101018|画文字 x=8 y=8 文本="HB 事件循环:按任意键 / 点一下鼠标" 颜色=0xFFD0D0D8|画矩形 x=8 y=40 宽=120 高=28 颜色=0xFF2A6EF0|画文字 x=24 y=48 文本="按钮" 颜色=0xFFFFFFFF|画文字 x=8 y=80 文本="事件数 5 / 已刷新 3 帧" 颜色=0xFFB0B0B8|画文字 x=8 y=100 文本="最近事件:类型 2 键码 65" 颜色=0xFFE8E8F0|刷新 命令=6|4|5|关闭窗口
