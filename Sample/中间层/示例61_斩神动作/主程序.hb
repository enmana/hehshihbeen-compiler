// ============================================================
// 示例61_斩神动作:《斩神》单人动作 demo —— 第 0 档(零新宿主能力)
//
//   这一篇要证的事:**这门语言现在就能做出一个"动作游戏"的样子** ——
//   第三人称跟随相机、网格地面、线框人物、挥砍判定、连击与血条、标题页,
//   全部落在**现成的图形原语**(清屏 / 画线 / 画矩形 / 画文字 / 刷新)+ `三维数学.hb` 上,
//   **一个新宿主能力都不开**。
//
//   要哪几件(对着"第 0 档"那张表逐条):
//     · **网格地面** —— 世界坐标里 4×4 条线,走 `投影` 投上去(真 3D,不是贴图);
//     · **角色与敌人** —— 线框小人(**广告牌画法**:始终面向相机,不做骨骼);
//     · **第三人称跟随相机** —— 相机吊在主角**身后 5.5 米、高 2.6 米**,偏航跟着主角走;
//     · **移动 / 转向 / 冲刺** —— W/S 前后、A/D 转向、空格冲刺(吃体力);
//     · **挥砍判定** —— J 起手,第 2 帧做判定:距离 ≤ 2.6 米 **且**夹角 ≤ 60° 算命中;
//     · **卖相** —— 血条 / 体力条 / 连击数 / 命中闪白 / 斩击弧。
//
//   ⚠ **操作是"点一下走一步",不是"按住走"**(这门语言的现状,如实写在这儿):
//     图形事件只有 `关窗 / 按键 / 移动 / 按下 / 抬起` 五档 —— **键盘没有"抬起"**,
//     所以"按住 W 一直走"表达不出来。这里的做法是**输入脉冲 + 意图保持**:
//     一次 `按键 W` 把"前进"点亮 **3 帧**(不是 3 个事件帧,是游戏自己的帧),
//     于是脚本里点一下就能看见人往前走一段;真人玩家按住不放时,操作系统的**自动重复**
//     会连着送 `按键` 事件,体感一样是连续的。
//
//   两档跑法(与 示例55 同一套):
//     · 真窗口(IDE 按 F5 / `hbcc -p 本工程.hbp --run`):跑起来给你看;
//     · 无头(`--run --无头`,以及自检里那一档):图形命令按同一份格式逐条打出来 ——
//       文件末尾那几行 `// 预期输出:` 对的就是它(硬规矩 6:不开窗也能验)。
//
//   边界(如实登记,不写空话):
//     · **不做近平面裁剪**:两端只要有一端在相机后面就整条不画,但**跨过**相机平面的那一条
//       会把另一头投到屏幕外很远(输出里那些 `x1=-42` / `x2=1795` 就是它)——
//       宿主自己会裁掉,难看一点但不崩;
//     · **人物是广告牌**(始终面向相机,不做骨骼与蒙皮),脚下那一点决定大小;
//     · **不做遮挡**:线框没有 z 缓冲,后面的线会画在前面的上面(这是线框,不是实体);
//     · **一次绘制 = 一次宿主往返**:一帧 20~35 条命令,还没到位图那一档的批处理;
//     · **键盘没有"抬起"** ⇒ 操作是"点一下落一段意图"(见上面那段说明)。
// ============================================================
包含 "../../库/三维数学.hb"
包含 "../../库/string.hb"

// ---------------- 视口(像素)----------------
整数 屏宽 = 640;
整数 屏高 = 480;
浮点 屏心x = 320.0;
浮点 屏心y = 250.0;
浮点 焦距 = 430.0;

// ---------------- 世界(米)----------------
浮点 主x = 0.0;
浮点 主z = 0.0;
浮点 主朝向 = 0.0;                 // 0 = 朝 +z
整数 主血 = 100;
整数 主体力 = 100;
浮点 敌x = 0.0;
浮点 敌z = 2.6;
整数 敌血 = 60;
整数 连击 = 0;
整数 命中闪 = 0;                   // > 0 = 敌人这一帧闪白
整数 幕 = 0;                       // 0 = 标题页,1 = 战斗中

// ---------------- 输入意图(一次按键点亮几帧)----------------
整数 前进剩 = 0;
整数 后退剩 = 0;
整数 左转剩 = 0;
整数 右转剩 = 0;
整数 挥砍剩 = 0;
整数 冲刺剩 = 0;

// ---------------- 相机 ----------------
浮点 眼x = 0.0;
浮点 眼y = 0.0;
浮点 眼z = 0.0;
浮点 见s = 0.0;
浮点 见c = 0.0;

// ---------------- 投影与画段的中间量 ----------------
//   ⚠ 函数帧只有 96 字节 ⇒ 草稿量一律提到模块级(与 `三维网格.hb` 同一条办法)。
浮点 投x = 0.0;
浮点 投y = 0.0;
浮点 投比 = 1.0;
浮点 段ax = 0.0;
浮点 段ay = 0.0;
浮点 段az = 0.0;
浮点 段bx = 0.0;
浮点 段by = 0.0;
浮点 段bz = 0.0;
浮点 画sx = 0.0;
浮点 画sy = 0.0;
浮点 画比 = 1.0;

// ============================================================
// 1、相机与投影
// ============================================================

// 每帧一次:相机吊在主角身后 5.5 米、高 2.6 米,偏航跟着主角
方法 摆相机()
{
    见s = 三维数学.正弦(主朝向);
    见c = 三维数学.余弦(主朝向);
    眼x = 主x - 见s * 5.5;
    眼z = 主z - 见c * 5.5;
    眼y = 2.6;
    返回
}

// 世界点 → 屏幕点。成不成看返回值;屏幕坐标在 `投x` / `投y`,
// 大小系数在 `投比`(= 焦距 / 深度,给"广告牌"量身高用)。
方法 投影(浮点 px, 浮点 py, 浮点 pz) 返回 逻辑
{
    浮点 dx = px - 眼x;
    浮点 dy = pz - 眼z;
    浮点 前 = dx * 见s + dy * 见c;
    如果 (前 < 0.6)
    {
        返回 假;
    }
    浮点 右 = dx * 见c - dy * 见s;
    投比 = 焦距 / 前;
    投x = 屏心x + 右 * 投比;
    投y = 屏心y - (py - 眼y) * 投比;
    返回 真;
}

// 世界空间里的一条线段(两端都在相机后面就不画)
方法 画段(浮点 ax, 浮点 ay, 浮点 az, 浮点 bx, 浮点 by, 浮点 bz, 整数 色)
{
    如果 (!投影(ax, ay, az))
    {
        返回
    }
    段ax = 投x;
    段ay = 投y;
    如果 (!投影(bx, by, bz))
    {
        返回
    }
    画线(整数(段ax), 整数(段ay), 整数(投x), 整数(投y), 色);
    返回
}

// 屏幕空间里的一条线段(给"广告牌"用):`dx/dy` 是米,`比` 是像素/米
方法 画屏段(浮点 dx, 浮点 dy, 浮点 ex, 浮点 ey, 整数 色)
{
    段ax = 画sx + dx * 画比;
    段ay = 画sy - dy * 画比;
    段bx = 画sx + ex * 画比;
    段by = 画sy - ey * 画比;
    画线(整数(段ax), 整数(段ay), 整数(段bx), 整数(段by), 色);
    返回
}

// ============================================================
// 2、画世界
// ============================================================

// 网格地面:纵向 4 条 + 横向 4 条
方法 画地面()
{
    整数 i = 0;
    无符号整数 色 = 0xFF243040;
    当 (i < 5)
    {
        浮点 x = 0.0 - 6.0 + 3.0 * i;
        画段(x, 0.0, 0.0 - 2.0, x, 0.0, 16.0, 色);
        i = i + 1;
    }
    i = 0;
    当 (i < 5)
    {
        浮点 z = 0.0 - 2.0 + 4.5 * i;
        画段(0.0 - 6.0, 0.0, z, 6.0, 0.0, z, 色);
        i = i + 1;
    }
    返回
}

// 线框小人(**广告牌**:先投脚下那一点,再按"米 × 比"在屏幕上画六段)
//   头 / 躯干 / 两臂 / 两腿;`刀` 真 = 右手多一道刀光
方法 画人(浮点 wx, 浮点 wz, 整数 色, 逻辑 刀)
{
    如果 (!投影(wx, 0.0, wz))
    {
        返回
    }
    画sx = 投x;
    画sy = 投y;
    画比 = 投比;
    画屏段(0.0, 1.72, 0.0, 1.53, 色);          // 头
    画屏段(0.0, 1.53, 0.0, 0.95, 色);          // 躯干
    画屏段(0.0, 1.44, 0.0 - 0.28, 1.02, 色);   // 左臂
    画屏段(0.0, 1.44, 0.28, 1.02, 色);         // 右臂
    画屏段(0.0, 0.95, 0.0 - 0.16, 0.0, 色);    // 左腿
    画屏段(0.0, 0.95, 0.16, 0.0, 色);          // 右腿
    如果 (刀)
    {
        画屏段(0.28, 1.02, 0.62, 1.60, 色);    // 刀
    }
    返回
}

// 斩击弧:挥砍那几帧在身前扫出三道
方法 画斩()
{
    如果 (挥砍剩 <= 0)
    {
        返回
    }
    浮点 s = 三维数学.正弦(主朝向);
    浮点 c = 三维数学.余弦(主朝向);
    段ax = 主x + s * 1.1 - c * 0.9;
    段az = 主z + c * 1.1 + s * 0.9;
    段bx = 主x + s * 1.1;
    段bz = 主z + c * 1.1;
    画段(段ax, 1.5, 段az, 段bx, 0.7, 段bz, 0xFFFFE08A);
    段ax = 主x + s * 1.1 - c * 0.45;
    段az = 主z + c * 1.1 + s * 0.45;
    段bx = 主x + s * 1.1 + c * 0.45;
    段bz = 主z + c * 1.1 - s * 0.45;
    画段(段ax, 1.1, 段az, 段bx, 1.1, 段bz, 0xFFFFF6C8);
    返回
}

// 界面:血条 / 体力条 / 连击 / 标题
方法 画界面()
{
    画矩形(12, 12, 208, 18, 0xFF1A1A22);
    画矩形(14, 14, 主血 * 2, 14, 0xFFD23B3B);
    画矩形(12, 36, 208, 12, 0xFF1A1A22);
    画矩形(14, 38, 主体力 * 2, 8, 0xFF3BA0D2);
    画文字(12, 54, "斩神 · 第 0 档", 0xFFE8D8A0);
    如果 (连击 > 0)
    {
        画文字(232, 14, 格式化("连击 {0}", 连击), 0xFFFFE08A);
    }
    如果 (敌血 <= 0)
    {
        画文字(232, 14, "已斩", 0xFFFFE08A);
    }
    返回
}

// 标题页:一张大标题 + 副题 + 操作说明(只认"回车 / 空格"开始)
方法 画标题()
{
    画矩形(0, 140, 屏宽, 130, 0xFF101820);
    画矩形(0, 142, 屏宽, 2, 0xFFE8D8A0);
    画矩形(0, 266, 屏宽, 2, 0xFFE8D8A0);
    画文字(272, 176, "斩 神", 0xFFE8D8A0);
    画文字(238, 208, "第 0 档 · 单人动作 demo", 0xFF8CA0C0);
    画文字(248, 240, "一次挥砍 · 一段连击", 0xFF6C7C8C);
    画文字(252, 300, "回车 / 空格   开始", 0xFFFFE08A);
    画文字(150, 336, "W / S 前后    A / D 转向    空格 冲刺    J 挥砍    ESC 退出", 0xFF6C7C8C);
    返回
}

// ============================================================
// 3、推进一帧(先收意图,再动世界)
// ============================================================
方法 迈一步()
{
    浮点 s = 三维数学.正弦(主朝向);
    浮点 c = 三维数学.余弦(主朝向);
    如果 (左转剩 > 0)
    {
        主朝向 = 主朝向 - 0.22;
        左转剩 = 左转剩 - 1;
    }
    如果 (右转剩 > 0)
    {
        主朝向 = 主朝向 + 0.22;
        右转剩 = 右转剩 - 1;
    }
    如果 (前进剩 > 0)
    {
        主x = 主x + s * 0.45;
        主z = 主z + c * 0.45;
        前进剩 = 前进剩 - 1;
    }
    如果 (后退剩 > 0)
    {
        主x = 主x - s * 0.30;
        主z = 主z - c * 0.30;
        后退剩 = 后退剩 - 1;
    }
    如果 (冲刺剩 > 0)
    {
        如果 (主体力 >= 4)
        {
            主x = 主x + s * 1.60;
            主z = 主z + c * 1.60;
            主体力 = 主体力 - 4;
        }
        冲刺剩 = 冲刺剩 - 1;
    }
    如果 (命中闪 > 0)
    {
        命中闪 = 命中闪 - 1;
    }
    如果 (挥砍剩 > 0)
    {
        挥砍剩 = 挥砍剩 - 1;
    }
    如果 (主体力 < 100)
    {
        主体力 = 主体力 + 1;
    }
    返回
}

// 一刀的判定(**按下 J 的那一刻判**,不拖到后面某一帧 —— 位置最可预期):
// 距离 ≤ 2.6 米 **且**夹角 ≤ 60° 算命中
方法 判命中()
{
    如果 (敌血 <= 0)
    {
        返回
    }
    浮点 dx = 敌x - 主x;
    浮点 dz = 敌z - 主z;
    浮点 距 = 三维数学.开方(dx * dx + dz * dz);
    如果 (距 > 2.6)
    {
        返回
    }
    浮点 夹 = 三维数学.余弦(主朝向) * dz + 三维数学.正弦(主朝向) * dx;
    如果 (夹 < 距 * 0.5)
    {
        返回
    }
    敌血 = 敌血 - 20;
    如果 (敌血 < 0)
    {
        敌血 = 0;
    }
    连击 = 连击 + 1;
    命中闪 = 3;
    返回
}

// ============================================================
// 4、主循环
// ============================================================

整数 帧 = 0;
整数 类型 = 0;
整数 键码 = 0;
整数 鼠x = 0;
整数 鼠y = 0;
逻辑 还开着 = 真;
逻辑 开着 = 打开窗口("斩神 —— 动作 demo(第 0 档)", 屏宽, 屏高);
如果 (开着)
{
     // ⚠ 转到用户自己关窗(第415批撤掉 `帧 < 600`);
     //   自检那条腿靠**事件脚本**投"关窗请求"收手(见同目录 `事件脚本.txt`)
    当 (还开着)
    {
        // ---- ① 收事件:标题页只认"开始",进了战斗才认操作键 ----
        当 (取事件(类型, 键码, 鼠x, 鼠y))
        {
            如果 (类型 == 1 || 键码 == 27)
            {
                还开着 = 假;
            }
            如果 (幕 == 0)
            {
                如果 (键码 == 13 || 键码 == 32)
                {
                    幕 = 1;
                }
            }
            否则
            {
                如果 (键码 == 87)
                {
                    前进剩 = 3;
                }
                如果 (键码 == 83)
                {
                    后退剩 = 3;
                }
                如果 (键码 == 65)
                {
                    左转剩 = 3;
                }
                如果 (键码 == 68)
                {
                    右转剩 = 3;
                }
                如果 (键码 == 32)
                {
                    冲刺剩 = 3;
                }
                如果 (键码 == 74 && 挥砍剩 <= 1)
                {
                    挥砍剩 = 3;
                    判命中();
                }
            }
        }

        // ---- ② 推进一帧(标题页上世界不动)----
        如果 (幕 == 1)
        {
            迈一步();
        }
        摆相机();

        // ---- ③ 画 ----
        清屏(0xFF0B0F14);
        如果 (幕 == 0)
        {
            画标题();
        }
        否则
        {
            画矩形(0, 0, 屏宽, 120, 0xFF121A24);
            画地面();
            如果 (敌血 > 0)
            {
                画人(敌x, 敌z, 0xFFB06060, 假);
            }
            如果 (命中闪 > 0)
            {
                画人(敌x, 敌z, 0xFFFFFFFF, 假);
            }
            画人(主x, 主z, 0xFF7BE0FF, 真);
            画斩();
            画界面();
        }
        刷新();

        帧 = 帧 + 1;
        等待(16);
    }
    关闭窗口();
}

// ---------------- 收尾:紧凑状态(无头那一档看的就是这几行)----------------
测试输出(帧);
测试输出(主z > 3.0);
测试输出(敌血);
测试输出(连击);
测试输出(主体力 < 100);
停止

// ---------------- 预期输出(无头那一档逐段对;一段一行,段内用 `|` 分隔)----------------
//   生成办法:hbcc -p 本工程.hbp --run --无头 --事件脚本 事件脚本.txt —— 把图形命令原样抄回来。
