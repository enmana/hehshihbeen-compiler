// ============================================================
// 示例66:IDE 三格布局(`Sample\库\IDE布局.hb`)—— 文件栏 / 编辑器格 / 输出区 + 一条可拖的隔条
//
//   这一件要证的事:**IDE 那三格摆得出来、鼠标落在哪一格说得清、隔条拖得动** ——
//   全用纯 HB 写,并且**每一格的矩形与命中结果都能逐条打印出来对表**。
//
//   摆法(全是现算,不存):
//     · 左栏 = 文件栏(通高);右上 = 编辑器格(挂 4-2 的 `编辑器视图.面板`);
//       右下 = 输出区;两者之间一条**十字隔条**(横的一半管左栏宽、竖的一半管下栏高);
//     · 焦点 = **鼠标按下落在哪一格**(0 文件栏 / 1 编辑器格 / 2 输出区);焦点那一格描一圈。
//
//   事件脚本这一趟(6 帧)干四件事:
//     ① 点编辑器格 ⇒ 焦点换过去;② 点文件栏第二条 ⇒ 当前文件换成 1;
//     ③ 按住横隔条往右拖 40 像素 ⇒ 左栏宽 140 → 180;④ 点输出区 ⇒ 焦点换过去。
//   每一帧打完:**焦点 / 当前文件 / 左栏宽 / 下栏高 / 输出行数 / 这一屏几条命令**。
// ============================================================
包含 "../../库/编辑器.hb"
包含 "../../库/编辑器视图.hb"
包含 "../../库/IDE布局.hb"
包含 "../../库/string.hb"

编辑器.编辑缓冲 编;
编辑器.建编辑器(编, 12);
字符串 初文;
拼接到(初文, "第一行");
拼接到(初文, 编辑器.换行符());
拼接到(初文, "第二行中文");
拼接到(初文, 编辑器.换行符());
拼接到(初文, "第三行");
编辑器.装入文本(编, 初文);

编辑器视图.面板 屏;

IDE布局.布局 台;
IDE布局.建布局(台, 0, 0, 640, 400, 140, 120);        // 左 0 / 上 0 / 宽 640 / 高 400 / 左栏 140 / 下栏 120
IDE布局.编辑格挂上(台, 编, 屏);

IDE布局.加文件(台, "main.hb");
IDE布局.加文件(台, "库.hb");
IDE布局.加文件(台, "工程.hbp");
IDE布局.写输出(台, "就绪");
IDE布局.写输出(台, "编译: 0 个错误");

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 帧 = 0;
逻辑 收手 = 假;

// 这一帧的读数(验收口径:焦点 / 当前文件 / 左栏宽 / 下栏高 / 输出行数 / 命令条数)
方法 报一行(整数 帧号, 整数 条)
{
    输出行(格式化("帧{0}: 焦点={1} 当前文件={2} 左栏宽={3} 命令{4}条", 帧号, IDE布局.焦点格(台), IDE布局.当前文件(台), 台.左栏宽, 条));
    返回
}

如果 (打开窗口("IDE 三格布局", 660, 430))
{
    当 (!收手)
    {
        逻辑 变过 = 假;
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;
            }
            否则
            {
                如果 (类型 == 2)
                {
                    变过 = IDE布局.送键盘(台, 键码) || 变过;
                }
                否则
                {
                    如果 (类型 == 3)
                    {
                        变过 = IDE布局.送鼠标(台, 0, 鼠标x, 鼠标y) || 变过;
                    }
                    否则
                    {
                        如果 (类型 == 4)
                        {
                            变过 = IDE布局.送鼠标(台, 1, 鼠标x, 鼠标y) || 变过;
                        }
                        否则
                        {
                            如果 (类型 == 5)
                            {
                                变过 = IDE布局.送鼠标(台, 2, 鼠标x, 鼠标y) || 变过;
                            }
                        }
                    }
                }
            }
        }
        整数 条 = 0;
        如果 (变过 || IDE布局.要重画(台))
        {
            条 = IDE布局.重画(台);
            编辑器视图.画一屏(屏, 编);                     // 编辑器格里的内容(4-2 那一条)
        }
        报一行(帧, 条);
        刷新();
        帧 = 帧 + 1;
        等待(80);
    }
    关闭窗口();
}
停止
