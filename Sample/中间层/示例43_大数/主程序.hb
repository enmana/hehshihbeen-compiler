// ============================================================
// 示例43_大数(G4 批 11:`大数.hb` —— 任意精度整数)
//
//   一段真用得上的活:算那些**32 位装不下**的数 ——
//     ① **阶乘**:一路乘上去,30! 有 33 位十进制(32 位整数早在 13! 就爆了);
//     ② **2 的 100 次方**:反复"乘 2 加 0",101 位二进制;
//     ③ **比大小 / 加减**:负数照收;
//     ④ **除余**:1000000000000000000000 ÷ 7 = 142857142857142857142 余 6
//        (**商写进你给的那张表,余数留在被除数里** —— x86 那一套)。
//
//   一份大数 = **一张定长数组 + 两个数**:`表[]`(低位在前的 16 位 limb)·
//   `用`(用了几格,0 就是零)· `负`(0 非负 / 1 负)。三条规范形写在库的头注释里。
//
//   三条口径(演示里照它走):
//     ① **`表.长度()` 就是这一份大数的位数上限**(16 格 ≈ 77 位十进制、64 格 ≈ 308 位):
//        目标表不够大,库给 `假` 并把结果置零,**不静默截断**;
//     ② **所有函数都不停机**:容量不够 / 除数为零 / 文本不合法 ⇒ 给 `假`,不写错误槽;
//     ③ **`除余` 的余数留在被除数里**:要留被除数就先 `拷到` 一份。
// ============================================================
包含 "../../库/大数.hb"

// ---------------- ① 30!(一路乘上去) ----------------
整数 阶乘[16];
整数 阶乘用 = 0;
整数 阶乘负 = 0;
大数.从整数(阶乘, 阶乘用, 阶乘负, 1);
整数 因子[2];
整数 因子用 = 0;
整数 因子负 = 0;
整数 临时[16];
整数 临时用 = 0;
整数 临时负 = 0;
整数 i = 2;
当 (i <= 30)
{
    大数.从整数(因子, 因子用, 因子负, i);
    大数.乘(临时, 临时用, 临时负, 阶乘, 阶乘用, 阶乘负, 因子, 因子用, 因子负);
    大数.拷到(阶乘, 阶乘用, 阶乘负, 临时, 临时用, 临时负);
    i = i + 1;
}
输出行(大数.转字符串(阶乘, 阶乘用, 阶乘负));       // 30!
输出行(阶乘用);                                      // 几格 16 位

// ---------------- ② 2 的 100 次方 ----------------
整数 幂[16];
整数 幂用 = 0;
整数 幂负 = 0;
大数.从整数(幂, 幂用, 幂负, 1);
大数.从整数(因子, 因子用, 因子负, 2);
i = 0;
当 (i < 100)
{
    大数.乘(临时, 临时用, 临时负, 幂, 幂用, 幂负, 因子, 因子用, 因子负);
    大数.拷到(幂, 幂用, 幂负, 临时, 临时用, 临时负);
    i = i + 1;
}
输出行(大数.转字符串(幂, 幂用, 幂负));            // 2^100

// ---------------- ③ 比大小 / 加减(负数照收) ----------------
整数 左[16];
整数 左用 = 0;
整数 左负 = 0;
大数.从文字(左, 左用, 左负, "-123456789012345678901234567890");
整数 右[16];
整数 右用 = 0;
整数 右负 = 0;
大数.从文字(右, 右用, 右负, "123456789012345678901234567890");
输出行(大数.谁大(左, 左用, 左负, 右, 右用, 右负));   // -1
输出行(大数.谁大(右, 右用, 右负, 右, 右用, 右负));   // 0
大数.加(临时, 临时用, 临时负, 左, 左用, 左负, 右, 右用, 右负);
输出行(大数.转字符串(临时, 临时用, 临时负));         // 互为相反数 ⇒ 0
输出行(大数.是零(临时用));                            // 1
大数.减(临时, 临时用, 临时负, 右, 右用, 右负, 左, 左用, 左负);
输出行(大数.转字符串(临时, 临时用, 临时负));         // 右 − 左 = 2 倍
大数.取负(临时, 临时用, 临时负);
输出行(大数.转字符串(临时, 临时用, 临时负));         // 翻个符号 ⇒ 变成负的

// ---------------- ④ 除余:商给你,余数留在被除数里 ----------------
整数 大[16];
整数 大用 = 0;
整数 大负 = 0;
大数.从文字(大, 大用, 大负, "1000000000000000000000");
整数 七[2];
整数 七用 = 0;
整数 七负 = 0;
大数.从整数(七, 七用, 七负, 7);
整数 商[16];
整数 商用 = 0;
整数 商负 = 0;
输出行(大数.除余(大, 大用, 大负, 七, 七用, 七负, 商, 商用, 商负));   // 1
输出行(大数.转字符串(商, 商用, 商负));               // 商
输出行(大数.转字符串(大, 大用, 大负));               // 余数(留在大里)
大数.从整数(七, 七用, 七负, 0);
输出行(大数.除余(大, 大用, 大负, 七, 七用, 七负, 商, 商用, 商负));   // 0:除数为零
输出行(大数.转字符串(大, 大用, 大负));               // 什么都没动
停止

// 预期输出: 265252859812191058636308480000000|7|1267650600228229401496703205376|-1|0|0|1|246913578024691357802469135780|-246913578024691357802469135780|1|142857142857142857142|6|0|6
