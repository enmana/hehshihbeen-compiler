// 库/数学.hb —— 模块名叫 `数学`
//   文件**第一条**写 `模块 数学`,这个文件里的函数 / 结构 / 全局变量就都自动带上 `数学.` 前缀:
//     函数 求和   → 数学.求和
//     结构 rec    → 数学.rec
//     整数 累加器 → 数学.累加器
//   模块**内部**写裸名字就行(下面 平均 里直接写 求和)。
//   加了 `私有` 的名字只有本模块能用:外面写 数学.调用次数 会被当场拦住。
模块 数学

私有 整数 调用次数 = 0;          // 私有数据:库的内部账,不想让使用者碰到
整数 累加器 = 0;                 // 公开数据:外面可以直接 数学.累加器 = …

结构 rec
{
    // → 数学.rec
    整数 sum;
    整数 cnt;
}

私有 方法 记一次()
{
    // 私有助手:只有本模块能用
    调用次数 = 调用次数 + 1;
}

方法 求和(整数 表[]) 返回 整数
{
    // → 数学.求和(统计.hb 里**也有一个同名的 求和**)
    记一次();
    整数 total = 0;
    整数 i = 0;
    当 (i < 表.长度())
    {
        total = total + 表[i];
        i = i + 1;
    }
    返回 total;
}

方法 平均(整数 表[]) 返回 整数
{
    如果 (表.长度() == 0)
    {
        返回 0;
    }
    返回 求和(表) / 表.长度();     // 模块内部:裸名字直接用,不用写 数学.
}

方法 调用了几次() 返回 整数
{
    返回 调用次数;               // 私有数据由公开函数"报"出来,这才是不暴露数据的正经写法
}
