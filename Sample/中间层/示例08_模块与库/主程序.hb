// ============================================================
// 示例08:模块与库 —— 多文件工程 + 模块(名字空间)+ 方法 / 静态方法
//
//   关键字中英等价(`如果` 就是 `if`),标识符随便起,中文优先只是默认 ——
//   本文件里两种写法混着用,一样能编。
//
//   本示例演示:
//     ① 多文件工程:主程序 + `库\数学.hb` + `库\统计.hb` 三个源文件 ——
//        两个库由主程序 `包含` 内联展开,工程文件的 `文件` 表列启动文件。
//        两条路别重叠:同一个库既 `包含`、又列进 `文件` 表,模块会被声明两次(报"重复定义")。
//     ② `模块 数学` / `模块 统计`:两个库**都有一个 求和**,谁也不挡谁 ——
//        跨模块调用写全名 `数学.求和(...)` / `统计.求和(...)`,模块内部写裸名字
//     ③ `私有` 成员:外面碰不到,只能通过公开函数"报"出来
//     ④ `方法 名()` = 无状态容器(名字空间)
//     ⑤ `静态 方法 名(…)` = 带常驻状态的容器(容器里的普通语句是开机跑一次的初始化脚本)
//     ⑥ 再调一次 `Sample\库\string.hb` 里的函数
//
//   重点看:模块前缀怎么把同名函数分开;`私有` 与公开的分工。
// ============================================================
//
//   带 UI(H82 批 3):文件末尾另接了"开一个窗口,把两个库各提供什么、调用它们各算出多少画出来"
//   那一半 —— 要看它演什么、怎么点,直接跳到文件末尾那一大段注释(窗口尺寸、帧节拍、事件脚本都在那儿);
//   上面这些纯计算与全部 `测试输出` 一个字没动,没有图形能力的宿主连窗口那几行都不会打。
// ============================================================
包含 "库/数学.hb"
包含 "库/统计.hb"
包含 "../../库/string.hb"

整数 data[4] = [1, 2, 3, 4];

// ---- ② 两个模块各有一个 求和:名字带前缀,分别调用 ----
测试输出(数学.求和(data));        // 10(累加)
测试输出(统计.求和(data));        // 24(连乘:1 × 2 × 3 × 4)
测试输出(数学.平均(data));        // 2(模块内部直接调 求和)
测试输出(数学.调用了几次());      // 2(求和一次 + 平均里面那次)
// 数学.调用次数 = 99;            // ← 私有成员:取消注释会当场报错,只有 数学 模块自己能用

// 模块里的**结构**和**全局变量**也带前缀:类型名写 `数学.rec`,全局写 `数学.累加器`
数学.rec r;
r.sum = 数学.求和(data);
r.cnt = 4;
数学.累加器 = 数学.累加器 + r.sum;
测试输出(r.sum);                  // 10
测试输出(r.cnt);                  // 4
测试输出(数学.累加器);            // 10

// ---- ④ 静态 方法 名() = 无状态容器:给一组方法分个组(名字空间;H46 起容器一律带 `静态`) ----
静态 方法 数学工具()
{
    平方(short x) 返回 整数
    {
        返回 x * x;
    }
    两倍和(short a, short b) 返回 整数
    {
        返回 平方(a) + 平方(b);   // 成员之间直接叫名字
    }
}
测试输出(数学工具.平方(7));        // 49
测试输出(数学工具.两倍和(3, 4));   // 25

// ---- ⑤ 静态 方法 名(字段…) = 带常驻状态的容器 ----
//     括号里的参数就是常驻字段;容器里的普通语句是"程序开头跑一次"的初始化脚本
静态 方法 计数器(整数 步)
{
    步 = 0;                       // 初始化脚本
    累加(整数 n)
    {
        步 = 步 + n;
    }
    当前值() 返回 整数
    {
        返回 步;
    }
}
计数器.累加(5);
计数器.累加(7);
测试输出(计数器.当前值());        // 12
测试输出(计数器.步);              // 12(外面也能直接读状态)

// ---- ⑤b 成员方法也能作用在**任意一份**上(H60 步②):容器名同时是类型名,`另一份.累加(5)` 改的是 另一份 ----
//      `p.成员(…)` 是纯语法糖,等于 `成员(p, …)`(收方当第一个参数,编译期就消失)
计数器 另一份;
另一份.累加(5);
另一份.累加(7);
测试输出(另一份.当前值());        // 12(另一份自己的 步)
测试输出(计数器.当前值());        // 12(单例那一份没被动过 —— 两份各是各的)

// ---- ⑤c 容器的常驻字段与结构字段**同一把尺子**(H60 步③):数组 / 字符串 / 别的结构都能写 ----
//      非标量字段不写初值 —— 初始化就在容器第一层(那本来就是"程序开头跑一次"的脚本)
静态 方法 统计盒(整数 计数)
{
    整数 样本[3];
    字符串 名字;
    计数 = 0;
    收(整数 值)
    {
        样本[计数 % 3] = 值;
        计数 = 计数 + 1;
    }
}
统计盒.收(11);
统计盒.收(22);
测试输出(统计盒.样本[1]);         // 22(数组字段)
测试输出(统计盒.计数);            // 2(标量字段)
统计盒.名字 = "样本盒";
输出行(统计盒.名字);              // 样本盒(字符串字段)

// ---- ⑥ 顺手用一下 Sample\库\string.hb ----
输出行(转字符串(数学.求和(data)));   // 10
测试输出(找子串("math-lib", "lib")); // 5

// ============================================================
// 带 UI 的那一半(H82 批 3):把"模块 / 库"这层画出来
//
//   上面那 106 行代码(纯计算 + 全部 `测试输出`)**一个字没动**;这一块接在它们后面、`停止` 之前 ——
//   只有在真开得了窗口的宿主上才跑(没有图形能力的宿主给 假 ⇒ 一个字都不多打)。
//
//   窗口里演的是"两个库各提供什么、调用它们各算出多少":
//     · 左边两栏 = `库\数学.hb` 与 `库\统计.hb` 的公开名字(一栏一行;统计 那栏就一个公开函数);
//     · 右边 = **调用结果**:点左边一行(不点就跟着蓝底走),右边就说它拿什么算、算出多少;
//     · **逐帧推进**:每 `刷新()` 一次蓝底往下走一格(数学 六行走完接着走 统计 那一行,走完绕回);
//     · 底下六行说明:蓝底 / 绿底是什么、`模块` 前缀干了什么、库函数起名那条规矩。
//     · 窗口一直转到用户自己关(点标题栏的叉);自检与命令行靠同目录 `事件脚本.txt`
//       (写死的输入:第 2 / 7 / 9 帧各投一次点击)跑满 13 帧后由宿主投关窗请求收手。
//
//   ⚠ 主循环里**一条字符串都不现拼**:要画的字全在开窗之前拼好(见下面那几个 `字符串` 数组),
//     每帧只是照原样画 —— 每帧现拼会把编译器的字符串池吃光(示例01 / 02 实测过)。
//   ⚠ `画矩形` 是不透明实心:底色一律画在文字**之前**,画在后面会把那一行的字盖掉。
//   ⚠ 摆位与命中测试**用的是同一组数**(`行0` / `行距` / `行左` / `行宽`),要挪地方只改这几行。
// ============================================================

// ---- 摆位:左边两栏 + 右边一块(命中测试与画图共用这一组数)----
整数 窗宽 = 560;
整数 窗高 = 462;
整数 行0 = 108;                  // 左边第一行的顶边
整数 行距 = 30;                  // 一行多高(= 命中测试的除数)
整数 栏高 = 22;                  // 一行那一格多高

// 左边那 7 行:第 0~5 行在 数学 栏,第 6 行在 统计 栏(顶边 / 左边 / 宽 / 文字左边)
整数 行顶[7] = [108, 138, 168, 198, 228, 258, 108];
整数 行左[7] = [16, 16, 16, 16, 16, 16, 164];
整数 行宽[7] = [144, 144, 144, 144, 144, 144, 140];
整数 文左[7] = [22, 22, 22, 22, 22, 22, 170];

// ---- 每一行要画的字:开窗之前一次拼好(`字符串` 数组不能在声明时给初值)----
字符串 名列[7];                 // 这一行是哪个公开名字
字符串 拿首列[7];                 // 它拿什么算(第一行)
字符串 拿次列[7];                 // 它拿什么算(第二行)
字符串 值列[7];                 // 算出多少
字符串 注列[7];                 // 一句话注脚

// ⚠ 一个函数里堆几十条 `格式化` 会撞「帧超出 96 字节」⇒ 一类文字一个小函数,一个只有 7 条纯字面量分支。
方法 名文(整数 r) 返回 字符串
{
    字符串 s = "?";
    如果 (r == 0)
    {
        s = "数学.求和(表)";
    }
    如果 (r == 1)
    {
        s = "数学.平均(表)";
    }
    如果 (r == 2)
    {
        s = "数学.调用了几次";
    }
    如果 (r == 3)
    {
        s = "数学.累加器";
    }
    如果 (r == 4)
    {
        s = "数学.rec.sum";
    }
    如果 (r == 5)
    {
        s = "数学.rec.cnt";
    }
    如果 (r == 6)
    {
        s = "统计.求和(表)";
    }
    返回 s;
}

方法 拿首文(整数 r) 返回 字符串
{
    字符串 s = "";
    如果 (r == 0)
    {
        s = "拿 data[4] = 1,2,3,4";
    }
    如果 (r == 1)
    {
        s = "拿 表.长度() = 4";
    }
    如果 (r == 2)
    {
        s = "拿 私有 调用次数";
    }
    如果 (r == 3)
    {
        s = "公开全局:外面能直接读写";
    }
    如果 (r == 4)
    {
        s = "数学.rec 是模块里的结构";
    }
    如果 (r == 5)
    {
        s = "同一个结构变量的字段";
    }
    如果 (r == 6)
    {
        s = "同名函数:算法完全不同";
    }
    返回 s;
}

方法 拿次文(整数 r) 返回 字符串
{
    字符串 s = "";
    如果 (r == 0)
    {
        s = "表.长度() 当边界,逐项累加";
    }
    如果 (r == 1)
    {
        s = "先 求和(表) ⇒ 10,再 10 / 4";
    }
    如果 (r == 2)
    {
        s = "求和 一次 + 平均 里那次";
    }
    如果 (r == 3)
    {
        s = "= 0 + r.sum(10)";
    }
    如果 (r == 4)
    {
        s = "r.sum = 数学.求和(data)";
    }
    如果 (r == 5)
    {
        s = "r.cnt = 4";
    }
    如果 (r == 6)
    {
        s = "拿 data[4] 逐项连乘";
    }
    返回 s;
}

方法 值文(整数 r) 返回 字符串
{
    字符串 s = "";
    如果 (r == 0)
    {
        s = "⇒ 10";
    }
    如果 (r == 1)
    {
        s = "⇒ 2";
    }
    如果 (r == 2)
    {
        s = "⇒ 2";
    }
    如果 (r == 3)
    {
        s = "⇒ 10";
    }
    如果 (r == 4)
    {
        s = "⇒ 10";
    }
    如果 (r == 5)
    {
        s = "⇒ 4";
    }
    如果 (r == 6)
    {
        s = "⇒ 24";
    }
    返回 s;
}

方法 注文(整数 r) 返回 字符串
{
    字符串 s = "";
    如果 (r == 0)
    {
        s = "模块里直接叫 记一次()";
    }
    如果 (r == 1)
    {
        s = "模块内部写裸名字 求和";
    }
    如果 (r == 2)
    {
        s = "私有成员:外面碰不到";
    }
    如果 (r == 3)
    {
        s = "模块的全局也带前缀 数学.";
    }
    如果 (r == 4)
    {
        s = "结构名也带前缀 数学.rec";
    }
    如果 (r == 5)
    {
        s = "与 r.sum 同一个结构变量";
    }
    如果 (r == 6)
    {
        s = "两个 求和 各在各的模块里";
    }
    返回 s;
}

// ---- 窗口自己要记住的那几格(写在顶层,别藏在嵌套里)----
整数 类型 = 0;                   // 图形那一套要的四个出参(照 示例14 / 15 / 16)
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                    // 这一帧那"点一下"落在哪儿
整数 点y = 0;
整数 选中 = -1;                  // -1 = 还没点;0~5 = 数学 栏第几行;6 = 统计 栏那一行
整数 光标 = 0;                   // 每刷新一帧往下走一格,走完 7 行绕回第 0 行
逻辑 有一下 = 假;                // 这一帧收到过"点一下"(按下 + 抬起)没有

// ---- 开窗之前把要画的字全部拼好:进主循环之后一条字符串都不再拼(见上面那句「池用完了」)----
整数 填 = 0;
当 (填 < 7)
{
    名列[填] = 名文(填);
    拿首列[填] = 拿首文(填);
    拿次列[填] = 拿次文(填);
    值列[填] = 值文(填);
    注列[填] = 注文(填);
    填 = 填 + 1;
}

// ---- 开窗:下面那一层每帧只画(一条字符串都不再拼)----
逻辑 开着 = 打开窗口("示例08 模块与库", 窗宽, 窗高);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算:数学 栏 6 行从 y=行0 起、每行 行距(横着 16~160);
        // 统计 栏那一行在 x 164~304、y 108~130(与上面 行顶 / 行左 / 行宽 是同一组数)。
        // ⚠ 这一步**单独摆在这一层**:命中测试与赋值别塞进上面那串嵌套里(塞进去实测不落地)。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 16 && 点x < 160 && 点y >= 行0 && 点y < 行0 + 6 * 行距)
            {
                选中 = (点y - 行0) / 行距;
            }
            如果 (点x >= 164 && 点x < 304 && 点y >= 行0 && 点y < 行0 + 栏高)
            {
                选中 = 6;
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼,画的都是开窗前拼好的)----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 40, 0xFF2A3550);
            画文字(24, 16, "示例08 模块与库:两个库各提供什么 → 调用算出多少", 0xFFE8E8F0);
            画文字(24, 34, "左边两栏 = 数学 / 统计 的公开名字;点一行看右栏", 0xFFB0B0B8);

            // 左边那块:两栏(数学 / 统计)—— 底先铺、字后画
            画矩形(12, 64, 296, 236, 0xFF16161E);
            画文字(22, 72, "数学 模块", 0xFF9CC4FF);
            画文字(170, 72, "统计 模块", 0xFF9CC4FF);
            画文字(22, 88, "库/数学.hb", 0xFF7A7A88);
            画文字(170, 88, "库/统计.hb", 0xFF7A7A88);
            画文字(170, 146, "公开函数就这一个", 0xFF7A7A88);
            画文字(170, 170, "同名 求和 不打架", 0xFF7A7A88);
            画文字(170, 194, "各在各的模块里", 0xFF7A7A88);
            画文字(170, 218, "外面要写全名", 0xFF7A7A88);

            // 两栏的函数清单:蓝底 = 光标这一帧走到的那一行,绿底 = 点中的那一行,暗蓝 = 鼠标压着的那一行
            // ⚠ 颜色别先存进 `整数` 变量:0xFF2A6EF0 这种 32 位常量超出 `整数` 的范围(当场报错),
            //   直接写进 `画矩形(...)` 当实参没问题(与 示例03 / 13 同一写法)。
            整数 i = 0;
            当 (i < 7)
            {
                整数 顶 = 行顶[i];
                逻辑 压着 = 鼠标x >= 行左[i] && 鼠标x < 行左[i] + 行宽[i] && 鼠标y >= 顶 && 鼠标y < 顶 + 栏高;
                如果 (i == 选中)
                {
                    画矩形(行左[i], 顶, 行宽[i], 栏高, 0xFF2FA84F);
                }
                否则 如果 (i == 光标)
                {
                    画矩形(行左[i], 顶, 行宽[i], 栏高, 0xFF2A6EF0);
                }
                否则 如果 (压着)
                {
                    画矩形(行左[i], 顶, 行宽[i], 栏高, 0xFF3A4664);
                }
                否则
                {
                    画矩形(行左[i], 顶, 行宽[i], 栏高, 0xFF23232E);
                }
                画文字(文左[i], 顶 + 4, 名列[i], 0xFFD0D0D8);
                i = i + 1;
            }

            // 右边那块:讲这一行"拿什么算、算出多少"(点过就一直讲点中的那一行,没点过就跟着光标走)
            画矩形(320, 64, 228, 236, 0xFF16161E);
            画文字(332, 74, "点左边一行就钉住这一行", 0xFF7A7A88);
            整数 详 = 光标;
            如果 (选中 >= 0)
            {
                详 = 选中;
            }
            画矩形(332, 92, 204, 22, 0xFF232B3E);
            画文字(338, 95, 名列[详], 0xFF9CC4FF);
            画文字(332, 126, "拿什么算:", 0xFF7A7A88);
            画文字(332, 146, 拿首列[详], 0xFFD0D0D8);
            画文字(332, 168, 拿次列[详], 0xFFD0D0D8);
            画文字(332, 196, "算出多少:", 0xFF7A7A88);
            画矩形(332, 214, 204, 24, 0xFF1E3A2E);
            画文字(338, 219, 值列[详], 0xFF8CE8A0);
            画文字(332, 250, 注列[详], 0xFFB0B0B8);

            // 底下六行说明
            画线(12, 312, 548, 312, 0xFF3C3C46);
            画文字(20, 324, "蓝底 = 光标:每帧往下走一格(数学 走完接着走 统计)", 0xFF9CC4FF);
            画文字(20, 346, "绿底 = 你点中的那一行;右边一直讲这一行", 0xFF8CE8A0);
            画文字(20, 370, "库文件第一条 模块 数学 ⇒ 里面的名字自动带 数学. 前缀", 0xFF8A8A96);
            画文字(20, 392, "库函数名不许撞语言关键字 / 类型名 / ISA 助记符 / 内建名", 0xFF8A8A96);
            画文字(20, 414, "撞上当场报错带改法:叫 求和 / 平均 行,叫 取反 / 加载 不行", 0xFF8A8A96);
            画文字(20, 436, "两条路别重叠:包含 进来的库别再列进 .hbp 的文件表(重复定义)", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)

            // 逐帧推进:每刷新一帧,蓝底往下走一格;走到第 7 行就绕回第 0 行
            光标 = 光标 + 1;
            如果 (光标 >= 7)
            {
                光标 = 0;
            }
        }
    }

    关闭窗口();
}

停止

