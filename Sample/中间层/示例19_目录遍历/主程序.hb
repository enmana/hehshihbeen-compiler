// ============================================================
// 示例19:目录与路径(库 `Sample\库\目录.hb`;R3-4 第三支)
//
//   要解决的事:语言内建了 `建目录` / `删文件` / `列目录`,但路径要自己拼(多一个斜杠、少一个斜杠都编得过、
//   跑起来才发现不对)、名字要自己切、列出来的清单还要自己数行 —— 这一批把这些收进库。
//
//   库**不另起第二个名字**:`建目录` / `删文件` / `列目录` 照旧直接用(一个需求一个入口),
//   库里补的是"拼路径 / 拆名字"的纯函数,加上清单这一族(列出 / 数出 / 条目数 / 取条目 / 条目到表)。
//
//   两条语言边界(见库文件头,也钉在自检里):
//     ① `引用 字符串` 编不过(报"引用指向的类型不认识")⇒ 清单走返回值,不走出参;
//     ② `列目录` 的上限要编译期常量 ⇒ 上限由库写死 65536。
//
//   本示例演示:
//     ① 路径拼接 / 去尾分隔
//     ② 取文件名 / 取目录 / 取后缀 / 是绝对路径
//     ③ 建目录 + 写两个文件
//     ④ 列出 / 条目数 / 取条目(含越界给空串)
//     ⑤ 条目到表(每条写进"起 + 长"两条并排数组)
//     ⑥ 列不成的目录给 -1(与空目录的 0 区分开)
//     ⑦ 收尾:删文件 / 删目录,不给仓库留垃圾
// ============================================================
包含 "../../库/目录.hb"

字符串 根 = "Sample/中间层/示例19_目录遍历";

// ① 路径拼接:末尾多几个斜杠、名字前面带不带斜杠,都替你收拾好
输出行(目录.路径拼接("数据/备份/", "日志.txt"));
输出行(目录.路径拼接("数据", "日志.txt"));
输出行(目录.去尾分隔("数据/备份///"));

// ② 拆名字(全是纯函数,不查盘)
输出行(目录.取文件名("数据/备份/日志.txt"));
输出行(目录.取目录("数据/备份/日志.txt"));
输出行(目录.取后缀("数据/备份/日志.txt"));
字符串 无点 = 目录.取后缀("数据/备份/没有点");
测试输出(无点.长度());
字符串 尾斜 = 目录.取文件名("数据/备份/");
测试输出(尾斜.长度());
测试输出(目录.是绝对路径("C:/数据"));
测试输出(目录.是绝对路径("数据/备份"));

// ③ 建目录 + 写两个文件(建目录 已存在也算成功,所以这个示例能反复跑)
字符串 临时 = 目录.路径拼接(根, "临时");
输出行(建目录(临时));
字符串 首文件 = 目录.路径拼接(临时, "a.txt");
字符串 次文件 = 目录.路径拼接(临时, "b.txt");
输出行(写文件(首文件, "a"));
输出行(写文件(次文件, "b"));

// ④ 列出 / 数 / 取:`列目录` 给的是"名字按行排"的一条串,库里这一族就是伺候它的
字符串 清单 = 目录.列出(临时);
测试输出(目录.条目数(清单));
输出行(目录.取条目(清单, 0));
输出行(目录.取条目(清单, 1));
字符串 越界 = 目录.取条目(清单, 9);
测试输出(越界.长度());
测试输出(目录.数出(临时));

// ⑤ 条目到表:每条的"起 + 长"写进两条并排数组(与 string.hb 的 `切分` 一个手势)
整数 起[4];
整数 长[4];
整数 条 = 目录.条目到表(清单, 起, 长);
测试输出(条);
输出行(取子串(清单, 起[1], 长[1]));

// ⑥ 列不成给 -1(空目录才是 0 —— 两个都想知道就问 `数出`)
字符串 没有 = 目录.路径拼接(根, "没有这个目录");
测试输出(目录.数出(没有));
字符串 空单 = 目录.列出(没有);
测试输出(空单.长度());

// ⑦ 收尾:两个文件删掉、目录删掉(删目录只删空目录),再问一句应当是"列不成"
输出行(删文件(首文件));
输出行(删文件(次文件));
输出行(删目录(临时));
测试输出(目录.数出(临时));
停止

// 预期输出: 数据/备份/日志.txt|数据/日志.txt|数据/备份|日志.txt|数据/备份|txt|0|0|1|0|1|1|1|2|a.txt|b.txt|0|2|2|b.txt|-1|0|1|1|1|-1
