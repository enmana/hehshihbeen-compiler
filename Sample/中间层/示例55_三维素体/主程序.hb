// ============================================================
// 示例55_三维素体:参数化**女性人体素体** + 线框渲染(R4-10)
//
//   这一篇要看的不是"画得多漂亮",而是**形体比例对不对**:
//   用算法把不穿衣服的形体长出来(绕 y 轴慢慢转),人眼判断像不像。
//
//   三份库(都在 `Sample\库\`):
//     · `三维数学.hb` —— 浮点平方根 / 正余弦(这门语言没有内建,是自己写的泰勒级数);
//     · `三维网格.hb` —— 顶点数组、横截面造形、旋转、透视投影、画线框、相机;
//     · `素体.hb`    —— **人体比例全在这一个文件里**(16 圈横截面 + 两侧胸 + 四肢 + 脚)。
//
//   两个可以拧的旋钮:
//     `每帧转角`   转得多快
//     `等多少毫秒` 每帧歇多久(决定每秒几帧)
//   ⚠ **没有"跑多少帧"这一档了**(第415批撤掉):硬规矩 7 的口径是
//     "**窗口循环转到用户自己关窗**";有上限就会到点自己关,看着像"一闪就没了"。
//
//   两档跑法:
//     · 真窗口(`hbcc --exe` 贴出来的 exe,或带图形壳的宿主):转起来给你看;
//     · 无头(`hbcc --run`):窗口那一段**跳过**,只在末尾报三个数(顶点 / 边 / 跑了多少帧)。
// ============================================================
包含 "../../库/三维数学.hb"
包含 "../../库/三维网格.hb"
包含 "../../库/素体.hb"

浮点 每帧转角 = 0.02;
整数 等多少毫秒 = 14;

// ---- 先把素体长出来(只建一次;厘米坐标,够 `三维网格` 的相机口径直接看)----
素体.建();

整数 跑了 = 0;
整数 帧 = 0;
逻辑 开着 = 打开窗口("HB 三维素体 —— 参数化人体线框", 480, 520);
如果 (开着)
{
    浮点 转角 = 0.0;
    整数 类型 = 0;
    整数 键码 = 0;
    整数 鼠x = 0;
    整数 鼠y = 0;
    逻辑 还开着 = 真;
    // ⚠ 转到用户自己关窗(第415批撤掉 `帧 < 跑多少帧`);
    //   自检那条腿靠**事件脚本**投"关窗请求"收手(见同目录 `事件脚本.txt`)
    当 (还开着)
    {
        三维网格.摆偏航(转角);
        清屏(0xFF0C0C12);
        三维网格.画线框(0xFF8FD6FF);
        画文字(8, 8, "HB 三维素体 —— 参数化人体线框", 0xFFFFFFFF);
        画文字(8, 24, "ESC 或关窗退出", 0xFF8090A0);
        刷新();
        转角 = 转角 + 每帧转角;
        帧 = 帧 + 1;
        当 (取事件(类型, 键码, 鼠x, 鼠y))
        {
            如果 (类型 == 1 || 键码 == 27)
            {
                还开着 = 假;
            }
        }
        等待(等多少毫秒);
    }
    关闭窗口();
}
跑了 = 帧;

// ---- 报三个数:跑了多少帧 / 顶点数 / 边数 ----
//   判据:后两个数说明模型真长出来了;`跑了 > 0` 说明窗口那段真跑起来了。
//   ⚠ **独立 exe 那条腿上 `打开窗口` 会给假**(贴出来的宿主里那层 Avalonia 桌面壳起不来,
//     实测卡 15 秒后失败)⇒ 那条腿上看不到窗口;要看窗口走 IDE 的 F5 或 `hbcc --run` 的进程内呈现。
测试输出(跑了);
测试输出(三维网格.顶点数);
测试输出(三维网格.边数);
停止
