// ============================================================
// 示例48_JSON与窗口(G4 批 16:`Sample\库\JSON.hb` + `界面.hb`)
//
//   这一段演示什么:**把一份 JSON 配置解析出来,摆到窗口上** ——
//     ① **整份解析**:`JSON.解析` 吃一段 JSON 文本,交回一个根节点号;
//     ② **路径取值**:`JSON.取文本 / 取整数 / 取逻辑 / 个数 / 是空` 按 `根.列表[0].名字` 一步取到位
//        (取字符串那一档写进**你自己的那一格**,反复取不涨池);
//     ③ **生成往返**:`JSON.生成到` 出来的那一串与解析进来那一串**逐字节相同**;
//     ④ **控件库**:把取到的值拼成标签摆进窗口(`界面.hb` 的 `建界面 / 加标签 / 重画`)。
//
//   三条口径(演示里照它走):
//     ① **节点号只在"当前这一份"里有效**:换一份文档之前先 `JSON.清空()`;
//     ② **取串要给它一格**:`字符串 值 = ""; JSON.取文本(根, "名字", 值);` —— 返回值只说取到没有;
//     ③ **界面那一套是"即时模式"**:改了就 `标脏`,`要重画` 问一句,`重画` 才真发绘制命令。
//
//   ⚠ 窗口那一半照 `示例16_控件库` 的骨架:**第 0 帧画一屏,之后没有事件就只推进节拍**;
//     自检与 `hbcc --run --无头 --事件脚本 …` 按同目录那份 `事件脚本.txt` 喂帧 —— 不开窗也能跑得一模一样。
// ============================================================
包含 "../../库/JSON.hb"
包含 "../../库/界面.hb"

// ---- ① 一份 JSON 配置(用 `拼接到` 现拼,免得在源码里叠引号) ----
字符 引 = '"';
字符串 配置 = "";
拼接到(配置, '{');
拼接到(配置, 引);
拼接到(配置, "名字");
拼接到(配置, 引);
拼接到(配置, ':');
拼接到(配置, 引);
拼接到(配置, "张三");
拼接到(配置, 引);
拼接到(配置, ',');
拼接到(配置, 引);
拼接到(配置, "年龄");
拼接到(配置, 引);
拼接到(配置, ':');
拼接到(配置, "28");
拼接到(配置, ',');
拼接到(配置, 引);
拼接到(配置, "在职");
拼接到(配置, 引);
拼接到(配置, ':');
拼接到(配置, "true");
拼接到(配置, ',');
拼接到(配置, 引);
拼接到(配置, "爱好");
拼接到(配置, 引);
拼接到(配置, ':');
拼接到(配置, '[');
拼接到(配置, 引);
拼接到(配置, "读书");
拼接到(配置, 引);
拼接到(配置, ',');
拼接到(配置, 引);
拼接到(配置, "爬山");
拼接到(配置, 引);
拼接到(配置, ']');
拼接到(配置, '}');

整数 根 = JSON.解析(配置);
测试输出(JSON.种类(根, ""));                 // 6 对象
测试输出(JSON.取整数(根, "年龄", 0));        // 28

// ---- ② 取值:字符串写进自己那一格 ----
字符串 名字 = "";
测试输出(JSON.取文本(根, "名字", 名字));     // 1(取到了)
输出行(名字);                                 // 张三
字符串 爱好 = "";
测试输出(JSON.取文本(根, "爱好[1]", 爱好));  // 1
输出行(爱好);                                 // 爬山
测试输出(JSON.取逻辑(根, "在职", 假));       // 1
测试输出(JSON.个数(根, "爱好"));              // 2
测试输出(JSON.取整数(根, "没有这个", 7));     // 7(给默认)

// ---- ③ 生成往返:与进来那一串逐字节相同 ----
字符串 出 = "";
测试输出(JSON.生成到(根, 出));               // 1
测试输出(出 == 配置);                         // 1

// ---- ④ 摆到窗口上 ----
界面 表单;
建界面(表单, 12, 12, 260, 8);
整数 标一 = 加标签(表单, "JSON 演示");
字符串 行二 = "";
拼接到(行二, "名字:");
拼接到(行二, 名字);
整数 标二 = 加标签(表单, 行二);
字符串 行三 = "";
拼接到(行三, "爱好[1]:");
拼接到(行三, 爱好);
整数 标三 = 加标签(表单, 行三);
测试输出(控件数(表单));                      // 3
测试输出(控件上(表单, 标三));                // 66(三行往下推)

如果 (打开窗口("JSON 演示", 300, 200))
{
    逻辑 收手 = 假;
    整数 帧 = 0;
    整数 类型 = 0;
    整数 键码 = 0;
    整数 鼠标x = 0;
    整数 鼠标y = 0;
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                        // 关窗请求:这一帧之后不再画
            }
            否则
            {
                送事件(表单, 类型, 键码, 鼠标x, 鼠标y);
            }
        }
        如果 (!收手)
        {
            如果 (要重画(表单))
            {
                测试输出(帧);                      // 哪一帧真重画了
                整数 条 = 重画(表单);
                测试输出(条);                      // 这一帧发了几条绘制命令
            }
            否则
            {
                测试输出(-1);                      // 干净的一帧:一条绘制命令都不发
            }
            刷新();
            帧 = 帧 + 1;
            等待(250);                             // 无头不真等;无人去关就一直转(脚本到帧数自己收手)
        }
    }
    关闭窗口();
}

停止
// 预期输出: 6|28|1|张三|1|爬山|1|2|7|1|1|3|72|打开窗口 标题="JSON 演示" 宽=300 高=200|0|4|清屏 颜色=0xFF101018|画文字 x=12 y=16 文本="JSON 演示" 颜色=0xFFB0B0B8|画文字 x=12 y=46 文本="名字:张三" 颜色=0xFFB0B0B8|画文字 x=12 y=76 文本="爱好[1]:爬山" 颜色=0xFFB0B0B8|刷新 命令=4|-1|刷新 命令=0|关闭窗口
