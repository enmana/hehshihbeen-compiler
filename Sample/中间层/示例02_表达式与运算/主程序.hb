// 示例02_表达式与运算 —— 优先级、位运算、复合赋值、比较当值、三目
//
//   这个示例演示什么:
//     1) 优先级与括号:`2 + 3 * 4` 是 14,`(2 + 3) * 4` 才是 20
//        完整优先级(高 → 低):() > 一元 - ! ~ > * / % > + - > << >> > & > ^ > | > 比较 > && > ||
//     2) 一元负(-c)与按位取反 ~(32 位整体取反,`~0` = 4294967295)
//     3) 位运算 `& | ^` 与移位 `<< >>`
//     4) 十个复合赋值:`+= -= *= /= %= &= |= ^= <<= >>=`,循环步进里也能写
//     5) 自增自减 `++` `--`
//     6) 32 位常量:0x12345678 这种一次写下来,编译器自己拆成两条指令
//     7) 比较当值用:`逻辑 big = p > q` —— 结果是个逻辑值(0/1),能存、能参与算术
//     8) 三目 `条件 ? a : b`:只算被选中的那一支,可以套着写
//
//   重点看哪几处:【1)】括号让两个式子差 6、【4)】十个复合赋值连做下来 x 的变化、
//   【7)】逻辑值当数字用、【8)】三目套三目。
//   关键字中英等价 —— 本示例里 `如果` 与 `if`、`循环` 与 `for` 混着写,两种都认;
//   标识符随便起(短英文即可),中文优先只是默认。
//
//   ============================================================
//   怎么看(带 UI;H82 批 1)—— 这一份是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例02 表达式与运算`。
//       窗口里是一张**算式 / 结果**清单:26 行分成三组(优先级与分组 / 位运算与复合赋值 /
//       比较当值与三目),右边那列就是程序真跑出来的值(和上面那些 `测试输出` 一个不差)。
//       **鼠标点哪一行就选中哪一行**(点中的那行有蓝底),下面三行是它的"为什么":
//       `为什么 2 + 3 * 4 = 14:` 加两句来历(乘先算 / 要 20 就得写括号)。
//       窗口**一直转到你自己关掉**(点标题栏的叉)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、也不用等人去关 ——
//       旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),跑满它写的帧数就投一个关窗请求;
//       于是"窗口该画什么、点一下变成什么样"都能逐行对出来(硬规矩 6:自检不开窗)。
//     · **顺序**:先把上面那些纯计算跑完、`测试输出` 打完(文件末尾那行 `// 预期输出:` 对的就是它们),
//       **然后**才开窗 —— 于是这一份示例的期望输出里,"数"还是那些数,窗口那几行排在后头。
//   ============================================================

// 1) 优先级与括号
整数 a = 2 + 3 * 4;          // 14:乘先算
整数 b = (2 + 3) * 4;        // 20:括号先算
测试输出(a);
测试输出(b);
测试输出(1 << 4 + 1);        // 32:加先算,再移位
测试输出(0x0F & 3 | 0xF0);   // 243:& 先于 |

// 2) 一元负
整数 c = 5;
测试输出(-c);                // -5
测试输出(-5 + 10);           // 5
测试输出(-(3 + 4));          // -7

// 3) 按位取反 ~(只给符号写法,不给中文名)
测试输出(~5 & 0xFF);         // 250:~5 = 4294967290,再截低 8 位
无符号整数 all = ~0;          // 32 位整体取反
测试输出(all);               // 4294967295

// 4) 位运算与移位
测试输出(12 & 10);           // 8
测试输出(12 | 10);           // 14
测试输出(12 ^ 10);           // 6
测试输出(3 << 4);            // 48
测试输出(0x80 >> 3);         // 16

// 5) 十个复合赋值:下面十句就是 15 10 40 8 2 10 8 11 44 22
整数 x = 12;
x += 3;                      // 15
x -= 5;                      // 10
x *= 4;                      // 40
x /= 5;                      // 8
x %= 3;                      // 2
x |= 8;                      // 10
x &= 12;                     // 8
x ^= 3;                      // 11
x <<= 2;                     // 44
x >>= 1;                     // 22
测试输出(x);

// 6) 自增自减
整数 i = 7;
i++;                         // 8
i--;                         // 7
测试输出(i);
整数 sum = 0;
循环 (整数 k = 1; k <= 4; k += 1)
{
    // 步进里也能写复合赋值
    sum += k;
}
测试输出(sum);               // 1+2+3+4 = 10

// 7) 32 位常量
整数 big = 0x12345678;       // 305419896:编译器自动拆 高位配置 + 或立即数
测试输出(big);

// 8) 比较当值用:结果是 逻辑(0/1)
整数 p = 7;
整数 q = 3;
逻辑 gt = p > q;             // 1
逻辑 eq = p == q;            // 0
测试输出(gt);
测试输出(eq);
测试输出(10 + (p > q));      // 11:逻辑值当数字用

// 9) 三目:只算被选中的那一支
测试输出(p > q ? p : q);     // 7
整数 score = 75;
测试输出(score >= 90 ? 3 : (score >= 60 ? 2 : 1));   // 2:三目套三目

// 10) 关键字中英等价:`如果` 与 `if` 混着写也行
if (p > q)
{
    测试输出(1);            // 英文 if
}
如果 (p < q)
{
    测试输出(0);            // 中文 如果:这层不进来
}

// ---- 11) 带 UI 的那一半(H82 批 1):算式 / 结果清单 + 点一行看"为什么是这个值" ----
// 这一整块**只在真开得了窗口时才跑**:没有图形能力的宿主给 假 ⇒ 一个字都不多打,
// 上面那 23 个数还是上面那 23 个数(顺序、条数一个字没动)。

包含 "../../库/string.hb"        // `格式化(...)` 要用的那个 `转字符串` 在库里

// 窗口参数与行布局(表头 3 行 + 算式 26 行,两组之间的空当不同):
// 下面画图和命中测试**用的是同一组数** —— 要挪地方只改这几行(表头画在哪儿也从它们算出来)。
整数 窗宽 = 560;
整数 窗高 = 990;
整数 行0 = 114;                  // 第一行的顶边
整数 行距 = 24;                  // 一行多高( = 命中测试的除数)
整数 组1头 = 84;                 // 三个分组标画的 y
整数 组2头 = 458;                // = 行0 + 13 * 行距 + 32(第一组 13 行 + 空当)
整数 组3头 = 762;                // = 行0 + 22 * 行距 + 64 + 32(前两组 24 行 + 空当)
整数 分隔y = 916;                // 算式清单与"这一行的来历"之间那条线
整数 详1y = 928;                 // "为什么 … = …"那一行
整数 详2y = 952;                 // 来历第一行
整数 详3y = 972;                 // 来历第二行

方法 画分组标(整数 y, 字符串 文本)
{
    画矩形(12, y, 窗宽 - 24, 24, 0xFF232B3E);
    画文字(20, y + 4, 文本, 0xFF9CC4FF);
}

// 算式那一列:都在 18 格以内,每行按宽度补齐 ⇒ 右边那列自然对齐
方法 补白(字符串 值, 整数 宽) 返回 字符串
{
    字符串 结果 = 值;
    当 (结果.长度() < 宽)
    {
        拼接到(结果, " ");
    }
    返回 结果;
}

// ---- 26 行 = 3 组:0~12 优先级与分组 / 13~21 位运算与复合赋值 / 22~25 比较与三目 ----
// ⚠ 26 行说明拆成两个函数(见结尾记的"帧只有 96 字节"那条):一个函数里堆 26 个分支当场报「帧超出」。
// ⚠ 这几个函数一律**只用一个局部**:值文本那一列要靠 `格式化(...)`,而它一个调用就要一份临时槽。
方法 取算式(整数 行) 返回 字符串
{
    字符串 s = "";
    如果 (行 == 0)
    {
        s = "2 + 3 * 4";
    }
    如果 (行 == 1)
    {
        s = "(2 + 3) * 4";
    }
    如果 (行 == 2)
    {
        s = "1 << 4 + 1";
    }
    如果 (行 == 3)
    {
        s = "0x0F & 3 ｜ 0xF0";
    }
    如果 (行 == 4)
    {
        s = "-5 + 10";
    }
    如果 (行 == 5)
    {
        s = "-(3 + 4)";
    }
    如果 (行 == 6)
    {
        s = "7 > 3";
    }
    如果 (行 == 7)
    {
        s = "7 == 3";
    }
    如果 (行 == 8)
    {
        s = "10 + (7 > 3)";
    }
    如果 (行 == 9)
    {
        s = "7 > 3 ? 7 : 3";
    }
    如果 (行 == 10)
    {
        s = "75 分 ? 3 : 2 : 1";
    }
    如果 (行 == 11)
    {
        s = "如果 (7 > 3)";
    }
    如果 (行 == 12)
    {
        s = "如果 (7 < 3)";
    }
    如果 (行 == 13)
    {
        s = "~5 & 0xFF";
    }
    如果 (行 == 14)
    {
        s = "~0";
    }
    如果 (行 == 15)
    {
        s = "1 << 4";
    }
    如果 (行 == 16)
    {
        s = "12 & 10";
    }
    如果 (行 == 17)
    {
        s = "12 ｜ 10";
    }
    如果 (行 == 18)
    {
        s = "12 ^ 10";
    }
    如果 (行 == 19)
    {
        s = "0x80 >> 3";
    }
    如果 (行 == 20)
    {
        s = "+=";
    }
    如果 (行 == 21)
    {
        s = "-= *= /= %= ｜= &= ^= <<= >>=";
    }
    如果 (行 == 22)
    {
        s = "i++ 与 i--";
    }
    如果 (行 == 23)
    {
        s = "k += 1 每轮步进";
    }
    如果 (行 == 24)
    {
        s = "0x12345678";
    }
    如果 (行 == 25)
    {
        s = "x = 12 复合十连";
    }
    返回 s;
}

// 结果那一列:能写成常量的直接写常量,是从变量来的(那 10 个、自增那两行、32 位常量)
// 就现算 —— **跑出来的数与原文件里 `测试输出` 打的那一个逐字一致**。
// ⚠ 只能用 `格式化(...)` ≥ 2 个的分支放这一个函数里(它一份调用要一个临时槽);
//   ⚠ 而且**不能**写成 `"x = " + 格式化(...)` —— 字符串赋值右边只认"字面量 / 另一个字符串 / 一个返回字符串的调用",
//     多段拼接要一句一个 `拼接到`(下面这 5 行就是这么拼的)。
方法 取结果(整数 行) 返回 字符串
{
    字符串 r = "";
    如果 (行 == 0)
    {
        r = "14";
    }
    如果 (行 == 1)
    {
        r = "20";
    }
    如果 (行 == 2)
    {
        r = "32";
    }
    如果 (行 == 3)
    {
        r = "243";
    }
    如果 (行 == 4)
    {
        r = "5";
    }
    如果 (行 == 5)
    {
        r = "-7";
    }
    如果 (行 == 6)
    {
        r = "1(真)";
    }
    如果 (行 == 7)
    {
        r = "0(假)";
    }
    如果 (行 == 8)
    {
        r = "11";
    }
    如果 (行 == 9)
    {
        r = "7";
    }
    如果 (行 == 10)
    {
        r = "2";
    }
    如果 (行 == 11)
    {
        r = "打 1";
    }
    如果 (行 == 12)
    {
        r = "不进来";
    }
    如果 (行 == 13)
    {
        r = "250";
    }
    如果 (行 == 14)
    {
        r = "4294967295";
    }
    如果 (行 == 15)
    {
        r = "48";
    }
    如果 (行 == 16)
    {
        r = "8";
    }
    如果 (行 == 17)
    {
        r = "14";
    }
    如果 (行 == 18)
    {
        r = "6";
    }
    如果 (行 == 19)
    {
        r = "16";
    }
    如果 (行 == 20)
    {
        拼接到(r, "x = ", 说明x);
    }
    如果 (行 == 21)
    {
        拼接到(r, "x = ", 说明x);
    }
    如果 (行 == 22)
    {
        拼接到(r, "i = ", 说明i);
    }
    如果 (行 == 23)
    {
        拼接到(r, "sum = ", 说明sum);
    }
    如果 (行 == 24)
    {
        r = 说明big;
    }
    如果 (行 == 25)
    {
        r = "22";
    }
    返回 r;
}

// 选中哪一行,就在下面把"为什么是这个值"说清楚:来历写成**两行**,一行一个函数、一行一个 `画文字`。
// ⚠ 两行是**画**出来的两条命令,不是字符串里的换行 —— `\n` 塞进 `画文字` 的文本里会把
//   无头呈现那一行撑成两行,`// 预期输出:` 的 `|` 分法当场对不上(实测踩过)。
// ⚠ 一行大致放得下 **55 格**(ASCII 一格、汉字两格),没有自动折行这种控件 ⇒ 太长的说明自己断句。
// ⚠ 每段字符串字面量都住在函数帧里:一条分支只给 `d` 赋一次值,26 条拆成 4 个函数(一个函数里堆 13 条
//   就会报「帧超出 96 字节」—— 实测:13 条那种写法当场报错)。
方法 取来历细说前(整数 行) 返回 字符串
{
    字符串 d = "";
    如果 (行 == 0)
    {
        d = "* 乘比加先算:3 * 4 = 12,再加 2 ⇒ 14";
    }
    如果 (行 == 1)
    {
        d = "* 括号最紧:先算里面的 2 + 3 = 5,再 5 * 4 ⇒ 20";
    }
    如果 (行 == 2)
    {
        d = "* 加比移位紧:先 4 + 1 = 5,再 1 << 5 ⇒ 32";
    }
    如果 (行 == 3)
    {
        d = "* & 比 ｜ 紧:先 0x0F & 3 = 3,再 3 ｜ 0xF0 = 0xF3";
    }
    如果 (行 == 4)
    {
        d = "* 一元负只贴住紧跟它的那个数:(-5) + 10 ⇒ 5";
    }
    如果 (行 == 5)
    {
        d = "* 括号先算 3 + 4 = 7,再对整体取负 ⇒ -7";
    }
    如果 (行 == 6)
    {
        d = "* 比较当值用:p > q 的结果就是逻辑值 真";
    }
    如果 (行 == 7)
    {
        d = "* p == q 不成立 ⇒ 逻辑值 假";
    }
    如果 (行 == 8)
    {
        d = "* 逻辑值直接当数加:10 + 真 = 10 + 1 ⇒ 11";
    }
    如果 (行 == 9)
    {
        d = "* 三目:条件 7 > 3 成立 ⇒ 取前一枝 7";
    }
    如果 (行 == 10)
    {
        d = "* 三目套三目:先看 75 >= 90 不成立";
    }
    如果 (行 == 11)
    {
        d = "* 中文 如果 与英文 if 完全等价";
    }
    如果 (行 == 12)
    {
        d = "* p < q 不成立 ⇒ 这一层**不进**来";
    }
    如果 (行 == 13)
    {
        d = "* ~ 对 32 位整体取反:~5 = 4294967290";
    }
    返回 d;
}

方法 取来历细说二前(整数 行) 返回 字符串
{
    字符串 d = "";
    如果 (行 == 0)
    {
        d = "* (2 + 3) * 4 才是 20 —— 差的就是那对括号";
    }
    如果 (行 == 1)
    {
        d = "* 与上一行只差一对括号,结果差 6";
    }
    如果 (行 == 2)
    {
        d = "* 要 (1 << 4) + 1 = 17 就得自己写括号";
    }
    如果 (行 == 3)
    {
        d = "* 0xF3 就是十进制的 243";
    }
    如果 (行 == 4)
    {
        d = "* 一元负比加减先算";
    }
    如果 (行 == 5)
    {
        d = "* 不写括号就成 -3 + 4 = 1 了";
    }
    如果 (行 == 6)
    {
        d = "* 存进 `逻辑 gt` 之后打出来就是 1";
    }
    如果 (行 == 7)
    {
        d = "* 假在机器里就是 0,当数字、当条件都行";
    }
    如果 (行 == 8)
    {
        d = "* 所以逻辑不是新类型,就是个 0/1";
    }
    如果 (行 == 9)
    {
        d = "* 它**只算被选中的那一支**(另一支不动)";
    }
    如果 (行 == 10)
    {
        d = "* 再看 75 >= 60 成立 ⇒ 2(分数分三档的老写法)";
    }
    如果 (行 == 11)
    {
        d = "* p > q 成立,这一层进来 ⇒ 打 1";
    }
    如果 (行 == 12)
    {
        d = "* 所以上面那句 测试输出(0) 没跑到";
    }
    如果 (行 == 13)
    {
        d = "* 再 & 0xFF 只留下低 8 位 ⇒ 250";
    }
    返回 d;
}

方法 取来历细说后(整数 行) 返回 字符串
{
    字符串 d = "";
    如果 (行 == 14)
    {
        d = "* ~0 把 32 个 0 位全翻成 1 ⇒ 4294967295";
    }
    如果 (行 == 15)
    {
        d = "* 左移 n 位 = 乘 2 的 n 次方";
    }
    如果 (行 == 16)
    {
        d = "* 按位与:12 = 1100、10 = 1010";
    }
    如果 (行 == 17)
    {
        d = "* 按位或:1100 ｜ 1010 ⇒ 1110 = 14";
    }
    如果 (行 == 18)
    {
        d = "* 按位异或:1100 ^ 1010 ⇒ 0110 = 6";
    }
    如果 (行 == 19)
    {
        d = "* 右移 3 位 = 除 8:0x80 = 128";
    }
