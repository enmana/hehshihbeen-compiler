    {
        d = "* 同位都为 1 才留 ⇒ 1000 = 8";
    }
    如果 (行 == 17)
    {
        d = "* 有一位是 1 就留";
    }
    如果 (行 == 18)
    {
        d = "* 两位不一样才是 1";
    }
    如果 (行 == 19)
    {
        d = "* 128 >> 3 ⇒ 16(移位不用动乘法)";
    }
    如果 (行 == 20)
    {
        d = "* 另外九个 -= *= /= %= ｜= &= ^= <<= >>= 同理";
    }
