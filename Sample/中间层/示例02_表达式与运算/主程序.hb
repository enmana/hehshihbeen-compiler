    }
    如果 (行 == 24)
    {
        d = "* 高位配置 + 或立即数 ⇒ 305419896";
    }
    如果 (行 == 25)
    {
        d = "* 十句复合赋值做完 ⇒ 22(想逐句看就点上面第 21 行)";
    }
    返回 d;
}

// 把四张表分派一下:两行来历各走自己那两个函数(行号 0~13 走 细说前/细说二前,14~25 走 细说后/细说二后)
方法 取行说明(整数 行) 返回 字符串
{
    如果 (行 < 14)
    {
        返回 取来历细说前(行);
    }
    返回 取来历细说后(行);
}

方法 取行说明二(整数 行) 返回 字符串
{
    如果 (行 < 14)
    {
        返回 取来历细说二前(行);
    }
    返回 取来历细说二后(行);
}

// 下面三行是"这一行的来历"那三句(每句一个函数,免得帧里塞不下)。
// ⚠ 这三句**只在选中变了的时候调一次**(见主循环里那个 `如果 (选中 != 上次选中)`)——
//   每帧都拼字符串会在编译器池里一块块占地方,真窗口跑一两分钟就报「池用完了」(实测踩过)。
方法 说明文本(整数 行) 返回 字符串
{
    字符串 结果 = "";
    如果 (行 < 0)
    {
        结果 = "点上面任意一行,这里说这一行的来历 —— 26 行算式全在这儿";
    }
    否则
    {
        拼接到(结果, "为什么 ", 取算式(行), " = ", 取结果(行), ":");
    }
    返回 结果;
}

方法 细说文本(整数 行) 返回 字符串
{
    如果 (行 < 0)
    {
        返回 "每一行都在原文件里 `测试输出` 过(这一屏只是排成算式)";
    }
    返回 取行说明(行);
}

方法 细说文本二(整数 行) 返回 字符串
{
    如果 (行 < 0)
    {
        返回 "鼠标点哪一行,这里就换哪一行的来历(点中的那一行有蓝底)";
    }
    返回 取行说明二(行);
}

// ---- 窗口自己那点状态:写在顶层(照模板;不藏在嵌套里) ----
整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点y = 0;                    // 这一帧那"点一下"落在哪一行
整数 选中 = -1;                  // 点中的那一行;-1 = 还没点
逻辑 有一下 = 假;                // 这一帧收到过"点一下"(按下 + 抬起)没有

// 两列文字**开窗时拼一次**,之后主循环只管画(见 `如果 (开着)` 里那两句初始化)。
// ⚠ 为什么不每帧现拼:字符串是在编译器的池里一块块占地方的 —— 每帧几十次 `补白(...)`/`拼接到(...)`
//   真窗口跑一两分钟就报「池用完了」(实测:主循环里每帧补白那一版 **209 帧**就撞上;
//   改成开窗前拼一次之后,同一份脚本跑满 **401 帧**一次都没撞上)。
// ⚠ 字符串数组**不能在声明时给初值**,只能一条条填(照 `Sample\说明.md` 那张坑表)。
字符串 算式列[26];
字符串 结果列[26];

// 底下那三句"来历"的文本:只在**选中变了**的时候重拼(见主循环里那个 `如果 (选中 != 上次选中)`)
整数 上次选中 = -2;
字符串 说明 = "";
字符串 细说 = "";
字符串 细说2 = "";

// ⚠ `格式化` 的占位符只认 `{0}` —— 写成 printf 那种 `%d` **不报错**,直接把 `"%d"` 当文字返回
//   (给的值被丢掉;2026-10-11 实测:`格式化("{0}", 44)` → `44`、`格式化("%d", 42)` → `%d`)。
//   这四句放在**顶层**:函数那一格帧只有 96 字节,而 `格式化` 一个调用要一份临时槽 ——
//   塞进 `取结果` 里当场报「帧超出 96 字节」(实测)。取的就是原程序 `测试输出` 打的那几个值。
字符串 说明x = "";
字符串 说明i = "";
字符串 说明sum = "";
字符串 说明big = "";
说明x = 格式化("{0}", x);
说明i = 格式化("{0}", i);
说明sum = 格式化("{0}", sum);
说明big = 格式化("{0}", big);

逻辑 开着 = 打开窗口("示例02 表达式与运算", 窗宽, 窗高);
如果 (开着)
{
    整数 i = 0;
    当 (i < 26)
    {
        算式列[i] = 补白(取算式(i), 18);
        结果列[i] = 取结果(i);
        i = i + 1;
    }

    逻辑 收手 = 假;

    // 主循环:收事件 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算:26 行从 `行0` 起、每行 `行距` 像素;
        // 两处**分组标**各占一行(第二组前空 32 像素、第三组前空 96 像素),
        // 所以落在标那 32 像素里的行先按"第几行"算,再各退回一行。
        // ⚠ 这一步**单独摆在这一层**(浅一层就稳):命中测试与赋值别塞进上面那串嵌套(与示例16 同一路数)。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点y >= 行0)
            {
                如果 (点y < 行0 + 26 * 行距 + 96)
                {
                    选中 = (点y - 行0) / 行距;
                    如果 (选中 >= 13)
                    {
                        选中 = 选中 - 1;        // 跳过"位运算与复合赋值"那个分组标那一行
                    }
                    如果 (选中 >= 22)
                    {
                        选中 = 选中 - 1;        // 跳过"比较当值 与 三目"那个分组标那一行
                    }
                }
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍 ----
            清屏(0xFF101018);
            画矩形(12, 12, 窗宽 - 24, 40, 0xFF2A3550);
            画文字(24, 16, "表达式与运算:优先级 / 位运算 / 十个复合赋值 / 比较 / 三目", 0xFFE8E8F0);
            画文字(24, 34, "右侧那列是程序真跑出来的值;点一行 ⇒ 说清为什么是这个值", 0xFFB0B0B8);

            画分组标(组1头, "优先级:括号 > 一元 > * / % > + - > 移位 > & > ^ > ｜ > 比较 > 逻辑");
            画分组标(组2头, "位运算与复合赋值:& ｜ ^ << >> ~ 与十个复合赋值(+= -= *= …)");
            画分组标(组3头, "比较当值 与 三目:结果是个逻辑值(0/1),能存、能算、能当条件");

            整数 r = 0;
            当 (r < 26)
            {
                整数 行y = 行0 + r * 行距;
                如果 (r >= 13)
                {
                    行y = 行y + 32;                // 第一组 13 行与"位运算"分组标之间的空当
                }
                如果 (r >= 22)
                {
                    行y = 行y + 64;                // 第二组 11 行与"比较与三目"分组标之间的空当
                }
                如果 (r == 选中)
                {
                    画矩形(12, 行y, 窗宽 - 24, 22, 0xFF2A6EF0);        // 选中那一行的底色
                }
                画文字(20, 行y + 3, 算式列[r], 0xFFD0D0D8);
                画文字(240, 行y + 3, 结果列[r], 0xFFE8E8F0);
                r = r + 1;
            }

            画线(12, 分隔y, 窗宽 - 12, 分隔y, 0xFF3C3C46);

            // 选中哪一行,就说哪一行的来历。
            // ⚠ **只在选中变了的时候重拼**(下面这个 `如果`):每帧都拼字符串会在编译器池里一块块占地方,
            //   真窗口跑上一两分钟就报「池用完了」(实测:每帧重拼那一版 151 帧就撞上)。选中没变就照旧画。
            如果 (选中 != 上次选中)
            {
                上次选中 = 选中;
                说明 = 说明文本(选中);
                细说 = 细说文本(选中);
                细说2 = 细说文本二(选中);
            }
            画文字(20, 详1y, 说明, 0xFFE8E8F0);
            画文字(20, 详2y, 细说, 0xFF8A8A96);
            画文字(20, 详3y, 细说2, 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();
}

停止

