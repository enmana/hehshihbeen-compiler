    {
        d = "* i 一开始是 7:i++ ⇒ 8、i-- ⇒ 7";
    }
    如果 (行 == 23)
    {
        d = "* 循环头里那个 k += 1 也是复合赋值";
    }
    如果 (行 == 24)
    {
        d = "* 0x12345678 一次写下来,编译器自己拆指令";
    }
    如果 (行 == 25)
    {
        d = "* 十连的起点:x 一开始 = 12";
    }
    返回 d;
}

方法 取来历细说二后(整数 行) 返回 字符串
{
    字符串 d = "";
    如果 (行 == 14)
    {
        d = "* 装它要用 无符号整数(整数装不下)";
    }
    如果 (行 == 15)
    {
        d = "* 1 << 4 = 16;顺带看看 3 << 4 = 48";
    }
