// 示例 09:堆与数据结构 —— 申请 / 释放 / 取字 / 存字,链表与二叉树
//
//   关键字中英等价(写 `如果` 和写 `if` 一个意思),标识符随便起,中文优先只是默认 ——
//   本示例故意中英混写,变量名一律用短英文(a b i n node head sum)。
//
//   堆(K8)是数据段里独立的一块(默认 64KB,工程文件的 "堆" 一行能改大小):
//     var p = 申请(字节数);     // 从堆里要一块,返回地址(要不到会当场停下)
//     存字(p, 偏移, 值);        // 往 p+偏移 写 4 字节(小端)
//     取字(p, 偏移);            // 从 p+偏移 读 4 字节
//     释放(p);                  // 还回堆里 —— 还了以后同一块还能再被申请到
//
//   重点看三处:
//     ① 申请回来的地址装在 var(32 位字)里,读写一律走 取字 / 存字(4 字节宽),不要用 加载 / 存储(1 字节);
//        (函数签名里那个 32 位字写 `整数` —— 和 `var` 同一个宽度,`返回 var` 这种写法编译器不认)
//     ② 链表节点 = 8 字节:值 [+0] + next [+4];头插建链 → 遍历求和 → 逐个释放;
//     ③ 二叉树节点 = 12 字节:值 [+0] + 左 [+4] + 右 [+8];递归建树、中序遍历、后序释放。

// ---- 二叉树要用的小工具(函数不限书写顺序,写在使用之前更好读)----

// 插入一个数:空位就新申请一个节点,否则按大小递归往左/右走
方法 插入(整数 root, 整数 value) 返回 整数
{
    if (root == 0)
    {
        var node = 申请(12);
        存字(node, 0, value);
        存字(node, 4, 0);            // 左孩子还没有
        存字(node, 8, 0);            // 右孩子还没有
        返回 node;
    }
    如果 (value < 取字(root, 0))
    {
        存字(root, 4, 插入(取字(root, 4), value));   // 比根小 → 插到左边
    }
    else
    {
        存字(root, 8, 插入(取字(root, 8), value));   // 不小 → 插到右边
    }
    返回 root;                       // 根没变,原样返回
}

// 中序遍历:左 → 根 → 右,打出来就是从小到大
方法 中序(整数 root)
{
    如果 (root == 0)
    {
        返回;
    }
    中序(取字(root, 4));
    测试输出(取字(root, 0));
    中序(取字(root, 8));
}

// 后序释放:先把两棵子树还掉,再还自己(顺序反了就读不到孩子了)
方法 释放树(整数 root)
{
    if (root == 0)
    {
        返回;
    }
    var left = 取字(root, 4);
    var right = 取字(root, 8);
    释放树(left);
    释放树(right);
    释放(root);
}

// ---- 1) 链表:头插 3 个节点,每个节点向堆要 8 字节 ----
var head = 0;                        // 空链表:头指针是 0

循环 (var i = 1; i <= 3; i = i + 1)
{
    var node = 申请(8);
    存字(node, 0, i);                // [+0] = 值
    存字(node, 4, head);             // [+4] = 原来的头(所以是"插在头上")
    head = node;
}

// 插进去的顺序是 1、2、3,头插之后从 head 出发看到的是 3、2、1
var sum = 0;
var p = head;
while (p != 0)
{
    // 顺着 next 走一遍,边走边累加
    sum = sum + 取字(p, 0);
    p = 取字(p, 4);                  // 0 = 到头了
}
测试输出(sum);                       // 3 + 2 + 1

// ---- 2) 逐个释放:先把 next 存下来,再释放当前节点(顺序不能反)----
循环 (var k = 0; k < 3; k = k + 1)
{
    var next = 取字(head, 4);
    释放(head);                      // 还回堆里
    head = next;
}
测试输出(head == 0);                 // 1:链表已经空了

// ---- 3) 二叉树:5 是根,3、8 分两边,1、4 挂在 3 下面 ----
var tree = 0;
tree = 插入(tree, 5);
tree = 插入(tree, 3);
tree = 插入(tree, 8);
tree = 插入(tree, 1);
tree = 插入(tree, 4);

测试输出(取字(tree, 0));             // 5:根还是最早插进去的那个
中序(tree);                          // 1 3 4 5 8(升序)
释放树(tree);                        // 5 个节点全还回堆里
tree = 0;

// ---- 4) 还回去的地方能再用:再要一块照样拿得到 ----
var again = 申请(8);
测试输出(again == 0);                // 0:拿到了(不是 0 就说明申请失败)
存字(again, 0, 99);
测试输出(取字(again, 0));            // 99
释放(again);
again = 0;                           // 还完把地址清 0:以后再拿它读写会被当场拦住

// ============================================================
// 带 UI 的那一半(H82 批 4)—— 把堆里的块、链表、二叉树真画出来
//
//   · 上面那 122 行(申请 / 释放 / 取字 / 存字 + 链表 + 二叉树,含 10 条 `测试输出`)
//     **一个字没动**;它们跑完时堆已经全还回去了,所以这一段照同一套写法**再申请一遍** ——
//     屏上画的就是此刻真在堆里的块,指针是运行期 `申请` 回来、`取字` 读回来的。
//   · 上半屏 = **堆块地图**:一个方框 = 一次申请拿回来的块(**块宽 = 字节数 × 4 像素**);
//     框里第一行是块里装的东西、第二行是字节数,框下 `#n` 是块号、再下一行是**这一块的堆内偏移**;
//     ⚠ **位置一律按"块号 + 堆内偏移"说,屏上不写裸地址**(H93:裸地址是机器布局的读数,
//     代码一长短就整体平移 —— 写进 `// 预期输出:` 就是"改一行别的代码、这一篇断言红一片";
//     偏移是相对第一块算的,布局平移不影响它,指针关系照样看得见)。
//     深蓝 = 链表节点(8 字节)、深绿 = 二叉树节点(12 字节)、**灰框 = 已经 释放 掉的块**。
//   · 中 / 下半屏 = **链表**(头指针 → 值 3 → 值 2 → 值 1 → 空)与
//     **二叉树**(按层摆:根 值 5,左 值 3(左 1 右 4)、右 值 8);节点之间那几条**箭头** =
//     `画线` 主线 + 两条 6 像素短斜线(帮手就是下面那 6 行的 `箭头`)。
//   · **点任意一个堆块 / 链表节点 / 树节点**:底下两行当场换成"它住在哪一块(块号 ·
//     几字节 · 堆内偏移)/ 谁指着它 / 它指着谁" —— 节点与堆块本来就是同一块内存,点哪边都落到同一块。
//   · **逐帧推进**:每 `刷新()` 进一帧,高亮沿"链表 3 个节点 → 二叉树 5 个节点"走一圈
//     (同一个块:结构图里的方框与地图上那一格一起亮),8 帧一轮,走完绕回来。
//   · ⚠ 屏上每一句话**都在开窗前拼好**(九个块的 "#n / 8B / 值"、每块的说明两行、
//     逐帧那八句),主循环里一条字符串都不现拼 —— 每帧现拼几十条,几百帧就把池吃光。
// ============================================================
包含 "../../库/string.hb"          // `格式化(...)` 要用的那个 `转字符串` 在库里

// ---- 窗口与摆位的尺寸:画图和命中测试用的是同一组数,要挪地方只改这几行 ----
整数 窗宽 = 560;
整数 窗高 = 600;
整数 块y = 104;                    // 堆块地图那一排的顶边
整数 块高 = 40;                    // 一块多高(框里两行:值 / 字节数)
整数 块间 = 14;                    // 两块之间留的空当
整数 每字节 = 4;                   // 块宽 = 字节数 × 4 像素(1 字节 = 4 像素)
整数 链y = 212;                    // 链表那一排方框的顶边
整数 节宽 = 56;                    // 链表 / 二叉树节点方框的宽
整数 节高 = 34;                    // 节点方框的高
整数 树y0 = 288;                   // 二叉树第一层(根)的顶边
整数 层距 = 52;                    // 二叉树一层占多高

// ---- 要画的九块:前 3 块 = 链表节点(8 字节)、中间 5 块 = 二叉树节点(12 字节)、
//      第 9 块 = 申请过又 释放 掉的(8 字节 ⇒ 画成灰的空框)----
整数 链头 = 0;                     // 头指针(堆外的变量,不是块)
整数 树根 = 0;                     // 根指针
整数 块字节[9] = [8, 8, 8, 12, 12, 12, 12, 12, 8];
整数 块类[9] = [0, 0, 0, 1, 1, 1, 1, 1, 2];   // 0 链表节点 / 1 二叉树节点 / 2 已释放的空块
整数 块地址[9];                    // 申请回来的地址(运行期填;**只在内部算关系,不画到屏上**)
整数 堆基 = 0;                     // 堆内偏移的基准 = 第一块的地址(布局平移时整段一起动,偏移不变)
整数 块值[9];                      // 块里装的那个数(存字 进去的)
整数 块x[9];                       // 地图上这一块的左边
整数 块宽[9];                      // 地图上这一块的宽 = 字节数 × 每字节
整数 块画x[9];                     // 结构图里这块方框的左边(链表 / 二叉树各按自己的摆法)
整数 块画y[9];
整数 链块[3] = [2, 1, 0];          // 顺着头指针走:第 3 块(值 3)→ 第 2 块 → 第 1 块
整数 树块[5] = [3, 4, 5, 6, 7];    // 二叉树 5 个节点在块表里的位置(值 5 / 3 / 8 / 1 / 4)
整数 树边父[4] = [3, 3, 4, 4];     // 四条边:父块号
整数 树边子[4] = [4, 5, 6, 7];     // 四条边:子块号
整数 走块[8] = [2, 1, 0, 3, 4, 5, 6, 7];   // 逐帧高亮走的顺序:链表 3 个 → 树 5 个

// 字符串数组**不能在声明时给初值** ⇒ 声明完在 `备块文字` / `备说明*` / `备扫文` 里一条条填
// (照 `Sample\说明.md` 那张坑表:拆成几个小函数是因为一个函数帧只有 96 字节)
字符串 号文[9];                    // "#1" … "#9"
字符串 字节文[9];                  // "8B" / "12B"(块宽就是按这个折算的)
字符串 值文[9];                    // 框里那个值(已释放的那块写 "空")
字符串 偏移文[9];                  // 框底下那行:这一块的堆内偏移(相对第一块,布局平移也不变)
字符串 说一[10];                   // 点中这一块时底下第一行(第 10 条 = 还没点中)
字符串 说二[10];                   // 底下第二行
字符串 扫文[8];                    // 逐帧那八句:这一帧高亮走到哪儿
整数 值文x[9];                     // 框里文字的左边 = 块x + (块宽 - 取文字宽度 × 8) / 2
整数 字节文x[9];
整数 号文x[9];
整数 偏移文x[9];

// ---- 窗口自己要记住的状态:一律写在**顶层**(照模板,别藏在嵌套里)----
整数 类型 = 0;                     // 取事件那四个出参
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                      // 这一帧"点一下"点在哪(先记下来,浅一层再结算)
整数 点y = 0;
逻辑 有一下 = 假;                  // 这一帧收到过"点一下"没有
整数 选中块 = -1;                  // 点中的是第几块(-1 = 还没点)
整数 帧计 = 0;                     // 每 `刷新()` 一次 +1
整数 扫 = 0;                       // 这一帧高亮走到第几步 = 帧计 % 8
整数 显 = 9;                       // 底下两行显示哪一条(没点中时用第 10 条)

// ---- 结构图里九块方框的位置:链表横着一排(顺着头指针 3 → 2 → 1),二叉树按层摆 ----
块画x[2] = 112;                    // 链表头节点(值 3)
块画y[2] = 链y;
块画x[1] = 208;                    // 链表第 2 个节点(值 2)
块画y[1] = 链y;
块画x[0] = 304;                    // 链表尾节点(值 1,next = 0)
块画y[0] = 链y;
块画x[3] = 252;                    // 二叉树根(值 5)
块画y[3] = 树y0;
块画x[4] = 140;                    // 根 的左孩子(值 3)
块画y[4] = 树y0 + 层距;
块画x[5] = 420;                    // 根 的右孩子(值 8)
块画y[5] = 树y0 + 层距;
块画x[6] = 56;                     // 值 3 的左孩子(值 1)
块画y[6] = 树y0 + 2 * 层距;
块画x[7] = 224;                    // 值 3 的右孩子(值 4)
块画y[7] = 树y0 + 2 * 层距;

// ---- 拼文字要用的小帮手 ----
// ⚠ 占位符只认 `{0}` 这种,printf 的 `%d` **不报错、也不替换**(会原样返回 "%d");
//   `返回 格式化(...)` 这种"直接把格式化当返回值"会静默停机 ⇒ 先落进一个字符串变量再返回。
方法 数文(整数 值) 返回 字符串
{
    字符串 文 = 格式化("{0}", 值);
    返回 文;
}

方法 类名(整数 类别) 返回 字符串
{
    如果 (类别 == 0)
    {
        返回 "链表节点";
    }
    如果 (类别 == 1)
    {
        返回 "二叉树节点";
    }
    返回 "已释放的空块";
}

// 地址 → 屏上说的那个"块号文":"#7";0 就是空(指针到头 / 没有这个孩子)
// ⚠ 不画裸地址(H93):块号是"换个布局也不变"的说法,偏移与指针关系照旧看得见
方法 块号文(整数 块址) 返回 字符串
{
    如果 (块址 == 0)
    {
        返回 "空";
    }
    整数 k = 0;
    当 (k < 9)
    {
        如果 (块地址[k] == 块址)
        {
            字符串 文 = "#";
            拼接到(文, 数文(k + 1));
            返回 文;
        }
        k = k + 1;
    }
    返回 "?";
}

// 一块的抬头:"#3(12 字节 · 二叉树节点)" —— 位置一律按块号说,不写机器布局的裸地址(H93)
// ⚠ 一个函数里堆太多调用 / 局部会当场报「帧超出 96 字节」⇒ 一句只拼一次、拆开写
方法 块头文(整数 号, 整数 字节数, 整数 类别) 返回 字符串
{
    字符串 文 = "#";
    拼接到(文, 数文(号 + 1));
    拼接到(文, "(", 数文(字节数), " 字节 · ", 类名(类别), ")");
    返回 文;
}

// "它指着:next = #2"(链表那头:块号 空 = 到头了)
方法 链指着(整数 下一地址) 返回 字符串
{
    字符串 文 = "它指着:next = ";
    拼接到(文, 块号文(下一地址));
    如果 (下一地址 == 0)
    {
        拼接到(文, "(0 = 链表到头了)");
    }
    返回 文;
}

// "它指着:左 = #7、右 = #8"(二叉树那头:块号 空 = 没有这个孩子)
方法 树指着(整数 左地址, 整数 右地址) 返回 字符串
{
    字符串 文 = "它指着:左 = ";
    拼接到(文, 块号文(左地址), "、右 = ", 块号文(右地址));
    如果 (左地址 == 0)
    {
        拼接到(文, "(0 = 没有孩子,叶子)");
    }
    返回 文;
}

// 在树里按值找那个节点(树节点是 `插入` 递归里申请的,地址得顺着左/右 `取字` 走一遍)
方法 找节点(整数 根, 整数 值) 返回 整数
{
    如果 (根 == 0)
    {
        返回 0;
    }
    如果 (取字(根, 0) == 值)
    {
        返回 根;
    }
    整数 左 = 找节点(取字(根, 4), 值);
    如果 (左 != 0)
    {
        返回 左;
    }
    返回 找节点(取字(根, 8), 值);
}

// ---- 画的那几条:一个框 = 外层深色矩形 + 内层缩 2 像素的填充色(2 条命令一个框)----
// 态:0 普通 / 1 逐帧高亮到这块 / 2 用户点中的这块(蓝底)
// ⚠ `画矩形` 是不透明实心 ⇒ 底色一律画在文字**之前**(画在后面就把字盖住)
方法 画块(整数 x, 整数 y, 整数 宽, 整数 高, 整数 类别, 整数 态)
{
    如果 (态 == 2)
    {
        画矩形(x, y, 宽, 高, 0xFF6EA0FF);
    }
    否则 如果 (态 == 1)
    {
        画矩形(x, y, 宽, 高, 0xFF4A6EA8);
    }
    否则
    {
        画矩形(x, y, 宽, 高, 0xFF3C3C46);
    }
    如果 (态 == 2)
    {
        画矩形(x + 2, y + 2, 宽 - 4, 高 - 4, 0xFF2A6EF0);
    }
    否则 如果 (类别 == 2)
    {
        画矩形(x + 2, y + 2, 宽 - 4, 高 - 4, 0xFF2A2A2A);
    }
    否则 如果 (类别 == 1)
    {
        画矩形(x + 2, y + 2, 宽 - 4, 高 - 4, 0xFF1E4A32);
    }
    否则
    {
        画矩形(x + 2, y + 2, 宽 - 4, 高 - 4, 0xFF1E3A5F);
    }
}

// 箭头 = `画线` 主线 + 两条 6 像素短斜线(末梢往回退 6 像素、上下各 6 像素)
// 向:0 = 往右 / 1 = 往下 —— 本示例的连线就这两种,所以斜线端点按方向分两支算
方法 箭头(整数 x1, 整数 y1, 整数 x2, 整数 y2, 整数 向, 整数 色)
{
    画线(x1, y1, x2, y2, 色);
    如果 (向 == 0)
    {
        画线(x2, y2, x2 - 6, y2 - 6, 色);
        画线(x2, y2, x2 - 6, y2 + 6, 色);
    }
    否则
    {
        画线(x2, y2, x2 - 6, y2 - 6, 色);
        画线(x2, y2, x2 + 6, y2 - 6, 色);
    }
}

// 上半屏那一排:九块方块先全画完,再画框里的字(免得后画的方框压住先画的字)
方法 画堆条()
{
    整数 k = 0;
    当 (k < 9)
    {
        整数 态 = 0;
        如果 (走块[扫] == k)
        {
            态 = 1;
        }
        如果 (选中块 == k)
        {
            态 = 2;
        }
        画块(块x[k], 块y, 块宽[k], 块高, 块类[k], 态);
        k = k + 1;
    }
    k = 0;
    当 (k < 9)
    {
        如果 (块类[k] == 2)
        {
            画文字(值文x[k], 块y + 6, 值文[k], 0xFF8A8A96);
        }
        否则
        {
            画文字(值文x[k], 块y + 6, 值文[k], 0xFFE8E8F0);
        }
        画文字(字节文x[k], 块y + 24, 字节文[k], 0xFFB0B0B8);
        画文字(号文x[k], 块y + 44, 号文[k], 0xFF8A8A96);
        画文字(偏移文x[k], 块y + 60, 偏移文[k], 0xFF6A6A76);
        k = k + 1;
    }
}

// 链表:头指针那一格(堆外的变量)+ 三个节点方框 + 空的尾巴 + 四条箭头
方法 画链表()
{
    整数 态头 = 0;
    如果 (选中块 == 2)
    {
        态头 = 2;
    }
    画块(16, 链y, 48, 节高, 0, 态头);
    画文字(24, 链y + 11, "链头", 0xFFE8E8F0);
    整数 k = 0;
    当 (k < 3)
    {
        整数 块 = 链块[k];
        整数 态 = 0;
        如果 (走块[扫] == 块)
        {
            态 = 1;
        }
        如果 (选中块 == 块)
        {
            态 = 2;
        }
        画块(块画x[块], 块画y[块], 节宽, 节高, 0, 态);
        k = k + 1;
    }
    画块(400, 链y, 44, 节高, 2, 0);
    k = 0;
    当 (k < 3)
    {
        整数 块2 = 链块[k];
        画文字(块画x[块2] + 24, 块画y[块2] + 11, 值文[块2], 0xFFE8E8F0);
        k = k + 1;
    }
    画文字(414, 链y + 11, "空", 0xFF8A8A86);
    箭头(64, 链y + 17, 108, 链y + 17, 0, 0xFF7AB0FF);
    箭头(168, 链y + 17, 204, 链y + 17, 0, 0xFF7AB0FF);
    箭头(264, 链y + 17, 300, 链y + 17, 0, 0xFF7AB0FF);
    箭头(360, 链y + 17, 396, 链y + 17, 0, 0xFF7AB0FF);
}

// 二叉树:五个节点方框(先框后字)+ 四条父 → 子的箭头
方法 画树()
{
    整数 k = 0;
    当 (k < 5)
    {
        整数 块 = 树块[k];
        整数 态 = 0;
        如果 (走块[扫] == 块)
        {
            态 = 1;
        }
        如果 (选中块 == 块)
        {
            态 = 2;
        }
        画块(块画x[块], 块画y[块], 节宽, 节高, 1, 态);
        k = k + 1;
    }
    k = 0;
    当 (k < 5)
    {
        整数 块2 = 树块[k];
        画文字(块画x[块2] + 24, 块画y[块2] + 11, 值文[块2], 0xFFE8E8F0);
        k = k + 1;
    }
    整数 e = 0;
    当 (e < 4)
    {
        整数 父 = 树边父[e];
        整数 子 = 树边子[e];
        箭头(块画x[父] + 28, 块画y[父] + 节高, 块画x[子] + 28, 块画y[子], 1, 0xFF4A9E6A);
        e = e + 1;
    }
}

// ---- 点在哪儿:三个命中测试都摆成小函数,主循环那层就只剩"记下来 → 结算" ----
方法 落块(整数 x) 返回 整数
{
    整数 i = 0;
    当 (i < 9)
    {
        如果 (x >= 块x[i] && x < 块x[i] + 块宽[i])
        {
            返回 i;
        }
        i = i + 1;
    }
    返回 -1;
}

方法 链落(整数 x) 返回 整数
{
    整数 k = 0;
    当 (k < 3)
    {
        整数 块 = 链块[k];
        如果 (x >= 块画x[块] && x < 块画x[块] + 节宽)
        {
            返回 块;
        }
        k = k + 1;
    }
    返回 -1;
}

方法 树落(整数 x, 整数 y) 返回 整数
{
    整数 层 = (y - 树y0) / 层距;
    如果 (层 == 0)
    {
        如果 (x >= 252 && x < 308)
        {
            返回 3;
        }
        返回 -1;
    }
    如果 (层 == 1)
    {
        如果 (x >= 140 && x < 196)
        {
            返回 4;
        }
        如果 (x >= 420 && x < 476)
        {
            返回 5;
        }
        返回 -1;
    }
    如果 (层 == 2)
    {
        如果 (x >= 56 && x < 112)
        {
            返回 6;
        }
        如果 (x >= 224 && x < 280)
        {
            返回 7;
        }
    }
    返回 -1;
}

// ---- 照着上面那 122 行的写法,把链表与二叉树再在堆里搭一遍(要画的得是真在堆里的块)----
方法 搭结构()
{
    循环 (var nn = 1; nn <= 3; nn = nn + 1)
    {
        var 节点 = 申请(8);
        存字(节点, 0, nn);           // [+0] = 值
        存字(节点, 4, 链头);         // [+4] = 原来的头
        链头 = 节点;
        整数 位 = nn - 1;            // ⚠ 数组下标先落进一个变量(算式当不了下标)
        块地址[位] = 节点;           // 申请回来的地址当场记下:屏上要按它说话
        块值[位] = nn;
    }
    树根 = 插入(树根, 5);
    树根 = 插入(树根, 3);
    树根 = 插入(树根, 8);
    树根 = 插入(树根, 1);
    树根 = 插入(树根, 4);
    块地址[3] = 找节点(树根, 5);
    块地址[4] = 找节点(树根, 3);
    块地址[5] = 找节点(树根, 8);
    块地址[6] = 找节点(树根, 1);
    块地址[7] = 找节点(树根, 4);
    块值[3] = 5;
    块值[4] = 3;
    块值[5] = 8;
    块值[6] = 1;
    块值[7] = 4;
    // 再要一块、写进去、读出来、还回去 ⇒ 地图上留一个灰的空框(申请 → 用 → 释放)
    var 临时块 = 申请(8);
    存字(临时块, 0, 99);
    块值[8] = 取字(临时块, 0);       // 释放前先读出来:释放后再 取字 会被当场拦住
    块地址[8] = 临时块;
    释放(临时块);
}

// ---- 开窗前把屏上每一句话一次拼好 —— ⚠ 帧 96 字节是**按临时槽收费**的:下面这几个
//      小函数就是被它逼出来的(一个函数里塞不下三列文字 + 九块说明)----
//      ① 备块文字 摆块宽与三列文字(块号 / 字节数 / 值 / 地址)② 备居中 把这几列摆到框中间
//      ③ 备说明链 / 备说明树 / 备说明树二 / 备说明尾 拼每块那两行 ④ 备扫文 拼逐帧八句
方法 备块文字()
{
    字符串 t = "";
    整数 块号 = 0;
    整数 游 = 16;                     // 地图从左往右摆,块与块之间留 块间 像素
    当 (块号 < 9)
    {
        块宽[块号] = 块字节[块号] * 每字节;
        块x[块号] = 游;
        游 = 游 + 块宽[块号] + 块间;
        t = "#";
        拼接到(t, 数文(块号 + 1));
        号文[块号] = t;
        块号 = 块号 + 1;
    }
    块号 = 0;
    当 (块号 < 9)
    {
        t = 数文(块字节[块号]);
        拼接到(t, "B");
        字节文[块号] = t;
        块号 = 块号 + 1;
    }
    块号 = 0;
    当 (块号 < 9)
    {
        如果 (块类[块号] == 2)
        {
            t = "空";
        }
        否则
        {
            t = 数文(块值[块号]);
        }
        值文[块号] = t;
        t = "+";                       // 框底下那行:堆内偏移(相对第一块;H93 起不写裸地址)
        拼接到(t, 数文(块地址[块号] - 堆基));
        偏移文[块号] = t;
        块号 = 块号 + 1;
    }
}

// 框里那一列文字居中(取文字宽度 给的是"格"、画文字 要的是像素 ⇒ 按 1 格 = 8 像素折)
// ⚠ 一句里塞三个下标 + 一个内建调用会"临时寄存器用光" ⇒ 先落进 字宽 再算,一句只算一格
方法 备居中()
{
    整数 块号 = 0;
    当 (块号 < 9)
    {
        整数 字宽 = 取文字宽度(值文[块号]) * 8;
        值文x[块号] = 块x[块号] + (块宽[块号] - 字宽) / 2;
        字宽 = 取文字宽度(字节文[块号]) * 8;
        字节文x[块号] = 块x[块号] + (块宽[块号] - 字宽) / 2;
        字宽 = 取文字宽度(号文[块号]) * 8;
        号文x[块号] = 块x[块号] + (块宽[块号] - 字宽) / 2;
        字宽 = 取文字宽度(偏移文[块号]) * 8;
        偏移文x[块号] = 块x[块号] + (块宽[块号] - 字宽) / 2;
        块号 = 块号 + 1;
    }
}

// 九个块各自的"住在哪一块(块号)/ 谁指着它"与"它指着谁"
// (指针那头一律用 `取字` 从块里现读 —— 屏上说的就是堆里真装着的那个数)
// ⚠ 帧 96 字节是**按临时槽收费**的 ⇒ 九个块拆成三小段拼(链 3 块 / 树 5 块 / 尾巴)
方法 备说明链()
{
    字符串 t = "";
    t = 块头文(0, 块字节[0], 块类[0]);
    拼接到(t, ";谁指着它:值 2 那个节点的 next");
    说一[0] = t;
    说二[0] = 链指着(取字(块地址[0], 4));
    t = 块头文(1, 块字节[1], 块类[1]);
    拼接到(t, ";谁指着它:值 3 那个节点的 next");
    说一[1] = t;
    说二[1] = 链指着(取字(块地址[1], 4));
    t = 块头文(2, 块字节[2], 块类[2]);
    拼接到(t, ";谁指着它:头指针 链头");
    说一[2] = t;
    说二[2] = 链指着(取字(块地址[2], 4));
}

方法 备说明树()
{
    字符串 t = "";
    t = 块头文(3, 块字节[3], 块类[3]);
    拼接到(t, ";谁指着它:根指针 树根");
    说一[3] = t;
    说二[3] = 树指着(取字(块地址[3], 4), 取字(块地址[3], 8));
    t = 块头文(4, 块字节[4], 块类[4]);
    拼接到(t, ";谁指着它:值 5 那个节点的左孩子");
    说一[4] = t;
    说二[4] = 树指着(取字(块地址[4], 4), 取字(块地址[4], 8));
    t = 块头文(5, 块字节[5], 块类[5]);
    拼接到(t, ";谁指着它:值 5 那个节点的右孩子");
    说一[5] = t;
    说二[5] = 树指着(取字(块地址[5], 4), 取字(块地址[5], 8));
}

方法 备说明树二()
{
    字符串 t = "";
    t = 块头文(6, 块字节[6], 块类[6]);
    拼接到(t, ";谁指着它:值 3 那个节点的左孩子");
    说一[6] = t;
    说二[6] = 树指着(取字(块地址[6], 4), 取字(块地址[6], 8));
    t = 块头文(7, 块字节[7], 块类[7]);
    拼接到(t, ";谁指着它:值 3 那个节点的右孩子");
    说一[7] = t;
    说二[7] = 树指着(取字(块地址[7], 4), 取字(块地址[7], 8));
}

方法 备说明尾()
{
    字符串 t = "";
    t = 块头文(8, 块字节[8], 块类[8]);
    拼接到(t, ";已经 释放 过 ⇒ 画成灰的空框");
    说一[8] = t;
    t = "释放前写进去的是 ";
    拼接到(t, 数文(块值[8]), ";释放后再 取字 / 存字 会被当场拦住");
    说二[8] = t;

    // 还没点中时底下那两行
    说一[9] = "点任意一个堆块 / 链表节点 / 树节点 ⇒ 这两行换成它的块号与关系";
    说二[9] = "高亮是逐帧自己往前走的:链表 3 个 → 二叉树 5 个,8 帧一圈";
}

// 逐帧那八句(每一句都是现成的,主循环只按下标取 —— 全是字面量,不吃帧)
方法 备扫文()
{
    扫文[0] = "逐帧:高亮走到 链表 头节点(值 3)⇒ 地图上第 3 块";
    扫文[1] = "逐帧:高亮走到 链表 第 2 个节点(值 2)⇒ 地图上第 2 块";
    扫文[2] = "逐帧:高亮走到 链表 尾节点(值 1,它的 next = 0)⇒ 第 1 块";
    扫文[3] = "逐帧:高亮走到 二叉树根(值 5)⇒ 地图上第 4 块";
    扫文[4] = "逐帧:高亮走到 值 3(根 的左孩子:左 1 右 4)⇒ 第 5 块";
    扫文[5] = "逐帧:高亮走到 值 8(根 的右孩子:叶子)⇒ 第 6 块";
    扫文[6] = "逐帧:高亮走到 值 1(值 3 的左孩子:叶子)⇒ 第 7 块";
    扫文[7] = "逐帧:高亮走到 值 4(值 3 的右孩子:叶子)⇒ 第 8 块";
}

搭结构();                          // 在堆里搭出要画的那九块(指针运行期读回来)
堆基 = 块地址[0];                    // 屏上那个"堆内偏移"的基准 = 第一块
备块文字();                        // 四列文字:块号 "#n" / 字节数 "8B" / 值 / 堆内偏移
备居中();                          // 这几列在框里居中(1 格 = 8 像素)
备说明链();                        // 每块两行说明:链表 3 块 / 树 5 块 / 尾巴,分三段拼
备说明树();
备说明树二();
备说明尾();
备扫文();                          // 逐帧那八句
// 屏上每一句话都在这儿拼好了:主循环里一条都不再拼

逻辑 开着 = 打开窗口("示例09 堆与数据结构", 窗宽, 窗高);
如果 (开着)                        // 没有图形能力的宿主给 假 ⇒ 一个字都不多打
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 点击结算:**单独摆在这一层**(判断与赋值别塞进上面那串嵌套里)。
        // 三条道各管一段:地图那一排(算上底下 #n 与偏移那两行)/ 链表那一排 / 二叉树那三层。
        // 节点与堆块本来就是同一块内存,所以点到哪边都算"选中这一块"。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点y >= 块y && 点y < 块y + 块高 + 34)
            {
                整数 落1 = 落块(点x);
                如果 (落1 >= 0)
                {
                    选中块 = 落1;
                }
            }
            如果 (点y >= 链y && 点y < 链y + 节高 + 12)
            {
                整数 落2 = 链落(点x);
                如果 (落2 >= 0)
                {
                    选中块 = 落2;
                }
            }
            如果 (点y >= 树y0 && 点y < 树y0 + 3 * 层距)
            {
                整数 落3 = 树落(点x, 点y);
                如果 (落3 >= 0)
                {
                    选中块 = 落3;
                }
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是现成的)----
            扫 = 帧计 % 8;                 // 高亮这一帧走到第几块
            帧计 = 帧计 + 1;
            显 = 选中块;
            如果 (显 < 0)
            {
                显 = 9;
            }

            清屏(0xFF101018);

            // 标题
            画矩形(12, 12, 536, 58, 0xFF2A3550);
            画文字(24, 18, "示例09 堆与数据结构:把堆里的链表与二叉树画出来", 0xFFE8E8F0);
            画文字(24, 40, "上面那 122 行一个字没动 —— 这一半是新接的开窗演示", 0xFFB0B0B8);

            // 上半屏:堆块地图(块宽 = 字节数 × 4 像素)
            画矩形(12, 78, 536, 18, 0xFF232B3E);
            画文字(20, 79, "堆块地图:申请一次 = 一块(块宽 = 字节数 × 4 像素;灰框 = 已释放)", 0xFF9CC4FF);
            画堆条();

            // 中半屏:链表(头插 3 个 8 字节节点)
            画矩形(12, 188, 536, 18, 0xFF232B3E);
            画文字(20, 189, "链表:头指针 链头 指着值 3,next 一路指到 0(空)", 0xFF9CC4FF);
            画链表();

            // 下半屏:二叉树(5 个 12 字节节点,左小右大)
            画矩形(12, 262, 536, 18, 0xFF232B3E);
            画文字(20, 263, "二叉树:5 个 12 字节节点(左小右大;中序遍历 = 1 3 4 5 8)", 0xFF9CC4FF);
            画树();

            // 底下两行:点中这一块"住在哪 / 谁指着它 / 它指着谁"
            画线(12, 436, 548, 436, 0xFF3C3C46);
            画矩形(12, 442, 536, 58, 0xFF16161E);
            画文字(20, 448, 说一[显], 0xFFE8E8F0);
            画文字(20, 470, 说二[显], 0xFFD0D0D8);

            // 最底下:逐帧那一句 + 两句说明(全是开窗前拼好的现成字符串)
            画线(12, 508, 548, 508, 0xFF3C3C46);
            画文字(20, 514, 扫文[扫], 0xFF9CC4FF);
            画文字(20, 538, "点堆块 / 节点都认:它们本来就是同一块内存(值 + 指针)", 0xFF8A8A96);
            画文字(20, 562, "堆那 64KB 里现在活着 8 块 + 1 块已释放 —— 框下那行是堆内偏移", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();                                // 关掉它,程序继续往下跑
