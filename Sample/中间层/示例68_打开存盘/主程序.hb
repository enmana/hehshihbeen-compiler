// ============================================================
// 示例68:打开 / 编辑 / 存盘闭环(`Sample\库\IDE文件.hb`)
//
//   这一件要证的事:**"盘上那份文件从打开到存回去"这一圈是通的** ——
//   在 `工具\临时\` 下真造一份临时工程:写盘 → `IDE文件.打开` → 改 → `IDE文件.存盘` →
//   再 `文件.读全部` 读回来,与缓冲那份**逐字比**。
//
//   判据三样:
//     ① `打开` 给真、头一行就是写进去那一行;
//     ② `改动过` 在插入前是 **0**、插入后是 **1**、存盘后回到 **0**;
//     ③ **存盘之后盘上那份逐字等于 `编辑器.全部文本()`** —— 这个真就是闭环通了。
//
//   ⚠ 两条如实登记的实况:
//     · **缓冲永远至少一条空行**:`装入文本` 读完一份以换行结尾的文件会多出一条空行 ⇒
//       第一次存盘会把那个换行写实(本件把"盘上大小"打出来,不假装它不存在);
//     · **帧账很紧**(96 字节 = 参数 + 局部 + 表达式临时槽):所以本件每一层只干一件小事 ——
//       一个函数里**只放一句 `格式化` + 一个调用**,多一件就拆出去(实测:一个函数里放
//       两条串局部 + 两句 `格式化` 当场顶穿)。
// ============================================================
包含 "../../库/编辑器.hb"
包含 "../../库/文件.hb"
包含 "../../库/IDE文件.hb"
包含 "../../库/string.hb"

// 缓冲放**顶层**(不能放进函数当局部:`编辑器.编辑缓冲` 2073 字节,一进帧就顶穿 —— 实测)
编辑器.编辑缓冲 编;
字符串 测试路径 = "工具/临时/第457批/临时工程/主程序.hb";

// ---- 每一层只干一件小事(帧账见头上那条) ----

// 造一份临时文件(三行,以换行结尾)
方法 造文件() 返回 逻辑
{
    返回 文件.写全部(测试路径, 格式化("第一行{0}第二行{0}第三行", 编辑器.换行符()));
}

// 打开它
方法 打开它() 返回 逻辑
{
    IDE文件.建库();
    返回 IDE文件.打开(编, 测试路径);
}

// 报"打开"那两样
方法 报打开(逻辑 打开了)
{
    输出行(格式化("打开={0} 行数={1}", 打开了, 编辑器.行数(编)));
    返回
}

// 报头一行
方法 报头行()
{
    输出行(格式化("头一行=[{0}]", 编辑器.行文本(编, 0)));
    返回
}

// 报改没改过
方法 报改动(字符串 什么时候)
{
    输出行(格式化("{0}改动过={1}", 什么时候, IDE文件.改动过(编)));
    返回
}

// 改一行
方法 改一行() 返回 逻辑
{
    返回 编辑器.插入文本(编, "——改过了");
}

// 存盘并报结果
方法 报存盘() 返回 逻辑
{
    逻辑 好了 = IDE文件.存盘(编);
    输出行(格式化("存盘={0}", 好了));
    返回 好了;
}

// 逐字节比(盘上 vs 缓冲)+ 报大小
方法 报比()
{
    字符串 盘上 = 文件.读全部(测试路径);
    字符串 缓冲里 = 编辑器.全部文本(编);
    逻辑 一致 = 盘上 == 缓冲里;
    输出行(格式化("逐字节比={0} 盘上大小={1}", 一致, 盘上.长度()));
    返回
}

如果 (文件.存在(测试路径))
{
    测试输出(删文件(测试路径));
}
输出行(格式化("建目录={0}", 建目录("工具/临时/第457批/临时工程")));
输出行(格式化("造文件={0}", 造文件()));
报打开(打开它());
报头行();
报改动("插入前");
改一行();
报改动("插入后");
报存盘();
报改动("存盘后");
报比();
停止
// 预期输出: 1|建目录=1|造文件=1|打开=真 行数=3|头一行=[第一行]|插入前改动过=0|插入后改动过=1|存盘=真|存盘后改动过=0|逐字节比=真 盘上大小=16
