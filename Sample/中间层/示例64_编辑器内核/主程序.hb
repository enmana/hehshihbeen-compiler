// ============================================================
// 示例64:编辑器内核(`Sample\库\编辑器.hb`)—— 文本缓冲 + 光标 + 编辑键
//
//   这一件要证的事:**"一块文本 + 一个光标"这件事本身,HB 自己写得出来**
//   (与"画出来"无关 —— 画是 4-2 `编辑器视图.hb` 的事,主循环是 4-4 的事)。
//
//   库里管四样:
//     · **行表**:`编辑缓冲` 里 256 格,每格一条池串;**光标按"字"走**(中文与 ASCII 一样算一列);
//     · **编辑**:插入(ASCII 走 `插入码点`、粘贴/输入法走 `插入文本`)/ 回车拆行 / 退格 / 删除 / 制表;
//     · **移动**:四方向(左右过行首行尾**跳行**、上下**记着想去的列**)/ 首页·末页(两段)/ 翻页;
//     · **滚屏**:光标跑出可视区就把 `可视首行` 推过去(一屏几行由 `建编辑器` 给)。
//
//   输入还是宿主那一套(`取事件(类型, 键码, 鼠标x, 鼠标y)` 轮询),旁边的 `事件脚本.txt` 是
//   一份写死的输入(第几帧投哪条),自检与 `hbcc --run --事件脚本 …` 按它喂 ⇒ **不开窗也能把这一屏
//   跑得一模一样**(硬规矩 6)。**中文走 `插入文本`**(输入法与粘贴都是这条路 —— 键盘事件一个键码
//   装不下一个汉字),ASCII 走 `插入码点`(真按键那条路)。
//
//   循环**转到用户自己关窗**(H37 那一套:收到 `类型 == 1` 就收手);无头那条路没有人去关,
//   由脚本的 `帧数 N` 投一个关窗请求 ⇒ 两条路收在同一个地方。
//
//   每一帧打完这一行四个数:**行数 / 光标(行,列)/ 可视首行 / 这一帧是第几帧** ——
//   这就是本件的验收口径(与 `// 预期输出:` 逐行对)。
// ============================================================
包含 "../../库/编辑器.hb"
包含 "../../库/string.hb"

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 第几帧 = 0;

// 一屏 5 行:小一点才看得见滚屏发生
编辑器.编辑缓冲 编;
编辑器.建编辑器(编, 5);

// 先灌两行中文(输入法/粘贴那条路就是 `插入文本`)—— 光标按"字"算,中文一个字一列、两格
编辑器.插入文本(编, "第一行中文");
编辑器.编辑键(编, 编辑器.键回车());
编辑器.插入文本(编, "第二行");
编辑器.编辑键(编, 编辑器.键回车());                 // 第三条空行,光标在行首等着键盘

// 一帧:收事件 → 该编辑的编辑 → 打这一帧的四个数 → `刷新()` 提交这一帧
//
// ⚠ **`刷新()` 是"帧边界"本身**(实测栽过):事件脚本按**帧号**投事件、也在跑满 `帧数` 时投关窗请求,
//   而帧号只在 `刷新()` 那一步 +1。第一版把 `刷新()` 写漏了 ⇒ 帧号一直是 0、脚本永远不投关窗请求、
//   程序转到池被耗尽(`字符串 本行 长不下了`)—— 与示例16「一帧的顺序永远是 收事件 → 送事件 →
//   要重画? → 重画 → 刷新()」同一条规矩。
方法 跑一帧(引用 整数 帧号) 返回 逻辑
{
    逻辑 收手 = 假;
    当 (取事件(类型, 键码, 鼠标x, 鼠标y))
    {
        如果 (类型 == 1)
        {
            收手 = 真;                               // 点标题栏的叉 / 脚本跑满帧数
        }
        否则
        {
            编辑一个事件(键码);
        }
    }
    行状态(帧号);
    刷新();
    帧号 = 帧号 + 1;
    等待(120);                                       // 真窗口上看得见;无头不真等、不产生输出
    返回 收手;
}

// 一个键盘事件进内核:编辑键先试(回车 / 退格 / 制表 / 删除),再试移动键(方向 / 首页末页 / 翻页),
// 都不是就当一个可见字符插进去(ASCII)
方法 编辑一个事件(整数 键码)
{
    如果 (编辑器.编辑键(编, 键码))
    {
        返回
    }
    如果 (编辑器.移动键(编, 键码))
    {
        返回
    }
    如果 (键码 >= 32 && 键码 <= 126)
    {
        编辑器.插入码点(编, 键码);
    }
    返回
}

// 这一帧的四个数(验收口径就这一行)
//
// ⚠ **帧账**:`行状态` 一开始是"四个 `测试输出` + 一句 `格式化`",当场报 `方法 '行状态' 的帧超出 96 字节`
//   —— 一次 `格式化` 就要一份临时槽。⇒ 四个数**只打一次**(那一句 `格式化` 里),不再各来一条 `测试输出`。
方法 行状态(整数 帧号)
{
    测试输出(帧号);
    测试输出(编辑器.行数(编));
    测试输出(编辑器.光标行(编));
    测试输出(编辑器.光标列(编));
    测试输出(编辑器.可视首行(编));
    字符串 本行 = 编辑器.行文本(编, 编辑器.光标行(编));
    输出行(本行);
    返回
}

如果 (打开窗口("HB 编辑器内核", 420, 200))
{
    逻辑 收手 = 假;
    当 (!收手)
    {
        收手 = 跑一帧(第几帧);
    }
    关闭窗口();
}

// 收尾:三条边界(都是"不报错、给确定值"那一档;行数 + 越界行 + 整篇占几个字)
//
// ⚠ **不许把带换行的整篇直接打出来**(实测):`// 预期输出:` 是**按行**比的,一条 `输出行` 里
//   夹着换行就会被拆成几行 ⇒ 期望值对不上(而且真跑起来也看不清)。要一行一行看内容就按行号打。
字符串 全篇 = 编辑器.全部文本(编);
字符串 越界 = 编辑器.行文本(编, 99);
输出行(格式化("收尾: {0} 行, 越界行长 {1}, 整篇 {2} 字", 编辑器.行数(编), 越界.长度(), 全篇.长度()));
停止
// 预期输出: 打开窗口 标题="HB 编辑器内核" 宽=420 高=200|0|3|2|2|0|HB|刷新 命令=0|1|2|1|3|0|第二行HB|刷新 命令=0|2|3|2|2|0|ABHB|刷新 命令=0|3|3|2|1|0|AHB|刷新 命令=0|4|5|4|0|0|HB|刷新 命令=0|5|5|0|0|0|第一行中文|刷新 命令=0|6|5|0|0|0|第一行中文|刷新 命令=0|关闭窗口|收尾: 5 行, 越界行长 0, 整篇 15 字
