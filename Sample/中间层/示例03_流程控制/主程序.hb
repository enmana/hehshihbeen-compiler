// 示例03_流程控制 —— 分支、选择、三种循环、跳出/继续(含多层)
//
//   这个示例演示什么:
//     1) `如果 / 否则 如果 / 否则` 链:多层判断一条链写完,不用一层层往右缩进
//     2) `选择 / 情况 / 默认`:按一个值挑分支(每个 情况 用完自动结束,不会掉进下一个)
//     3) `当`(while):条件成立就转
//     4) `循环`(for):三段式 初始化;条件;步进,步进里能写复合赋值
//     5) `遍历`(内存):从起始地址起,按"数量"个字节逐字节读进当前变量
//     6) `跳出` / `继续`:离开最近一层循环 / 跳过本轮剩下的语句
//     7) `跳出 2` / `继续 2`:一次管两层(选择也算一层,继续只数循环)
//     8) 嵌套循环:外内两层配合
//
//   重点看哪几处:【6)】的 7 是 1+2+4 而不是 1+2+3+4、【7)】跳出 2 直接得 34、
//   【8)】继续 2 让内层每轮只算一次、【9)】遍历是靠手写两条指令先把数据摆进内存。
//   关键字中英等价(如果/if、当/while、循环/for 都合法),标识符随便起,中文优先只是默认。
//
//   ============================================================
//   怎么看(带 UI;H82 批 2)—— 这一份是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例03 流程控制`。
//       窗口左边一列八格就是上面那八个小节;点哪一格,右边的表当场换成那一节 ——
//       表里是那一节**真跑下来的过程**(左列"念到哪一步"、右列这一步的值),
//       每刷新一帧蓝底往下走一格,"过程"就在你眼前一步步往前挪;
//       **绿底那一行 = 这一节真正走到 / 真正算出来的那一步**(如果链里成立的那一支、
//       `跳出 2` 那节里 a = 3、b = 4 那次命中),灰底那一行 = 后面连看都不看了。
//       点右边某一行,蓝底直接停到那一行。窗口**一直转到你自己关掉**(点标题栏的叉)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、也不用等人去关 ——
//       旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),第 13 帧宿主投一个关窗请求;
//       于是"窗口该画什么、点一下换成哪一节"都能逐行对出来(硬规矩 6:自检不开窗)。
//     · **顺序**:先把上面那些纯计算跑完、`测试输出` 打完(文件末尾那行 `// 预期输出:` 对的就是它们),
//       **然后**才开窗 —— 于是这一份示例的期望输出里,"数"还是那些数,窗口那几行排在后头。
//   ============================================================

// 1) 如果 / 否则 如果 / 否则
整数 score = 87;
如果 (score >= 90)
{
    测试输出(4);
}
否则 如果 (score >= 80)
{
    测试输出(3);            // 87 → 良
}
否则 如果 (score >= 60)
{
    测试输出(2);
}
否则
{
    测试输出(1);
}

score = 45;
如果 (score >= 90)
{
    测试输出(4);
}
否则 如果 (score >= 60)
{
    测试输出(2);
}
否则
{
    测试输出(1);            // 45 → 不及格
}

// 2) 英文写法 if / else if / else,与中文完全等价
if (score == 45)
{
    测试输出(45);
}
else
{
    测试输出(0);
}

// 3) 选择 / 情况 / 默认
整数 level = 2;
选择 (level)
{
    情况 3
    {
        测试输出(300);
    }
    情况 2
    {
        测试输出(200);      // level = 2 → 走这一支
    }
    默认
    {
        测试输出(50);
    }
}

// 4) 当(while)
整数 n = 0;
整数 acc = 0;
当 (n < 5)
{
    acc = acc + n;
    n = n + 1;
}
测试输出(acc);              // 0+1+2+3+4 = 10

// 5) 循环(for)
整数 prod = 1;
循环 (整数 k = 1; k <= 4; k += 1)
{
    prod *= k;
}
测试输出(prod);             // 1*2*3*4 = 24

// 6) 跳出 / 继续
整数 s1 = 0;
循环 (整数 i = 1; i <= 5; i += 1)
{
    如果 (i == 3)
    {
        继续;               // 跳过本轮剩下的语句
    }
    如果 (i == 5)
    {
        跳出;               // 直接离开这一层循环
    }
    s1 += i;
}
测试输出(s1);               // 1+2+4 = 7(3 被跳过,5 之前就跳出了)

// 7) 嵌套循环 + 跳出 2:一次跳出两层
整数 found = 0;
循环 (整数 a = 2; a <= 4; a += 1)
{
    循环 (整数 b = 2; b <= 4; b += 1)
    {
        如果 (a * b == 12)
        {
            found = a * 10 + b;
            跳出 2;
        }
    }
}
测试输出(found);            // 34(a=3、b=4 时跳出两层)

// 8) 继续 2:跳过内层剩下的,直接进外层循环的下一次
整数 cnt = 0;
循环 (整数 m = 1; m <= 3; m += 1)
{
    循环 (整数 d = 1; d <= 3; d += 1)
    {
        如果 (d == 2)
        {
            继续 2;
        }
        cnt += 1;
    }
}
测试输出(cnt);              // 3(每轮外层只在内层 d=1 时记一次)

// 9) 遍历(内存):先用两条指令把 1、2、3 摆进 0x2000 起的字节里
加载立即数 R2, 1
存储 R2, [0x2000]
加载立即数 R2, 2
存储 R2, [0x2001]
加载立即数 R2, 3
存储 R2, [0x2002]

byte cur = 0;               // 每轮读出来的那个字节
整数 pt = 0x2000;           // 起始地址
整数 left = 3;              // 还要读几个字节
整数 total = 0;
遍历 (cur, 起始 pt, 数量 left)
{
    total = total + cur;    // 1+2+3 = 6
}
测试输出(total);

// ---- 带 UI 的那一半(H82 批 2):左边八格小节,右边那一节"真跑下来的过程" ----
// 这一整块**只在真开得了窗口时才跑**:没有图形能力的宿主给 假 ⇒ 一个字都不多打,
// 上面那十个 `测试输出` 还是那十个(顺序、条数一个字没动)。
//
//   · 左边一列八格 = 上面那八个小节(如果链 / 选择 / 当 / 循环 / 遍历 / 跳出·继续 / 跳出 2 / 嵌套);
//     点哪一格,右边那张表当场换成那一节,那一格与"鼠标正压着的那一格"都给底色。
//   · 右边那张两列表 = 那一节**真跑下来的过程**:左列"念到哪一步",右列这一步的值。
//   · 每 `刷新()` 进一帧,蓝底往下走一格(走到这一节最后一行就绕回第一行)—— 过程在逐帧往前走。
//   · **绿底那一行 = 这一节真正走到 / 真正算出来的那一步**;灰底那一行 = 后面连看都不看了。
//   · 点右边某一行,蓝底直接停到那一行(想细看哪一步就点它)。
//
// ⚠ 主循环(每帧都跑的那一层)里**一条字符串都不拼**:要画的字全在开窗之前拼好,每帧只是照原样画。
//   实测:主循环里每帧现拼几十条,209 帧就把编译器那个池吃光,真窗口上跑几秒就报「池用完了」——
//   这一篇一条都不现拼,状态真变了(换节 / 点行)也只是改两个下标。
// ⚠ 摆位与命中测试**用的是同一组数**(`格顶` / `格高` / `行0` / `行距`),要挪地方只改这几行。

整数 窗宽 = 560;
整数 窗高 = 480;
整数 格顶 = 72;                 // 左边第一格的顶边
整数 格高 = 34;                 // 一格多高(= 命中测试的除数)
整数 格宽 = 180;                // 左边那一列的宽
整数 板左 = 204;                // 右边那块板的左边
整数 板宽 = 344;                // 右边那块板的宽
整数 行0 = 150;                 // 表里第一行的顶边
整数 行距 = 25;                 // 一行多高(= 命中测试的除数)

// ---- 每一节要说的话 —— 一律写字面量(字符串赋值右边只认"字面量 / 另一个串 / 一个返回串的调用")----
方法 格名(整数 节) 返回 字符串
{
    字符串 s = "?";
    如果 (节 == 0)
    {
        s = "① 如果/否则 如果";
    }
    如果 (节 == 1)
    {
        s = "② 选择/情况/默认";
    }
    如果 (节 == 2)
    {
        s = "③ 当(while)";
    }
    如果 (节 == 3)
    {
        s = "④ 循环(for)";
    }
    如果 (节 == 4)
    {
        s = "⑤ 遍历(内存)";
    }
    如果 (节 == 5)
    {
        s = "⑥ 跳出/继续";
    }
    如果 (节 == 6)
    {
        s = "⑦ 跳出 2/继续 2";
    }
    如果 (节 == 7)
    {
        s = "⑧ 嵌套循环";
    }
    返回 s;
}

