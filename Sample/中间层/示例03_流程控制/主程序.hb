// ---- 表里的文字:47 行,左列"念到哪一步"、右列这一步的值 ----
// ⚠ 四十几条分支装一个函数里会撞「帧超出 96 字节」⇒ 拆成前后两个,一个函数别超过 ~24 条。
方法 行说明前(整数 平) 返回 字符串
{
    字符串 s = "";
    如果 (平 == 0)
    {
        s = "score = 87";
    }
    如果 (平 == 1)
    {
        s = "比 >= 90";
    }
    如果 (平 == 2)
    {
        s = "比 >= 80";
    }
    如果 (平 == 3)
    {
        s = "比 >= 60";
    }
    如果 (平 == 4)
    {
        s = "否则";
    }
    如果 (平 == 5)
    {
        s = "level = 2";
    }
    如果 (平 == 6)
    {
        s = "情况 3";
    }
    如果 (平 == 7)
    {
        s = "情况 2";
    }
