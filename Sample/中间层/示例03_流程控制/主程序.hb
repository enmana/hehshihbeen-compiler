方法 尾一文本(整数 节) 返回 字符串
{
    字符串 s = "?";
    如果 (节 == 0)
    {
        s = "第 1 比不成立就往下;第 2 比一成立,后面两条不再看 —— 链到这儿断了";
    }
    如果 (节 == 1)
    {
        s = "情况 用完自动结束:所以进了 情况 2,默认 那一支连碰都不会碰";
    }
    如果 (节 == 2)
    {
        s = "循环体走 5 趟(n = 0~4);n 到 5 那一刻条件不成立,才出循环";
    }
    如果 (节 == 3)
    {
        s = "循环头三段:初始化 k = 1;条件 k <= 4;步进 k += 1 每轮末尾走一次";
    }
    如果 (节 == 4)
    {
        s = "遍历 是唯一的按字节扫内存写法:读几个字节由 数量 说了算";
    }
    如果 (节 == 5)
    {
        s = "继续 = 跳过本轮剩下的语句;跳出 = 直接离开这一层";
    }
    如果 (节 == 6)
    {
        s = "跳出 2 一次管两层:内层与外层一起出,后面的组合一个都不算了";
    }
    如果 (节 == 7)
    {
        s = "继续 2 只数循环:跳到外层下一次,所以内层每轮只在 d = 1 时记一次";
    }
    返回 s;
}

