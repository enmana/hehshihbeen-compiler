// ============================================================
// 示例18:文本处理(库 `Sample\库\string.hb` 第4批;R3-4 第二支)
//
//   要解决的事:HB 有 `取段(主串, 分隔, 序号)`,但"把一条串按分隔符全切开、逐段处理、再拼回去"
//   以前只能自己一圈一圈地叫 `取段`。这一批补上切分 / 连接,顺带几条单串上的小工具。
//
//   段表怎么给(**这一批的关键设计**):段表 = **两条并排的整数数组**(起、长),地方由调用方出。
//   三条语言边界逼出了这个形状(见 `Sample\库\string.hb` 文件头,也钉在自检里):
//     ① 动态列表不能当参数传、不能当返回值;② 元素是字符串的列表不能进结构字段;
//     ③ 字符串参数 + 结构参数同处一个函数头时,结构字段取下标编不过。
//   段本身不另存一份:表里只有下标,文字还在原串里 ⇒ 库不留跨调用的状态。
//
//   本示例演示:
//     ① 切分:空段照样记账("张三,李四,,王五" 是 4 段);返回实际写下的段数
//     ② 段取 / 数组元素:按段号取回来;越界给空串
//     ③ 段数:光数不建表(和 切分 同一口径;先问一句就不会因为表小丢段)
//     ④ 连接:各段用分隔拼回去(切分 + 连接 = 往返)
//     ⑤ 表装不下 / 分隔符为空串两个边界
//     ⑥ 反转 / 重复
//     ⑦ 左补位 / 右补位:不足才补,超了不截断
//     ⑧ 安全解析整数:整串必须正好合法且不越 32 位;失败不动出参
// ============================================================
包含 "../../库/string.hb"

// 段表:两条并排的数组(下面这些演示都用它们装"每段的起 + 长")
整数 起[8];
整数 长[8];

// ① 切分:空段照记
整数 段个数 = 切分("张三,李四,,王五", ",", 起, 长);
测试输出(段个数);
字符串 零号段 = 段取("张三,李四,,王五", 起, 长, 0);
输出行(零号段);
测试输出(长[2]);
字符串 越界段 = 段取("张三,李四,,王五", 起, 长, 9);
测试输出(越界段.长度());

// ② 段数:光数不建表
测试输出(段数("张三,李四,,王五", ","));
测试输出(段数("没有分隔符", ","));
测试输出(段数("", ","));
测试输出(段数("abc", ""));

// ③ 连接:切分 + 连接 是个往返
字符串 拼回 = 连接("张三,李四,,王五", 起, 长, 段个数, "-");
输出行(拼回);

// ④ 表装不下:只写能放的,返回写下几段
整数 小起[2];
整数 小长[2];
测试输出(切分("张三,李四,王五,赵六", ",", 小起, 小长));
测试输出(段数("张三,李四,王五,赵六", ","));

// ⑤ 分隔符为空串:整串算一段
整数 空隔起[2];
整数 空隔长[2];
测试输出(切分("红绿蓝", "", 空隔起, 空隔长));
测试输出(空隔长[0]);

// ⑥ 反转 / 重复
字符串 倒过来 = 反转("abc中");
输出行(倒过来);
字符串 放三遍 = 重复("ab", 3);
输出行(放三遍);
字符串 放零遍 = 重复("ab", 0);
测试输出(放零遍.长度());

// ⑦ 补位:不足才补,超了不截断
字符串 补零 = 左补位("7", 3, '0');
输出行(补零);
字符串 补点 = 右补位("7", 3, '.');
输出行(补点);
字符串 超宽 = 左补位("abcd", 2, '0');
输出行(超宽);

// ⑧ 安全解析整数:整串必须正好合法(与 字符串转整数 的"给 0 / 夹住"相反)
整数 收 = 0;
测试输出(安全解析整数("  -12 ", 收));
测试输出(收);
收 = 42;
测试输出(安全解析整数("12x", 收));
测试输出(收);
测试输出(安全解析整数("", 收));
测试输出(安全解析整数("+7", 收));
测试输出(收);
测试输出(安全解析整数("2147483647", 收));
测试输出(收);
测试输出(安全解析整数("2147483648", 收));
测试输出(安全解析整数("-2147483648", 收));
测试输出(收);
测试输出(安全解析整数("-2147483649", 收));
测试输出(收);
停止

// 预期输出: 4|张三|0|0|4|1|1|1|张三-李四--王五|2|4|1|3|中cba|ababab|0|007|7..|abcd|1|-12|0|42|0|1|7|1|2147483647|0|1|-2147483648|0|-2147483648
