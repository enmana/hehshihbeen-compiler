// ============================================================
// 示例69:后端接线(`Sample\库\IDE后端.hb`)—— 后端输出怎么"收回来、拆成行"
//
//   这一件要证的事:**IDE 里那个"编译 + 跑"按钮背后那件事** —— 拼命令行 → 交给后端 →
//   收 stdout → 拆成一行一行(好灌进输出区)。判据照施工图那条:**用"假后端"把
//   "发出去的命令 / 收回来的行"两边都逐条对**(与"假前端"那条自检同一个思路)。
//
//   分两段:
//     ① **假后端**(本件的主判据,自检里跑的就是这一段):挂一份固定的多行输出 + 退出码 12,
//        再调 `编译并跑` ⇒ 逐条核"行数 / 每一行 / 退出码 / 是假后端";
//     ② **真后端**(有白名单那台机器上跑):`设命令("hbcc")` + 真起一个进程。
//        ⚠ 这一段的**现况如实记**:`hbcc` 自己跑的时候再 `运行进程("hbcc", … --run …)`
//        会崩(同一份二进制**不支持嵌套跑虚拟机**;实测:跑"不嵌套"的工程给 `起=真 码=0`,
//        跑任何"还要再跑一份 VM"的工程给 `起=假 码=-1`,加 `--跨进程` 也一样)—— 这条已登记,
//        所以本件在这一段只验"没能力 / 名字不对"那一档能不能干净地给假。
//
//   ⚠ 帧账(96 字节)在这一件尤其吃紧:一个函数里"两三个 `格式化`"就顶穿 ⇒ 下面一律**一句一函数**。
//
//   🔶 **本件的状态如实记(下一笔接着修)**:① 假后端那一段(主判据)**全绿** ——
//     `是假后端` 0→1、`起了=假`(假后端那趟本来就"没真起进程",照设计给假)、
//     **行数=4 / 四行逐条对 / 空行占位 / 越界给空 / 退出码=12**;
//     ② **真后端那一档还不对**:`设命令("这个后端不在白名单里")` 之后跑,读到的是
//     **4 行 + 上一次那段假输出**(期望:0 行 + 退出码 -1)—— 库那几条清状态的路上还有一处没查清,
//     已登记;**所以本件此刻不写 `// 预期输出:`**(写了就是把错的读数钉成基线)。
// ============================================================
包含 "../../库/编辑器.hb"
包含 "../../库/IDE后端.hb"
包含 "../../库/string.hb"

// 换行那一个字的串(本工程自带一份,不引别的库)
方法 造换行() 返回 字符串
{
    返回 编辑器.换行符();
}

// 一份"假后端"的输出:四行(第三行故意是空的 —— 空行也要占一行)
方法 造假输出() 返回 字符串
{
    字符串 换 = 造换行();
    字符串 结果;
    拼接到(结果, "编译:0 个错误");
    拼接到(结果, 换);
    拼接到(结果, "跑:示例01 通过");
    拼接到(结果, 换);
    拼接到(结果, 换);
    拼接到(结果, "退出码 0");
    返回 结果;
}

// ---- 每一层只干一件小事(帧账见头上那条) ----

// 报一行(标签 + 行号 + 那一行)
方法 报一行(字符串 标签, 整数 第几行)
{
    输出行(格式化("{0}第{1}行=[{2}]", 标签, 第几行, IDE后端.取输出行(第几行)));
    返回
}

// 报"是不是假后端"
方法 报假后端(字符串 什么时候)
{
    输出行(格式化("{0}是假后端={1}", 什么时候, IDE后端.是假后端()));
    返回
}

// 报一次跑的结果
方法 报跑(字符串 标签, 逻辑 起了)
{
    输出行(格式化("{0}起了={1} 行数={2} 退出码={3}", 标签, 起了, IDE后端.输出行数(), IDE后端.退出码()));
    返回
}

// 第 ① 段:假后端那一路
方法 段假后端()
{
    IDE后端.建后端();
    报假后端("挂之前 ");
    IDE后端.挂假后端(造假输出(), 12);
    报假后端("挂之后 ");
    逻辑 起了 = IDE后端.编译并跑("随便什么参数", 1000);
    报跑("假后端: ", 起了);
    报一行("假后端: ", 0);
    报一行("假后端: ", 1);
    报一行("假后端: ", 2);
    报一行("假后端: ", 3);
    报一行("假后端越界: ", 9);
    返回
}

// 第 ② 段:真后端那一档(名字不在白名单 ⇒ 干净地给假、退出码 -1)
方法 段真后端()
{
    IDE后端.建后端();
    IDE后端.设命令("这个后端不在白名单里");
    报跑("真后端: ", IDE后端.编译并跑("--run", 1000));
    报一行("真后端: ", 0);
    返回
}

// 第 ③ 段:连命令都没设(库自己的护栏:直接给假,不起进程)
方法 段没设命令()
{
    IDE后端.建后端();
    报跑("没设命令: ", IDE后端.编译并跑("--run", 1000));
    返回
}

段假后端();
段真后端();
段没设命令();
停止
// 预期输出: 挂之前 是假后端=0|挂之后 是假后端=1|假后端: 起了=假 行数=4 退出码=12|假后端: 第0行=[编译:0 个错误]|假后端: 第1行=[跑:示例01 通过]|假后端: 第2行=[]|假后端: 第3行=[退出码 0]|假后端越界: 第9行=[]|真后端: 起了=假 行数=1 退出码=-1|真后端: 第0行=[没起来:这个工程没给 `可执行文件` 白名单,或者名字不对,或者超时了]|没设命令: 起了=假 行数=0 退出码=-1
