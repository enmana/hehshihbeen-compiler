// ============================================================
// 示例49_Markdown(G4 批 17:`Sample\库\Markdown.hb`)
//
//   这一段演示什么:**程序生成一份 `.md`,再当场把它读回结构** ——
//     ① **写**:`开始 / 标题 / 段落 / 要点 / 编号 / 代码块 / 表格` 一条条追加,
//        `取结果` 一次成型成整串(写那一半是**一个持久缓冲**,反复写不涨池);
//     ② **读**:`解析` 把整串收进库里的字节区,认成"块 + 行内"两层;
//        `块数 / 取块 / 块级 / 行内数 / 取行内` 按块取、按行内取;
//        表那一档问 `表行数 / 行首格 / 行格数`;
//     ③ **读那一半不往池里搬**:`取块 / 取行内 / 转纯文本 / 转HTML` 都把结果写进**你自己那一格**
//        (反复取同一格 ⇒ 就地复用);
//     ④ **转 HTML**:那一趟按 HTML 五个字符转义(正文里的 `<script>` 出来只是字);
//     ⑤ **摆到窗口上**:标题 / 块数 / 表格格数拼成标签摆进窗口(即时模式:标脏 → 要重画 → 重画)。
//
//   三条口径(演示里照它走):
//     ① **写:一条条追加,最后取一次** —— `开始()` 清缓冲,`取结果(全篇)` 收尾;
//     ② **读:解析一次、按两层取** —— 块那一层是"行"的口径,行内那一层是"这一段里的东西";
//     ③ **表格按行问** —— 行号从 0 起(第 0 行是列头),格号是行内那一层的下标。
//
//   ⚠ **这一篇不碰盘**(标准工程不碰盘):要落成 `.md` 文件自己配 `文件.hb` 的 `写全部`;
//     窗口那一半照 `示例16_控件库` 的骨架:第 0 帧画一屏,之后没有事件就只推进节拍,
//     自检与 `hbcc --run --无头 --事件脚本 …` 按同目录那份 `事件脚本.txt` 喂帧。
// ============================================================
包含 "../../库/Markdown.hb"
包含 "../../库/界面.hb"

// ---------------- ① 写:一条条追加 ----------------
逻辑 丢一 = Markdown.开始();
逻辑 丢二 = Markdown.标题(1, "项目周报");
逻辑 丢三 = Markdown.段落("这一周把 Markdown 库补齐了。");
逻辑 丢四 = Markdown.要点("写那一半零依赖");
逻辑 丢五 = Markdown.要点("读那一半给**块**与行内");
逻辑 丢六 = Markdown.编号("先写库");
逻辑 丢七 = Markdown.编号("再配示例");
逻辑 丢八 = Markdown.代码块("hb", "输出行(1);");
逻辑 丢九 = Markdown.表格("名字|年龄", "张三|28\n李四|30");
逻辑 丢十 = Markdown.段落("代码里写 `a < b` 与 <script> 都不该把页面带坏。");

字符串 全篇 = "";
测试输出(Markdown.取结果(全篇));              // 1
输出行(Markdown.字节数());                     // 304(UTF-8 字节)
输出行(全篇.长度());                           // 182(文字数:中文一个字算一个)

// ---------------- ② 读:解析一次,按块 / 行内取 ----------------
整数 文档 = Markdown.解析(全篇);
字符串 块文 = "";
整数 种类 = 0;
测试输出(Markdown.块数(文档));                // 10

测试输出(Markdown.取块(文档, 0, 种类, 块文)); // 1
输出行(种类);                                  // 1 标题
输出行(块文);                                  // 项目周报
测试输出(Markdown.块级(文档, 0));              // 1

测试输出(Markdown.取块(文档, 1, 种类, 块文)); // 1
输出行(块文);                                  // 这一周把 Markdown 库补齐了。

// 要点那一块:块自己的文本是"去掉标记"的,标记在行内那一层
测试输出(Markdown.取块(文档, 3, 种类, 块文)); // 1
输出行(块文);                                  // 读那一半给**块**与行内
测试输出(Markdown.行内数(文档, 3));            // 3

字符串 段文 = "";
字符串 段址 = "";
整数 内类 = 0;
测试输出(Markdown.取行内(文档, 3, 1, 内类, 段文, 段址));   // 1
输出行(内类);                                  // 2 粗体
输出行(段文);                                  // 块
测试输出(段文.长度());                         // 1

// 代码块:围栏里的内容原样给(不做行内)
测试输出(Markdown.取块(文档, 6, 种类, 块文)); // 1
输出行(种类);                                  // 6 代码块
输出行(块文);                                  // 输出行(1);

// 表格:行按 `表行数` 问,格号由 `行首格 / 行格数` 给
测试输出(Markdown.表行数(文档, 7));            // 2
测试输出(Markdown.行格数(文档, 7, 0));         // 2
整数 首格 = Markdown.行首格(文档, 7, 0);
测试输出(Markdown.取行内(文档, 7, 首格, 内类, 段文, 段址)); // 1
输出行(段文);                                  // 名字
测试输出(Markdown.行首格(文档, 7, 1));         // 2

// 转纯文本 / 转 HTML:都写进自己那一格
字符串 纯文 = "";
测试输出(Markdown.转纯文本(文档, 纯文));       // 1
输出行(纯文.长度());                           // 146(去掉了标记的正文)
输出行(纯文.长度() < 全篇.长度());              // 1
字符串 网页 = "";
测试输出(Markdown.转HTML(文档, 网页));         // 1
输出行(网页.长度());                           // 422
输出行(网页.长度() > 全篇.长度());              // 1

// ---------------- ③ 写读往返:生成 → 解析 → 再生成 ----------------
整数 文档二 = Markdown.解析(全篇);
字符串 再一遍 = "";
测试输出(Markdown.取结果(再一遍));             // 1
输出行(再一遍 == 全篇);                        // 1 逐字节相同

// ---------------- ④ 写那一半的几个小档 ----------------
逻辑 丢二十 = Markdown.开始();
逻辑 丢二一 = Markdown.段落("# 不是标题");
字符串 一段 = "";
测试输出(Markdown.取结果(一段));               // 1
输出行(一段);                                  // \# 不是标题

字符串 躲好的 = "";
测试输出(Markdown.转义("a*b_c", 躲好的));      // 1
输出行(躲好的);                                // a\*b\_c

字符串 空格好的 = "";
测试输出(Markdown.中英空格("中文abc中文", 空格好的));   // 1
输出行(空格好的);                              // 中文 abc 中文

// ============================================================
// 窗口那一半:把读回来的东西摆到窗口上(即时模式)
// ============================================================
界面 表单;
建界面(表单, 12, 12, 320, 6);
整数 标一 = 加标签(表单, "标题:项目周报");
整数 标二 = 加标签(表单, "读回 10 个块");
整数 标三 = 加标签(表单, "表格 2 行 × 2 格");
测试输出(控件数(表单));                        // 3
测试输出(控件上(表单, 标三));                  // 66

如果 (打开窗口("Markdown 演示", 360, 220))
{
    逻辑 收手 = 假;
    整数 帧 = 0;
    整数 类型 = 0;
    整数 键码 = 0;
    整数 鼠标x = 0;
    整数 鼠标y = 0;
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;
            }
            否则
            {
                送事件(表单, 类型, 键码, 鼠标x, 鼠标y);
            }
        }
        如果 (!收手)
        {
            如果 (要重画(表单))
            {
                测试输出(帧);
                整数 条 = 重画(表单);
                测试输出(条);
            }
            否则
            {
                测试输出(-1);
            }
            刷新();
            帧 = 帧 + 1;
            等待(250);
        }
    }
    关闭窗口();
}

停止

// 预期输出: 1|304|182|9|1|1|项目周报|1|1|这一周把 Markdown 库补齐了。|1|读那一半给\*\*块\*\*与行内|5|1|3|\|1|1|6|输出行(1);|3|2|1|名字|2|1|148|1|1|424|1|1|0|1|\# 不是标题\||1|a\*b\_c|1|中文 abc 中文|3|68|打开窗口 标题="Markdown 演示" 宽=360 高=220|0|4|清屏 颜色=0xFF101018|画文字 x=12 y=16 文本="标题:项目周报" 颜色=0xFFB0B0B8|画文字 x=12 y=44 文本="读回 10 个块" 颜色=0xFFB0B0B8|画文字 x=12 y=72 文本="表格 2 行 × 2 格" 颜色=0xFFB0B0B8|刷新 命令=4|-1|刷新 命令=0|关闭窗口
