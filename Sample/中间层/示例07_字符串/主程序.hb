// ============================================================
// 示例07:字符串 —— 一段会变的文字怎么存、怎么改、怎么算
//
//   关键字中英等价(`如果` 就是 `if`),标识符随便起,中文优先只是默认 ——
//   本文件里两种写法混着用,一样能编。
//
//   本示例演示:
//     ① 声明 / 赋值(容量不够自动 ×2 翻倍)/ `.长度()`
//     ② 下标取出来是一个 `文字`;`名字[下标] = 文字` 写回去**可以不等长**
//     ③ 比较 `==` `!=` 与字典序(`<` `<=` `>` `>=`);拼接 `拼接到`
//     ④ 字符串当函数参数 / 当返回值
//     ⑤ `字符串 出 名字` = 可写回参数(里面一赋值,外面那份当场就变)
//     ⑥ 字符串进结构字段(`字符串 name;` 字段里是"数据地址 + 容量",字在堆里)
//        与定长缓冲(`字符 code[8];` 内联、末尾 0 定长度)、字符串数组
//     ⑦ `包含 "../../库/string.hb"` 之后用库里的字符串工具
//
//   重点看两处:长度与下标都按**文字**(中文一个字算一个)算;赋值是**各有一份**(值语义)。
//
//   ============================================================
//   怎么看(带 UI;H82 批 1)—— 这一份是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例07 字符串`。
//       这一篇讲的是"一段会变的文字怎么存 / 怎么改 / 怎么算",所以窗口里演的就是**文字本身在变**:
//       左边四格 = 上面四种改法(等长替换 / 不等长替换 / 拼接 / 转大写),**鼠标点哪一格就在哪一格上改一次**;
//       右边那一块画的就是改完之后的**当前字符串**,连同它的 `.长度()` 与屏幕宽度
//       (`取文字宽度`:ASCII 1 格、汉字 2 格 —— 不等长替换之后这两个数当场分家)。
//       窗口**一直转到你自己关掉**(点标题栏的叉)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、也不用等人去关 ——
//       旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),跑满它写的帧数就投一个关窗请求;
//       于是"窗口该画什么、点一下文字变成什么样"都能逐行对出来(硬规矩 6:自检不开窗)。
//     · **顺序**:先把上面那些纯计算跑完、`输出行` / `测试输出` 打完(文件末尾那行 `// 预期输出:` 对的就是它们),
//       **然后**才开窗 —— 于是这一份示例的期望输出里,"字"还是那些字,窗口那几行排在后头。
//   ============================================================
包含 "../../库/string.hb"

// ---- ① 声明 / 赋值 / 长度 ----
字符串 text = "hello";
输出行(text);                     // hello
测试输出(text.长度());            // 5
text = "这里更长了";               // 容量不够自动翻倍,不用你管
输出行(text);
测试输出(text.长度());            // 5

// ---- ② 下标:读出来是 `文字`,写回去可以不等长 ----
字符串 word = "abc";
文字 c = word[0];
输出行(c);                        // a
word[1] = 'B';                    // 等长替换
输出行(word);                     // aBc
word[0] = '中';                   // 不等长也行:后面自动挪位,容量不够自动扩容
输出行(word);                     // 中Bc
测试输出(word.长度());            // 3
输出行(word[1]);                  // B

// ---- ③ 比较:== != 与字典序 ----
字符串 a = "apple";
字符串 b = "banana";
测试输出(a == "apple");           // 1
测试输出(a != b);                 // 1
测试输出(a < b);                  // 1
测试输出("apple" < "apples");     // 1(一个是另一个的前缀时,短的算小)
如果 (a == "apple")
{
    输出行("same");
}

// ---- ④ 拼接:段数不限,字符串 / 一个字节 / 一个文字都能接 ----
字符串 full;
拼接到(full, "for ", a, "-", '!');
输出行(full);                     // for apple-!

// ---- ⑤ 当参数 / 当返回值 ----
方法 量长(字符串 s) 返回 整数
{
    返回 s.长度();
}
测试输出(量长(full));             // 11

方法 挑(整数 n) 返回 字符串
{
    if (n < 0)
    {
        返回 "neg";
    }
    返回 "pos";
}
字符串 r = 挑(5);
输出行(r);                        // pos
r = 挑(-1);
输出行(r);                        // neg

// ---- ⑥ 可写回参数 `字符串 出 名字` ----
方法 造全名(字符串 出 outName, 字符串 first, 字符串 last)
{
    outName = first;
    拼接到(outName, " ", last);
}
字符串 who;
造全名(who, "Amy", "Lee");
输出行(who);                      // Amy Lee
测试输出(who.长度());             // 7

// ---- ⑦ 字符串进结构字段 + 定长缓冲 `字符 代号[8]` ----
结构 Card
{
    字符串 name;                  // 8 字节:数据地址 + 容量;真正的字在堆里,会变长
    字符 code[8];                 // 定长缓冲:内联 8 字节,末尾的 0 定长度
}
Card one;
one.name = "pen";
one.code = "P1";
输出行(one.name);                 // pen
输出行(one.code);                 // P1
测试输出(one.name.长度());        // 3
拼接到(one.name, "cil");          // 字段里装不下就换一块更大的
输出行(one.name);                 // pencil

// ---- ⑧ 字符串数组:每个元素自己一份 ----
字符串 names[3];
names[0] = "Amy";
names[1] = "Bob";
names[2] = "Cid";
整数 i = 1;
输出行(names[i]);                 // Bob(运行期下标也行)
测试输出(names[i] == "Bob");      // 1

// ---- ⑨ 库函数(string.hb):挑几个语言里没有的 ----
字符串 num = 转字符串(2026);
输出行(num);                      // 2026
测试输出(找子串("hello world", "world"));   // 6
输出行(取子串("hello world", 0, 5));        // hello
输出行(替换("a-b-c", "-", "+"));            // a+b+c
输出行(去空白("  hi  "));                   // hi
输出行(转大写("abc"));                      // ABC
输出行(转小写("ABC"));                      // abc

// ---- ⑩ 带 UI 的那一半(H82 批 1):左边四格操作按钮,右边那段文字当场变 ----
// 这一整块**只在真开得了窗口时才跑**:没有图形能力的宿主给 假 ⇒ 一个字都不多打,
// 上面那 33 段输出还是那 33 段输出(①~⑨ 那些 输出行 / 测试输出 一行都没动)。

// 左边那四格按钮的名字:开窗之前拼一次就够
// ⚠ 窗口那一层(每帧都跑)里**一条字符串都不再拼** —— 每帧现拼会把编译器的字符串池吃光(示例01 实测过)。
字符串 按钮[4];
按钮[0] = "① 等长替换";
按钮[1] = "② 不等长替换";
按钮[2] = "③ 拼接一段";
按钮[3] = "④ 转大写";

// 窗口里那段"会变的文字":从 abc 出发,点一次真改一次
字符串 当前 = "abc";
字符串 长度行;                 // 只在"文字真被改过"之后重拼一次(每帧重拼 = 池漏光)
字符串 说明行;
整数 操作次 = 0;                // 点过几下(也是拼接接上去的那个序号)
整数 点了 = -1;                 // 最后点下的那一格;-1 = 还没点
整数 类型 = 0;                  // 图形那一套要的四个出参(照 示例14 / 15 / 16)
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                   // 这一帧那"点一下"落在哪儿(x / y)
整数 点y = 0;
逻辑 有一下 = 假;               // 这一帧收到过"点一下"(按下 + 抬起)没有

// 状态那一行:长度按**文字**算(中文一个字算一个)、屏幕宽度按**格**算
方法 状态行(整数 字数, 整数 格数) 返回 字符串
{
    字符串 行 = "长度 = ";
    拼接到(行, 转字符串(字数));
    拼接到(行, " 个字 / 宽 ");
    拼接到(行, 转字符串(格数));
    拼接到(行, " 格");
    返回 行;
}

// 真正"改文字"的那几行都在这儿:等长替换 / 不等长替换 / 拼接 / 转大写
// (参数收进来的是**另一份** —— 字符串是值语义,这里改的是那份副本,改完整个交回去)
方法 改一次(字符串 原, 整数 号, 整数 次) 返回 字符串
{
    字符串 新 = 原;
    字符 字 = 'B';
    如果 (号 == 0)
    {
        如果 (次 % 3 == 1)
        {
            字 = 'C';
        }
        如果 (次 % 3 == 2)
        {
            字 = 'D';
        }
        新[1] = 字;                        // 等长替换:一个字符换一个字符
    }
    如果 (号 == 1)
    {
        新[0] = '中';                      // 不等长替换:1 字节换成 3 字节,后面的字自动往后挪
    }
    如果 (号 == 2)
    {
        拼接到(新, "-", 转字符串(次));    // 拼接:段数不限,接完长度当场就变
    }
    如果 (号 == 3)
    {
        新 = 转大写(新);                   // 库函数(string.hb):返回值要有变量接住
    }
    返回 新;
}

// 底下那一行说明:按"最后点下的那一格"选一句(还没点给开场白)
方法 说明文(整数 号) 返回 字符串
{
    字符串 文 = "点左边四格:右边那段文字会当场改一次,长度与宽度一起跟着变";
    如果 (号 == 0)
    {
        文 = "① 等长替换:当前[1] 换个新字符 —— 后面的字不用挪,长度也不变";
    }
    如果 (号 == 1)
    {
        文 = "② 不等长替换:当前[0] = '中' —— 1 字节换 3 字节,后面的字自动往后挪";
    }
    如果 (号 == 2)
    {
        文 = "③ 拼接:拼接到(当前, 短横线 + 序号) —— 段数不限,长度当场涨";
    }
    如果 (号 == 3)
    {
        文 = "④ 转大写:当前 = 转大写(当前) —— 库里的函数,返回值要有变量接住";
    }
    返回 文;
}

// 开窗之前先把状态那一行拼好(开窗之后只在"真改过"的那一刻重拼)
长度行 = 状态行(当前.长度(), 取文字宽度(当前));
说明行 = 说明文(-1);

逻辑 开着 = 打开窗口("示例07 字符串", 560, 330);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算它:四格按钮从 y=72 起、每格 40 像素、宽 170(x 从 12 到 182)。
        // 这一步**单独摆在这一层**,不塞进上面那串嵌套里(与 示例01 / 示例16 的"取点击"同一路数);
        // "真改一次"就在这一格里 —— 改完把状态两行重拼一遍,重画那一层只管画。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 12 && 点x < 182 && 点y >= 72 && 点y < 224)
            {
                点了 = (点y - 72) / 40;
                操作次 = 操作次 + 1;
                当前 = 改一次(当前, 点了, 操作次);
                长度行 = 状态行(当前.长度(), 取文字宽度(当前));
                说明行 = 说明文(点了);
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是现成的)----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 40, 0xFF2A3550);
            画文字(24, 16, "示例07 字符串:一段会变的文字 —— 怎么存 / 怎么改 / 怎么算", 0xFFE8E8F0);
            画文字(24, 34, "左边点一格 ⇒ 右边那段文字当场改一次(点过的那格有底色)", 0xFFB0B0B8);

            // 左边四格按钮:最后点过的那一格 + 鼠标正压着的那一格都有底色(先铺底、再画字)
            整数 序 = 0;
            当 (序 < 4)
            {
                整数 行y = 72 + 序 * 40;
                逻辑 亮 = 假;
                如果 (序 == 点了)
                {
                    亮 = 真;
                }
                如果 (鼠标x >= 12 && 鼠标x < 182 && 鼠标y >= 行y && 鼠标y < 行y + 32)
                {
                    亮 = 真;
                }
                如果 (亮)
                {
                    画矩形(12, 行y, 170, 32, 0xFF2A6EF0);
                }
                如果 (!亮)
                {
                    画矩形(12, 行y, 170, 32, 0xFF2A3550);
                }
                画文字(24, 行y + 8, 按钮[序], 0xFFE8E8F0);
                序 = 序 + 1;
            }

            // 右边那一块:窗口里"这一段文字"现在长什么样 + 它的长度与宽度
            画矩形(196, 72, 352, 152, 0xFF16161E);
            画文字(208, 82, "当前字符串(窗口里这一份)", 0xFF8A8A96);
            画矩形(208, 104, 328, 40, 0xFF23232E);
            画文字(220, 116, 当前, 0xFFE8E8F0);
            画文字(208, 156, 长度行, 0xFFD0D0D8);
            画文字(208, 182, "字符串是各有一份:赋一次、传一次都各自留底", 0xFF8A8A96);
            画文字(208, 204, "下标写回不等长也行;容量不够自动 ×2 翻倍", 0xFF8A8A96);

            画线(12, 236, 548, 236, 0xFF3C3C46);
            画文字(20, 248, 说明行, 0xFFE8E8F0);
            画文字(20, 272, "九小节:声明 · 长度 · 下标 · 比较 · 拼接 · 参数 · 结构 · 库函数", 0xFF8A8A96);
            画文字(20, 296, "上面那 33 段输出打在控制台里;窗口这一屏演的就是同一批字符串", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();
}

