// ============================================================
// 示例33_位与数学:G4 批 1 —— `位.hb`(32 位位运算)与 `数学.hb`(整数数学)
//
//   这一篇把两个"零依赖"的基础库连起来演示一遍:
//     · **`Sample\库\位.hb`** —— 查一位 / 置一位 / 清一位 / 翻一位、数一位、前导零、尾随零,
//       外加字节交换 / 半字拆拼 / 循环移位 / 掩码(14 个公开函数);
//     · **`Sample\库\数学.hb`** —— 绝对值 / 最大 / 最小 / 夹取、整数幂 / 整数开方、
//       最大公约数 / 最小公倍数、向上整除 / 正模 / 符号(11 个公开函数)。
//
//   三条口径(写这两个库时定下来的,演示里处处照它走):
//     ① **一律 32 位**:内建 `整数` 是 32 位有符号;位模式那一族用 **`无符号整数`**
//        (0~4294967295 —— 这样最高位不会显示成负数,右移也是逻辑右移);
//     ② **位数一律 0~31**(最低位是 0),越界**不报错**:`取位` 给 假、`置位 / 清位 / 翻位` 给原值、
//        循环移位按 `位数 % 32` 归一;
//     ③ **打印很大的无符号结果要先存进一个 `无符号整数` 变量**:`输出行(…)` 按表达式自己的类型打,
//        `输出行(位.掩码(32))` 会显示 -1 —— 写成 `无符号整数 全 = 位.掩码(32);` 再打就是 4294967295。
//
//   这一篇**不碰文件、不碰网络**:要看的全是数字,逐行对得上就行。
// ============================================================
包含 "../../库/位.hb"
包含 "../../库/数学.hb"

// ---------------- ① 一位一位地读改写:拿"读 / 写 / 执行"三枚权限位当例子 ----------------
无符号整数 权限 = 0;
权限 = 位.置位(权限, 0);                                   // 读
权限 = 位.置位(权限, 1);                                   // 写
输出行(权限);                                              // 3:低两位都立起来了
输出行(位.取位(权限, 0));                                  // 1:第 0 位是 1
输出行(位.取位(权限, 2));                                  // 0:第 2 位还没立
权限 = 位.翻位(权限, 2);                                   // 加上"执行"
输出行(权限);                                              // 7
权限 = 位.清位(权限, 1);                                   // 去掉"写"
输出行(权限);                                              // 5

// 越界那一档:不报错、不停机(取位给假、置位给原值)
输出行(位.取位(权限, 9));                                  // 0:第 9 位是 0
输出行(位.取位(权限, 40));                                 // 0:越界给假
无符号整数 没动 = 位.置位(权限, 40);                       // 越界:原样返回
输出行(没动);                                              // 5

// ---------------- ② 数一遍:有几个 1 / 前导零 / 尾随零 ----------------
无符号整数 图案 = 0xF0F0F0F0;
输出行(位.数一位(图案));                                   // 16:一半是 1
输出行(位.前导零(图案));                                   // 0:最高位就是 1
无符号整数 小 = 0x00010000;
输出行(位.前导零(小));                                     // 15
输出行(位.尾随零(小));                                     // 16
输出行(位.前导零(0));                                      // 32:0 的 32 个位全是 0

// ---------------- ③ 拆字节 / 拆半字 / 拼回去 ----------------
无符号整数 字 = 0x12345678;
输出行(位.字节交换(字));                                   // 2018915346 = 0x78563412
输出行(位.取高半字(字));                                   // 4660 = 0x1234
输出行(位.取低半字(字));                                   // 22136 = 0x5678
输出行(位.拼半字(4660, 22136));                            // 305419896:拼回原来那个字

// ---------------- ④ 循环移位与掩码 ----------------
无符号整数 环 = 位.循环左移(0x80000001, 1);
输出行(环);                                                // 3:最高位绕到最低位
环 = 位.循环右移(3, 1);
输出行(环);                                                // 2147483649:再绕回来
输出行(位.循环左移(字, 32) == 字);                         // 1:转 32 位等于没转
输出行(位.掩码(8));                                        // 255:低 8 位全 1
无符号整数 全 = 位.掩码(32);
输出行(全);                                                // 4294967295:32 位全 1

// ---------------- ⑤ 数学:夹取 / 幂 / 开方 ----------------
输出行(数学.绝对值(-7));                                   // 7
输出行(数学.夹取(120, 0, 100));                            // 100:压进上界
输出行(数学.夹取(-3, 0, 100));                             // 0:压进下界
输出行(数学.最大(3, 9));                                   // 9
输出行(数学.最小(3, 9));                                   // 3
输出行(数学.整数幂(2, 10));                                // 1024
输出行(数学.整数幂(2, 31));                                // -2147483648:到边界按 32 位回绕
输出行(数学.整数幂(7, -1));                                // 0:指数为负给 0
输出行(数学.整数开方(1000000));                            // 1000
输出行(数学.整数开方(10));                                 // 3:向下取整
输出行(数学.整数开方(-4));                                 // -1:负数没有整数平方根

// ---------------- ⑥ 除与余:两个负数口径各来一条 ----------------
输出行(数学.最大公约数(12, 18));                           // 6
输出行(数学.最大公约数(-12, 18));                          // 6:先取绝对值
输出行(数学.最小公倍数(4, 6));                             // 12
输出行(数学.向上整除(7, 2));                               // 4:商向 +∞ 取整
输出行(数学.向上整除(-7, 2));                              // -3:负数那一档截断正好就是向上取整
输出行(数学.向上整除(7, -2));                              // -3:除数为负走"先向下再取负"
输出行(数学.正模(-5, 3));                                  // 1:余数恒非负(而 -5 % 3 是 -1)
输出行(数学.符号(-9));                                     // -1
输出行(数学.符号(0));                                      // 0
输出行(数学.符号(9));                                      // 1

// ---------------- ⑦ 两个库凑一件真事:七枚标记位打包成一个数,再逐个读出来 ----------------
无符号整数 标记 = 0;
整数 天 = 0;
当 (天 < 7)
{
    标记 = 位.置位(标记, 天);                              // 七天全立起来
    天 = 天 + 1;
}
输出行(标记);                                              // 127
输出行(位.数一位(标记));                                   // 7
标记 = 位.清位(标记, 3);                                   // 第 4 天关掉
输出行(标记);                                              // 119
输出行(位.数一位(标记));                                   // 6
输出行(位.取位(标记, 3));                                  // 0
输出行(数学.向上整除(10, 7));                              // 2:十天算两周
输出行(数学.正模(10, 7));                                  // 3:十天落在一周的第 3 天

// 预期输出: 3|1|0|7|5|0|0|5|16|0|15|16|32|2018915346|4660|22136|305419896|3|2147483649|1|255|4294967295|7|100|0|9|3|1024|-2147483648|0|1000|3|-1|6|6|12|4|-3|-3|1|-1|0|1|127|7|119|6|0|2|3
