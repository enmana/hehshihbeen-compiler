// ============================================================
// 示例17:排序与查找(库 `Sample\库\排序.hb` + `Sample\库\查找.hb`)
//
//   要解决的事:HB 有数组 / 列表,但"把一张表排好"和"在表里找东西"以前都得手写
//   (示例里有手写冒泡)。这两个库补上它们,写中型项目时不用每次都重抄一遍。
//
//   本示例演示:
//     ① 整数升序 / 降序:插入排序,**就地**改调用方那张表(数组参数传"地址 + 长度")
//     ② 稳定性:相等的元素保持原来的先后(按键排序里两个 1 键的顺序能看出来)
//     ③ 部分升序:只要最小的前 k 个就位(选择排序跑 k 轮,整表不必排完)
//     ④ 按键排序:键决定次序,值跟着键一起走(值和键还是一对)
//     ⑤ 线性找:不要求有序;二分找:表必须先升序,表没序也不报错、只是可能找不到
//     ⑥ 是升序:二分找的护栏(先问一句再二分)
//     ⑦ 第k小:乱序表也照算,内部复制一份,**不动调用方那张表**;k 越界给 假 且不动 `收值`
//     ⑧ 最大最小:一趟走完拿两个值(比"排一遍再取两头"省)
//
//   两条边界(库文件头写清了,这里也点一句):
//     · 两个库只收**固定数组**(`整数 表[8]`);动态**列表**现在传不了(语言层明文禁止取列表地址);
//     · 字符串表排序这一版没有:`字符串 表[]` 这种参数形态语言面还不收。
// ============================================================
包含 "../../库/排序.hb"
包含 "../../库/查找.hb"
包含 "../../库/string.hb"          // UI 那一段要 `格式化`(把数字拼进文字)—— 放文件头,与 示例07 / 示例20 一样

// 把一张整数表逐行打出来(每行一个;文件末尾那行对账数据按行比)
方法 打印表(整数 表[])
{
    整数 i = 0;
    当 (i < 表.长度())
    {
        测试输出(表[i]);
        i = i + 1;
    }
    返回
}

// ① 升序 / 降序:排完就是原来那张表
整数 数[8] = [5, 2, 9, 2, 7, 1, 8, 3];
打印表(数);                       // 原样
排序.整数升序(数);
打印表(数);                       // 1 2 2 3 5 7 8 9
测试输出(查找.是升序(数));        // 1
排序.整数降序(数);
打印表(数);                       // 9 8 7 5 3 2 2 1

// ③ 部分升序:只要前 3 小(其余次序不作保证)
整数 待排[6] = [40, 10, 30, 20, 50, 0];
排序.部分升序(待排, 3);
打印表(待排);                       // 0 10 20 30 50 40

// ④ 按键排序:值跟着键走;两个 1 键保持原来的先后(稳定)
整数 值[5] = [100, 200, 300, 400, 500];
整数 键[5] = [3, 1, 2, 1, 3];
排序.按键排序(值, 键);
打印表(键);                       // 1 1 2 3 3
打印表(值);                       // 200 400 300 100 500(键 1 的两个:200 在前、400 在后)

// ⑤ 线性找 / 二分找
整数 序[7] = [1, 3, 5, 7, 9, 11, 13];
测试输出(查找.线性找(序, 7));     // 3
测试输出(查找.线性找(序, 8));     // -1
测试输出(查找.二分找(序, 1));     // 0
测试输出(查找.二分找(序, 13));    // 6
测试输出(查找.二分找(序, 8));     // -1

// ⑥ 是升序:乱序表给 假(二分之前先问一句就不会白找)
整数 乱[3] = [3, 1, 2];
测试输出(查找.是升序(乱));        // 0

// ⑦ 第k小:k 从 1 开始;乱序表也能算,而且不动原表
整数 收 = 0;
测试输出(查找.第k小(序, 4, 收));  // 1
测试输出(收);                     // 7(1 3 5 [7] 9 11 13 里第 4 小)
测试输出(查找.第k小(乱, 2, 收));  // 1
测试输出(收);                     // 2
测试输出(乱[0]);                  // 3(原表一个字节没动)
收 = 7;
测试输出(查找.第k小(序, 0, 收));  // 0(k 越界)
测试输出(收);                     // 7(假的时候不动 收值)
测试输出(查找.第k小(序, 8, 收));  // 0(k 比表长还大)

// ⑧ 最大最小:一趟拿两个
整数 大 = 0;
整数 小 = 0;
测试输出(查找.最大最小(乱, 大, 小));  // 1
测试输出(大);                        // 3
测试输出(小);                        // 1

// ============================================================
// H82 批 5:窗口那一半 —— 把"一轮一轮排过去"演出来(上面的计算与断言一行没动)
//
//   上半 = 部分升序逐轮:每帧放好一个,蓝底那一格就是**这一轮刚就位的**;
//   中间 = 同一轮的直方图(柱高 = 值 × 2 像素);
//   下半 = 查找那几条的**真结果**(开窗前现问库要的,不是抄下来的常数);
//   点上面任意一格 / 任意一根柱子 ⇒ 底下那行换成"第几格 · 值"。
//
//   写法照 `Sample\说明.md`《带 UI 的示例怎么写》那一节:开窗前把要画的文字**全部拼好**,
//   主循环里一条字符串都不拼(每帧现拼几十块 = 几秒就把池撑爆,§25 有实测)。
//   三个坑绕开走:① 字符串数组元素**当不了赋值右值**(H87)⇒ 状态行拆成"前缀 + 值"两段画;
//   ② 循环体里**不留声明** ⇒ 下标全用顶层那几格(复 / 位 / 平 / 高);
//   ③ 二维元素读、下标算式、`格式化(...)` **一样占临时寄存器** ⇒ 一层循环里只放一个,先落格再用。
// ============================================================

// ---- 一、七轮快照:第 0 轮 = 原表次序,第 k 轮 = 最小的 k 个已就位(用的是库里的 部分升序)----
整数 原表[6] = [40, 10, 30, 20, 50, 0];    // 与上面那张 `待排` 同源 —— 上面那张已经被排过了,这份是干净的
整数 临[6];
整数 快照[7][6];
整数 复 = 0;
整数 位 = 0;
整数 平 = 0;
整数 高 = 0;
当 (复 <= 6)
{
    位 = 0;
    当 (位 < 6)
    {
        临[位] = 原表[位];
        位 = 位 + 1;
    }
    如果 (复 > 0)
    {
        排序.部分升序(临, 复);
    }
    位 = 0;
    当 (位 < 6)
    {
        快照[复][位] = 临[位];
        位 = 位 + 1;
    }
    复 = 复 + 1;
}

// ---- 二、要画的文字(全在开窗前拼好)----
//   ① 值文字只拼 **6 条**:表里就这六个数(0 / 10 / 20 / 30 / 40 / 50)⇒ 用 `值 / 10` 当下标取;
//   ② 格号 6 条;③ 每一轮那句话 7 条。
字符串 值文[6];
字符串 号文[6];
字符串 轮文[7];
字符串 暂 = "";
复 = 0;
当 (复 < 6)
{
    平 = 复 * 10;
    暂 = 格式化("{0}", 平);
    值文[复] = 暂;
    暂 = 格式化("{0}", 复);
    号文[复] = 暂;
    复 = 复 + 1;
}
复 = 0;
当 (复 <= 6)
{
    如果 (复 == 0)
    {
        暂 = "第 0 轮:原表次序(一个都还没就位)";
    }
    否则
    {
        暂 = 格式化("第 {0} 轮:最小的那几个已经就位", 复);
    }
    轮文[复] = 暂;
    复 = 复 + 1;
}

// ---- 三、查找那几条的真结果(开窗前现问库;上面那几条断言比的就是同一批调用)----
整数 答线 = 查找.线性找(序, 7);
整数 答二 = 查找.二分找(序, 13);
整数 答空 = 查找.二分找(序, 8);
整数 答序 = 查找.是升序(乱);
字符串 查一 = 格式化("线性找(序, 7) = {0}(不要求有序)", 答线);
字符串 查二 = 格式化("二分找(序, 13) = {0};找没有的 8 给 {1}", 答二, 答空);
字符串 查三 = 格式化("是升序(乱表) = {0}:二分之前先问一句就不会白找", 答序);
字符串 查四 = 格式化("乱表最大 {0} / 最小 {1}(一趟走完拿两个)", 大, 小);

// ---- 四、窗口自己要记住的那几格(状态行 / 轮次 / 点击)----
整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;
整数 点y = 0;
整数 选中 = -1;
整数 选平 = 0;
整数 轮次 = 0;
逻辑 有一下 = 假;
字符串 状态头 = "点上面任意一格 / 任意一根柱子 ⇒";
字符串 尾一 = "底色:蓝 = 这一轮刚就位的那一格,深绿 = 前面几轮已经就位的";
字符串 尾二 = "ESC 或关窗退出:窗口一直转到你自己关";

逻辑 开着 = 打开窗口("示例17 排序与查找", 560, 620);
如果 (开着)
{
    逻辑 收手 = 假;
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                如果 (类型 == 5)
                {
                    有一下 = 真;               // 抬起 = "点一下"落地(照 示例03/16 那一套)
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
                否则
                {
                    如果 (键码 == 27)
                    {
                        收手 = 真;             // ESC 也收手
                    }
                }
            }
        }

        // 点击结算**单独摆一层**(塞进上面那串嵌套里实测不落地):上半那排格子与中间那排柱子各算一次。
        // 两块命中区**不重叠**(格子 y 104~148、柱子 y 236~342)⇒ 踩不到"谁写在后面谁赢"那条坑。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点y >= 104 && 点y < 148 && 点x >= 24 && 点x < 24 + 6 * 86)
            {
                选中 = (点x - 24) / 86;
            }
            如果 (点y >= 236 && 点y < 342 && 点x >= 30 && 点x < 30 + 6 * 86)
            {
                选中 = (点x - 30) / 86;
            }
            如果 (选中 == 0)
            {
                状态头 = "选中 第 0 格,值 =";
            }
            如果 (选中 == 1)
            {
                状态头 = "选中 第 1 格,值 =";
            }
            如果 (选中 == 2)
            {
                状态头 = "选中 第 2 格,值 =";
            }
            如果 (选中 == 3)
            {
                状态头 = "选中 第 3 格,值 =";
            }
            如果 (选中 == 4)
            {
                状态头 = "选中 第 4 格,值 =";
            }
            如果 (选中 == 5)
            {
                状态头 = "选中 第 5 格,值 =";
            }
        }

        如果 (!收手)
        {
            // 选中的那一格要取"这一轮"的值 ⇒ 摊平下标每帧现算(值文字本身是开窗前拼好的)
            如果 (选中 >= 0)
            {
                高 = 快照[轮次][选中];
                选平 = 高 / 10;            // 值文字按 `值 / 10` 取(见上面第2节)
            }

            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼)----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 40, 0xFF2A3550);
            画文字(24, 16, "示例17 排序与查找:部分升序一轮放好一个", 0xFFE8E8F0);
            画文字(24, 34, "上面那排 = 这一轮的表;中间 = 同一轮的直方图", 0xFFB0B0B8);

            // 上半:六格(⚠ 底色一律画在文字**之前** —— 反了就把那一格的数字盖掉)
            画矩形(12, 64, 536, 130, 0xFF16161E);
            画文字(24, 74, 轮文[轮次], 0xFF9CC4FF);
            位 = 0;
            当 (位 < 6)
            {
                如果 (位 < 轮次)
                {
                    画矩形(24 + 位 * 86, 104, 80, 44, 0xFF1E4A2E);       // 前面几轮已经就位的
                }
                否则
                {
                    画矩形(24 + 位 * 86, 104, 80, 44, 0xFF232B3E);
                }
                如果 (位 == 轮次 - 1)
                {
                    画矩形(24 + 位 * 86, 104, 80, 44, 0xFF2A6EF0);       // 这一轮刚就位的那一格
                }
                平 = 快照[轮次][位] / 10;
                画文字(24 + 位 * 86 + 34, 118, 值文[平], 0xFFE8E8F0);
                画文字(24 + 位 * 86 + 36, 152, 号文[位], 0xFF8A8A96);    // 格号
                位 = 位 + 1;
            }

            // 中间:直方图(柱高 = 值 × 2 像素;柱子底部都在 y = 340)
            画矩形(12, 202, 536, 150, 0xFF16161E);
            画文字(24, 210, "直方图:这一轮的值(柱高 = 值 × 2 像素)", 0xFF9CC4FF);
            位 = 0;
            当 (位 < 6)
            {
                平 = 快照[轮次][位] / 10;
                高 = 快照[轮次][位] * 2;      // 同上:二维元素读先落一格,画矩形那一句才装得下
                画矩形(30 + 位 * 86, 340 - 高, 40, 高 + 2, 0xFF2A6EF0);
                画文字(30 + 位 * 86 + 14, 346, 值文[平], 0xFFD0D0D8);
                位 = 位 + 1;
            }

            // 下半:查找(开窗前现问库要的那几条)
            画矩形(12, 364, 536, 130, 0xFF16161E);
            画文字(24, 372, "查找:下面四条是开窗前现问库要的", 0xFF9CC4FF);
            画文字(24, 396, 查一, 0xFFD0D0D8);
            画文字(24, 418, 查二, 0xFFD0D0D8);
            画文字(24, 440, 查三, 0xFFD0D0D8);
            画文字(24, 462, 查四, 0xFFD0D0D8);

            // 状态行:前缀 + 值两段分开画(字符串数组元素当不了赋值右值 —— H87)
            画矩形(12, 504, 536, 34, 0xFF232B3E);
            画文字(24, 513, 状态头, 0xFFE8E8F0);
            如果 (选中 >= 0)
            {
                画文字(300, 513, 值文[选平], 0xFF9CC4FF);
            }
            画文字(24, 550, 尾一, 0xFF8A8A96);
            画文字(24, 572, 尾二, 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(240);                             // 让出一帧、别把 CPU 烧满(无头不真等)

            // 逐帧推进:0 → 6 轮走一遍,再绕回第 0 轮
            轮次 = 轮次 + 1;
            如果 (轮次 > 6)
            {
                轮次 = 0;
            }
        }
    }

    关闭窗口();
}

