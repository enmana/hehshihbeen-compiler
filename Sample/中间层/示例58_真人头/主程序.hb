// ============================================================
// 示例58_真人头(半身像)—— 开窗转着看
//
//   素材:网盘那份 `A2763` 大模型(`all in one.obj`,375 MB / 227 万顶点 / 543 万三角 / 6 角色 × 8 件)
//   经"取件 + **按平面裁** + 减面 + 统一归一化"拼成一份:`Sample\模型\人头肩\头肩.obj`
//   —— **实测 813 顶点 / 2520 边 / 1821 面**(用 `模型.要几条` 量出来的实数)。
//
//   ★ 这一版是"**只做头肩**"之后的写法:上一版是**全身站像**,
//     一整个身子只有 424 顶点 ⇒ 摊到脸和头发上只剩几十个三角,减面之后糊成"一簇毛球"。
//     改成半身像之后,同一个档位里**面数全给脸和头发**,五官与发型的形状就立起来了:
//     一帧实测 **画了 779 面**(背面剔 724)、覆盖 **107577 像素**、明暗 **295~988**。
//     裁剪面与做法记在 `工具\模型工具\README.md` §7(上留头发、下到胸口、两侧切掉横出去的手臂)。
//
//   ⚠ 三条"必须知道"的口径:
//     ① **宿主会把读到的顶点归一化**(包围盒居中 + 最长边缩到 2 个单位)—— 这一份的**最长边是竖着的那条**
//        (身高方向),所以 y 正好铺满 -1 ~ 1;
//     ② **堆要够**:这一份实测落在**三档**(1300 / 4500 / 2600 ⇒ 82.8 KB),
//        工程文件里写的 `"堆": "256KB"` 绰绰有余;不带工程直接 `hbcc 主程序.hb --run` 会在
//        默认 64 KB 上先报"申请失败"(那是堆的问题,人话里给了改法);
//     ③ **两个跑法都验过**:虚拟机与原生(`--run --跑法 原生`)读数一字不差。
//
//   ⚠ 如实记三条(素材本身的限制,不是缺陷):
//     · **没有骨骼 / 蒙皮 / 动画**(`.obj` 与那份 `.fbx` 里 `LimbNode` 搜到 0 次)⇒ 只能整体转;
//     · 贴图在 `FBX.zip` 里(每角色三张 3000×4000),但是**贴图集**(约 19% 有像素),
//       而 HB 没有 UV 采样 ⇒ 这一份用的是**从贴图上取的代表色**(单色);
//     · 减面是"顶点聚类 + 平滑":半身像这一档留得住轮廓、发型与明暗,五官仍然只有大形。
// ============================================================

包含 "../../库/三维数学.hb"
包含 "../../库/三维网格.hb"
包含 "../../库/模型.hb"

无符号整数 肤色 = 4292335136;

// ① 读 + 装(一句:内部先只读探查量规模、再挑档、不够就升档)
//   ⚠ **路径给两个候选**(第415批):标准示例的数据路径按**仓库根**写
//   (`引擎\仓库根C.cs` 那条口径);双击工程目录里的 .exe 时当前目录是工程目录 ⇒ 第二条接上。
逻辑 进来没 = 模型.装进网格("Sample/模型/人头肩/头肩.obj");
如果 (!进来没)
{
    进来没 = 模型.装进网格("../../模型/人头肩/头肩.obj");
}
测试输出(进来没);
测试输出(模型.顶点数());
测试输出(模型.面数());
如果 (进来没 == 假)
{
    输出行(模型.上次错());
    输出行(模型.要几颗顶点());
    输出行(模型.要几条边());
    输出行(模型.要几个面());
    输出行(模型.大档有多少颗());
    输出行(模型.大档有多少条());
    输出行(模型.大档有多少个());
    停止
}

// ② 相机 + 开窗
//   ⚠ 相机这三个数**要按这一份模型算**(实测口径,别照抄别的演示):
//     · 投影比例 = **焦距 / 眼距**;这一份实测 **y 跨度 2.0**,而**头那一块只有 0.30**
//       ⇒ 比例要**比"铺满整幅"再大一档**才看得清脸:取 **400**(眼距 8.0 / 焦距 3200);
//     · 画心取 **(320, 330)**(窗口 640 × 760 的正中略偏低,给标题留出上方);
//     · 这一档实测:整个人占 **x 52~489 · y -47~664**(上边那 47 像素是头发顶,故意让它顶到框边),
//       头那一块占 **约 273 × 252 像素**;
//     · ⚠ 早先抄的"眼距 3.2 / 焦距 300"比例只有 94 ⇒ 整幅只占正中一小块,
//       看着就像"模型没加载出来"(那是量出来的第一个坑)。
//   ⚠ **起始偏航角要按素材的坐标朝向定**:这一份的 x 轴是"前后"向(人是侧着躺在坐标里的),
//     所以偏航 0° 看到的是侧脊;实测**偏航 1.8 弧度**(约 103°)时脸正对镜头 ——
//     判据是**两只眼的屏幕横向距离**:眼那一件是竖着一条薄片,偏航 90° 时正好被看扁(0.003),
//     0° / 180° 时最宽(0.107)⇒ 1.8 弧度正落在"五官最展开"那一段上。
三维网格.眼距 = 8.0;
三维网格.焦距 = 3200.0;
三维网格.画心x = 320.0;
三维网格.画心y = 330.0;

逻辑 开着 = 打开窗口("HB 真人头(半身像 · 减面 1821 面)—— 转着看", 640, 760);
如果 (开着)
{
    浮点 转角 = 1.8;      // 起始偏航:约 103°(这份素材的 x 轴是"前后"向 ⇒ 要转过 90° 才正对镜头)
    整数 帧 = 0;
    整数 类型 = 0;
    整数 键码 = 0;
    整数 鼠x = 0;
    整数 鼠y = 0;
    逻辑 还开着 = 真;
    // ⚠ **转到用户自己关窗**(第418批撤掉 `帧 < 4000` 那道上限;理由见 示例56 那一处)
    当 (还开着)
    {
        三维网格.摆角(0.14, 转角, 0.0);
        清屏(0xFF0C0C12);
        整数 画了几面 = 三维网格.画实心带光(肤色);   // 背面自动剔(`网格不剔除` 默认假)
        如果 (帧 == 0)
        {
            测试输出(画了几面);
            测试输出(三维网格.上次面积负);
            测试输出(三维网格.上次覆盖像素);
            测试输出(三维网格.上次亮最小);
            测试输出(三维网格.上次亮最大);
        }
        画文字(8, 8, "真人头(半身像 · 减面 1821 面)· 背面已剔", 0xFFFFFFFF);
        画文字(8, 24, "ESC 或关窗退出", 0xFF8090A0);
        刷新();
        转角 = 转角 + 0.02;
        帧 = 帧 + 1;
        当 (取事件(类型, 键码, 鼠x, 鼠y))
        {
            如果 (类型 == 1 || 键码 == 27)
            {
                还开着 = 假;
            }
        }
        等待(14);
    }
    关闭窗口();
}
模型.清掉();
停止
