// ============================================================
// 示例56_读OBJ模型:把外部模型(Wavefront `.obj`)读进来画线框(R4-11)
//
//   这一篇演示的是**"几何外包"这条路**:HB 自己不去捏几何,而是
//   读一份别人做的 `.obj`(MakeHuman 开源 CC0 / Blender 自己捏 / 别的工具),
//   然后 HB 侧只干它擅长的事 —— 变换 / 投影 / 每帧画。
//
//   一条能力搞定导入:
//     读取模型(路径, 顶点块, 边块, 顶点上限, 边上限, 条数块) → 逻辑
//     · 块是 `申请(字节数)` 拿到的地址:顶点每颗 12 字节(三个单精度 x,y,z),
//       边每条 8 字节(两个整数下标);
//     · 条数块三格:`取字(条数块, 0)` 顶点数 / `+4` 边数 / `+8` 状态码
//       (0 成功 / 1 打不开 / 2 不是 OBJ / 3 装不下);
//     · **读进来时自动归一化**:包围盒中心对到原点、最长边缩到 2 个单位
//       —— 所以下面相机用"小模型那档"(眼距 6 / 焦距 500),不用按模型的原始单位配。
//
//   ⚠ 换真模型只改一行:`模型路径` 指到你自己的 `.obj`。
//     ⚠ 上限也要跟着改:一个几万面的模型,顶点块要 `申请(顶点数×12)`、
//       边块要 `申请(边数×8)` —— `申请` 失败会当场停下,别写太小。
// ============================================================
包含 "../../库/三维数学.hb"
包含 "../../库/三维网格.hb"

// ---- 要读的模型(改这一行就能换模型)----
//   ⚠ **路径按"当前工作目录"算**(不是相对源文件)⇒ 这一份给**两个候选**:
//     ① 仓库根那一条(`Sample/模型/…`)—— IDE 里跑、命令行在仓库根跑都走它;
//     ② 工程目录那一条(`../../模型/…`)—— **双击工程目录里的 .exe** 时当前目录是工程目录,
//        头一条落空、这一条接上(第415批补:以前只有 ①,双击 exe 那条腿上模型读不到,
//        窗口里空无一物)。
//   ⚠ 两个上限**必须是编译期数字**(写死在调用里):`申请` 与 `读取模型` 都要求常量。
//   换大模型时把这四个数一起改大(顶点块 = 顶点上限×12 字节、边块 = 边上限×8 字节)。
字符串 仓库根路径 = "Sample/模型/球带面.obj";
字符串 工程目录路径 = "../../模型/球带面.obj";

// ---- 三个块:顶点 / 边 / 面(R4-14 加面:实心渲染要它) / 条数 ----
地址 顶点块 = 申请(400 * 12);      // 最多 400 颗顶点
地址 边块 = 申请(1200 * 8);        // 最多 1200 条边
地址 面块 = 申请(1600 * 12);       // 最多 1600 个三角面(球带面.obj 是 280 个)
地址 条数块 = 申请(16);            // 四格:顶点数 / 边数 / 面数 / 状态码

整数 模型顶点数 = 0;
整数 模型边数 = 0;
整数 模型面数 = 0;
逻辑 读成了 = 读取模型(仓库根路径, 顶点块, 边块, 面块, 400, 2000, 1600, 条数块);
如果 (!读成了)
{
    读成了 = 读取模型(工程目录路径, 顶点块, 边块, 面块, 400, 2000, 1600, 条数块);
}
如果 (读成了)
{
    模型顶点数 = 整数(取字(条数块, 0));
    模型边数 = 整数(取字(条数块, 4));
    模型面数 = 整数(取字(条数块, 8));
    测试输出(模型顶点数);
    测试输出(模型边数);
}
否则
{
    // 没读进来:状态码说清是哪一档(1 打不开 / 2 不是 OBJ / 3 装不下)
    测试输出(0 - 整数(取字(条数块, 8)));
}

// ---- 装进网格(装进去的才是能画的)----
//   ⚠ 这里用 `清空()`(只归零计数)而**不是** `清数组()`(慢慢擦两万八千个格子):
//   擦干净的代价是每帧前的几万条指令,而这一份要开窗转着画 ⇒ 用不起。
//   后果是"没读过的格子"里留着残值 —— 对逐字节对拍不友好(记在 `未做任务清单.md`),但**不影响画面**。
三维网格.清空();
测试输出(整数(取字(条数块, 0)));     // 现场再读一次顶点数(定位用)
测试输出(整数(取字(顶点块, 0)));      // 顶点块第一格(1.0 的位模式 = 1065353216)
整数 装了几个 = 三维网格.装顶点(顶点块, 模型顶点数);
整数 装了几条 = 三维网格.装边(边块, 模型边数);
整数 装了几个面 = 三维网格.装面(面块, 模型面数);
测试输出(装了几个面);
测试输出(装了几个);
测试输出(装了几条);

// ---- 画:归一化之后模型最长边 = 2 ⇒ 相机改小模型那档 ----
三维网格.眼距 = 3.0;
三维网格.焦距 = 300.0;
三维网格.画心x = 240.0;
三维网格.画心y = 260.0;

无符号整数 基色 = 4290705640;
三维网格.眼距 = 3.0;
三维网格.焦距 = 300.0;
逻辑 开着 = 打开窗口("HB 读 OBJ —— 实心 + 光照", 480, 520);
如果 (开着)
{
    浮点 转角 = 0.0;
    整数 帧 = 0;
    整数 类型 = 0;
    整数 键码 = 0;
    整数 鼠x = 0;
    整数 鼠y = 0;
    逻辑 还开着 = 真;
    // ⚠ **转到用户自己关窗**(第415批撤掉了 `帧 < 4000` 那道上限):
    //   硬规矩 7 的口径是"窗口循环转到用户自己关窗";有上限就会到点自己关,
    //   看着像"程序一闪就没了"(实测 4000 帧那道上限在慢机器上几十秒就走到)。
    //   自检那条腿靠**事件脚本**投"关窗请求"收手(见同目录 `事件脚本.txt`),不靠帧数上限。
    当 (还开着)
    {
        // 两个轴一起转,才看得出这是个立体(只绕 y 转看着像纸片)
        三维网格.摆角(0.35, 转角, 0.0);
        清屏(0xFF0C0C12);
        整数 画了 = 三维网格.画实心带光(基色);   // R4-14:实心 + 光照(面是从 .obj 读来的)
        如果 (帧 == 0)
        {
            测试输出(画了);
            测试输出(三维网格.上次扫描线);
            测试输出(三维网格.上次覆盖像素);
        }
        画文字(8, 8, "读 OBJ —— 实心 + 光照", 0xFFFFFFFF);
        画文字(8, 24, "ESC 或关窗退出", 0xFF8090A0);
        刷新();
        转角 = 转角 + 0.02;
        帧 = 帧 + 1;
        当 (取事件(类型, 键码, 鼠x, 鼠y))
        {
            如果 (类型 == 1 || 键码 == 27)
            {
                还开着 = 假;
            }
        }
        等待(14);
    }
    关闭窗口();
}

释放(顶点块);
释放(边块);
释放(条数块);
停止
