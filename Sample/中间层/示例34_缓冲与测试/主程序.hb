// ============================================================
// 示例34_缓冲与测试:G4 批 2 —— `缓冲.hb`(字符串构建器)· `测试助手.hb` · `错误.hb`
//
//   三个都是零依赖的支撑库,合起来讲一件完整的事:**写一份报表 → 拿断言验它 → 出错时给人话**。
//     · **`Sample\库\缓冲.hb`** —— 往**堆**里一块一块加字节,最后 `取值` 成型一次成字符串:
//       循环里 `加 / 加整数 / 加行` 一个池临时串都不产生(这是"别把 32KB 池拼爆"的那一半);
//     · **`Sample\库\测试助手.hb`** —— 语言里**没有直接写法**的那几种比较(整表比 / 容差比 / 子串包含)
//       与"把一张表写成 `[3, 1, 4, 1]` 给人看";**报行号那一半是语言内建的 `测试 / 断言`**;
//     · **`Sample\库\错误.hb`** —— 编译器那套状态码(0 / 2 / 22 …)的名字与说法,按名字比、按码打人话。
//
//   三条口径(写这三个库时定下来的,演示里照它走):
//     ① **缓冲不自动长**:装满了 `加*` 一律给 -1 —— 要更大就 `建` 得宽一点,或者 `重置` 了重用;
//     ② **一切按字节算**:容量 / 字节数 / 返回值都是字节数(不是 `.长度()` 那种"文字数");
//     ③ **库函数返回 `逻辑`,由 `断言` 报行号** —— 库自己报的话,行号会落在库文件里,没用。
//
//   这一篇不碰文件、不碰网络:要看的全是打印出来的字。
// ============================================================
包含 "../../库/缓冲.hb"
包含 "../../库/测试助手.hb"
包含 "../../库/错误.hb"

// ---------------- ① 拼一份小报表:中间数据全在堆里 ----------------
地址 本 = 缓冲.建(256);
输出行(缓冲.容量(本));                                    // 256
输出行(缓冲.加行(本, "=== 本月小结 ==="));                 // 21
输出行(缓冲.加(本, "条目 "));                              // 28
输出行(缓冲.加整数(本, 17));                               // 30
输出行(缓冲.加(本, " 条,合计 "));                          // 42
输出行(缓冲.加整数(本, -1234));                            // 47
输出行(缓冲.加行(本, " 分"));                              // 52
输出行(缓冲.加字符(本, '-'));                              // 53
输出行(缓冲.加字符(本, '-'));                              // 54
输出行(缓冲.加行(本, ""));                                 // 55
输出行(缓冲.字节数(本));                                   // 55
输出行(缓冲.剩余(本));                                     // 201
字符串 报表 = 缓冲.取值(本);                               // 成型一次(池里只多这一个串)
输出(报表);
输出行(报表.长度());                                       // 文字数(不是字节数)
输出行(缓冲.重置(本));                                     // 1
输出行(缓冲.字节数(本));                                   // 0

// ---------------- ② 放不下那一档:给 -1,不报错、不停机 ----------------
地址 小 = 缓冲.建(8);                                      // 容量按最小一格 16 给
输出行(缓冲.容量(小));                                     // 16
输出行(缓冲.加(小, "0123456789abcdef"));                   // 16(正好装满)
输出行(缓冲.剩余(小));                                     // 0
输出行(缓冲.加(小, "还有"));                               // -1:装不下
输出行(缓冲.加整数(小, 7));                                // -1
输出行(缓冲.加行(小, ""));                                 // -1(文本 0 字节进得去,换行没地方)
输出行(缓冲.销毁(本));                                     // 1
输出行(缓冲.销毁(小));                                     // 1

// ---------------- ③ 拿断言验它:整表比 / 容差比 / 子串包含 ----------------
整数 原表[4] = [3, 1, 4, 1];
整数 同表[4] = [3, 1, 4, 1];
整数 异表[4] = [3, 1, 4, 2];
测试 表与容差
{
    断言 测试助手.表相等(原表, 同表);
    断言 测试助手.表相等(原表, 异表) == 假;
    断言 测试助手.表近似(原表, 异表, 1);
    断言 测试助手.表近似(原表, 异表, 0) == 假;
    断言 测试助手.近似(100, 103, 3);
    断言 测试助手.字符串包含("合计 1234 分", "1234");
    断言 测试助手.字符串包含("合计 1234 分", "5678") == 假;
}
输出行(测试助手.表文字(原表));                               // [3, 1, 4, 1]
输出行(测试助手.表文字(异表));                               // [3, 1, 4, 2]

// ---------------- ④ 出错时给人话:状态码的名字与说法 ----------------
输出行(错误.无错);                                         // 0
输出行(错误.是否成功(0));                                  // 1
整数 状态 = 错误.打不开;
输出行(状态);                                              // 2
输出行(错误.说明(状态));                                   // 打不开:…
输出行(错误.是否成功(状态));                               // 0
输出行(错误.说明(错误.句柄无效));                          // 句柄无效:…
输出行(错误.说明(99));                                     // 未知状态码(99)

// 预期输出: 256|21|28|30|42|47|52|53|54|55|55|201|=== 本月小结 ===|条目 17 条,合计 -1234 分|--|35|1|0|16|16|0|-1|-1|-1|1|1|测试 表与容差:共 7 条断言,失败 0 条|[3, 1, 4, 1]|[3, 1, 4, 2]|0|1|2|打不开:文件 / 目录不在,或者路径上缺目录|0|句柄无效:这个句柄没开过 / 已经关了 / 已经作废|未知状态码(99)

