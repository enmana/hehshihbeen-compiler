// ============================================================
// 示例57_消息与状态机 —— G4 批 22 的两个库一起演一遍(控制台,不开窗)
//
//   ① **消息 / 发布订阅**(`Sample\库\消息.hb`):订阅 / 发布 / 退订三件事各有确定的返回;
//      库**真的替你把处理函数存下来并调过去**(这是本库与 `事件.hb` 那条过渡版最大的不同 ——
//      `事件.hb` 写的时候库一律不收 `回调` 形参,那时记的账是 H86;本库靠"每个函数的回调形参
//      各起一个不同的名字"绕开了它,判据在自检分组 `消息与状态机库`)。
//   ② **状态机**(`Sample\库\状态机.hb`):把"一坨如果"变成一张**写死的转移表** ——
//      建 / 设转移 / 喂三个动作;没设过的格子 = "什么都不做"(原地不动,不报错)。
//   ③ 两者接在一起:**状态机的每一次转移发一条消息**,处理函数收下来 —— 这就是"事件驱动的骨架"
//      最小的一份(模块之间不互相认识,只认识主题)。
//
//   ⚠ 这一份**只用整数与字符串字面量**输出(每行一个小标签 + 一个数),不引入 `string.hb`
//     那种"数字转文字"的依赖 —— 示例要能一眼看懂、期望值要能逐行对。
//   判据:文件末尾那一行期望输出(`|` 分段)逐段可对 —— 自检按它回归,
//   `hbcc -p <这个目录> --run` 也能直接看。
// ============================================================

包含 "../../库/消息.hb"
包含 "../../库/状态机.hb"

// ---- 两个处理函数:签名是 `(整数 号, 整数 值)` ----
整数 首订阅收到 = 0;
整数 次订阅收到 = 0;

方法 首订阅收下(整数 号, 整数 值)
{
    首订阅收到 = 首订阅收到 + 1;
    输出行("首订阅收到 号");
    输出行(号);
    输出行("首订阅收到 值");
    输出行(值);
    返回
}

方法 次订阅收下(整数 号, 整数 值)
{
    次订阅收到 = 次订阅收到 + 1;
    输出行("次订阅收到 号");
    输出行(号);
    输出行("次订阅收到 值");
    输出行(值);
    返回
}

// ---- 状态机的两个处理函数:签名是 `(整数 旧, 整数 新)` ----
方法 进了运行(整数 旧, 整数 新)
{
    输出行("状态转移 旧");
    输出行(旧);
    输出行("状态转移 新(开始运行)");
    输出行(新);
    // ③ 转移的一刻**发一条消息**出去(订阅方自己去关心)
    输出行("转移时发布的条数");
    输出行(消息.发布全部("运行", 新));
    返回
}

方法 进了停止(整数 旧, 整数 新)
{
    输出行("状态转移 旧");
    输出行(旧);
    输出行("状态转移 新(停下来)");
    输出行(新);
    输出行("转移时发布的条数");
    输出行(消息.发布全部("停止", 新));
    返回
}

// ============================================================
输出行("=== 一、订阅 ===");
输出行("上限");
输出行(消息.上限());
输出行("订阅 运行/首订阅 给的号");
输出行(消息.订阅("运行", 地址(首订阅收下)));
输出行("订阅 运行/次订阅 给的号");
输出行(消息.订阅("运行", 地址(次订阅收下)));
输出行("订阅 停止/次订阅 给的号");
输出行(消息.订阅("停止", 地址(次订阅收下)));
输出行("条数");
输出行(消息.条数());
输出行("有订阅 运行");
输出行(消息.有订阅("运行"));
输出行("有订阅 空主题");
输出行(消息.有订阅("空主题"));
输出行("主题(1)");
输出行(消息.主题(1));
输出行("主题(9) 没这一条");
输出行(消息.主题(9));

输出行("=== 二、发布 ===");
输出行("发布全部 运行 值 7 的返回");
输出行(消息.发布全部("运行", 7));
输出行("发布全部 停止 值 9 的返回");
输出行(消息.发布全部("停止", 9));
输出行("发布 运行 值 11 的返回");
输出行(消息.发布("运行", 11));
输出行("发布一个 运行 第 1 条 值 13 的返回");
输出行(消息.发布一个("运行", 1, 13));
输出行("发布 没有这个主题 的返回");
输出行(消息.发布("没有这个主题", 5));

输出行("=== 三、退订 ===");
输出行("退订 运行 撤了几条");
输出行(消息.退订("运行"));
输出行("条数");
输出行(消息.条数());
输出行("发布全部 运行 值 21 的返回(撤光了)");
输出行(消息.发布全部("运行", 21));
输出行("退订一个(2)");
输出行(消息.退订一个(2));
输出行("条数");
输出行(消息.条数());
输出行("退订一个(2) 再来一次");
输出行(消息.退订一个(2));

输出行("=== 四、状态机 ===");
输出行("状态上限");
输出行(状态机.状态上限());
输出行("事件上限");
输出行(状态机.事件上限());
输出行("建(3, 2)");
输出行(状态机.建(3, 2));
输出行("建(9, 2) 越界");
输出行(状态机.建(9, 2));
输出行("设转移 0-0 到 1");
输出行(状态机.设转移(0, 0, 1, 地址(进了运行)));
输出行("设转移 1-1 到 2");
输出行(状态机.设转移(1, 1, 2, 地址(进了停止)));
输出行("设转移 越界");
输出行(状态机.设转移(0, 9, 1, 地址(进了运行)));
输出行("有转移(0,0)");
输出行(状态机.有转移(0, 0));
输出行("有转移(0,1)");
输出行(状态机.有转移(0, 1));
输出行("目标(0,0)");
输出行(状态机.目标(0, 0));
输出行("目标(0,1) 没这条转移");
输出行(状态机.目标(0, 1));
输出行("设初始(0)");
输出行(状态机.设初始(0));
输出行("当前");
输出行(状态机.当前());
输出行("喂(0) 之后的当前");
输出行(状态机.喂(0));
输出行("喂(0) 再来(没这条转移)");
输出行(状态机.喂(0));
输出行("喂(1) 之后的当前");
输出行(状态机.喂(1));
输出行("喂(1) 再来");
输出行(状态机.喂(1));
输出行("喂(9) 越界");
输出行(状态机.喂(9));
输出行("当前");
输出行(状态机.当前());

输出行("=== 五、清掉 ===");
输出行("清转移(1,1)");
输出行(状态机.清转移(1, 1));
输出行("有转移(1,1)");
输出行(状态机.有转移(1, 1));
输出行("状态机.清掉() 之后的当前");
状态机.清掉();
输出行(状态机.当前());
消息.清掉();
输出行("消息.清掉() 之后的条数");
输出行(消息.条数());
输出行("首订阅一共收到");
输出行(首订阅收到);
输出行("次订阅一共收到");
输出行(次订阅收到);
停止

// 预期输出: === 一、订阅 ===|上限|16|订阅 运行/首订阅 给的号|0|订阅 运行/次订阅 给的号|1|订阅 停止/次订阅 给的号|2|条数|3|有订阅 运行|1|有订阅 空主题|0|主题(1)|运行|主题(9) 没这一条||=== 二、发布 ===|发布全部 运行 值 7 的返回|首订阅收到 号|0|首订阅收到 值|7|次订阅收到 号|1|次订阅收到 值|7|2|发布全部 停止 值 9 的返回|次订阅收到 号|2|次订阅收到 值|9|1|发布 运行 值 11 的返回|首订阅收到 号|0|首订阅收到 值|11|1|发布一个 运行 第 1 条 值 13 的返回|次订阅收到 号|1|次订阅收到 值|13|1|发布 没有这个主题 的返回|0|=== 三、退订 ===|退订 运行 撤了几条|2|条数|1|发布全部 运行 值 21 的返回(撤光了)|0|退订一个(2)|1|条数|0|退订一个(2) 再来一次|0|=== 四、状态机 ===|状态上限|4|事件上限|4|建(3, 2)|1|建(9, 2) 越界|0|设转移 0-0 到 1|1|设转移 1-1 到 2|1|设转移 越界|0|有转移(0,0)|1|有转移(0,1)|0|目标(0,0)|1|目标(0,1) 没这条转移|0|设初始(0)|1|当前|0|喂(0) 之后的当前|状态转移 旧|0|状态转移 新(开始运行)|1|转移时发布的条数|0|1|喂(0) 再来(没这条转移)|1|喂(1) 之后的当前|状态转移 旧|1|状态转移 新(停下来)|2|转移时发布的条数|0|2|喂(1) 再来|2|喂(9) 越界|2|当前|2|=== 五、清掉 ===|清转移(1,1)|1|有转移(1,1)|0|状态机.清掉() 之后的当前|0|消息.清掉() 之后的条数|0|首订阅一共收到|2|次订阅一共收到|3
