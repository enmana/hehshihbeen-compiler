// ============================================================
// 预览_全身像(静态一张)—— 逐顶点投点画出来,用来"一眼看出模型进没进来"
//
//   为什么要有它:`画实心带光` 那条路**只填可见面**,从任何角度看都只能看到
//   "正对镜头的那一层",很难一眼判断"模型到底进来没有"。这一份**不剔任何东西** ——
//   把 527 个顶点全投到屏幕上各画一个小十字 ⇒ **人形轮廓**直接看得见。
//   (它是 `工具\模型工具\README.md` 那套流程的验收件:换模型之后先跑它。)
//
//   命令行:`hbcc -p Sample\中间层\预览_全身像\预览_全身像.hbp --run`
//   (命令行是**无头**的:图形命令逐条打在屏幕上;要看窗口就照常从 IDE 里跑这个工程。)
// ============================================================
包含 "../../库/三维数学.hb"
包含 "../../库/三维网格.hb"
包含 "../../库/模型.hb"

字符串 仓库根路径 = "Sample/模型/人头A/全身.obj";
字符串 工程目录路径 = "../../模型/人头A/全身.obj";
无符号整数 点色 = 4293457276;      // 0xFFE8E77C

// ⚠ **两个候选路径**(第415批):① 仓库根那一条(IDE 里跑、命令行在仓库根跑);
//   ② 工程目录那一条(双击工程目录里的 .exe 时当前目录是工程目录)。
逻辑 进来没 = 模型.装进网格(仓库根路径);
如果 (!进来没)
{
    进来没 = 模型.装进网格(工程目录路径);
}
测试输出(进来没);
测试输出(模型.顶点数());
测试输出(模型.面数());

// 相机:比例 = 焦距 / 眼距,这一份实测 y 跨度 1.91 ⇒ 取比例 240(≈458 像素高)
三维网格.眼距 = 8.0;
三维网格.焦距 = 1920.0;
三维网格.画心x = 240.0;
三维网格.画心y = 265.0;

逻辑 开着 = 打开窗口("全身像 · 静态预览(逐顶点投点)", 480, 560);
如果 (开着)
{
    // 这一份素材的 x 轴是"前后"向 ⇒ 偏航 2.53 弧度(约 145°)人形最正(实测)
    三维网格.摆角(0.14, 2.53, 0.0);
    清屏(0xFF0C0C12);
    整数 i = 0;
    整数 画了几个 = 0;
    当 (i < 三维网格.顶点数)
    {
        浮点 可 = 三维网格.投点(三维网格.顶点x[i], 三维网格.顶点y[i], 三维网格.顶点z[i]);
        如果 (可 > 0.0)
        {
            整数 点x = 三维网格.屏x;
            整数 点y = 三维网格.屏y;
            画线(点x - 1, 点y, 点x + 1, 点y, 点色);
            画线(点x, 点y - 1, 点x, 点y + 1, 点色);
            画了几个 = 画了几个 + 1;
        }
        i = i + 1;
    }
    测试输出(画了几个);
    画文字(8, 8, "全身像 · 逐顶点投点(不剔)", 0xFFFFFFFF);
    画文字(8, 24, "这一张用来确认模型进来了、相机对不对", 0xFF8090A0);
    // ⚠ **窗口活多久**(第415批改):以前是"刷新 → 等待 50 毫秒 → 关窗" ——
    //   窗口只活 **50 毫秒**,人眼看见的就是"一闪而过"(用户实测报的正是这个)。
    //   这一张是**静态预览**:画面只画一次,循环里只重贴 + 收事件,不再重画。
    //   ⚠ 这一篇**仍然留了一道帧数上限**(别的开窗示例都撤了):它是 `示例回归` 那条腿
    //     会**真的跑**的一篇(别的几篇"无可回归段"整篇跳过),而没有事件脚本时
    //     无头那条腿的循环不会自己停 —— 实测:改成"转到用户自己关窗"之后
    //     `示例回归` 那一组当场跑不完(整进程被拖死)。
    //   6000 帧 × 50 毫秒 ≈ **5 分钟**:人来得及看,自检那条腿也有头。
    整数 类型 = 0;
    整数 键码 = 0;
    整数 鼠x = 0;
    整数 鼠y = 0;
    整数 帧 = 0;
    逻辑 收手 = 假;
    当 (!收手 && 帧 < 6000)
    {
        刷新();
        当 (取事件(类型, 键码, 鼠x, 鼠y))
        {
            如果 (类型 == 1 || 键码 == 27)
            {
                收手 = 真;
            }
        }
        帧 = 帧 + 1;
        等待(50);
    }
    关闭窗口();
}
模型.清掉();
停止
