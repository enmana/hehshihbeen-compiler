// ============================================================
// 示例25:错误怎么传(R3-5 起)—— 没有异常,失败靠返回值
//
// 这个示例演示什么:HB 里**失败怎么一层层往上传** —— 五处一起看:
//   ① 底层:可能失败的一步 `返回 [假, 0];` / `返回 [真, 值];`
//      —— 一个"成不成 + 值"的小捆(元组),这就是**标准结果形状**;
//   ② 中层:自己也要往上穿时,把那个小捆**原样返回**给上一层(不看值,只接着递);
//   ③ 顶层:`如果 (结果.项0) { … } 否则 { … }` 当场分岔 —— 不必猜"哪个数是失败";
//   ④ 要**错误码 / 说明**就用**结构**当结果类型(元组里放不下说明文字);
//   ⑤ 宿主能力(`读文件`…)是老约定:返回 `逻辑`,**失败不停机、不写错误槽** —— 程序照常跑到最后。
//
// 关键字中英等价(整数=int、如果=if、返回=return),标识符随便起。
// 本示例不需要任何库,单独就能编译运行。
// ============================================================

// ① 底层:可能失败的一步 —— 成功给"真 + 值",失败给"假 + 0"
方法 取一半(整数 数) 返回 [逻辑, 整数]
{
    如果 (数 < 0)
    {
        返回 [假, 0];
    }
    返回 [真, 数 / 2];
}

// ② 中层:两步都可能失败,失败了就把小捆接着往上递
方法 平均值(整数 左, 整数 右) 返回 [逻辑, 整数]
{
    [逻辑, 整数] 左半 = 取一半(左);
    如果 (左半.项0)
    {
        [逻辑, 整数] 右半 = 取一半(右);
        如果 (右半.项0)
        {
            返回 [真, 左半.项1 + 右半.项1];
        }
        返回 [假, 0];
    }
    返回 [假, 0];
}

// ④ 结构当结果类型:要错误码 + 说明时(字段一行一个)
结构 取数结果
{
    逻辑 成;
    整数 值;
    整数 错误码;
    字符串 说明;
}

方法 取两倍(整数 原始) 返回 取数结果
{
    取数结果 结果;
    如果 (原始 < 0)
    {
        结果.成 = 假;
        结果.值 = 0;
        结果.错误码 = 7;
        结果.说明 = "负数取不了两倍";
        返回 结果;
    }
    结果.成 = 真;
    结果.值 = 原始 * 2;
    结果.错误码 = 0;
    结果.说明 = "";
    返回 结果;
}

// ---------------- 调用方:三条路各看一遍 ----------------

// ③ 顶层:成功的这一路
[逻辑, 整数] 好 = 平均值(10, 20);
如果 (好.项0)
{
    测试输出(好.项1);                      // 15
}
否则
{
    测试输出(0 - 1);
}

// ③ 顶层:失败的那一路(只看"成不成",不看那个 0 值)
[逻辑, 整数] 坏 = 平均值(10, 0 - 2);
如果 (坏.项0)
{
    测试输出(坏.项1);
}
否则
{
    测试输出(0 - 1);                      // -1
}

// ④ 结构结果:成功与失败各一次,失败时读错误码(要看说明就读 `结果.说明`)
取数结果 成功例 = 取两倍(21);
如果 (成功例.成)
{
    测试输出(成功例.值);                      // 42
}
否则
{
    测试输出(成功例.错误码);
}
取数结果 失败例 = 取两倍(0 - 1);
如果 (失败例.成)
{
    测试输出(失败例.值);
}
否则
{
    测试输出(失败例.错误码);                  // 7
}

// ⑤ 宿主能力:读一份不存在的文件 —— 返回 假,但**不停机、不写错误槽**:后面那句照跑
字符串 内容 = "";
逻辑 读到了 = 读文件("示例25里没有这份文件.txt", 内容, 4096);
如果 (读到了)
{
    测试输出(1);
}
否则
{
    测试输出(0);                          // 0 = 没读到
}
测试输出(999);                            // 999 = 程序跑到了最后(失败没打断它)

停止

// 预期输出: 15|-1|42|7|0|999
