// ============================================================
// 示例31_异步:G3 域 5 —— 异步输入输出(功能号 40 / 41 / 42)
//
//   这一域解决两件具体的事:
//     ① 界面程序里**一次阻塞调用会把整帧卡住**(`读一块` / `接收` 都是全同步的);
//     ② 1MB 运行内存下大文件只能分块读,而每一块都可能阻塞。
//   路是**宿主线程池**:`发起异步` 把活交给宿主后台线程、**立刻**返回任务号;
//   真阻塞那一趟在后台跑;VM 照旧单线程,`任务就绪` 只是"读一格状态 + 把结果搬回来"。
//
//   三个函数(完整说明见帮助《三十三、异步》):
//     发起异步(种类, 目标, 内容, 数值, 任务)   种类 1 读文件 / 2 写文件 / 3 连接;立刻给任务号(排不上给 -1)
//     任务就绪(任务号, 状态, 字节数)      0 还没好 / 1 好了 / 2 这一趟失败 / 3 号作废 / 22 号不成形
//     取消任务(任务号)                    不再等它(尽力取消:已经在跑的那一趟拦不住,结果丢掉)
//
//   四个实参按种类解释:读文件 `(1, 路径, 内容变量, 上限, 任务)`、
//   写文件 `(2, 路径, 要写的串, 要写的字节数, 任务)`(字节数写 0 = 整段都写)、
//   连接 `(3, 主机, "", 端口, 任务)`(内容那一格连接不用)。
//
//   三条口径:
//     · **等就绪一律靠 `当 (任务就绪(...) == 0) { }`** —— 本机测试不许加"睡眠式"的等待;
//     · **连接那一条自己连自己**(照 `示例29_网络` 那条路:**先监听、再连上**,不碰外网);
//       `任务就绪` 的第三格(那一格叫"字节数")在连接这一趟放的是**新连接的句柄** ——
//       连接没有"字节数",那一格就是它的结果,拿它去 `发送` / `接收` / `关闭`;
//     · **收走只能收一次**:`任务就绪` 返回 1 的那一刻结果搬回来、任务号当场作废(再问给 3)。
//
//   这一篇只碰自己的临时工作目录(跑完自己清干净),不碰别的示例的文件。
// ============================================================

字符串 目录 = "工具/临时/示例31";
字符串 路径 = "工具/临时/示例31/数据.txt";
字符串 没这个 = "工具/临时/示例31/没有这个.txt";
输出行(建目录(目录));                       // 1

整数 任务 = 0;
整数 状态 = 0;
整数 个数 = 0;
整数 码 = 0;

// ---------------- ① 异步写文件:发起 → 等就绪 → 看结果 ----------------
任务 = 发起异步(2, 路径, "异步写进来的", 0, 任务);
输出行(任务);                                // 1:第一个任务的号(`(0 << 16) | 1`)
当 (任务就绪(任务, 状态, 个数) == 0)
{
}
输出行(状态);                                // 0:这一趟成了
输出行(个数);                                // 18:写下去 18 个字节(6 个汉字 × 3)
码 = 任务就绪(任务, 状态, 个数);
输出行(码);                                  // 3:结果只收得到一次 —— 收走那一刻这个号就作废了

// ---------------- ② 异步读文件:读到的内容直接进那个 `字符串` 变量 ----------------
字符串 读回 = "";
整数 读任务 = 0;
读任务 = 发起异步(1, 路径, 读回, 4096, 读任务);
当 (任务就绪(读任务, 状态, 个数) == 0)
{
}
输出行(状态);                                // 0
输出行(个数);                                // 18
输出行(读回);                                // 异步写进来的

// ---------------- ③ 异步连接:自己连自己(先监听、再连上) ----------------
字符串 本机 = "127.0.0.1";
整数 端口 = 45321;
整数 听 = 0;
听 = 监听(本机, 端口, 听);
输出行(听 > 0);                              // 1:监听开起来了
整数 连任务 = 0;
连任务 = 发起异步(3, 本机, "", 端口, 连任务);
当 (任务就绪(连任务, 状态, 个数) == 0)
{
}
输出行(状态);                                // 0:连上了
整数 客 = 个数;
输出行(客 > 0);                              // 1:第三格给的就是新连接的句柄
整数 服 = 0;
服 = 接受(听, 服);
输出行(服 > 0);                              // 1
输出行(发送(客, "ping"));                    // 4:发出去 4 个字节
字符串 收块 = "";
字符串 全文 = "";
整数 已收 = 0;
整数 块长 = 1;
当 (已收 < 4 && 块长 > 0)
{
    块长 = 接收(服, 收块, 8);
    如果 (块长 > 0)
    {
        拼接到(全文, 收块);
        已收 = 已收 + 块长;
    }
}
输出行(已收);                                // 4(一次能收到几个字节由网络说了算,所以按"还差几个"收满)
输出行(全文);                                // ping
输出行(关闭(客));                            // 0
输出行(关闭(服));                            // 0
输出行(关闭(听));                            // 0

// ---------------- ④ 失败路一:**文件打不开**(发起成了,是"这一趟"失败) ----------------
整数 坏 = 0;
坏 = 发起异步(1, 没这个, 读回, 64, 坏);
输出行(坏 > 0);                              // 1:任务开出去了(打不开是后台那一趟的事)
当 (任务就绪(坏, 状态, 个数) == 0)
{
}
输出行(状态);                                // 2:打不开
输出行(个数);                                // 0:一个字节都没读着

// ---------------- ⑤ 失败路二:**任务太多**(32 格全占着,第 33 个给 -1) ----------------
// 为什么这样是确定的:一格从 `发起` 占到最后一次 `任务就绪`,**跑完不自己放格子** ——
// 所以发起 32 个、一个都不查,第 33 个必然排不上(与线程快慢无关)。
整数 一堆[32];
整数 i = 0;
当 (i < 32)
{
    整数 一个 = 0;
    一个 = 发起异步(1, 没这个, 读回, 16, 一个);
    一堆[i] = 一个;
    i = i + 1;
}
整数 满了 = 0;
满了 = 发起异步(1, 没这个, 读回, 16, 满了);
输出行(满了);                                // -1:排不上

// ---------------- ⑥ 失败路三:**作废号**(取消过) ----------------
输出行(取消任务(一堆[0]));                   // 0:取消成功
码 = 任务就绪(一堆[0], 状态, 个数);
输出行(码);                                  // 3:取消过 ⇒ 旧号当场作废
输出行(取消任务(一堆[0]));                   // 3:再取消一次也是作废

// ---------------- 收尾:把还没收走的都收掉,再把文件 / 目录清干净 ----------------
// ⚠ 每一个都**等它到**再收(不是"查到什么算什么"):收的结果会写进请求块与 `状态` / `个数` ——
//   不等它到就收,"收着的是一个还在跑的任务"还是"一个已经好了的任务"就跟线程快慢有关,
//   整机内存也就不可复现了(异步那一档要确定,靠的正是"等它到 1 再往下走")。
i = 0;
当 (i < 32)
{
    当 (任务就绪(一堆[i], 状态, 个数) == 0)
    {
    }
    i = i + 1;
}
输出行(删文件(路径));                        // 1
输出行(删目录(目录));                        // 1

// 预期输出: 1|1|0|18|3|0|18|异步写进来的|1|0|1|1|4|4|ping|0|0|0|1|2|0|-1|0|3|3|1|1
