// ============================================================
// 示例67:主循环接线 —— 三格布局 + 编辑器内核 + 编辑器视图 拼成一台能用的 IDE 壳
//
//   这一件要证的事:**一台 IDE 的"心跳"转得起来** —— 一帧的顺序是
//   「收事件 → 按焦点分发(鼠标 / 键盘) → 标脏 → 要重画? → 重画 → 刷新()」,
//   而且每一步都能逐帧打印出来对表。
//
//   分发口径(这一件最要紧的规矩):
//     · **焦点在编辑器格**:鼠标按下 ⇒ 光标挪到点的那一行那一列(`编辑器视图.行在第几` / `列在第几`);
//       键盘 ⇒ 先试编辑键(回车 / 退格 / 制表 / 删除)、再试移动键(四方向 / 首页末页 / 翻页),
//       都不是就当一个可见 ASCII 字符插进去(中文走 `插入文本`,键盘事件一个键码装不下一个汉字);
//     · **焦点在文件栏**:上下方向键换当前文件(`IDE布局.送键盘`);
//     · **焦点在输出区**:键盘不做事(如实记:输出区只读);
//     · **隔条**:按住拖 —— 由 `IDE布局.送鼠标` 自己管(它与焦点无关)。
//
//   ⚠ **一条如实登记的缺口**:语言面那 10 条图形原语里**没有"取窗口宽高"** ⇒
//     "窗口尺寸变化 ⇒ 三格跟着变"这一半**做不到**(只能由程序自己知道窗口多大)。
//     真正的响应式布局要等一个"查询窗口尺寸"的图形原语 —— 这一件按**固定尺寸**布局。
//
//   旁边 `事件脚本.txt` 的 6 帧:点编辑器格第 2 行第 3 列 · 敲 `X` · 回行首退格(并回上一行) ·
//   回车拆行 · 点输出区 · 拖横隔条。每一帧打:焦点 / 光标(行,列)/ 行数 / 文件数 /
//   这一帧几条命令 / 输出区末尾一行。
// ============================================================
包含 "../../库/编辑器.hb"
包含 "../../库/编辑器视图.hb"
包含 "../../库/IDE布局.hb"
包含 "../../库/string.hb"

// 三格:左 0 / 上 0 / 宽 640 / 高 400 / 左栏 140 / 下栏 120(固定尺寸 —— 见头上那条缺口)
编辑器.编辑缓冲 编;
编辑器.建编辑器(编, 8);
编辑器视图.面板 屏;
IDE布局.布局 台;

字符串 初文;
拼接到(初文, "第一行");
拼接到(初文, 编辑器.换行符());
拼接到(初文, "第二行中文");
拼接到(初文, 编辑器.换行符());
拼接到(初文, "第三行");

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 帧 = 0;
整数 上一帧焦点 = 0 - 1;
逻辑 收手 = 假;

// 键盘进编辑器:编辑键 → 移动键 → 可见 ASCII 字符(中文不走这条)
方法 键盘进编辑器(整数 键码) 返回 逻辑
{
    如果 (编辑器.编辑键(编, 键码))
    {
        返回 真;
    }
    如果 (编辑器.移动键(编, 键码))
    {
        返回 真;
    }
    如果 (键码 >= 32 && 键码 <= 126)
    {
        IDE布局.写输出(台, "敲了一个字符");
        返回 编辑器.插入码点(编, 键码);
    }
    返回 假;
}

// 鼠标按下:先让布局判"落在哪一格"(顺带管焦点与隔条拖动),焦点在编辑器格时再把光标挪过去
方法 鼠标按下(整数 x, 整数 y) 返回 逻辑
{
    逻辑 变过 = IDE布局.送鼠标(台, 1, x, y);
    如果 (IDE布局.焦点格(台) == 1)
    {
        整数 行 = 编辑器视图.行在第几(屏, 编, y);
        整数 列 = 编辑器视图.列在第几(屏, 编, 行, x);
        编辑器.设光标(编, 行, 列);
        返回 真;
    }
    返回 变过;
}

// 一个事件按焦点分发(回来的是"这一帧有没有变过")
方法 分发一个事件(逻辑 变过) 返回 逻辑
{
    如果 (类型 == 3)
    {
        IDE布局.送鼠标(台, 0, 鼠标x, 鼠标y);
        返回 变过;
    }
    如果 (类型 == 4)
    {
        返回 鼠标按下(鼠标x, 鼠标y) || 变过;
    }
    如果 (类型 == 5)
    {
        IDE布局.送鼠标(台, 2, 鼠标x, 鼠标y);
        返回 变过;
    }
    如果 (类型 == 2)
    {
        整数 焦点 = IDE布局.焦点格(台);
        如果 (焦点 == 1)
        {
            返回 键盘进编辑器(键码) || 变过;
        }
        如果 (焦点 == 0)
        {
            IDE布局.送键盘(台, 键码);
            返回 变过;
        }
        返回 变过;
    }
    返回 变过;
}

// 一帧的读数:焦点 / 光标 / 行数 / 文件数 / 这一帧几条命令 / 输出区末行
方法 报一帧(整数 帧号, 整数 条)
{
    输出行(格式化("帧{0}: 焦点={1} 命令={2}", 帧号, IDE布局.焦点格(台), 条));
    报输出末行(台);
    返回
}

// 输出区末尾那一行(单独一个函数:一次 `输出行` 取两回,挤在 `报一帧` 里帧会顶穿)
方法 报输出末行(IDE布局.布局 台)
{
    输出行(格式化("光标={0},{1} 输出行数={2}", 编辑器.光标行(编), 编辑器.光标列(编), IDE布局.输出行数(台)));
    返回
}

如果 (打开窗口("IDE 主循环", 660, 430))
{
    编辑器.装入文本(编, 初文);
    IDE布局.建布局(台, 0, 0, 640, 400, 140, 120);
    IDE布局.编辑格挂上(台, 编, 屏);
    IDE布局.加文件(台, "main.hb");
    IDE布局.加文件(台, "库.hb");
    IDE布局.写输出(台, "就绪");
    IDE布局.写输出(台, "点了编辑器格");
    上一帧焦点 = IDE布局.焦点格(台);

    当 (!收手)
    {
        逻辑 变过 = 假;
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;
            }
            否则
            {
                变过 = 分发一个事件(变过);
            }
        }
        整数 条 = 0;
        如果 (变过 || IDE布局.要重画(台))
        {
            条 = IDE布局.重画(台);                      // 清屏 + 三格 + 隔条 + 焦点框
            条 = 条 + 编辑器视图.画一屏(屏, 编);         // 编辑器格里的内容
        }
        报一帧(帧, 条);
        刷新();
        帧 = 帧 + 1;
        等待(80);
    }
    关闭窗口();
}
停止
// 预期输出: 打开窗口 标题="IDE 主循环" 宽=660 高=430|帧0: 焦点=1 命令=22|光标=1,0 输出行数=2|清屏 颜色=0xFF14141C|画矩形 x=0 y=0 宽=140 高=400 颜色=0xFF14141C|画文字 x=6 y=6 文本="文件" 颜色=0xFF6A6A80|画矩形 x=0 y=24 宽=140 高=20 颜色=0xFF2A6EF0|画文字 x=8 y=27 文本="main.hb" 颜色=0xFFE8E8F0|画文字 x=8 y=47 文本="库.hb" 颜色=0xFFE8E8F0|画矩形 x=0 y=280 宽=640 高=120 颜色=0xFF14141C|画文字 x=6 y=284 文本="输出" 颜色=0xFF6A6A80|画文字 x=8 y=304 文本="就绪" 颜色=0xFFE8E8F0|画文字 x=8 y=322 文本="点了编辑器格" 颜色=0xFFE8E8F0|画矩形 x=140 y=0 宽=4 高=400 颜色=0xFF2A2A3A|画矩形 x=144 y=276 宽=496 高=4 颜色=0xFF2A2A3A|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF2A6EF0|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF14141C|画文字 x=168 y=3 文本="1" 颜色=0xFF6A6A80|画文字 x=182 y=3 文本="第一行" 颜色=0xFFE8E8F0|画矩形 x=145 y=18 宽=487 高=18 颜色=0xFF23233A|画文字 x=168 y=21 文本="2" 颜色=0xFF6A6A80|画文字 x=182 y=21 文本="第二行中文" 颜色=0xFFE8E8F0|画文字 x=168 y=39 文本="3" 颜色=0xFF6A6A80|画文字 x=182 y=39 文本="第三行" 颜色=0xFFE8E8F0|画矩形 x=182 y=20 宽=8 高=14 颜色=0xFF2A6EF0|刷新 命令=22|帧1: 焦点=1 命令=23|光标=1,1 输出行数=3|清屏 颜色=0xFF14141C|画矩形 x=0 y=0 宽=140 高=400 颜色=0xFF14141C|画文字 x=6 y=6 文本="文件" 颜色=0xFF6A6A80|画矩形 x=0 y=24 宽=140 高=20 颜色=0xFF2A6EF0|画文字 x=8 y=27 文本="main.hb" 颜色=0xFFE8E8F0|画文字 x=8 y=47 文本="库.hb" 颜色=0xFFE8E8F0|画矩形 x=0 y=280 宽=640 高=120 颜色=0xFF14141C|画文字 x=6 y=284 文本="输出" 颜色=0xFF6A6A80|画文字 x=8 y=304 文本="就绪" 颜色=0xFFE8E8F0|画文字 x=8 y=322 文本="点了编辑器格" 颜色=0xFFE8E8F0|画文字 x=8 y=340 文本="敲了一个字符" 颜色=0xFFE8E8F0|画矩形 x=140 y=0 宽=4 高=400 颜色=0xFF2A2A3A|画矩形 x=144 y=276 宽=496 高=4 颜色=0xFF2A2A3A|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF2A6EF0|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF14141C|画文字 x=168 y=3 文本="1" 颜色=0xFF6A6A80|画文字 x=182 y=3 文本="第一行" 颜色=0xFFE8E8F0|画矩形 x=145 y=18 宽=487 高=18 颜色=0xFF23233A|画文字 x=168 y=21 文本="2" 颜色=0xFF6A6A80|画文字 x=182 y=21 文本="X第二行中文" 颜色=0xFFE8E8F0|画文字 x=168 y=39 文本="3" 颜色=0xFF6A6A80|画文字 x=182 y=39 文本="第三行" 颜色=0xFFE8E8F0|画矩形 x=190 y=20 宽=8 高=14 颜色=0xFF2A6EF0|刷新 命令=23|帧2: 焦点=1 命令=21|光标=0,3 输出行数=3|清屏 颜色=0xFF14141C|画矩形 x=0 y=0 宽=140 高=400 颜色=0xFF14141C|画文字 x=6 y=6 文本="文件" 颜色=0xFF6A6A80|画矩形 x=0 y=24 宽=140 高=20 颜色=0xFF2A6EF0|画文字 x=8 y=27 文本="main.hb" 颜色=0xFFE8E8F0|画文字 x=8 y=47 文本="库.hb" 颜色=0xFFE8E8F0|画矩形 x=0 y=280 宽=640 高=120 颜色=0xFF14141C|画文字 x=6 y=284 文本="输出" 颜色=0xFF6A6A80|画文字 x=8 y=304 文本="就绪" 颜色=0xFFE8E8F0|画文字 x=8 y=322 文本="点了编辑器格" 颜色=0xFFE8E8F0|画文字 x=8 y=340 文本="敲了一个字符" 颜色=0xFFE8E8F0|画矩形 x=140 y=0 宽=4 高=400 颜色=0xFF2A2A3A|画矩形 x=144 y=276 宽=496 高=4 颜色=0xFF2A2A3A|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF2A6EF0|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF14141C|画矩形 x=145 y=0 宽=487 高=18 颜色=0xFF23233A|画文字 x=168 y=3 文本="1" 颜色=0xFF6A6A80|画文字 x=182 y=3 文本="第一行X第二行中文" 颜色=0xFFE8E8F0|画文字 x=168 y=21 文本="2" 颜色=0xFF6A6A80|画文字 x=182 y=21 文本="第三行" 颜色=0xFFE8E8F0|画矩形 x=230 y=2 宽=8 高=14 颜色=0xFF2A6EF0|刷新 命令=21|帧3: 焦点=1 命令=23|光标=1,0 输出行数=3|清屏 颜色=0xFF14141C|画矩形 x=0 y=0 宽=140 高=400 颜色=0xFF14141C|画文字 x=6 y=6 文本="文件" 颜色=0xFF6A6A80|画矩形 x=0 y=24 宽=140 高=20 颜色=0xFF2A6EF0|画文字 x=8 y=27 文本="main.hb" 颜色=0xFFE8E8F0|画文字 x=8 y=47 文本="库.hb" 颜色=0xFFE8E8F0|画矩形 x=0 y=280 宽=640 高=120 颜色=0xFF14141C|画文字 x=6 y=284 文本="输出" 颜色=0xFF6A6A80|画文字 x=8 y=304 文本="就绪" 颜色=0xFFE8E8F0|画文字 x=8 y=322 文本="点了编辑器格" 颜色=0xFFE8E8F0|画文字 x=8 y=340 文本="敲了一个字符" 颜色=0xFFE8E8F0|画矩形 x=140 y=0 宽=4 高=400 颜色=0xFF2A2A3A|画矩形 x=144 y=276 宽=496 高=4 颜色=0xFF2A2A3A|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF2A6EF0|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF14141C|画文字 x=168 y=3 文本="1" 颜色=0xFF6A6A80|画文字 x=182 y=3 文本="第一行" 颜色=0xFFE8E8F0|画矩形 x=145 y=18 宽=487 高=18 颜色=0xFF23233A|画文字 x=168 y=21 文本="2" 颜色=0xFF6A6A80|画文字 x=182 y=21 文本="X第二行中文" 颜色=0xFFE8E8F0|画文字 x=168 y=39 文本="3" 颜色=0xFF6A6A80|画文字 x=182 y=39 文本="第三行" 颜色=0xFFE8E8F0|画矩形 x=182 y=20 宽=8 高=14 颜色=0xFF2A6EF0|刷新 命令=23|帧4: 焦点=2 命令=23|光标=1,0 输出行数=3|清屏 颜色=0xFF14141C|画矩形 x=0 y=0 宽=140 高=400 颜色=0xFF14141C|画文字 x=6 y=6 文本="文件" 颜色=0xFF6A6A80|画矩形 x=0 y=24 宽=140 高=20 颜色=0xFF2A6EF0|画文字 x=8 y=27 文本="main.hb" 颜色=0xFFE8E8F0|画文字 x=8 y=47 文本="库.hb" 颜色=0xFFE8E8F0|画矩形 x=0 y=280 宽=640 高=120 颜色=0xFF14141C|画文字 x=6 y=284 文本="输出" 颜色=0xFF6A6A80|画文字 x=8 y=304 文本="就绪" 颜色=0xFFE8E8F0|画文字 x=8 y=322 文本="点了编辑器格" 颜色=0xFFE8E8F0|画文字 x=8 y=340 文本="敲了一个字符" 颜色=0xFFE8E8F0|画矩形 x=140 y=0 宽=4 高=400 颜色=0xFF2A2A3A|画矩形 x=144 y=276 宽=496 高=4 颜色=0xFF2A2A3A|画矩形 x=0 y=280 宽=640 高=120 颜色=0xFF2A6EF0|画矩形 x=144 y=0 宽=496 高=276 颜色=0xFF14141C|画文字 x=168 y=3 文本="1" 颜色=0xFF6A6A80|画文字 x=182 y=3 文本="第一行" 颜色=0xFFE8E8F0|画矩形 x=145 y=18 宽=487 高=18 颜色=0xFF23233A|画文字 x=168 y=21 文本="2" 颜色=0xFF6A6A80|画文字 x=182 y=21 文本="X第二行中文" 颜色=0xFFE8E8F0|画文字 x=168 y=39 文本="3" 颜色=0xFF6A6A80|画文字 x=182 y=39 文本="第三行" 颜色=0xFFE8E8F0|画矩形 x=182 y=20 宽=8 高=14 颜色=0xFF2A6EF0|刷新 命令=23|帧5: 焦点=2 命令=0|光标=1,0 输出行数=3|刷新 命令=0|帧6: 焦点=2 命令=0|光标=1,0 输出行数=3|刷新 命令=0|帧7: 焦点=2 命令=0|光标=1,0 输出行数=3|刷新 命令=0|帧8: 焦点=2 命令=0|光标=1,0 输出行数=3|刷新 命令=0|关闭窗口
