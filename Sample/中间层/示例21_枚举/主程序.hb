// ============================================================
// 示例21:枚举(H68-2 起)—— 成员是编译期常量,底层就是有符号 整数
//
// 这个示例演示什么:给一组"名字"编上号,写起来像类型、用起来像常量。
// 重点看哪几处:
//   ① 声明:**一行写完** `枚举 名字 { 成员, 成员 }` —— 成员从 0 起依次 +1;
//      想自己定值就写 `= 3`(认十进制与 0x,也认负号),后面的成员接着它 +1。
//   ② 当类型名用:`颜色 画 = 绿;` —— 枚举**不占存储**,机器码里就是一个立即数,
//      所以它与写 `整数` **逐字节同构**(本示例把两个写法对了一遍)。
//   ③ 成员在表达式里就是**常量**:裸名 `绿` 与全名 `颜色.绿` 都能写,
//      比较 / `选择` 的 `情况` / 循环头 / 数组初值 里都能直接用。
//   ④ 处处能用:变量 / 数组 / 结构字段 / 方法参数 / 返回值 / 引用 / 静态容器的常驻字段。
//   ⑤ 约束(报错当场说):两个枚举的成员**不许隐式互赋**;枚举不进 `[]` 当数组长度;
//      两个枚举里不能有同名成员(裸名会说不清指谁)。
//
// 关键字中英等价(枚举=enum、循环=for、方法=method),标识符随便起。
// 本示例不需要任何库,单独就能编译运行。
//
//   ============================================================
//   怎么看(带 UI;H82 批 3)—— 这一份是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例21 枚举`。
//       窗口左边一列八格 = 上面两个枚举的八个成员(`颜色.赤` … `方向.右`,一个成员一格**写着成员名**);
//       右边那一块 = 这一格的**值**(数字)与"这一档是什么意思";底下两行说它的**值 / 它在 `选择`
//       里走哪一支 / 它能不能当数组下标**。蓝底那一格就是这一帧"指到"的成员,每 `刷新()` 一帧往下走一格
//       (走到 `方向.右` 就绕回 `颜色.赤`);**绿底那一格 = 鼠标刚点中的成员**,点右边表里某一行也一样。
//       窗口**一直转到你自己关掉**(点标题栏的叉)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、也不用等人去关 ——
//       旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),跑满它写的帧数就投一个关窗请求;
//       于是"窗口该画什么、点一下换成哪一格"都能逐行对出来(硬规矩 6:自检不开窗)。
//     · **顺序**:先把上面那些纯计算跑完、`测试输出` 打完(文件末尾那行 `// 预期输出:` 对的就是它们),
//       **然后**才开窗 —— 于是这一份示例的期望输出里,"数"还是那些数,窗口那几行排在后头。
//   ============================================================
包含 "../../库/string.hb"          // 要把数字拼进文字就得有它(`格式化` 靠库里的 `转字符串`)

// ① 声明:从 0 起 / 自己定值
枚举 颜色 { 赤, 绿, 蓝 }
枚举 方向 { 上 = 3, 下, 左 = 10, 右 }

颜色 画 = 绿;
测试输出(画);                      // 1:绿 = 1
测试输出(颜色.蓝);                 // 2:全名也能写
测试输出(方向.左);                 // 10:自己定的值
测试输出(右);                      // 11:左 后面接着 +1
测试输出(下);                      // 4:上 = 3 后面接着 +1

// ② 枚举名当类型名:与 `整数` 逐字节同构(不占存储、机器码里就是一个立即数)
整数 当整数 = 画;
测试输出(当整数 - 画);             // 0:同一个数
测试输出(画 + 1);                  // 2:成员就是常量,直接参与运算

// ③ 表达式 / 选择 / 循环头里都能用
如果 (画 == 绿)
{
    测试输出(100);                 // 100
}
选择 (画)
{
    情况 赤, 绿
    {
        测试输出(200);             // 200:情况后面能列多个成员
    }
    默认
    {
        测试输出(0);
    }
}
循环 (颜色 走 = 赤; 走 < 蓝; 走++)
{
    测试输出(走);                  // 0 / 1
}

// ④ 数组 / 结构字段 / 方法参数 / 返回值 / 引用
颜色 名单[3] = [蓝, 赤, 颜色.绿];
名单[1] = 名单[0];
测试输出(名单[0]);                 // 2
测试输出(名单[1]);                 // 2
测试输出(名单[2]);                 // 1

结构 卡
{
    颜色 花色;
    整数 点数;
}
卡 一张 = [绿, 9];
测试输出(一张.花色);               // 1
测试输出(一张.点数);               // 9

方法 下一个(颜色 当前) 返回 颜色
{
    如果 (当前 == 赤)
    {
        返回 绿;
    }
    返回 蓝;
}
测试输出(下一个(赤));              // 1
测试输出(下一个(绿));              // 2

方法 数一数(颜色 表[], 整数 个数) 返回 整数
{
    整数 总 = 0;
    循环 (var i = 0; i < 个数; i = i + 1)
    {
        总 = 总 + 表[i];
    }
    返回 总;
}
测试输出(数一数(名单, 3));         // 5 = 2 + 2 + 1

方法 指过去()
{
    引用 颜色 参 = 画;
    参 = 蓝;
    测试输出(参);                  // 2
}
指过去();
测试输出(画);                      // 2:引用改的就是它

// ⑤ 静态容器的常驻字段也能是枚举
静态 方法 棋盘()
{
    颜色 当前方 = 赤;
    整数 步数 = 0;
}
棋盘.当前方 = 绿;
测试输出(棋盘.当前方);             // 1

// ---- 带 UI 的那一半(H82 批 3):左边一格一个成员,右边是它的"值 / 什么意思" ----
// 这一整块**只在真开得了窗口时才跑**:没有图形能力的宿主给 假 ⇒ 一个字都不多打,
// 上面那 22 个 `测试输出` 还是那 22 个(顺序、条数一个字没动)。
//
//   · 左边一列八格 = 两个枚举的八个成员(`颜色.赤` … `方向.右`),**一个成员一格、格上写着成员名**;
//     点哪一格,右边那一块当场换成它的**值**(数字)与那一档的**意思**。
//   · 右边那一块的上面是"这一格是哪个枚举的成员",下面是一张表:八格一行,行里写着"值 / 这一档什么意思"。
//   · 底下四行说这一格的**值 / 它在 `选择` 里走哪一支 / 它能不能当数组下标**(`名单[绿]` 那一路)。
//   · 每 `刷新()` 进一帧,蓝底往下走一格(走到最后一个成员就绕回 `颜色.赤`)—— 这一屏在逐帧往前挪;
//     **绿底那一格 = 鼠标刚点中的成员**(点右边表里某一行也一样)。
//
// ⚠ 主循环(每帧都跑的那一层)里**一条字符串都不拼**:要画的字全在开窗之前拼好,每帧只是照原样画。
//   实测:主循环里每帧现拼几十条,209 帧就把编译器那个池吃光,真窗口上跑几秒就报「池用完了」——
//   这一篇连"值"都是开窗前的 `格式化("{0}", 值)` 转好的(`%d` 那种占位符 **不报错也不顶用**:
//   它原样返回 `"%d"`,值被丢掉 ⇒ 窗口上看得见、自检里看不见,所以屏上每个数写完都要自己念一遍)。
// ⚠ 摆位与命中测试**用的是同一组数**(`格顶` / `格高` / `行0` / `行距`),要挪地方只改这几行。
// ⚠ `画矩形` 是不透明实心(没有透明叠层):底色一律画在文字**之前**,画在文字后面就把那一行的字盖掉
//   (无头呈现看不出来,桌面壳上才看得出来)。

整数 窗宽 = 560;
整数 窗高 = 510;
整数 格顶 = 72;                  // 左边第一格的顶边
整数 格高 = 40;                  // 一格多高(= 命中测试的除数)
整数 格宽 = 180;                 // 左边那一列的宽
整数 板左 = 204;                 // 右边那一块的左边
整数 板宽 = 344;                 // 右边那一块的宽
整数 行0 = 148;                  // 表里第一行的顶边
整数 行距 = 34;                  // 一行多高(= 命中测试的除数)

// ---- 左边八格的名字 / 右边每个成员要说的话 —— 一律写字面量 ----
// (字符串赋值右边只认"字面量 / 另一个串 / 一个返回串的调用",所以一条条填)
方法 成员名(整数 序) 返回 字符串
{
    字符串 s = "?";
    如果 (序 == 0)
    {
        s = "赤 = 0";
    }
    如果 (序 == 1)
    {
        s = "绿 = 1";
    }
    如果 (序 == 2)
    {
        s = "蓝 = 2";
    }
    如果 (序 == 3)
    {
        s = "上 = 3";
    }
    如果 (序 == 4)
    {
        s = "下 = 4";
    }
    如果 (序 == 5)
    {
        s = "左 = 10";
    }
    如果 (序 == 6)
    {
        s = "右 = 11";
    }
    如果 (序 == 7)
    {
        s = "(八格用满)";
    }
    返回 s;
}

方法 全名文(整数 序) 返回 字符串
{
    字符串 s = "?";
    如果 (序 == 0)
    {
        s = "颜色.赤";
    }
    如果 (序 == 1)
    {
        s = "颜色.绿";
    }
    如果 (序 == 2)
    {
        s = "颜色.蓝";
    }
    如果 (序 == 3)
    {
        s = "方向.上";
    }
    如果 (序 == 4)
    {
        s = "方向.下";
    }
    如果 (序 == 5)
    {
        s = "方向.左";
    }
    如果 (序 == 6)
    {
        s = "方向.右";
    }
    如果 (序 == 7)
    {
        s = "?";
    }
    返回 s;
}

// 这一档"是什么意思" —— **按左边那一格的序号**说话(序号 = 这一格在成员清单里排第几):
// 底下两张表都用这个序号取,所以 8 格一格都不能落下(少了哪一格,屏上就是一个光秃秃的 `?`)。
方法 意思文(整数 序) 返回 字符串
{
    字符串 s = "?";
    如果 (序 == 0)
    {
        s = "颜色 的第 1 个成员";
    }
    如果 (序 == 1)
    {
        s = "颜色 的第 2 个成员(画 = 绿)";
    }
    如果 (序 == 2)
    {
        s = "颜色 的第 3 个成员";
    }
    如果 (序 == 3)
    {
        s = "方向 的第 1 个成员,自己定的 3";
    }
    如果 (序 == 4)
    {
        s = "接着 上 = 3 往下 +1";
    }
    如果 (序 == 5)
    {
        s = "方向 里自己定的第二个值";
    }
    如果 (序 == 6)
    {
        s = "接着 左 = 10 往下 +1";
    }
    如果 (序 == 7)
    {
        s = "_";
    }
    返回 s;
}

// 「它在 `选择` 里走哪一支」:拿本示例上面那个真跑过的 `选择 (画)` 的同一组情况来对 —— 同样按序号说话
方法 选支文(整数 序) 返回 字符串
{
    字符串 s = "?";
    如果 (序 == 0)
    {
        s = "选择(画) 走 情况 赤, 绿 → 打 200";
    }
    如果 (序 == 1)
    {
        s = "选择(画) 走 情况 赤, 绿 → 打 200";
    }
    如果 (序 == 2)
    {
        s = "选择(画) 没有它的 情况 → 走 默认";
    }
    如果 (序 == 3)
    {
        s = "这个值一个 情况 都没写 → 走 默认";
    }
    如果 (序 == 4)
    {
        s = "这个值一个 情况 都没写 → 走 默认";
    }
    如果 (序 == 5)
    {
        s = "这个值一个 情况 都没写 → 走 默认";
    }
    如果 (序 == 6)
    {
        s = "这个值一个 情况 都没写 → 走 默认";
    }
    如果 (序 == 7)
    {
        s = "_";
    }
    返回 s;
}

// ---- 表里的文字:8 行,一格一行(全名 / 值 / 这一档什么意思)----
方法 表名文(整数 序) 返回 字符串
{
    字符串 s = "?";
    如果 (序 == 0)
    {
        s = "颜色.赤";
    }
    如果 (序 == 1)
    {
        s = "颜色.绿";
    }
    如果 (序 == 2)
    {
        s = "颜色.蓝";
    }
    如果 (序 == 3)
    {
        s = "方向.上";
    }
    如果 (序 == 4)
    {
        s = "方向.下";
    }
    如果 (序 == 5)
    {
        s = "方向.左";
    }
    如果 (序 == 6)
    {
        s = "方向.右";
    }
    如果 (序 == 7)
    {
        s = "_";
    }
    返回 s;
}

方法 表值文(整数 序) 返回 字符串
{
    字符串 s = "?";
    如果 (序 == 0)
    {
        s = "0";
    }
    如果 (序 == 1)
    {
        s = "1";
    }
    如果 (序 == 2)
    {
        s = "2";
    }
    如果 (序 == 3)
    {
        s = "3";
    }
    如果 (序 == 4)
    {
        s = "4";
    }
    如果 (序 == 5)
    {
        s = "10";
    }
    如果 (序 == 6)
    {
        s = "11";
    }
    如果 (序 == 7)
    {
        s = "_";
    }
    返回 s;
}

方法 表意文(整数 序) 返回 字符串
{
    字符串 s = "?";
    如果 (序 == 0)
    {
        s = "从 0 起,第一个就是 0";
    }
    如果 (序 == 1)
    {
        s = "接着 +1;画 就取这个";
    }
    如果 (序 == 2)
    {
        s = "接着 +1,到 2 为止";
    }
    如果 (序 == 3)
    {
        s = "自己定值:上 = 3";
    }
    如果 (序 == 4)
    {
        s = "接着 3 往下 +1";
    }
    如果 (序 == 5)
    {
        s = "自己定值:左 = 10";
    }
    如果 (序 == 6)
    {
        s = "接着 10 往下 +1";
    }
    如果 (序 == 7)
    {
        s = "_";
    }
    返回 s;
}

// ---- 窗口自己那点状态:写在顶层(照模板;不藏在嵌套里)----
整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                    // 这一帧那"点一下"落在哪儿(x / y)
整数 点y = 0;
整数 序数 = -1;                  // 最后点中的那一格;-1 = 还没点过
整数 光标 = 0;                   // 这一帧指到八格里的第几格(每刷新一帧往下走一格)
逻辑 有一下 = 假;                // 这一帧收到过"点一下"(按下 + 抬起)没有

// ⚠ 字符串数组**不能在声明时给初值**(只能声明后一条条填);数字类的初值则要写在一行里。
//   这四列都是**八格**一格一条(序号 = 左边第几格),底下一行按 `光标` 取。
字符串 左格[8];
字符串 表名[8];
字符串 表值[8];
字符串 表意[8];
字符串 值列[8];
字符串 意列[8];
字符串 支列[8];
字符串 例列[8];

// 开窗之前把要画的字**全部**拼好:进主循环之后一条字符串都不再拼(见上面那句「池用完了」)。
// 值那一列不是写死的字面量,是**真算出来再格式化**的 —— 占位符写 `{0}`(`%d` 不报错但值会丢)。
方法 值文(整数 数) 返回 字符串
{
    字符串 s = 格式化("{0}", 数);
    返回 s;
}

// 左边那一格的序号 → 这个成员**真正的值**(序号 5、6 就是 `方向.左 = 10` 与 `方向.右 = 11`)。
// 右边表里"值"那一列与底下一行都从这儿取 —— 与左边格子上写的数字对得上。
方法 成员值(整数 序) 返回 整数
{
    整数 值 = 0;
    如果 (序 == 5)
    {
        值 = 10;
    }
    如果 (序 == 6)
    {
        值 = 11;
    }
    返回 值;
}

// 只用成员那个**裸名**(不带 `颜色.` 前缀):`名单[绿]` 就是本示例里那一行真写过的写法
方法 短名文(整数 序) 返回 字符串
{
    字符串 s = "?";
    如果 (序 == 0)
    {
        s = "赤";
    }
    如果 (序 == 1)
    {
        s = "绿";
    }
    如果 (序 == 2)
    {
        s = "蓝";
    }
    如果 (序 == 3)
    {
        s = "上";
    }
    如果 (序 == 4)
    {
        s = "下";
    }
    如果 (序 == 5)
    {
        s = "左";
    }
    如果 (序 == 6)
    {
        s = "右";
    }
    如果 (序 == 7)
    {
        s = "?";
    }
    返回 s;
}

方法 例句(整数 序) 返回 字符串
{
    字符串 s = "【用】名单[";
    字符串 短 = 短名文(序);
    拼接到(s, 短, "] · 枚举不进 [] 当长度");
    返回 s;
}

// ---- 开窗之前:把每一格、每一行要说的话都变成文字 ----
整数 填 = 0;
当 (填 < 8)
{
    左格[填] = 成员名(填);
    表名[填] = 表名文(填);
    表值[填] = 表值文(填);
    表意[填] = 表意文(填);
    填 = 填 + 1;
}
填 = 0;
当 (填 < 8)
{
    值列[填] = 值文(成员值(填));
    意列[填] = 意思文(填);
    支列[填] = 选支文(填);
    例列[填] = 例句(填);
    填 = 填 + 1;
}

逻辑 开着 = 打开窗口("示例21 枚举", 窗宽, 窗高);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算:左边八格从 `格顶` 起、每格 `格高`;
        // 右边表里第一行从 `行0` 起、每行 `行距`(点多出来的行收口到最后一格)。
        // ⚠ 这一步**单独摆在这一层**:命中测试与赋值别塞进上面那串嵌套里(塞进去实测不落地)。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 12 && 点x < 12 + 格宽 && 点y >= 格顶 && 点y < 格顶 + 7 * 格高)
            {
                序数 = (点y - 格顶) / 格高;
            }
            如果 (点x >= 板左 + 10 && 点x < 板左 + 板宽 - 10 && 点y >= 行0 && 点y < 行0 + 7 * 行距)
            {
                序数 = (点y - 行0) / 行距;
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼,画的都是开窗前拼好的)----
            清屏(0xFF101018);
            画矩形(12, 12, 窗宽 - 24, 40, 0xFF2A3550);
            画文字(24, 16, "示例21 枚举:成员名 ↔ 数字,一格一个成员", 0xFFE8E8F0);
            画文字(24, 34, "左边点一格选成员 ⇒ 右边换成它的值;蓝底每帧往下走一格", 0xFFB0B0B8);

            // ⚠ 底色一律画在文字**之前**:`画矩形` 是不透明实心,画在文字后面会把那一行的字盖掉
            //   (无头呈现看不出来,桌面壳上才看得出来)。
            画矩形(12, 格顶, 格宽, 7 * 格高, 0xFF16161E);
            画矩形(12, 格顶 + 光标 * 格高, 格宽, 30, 0xFF2A6EF0);
            如果 (序数 >= 0)
            {
                画矩形(12, 格顶 + 序数 * 格高, 格宽, 30, 0xFF2FA84F);   // 刚点中的那一格:亮绿
            }
            如果 (鼠标x >= 12 && 鼠标x < 12 + 格宽 && 鼠标y >= 格顶 && 鼠标y < 格顶 + 7 * 格高)
            {
                整数 悬 = (鼠标y - 格顶) / 格高;
                如果 (悬 != 光标 && 悬 != 序数)
                {
                    画矩形(12, 格顶 + 悬 * 格高, 格宽, 30, 0xFF232B3E);   // 鼠标正压着的那一格
                }
            }
            整数 格 = 0;
            当 (格 < 7)
            {
                画文字(22, 格顶 + 格 * 格高 + 11, 左格[格], 0xFFD0D0D8);
                格 = 格 + 1;
            }

            // 右边那一块:这一格是哪个枚举的、值是多少、这一档什么意思
            画矩形(板左, 格顶, 板宽, 200, 0xFF16161E);
            画文字(板左 + 10, 格顶 + 8, 全名文(光标), 0xFF9CC4FF);
            画文字(板左 + 10, 格顶 + 30, "值 = 数字,成员就是编译期常量", 0xFFB0B0B8);
            画矩形(板左 + 10, 124, 板宽 - 20, 20, 0xFF232B3E);
            画文字(板左 + 16, 127, "成员", 0xFF9CC4FF);
            画文字(374, 127, "值", 0xFF9CC4FF);
            画文字(板左 + 110, 127, "这一档什么意思", 0xFF9CC4FF);

            整数 r = 0;
            当 (r < 7)
            {
                整数 行y = 行0 + r * 行距;
                如果 (r == 光标)
                {
                    画矩形(板左 + 10, 行y, 板宽 - 20, 28, 0xFF2A6EF0);   // 这一帧指到的那一格:蓝
                }
                否则
                {
                    如果 (r == 序数)
                    {
                        画矩形(板左 + 10, 行y, 板宽 - 20, 28, 0xFF2FA84F);   // 刚点中的那一格:亮绿
                    }
                    否则
                    {
                        画矩形(板左 + 10, 行y, 板宽 - 20, 28, 0xFF1A1A22);
                    }
                }
                画文字(板左 + 16, 行y + 8, 表名[r], 0xFFD0D0D8);
                画文字(374, 行y + 8, 表值[r], 0xFFE8E8F0);
                画文字(板左 + 110, 行y + 8, 表意[r], 0xFFD0D0D8);
                r = r + 1;
            }

            画线(12, 330, 窗宽 - 12, 330, 0xFF3C3C46);
            画文字(20, 342, 值列[光标], 0xFFE8E8F0);
            画文字(20, 374, 意列[光标], 0xFFE8E8F0);
            画文字(20, 406, 支列[光标], 0xFFE8E8F0);
            画文字(20, 438, 例列[光标], 0xFFD0D0D8);
            画文字(20, 470, "底色:蓝 = 这一帧指到的,绿 = 刚点中的;点左边一格或右边一行都能选", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)

            // 逐帧推进:每刷新一帧,蓝底往下走一格;走到最后一个成员就绕回第一个
            光标 = 光标 + 1;
            如果 (光标 >= 7)
            {
                光标 = 0;
            }
        }
    }

    关闭窗口();
}

停止

