// ============================================================
// 示例52_校验与几何:批 19 那七个库一起走一遍
//   `Sample\库\` 里的 命令行选项 / 剖析 / 校验和 / RLE / 唯一号 / 单位换算 / 几何
//
//   ① 命令行选项:一条命令行拆成"开关 / 键值 / 位置参数"三样(引号包住的整段算一个)。
//      ⚠ 语言里没有"读 argv"的宿主能力 ⇒ 这一库收的是**一整条字符串**,
//      从哪儿来由调用方决定(读一行 / 读配置 / 从环境变量凑)。
//   ② 校验和:CRC32(与 zlib 的 `crc32` 逐位同)+ FNV-1a 32 + 逐字节和;
//      分块那三件套(初值 → 续 → 收尾)与"一次算完"给的是同一个数。
//   ③ RLE:一串相同的字节压成一对(计数, 值);压完再解回来逐字节同。
//   ④ 唯一号:35 个字符的 `8-8-8-8`(当前秒 / 随机 / 开机毫秒 / 计数);
//      这一篇只打"格式对不对、两次一不一样"(真的号每次都不同,不能写进预期输出)。
//   ⑤ 单位换算:钱一律以分进出(浮点存钱是坑)、时长文字、秒表格式、大小文字、度 ↔ 微弧度。
//   ⑥ 几何:点 / 矩形 / 线段那一套判定(全整数;左上角闭、右下角开)。
//   ⑦ 剖析:一个阶段两头各插一句,次数 / 总毫秒 / 平均 / 最大它替你攒着。
//      这一篇只打**次数**与"那几个数不小于 0"(毫秒是墙上量出来的,不能写进预期输出);
//      报表的格式用 `清零` 之后那一份(全是 0)来演示。
//
//   ⚠ 全程 `测试输出` / `输出行`;末尾那一行 `// 预期输出` 逐行可对(不碰盘、不碰网络、不碰窗口)。
// ============================================================
包含 "../../库/命令行选项.hb"
包含 "../../库/校验和.hb"
包含 "../../库/RLE.hb"
包含 "../../库/唯一号.hb"
包含 "../../库/单位换算.hb"
包含 "../../库/几何.hb"
包含 "../../库/剖析.hb"

整数 序号 = 0;

// ---------------- ① 命令行选项:一条命令行拆开 ----------------
//   `--端口 8080`(下一个记号当值)、`--宽=640`(等号那一档)、`--详细`(纯开关)、
//   `"输入 文件.txt"`(引号里的空格不切)、`输出.txt`(位置参数)。
//   ⚠ **纯开关后面紧跟位置参数会被当成它的值**(这是"下一个记号当值"那条口径的另一面)——
//     所以 `--详细` 写在最后;要么让它后面紧跟着另一个以 `-` 开头的记号。
测试输出(命令行选项.解析("--端口 8080 --宽=640 --高=480 \"输入 文件.txt\" 输出.txt --详细"));    // 6
测试输出(命令行选项.个数());                             // 4(端口 / 宽 / 高 / 详细)
测试输出(命令行选项.位置个数());                         // 2
测试输出(命令行选项.取整数("端口", 80));                // 8080
测试输出(命令行选项.取整数("宽", 0));                   // 640
测试输出(命令行选项.取整数("高", 0));                   // 480
测试输出(命令行选项.开关("详细"));                      // 1(在册且没有值)
测试输出(命令行选项.开关("端口"));                      // 0(它有值)
字符串 第一位 = 命令行选项.位置(0);
输出行(第一位);                                          // 输入 文件.txt
字符串 第二位 = 命令行选项.位置(1);
输出行(第二位);                                          // 输出.txt
字符串 缺省值 = 命令行选项.取("没有这个键", "(没给)");    // 取不到就给缺省
输出行(缺省值);
测试输出(命令行选项.从环境("HB_示例52_绝对没有这个变量"));    // 0(没设 / 宿主没挂能力都是 0)

// ---------------- ② 校验和:CRC32 / FNV-1a 32 / 逐字节和 ----------------
无符号整数 标准值 = 校验和.CRC32串("123456789");           // 标准检验值 0xCBF43926
测试输出(标准值);                                          // 3421780262
无符号整数 空串值 = 校验和.CRC32串("");                    // 空串给 0
测试输出(空串值);                                          // 0
无符号整数 fnv值 = 校验和.FNV("123456789");
测试输出(fnv值);                                          // 3146166556
无符号整数 和校验值 = 校验和.和校验串("ABC");                // 65 + 66 + 67
测试输出(和校验值);                                          // 198
// 块那一半 + 分块三件套:第一块放 "1234"、第二块放 "56789",拼起来与一次算完的同一个数。
地址 前块 = 申请(16);
地址 后块 = 申请(16);
存字(前块, 0, 49 + 50 * 256 + 51 * 65536 + 52 * 16777216);
存字(前块, 4, 0);
存字(前块, 8, 0);
存字(前块, 12, 0);
存字(后块, 0, 53 + 54 * 256 + 55 * 65536 + 56 * 16777216);
存字(后块, 4, 57);
存字(后块, 8, 0);
存字(后块, 12, 0);
测试输出(校验和.和校验(前块, 4));                       // 202
无符号整数 分块 = 校验和.CRC32初值();
分块 = 校验和.CRC32续(分块, 前块, 4);
分块 = 校验和.CRC32续(分块, 后块, 5);
无符号整数 分块和 = 校验和.CRC32收尾(分块);
测试输出(分块和);                                        // 3421780262(与上面 `标准值` 同)
释放(前块);
释放(后块);

// ---------------- ③ RLE:20 个 'A' + 6 个 'B' ----------------
字符 源区[64];
字符 压区[128];
字符 回区[64];
序号 = 0;
当 (序号 < 20)
{
    源区[序号] = 65;
    序号 = 序号 + 1;
}
当 (序号 < 26)
{
    源区[序号] = 66;
    序号 = 序号 + 1;
}
测试输出(RLE.压后长度(源区, 26));                       // 4(两对)
测试输出(RLE.压(源区, 26, 压区, 128));                  // 4
测试输出(RLE.压(源区, 26, 压区, 2));                    // -1(容量不够,一个字节都不写)
整数 回长 = RLE.解(压区, 4, 回区, 64);
测试输出(回长);                                          // 26
测试输出(回区[0]);                                       // 65
测试输出(回区[19]);                                      // 65
测试输出(回区[25]);                                      // 66
测试输出(RLE.解(压区, 4, 回区, 10));                    // -1(解出来要 26 个字节)
测试输出(RLE.解(压区, 3, 回区, 64));                    // -1(尾巴不成对)

// ---------------- ④ 唯一号:格式与"两次不一样" ----------------
随机.设种子(1);
字符串 首号 = 唯一号.唯一号();
字符串 次号 = 唯一号.唯一号();
测试输出(唯一号.是唯一号(首号));                        // 1
测试输出(首号 == 次号);                                  // 0(同一秒里两次也不同:计数那一段在走)
测试输出(首号.长度());                                   // 35
测试输出(唯一号.计数());                                 // 2
唯一号.清零();
测试输出(唯一号.计数());                                 // 0

// ---------------- ⑤ 单位换算:钱 / 时长 / 大小 / 角度 ----------------
整数 分 = 0;
整数 认得 = 单位换算.元转分("19.90", 分);
测试输出(认得);                                          // 1
测试输出(分);                                            // 1990
字符串 元文 = 单位换算.分转元(分);
输出行(元文);                                            // 19.90
元文 = 单位换算.分转元(-5);
输出行(元文);                                            // -0.05
元文 = 单位换算.时长文本(3661);
输出行(元文);                                            // 1 小时 1 分 1 秒
元文 = 单位换算.时长文本毫秒(3723456);
输出行(元文);                                            // 1:02:03.456
元文 = 单位换算.字节转大小文本(1536000);
输出行(元文);                                            // 1.5 MB
测试输出(单位换算.时分秒转秒(1, 1, 1));                 // 3661
测试输出(单位换算.度转微弧度(90));                       // 1570770
测试输出(单位换算.微弧度转度(1570796));                  // 90

// ---------------- ⑥ 几何:点 / 矩形 / 线段 ----------------
测试输出(几何.点在矩形内(5, 5, 0, 0, 10, 10));          // 1
测试输出(几何.点在矩形内(10, 5, 0, 0, 10, 10));         // 0(右边是开的)
测试输出(几何.矩形相交(0, 0, 10, 10, 8, 8, 5, 5));       // 1
测试输出(几何.交宽(0, 10, 8, 5));                        // 2
测试输出(几何.交高(0, 10, 8, 5));                        // 2
测试输出(几何.交宽(0, 10, 10, 5));                       // 0(边挨着边不算交)
测试输出(几何.距离平方(0, 0, 3, 4));                    // 25
测试输出(几何.距离(0, 0, 3, 4));                        // 5
测试输出(几何.线段相交(0, 0, 10, 10, 0, 10, 10, 0));     // 1(交叉)
测试输出(几何.线段相交(0, 0, 10, 0, 0, 5, 10, 5));        // 0(平行)
测试输出(几何.线段相交(0, 0, 10, 0, 5, 0, 15, 0));        // 1(共线搭上)
测试输出(几何.点在线段上(5, 5, 0, 0, 10, 10));           // 1
测试输出(几何.点在线段上(5, 6, 0, 0, 10, 10));           // 0

// ---------------- ⑦ 剖析:一段活两头各插一句 ----------------
剖析.开始("就算这一趟");
序号 = 0;
整数 累计 = 0;
当 (序号 < 200)
{
    累计 = 累计 + 序号;
    序号 = 序号 + 1;
}
整数 这一趟 = 剖析.结束("就算这一趟");
测试输出(累计);                                          // 19900
测试输出(这一趟 >= 0);                                   // 1(毫秒数是墙上量的,只判"不小于 0")
测试输出(剖析.次数("就算这一趟"));                        // 1
测试输出(剖析.总毫秒("就算这一趟") >= 0);                 // 1
测试输出(剖析.最大毫秒("就算这一趟") >= 0);               // 1
测试输出(剖析.平均毫秒("就算这一趟") >= 0);               // 1
测试输出(剖析.是空的());                                 // 0
剖析.清零();
字符串 表 = 剖析.报表();
输出行(表);                                              // 就算这一趟  次数=0  总毫秒=0  平均毫秒=0  最大毫秒=0
停止

// 预期输出: 6|4|2|8080|640|480|1|0|输入 文件.txt|输出.txt|(没给)|0|3421780262|0|3146166556|198|202|3421780262|4|4|-1|26|65|65|66|-1|-1|1|0|35|2|0|1|1990|19.90|-0.05|1 小时 1 分 1 秒|1:02:03.456|1.5 MB|3661|1570770|90|1|0|1|2|2|0|25|5|1|0|1|1|0|19900|1|1|1|1|1|0|就算这一趟  次数=0  总毫秒=0  平均毫秒=0  最大毫秒=0
