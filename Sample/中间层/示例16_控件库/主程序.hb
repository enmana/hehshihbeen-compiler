// ============================================================
// 示例16:控件库(`Sample\库\界面.hb`)—— 布局 / 命中测试 / 重绘调度
//
//   这一批要证的事:**控件是 HB 自己写的**(路线 a:即时模式自绘,框架只给"窗口 + 像素 + 输入")。
//   库里有四样控件:标签 / 按钮 / 文本框 / 列表,全按"一屏一表"的即时模式办 ——
//     · **布局**:`建界面` 定列宽与落点,`加标签 / 加按钮 / 加文本框 / 加列表` 依次往下堆;
//     · **命中测试**:`命中控件` 从后往前找(后加的盖在上面),列表再往里算一行;
//     · **重绘调度**:改了就 `标脏`,`要重画` 问一句,`重画` 才真发绘制命令(回来的是条数);
//     · **状态机**:按下 + 抬起才算"点一下"(`取点击` 取一次清掉);文本框拿焦点吃键盘,退格删一个字。
//
//   输入还是宿主那一套:`取事件(类型, 键码, x, y)` 轮询。旁边的 `事件脚本.txt` 是一份写死的输入
//   (第几帧投哪条事件),自检与 `hbcc --run --事件脚本 …` 按它喂 ⇒ **不开窗也能把这一屏跑得一模一样**
//   (硬规矩 6)。第 0~5 帧有事件(点按钮 / 敲字 / 点列表),第 6~7 帧什么都没发生 —— 于是能看见
//   "干净的一帧一条绘制命令都不发,只推进节拍"。
//
//   循环**转到用户自己关窗**(H37,第226批):`取事件` 收到 类型 == 1 就 `收手`(照示例15 那一套)
//   —— 真窗口上想看多久看多久,不再是"两秒自己退出"。无头那条路没有人去关,由脚本的 `帧数 8` 投一个
//   关窗请求 ⇒ 两条路收在同一个地方,文件末尾那行期望输出**一个字没改**(开工先量过一遍才动的手)。
// ============================================================
包含 "../../库/界面.hb"

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;

// ---- 建界面:纵向堆叠,左 12 / 上 12 / 宽 200 / 间距 8 ----
界面 表单;
建界面(表单, 12, 12, 200, 8);
整数 标题号 = 加标签(表单, "HB 控件库演示");
整数 按钮号 = 加按钮(表单, "确定");
整数 输入号 = 加文本框(表单, "");
整数 列表号 = 加列表(表单, 3, 22);
加列表项(表单, 列表号, 0, "第一项");
加列表项(表单, 列表号, 1, "第二项");
加列表项(表单, 列表号, 2, "第三项");

// ---- ① 布局:落点一个个往下推(开窗之前就能问)----
测试输出(控件数(表单));                       // 4
测试输出(控件上(表单, 标题号));                // 12
测试输出(控件上(表单, 按钮号));                // 42
测试输出(控件上(表单, 输入号));                // 80
测试输出(控件上(表单, 列表号));                // 118
测试输出(控件高(表单, 列表号));                // 66(3 行 × 22)
逻辑 放得下 = 加列表项(表单, 列表号, 3, "第四项");
测试输出(放得下);                              // 假:只有 3 行,放不下
测试输出(列表行数(表单, 列表号));              // 3

// ---- ② 命中测试:从后往前找;不在控件上给 -1 ----
测试输出(命中控件(表单, 100, 20));             // 0 标签
测试输出(命中控件(表单, 100, 57));             // 1 按钮
测试输出(命中控件(表单, 100, 95));             // 2 文本框
测试输出(命中控件(表单, 100, 140));            // 3 列表
测试输出(命中控件(表单, 5, 5));                // -1 空白
测试输出(命中行(表单, 列表号, 140));           // 1 第二行
测试输出(命中行(表单, 列表号, 175));           // 2 第三行
测试输出(命中行(表单, 列表号, 115));           // -1 列表上边之上

如果 (打开窗口("HB 控件库演示", 240, 220))
{
    逻辑 收手 = 假;                               // 关窗请求(类型 1)一来就收手 —— 窗口停留到用户自己关
    整数 帧 = 0;
    整数 点 = 0;
    整数 条 = 0;
    当 (!收手)
    {
        // ③ 收事件:这一帧投进来的全取出来,一条条送进库(关窗请求归程序管,库里不碰)
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                          // 点标题栏的叉:这一帧之后不再画(照示例15 那一套)
            }
            否则
            {
                送事件(表单, 类型, 键码, 鼠标x, 鼠标y);
            }
        }

        如果 (!收手)
        {
            点 = 取点击(表单);
            如果 (点 >= 0)
            {
                测试输出(点);                      // 被"点一下"的控件号
            }

            // ④ 重绘调度:脏了才发绘制命令;干净的一帧只推进节拍
            如果 (要重画(表单))
            {
                测试输出(帧);                      // 哪一帧真重画了
                条 = 重画(表单);                   // 这一帧发了几条绘制命令
                测试输出(条);
            }
            否则
            {
                测试输出(-1);                      // 干净:一条绘制命令都不发
            }
            刷新();
            帧 = 帧 + 1;
            等待(250);                             // 每帧停 250 毫秒:不等待就是"一闪就没"(用户实测)。
                                                   // 无头不真等、不产生输出;无人去关就一直转下去
        }
    }

    // ⑤ 跑完看状态:文本框里剩什么、列表选了哪一行
    字符串 输入内容 = 文本框内容(表单, 输入号);
    输出行(输入内容);                              // H(敲了 H、i,又退了一个)
    整数 选中 = 列表选中行(表单, 列表号);
    测试输出(选中);                                // 1
    字符串 第二项 = 列表项文本(表单, 列表号, 1);
    输出行(第二项);                                // 第二项
    逻辑 还要画 = 要重画(表单);
    测试输出(还要画);                              // 假(最后一帧画过之后没再变)
    关闭窗口();
}

停止
// 预期输出: 4|12|42|80|118|66|0|3|0|1|2|3|-1|1|2|-1|打开窗口 标题="HB 控件库演示" 宽=240 高=220|0|10|清屏 颜色=0xFF101018|画文字 x=12 y=16 文本="HB 控件库演示" 颜色=0xFFB0B0B8|画矩形 x=12 y=42 宽=200 高=30 颜色=0xFF2A3550|画文字 x=22 y=49 文本="确定" 颜色=0xFFFFFFFF|画矩形 x=12 y=80 宽=200 高=30 颜色=0xFF1C1C26|画文字 x=20 y=87 文本="" 颜色=0xFFE8E8F0|画矩形 x=12 y=118 宽=200 高=66 颜色=0xFF16161E|画文字 x=20 y=122 文本="第一项" 颜色=0xFFD0D0D8|画文字 x=20 y=144 文本="第二项" 颜色=0xFFD0D0D8|画文字 x=20 y=166 文本="第三项" 颜色=0xFFD0D0D8|刷新 命令=10|1|10|清屏 颜色=0xFF101018|画文字 x=12 y=16 文本="HB 控件库演示" 颜色=0xFFB0B0B8|画矩形 x=12 y=42 宽=200 高=30 颜色=0xFF2A6EF0|画文字 x=22 y=49 文本="确定" 颜色=0xFFFFFFFF|画矩形 x=12 y=80 宽=200 高=30 颜色=0xFF1C1C26|画文字 x=20 y=87 文本="" 颜色=0xFFE8E8F0|画矩形 x=12 y=118 宽=200 高=66 颜色=0xFF16161E|画文字 x=20 y=122 文本="第一项" 颜色=0xFFD0D0D8|画文字 x=20 y=144 文本="第二项" 颜色=0xFFD0D0D8|画文字 x=20 y=166 文本="第三项" 颜色=0xFFD0D0D8|刷新 命令=10|1|2|10|清屏 颜色=0xFF101018|画文字 x=12 y=16 文本="HB 控件库演示" 颜色=0xFFB0B0B8|画矩形 x=12 y=42 宽=200 高=30 颜色=0xFF2A3550|画文字 x=22 y=49 文本="确定" 颜色=0xFFFFFFFF|画矩形 x=12 y=80 宽=200 高=30 颜色=0xFF1C1C26|画文字 x=20 y=87 文本="" 颜色=0xFFE8E8F0|画矩形 x=12 y=118 宽=200 高=66 颜色=0xFF16161E|画文字 x=20 y=122 文本="第一项" 颜色=0xFFD0D0D8|画文字 x=20 y=144 文本="第二项" 颜色=0xFFD0D0D8|画文字 x=20 y=166 文本="第三项" 颜色=0xFFD0D0D8|刷新 命令=10|3|10|清屏 颜色=0xFF101018|画文字 x=12 y=16 文本="HB 控件库演示" 颜色=0xFFB0B0B8|画矩形 x=12 y=42 宽=200 高=30 颜色=0xFF2A3550|画文字 x=22 y=49 文本="确定" 颜色=0xFFFFFFFF|画矩形 x=12 y=80 宽=200 高=30 颜色=0xFF1C1C26|画文字 x=20 y=87 文本="" 颜色=0xFFE8E8F0|画矩形 x=12 y=118 宽=200 高=66 颜色=0xFF16161E|画文字 x=20 y=122 文本="第一项" 颜色=0xFFD0D0D8|画文字 x=20 y=144 文本="第二项" 颜色=0xFFD0D0D8|画文字 x=20 y=166 文本="第三项" 颜色=0xFFD0D0D8|刷新 命令=10|4|11|清屏 颜色=0xFF101018|画文字 x=12 y=16 文本="HB 控件库演示" 颜色=0xFFB0B0B8|画矩形 x=12 y=42 宽=200 高=30 颜色=0xFF2A3550|画文字 x=22 y=49 文本="确定" 颜色=0xFFFFFFFF|画矩形 x=12 y=80 宽=200 高=30 颜色=0xFF1C1C26|画文字 x=20 y=87 文本="H" 颜色=0xFFE8E8F0|画线 x1=21 y1=85 x2=21 y2=105 颜色=0xFF2A6EF0|画矩形 x=12 y=118 宽=200 高=66 颜色=0xFF16161E|画文字 x=20 y=122 文本="第一项" 颜色=0xFFD0D0D8|画文字 x=20 y=144 文本="第二项" 颜色=0xFFD0D0D8|画文字 x=20 y=166 文本="第三项" 颜色=0xFFD0D0D8|刷新 命令=11|5|11|清屏 颜色=0xFF101018|画文字 x=12 y=16 文本="HB 控件库演示" 颜色=0xFFB0B0B8|画矩形 x=12 y=42 宽=200 高=30 颜色=0xFF2A3550|画文字 x=22 y=49 文本="确定" 颜色=0xFFFFFFFF|画矩形 x=12 y=80 宽=200 高=30 颜色=0xFF1C1C26|画文字 x=20 y=87 文本="H" 颜色=0xFFE8E8F0|画矩形 x=12 y=118 宽=200 高=66 颜色=0xFF16161E|画文字 x=20 y=122 文本="第一项" 颜色=0xFFD0D0D8|画矩形 x=13 y=140 宽=198 高=22 颜色=0xFF2A6EF0|画文字 x=20 y=144 文本="第二项" 颜色=0xFFD0D0D8|画文字 x=20 y=166 文本="第三项" 颜色=0xFFD0D0D8|刷新 命令=11|-1|刷新 命令=0|-1|刷新 命令=0|H|1|第二项|0|关闭窗口
