// ============================================================
// 示例32_数据表:G3 域 4 —— 数据库取 c(`30~33` 判定不做),交付 `Sample\库\数据表.hb`
//
//   这一域拍板取的是 **c**:SQL 那半(打开库 / 执行语句 / 取一行 / 事务)**判定不做、号留空**,
//   把"数据库"落地成**文件型定长记录表** —— 只用现有的文件能力与 G3 流(`48~54`),
//   零新能力号、零依赖。**这一篇不是 SQL**。
//
//   表在盘上就是一个**平铺的字节流**:第 i 条记录的落点正好是 `i × 记录长` 字节,
//   所以"第几条"是一句乘法 —— 不用索引文件、不用表头、不用把表读进内存。
//
//   四条口径(整个库设计的地基,都是本批**实测**出来的):
//     ① **追加只能靠 `追加写文件`** —— `打开写流` 一开就把文件清空
//        (`FileMode.Create` / C 后端 `"wb"`;实测:16 字节的文件打开写流、只写 4 字节,
//         盘上就只剩 4 字节,旧尾巴没了),所以"接到表尾"只有 `追加写文件` 这一条路;
//     ② **记录长 / 主键偏移一律按字节算** —— `.长度()` 数的是**文字**
//        (实测:"汉字ab" 的 `.长度()` 是 4,而它占 8 个字节),所以要按字节切就得用
//        库里的 `字节长` / `取字节段`;
//     ③ **`读一块` 的上限必须是编译期字面量** —— 库里钉死"一条记录 8 字节";
//     ④ **记录不许写半条** —— 字节数不正好等于 `记录长` 就拒收(返回 -1)。
//
//   注:这一篇的记录一律用 **ASCII**(8 个字节 = 8 个字母数字)—— 这样每条记录都能原样回显,
//   末尾那行期望输出才对得上(自检收那一行时会**逐行裁掉行尾空白**,行尾带空格的记录会被吃掉尾巴;
//   所以"补位到 8 字节"那一条在这里只量字节数,不把补出来的那条放进表;
//   真要用 `数据表.补足(文本, 8)` 补位,库本身是支持的 —— 自检分组 `数据表库` 里真跑过)。
//
//   这一篇**只碰自己的临时工作目录**(跑完自己清干净),不碰网络、不碰别的示例的文件。
// ============================================================
包含 "../../库/数据表.hb"

字符串 目录 = "工具/临时/示例32";
字符串 名单 = "工具/临时/示例32/名单.bin";
字符串 日志 = "工具/临时/示例32/日志.bin";
字符串 显示 = "";

输出行(建目录(目录));                                     // 1

// ---------------- ① 先钉住"记录长按字节数"这件事 ----------------
输出行(数据表.字节长("汉字ab"));                           // 8:两个汉字各 3 字节 + 两个字母
字符串 混 = "汉字ab";
输出行(混.长度());                                         // 4:`.长度()` 数的是**文字**,不是字节

// ---------------- ② 建表 + 追加:每条 8 字节(主键 = 头 4 字节) ----------------
输出行(数据表.建表(名单));                                 // 1
输出行(数据表.记录数(名单, 8));                            // 0:空表
输出行(数据表.追加(名单, 8, "0001AAAA"));                  // 0:第一条的序号
输出行(数据表.追加(名单, 8, "0002BBBB"));                  // 1
输出行(数据表.追加(名单, 8, "0003CCCC"));                  // 2
输出行(数据表.记录数(名单, 8));                            // 3
输出行(数据表.总字节数(名单));                             // 24:3 条 × 8 字节

// 记录长不对 ⇒ 拒收(表里永远不会出现"半条"把后面全错位)
输出行(数据表.追加(名单, 8, "0004DDD"));                   // -1:那是 7 字节
输出行(数据表.追加(名单, 8, "0004DDDDD"));                 // -1:那是 9 字节
输出行(数据表.记录数(名单, 8));                            // 3:拒收的不算数

// ---------------- ③ 按主键取:键 4 字节、偏移 0 ----------------
输出行(数据表.按主键取(名单, 8, 0, "0002"));               // 0002BBBB
输出行(数据表.按主键取(名单, 8, 0, "0003"));               // 0003CCCC
输出行(数据表.按主键取(名单, 8, 0, "9999"));               // (空):没有这一条
输出行(数据表.按主键取(名单, 8, 0, "000"));                // (空):键必须正好 4 字节
输出行(数据表.按主键取(名单, 8, 6, "0002"));               // (空):主键偏移越界(6 + 4 > 8)

// ---------------- ④ 按序号取 + 补足(补位那条只量字节数,不进表) ----------------
输出行(数据表.取记录(名单, 0, 8));                         // 0001AAAA
输出行(数据表.取记录(名单, 1, 8));                         // 0002BBBB
输出行(数据表.取记录(名单, 4, 8));                         // (空):越界
输出行(数据表.取记录(名单, -1, 8));                        // (空):负数
显示 = 数据表.补足("0004DD", 8);                            // 6 字节补成 8(**补的是空格**)
输出行(数据表.字节长(显示));                               // 8:这就是"要补位就补足"那一条
输出行(数据表.追加(名单, 8, "0004DDDD"));                  // 3
输出行(数据表.记录数(名单, 8));                            // 4
输出行(数据表.按主键取(名单, 8, 0, "0004"));               // 0004DDDD
输出行(数据表.字节长(数据表.取记录(名单, 3, 8)));          // 8:整条就是 8 字节

// ---------------- ⑤ 拉模式遍历:一条一条读,不整表进内存 ----------------
输出行(数据表.开始遍历(名单) > 0);                        // 1
整数 数到 = 0;
字符串 这条 = 数据表.下一条(8);
当 (这条 != "")                                            // 空串 = 没有下一条
{
    显示 = 格式化("[{0}]", 这条);
    输出行(显示);
    数到 = 数到 + 1;
    这条 = 数据表.下一条(8);
}
输出行(数到);                                              // 4
输出行(数据表.结束遍历());                                 // 1
输出行(数据表.下一条(8));                                  // (空):流已经关了

// ---------------- ⑥ 失败那条路:打不开的表 ----------------
输出行(数据表.记录数("工具/临时/示例32/没有这个.bin", 8));  // -1
输出行(数据表.总字节数("工具/临时/示例32/没有这个.bin"));   // -1

// ---------------- ⑦ 当"只往后追加的日志表"用(主键挪到偏移 4 那一档) ----------------
//   这一档键 = 记录里的第 5~8 个字节;这里拿"序号"当键的位置占位,前半段随便填
输出行(数据表.建表(日志));                                 // 1
输出行(数据表.追加(日志, 8, "AAAA0001"));                  // 0
输出行(数据表.追加(日志, 8, "BBBB0002"));                  // 1
输出行(数据表.按主键取(日志, 8, 4, "0002"));               // BBBB0002
输出行(数据表.按主键取(日志, 8, 4, "0001"));               // AAAA0001
输出行(数据表.按主键取(日志, 8, 4, "9999"));               // (空)

// ---------------- 收尾:把自己造的文件 / 目录清干净 ----------------
输出行(删文件(名单));                                      // 1
输出行(删文件(日志));                                      // 1
输出行(删目录(目录));                                      // 1

// 预期输出: 1|8|4|1|0|0|1|2|3|24|-1|-1|3|0002BBBB|0003CCCC||||0001AAAA|0002BBBB|||8|3|4|0004DDDD|8|1|[0001AAAA]|[0002BBBB]|[0003CCCC]|[0004DDDD]|4|1||-1|-1|1|0|1|BBBB0002|AAAA0001||1|1|1
