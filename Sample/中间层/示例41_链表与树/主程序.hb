// ============================================================
// 示例41_链表与树(G4 批 9:`链表.hb` · `树.hb` 两个库)
//
//   两个"堆上节点"的库,各演示一段真用得上的活:
//     · `Sample\库\链表.hb` —— **双向链表**:开一份名单,前插 / 后插 / 正着走 / 倒着走 /
//       按值找 / 按值删 / 按序号取 / 到数组 / 销毁
//       (16 个公开函数:新建 / 销毁 / 清掉 / 是空 / 个数 / 前插 / 后插 / 按值删 / 按值找 /
//        取第几个 / 到数组 / 从头 / 从尾 / 下一项 / 上一项 / 当前)
//     · `Sample\库\树.hb` —— **二叉查找树**:插一批数,**中序遍历出来就是从小到大**;
//       查找 / 最小 / 最大 / 高度 / 到数组,三种删除(叶子 / 一个孩子 / 两个孩子)各来一次
//       (15 个公开函数:新建 / 销毁 / 清掉 / 是空 / 个数 / 插入 / 查找 / 删除 / 最小 / 最大 /
//        高度 / 到数组 / 最小游标 / 下一项 / 当前)
//
//   四条口径(演示里照它走,细节看各库的头注释):
//     ① **节点真申请真释放**:`新建` 从堆里要一块当"家",插一个节点要一块,`销毁` 全还回去
//        (`清掉` 只还节点、家留着还能用);语言没有 GC,用完自己还;
//     ② **迭代器走"拉模式"**:`从头 / 从尾 / 最小游标` 交出**游标**,`当 (下一项(游标, 值))`
//        一句一句地要,到头给 `假`(与 `基础库框架.md` §8.4 同一套);
//     ③ **越界 / 空表一律不报错**:`取第几个` 越界给 `假`(不动 `收值`)、`按值找` 没有给 -1、
//        `最小 / 最大` 空树给 `假`、`从头` 空表给 0(`当` 一次都不进);
//     ④ **树里的重复值一律拒绝**(`插入` 给 `假`):查找树的价值在"每个值最多一个位置"。
// ============================================================
包含 "../../库/链表.hb"
包含 "../../库/树.hb"

// ---------------- ① 链表:一份名单 ----------------
整数 名单 = 链表.新建();
输出行(链表.是空(名单));            // 1
链表.后插(名单, 30);
链表.后插(名单, 40);
链表.前插(名单, 20);
链表.前插(名单, 10);
输出行(链表.个数(名单));            // 4
整数 游标 = 链表.从头(名单);
整数 值 = 0;
当 (链表.下一项(游标, 值))
{
    输出行(值);                       // 从前往后:10 / 20 / 30 / 40
}
输出行(链表.当前(游标));            // 0:游标已经走到头
游标 = 链表.从尾(名单);
当 (链表.上一项(游标, 值))
{
    输出行(值);                       // 从后往前:40 / 30 / 20 / 10
}
输出行(链表.按值找(名单, 30));       // 2
输出行(链表.按值找(名单, 99));       // -1:没有
链表.后插(名单, 30);
输出行(链表.按值删(名单, 30));       // 2:两个 30 一起删
输出行(链表.个数(名单));            // 3
整数 一份[8];
输出行(链表.到数组(名单, 一份));     // 3
输出行(一份[0]);                      // 10
输出行(一份[2]);                      // 40
输出行(链表.取第几个(名单, 1, 值));   // 1
输出行(值);                           // 20
输出行(链表.取第几个(名单, 9, 值));   // 0:越界
输出行(值);                           // 20:不动 `收值`
链表.清掉(名单);
输出行(链表.是空(名单));            // 1(家还在,还能接着插)
链表.后插(名单, 7);
输出行(链表.个数(名单));            // 1
链表.销毁(名单);                      // 节点与控制块一起还回堆里

// ---------------- ② 树:一批数排成一棵查找树 ----------------
整数 树根 = 树.新建();
输出行(树.是空(树根));               // 1
树.插入(树根, 50);
树.插入(树根, 30);
树.插入(树根, 70);
树.插入(树根, 20);
树.插入(树根, 40);
树.插入(树根, 80);
输出行(树.插入(树根, 50));           // 0:重复值不收
输出行(树.个数(树根));               // 6
输出行(树.高度(树根));               // 3
输出行(树.查找(树根, 40));           // 1
输出行(树.查找(树根, 99));           // 0
输出行(树.最小(树根, 值));           // 1
输出行(值);                           // 20
输出行(树.最大(树根, 值));           // 1
输出行(值);                           // 80
整数 有序[8];
输出行(树.到数组(树根, 有序));       // 6:中序(从小到大)
整数 i = 0;
当 (i < 6)
{
    输出行(有序[i]);                  // 20 / 30 / 40 / 50 / 70 / 80
    i = i + 1;
}
游标 = 树.最小游标(树根);
当 (树.下一项(游标, 值))
{
    输出行(值);                       // 拉模式再走一遍:20 / 30 / 40 / 50 / 70 / 80
}

// 三种删除各来一次
输出行(树.删除(树根, 20));           // 1:叶子,直接摘
输出行(树.个数(树根));               // 5
输出行(树.删除(树根, 70));           // 1:只有一个孩子(80),让孩子顶上
输出行(树.到数组(树根, 有序));       // 4
输出行(有序[2]);                      // 50
输出行(有序[3]);                      // 80
输出行(树.删除(树根, 50));           // 1:根,两个孩子 —— 拿右子树最小的(80)顶上来
输出行(树.个数(树根));               // 3
输出行(树.高度(树根));               // 2
输出行(树.到数组(树根, 有序));       // 3
输出行(有序[0]);                      // 30
输出行(有序[1]);                      // 40
输出行(有序[2]);                      // 80
输出行(树.删除(树根, 50));           // 0:已经没有了
树.清掉(树根);
输出行(树.是空(树根));               // 1
输出行(树.高度(树根));               // 0
输出行(树.最小(树根, 值));           // 0:空树给 假
输出行(值);                           // 80:不动 `收值`
树.销毁(树根);

// ============================================================
// ---- 带 UI 的那一半(H82 批 4):把内存里的结构真画出来 ----
//
//   上面那 117 行(纯计算 + 全部 `测试输出`)**一个字没动**;这一块接在它们后面、`停止` 之前 ——
//   只有真开得了窗口的宿主才进主循环(没有图形能力的宿主给 假 ⇒ 一个字都不多打)。
//
//   窗口里演的是**另一份**名单与树(上面那份 `名单` 与 `树根` 都已经 `销毁` 还回堆里了),
//   一律只用 `链表.hb` / `树.hb` 的公开函数建(`Sample\库\` 一个字没改):
//     · **上半屏 = 双向链表**:5 个节点画成一排方框(框里是值),两个框之间画**两条箭头** ——
//       上面那条 = 后继(`后`,往右)、下面那条 = 前驱(`前`,往左),"双向"这两个字就是这两条线;
//       当前走到的那一格换蓝底(`画方框` = 外层深色矩形 + 内层缩 2 像素的填充矩形,底色先画、字后画)。
//     · **下半屏 = 二叉树**:7 个节点按层摆(根在第 1 层、左右孩子往下),父子之间连线;
//       点某个节点 ⇒ 底下两行说"第几层 / 左孩子是谁 / 右孩子是谁 / 子树有几个节点"。
//     · **逐帧推进**:每 `刷新()` 进一帧 —— 上半屏沿链表一格一格走(正着 5 步走完、再倒着 4 步走回来,
//       9 步一轮),下半屏换个节点高亮(7 个节点一轮);点一下就把底下那两行钉在你点的那一格
//       (那一格换成金边),没点过就跟着这一帧的游标走。
//     · 窗口一直转到用户自己关(点标题栏的叉);自检 / 命令行靠同目录 `事件脚本.txt`
//       (写死的输入:第 3 / 9 / 16 / 24 帧各投一次点击)跑满 28 帧后由宿主投关窗请求收手。
//
//   ⚠ 主循环里**一条字符串都不产生**:要画的字全在开窗之前拼好、存进 `字符串` 数组,
//     每帧只 `画文字(…, 数组[下标], …)`(字符串数组元素能当内建 `画文字` / `取文字宽度` 的实参,
//     当不了自定义函数的字符串实参 —— 见 `Sample\说明.md` 那张坑表)。每帧现拼会把池吃光。
//   ⚠ 摆位与命中测试**用的是同一组数**(`链距` / `树顶` / `树层距` / `树中`):要挪地方只改这几行。
//   ⚠ 文字宽度按约定 **1 格 = 8 像素** 折算(`取文字宽度(文本) × 8`),格子里的值才画得正。
//   ⚠ 树的**形状**(谁是谁的孩子、在第几层)是照插入顺序写死的几张表 —— `树.hb` 只给了中序迭代,
//     没有"某个值在第几层 / 左孩子是谁"这种查询;框里那些**值**是开窗前用 `到数组`(中序)真问出来的。
// ============================================================
包含 "../../库/string.hb"        // 把数字拼进文字要用库里的 `转字符串`(纯 HB、零依赖)

// ---- 窗口尺寸与摆位:**手算过的一组数**(画图与命中测试用的是同一组)----
//   宽 560:链表 5 个方框(宽 72、左边相距 116 ⇒ 12 / 128 / 244 / 360 / 476)、树的中轴 280
//   高 540:页眉 12~56 / 链表 58~174 / 树 180~406 / 分割线 424 / 页脚 434~512
整数 窗宽 = 560;
整数 窗高 = 540;
整数 链顶 = 88;                  // 链表那一排方框的顶边
整数 链宽 = 72;                  // 一个方框多宽
整数 链高 = 36;                  // 一个方框多高
整数 链距 = 116;                 // 两个方框的左边相距多少(= 命中测试的除数)
整数 树顶 = 208;                 // 树第 1 层(根)那一排的顶边
整数 树层距 = 58;                // 上下两层相距多少(= 命中测试的除数)
整数 树宽 = 60;                  // 树节点多宽
整数 树高 = 30;                  // 树节点多高
整数 树中 = 280;                 // 整棵树的中轴(根的中心 x)

// ---- 窗口自己要记住的那几格:写在**顶层**(照模板;不藏在嵌套里)----
整数 类型 = 0;                   // 取事件那四个出参
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                    // 这一帧"点一下"落在哪儿(先记下来,浅一层再结算)
整数 点y = 0;
整数 选链 = -1;                  // 点中的链表节点(-1 = 还没点过)
整数 选树 = -1;                  // 点中的树节点(-1 = 还没点过)
整数 链游标 = 0;                 // 这一帧上半屏亮在第几格
整数 树游标 = 0;                 // 这一帧下半屏亮在第几个节点(布局序)
整数 帧步 = 0;                   // 逐帧推进走到第几步(0~62 一轮 = 9 与 7 的公倍数)
逻辑 有一下 = 假;                // 这一帧收到过"点一下"没有

// ---- 窗口里演的那一份名单与树:只用两个库的**公开函数**建(库一个字没改)----
整数 链表演 = 链表.新建();
链表.后插(链表演, 10);
链表.后插(链表演, 20);
链表.后插(链表演, 30);
链表.后插(链表演, 40);
链表.后插(链表演, 50);
整数 树演 = 树.新建();
树.插入(树演, 50);
树.插入(树演, 30);
树.插入(树演, 70);
树.插入(树演, 20);
树.插入(树演, 40);
树.插入(树演, 60);
树.插入(树演, 80);

// ---- 摆位表与树的形状表(`字符串` 数组不能给初值;这几张都是整数表,初值写在一行里)----
整数 树x[7] = [250, 130, 370, 70, 190, 310, 430];
整数 树y[7] = [208, 266, 266, 324, 324, 324, 324];
整数 取序[7] = [3, 1, 5, 0, 2, 4, 6];          // 布局序 → 中序下标(值是开窗前从 `到数组` 问的)
整数 左孩位[7] = [1, 3, 5, -1, -1, -1, -1];    // 左孩子在布局序里的下标(-1 = 没有)
整数 右孩位[7] = [2, 4, 6, -1, -1, -1, -1];
整数 层号[7] = [1, 2, 2, 3, 3, 3, 3];
整数 子树数[7] = [7, 3, 3, 1, 1, 1, 1];
整数 中序位[7] = [4, 2, 6, 1, 3, 5, 7];

// ---- 这一屏要画的字:全部在**开窗之前**拼好(进主循环之后一条都不再拼)----
字符串 链值列[5];                // 链表 5 格的"值的文字"
字符串 链步文[9];                // 9 步走法各一句(正着 5 步 + 倒着 4 步)
字符串 链点文[5];                // 点中某一格时那句话(第几个 / 前驱 / 后继)
字符串 树值列[7];                // 树 7 个节点的"值的文字"
字符串 树详一[7];                // 点中某个节点:第几层 / 左孩子 / 右孩子
字符串 树详二[7];                // 点中某个节点:这棵子树几个节点 / 中序里排第几
字符串 账文1 = "";               // 库的账(个数 / 高度)
字符串 账文2 = "";               // 中序走出来的那一串

// ---- 一个方框 = 外层深色矩形 + 内层缩 2 像素的填充矩形(a档:没有 `画框` 原语,2 条命令一个框)----
//   态:2 = 这一帧走到的(蓝底) · 1 = 用户点中的(金边) · 0 = 平常
方法 画方框(整数 x, 整数 y, 整数 w, 整数 h, 整数 态)
{
    如果 (态 == 2)
    {
        画矩形(x, y, w, h, 0xFF7AB0FF);
        画矩形(x + 2, y + 2, w - 4, h - 4, 0xFF2A6EF0);
    }
    否则
    {
        如果 (态 == 1)
        {
            画矩形(x, y, w, h, 0xFFD8A040);
            画矩形(x + 2, y + 2, w - 4, h - 4, 0xFF3A3020);
        }
        否则
        {
            画矩形(x, y, w, h, 0xFF4A5570);
            画矩形(x + 2, y + 2, w - 4, h - 4, 0xFF1E2430);
        }
    }
}

// ---- 箭头 4 行:主线 + 尖上两条 6 像素短斜线(a档:没有 `画箭头` 原语;`尖` = +6 往左、-6 往右)----
//   ⚠ 颜色只能当 `无符号整数` 形参传 —— 0xFF…… 这种 32 位色值超出 `整数` 的范围(写 `整数 色` 当场报错)
方法 画箭头(整数 x1, 整数 y1, 整数 x2, 整数 y2, 整数 尖, 无符号整数 色)
{
    画线(x1, y1, x2, y2, 色);
    画线(x2 + 尖, y2 - 4, x2, y2, 色);
    画线(x2 + 尖, y2 + 4, x2, y2, 色);
}

// ---- 开窗之前那一次拼装:值从库里问、话在这儿拼 ----
//   ⚠ 主循环里写 `转字符串(值)` / `格式化(…)` 就是"返回字符串的调用当实参",每调用一次漏一块池;
//     数字必须在**这儿**转成文字(16 帧的脚本看不出来,真窗口挂几百帧就报"池用完了")。
整数 链值[6];
整数 链数 = 链表.到数组(链表演, 链值);
整数 填 = 0;
当 (填 < 5)
{
    链值列[填] = 转字符串(链值[填]);
    填 = 填 + 1;
}

// 9 步走法:前 5 步正着走(从头往后,一格一格往右)、后 4 步倒着走(从尾往前)
整数 k = 0;
当 (k < 9)
{
    整数 游 = k;
    如果 (k >= 5)
    {
        游 = 8 - k;
    }
    字符串 s = "正着走(从头往后):第 ";
    如果 (k >= 5)
    {
        s = "倒着走(从尾往前):第 ";
    }
    拼接到(s, 转字符串(游 + 1), " 格,值 ");
    拼接到(s, 转字符串(链值[游]));
    链步文[k] = s;
    k = k + 1;
}

// 每一格的"前驱 / 后继":真用 `取第几个` 问邻居(两头是 0 ⇒ 说"没有")
k = 0;
当 (k < 5)
{
    整数 前 = -1;
    整数 后 = -1;
    整数 收 = 0;
    如果 (k > 0)
    {
        链表.取第几个(链表演, k - 1, 收);
        前 = 收;
    }
    如果 (k < 4)
    {
        链表.取第几个(链表演, k + 1, 收);
        后 = 收;
    }
    字符串 s = "这一格:第 ";
    拼接到(s, 转字符串(k + 1), " 个,值 ");
    拼接到(s, 链值列[k], " —— 前驱 ");
    如果 (前 < 0)
    {
        拼接到(s, "没有(它是头,前驱是 0)");
    }
    否则
    {
        拼接到(s, 转字符串(前));
    }
    拼接到(s, ",后继 ");
    如果 (后 < 0)
    {
        拼接到(s, "没有(它是尾,后继是 0)");
    }
    否则
    {
        拼接到(s, 转字符串(后));
    }
    链点文[k] = s;
    k = k + 1;
}

// 树的 7 个值:布局序 → 中序下标 → 中序数组里的那个值(值全是库里真问出来的)
整数 序值[8];
整数 树数 = 树.到数组(树演, 序值);            // 中序:20 30 40 50 60 70 80
整数 j = 0;
当 (j < 7)
{
    整数 位 = 取序[j];
    整数 真值 = 序值[位];
    树值列[j] = 转字符串(真值);
    j = j + 1;
}

// 每个节点的四件事:第几层 / 左孩子 / 右孩子 / 这棵子树几个节点
j = 0;
当 (j < 7)
{
    整数 左位 = 左孩位[j];
    整数 右位 = 右孩位[j];
    字符串 s = "点中 ";
    拼接到(s, 树值列[j], ":第 ");
    拼接到(s, 转字符串(层号[j]), " 层;左孩子 ");
    如果 (左位 < 0)
    {
        拼接到(s, "没有");
    }
    否则
    {
        拼接到(s, 树值列[左位]);
    }
    拼接到(s, ",右孩子 ");
    如果 (右位 < 0)
    {
        拼接到(s, "没有");
    }
    否则
    {
        拼接到(s, 树值列[右位]);
    }
    树详一[j] = s;

    字符串 t = "它这棵子树 ";
    拼接到(t, 转字符串(子树数[j]), " 个节点;中序里排第 ");
    拼接到(t, 转字符串(中序位[j]));
    树详二[j] = t;
    j = j + 1;
}

// 库的账:个数 / 高度 —— 全是开窗前问出来的(库一个字没改)
字符串 账1 = "库问出来的账:链表 ";
拼接到(账1, 转字符串(链数), " 个、树 ");
拼接到(账1, 转字符串(树数), " 个、树高 ");
拼接到(账1, 转字符串(树.高度(树演)), "(开窗前问的)");
账文1 = 账1;

字符串 账2 = "中序走出来就是从小到大:";
j = 0;
当 (j < 树数)
{
    拼接到(账2, " ");
    拼接到(账2, 转字符串(序值[j]));
    j = j + 1;
}
账文2 = 账2;

// ---- 开窗:下面那一层每帧只画(一条字符串都不再拼)----
逻辑 开着 = 打开窗口("示例41 链表与树", 窗宽, 窗高);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → **浅层结算点击** → 重画 → 刷新 → 等待,转到用户自己关窗(或脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 点击结算:**单独摆在这一层**(命中测试与赋值别塞进上面那串嵌套里,塞进去实测不落地)。
        //   上半屏:5 个方框的左边相距 `链距` ⇒ 序号 = (点x - 12) / 链距,再卡一次框的左右边界;
        //   下半屏:先按 y 定层(树层距),再按层算这一层的首 x 与节点间距(第 L 层有 2^L 个),
        //   最后按 x 定槽 —— 布局序 = 层序,正好就是 `2^层 - 1 + 槽`。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 12 && 点x < 548 && 点y >= 链顶 && 点y < 链顶 + 链高)
            {
                整数 格 = (点x - 12) / 链距;
                整数 链格左 = 12 + 格 * 链距;
                如果 (点x >= 链格左 && 点x < 链格左 + 链宽)
                {
                    选链 = 格;
                }
            }
            如果 (点x >= 12 && 点x < 548 && 点y >= 树顶 && 点y < 树顶 + 3 * 树层距)
            {
                整数 层 = (点y - 树顶) / 树层距;
                整数 槽数 = 1 << 层;
                整数 间距 = 480 / 槽数;
                整数 首x = 树中 - 树宽 / 2 - (槽数 - 1) * 间距 / 2;
                整数 槽 = (点x - 首x) / 间距;
                整数 树格左 = 首x + 槽 * 间距;
                如果 (点x >= 树格左 && 点x < 树格左 + 树宽)
                {
                    选树 = 槽数 - 1 + 槽;
                }
            }
        }

        如果 (!收手)
        {
            // ---- 逐帧推进:9 步一轮(链表:正着 5 步 + 倒着 4 步)、树 7 个节点一轮 ----
            整数 链步 = 帧步 % 9;
            如果 (链步 < 5)
            {
                链游标 = 链步;
            }
            否则
            {
                链游标 = 8 - 链步;
            }
            树游标 = 帧步 % 7;
            // 底下那两行:点过就钉在点中的那一格,没点过就跟着这一帧的游标走
            整数 链说 = 选链;
            如果 (链说 < 0)
            {
                链说 = 链游标;
            }
            整数 树说 = 选树;
            如果 (树说 < 0)
            {
                树说 = 树游标;
            }

            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是开窗前拼好的)----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 44, 0xFF2A3550);
            画文字(24, 16, "示例41 链表与树:把内存里的结构真画出来", 0xFFE8E8F0);
            画文字(24, 38, "上半屏:双向链表(两个方向)  下半屏:二叉树(按层摆)", 0xFFB0B0B8);

            // ---- 上半屏:双向链表 ----
            // ⚠ 底色一律画在文字**之前**:`画矩形` 是不透明实心,画在文字后面会把那一格的数盖掉
            //   (无头呈现看不出来,桌面壳上才看得出来 —— 「盖字检查」那条几何机检逮的就是这个)。
            画矩形(12, 58, 536, 116, 0xFF16161E);
            画文字(20, 64, "1) 双向链表(5 个节点):上面那条箭头 = 后继,下面那条 = 前驱", 0xFF9CC4FF);

            整数 i = 0;
            当 (i < 5)
            {
                整数 态 = 0;
                如果 (i == 选链)
                {
                    态 = 1;
                }
                如果 (i == 链游标)
                {
                    态 = 2;
                }
                整数 链左 = 12 + i * 链距;
                画方框(链左, 链顶, 链宽, 链高, 态);
                整数 值半宽 = 取文字宽度(链值列[i]) * 4;      // 1 格 = 8 像素 ⇒ 半个字宽 = 格数 × 4
                如果 (态 == 2)
                {
                    画文字(链左 + 36 - 值半宽, 链顶 + 12, 链值列[i], 0xFFFFFFFF);
                }
                否则 如果 (态 == 1)
                {
                    画文字(链左 + 36 - 值半宽, 链顶 + 12, 链值列[i], 0xFFFFE08A);
                }
                否则
                {
                    画文字(链左 + 36 - 值半宽, 链顶 + 12, 链值列[i], 0xFFE8E8F0);
                }
                i = i + 1;
            }

            // 两个框之间那两条箭头:上面 = 后继(往右,蓝)、下面 = 前驱(往左,橙)
            整数 g = 0;
            当 (g < 4)
            {
                整数 缝 = 84 + g * 链距;
                画箭头(缝 + 4, 链顶 + 9, 缝 + 40, 链顶 + 9, -6, 0xFF7AB0FF);
                画箭头(缝 + 40, 链顶 + 27, 缝 + 4, 链顶 + 27, 6, 0xFFE0A050);
                g = g + 1;
            }

            画文字(20, 134, 链步文[链步], 0xFFE8E8F0);
            画文字(20, 154, 链点文[链说], 0xFFD0D0D8);

            // ---- 下半屏:二叉树 ----
            画矩形(12, 180, 536, 226, 0xFF16161E);
            画文字(20, 186, "2) 二叉树(7 个节点 / 3 层):根在第 1 层,父子连线", 0xFF9CC4FF);

            // 父子之间的连线:先画线、后画方框(线头藏在框底下)
            整数 e = 0;
            当 (e < 3)
            {
                整数 父x = 树x[e] + 30;
                整数 父y = 树y[e] + 树高;
                整数 左孩 = 2 * e + 1;
                整数 右孩 = 2 * e + 2;
                画线(父x, 父y, 树x[左孩] + 30, 树y[左孩], 0xFF4A5570);
                画线(父x, 父y, 树x[右孩] + 30, 树y[右孩], 0xFF4A5570);
                e = e + 1;
            }

            整数 n = 0;
            当 (n < 7)
            {
                整数 态2 = 0;
                如果 (n == 选树)
                {
                    态2 = 1;
                }
                如果 (n == 树游标)
                {
                    态2 = 2;
                }
                整数 树左 = 树x[n];
                整数 树上 = 树y[n];
                画方框(树左, 树上, 树宽, 树高, 态2);
                整数 值半宽2 = 取文字宽度(树值列[n]) * 4;
                如果 (态2 == 2)
                {
                    画文字(树左 + 30 - 值半宽2, 树上 + 9, 树值列[n], 0xFFFFFFFF);
                }
                否则 如果 (态2 == 1)
                {
                    画文字(树左 + 30 - 值半宽2, 树上 + 9, 树值列[n], 0xFFFFE08A);
                }
                否则
                {
                    画文字(树左 + 30 - 值半宽2, 树上 + 9, 树值列[n], 0xFFE8E8F0);
                }
                n = n + 1;
            }

            // 点中的那个节点(没点过就跟着这一帧的游标):层 / 左孩子 / 右孩子 / 子树几个节点
            画文字(20, 372, 树详一[树说], 0xFFE8E8F0);
            画文字(20, 390, 树详二[树说], 0xFFD0D0D8);

            // ---- 底下那几句:写死的字符串直接进 `画文字`(每帧不产生新字符串)----
            画线(12, 424, 548, 424, 0xFF3C3C46);
            画文字(20, 434, "怎么点:点上面一个方框 / 点下面一个节点,底下就换成它的账", 0xFF8A8A96);
            画文字(20, 458, 账文1, 0xFFB0B0B8);
            画文字(20, 480, 账文2, 0xFFB0B0B8);
            画文字(20, 502, "每进一帧:上半屏正着走完倒着走,下半屏换个节点亮", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)

            // 帧步往前走一格(9 与 7 的公倍数 ⇒ 63 帧一整个循环)
            帧步 = 帧步 + 1;
            如果 (帧步 >= 63)
            {
                帧步 = 0;
            }
        }
    }

    关闭窗口();
}

// 演完把这两份结构还回堆里(与上面那份纯计算同一个口径:语言没有 GC,用完自己还)
链表.销毁(链表演);
树.销毁(树演);

停止

