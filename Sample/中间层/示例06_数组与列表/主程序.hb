// ============================================================
// 示例06:数组与列表 —— 定长数组、变长列表、两种下标
//
// 这个示例演示什么:数组(个数写死)和列表(个数不写)怎么声明、怎么读写、下标怎么算。
// 重点看哪几处:
//   ① 数组 `字节 buf[5]` / `短整数 vals[3]` / `整数 words[2]`:元素紧排,
//      元素宽可以是 1 / 2 / 4 字节,宽度决定"下标 × 几"。
//   ② 下标两种:常量下标(`buf[0]`)编译期就算好偏移,最省指令;
//      变量下标(`buf[i]`)运行期算地址 = 基址 + 下标 × 元素宽,所以能放进循环里用。
//   ③ `[…]` 初值:声明数组时给一串常量,写几个算几个,剩下补 0(长度也可以不写,个数按初值个数算)。
//   ④ 列表 `短整数 分数[]`:个数**不写** —— 编译器能数清 `.添加()` 几次就精确给那么大,
//      数不清(比如在循环里添加)就让它自己长:一开始给 4 个,不够翻倍。
//      取/改和数组一模一样(`分数[0]`、`分数[1] = 91`),多出来的动作是 `.添加()` / `.长度()` / `.清空()`。
//   ⑤ 方法名中英两写法都认:`.添加()` = `.add()`、`.长度()` = `.length()`、`.清空()` = `.clear()`。
//   ⑥ 列表也能当函数里的局部变量:头在帧里,数据从池里要一块,函数一返回就还回去。
//   ⑦ 数组整个交给函数:参数写 `整数 nums[]`,编译器自动传"地址 + 长度"两个字。
//
// 关键字中英等价(如果=if、函数=func、返回=return、当=while、循环=for),标识符随便起,
// 中文优先只是默认;本示例标识符一律用短英文。
// 本示例不需要任何库,单独就能编译运行。
//
//   ============================================================
//   怎么看(带 UI;H82 批 2)—— 这一份是"能开窗就开窗"的写法:
//
//     · 上面 ①~⑦ 那一段(**一个字没动**)**不需要任何库**;下面带窗口的那一半要用
//       `包含 "../../库/string.hb"` —— 把数字拼进文字靠的就是它那个 `转字符串`(`格式化` 要)。
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例06 数组与列表`。
//       上半屏四行格子 = `字节 buf[5]` / `短整数 vals[3]` / `整数 words[2]` / `整数 data[4]`,
//       **格宽 = 元素宽 × 24 像素** ⇒ 1 / 2 / 4 字节三种格宽一眼看得出来;
//       下半屏一行格子是列表 `分数[]`(点右边那个「＋ 添加一个」,它就自己长一格)。
//       **鼠标点任意一格**:底下两行当场换成那一格的"第几个下标 / 元素宽 / 字节偏移 = 下标 × 元素宽 /
//       现在装的值",点中的那一格换蓝底;浅色框是**逐帧扫描**的下标(每 `刷新()` 一帧往右挪一格)。
//       窗口**一直转到你自己关掉**(点标题栏的叉)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、也不用等人去关 ——
//       旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),跑满它写的帧数就投一个关窗请求;
//       于是"窗口该画什么、点一下变成什么样"都能逐行对出来(硬规矩 6:自检不开窗)。
//     · **顺序**:先把上面那些纯计算跑完、`测试输出` 打完(文件末尾那行 `// 预期输出:` 对的就是它们),
//       **然后**才开窗 —— 于是这一份示例的期望输出里,"数"还是那些数,窗口那几行排在后头。
//   ============================================================

// ⑦ 数组参数:实参只能是变量/字段/数组元素(传地址,不复制)
方法 求和(整数 nums[]) 返回 整数
{
    整数 s = 0;
    整数 i = 0;
    当 (i < nums.长度())
    {
        s = s + nums[i];
        i = i + 1;
    }
    返回 s;
}

方法 第一个(整数 nums[]) 返回 整数
{
    返回 nums[0];
}

// ⑥ 列表当函数里的局部变量:每次调用都从空的开始,返回时池里的那块自动还回去
方法 前几项和(整数 n) 返回 整数
{
    整数 tmp[];                    // 个数不写 = 列表
    整数 i = 1;
    当 (i <= n)
    {
        tmp.添加(i * i);           // 循环里添加 → 编译器数不清,让它自己长
        i = i + 1;
    }
    整数 s = 0;
    i = 0;
    当 (i < tmp.长度())
    {
        s = s + tmp[i];
        i = i + 1;
    }
    返回 s;
}

// ============================================================
// ① 三种元素宽的数组 + ③ `[…]` 初值
// ============================================================
字节 buf[5];                       // 元素宽 1:下标就是字节偏移
buf[0] = 10;
buf[1] = 20;
buf[2] = 30;
buf[3] = 40;
buf[4] = 30;
var sum = buf[0] + buf[1] + buf[2] + buf[3] + buf[4];
测试输出(sum);                     // 130

短整数 vals[3] = [100, 200, 300];  // 元素宽 2(短整数),`[…]` 初值
测试输出(vals[0] + vals[1]);       // 300:常量下标能直接相加

整数 words[2];                     // 元素宽 4
words[0] = 0x12345678;
words[1] = words[0] - 1;
测试输出(words[0]);                // 305419896

// ② 变量下标:运行期算地址(基址 + 下标 × 元素宽),循环里就靠它
var i = 0;
循环 (i = 0; i < 5; i = i + 1)
{
    buf[i] = buf[i] - 1;           // 每个元素减 1
}
测试输出(buf[4]);                  // 29
测试输出(地址(buf[1]) - 地址(buf[0]));    // 1:字节数组的元素间距
测试输出(地址(words[1]) - 地址(words[0])); // 4:整数数组的元素间距

// ④ 列表:个数不写,编译器按 `.添加()` 次数自己算
短整数 分数[];                     // 一共 2 次添加都在直线上 → 精确给 2 个
分数.添加(85);
分数.添加(90);
测试输出(分数.长度());             // 2
分数[1] = 91;                      // 改:和数组一个写法
测试输出(分数[0]);                 // 85
测试输出(分数[1]);                 // 91

// ④ 算不出个数的情况:在循环里添加 → 自己长(一开始 4 个,不够翻倍)
循环 (var k = 1; k <= 10; k = k + 1)
{
    分数.添加(k);
}
测试输出(分数.长度());             // 12(前面 2 个 + 循环 10 个)

// ⑤ 方法名的英文写法一样认
短整数 名单[];
名单.add(7);
名单.add(9);
测试输出(名单.length());           // 2
名单.clear();
测试输出(名单.length());           // 0

// ④ 清空:长度归零(数据不动,很便宜)
分数.清空();
测试输出(分数.长度());             // 0
分数.添加(5);                      // 清空后还能接着加
测试输出(分数.长度());             // 1

// ⑦ 数组参数 + ⑥ 函数里的列表
整数 data[4] = [3, 1, 4, 1];
测试输出(求和(data));              // 9
测试输出(第一个(data));            // 3
测试输出(前几项和(3));             // 14 = 1 + 4 + 9
测试输出(前几项和(4));             // 30 = 1 + 4 + 9 + 16

// ============================================================
// 带 UI 的那一半(H82 批 2)—— 把上面这些数组 / 列表画成格子
//
//   · 上半屏四行格子(格宽 = 元素宽 × 24 像素):`字节 buf[5]` / `短整数 vals[3]` /
//     `整数 words[2]` / `整数 data[4]` —— 1 / 2 / 4 字节三种格宽一眼看得出来;
//     每行头上一行小字就是这一行的"下标 × 元素宽 = 字节偏移"。
//   · 下半屏一行格子:列表 `短整数 分数[]`(个数不写)—— 点「＋ 添加一个」它就自己长一格。
//   · **鼠标点任意一格**:底下两行换成那一格的"第几个下标 / 元素宽 / 字节偏移 = 下标 × 元素宽 /
//     现在装的值";点中的那一格换蓝底。
//   · **逐帧推进**:每 `刷新()` 进一帧,"扫描下标"的浅色框从第 0 格一格格往右挪。
//   · ⚠ 要画的文字**全部在开窗之前拼好** —— 主循环里一条字符串都不现拼
//     (每帧现拼几十条,实测 **209 帧**就把编译器的池吃光)。
// ============================================================
包含 "../../库/string.hb"          // `格式化(...)` 要用的那个 `转字符串` 在库里

// ---- 窗口与格子的尺寸:画图和命中测试用的是同一组数,要挪地方只改这几行 ----
整数 窗宽 = 560;
整数 窗高 = 660;
整数 列0 = 20;                    // 每行格子的起点 x
整数 行基 = 96;                   // 上半屏第一行小字的 y
整数 行距 = 66;                   // 上半屏一行占多高(小字 + 格子 + 空当)
整数 行高 = 34;                   // 一格多高
整数 每字节 = 24;                 // 元素宽 1 字节 = 24 像素 ⇒ 格宽 = 元素宽 × 24
整数 列表y = 412;                 // 下半屏列表那一行格子的 y
整数 钮x = 420;                   // 「＋ 添加一个」按钮的左上角(宽 120 / 高 28)
整数 钮y = 452;

// ---- 四行格子:元素宽 1 / 2 / 4 / 4(最后一行 data[4] 就是交给 `求和` / `第一个` 的那个)----
整数 元素宽表[4] = [1, 2, 4, 4];
整数 格数表[4] = [5, 3, 2, 4];
整数 基表[4] = [0, 5, 8, 10];     // 第 r 行第 0 格在 `值文本[]` 里的下标(值文本是一条长数组)
整数 格宽表[4];                   // 格宽 = 元素宽 × 每字节(下面那圈算出来)

// 字符串数组**不能在声明时给初值** ⇒ 声明完一条条填(照 `Sample\说明.md` 那张坑表)
字符串 行名表[4];
行名表[0] = "字节 buf[5]";
行名表[1] = "短整数 vals[3]";
行名表[2] = "整数 words[2]";
行名表[3] = "整数 data[4]";
字符串 行头表[4];
行头表[0] = "字节 buf[5] · 元素宽 1 字节 ⇒ 下标 × 1 = 字节偏移";
行头表[1] = "短整数 vals[3] · 元素宽 2 字节 ⇒ 下标 × 2 = 字节偏移";
行头表[2] = "整数 words[2] · 元素宽 4 字节 ⇒ 下标 × 4 = 字节偏移";
行头表[3] = "整数 data[4](给函数的那个)· 元素宽 4 字节 ⇒ 下标 × 4 = 字节偏移";
字符串 值文本[14];                // 14 = 5 + 3 + 2 + 4 格的文字:**开窗前一次拼好**,主循环只管画
字符串 扫描文本[5];               // 逐帧扫描那一行也是现成的(每帧只换一句现成的,不现拼)
字符串 说明一 = "";               // 底下两行说明:只在"选中变了"那一刻重拼
字符串 说明二 = "";
字符串 列表状态 = "";             // 列表那一行:只在点了「＋ 添加一个」之后重拼
字符串 列表值文本[8];             // 列表格子的文字(先按现在的长度拼好,添加时只补新那一个)

// ---- 窗口自己要记住的状态:一律写在**顶层**(别藏在嵌套里)----
整数 类型 = 0;                    // 图形那一套要的四个出参(照 示例14 / 15 / 16)
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                     // 这一帧那"点一下"落在哪儿(x / y)
整数 点y = 0;
逻辑 有一下 = 假;                 // 这一帧收到过"点一下"(按下 + 抬起)没有
整数 选中行 = -1;                 // 点中的那一格:0~3 = 上半屏四行,4 = 下半屏列表;-1 = 还没点
整数 选中列 = -1;
整数 落行 = -1;                   // 命中测试的落脚点(结算单独摆浅一层,主循环里不多声明局部)
整数 落列 = -1;
整数 帧计 = 0;                    // 每 `刷新()` 一次 +1
整数 扫描 = 0;                    // 这一帧浅色框扫到第几格 = 帧计 % 5
整数 新格 = 0;                    // 列表刚长出来的那一格的格号
整数 添加次 = 16;                 // `分数` 一共被 `.添加()` 过几次:直线 2 + 循环 10 + 清空后 4

// ---- 格子要的文字都从这几个小函数来 ----
// ⚠ `格式化(...)` **不能直接写在"数组元素 = …"右边**(编译期会说"未定义的函数")⇒ 包一层就有了;
//   而且 `返回 格式化(…)` 这种"直接把格式化当返回值"跑出来是空串 ⇒ 先落进一个字符串变量再返回。
// ⚠ 占位符只认 `{0}` 这种,printf 的 `%d` **不报错、也不替换**(会原样返回 "%d")。
方法 数文(整数 值) 返回 字符串
{
    字符串 文 = 格式化("{0}", 值);
    返回 文;
}

方法 取值(整数 行, 整数 下标) 返回 整数
{
    如果 (行 == 4)
    {
        返回 分数[下标];
    }
    // 4 = 下半屏那个列表
    如果 (行 == 0)
    {
        返回 buf[下标];
    }
    如果 (行 == 1)
    {
        返回 vals[下标];
    }
    如果 (行 == 2)
    {
        返回 words[下标];
    }
    返回 data[下标];
}

方法 取宽(整数 行) 返回 整数
{
    如果 (行 == 4)
    {
        返回 2;
    }
    // 列表是 `短整数`:元素宽也是 2 字节
    返回 元素宽表[行];
}

方法 取名(整数 行) 返回 字符串
{
    如果 (行 == 4)
    {
        返回 "短整数 分数[]";
    }
    返回 行名表[行];
}

// 底下那两行说明:第几个下标 / 元素宽 / 字节偏移 = 下标 × 元素宽 / 现在装的值
// ⚠ 一个函数里堆太多调用 / 局部会当场报「帧超出 96 字节」⇒ 一句只拼一次、拆开写
方法 选中一(整数 行, 整数 下标) 返回 字符串
{
    字符串 文 = "选中 ";
    拼接到(文, 取名(行), " 的第 ", 数文(下标));
    拼接到(文, " 号 · 元素宽 ", 数文(取宽(行)), " 字节");
    返回 文;
}

方法 选中二(整数 行, 整数 下标) 返回 字符串
{
    字符串 文 = "字节偏移 = 下标 ";
    拼接到(文, 数文(下标), " × 元素宽 ", 数文(取宽(行)));
    拼接到(文, " = ", 数文(下标 * 取宽(行)), "(运行期:基址 + 元素宽 × 下标)");
    返回 文;
}

// 列表那一行的状态(点一次「＋ 添加一个」重拼一次 —— **不是每帧拼**)
方法 列表状态行(整数 次数, 整数 格数) 返回 字符串
{
    字符串 文 = "添加 ";
    拼接到(文, 数文(次数), " 次 ⇒ 列表自己长到 ", 数文(格数));
    拼接到(文, " 个格(.长度() = ", 数文(格数), ")");
    返回 文;
}

// 一格的底色:`画矩形` 是不透明实心 ⇒ **先铺底色、再画字**(反了就把字盖住)。
// 态:0 普通格 / 1 这一帧扫描到的格(浅色框)/ 2 点中的格(蓝底)。
方法 画底色(整数 x, 整数 y, 整数 宽, 整数 态)
{
    如果 (态 == 2)
    {
        画矩形(x, y, 宽, 行高, 0xFF6EA0FF);
        画矩形(x + 2, y + 2, 宽 - 4, 行高 - 4, 0xFF2A6EF0);
    }
    否则
    {
        如果 (态 == 1)
        {
            画矩形(x, y, 宽, 行高, 0xFF4A6EA8);
            画矩形(x + 2, y + 2, 宽 - 4, 行高 - 4, 0xFF233046);
        }
        否则
        {
            画矩形(x, y, 宽, 行高, 0xFF3C3C46);
            画矩形(x + 2, y + 2, 宽 - 4, 行高 - 4, 0xFF16161E);
        }
    }
}

// 上半屏一行:小字(元素宽 ⇒ 下标 × N)+ 这一行各格
// ⚠ 字符串数组的元素**只能直接交给 `画文字` 这种内建命令** —— 当自定义函数的字符串参数不行
方法 画数组行(整数 行)
{
    整数 y = 行基 + 行 * 行距;
    画文字(列0, y, 行头表[行], 0xFF8A8A96);
    整数 k = 0;
    当 (k < 格数表[行])
    {
        整数 态 = 0;
        如果 (扫描 == k)
        {
            态 = 1;
        }
        // 浅色框:这一帧扫到第 k 格
        如果 (选中行 == 行 && 选中列 == k)
        {
            态 = 2;
        }
        // 蓝底:用户点中的那一格
        整数 x = 列0 + k * 格宽表[行];
        整数 位 = 基表[行] + k;                           // ⚠ 数组下标要写成**一个变量**(算式不行)
        画底色(x, y + 20, 格宽表[行], 态);
        画文字(x + 6, y + 28, 值文本[位], 0xFFE8E8F0);
        k = k + 1;
    }
}

// 下半屏那一行:列表 `分数[]` 的格子(几个格由它自己的 `.长度()` 说了算)
方法 画列表行()
{
    整数 n = 分数.长度();
    整数 k = 0;
    当 (k < n)
    {
        整数 态 = 0;
        如果 (选中行 == 4 && 选中列 == k)
        {
            态 = 2;
        }
        整数 x = 列0 + k * 48;                            // 列表元素宽 2 ⇒ 格宽 = 2 × 24
        画底色(x, 列表y, 48, 态);
        画文字(x + 6, 列表y + 8, 列表值文本[k], 0xFFE8E8F0);
        k = k + 1;
    }
}

// ---- 开窗之前:把每格的文字、每行的格宽一次算清(主循环里只画)----
整数 r = 0;
当 (r < 4)
{
    格宽表[r] = 元素宽表[r] * 每字节;
    整数 c = 0;
    当 (c < 格数表[r])
    {
        整数 位 = 基表[r] + c;                 // ⚠ 下标要写成**一个变量**(算式当不了数组下标)
        字符串 临时 = 数文(取值(r, c));       // ⚠ 返回字符串的调用要先落进一个字符串变量
        值文本[位] = 临时;
        c = c + 1;
    }
    r = r + 1;
}

// 下半屏要画的列表就用原来那条 `分数[]`:它刚被 `清空` 过、只有清空后加的那 1 个格(5),
// 这里再添 3 次 —— 它自己长,不用你管容量(前面在循环里加那 10 次已经把它撑到 12 格了)。
分数.添加(70);
分数.添加(88);
分数.添加(93);
整数 c2 = 0;
当 (c2 < 分数.长度())
{
    字符串 临时2 = 数文(分数[c2]);
    列表值文本[c2] = 临时2;
    c2 = c2 + 1;
}
列表状态 = 列表状态行(添加次, 分数.长度());

// 逐帧扫描那一行:五句现成的,主循环里按下标取,不现拼
扫描文本[0] = "逐帧扫描:下标 0 的浅色框,每帧往右挪一格(下标同、四行元素不同)";
扫描文本[1] = "逐帧扫描:下标 1 的浅色框,每帧往右挪一格(下标同、四行元素不同)";
扫描文本[2] = "逐帧扫描:下标 2 的浅色框,每帧往右挪一格(下标同、四行元素不同)";
扫描文本[3] = "逐帧扫描:下标 3 的浅色框,每帧往右挪一格(下标同、四行元素不同)";
扫描文本[4] = "逐帧扫描:下标 4 的浅色框(只有 `字节 buf[5]` 还有第 4 格)";
说明一 = "点任意一格 ⇒ 这两行说清这一格的下标 / 元素宽 / 字节偏移 / 现值";
说明二 = "浅色框是逐帧扫描的下标;点中的那一格换蓝底(底色先画、字后画)";

逻辑 开着 = 打开窗口("示例06 数组与列表", 窗宽, 窗高);
如果 (开着)                        // 没有图形能力的宿主给 假 ⇒ 一个字都不多打
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算它 —— **单独摆在这一层**(命中测试与赋值别塞进上面那串嵌套)。
        // 上半屏:小字那一行(前 20 像素)与行末空当(后 12 像素)不算格子;
        // 下半屏:列表那一行按 48 像素一格;右边那个按钮整块都算。
        如果 (有一下)
        {
            有一下 = 假;
            整数 旧行 = 选中行;
            整数 旧列 = 选中列;

            如果 (点y >= 行基 && 点y < 行基 + 4 * 行距)
            {
                落行 = (点y - 行基) / 行距;
                落列 = (点y - 行基) % 行距;
                如果 (落列 >= 20 && 落列 < 54 && 点x >= 列0)
                {
                    落列 = (点x - 列0) / 格宽表[落行];
                    如果 (落列 >= 格数表[落行])
                    {
                        落列 = -1;
                    }
                    如果 (落列 >= 0)
                    {
                        选中行 = 落行;
                        选中列 = 落列;
                    }
                }
            }

            如果 (点y >= 列表y && 点y < 列表y + 行高 && 点x >= 列0)
            {
                落列 = (点x - 列0) / 48;
                如果 (落列 < 分数.长度())
                {
                    选中行 = 4;
                    选中列 = 落列;
                }
            }

            // 「＋ 添加一个」:点它 `分数` 就 `.添加()` 一次 —— 列表自己长一格
            如果 (点x >= 钮x && 点x < 钮x + 120 && 点y >= 钮y && 点y < 钮y + 28)
            {
                如果 (分数.长度() < 8)
                {
                    分数.添加(分数.长度() * 10);
                    添加次 = 添加次 + 1;
                    新格 = 分数.长度() - 1;
                    字符串 新文 = 数文(分数[新格]);
                    列表值文本[新格] = 新文;
                    列表状态 = 列表状态行(添加次, 分数.长度());
                }
            }

            // 选中真变了才重拼那两行(每帧重拼 = 池漏光;每点一次重拼一次是安全的)
            如果 (选中行 != 旧行 || 选中列 != 旧列)
            {
                如果 (选中行 < 0)
                {
                    说明一 = "点任意一格 ⇒ 这两行说清这一格的下标 / 元素宽 / 字节偏移 / 现值";
                    说明二 = "浅色框是逐帧扫描的下标;点中的那一格换蓝底(底色先画、字后画)";
                }
                否则
                {
                    说明一 = 选中一(选中行, 选中列);
                    说明二 = 选中二(选中行, 选中列);
                }
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是现成的)----
            扫描 = 帧计 % 5;
            帧计 = 帧计 + 1;

            清屏(0xFF101018);
            画矩形(12, 12, 536, 44, 0xFF2A3550);
            画文字(24, 18, "示例06 数组与列表:把数组 / 列表画成格子", 0xFFE8E8F0);
            画文字(24, 38, "格宽 = 元素宽 × 24 像素 ⇒ 1 / 2 / 4 字节三种格宽", 0xFFB0B0B8);

            画矩形(12, 66, 536, 22, 0xFF232B3E);
            画文字(20, 69, "上半屏:四个数组,一格一个元素(小字就是这一行的字节偏移口径)", 0xFF9CC4FF);

            整数 q = 0;
            当 (q < 4)
            {
                画数组行(q);
                q = q + 1;
            }

            画矩形(12, 362, 536, 22, 0xFF232B3E);
            画文字(20, 365, "下半屏:列表 短整数 分数[](个数不写 —— 装不下它自己长)", 0xFF9CC4FF);
            画文字(20, 390, "直线加 2 次 ⇒ 2 格;循环加 10 次 ⇒ 长到 12 格;清空后加 4 次 ⇒ 4 格", 0xFF8A8A96);
            画列表行();
            画文字(20, 456, 列表状态, 0xFFD0D0D8);

            // 「＋ 添加一个」按钮:鼠标压着它的时候亮一下(移动事件进来自动变)
            如果 (鼠标x >= 钮x && 鼠标x < 钮x + 120 && 鼠标y >= 钮y && 鼠标y < 钮y + 28)
            {
                画矩形(钮x, 钮y, 120, 28, 0xFF6EA0FF);
                画矩形(钮x + 2, 钮y + 2, 116, 24, 0xFF2A3550);
            }
            否则
            {
                画矩形(钮x, 钮y, 120, 28, 0xFF3C3C46);
                画矩形(钮x + 2, 钮y + 2, 116, 24, 0xFF232B3E);
            }
            画文字(钮x + 12, 钮y + 7, "＋ 添加一个", 0xFFE8E8F0);

            画线(12, 494, 548, 494, 0xFF3C3C46);
            画文字(20, 506, 说明一, 0xFFE8E8F0);
            画文字(20, 530, 说明二, 0xFFD0D0D8);
            画文字(20, 560, 扫描文本[扫描], 0xFF9CC4FF);
            画文字(20, 584, "点任意一格 ⇒ 上面两行换成那一格的下标 / 元素宽 / 字节偏移 / 现值", 0xFF8A8A96);
            画文字(20, 608, "上面 18 个 测试输出 一个字没动 —— 这一屏只是把它们排成格子", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();                                // 关掉它,程序继续往下跑
}

停止

