// ============================================================
// 示例20:多维数组(H68-1 起)—— 定长、行优先、逐维查越界
//
// 这个示例演示什么:一个正常语言该有的"表格"写法:`整数 袋[行][列];`
// 重点看哪几处:
//   ① 声明:`类型 名字[第一维][第二维]…`,各维都写常量,一共 2~4 维;
//      各维乘起来就是元素总数,整块大小 = 元素总数 × 最内层元素宽。
//   ② 读写:`袋[行][列]` —— 每一维的下标都能是常量,也能是变量(循环里就是变量)。
//      地址是**行优先**线性累加:字节偏移 = ((行 × 列数) + 列) × 元素宽 ——
//      与"自己摊平成一维 `袋[行 * 列数 + 列]`"**逐字节同构**(本示例就把两个写法对了一遍)。
//   ③ 初值:`[…]` 按行铺开(最后一维最快),写几个算几个,剩下补 0。
//   ④ 越界是**逐维查**的:编译期算得出的常量下标当场报错,变量下标运行期停下,
//      两种都说清是"第几维只有几个元素"。
//   ⑤ 明确不做(报错当场说):列表的列表(`整数 表[][];`)、当数组参数传、取地址、
//      整块赋值 —— 要整块用就摊平成一维,或者把那一行写成一个结构。
//
// 关键字中英等价(循环=for、当=while、整数=int),标识符随便起。
// 本示例 UI 那一段要用 `格式化(...)`,所以多包含了一份 `库\string.hb`(纯 HB,零依赖)。
//
//   ============================================================
//   怎么看(带 UI;H82 批 2)—— 这一份也是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例20 多维数组`。
//       窗口里是**同一块内存的两种看法**:
//         左边 3 × 4 的格子阵 = `整数 袋[3][4]`,格子里写着值,底下那行小字是它的格号;
//         右边一排 12 格 = 摊平成一维的 `整数 平[12]`,行优先顺序,格子上标着 `平[0]`…`平[11]`;
//         点左边任意一格 ⇒ 左边这一格与右边**同一个格子**同时高亮(底色先画、字后画)。
//       底下两行当场说明对应关系:`袋[行][列] ⇔ 平[行 * 4 + 列]` 与
//       字节偏移 = ((行 × 4) + 列) × 4 = **具体数**。
//     · **逐帧推进**:每帧高亮沿行优先顺序往后挪一格(`#0 → #1 → … → #11 → #0`),
//       于是"行优先"这件事看得见;旁边那份 `事件脚本.txt` 再在第 1、5、13 帧各投一次点击,
//       看点击落在哪一格、两边怎么一起亮。
//     · **窗口一直转到你自己关掉**(点标题栏的叉);自检 / 命令行那份脚本跑满 16 帧就投关窗请求。
//   ============================================================

包含 "../../库/string.hb"        // `格式化(...)` 要用的那个 `转字符串` 在库里(放文件头,与 示例07 一样)

// ① 二维:常量下标 + 运行期下标
整数 袋[3][4];
袋[0][0] = 1;
袋[2][3] = 9;
var 行 = 1;
var 列 = 2;
袋[行][列] = 7;                    // 下标是变量:运行期算地址
测试输出(袋[0][0]);                // 1
测试输出(袋[2][3]);                // 9
测试输出(袋[行][列]);              // 7
测试输出(袋[行][列] + 袋[0][0]);   // 8

// ② 行优先:与"自己摊平成一维"逐字节同构
整数 平[12];
平[行 * 4 + 列] = 7;               // 同一个格子的另一种写法
测试输出(袋[行][列] - 平[行 * 4 + 列]);        // 0:读写的是同一格
测试输出(地址(袋[行][列]) - 地址(袋[0][0]));   // 24 = (1 × 4 + 2) × 4
测试输出(地址(袋[2][3]) - 地址(袋[0][0]));     // 44 = (2 × 4 + 3) × 4

// ③ 初值按行铺开(最后一维最快),写几个算几个、剩下补 0
整数 表[2][2] = [1, 2, 3, 4];
测试输出(表[0][1]);                // 2
测试输出(表[1][0]);                // 3
短整数 半[2][3] = [5, 6];
测试输出(半[0][1]);                // 6
测试输出(半[1][0]);                // 0(没写到的补 0)

// ④ 用两层循环填一张乘法表(下标是归纳变量)
整数 九[3][3];
循环 (var i = 0; i < 3; i = i + 1)
{
    循环 (var j = 0; j < 3; j = j + 1)
    {
        九[i][j] = i * 3 + j;
    }
}
测试输出(九[2][2]);                // 8
测试输出(九.长度());               // 3:`袋.长度()` 是**第一维**的长度(行数)

// ⑤ 三维 / 四维:每一维都能是变量
整数 立[2][3][4];
立[1][2][3] = 42;
var a = 1;
var b = 2;
var c = 3;
立[a][b][c] = 43;
测试输出(立[1][2][3]);             // 43(被上一句改掉了)
整数 四[2][2][2][2];
四[1][1][1][1] = 9;
测试输出(四[1][1][1][1]);          // 9

// ⑥ 元素是结构:写全各维下标之后再点字段
结构 点
{
    整数 x;
    整数 y;
}
点 网格[2][3];
网格[1][2].x = 5;
网格[1][2].y = 6;
网格[a][b].x = 网格[a][b].x + 10;  // 1,2 那一格
测试输出(网格[1][2].x);            // 15
测试输出(网格[a][b].y);            // 6

// ⑦ 元素宽 2 / 1:各按自己的宽度摆
短整数 短[2][2];
短[1][1] = 30000;
短[0][1] = -5;
字节 字[2][3];
字[1][2] = 200;
测试输出(短[1][1]);                // 30000
测试输出(短[0][1]);                // -5
测试输出(字[1][2]);                // 200
测试输出(地址(短[1][1]) - 地址(短[0][0]));    // 6 = (1 × 2 + 1) × 2
测试输出(地址(字[1][2]) - 地址(字[0][0]));    // 5 = (1 × 3 + 2) × 1

// ---- ⑧ 把"行优先"真铺满一遍(H82 批 2 加的一小节:上面 ①② 只对过一格) ----
// 这一段做的正是"袋子 ⇔ 摊平"那两行的**双向铺满**:
//   先让 `平()` 逐格写出它现在存着什么,再让 `袋()` 按行读一遍、看它读出来的是不是同一串。
// 于是下面 4 个数与上面 `地址(...)` 那两条断言说的是同一件事:两个写法**逐格子同构**。
var 面 = 0;
当 (面 < 12)
{
    平[面] = 面 + 1;               // 摊平那一行:平[0]…平[11] = 1…12(行优先顺序)
    面 = 面 + 1;
}
循环 (var 铺 = 0; 铺 < 3; 铺 = 铺 + 1)
{
    循环 (var 摆 = 0; 摆 < 4; 摆 = 摆 + 1)
    {
        袋[铺][摆] = 平[铺 * 4 + 摆];   // 从摊平那一行按行优先读回来:下标换成两个
    }
}
测试输出(袋[1][2]);                // 7 = 平[1 * 4 + 2]
测试输出(平[7]);                   // 8:同一个位置,两种写法
测试输出(袋[2][3]);                // 12
测试输出(地址(袋[2][3]) - 地址(袋[0][0]));    // 44:还是那一句 ((2 × 4) + 3) × 4

// ============================================================
// ---- 带 UI 的那一半(H82 批 2)----
// 只在**真开得了窗口**时才跑:没有图形能力的宿主给 假 ⇒ 一个字都不多打;
// 上面那 26 个数还是上面那 26 个数(顺序、条数一个字没动)。
// ============================================================

// 窗口尺寸与格阵摆法 —— **手算过的**(下面画图与命中测试用的是同一组数):
//   宽 560:左格阵 x = 12,每格 50 宽、间隔 2 ⇒ 4 格到 206;右摊平行 x = 268,12 格每格 23 宽到 548
//   高 574:页眉 12~72 / 格阵 122~262 / 说明 306~340 / 元素宽那一块 372~532
整数 窗宽 = 560;
整数 窗高 = 574;

整数 左x = 12;                   // 左边 3 × 4 格阵的左上角
整数 左y = 122;
整数 格宽 = 50;                  // 一格多宽
整数 格高 = 44;                  // 一格多高
整数 横距 = 52;                  // 下一列 = +52(= 50 宽 + 2 间隔)
整数 纵距 = 46;                  // 下一行 = +46(= 44 高 + 2 间隔)

整数 平x = 268;                  // 右边那一排 12 格(摊平成一维)
整数 平y = 194;
整数 平格宽 = 23;
整数 平外距 = 24;                // 12 格 + 3 个一组空 4 像素 ⇒ 12 * 23 + 3 * 4 = 288

// 底色 / 高亮 / 文字那几档颜色(画矩形是不透明实心:**底色先画、字后画**)
// (窗口标题、命中区的坐标、以及"一个函数只堆几个分支"这几条都照 `Sample\说明.md` 那节办)

// ---- 开窗前要拼的文字:**一个字符串都不留到主循环里现拼** ----
// ⚠ 为什么:字符串是在编译器那个池里一块块占地方的,每帧拼几条、真窗口跑一两分钟就报「池用完了」
//   (`示例02` 实测 209 帧就撞上)。所以下面这一整套**开窗时拼一次**,主循环只管 `画文字`。
// ⚠ 字符串数组**不能在声明时给初值**,只能一条条填(照说明里那张坑表)。
// ⚠ 一个函数里分支堆多了当场报「帧超出 96 字节」⇒ 下面按"一句一个函数"拆开。

// 左格阵每一格底下那行小字:格号(拆成两个函数,免得一个函数里堆 12 个 `格式化`)
方法 格号首(整数 n) 返回 字符串
{
    字符串 s = "";
    如果 (n == 0)
    {
        s = "#0";
    }
    如果 (n == 1)
    {
        s = "#1";
    }
    如果 (n == 2)
    {
        s = "#2";
    }
    如果 (n == 3)
    {
        s = "#3";
    }
    如果 (n == 4)
    {
        s = "#4";
    }
    如果 (n == 5)
    {
        s = "#5";
    }
    返回 s;
}

方法 格号次(整数 n) 返回 字符串
{
    字符串 s = "";
    如果 (n == 6)
    {
        s = "#6";
    }
    如果 (n == 7)
    {
        s = "#7";
    }
    如果 (n == 8)
    {
        s = "#8";
    }
    如果 (n == 9)
    {
        s = "#9";
    }
    如果 (n == 10)
    {
        s = "#10";
    }
    如果 (n == 11)
    {
        s = "#11";
    }
    返回 s;
}

方法 格号(整数 n) 返回 字符串
{
    如果 (n < 6)
    {
        返回 格号首(n);
    }
    返回 格号次(n);
}

// 右摊平行每一格上面那行小字:`平[0]` … `平[11]`(下标真的拼进去,两个函数分着堆)
方法 平标首(整数 n) 返回 字符串
{
    字符串 s = "";
    如果 (n == 0)
    {
        s = "平[0]";
    }
    如果 (n == 1)
    {
        s = "平[1]";
    }
    如果 (n == 2)
    {
        s = "平[2]";
    }
    如果 (n == 3)
    {
        s = "平[3]";
    }
    如果 (n == 4)
    {
        s = "平[4]";
    }
    如果 (n == 5)
    {
        s = "平[5]";
    }
    返回 s;
}

方法 平标次(整数 n) 返回 字符串
{
    字符串 s = "";
    如果 (n == 6)
    {
        s = "平[6]";
    }
    如果 (n == 7)
    {
        s = "平[7]";
    }
    如果 (n == 8)
    {
        s = "平[8]";
    }
    如果 (n == 9)
    {
        s = "平[9]";
    }
    如果 (n == 10)
    {
        s = "平[10]";
    }
    如果 (n == 11)
    {
        s = "平[11]";
    }
    返回 s;
}

方法 平标(整数 n) 返回 字符串
{
    如果 (n < 6)
    {
        返回 平标首(n);
    }
    返回 平标次(n);
}

// 底下那句"现在亮的是第几格"(也开窗前拼好,主循环里一条都不拼)
方法 亮号文(整数 n) 返回 字符串
{
    字符串 s = "现在亮的是 #";
    拼接到(s, 转字符串(n));
    拼接到(s, " 这一格 —— 左边第 ");
    拼接到(s, 转字符串(n / 4));
    拼接到(s, " 行、第 ");
    拼接到(s, 转字符串(n % 4));
    拼接到(s, " 列(两边同时亮的就是它)");
    返回 s;
}

// 底下说明第一行:两边的写法对上 —— `袋[行][列] ⇔ 平[行 * 4 + 列]`
// ⚠ 不能写成 `"袋[" + 格式化(...)` —— 字符串赋值右边只认"字面量 / 另一个字符串 / 一个返回字符串的调用",
//   多段要用 `拼接到` 一句一段接(照 `示例02` 那几行)。
方法 写法行(整数 r, 整数 c, 整数 n) 返回 字符串
{
    字符串 s = "袋[";
    拼接到(s, 转字符串(r));
    拼接到(s, "][");
    拼接到(s, 转字符串(c));
    拼接到(s, "]  ⇔  平[");
    拼接到(s, 转字符串(r * 4 + c));
    拼接到(s, "]   (行优先:行 × 4 + 列)");
    返回 s;
}

// 底下说明第二行:字节偏移 = ((行 × 4) + 列) × 4 = 具体数(每格 4 字节)
方法 偏移行(整数 r, 整数 c, 整数 n) 返回 字符串
{
    字符串 s = "字节偏移 = ((行 × 4) + 列) × 4 = ((";
    拼接到(s, 转字符串(r));
    拼接到(s, " × 4) + ");
    拼接到(s, 转字符串(c));
    拼接到(s, ") × 4 = ");
    拼接到(s, 转字符串((r * 4 + c) * 4));
    拼接到(s, " 字节");
    返回 s;
}

// ---- 窗口自己那点状态:写在**顶层**(照模板;不藏在嵌套里) ----
整数 类型 = 0;                    // 取事件那四个出参
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                     // 这一帧"点一下"点在哪(先记下来,浅一层再结算)
整数 点y = 0;
整数 亮 = 0;                      // 现在亮着的是第几格(0~11,行优先编号)
逻辑 有一下 = 假;                 // 这一帧收到过"点一下"没有

// 画的时候只用这几张表 —— 全部开窗前拼好
字符串 平标列[12];               // 右排每格上面那行 `平[0]` … `平[11]`
字符串 格号列[12];               // 左格阵每格底下那行 `#0` … `#11`
字符串 写法列[12];               // 说明第一行:`袋[行][列] ⇔ 平[行 * 4 + 列]`
字符串 偏移列[12];               // 说明第二行:字节偏移 = ((行 × 4) + 列) × 4 = 具体数
字符串 亮号列[12];               // 底下那句"现在亮的是第几格"
字符串 袋值列[12];               // 左格阵每格里的值 —— **开窗前**转成文字(主循环里一次都不再转)
字符串 平值列[12];               // 右排每格里的值 —— 同上

逻辑 开着 = 打开窗口("示例20 多维数组", 窗宽, 窗高);
如果 (开着)
{
    // ---- 开窗前那一次拼装:12 格 × 7 串,一共 84 条,之后一条都不再拼 ----
    //      ⚠ 格子里那两个值也必须在这儿转成文字 —— 主循环里写 `转字符串(袋[r][cc])` 是
    //      "返回字符串的调用当实参",**每调用一次漏一块池**(实测口径见 `未做任务清单.md` 的 H84 / H83),
    //      16 帧的脚本看不出来,真窗口挂几百帧就会报「池用完了」。
    var n = 0;
    当 (n < 12)
    {
        平标列[n] = 平标(n);
        格号列[n] = 格号(n);
        写法列[n] = 写法行(n / 4, n % 4, n);
        偏移列[n] = 偏移行(n / 4, n % 4, n);
        亮号列[n] = 亮号文(n);
        袋值列[n] = 转字符串(袋[n / 4][n % 4]);
        平值列[n] = 转字符串(平[n]);
        n = n + 1;
    }

    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 逐格推进 → 重画 → 刷新,转到用户自己关窗(或脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 点击结算:**单独摆在这一层**(命中测试与赋值别塞进上面那串嵌套里)。
        // 点左边任意一格 ⇒ 两边同时亮;点右边摊平那一排也认(两边本来就是同一块内存)。
        // ⚠ 两处命中**都要把 y 卡住**:右排只有 194~238 那一行 —— 少了 y 上界,点它底下的说明文字
        //   会被左边格阵那一条按 y 接走(实测:点 (180, 250) 点亮了 #0),所以两条各带自己的矩形。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 左x && 点x < 左x + 4 * 横距 && 点y >= 左y && 点y < 左y + 3 * 纵距)
            {
                亮 = ((点y - 左y) / 纵距) * 4 + ((点x - 左x) / 横距);
            }
            如果 (点x >= 平x && 点x < 平x + 12 * 平格宽 + 3 * 4 && 点y >= 平y && 点y < 平y + 格高)
            {
                亮 = (点x - 平x) / 平外距;
            }
        }
        否则
        {
            // 这一帧没点过 ⇒ 逐帧推进:高亮沿行优先顺序往后挪一格(#0 → #1 → … → #11 → #0)。
            // 放在 `否则` 里是为了"刚点亮的格子不被同一帧推走" —— 点击那一下停在屏上看得见。
            亮 = 亮 + 1;
            如果 (亮 >= 12)
            {
                亮 = 0;
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是现成的)----
            清屏(0xFF101018);
            画矩形(12, 12, 窗宽 - 24, 60, 0xFF2A3550);
            画文字(24, 18, "示例20 多维数组:同一块内存的两种看法 —— 行优先", 0xFFE8E8F0);
            画文字(24, 42, "左:整数 袋[3][4] 的 3 × 4 格阵   右:摊平成一维的 整数 平[12]", 0xFFB0B0B8);

            // 左面板:格阵(⚠ 标题只能放得下 ~14 格:再长就被右面板那块的实心底色压住 ——
            //   无头呈现看不出来,"盖字检查"那条几何机检逮到的)
            画矩形(12, 80, 240, 16, 0xFF232B3E);
            画文字(20, 81, "袋[行][列] —— 行优先", 0xFF9CC4FF);

            // 右面板:摊平成一维那一排
            画矩形(268, 80, 280, 16, 0xFF232B3E);
            画文字(276, 81, "平[行 * 4 + 列]:同一块内存摊平", 0xFF9CC4FF);

            // 左边 3 × 4:每格画出值 + 底下那行格号
            var r = 0;
            当 (r < 3)
            {
                var cc = 0;
                当 (cc < 4)
                {
                    var 格号 = r * 4 + cc;
                    var 格x = 左x + cc * 横距;
                    var 格y = 左y + r * 纵距;
                    如果 (格号 == 亮)
                    {
                        画矩形(格x, 格y, 格宽, 格高, 0xFF2A6EF0);      // 底色先画
                    }
                    否则
                    {
                        画矩形(格x, 格y, 格宽, 格高, 0xFF2A3550);
                    }
                    画文字(格x + 17, 格y + 12, 袋值列[格号], 0xFFE8E8F0);   // 字后画(值是开窗前转好的)
                    画文字(格x + 15, 格y + 33, 格号列[格号], 0xFF8A8A96);
                    cc = cc + 1;
                }
                r = r + 1;
            }

            // 右边 12 格:同一块内存摊平成的一维 —— 亮的那一格与左边**同一格**
            var p = 0;
            当 (p < 12)
            {
                var 平格x = 平x + p * 平外距;
                如果 (p == 亮)
                {
                    画矩形(平格x, 平y, 平格宽, 格高, 0xFF2A6EF0);
                }
                否则
                {
                    画矩形(平格x, 平y, 平格宽, 格高, 0xFF2A3550);
                }
                画文字(平格x + 8, 平y + 13, 平值列[p], 0xFFE8E8F0);
                var 标x = 平格x + 1;
                // ⚠ 最后一格标签(平[11])按原位置会顶出右边界 21 像素 —— 无头看不出来,往左让一让
                如果 (p == 11)
                {
                    标x = 平格x - 22;
                }
                画文字(标x, 平y - 20, 平标列[p], 0xFF9CC4FF);
                p = p + 1;
            }

            // ---- 底下说明:两边说的是同一格,再给出具体字节偏移 ----
            画线(12, 292, 548, 292, 0xFF3C3C46);
            画文字(20, 306, 写法列[亮], 0xFFE8E8F0);
            画文字(20, 330, 偏移列[亮], 0xFFD0D0D8);

            // ---- 元素宽那一块:同一个 (2 × 4 + 3),宽度不同偏移就不同 ----
            画矩形(12, 372, 536, 24, 0xFF232B3E);
            画文字(20, 376, "元素宽不同 ⇒ 同一个 ((2 × 4) + 3) 的偏移不同(上面演的是 整数)", 0xFF9CC4FF);
            画文字(20, 408, "袋[2][3] 是第 11 个格子( = 2 * 4 + 3),按元素宽 4 摆,地址(袋[2][3]) = 首址 + 44", 0xFFD0D0D8);
            画文字(20, 432, "地址(短[1][1]) - 地址(短[0][0]) = 6:短整数 一格 2 字节,(1 × 2 + 1) × 2", 0xFF8A8A96);
            画文字(20, 456, "地址(字[1][2]) - 地址(字[0][0]) = 5:字节 一格 1 字节,(1 × 3 + 2) × 1", 0xFF8A8A96);
            画文字(20, 480, "行优先 = 最后一维最快:先铺满 0 行 4 格,再去 1 行(每帧挪一格)", 0xFF8A8A96);

            // ---- 越界是逐维查的(说明文字;**不真跑那一句**) ----
            画线(12, 510, 548, 510, 0xFF3C3C46);
            画文字(20, 524, "越界逐维查:第 1 维只有 3 个元素 ⇒ 写 袋[3][0] 编译期报错", 0xFFE8E8F0);
            画文字(20, 548, 亮号列[亮], 0xFFB0B0B8);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();
}

停止

