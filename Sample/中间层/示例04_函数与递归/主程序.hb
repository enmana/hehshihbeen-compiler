// ============================================================
// 示例04:函数与递归 —— 中间层写子程序的全部基本件
//
// 这个示例演示什么:怎么用 `函数` 声明子程序、怎么收参数、怎么把结果送回来。
// 重点看哪几处:
//   ① 函数头尾缀 `返回 类型`:写在参数表**后面**(Rust 风);不写 = 没有返回值,
//      里面 `返回 值` 会当场报错。英文写法是 `func 名(...) return 类型`。
//   ② 返回值直接写进表达式:`测试输出(sq(7))`、`sq(sq(2)) + 1`,
//      不用再"先调用一句、再读 R0"。参数与局部变量都放固定 64 字节的帧里,所以能递归。
//   ③ 递归:阶乘 `fact(n - 1) * n` —— 每层调用各有自己的帧,互不干扰。
//   ④ 数组参数 `整数 nums[]`:编译器自动传"地址 + 长度"两个字,
//      函数里能用 `nums.长度()` 当循环上界、`nums[i]` 自动查越界。
//   ⑤ 结构参数 `点 p`:按**地址**传(和 C 的指针一个道理),所以被调方改了就是改调用方那份;
//      而标量参数(整数/短整数/…)是**值传递**,函数里怎么改都不影响调用方。
//   ⑥ 三种"把两倍写回调用方"的办法:返回值 / 结构参数 / 无返回值(void)。
//
// 关键字中英等价(如果=if、函数=func、返回=return、当=while),标识符随便起,
// 中文优先只是默认;本示例标识符一律用短英文。
// 本示例不需要任何库,单独就能编译运行。
//
//   ============================================================
//   怎么看(带 UI;H82 批 3)—— 这一份是"能开窗就开窗"的写法,演的是**调用栈**:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例04 函数与递归`。
//       左边一竖条就是**调用栈**:**栈顶在最上面**(蓝底那一格),一层一个方框:
//       框里是"这一层是谁、拿着什么参数"(`fact(3) 进入,n = 3`),右边对齐那一列是这一层的
//       返回值 / 中间结果(`n = 3,还要往下调一层`)。**递归往里走就压一层**(方框往下长)、
//       **回来就弹一层**:弹掉的那层随即变灰、右边改成"已返回 N ⇒ 弹掉了"。
//       于是 `fact(5)` 的五层怎么一层层压到 `n = 1`、又怎么把 1 / 2 / 6 / 24 / 120 一层层弹回来,
//       整段看得见;后面 `sq` / 较大 / 求和 那几段是"压一层就回来"。
//     · **点左边某一层**:底下那块当场说这一层"拿到的参数 / 正在算什么 / 返回值"。
//       点空白处不认(命中只认那 6 行方框)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、也不用等人去关 ——
//       旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),第 29 帧宿主投一个关窗请求;
//       于是"每帧栈长什么样、点一层换出哪几行说明"都能逐行对出来(硬规矩 6:自检不开窗)。
//     · **顺序**:先把上面那些纯计算跑完、`测试输出` 打完(文件末尾那行 `// 预期输出:` 对的就是它们),
//       **然后**才开窗 —— 于是这一份示例的期望输出里,"数"还是那些数,窗口那几行排在后头。
//   ============================================================

包含 "../../库/string.hb"        // `格式化(...)` 要用的那个 `转字符串` 在库里(放文件头,与 示例07 / 示例20 一样)

结构 点
{
    整数 x;
    整数 y;
}

// ① 最普通的函数:参数 + `返回 类型`,返回值直接当值用
方法 sq(整数 n) 返回 整数
{
    返回 n * n;
}

方法 较大(整数 a, 整数 b) 返回 整数
{
    如果 (a > b)
    {
        返回 a;
    }
    返回 b;                       // 没有 否则 的那一支:直接落到这里
}

// ③ 递归:fact(n) = n × fact(n-1);帧是每次调用新的一份,所以递归安全
方法 fact(整数 n) 返回 整数
{
    if (n <= 1)
    {
        返回 1;
    }
    返回 fact(n - 1) * n;
}

// ④ 数组参数:实参只能是变量/字段/数组元素(传的是地址),不用手写 地址(...)
方法 求和(整数 nums[]) 返回 整数
{
    整数 s = 0;
    整数 i = 0;
    当 (i < nums.长度())          // 长度自动跟着来:同一个函数收 5 个的 / 3 个的都行
    {
        s = s + nums[i];
        i = i + 1;
    }
    返回 s;
}

// ⑤ 结构参数:默认按地址传 —— 改的就是调用方那个结构
方法 移动(点 p, 整数 dx, 整数 dy)
{
    p.x = p.x + dx;
    p.y = p.y + dy;
}

// ⑤ 反面对照:标量参数是值传递,函数里改了调用方一点感觉都没有
方法 白加(整数 n)
{
    n = n + 100;
    返回
}

整数 nums[5] = [3, 1, 4, 1, 6];   // `[…]` 初值:没写到的元素补 0

测试输出(sq(7));                   // 49:返回值直接当参数用
测试输出(较大(5, 12));             // 12
测试输出(fact(5));                 // 120:递归 5×4×3×2×1
测试输出(求和(nums));              // 15:数组参数 + .长度()
测试输出(sq(sq(2)) + 1);           // 17:调用嵌调用、还能参与算术

点 p;
p.x = 1;
p.y = 2;
移动(p, 10, 20);                   // 结构参数按地址传
测试输出(p.x);                     // 11
测试输出(p.y);                     // 22

整数 k = 3;
白加(k);                           // 值传递:函数里的 n 是另一份
测试输出(k);                       // 3

// ---- 带 UI 的那一半(H82 批 3):把**调用栈**一层一层画出来 ----
// 这一整块**只在真开得了窗口时才跑**:没有图形能力的宿主给 假 ⇒ 一个字都不多打,
// 上面那八个 `测试输出` 还是那八个(顺序、条数一个字没动)。
//
//   · 左边那一竖条 = 调用栈:**最上面那一格就是栈顶**(蓝底),一层一个方框:
//     框里是"这一层是谁 + 它的参数"(`fact(3) 进入,n = 3`),右边对齐那一列是这一层的
//     返回值 / 中间结果(`n = 3,还要往下调一层`);已经弹掉的层画成灰底灰字。
//   · 每 `刷新()` 进一帧:递归往里走就**压一层**(方框往下长)、回来就**弹一层** ——
//     `fact(5)` 那五层的压栈与弹栈整段演完,再演 `sq` / 较大 / 求和 的"压一层就回来"。
//   · 点左边某一层 ⇒ 底下那块说这一层"拿到的参数 / 正在算什么 / 返回值"。
//
// ⚠ 主循环(每帧都跑的那一层)里**一条字符串都不拼**:要画的字全在开窗前拼好、存进
//   `字符串` 数组,每帧只按下标取。实测口径(见 `Sample\说明.md` 的坑表):主循环里写
//   `画文字(x, y, 转字符串(值), 色)` 这种"返回字符串的调用当实参"**每调用一次漏一块池**,
//   真窗口上挂几百帧就报「池用完了」;这一篇一条都不现拼。
// ⚠ 摆位与命中测试**用的是同一组数**(`栈顶` / `框高` / `框距`):要挪地方只改这几行。

整数 窗宽 = 560;
整数 窗高 = 700;
整数 栈顶 = 104;                // 第一层(栈顶那一格)的顶边
整数 框高 = 24;                 // 一个方框多高
整数 框距 = 28;                 // 两层之间的间隔(= 命中测试的除数)
整数 框宽 = 500;                // 方框的宽
整数 框x = 12;                  // 方框的左边
整数 详左 = 24;                 // 底下说明那几行的左边
整数 详右 = 360;                // 右边对齐那一列的左边(窄的那一列,按 22 格排)
整数 层满 = 6;                  // 最多画几层
整数 步满 = 24;                 // 逐帧推进一共走几步(把压到最深再弹回来演完)

// ⚠ 帧 96 字节按"临时槽"收费:分支里带 `格式化(...)` 的最贵(实测:六个 `格式化` 就报
//    「帧超出 96 字节」)⇒ 下面这些函数一律**只写字面量**,一个 `格式化` 都不放。
// ⚠ 方框左边那一列:这一层是谁 + 参数。24 步 × 最多 6 层,但一条规则能管好几步,
//    所以下面的分支一条顶多步。
方法 左1(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 1 && 层 == 0)
    {
        s = "fact(5) 进入,n = 5";
    }
    如果 (步 == 2 && 层 < 2)
    {
        s = "fact(4) 进入,n = 4";
    }
    如果 (步 == 3 && 层 < 3)
    {
        s = "fact(3) 进入,n = 3";
    }
    如果 (步 == 4)
    {
        s = "fact(2) 进入,n = 2";
    }
    如果 (步 == 5)
    {
        s = "fact(1) 进入,n = 1(n <= 1 到底了)";
    }
    如果 (步 == 6 && 层 == 0)
    {
        s = "fact(1) 进入,n = 1(n <= 1 到底了)";
    }
    如果 (步 == 7 && 层 == 0)
    {
        s = "fact(2) 进入,n = 2";
    }
    如果 (步 == 7 && 层 == 1)
    {
        s = "fact(2) 拿到 1,要算 1 × 2";
    }
    如果 (步 == 8 && 层 == 0)
    {
        s = "fact(3) 进入,n = 3";
    }
    返回 s;
}

方法 左2(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 10)
    {
        s = "sq(7) 进入,n = 7(不是递归,压一层就弹)";
    }
    如果 (步 == 11)
    {
        s = "sq(2) 进入,n = 2(它嵌在 sq(7) 的实参里)";
    }
    如果 (步 == 12)
    {
        s = "较大(5, 12) 进入,a = 5、b = 12";
    }
    如果 (步 == 13)
    {
        s = "求和(nums) 进入,长度 5";
    }
    如果 (步 == 14)
    {
        s = "求和:nums[0] = 3 加进 s";
    }
    如果 (步 == 15)
    {
        s = "求和:nums[1] = 1 加进 s";
    }
    如果 (步 == 16)
    {
        s = "求和:nums[2] = 4 加进 s";
    }
    返回 s;
}

// ⚠ 从第 6 步起那几层正在等下一层回来 —— 它们的文字**按"第几层"一条条摆出来**
//    (递推摆:第 k 层等的是 fact(k) 的结果)。别只写给第 0 层:那样第 6~9 步里
//    夹在中间的那几层会一个字都没有(实测撞到过)。
方法 左3(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 6 && 层 == 0)
    {
        s = "fact(1) 进入,n = 1(n <= 1 到底了)";
    }
    如果 (步 == 6 && 层 == 1)
    {
        s = "fact(2) 等下一层,n = 2";
    }
    如果 (步 == 6 && 层 == 2)
    {
        s = "fact(3) 等下一层,n = 3";
    }
    如果 (步 == 6 && 层 == 3)
    {
        s = "fact(4) 等下一层,n = 4";
    }
    如果 (步 == 7 && 层 == 0)
    {
        s = "fact(2) 进入,n = 2";
    }
    如果 (步 == 7 && 层 == 1)
    {
        s = "fact(2) 拿到 1,要算 1 × 2";
    }
    如果 (步 == 7 && 层 == 2)
    {
        s = "fact(3) 等下一层,n = 3";
    }
    如果 (步 == 7 && 层 == 3)
    {
        s = "fact(4) 等下一层,n = 4";
    }
    如果 (步 == 8 && 层 == 0)
    {
        s = "fact(3) 进入,n = 3";
    }
    如果 (步 == 8 && 层 == 1)
    {
        s = "fact(3) 拿到 2,要算 2 × 3";
    }
    如果 (步 == 8 && 层 == 2)
    {
        s = "fact(4) 等下一层,n = 4";
    }
    返回 s;
}

方法 左4(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 9 && 层 == 0)
    {
        s = "fact(4) 进入,n = 4";
    }
    如果 (步 == 9 && 层 == 1)
    {
        s = "fact(4) 拿到 6,要算 6 × 4";
    }
    返回 s;
}

方法 左5(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 17)
    {
        s = "求和:nums[3] = 1 加进 s";
    }
    如果 (步 == 18)
    {
        s = "求和:nums[4] = 6 加进 s";
    }
    如果 (步 == 19)
    {
        s = "求和:5 个加完,准备 返回 15";
    }
    如果 (步 == 20)
    {
        s = "整座栈弹空:fact(5) = 120";
    }
    如果 (步 == 21)
    {
        s = "整座栈弹空:sq(7) = 49";
    }
    如果 (步 == 22)
    {
        s = "整座栈弹空:较大(5, 12) = 12";
    }
    如果 (步 == 23)
    {
        s = "整座栈弹空:求和(nums) = 15";
    }
    返回 s;
}

方法 方框左(整数 步, 整数 层) 返回 字符串
{
    字符串 a1 = 左1(步, 层);
    如果 (a1 != "?")
    {
        返回 a1;
    }
    a1 = 左2(步, 层);
    如果 (a1 != "?")
    {
        返回 a1;
    }
    a1 = 左3(步, 层);
    如果 (a1 != "?")
    {
        返回 a1;
    }
    a1 = 左4(步, 层);
    如果 (a1 != "?")
    {
        返回 a1;
    }
    a1 = 左5(步, 层);
    如果 (a1 != "?")
    {
        返回 a1;
    }
    返回 "";
}

// ⚠ 方框右边那一列:这一层的返回值 / 中间结果(窄,按 22 格排)
方法 右1(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 1)
    {
        s = "n = 5,还要往下调";
    }
    如果 (步 == 2)
    {
        s = "n = 4,还要往下调";
    }
    如果 (步 == 3)
    {
        s = "n = 3,还要往下调";
    }
    如果 (步 == 4)
    {
        s = "n = 2,还要往下调";
    }
    如果 (步 == 5)
    {
        s = "n = 1 ⇒ 直接返回 1";
    }
    如果 (步 == 6 && 层 == 0)
    {
        s = "n = 1 ⇒ 直接返回 1";
    }
    如果 (步 == 7 && 层 == 0)
    {
        s = "1 × 2 = 2,返回 2";
    }
    如果 (步 == 7 && 层 == 1)
    {
        s = "n = 2,等下一层";
    }
    如果 (步 == 8 && 层 == 0)
    {
        s = "2 × 3 = 6,返回 6";
    }
    如果 (步 == 8 && 层 == 1)
    {
        s = "n = 3,等下一层";
    }
    如果 (步 == 9 && 层 == 0)
    {
        s = "6 × 4 = 24,返回 24";
    }
    返回 s;
}

方法 右2(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 9 && 层 == 1)
    {
        s = "n = 4,等下一层";
    }
    如果 (步 == 10)
    {
        s = "n = 7,返回 49";
    }
    如果 (步 == 11)
    {
        s = "n = 2,返回 4";
    }
    如果 (步 == 12)
    {
        s = "a > b 成立,返回 12";
    }
    如果 (步 == 13)
    {
        s = "s = 0,从 nums[0] 起";
    }
    如果 (步 == 14)
    {
        s = "s = 3,还在转";
    }
    如果 (步 == 15)
    {
        s = "s = 4,还在转";
    }
    如果 (步 == 16)
    {
        s = "s = 8,还在转";
    }
    如果 (步 == 17)
    {
        s = "s = 9,还在转";
    }
    如果 (步 == 18)
    {
        s = "s = 15,循环到头了";
    }
    如果 (步 == 19)
    {
        s = "返回 s = 15";
    }
    返回 s;
}

// ⚠ 第 6~9 步里还在等下一层的那几层:右边那一列也是**按第几层递推**摆出来
//    (第 k 层等的是 fact(k) 的结果)—— 只写给第 0 层的话,中间那几层的右边会是空的。
方法 右3(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 6 && 层 == 1)
    {
        s = "n = 2,等下一层";
    }
    如果 (步 == 6 && 层 == 2)
    {
        s = "n = 3,等下一层";
    }
    如果 (步 == 6 && 层 == 3)
    {
        s = "n = 4,等下一层";
    }
    如果 (步 == 7 && 层 == 2)
    {
        s = "n = 3,等下一层";
    }
    如果 (步 == 7 && 层 == 3)
    {
        s = "n = 4,等下一层";
    }
    如果 (步 == 8 && 层 == 2)
    {
        s = "n = 4,等下一层";
    }
    如果 (步 == 9 && 层 == 1)
    {
        s = "n = 4,等下一层";
    }
    如果 (步 == 20)
    {
        s = "fact(5) = 120,栈弹空";
    }
    如果 (步 == 21)
    {
        s = "sq(7) = 49,栈弹空";
    }
    如果 (步 == 22)
    {
        s = "较大(5, 12) = 12,栈弹空";
    }
    如果 (步 == 23)
    {
        s = "求和(nums) = 15,栈弹空";
    }
    如果 (步 >= 10 && 层 >= 1)
    {
        s = "(没有更深的层)";
    }
    返回 s;
}

方法 方框右(整数 步, 整数 层) 返回 字符串
{
    字符串 a2 = 右1(步, 层);
    如果 (a2 != "?")
    {
        返回 a2;
    }
    a2 = 右2(步, 层);
    如果 (a2 != "?")
    {
        返回 a2;
    }
    a2 = 右3(步, 层);
    如果 (a2 != "?")
    {
        返回 a2;
    }
    返回 "";
}

// ⚠ 已经弹掉的层:那一格已经不在栈上了(层号 ≥ 这一步的栈深)⇒ 框变灰、右边换成
//    "它当时把什么送回来了"。⚠ 判据只能用**栈深**,不能用步号:`步` 超过 9 之后
//    栈深一直停在 1,再拿步号去比就会把还在栈上的第 0 层也画成"弹掉了"。
// ⚠ 这一格**必须给每一对 (步, 层) 都返回一个值**(还没弹掉的层就把 `方框右` 的原话还回去):
//    返回空串的话,填表那一步就**跳过赋值** —— 这一格会留着上一对 (步, 层) 写进去的旧话,
//    点它时底下读到的是别的层的字(实测撞到过:第 27 帧点第 2 层读出了 fact(1))。
方法 弹右(整数 步, 整数 层) 返回 字符串
{
    整数 dn = 10 - 步;
    如果 (步 < 6)
    {
        dn = 步;
    }
    如果 (步 >= 10)
    {
        dn = 1;
    }
    如果 (层 < dn)
    {
        返回 方框右(步, 层);
    }
    字符串 s = "已返回 1 ⇒ 弹掉了";
    如果 (层 == 1)
    {
        s = "已返回 2 ⇒ 弹掉了";
    }
    如果 (层 == 2)
    {
        s = "已返回 6 ⇒ 弹掉了";
    }
    如果 (层 == 3)
    {
        s = "已返回 24 ⇒ 弹掉了";
    }
    如果 (层 == 4)
    {
        s = "已返回 120 ⇒ 弹掉了";
    }
    返回 s;
}

// ⚠ 底下那一行:这一层"拿到的参数 / 正在算什么"。**按栈深递推**一条条摆出来
//    (第 k 层等的是 fact(k) 的结果)—— 只有第 0 层有字、其余留空的话,一点中间那几层
//    底下就空了。
方法 详1(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 1)
    {
        s = "参数 n = 5;它算的是 fact(5) = fact(4) × 5";
    }
    如果 (步 == 2)
    {
        s = "参数 n = 4;它算的是 fact(4) = fact(3) × 4";
    }
    如果 (步 == 3)
    {
        s = "参数 n = 3;它算的是 fact(3) = fact(2) × 3";
    }
    如果 (步 == 4)
    {
        s = "参数 n = 2;它算的是 fact(2) = fact(1) × 2";
    }
    如果 (步 == 5)
    {
        s = "参数 n = 1;n <= 1 成立 ⇒ 直接 返回 1";
    }
    如果 (步 == 6 && 层 == 0)
    {
        s = "参数 n = 1;它已经 返回 1,这一层要弹掉了";
    }
    如果 (步 == 6 && 层 == 1)
    {
        s = "参数 n = 2;它正在等下面那层回来";
    }
    如果 (步 == 6 && 层 == 2)
    {
        s = "参数 n = 3;它正在等下面那层回来";
    }
    如果 (步 == 6 && 层 == 3)
    {
        s = "参数 n = 4;它正在等下面那层回来";
    }
    如果 (步 == 7 && 层 == 0)
    {
        s = "参数 n = 2;拿到 fact(1) = 1,接着算 1 × 2";
    }
    如果 (步 == 7 && 层 >= 1)
    {
        s = "参数 n = 4;它正在等下面那层回来";
    }
    如果 (步 == 8 && 层 == 0)
    {
        s = "参数 n = 3;拿到 fact(2) = 2,接着算 2 × 3";
    }
    如果 (步 == 8 && 层 >= 1)
    {
        s = "参数 n = 4;它正在等下面那层回来";
    }
    如果 (步 == 9 && 层 == 0)
    {
        s = "参数 n = 4;拿到 fact(3) = 6,接着算 6 × 4";
    }
    如果 (步 == 9 && 层 >= 1)
    {
        s = "参数 n = 4;它正在等下面那层回来";
    }
    返回 s;
}

方法 详2(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 10)
    {
        s = "参数 n = 7;返回 n × n = 49(压一层就弹)";
    }
    如果 (步 == 11)
    {
        s = "参数 n = 2;它嵌在 sq(7) 的实参里,得先算它";
    }
    如果 (步 == 12)
    {
        s = "参数 a = 5、b = 12;比出大的那个再 返回";
    }
    如果 (步 == 13)
    {
        s = "参数 nums[](数组参数传的是地址);循环用 nums.长度()";
    }
    如果 (步 == 14)
    {
        s = "局部 s、i;这一轮把 nums[0] 加进 s";
    }
    如果 (步 == 15)
    {
        s = "局部 s、i;这一轮把 nums[1] 加进 s";
    }
    如果 (步 == 16)
    {
        s = "局部 s、i;这一轮把 nums[2] 加进 s";
    }
    如果 (步 == 17)
    {
        s = "局部 s、i;这一轮把 nums[3] 加进 s";
    }
    如果 (步 == 18)
    {
        s = "局部 s、i;这一轮把 nums[4] 加进 s";
    }
    如果 (步 == 19)
    {
        s = "i 到 5 了,循环出来,把 s 送回去";
    }
    返回 s;
}

方法 详3(整数 步, 整数 层) 返回 字符串
{
    字符串 s = "?";
    如果 (步 == 20)
    {
        s = "参数 n = 5;五层都回来了,整座栈弹空";
    }
    如果 (步 == 21)
    {
        s = "它跟上面第 1 条 `测试输出(sq(7))` 是同一次调用";
    }
    如果 (步 == 22)
    {
        s = "它跟上面第 2 条 `测试输出(较大(5, 12))` 是同一次";
    }
    如果 (步 == 23)
    {
        s = "它跟上面第 4 条 `测试输出(求和(nums))` 是同一次";
    }
    返回 s;
}

方法 详情(整数 步, 整数 层) 返回 字符串
{
    字符串 a3 = 详1(步, 层);
    如果 (a3 != "?")
    {
        返回 a3;
    }
    a3 = 详2(步, 层);
    如果 (a3 != "?")
    {
        返回 a3;
    }
    a3 = 详3(步, 层);
    如果 (a3 != "?")
    {
        返回 a3;
    }
    返回 "这一层已经弹掉了,只剩它当时那两个参数";
}

// ---- 窗口自己那点状态:写在**顶层**(照模板;不藏在嵌套里) ----
整数 类型 = 0;                  // 取事件那四个出参
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                   // 这一帧"点一下"点在哪(先记下来,浅一层再结算)
整数 点y = 0;
整数 步 = 0;                    // 逐帧推进走到第几步
整数 深 = 0;                    // 这一步的栈深(0 = 栈空)
整数 层 = 0;                    // 底下说的是第几层(0 = 栈顶)
逻辑 有一下 = 假;               // 这一帧收到过"点一下"没有

// 画的时候只用这几张表 —— 全部开窗前拼好,主循环里一条字符串都不再拼
// ⚠ `字符串` 数组**不能在声明时给初值**(只能声明后一条条填)。
字符串 左表[144];
字符串 右表[144];
字符串 详表[144];

逻辑 开着 = 打开窗口("示例04 函数与递归", 窗宽, 窗高);
如果 (开着)
{
    // ---- 开窗前那一次拼装:24 步 × 6 层 = 144 格 × 3 串 = 432 条,之后一条都不再拼 ----
    //      ⚠ 值也必须在这儿转成文字 —— 主循环里写 `格式化(...)` / `转字符串(...)` 当实参
    //      就是"返回字符串的调用当实参",**每调用一次漏一块池**(真窗口挂几百帧就报「池用完了」)。
    整数 a = 0;
    当 (a < 步满)
    {
        整数 b = 0;
        当 (b < 层满)
        {
            左表[a * 6 + b] = 方框左(a, b);
            右表[a * 6 + b] = 方框右(a, b);
            详表[a * 6 + b] = 详情(a, b);
            b = b + 1;
        }
        a = a + 1;
    }
    // 已经弹掉的那些帧:右边那一列换成"它当时送回来的值"
    整数 c = 0;
    当 (c < 步满)
    {
        整数 d = 0;
        当 (d < 层满)
        {
            字符串 e = 弹右(c, d);
            如果 (e != "")
            {
                右表[c * 6 + d] = e;
            }
            d = d + 1;
        }
        c = c + 1;
    }

    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 逐帧推进 → 重画 → 刷新,转到用户自己关窗(或脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 点击结算:**单独摆在这一层**(命中测试与赋值别塞进上面那串嵌套里)。
        // 只认那 6 行方框:点在空白处不认 —— 少了 y 的上界,点到底下说明文字会被按 y 接走。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 框x && 点x < 框x + 框宽 && 点y >= 栈顶 && 点y < 栈顶 + 层满 * 框距)
            {
                整数 行 = (点y - 栈顶) / 框距;
                如果 (行 < 深)
                {
                    层 = 行;
                }
            }
        }

        // 逐帧推进:每 `刷新()` 进一帧。第 0 步 = 栈空;第 1~5 步一层层压到最深的 5 层;
        // 第 6~9 步一层层弹回来;第 10 步起换 `sq` / 较大 / 求和 这几段"压一层就回来"。
        如果 (!有一下)
        {
            步 = 步 + 1;
            如果 (步 >= 步满)
            {
                步 = 0;
            }
        }
        如果 (步 < 6)
        {
            深 = 步;
        }
        否则 如果 (步 < 10)
        {
            深 = 10 - 步;
        }
        否则
        {
            深 = 1;
        }
        如果 (深 == 0)
        {
            层 = 0;
        }
        如果 (层 >= 深 && 深 > 0)
        {
            层 = 深 - 1;
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是现成的)----
            清屏(0xFF101018);
            画矩形(12, 12, 窗宽 - 24, 60, 0xFF2A3550);
            画文字(24, 18, "示例04 函数与递归:把调用栈一层层压出来", 0xFFE8E8F0);
            画文字(24, 42, "左:调用栈(栈顶在最上面)  右:这一层的返回值 / 中间结果", 0xFFB0B0B8);

            // 左边那一块板的底 —— ⚠ 底色一律画在文字**之前**(`画矩形` 是不透明实心,
            //   画在文字后面会把字盖掉;无头呈现看不出来,桌面壳上才看得出来)。
            画矩形(12, 80, 窗宽 - 24, 440, 0xFF16161E);
            画文字(24, 88, "调用栈(最上面那格是栈顶;往下 = 往里调)", 0xFF9CC4FF);
            画文字(详右, 88, "这一层的返回值 / 中间结果", 0xFF9CC4FF);

            整数 i = 0;
            当 (i < 深 && i < 层满)
            {
                整数 框y = 栈顶 + i * 框距;
                // ⚠ 0xFF…… 这种 32 位色值**只能直接写在 `画矩形` / `画文字` 的实参位置**:
                //   存进 `整数` 变量当场报「常量超出 整数 范围(整数 是有符号的)」;
                //   要存就先摆进一个 `无符号整数` 变量(本示例用不着那一手)。
                如果 (i == 深 - 1)
                {
                    画矩形(框x, 框y, 框宽, 框高, 0xFF2A6EF0);     // 栈顶那一格:蓝底
                }
                否则 如果 (i == 0)
                {
                    画矩形(框x, 框y, 框宽, 框高, 0xFF3A4468);     // 最底下那一层(它最先被调进来)
                }
                否则
                {
                    画矩形(框x, 框y, 框宽, 框高, 0xFF232B3E);     // 中间那些层
                }
                如果 (i == 深 - 1)
                {
                    画矩形(框x, 框y, 4, 框高, 0xFF7AB0FF);        // 栈顶那一格左边点一道竖条
                }
                如果 (i == 深 - 1)
                {
                    画文字(20, 框y + 6, 左表[步 * 6 + i], 0xFFF0F0F8);
                    画文字(详右, 框y + 6, 右表[步 * 6 + i], 0xFFFFE08A);
                }
                否则
                {
                    画文字(20, 框y + 6, 左表[步 * 6 + i], 0xFFD0D0D8);
                    画文字(详右, 框y + 6, 右表[步 * 6 + i], 0xFFE8E8F0);
                }
                i = i + 1;
            }

            // ---- 底下说明:点中那一层"拿到的参数 / 算了什么 / 返回值" ----
            画线(12, 540, 窗宽 - 12, 540, 0xFF3C3C46);
            画矩形(12, 552, 窗宽 - 24, 92, 0xFF16161E);
            画文字(详左, 556, "这一层:参数 / 算了什么 / 返回值(点左边任意一层)", 0xFF9CC4FF);
            画文字(详左, 582, 左表[步 * 6 + 层], 0xFFE8E8F0);
            画文字(详左, 606, 详表[步 * 6 + 层], 0xFFB0B0B8);
            画文字(详左, 628, 右表[步 * 6 + 层], 0xFFD0D0D8);
            画文字(详左, 662, "每帧压一层 / 弹一层;栈空那几帧顶上没方框", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();
}

