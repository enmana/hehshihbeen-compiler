// 示例29_网络:G3 域 3 网络(裸 socket)的七个函数
//          (连到 / 发送 / 接收 / 关闭 / 监听 / 接受 / 主机解析)
//
// 为什么要有它们:`取网址` 只做"同步一次性 GET"(HTTP 由宿主自己解析),要自己写一套协议
// (或者当一个小服务端)就得有裸 TCP。这一篇**自己连自己**:先在 `127.0.0.1` 上监听,
// 再连上去 —— 一来一回把收发两条路都走通,不碰外网,也不用别的程序配合。
//
// 两条口径(完整说明见帮助《三十一、网络》):
//   ① 主机 + 端口必须先在工程文件 `.hbp` 的 `网址` 表里声明(本工程里就有一条 `127.0.0.1:45217`);
//      不在表里**连试都不试**(连接给 -1、主机解析给 假)。
//   ② 这一族**全同步阻塞**:连上 / 收到东西 / 有人来连才往下走(异步那一档是别的域)。

字符串 本机 = "127.0.0.1";
整数 端口 = 45217;

// ---------------- ① 监听:绑一块网卡 + 一个端口,等着别人来 ----------------
整数 听 = 0;
听 = 监听(本机, 端口, 听);
输出行(听 > 0);                                    // 句柄是个正整数(绑不上给 -1)

// ---------------- ② 主机解析:主机名 → 地址(写进那个字符串变量) ----------------
字符串 地址 = "";
输出行(主机解析(本机, 地址));                     // 真 = 解析到了
输出行(地址);                                      // 127.0.0.1

// ---------------- ③ 连接 + 接受:同一个进程里两头都开 ----------------
整数 客户 = 0;
客户 = 连到(本机, 端口, 客户);                    // 先连上(内核把这条连接排进监听那边的 backlog)
输出行(客户 > 0);
整数 服务 = 0;
服务 = 接受(听, 服务);                            // 再把排着的那条收下来
输出行(服务 > 0);

// ---------------- ④ 一来一回:收多少由 `接收` 的返回值说了算 ----------------
// 一次能收到几个字节由网络说了算(可能被切成几段),所以按"还差几个字节"循环收,
// 收满为止 —— 这也是 `接收` 的标准写法(它返回 0 就表示对端关掉了)。
字符串 要发 = "来自客户端";
字符串 块 = "";
整数 块长 = 1;
整数 已收 = 0;
字符串 全文 = "";
输出行(发送(客户, 要发));                         // 真发出去的字节数(UTF-8:一个汉字 3 字节 ⇒ 15)
// `接收` 的 `上限` 要写编译期数字(与 `读一块` 同一条规矩),所以按"还差几个字节"决定收不收 ——
// 一次能收到几个字节由网络说了算(可能被切成几段),收满 15 个字节为止;
// 对端关掉时 `接收` 给 0,循环也就自己收尾了。
当 (已收 < 15 && 块长 > 0)
{
    块长 = 接收(服务, 块, 64);
    如果 (块长 > 0)
    {
        拼接到(全文, 块);
        已收 = 已收 + 块长;
    }
}
输出行(已收);
输出行(全文);

字符串 回话 = "服务端收到";
整数 收到 = 0;
字符串 回文 = "";
输出行(发送(服务, 回话));                         // 反过来:服务端发、客户端收
当 (收到 < 15 && 块长 > 0)
{
    块长 = 接收(客户, 块, 64);
    如果 (块长 > 0)
    {
        拼接到(回文, 块);
        收到 = 收到 + 块长;
    }
}
输出行(收到);
输出行(回文);

// ---------------- ⑤ 对端关掉:`接收` 给 0,那个字符串变量跟着清空 ----------------
输出行(关闭(客户));
输出行(接收(服务, 块, 8));                        // 0 = 对端关掉了
输出行(块.长度());                                 // 到这儿那个变量被清空

// ---------------- ⑥ 失败路:白名单外的主机端口、作废的句柄 ----------------
整数 坏 = 0;
坏 = 连到(本机, 9, 坏);                           // `网址` 表里没有 `127.0.0.1:9` ⇒ 连都不连
输出行(坏);                                        // -1(句柄变量是有符号的,打出来就是 -1)
输出行(发送(坏, "x"));                             // -1
输出行(接收(坏, 块, 8));                           // -1
输出行(关闭(坏));                                  // 22(句柄不认)
字符串 空地址 = "";
输出行(主机解析("没有这个主机.测试", 空地址));      // 假(这台主机没在 `网址` 表里声明过)
输出行(空地址.长度());                              // 0(变量没被碰过)

// ---------------- 收尾:三个句柄都关掉(标准工程跑完不留开着的东西) ----------------
输出行(关闭(客户));                                // 0
输出行(关闭(客户));                                // 22(同一个句柄再关一次:已经作废)
输出行(关闭(服务));
输出行(关闭(听));

// 预期输出: 1|1|127.0.0.1|1|1|15|15|来自客户端|15|15|服务端收到|0|0|0|-1|4294967295|4294967295|22|0|0|22|22|0|0
