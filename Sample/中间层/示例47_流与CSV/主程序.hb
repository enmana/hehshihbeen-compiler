// ============================================================
// 示例47_流与CSV(G4 批 15:`迭代器.hb` / `CSV.hb`)
//
//   一段真用得上的活:**把一张表格文本切来切去,再拼回去** ——
//     ① **读一行**:`CSV.字段数` / `CSV.取字段`(引号里那个逗号不算分隔、`""` 是一个引号);
//     ② **拼一行**:`string.hb.切分` 先切段,`CSV.生成` 再按 CSV 规矩拼(该转义的自动转义),
//        拼完当场 `取字段` 走一遍往返;
//     ③ **逐项处理**:`迭代器` 在一条字符串上按分隔 / 按行走(`下一项` / `当前项` / `取前` /
//        `含子串` / `汇聚整数` / `重开`)。
//
//   三条口径(演示里照它走):
//     ① **切段口径与 `string.hb.切分` 一致**:`"苹果,香蕉,"` 给 3 段(最后那个是空串)、空串给 1 段;
//     ② **"拼好"与"打印"分开**:`转义` / `生成` 拿字符串,`取字段` / `字段数` 只管解析;
//     ③ **迭代器是"拉"的**:处理什么、什么时候停,全在调用方手里。
//
//   ⚠ **流与磁盘那一族不在这一篇里**(`流.hb` / `大文件工具.hb`):它们要真盘读写,
//     自检分组 `流与CSV库` 里**在真盘上真跑**(分块 / 跨块拼行 / 拷到 / 数行 / 校验 / 读头);
//     这一篇跟 `示例45` / `示例46` 一个口径:标准工程不碰盘。
// ============================================================
包含 "../../库/迭代器.hb"
包含 "../../库/CSV.hb"
包含 "../../库/string.hb"

// ---------------- ① 读一行:一张表格文本 ----------------
字符串 第二行 = "李四,\"7,5\",乌鲁木齐";
输出行(CSV.字段数(第二行, ","));
输出行(CSV.取字段(第二行, ",", 1));
字符串 带引号 = "王五,\"说\"\"好\"\"\",上海";
输出行(CSV.字段数(带引号, ","));
输出行(CSV.取字段(带引号, ",", 1));

// ---------------- ② 拼一行:切分 → 生成 → 取字段 往返 ----------------
整数 起[6];
整数 长[6];
整数 个数 = 切分("苹果,带,逗号,葡萄", ",", 起, 长);
输出行(个数);
字符串 拼好 = CSV.生成("苹果,带,逗号,葡萄", 起, 长, 个数, ",");
输出行(拼好);
字符串 转 = CSV.转义("带,逗号", ",");
输出行(转);
输出行(CSV.取字段(转, ",", 0));
输出行(CSV.字段数(转, ","));

// ---------------- ③ 逐项处理:迭代器 ----------------
整数 句 = 迭代器.建("1,2,x,4", ",");
输出行(迭代器.剩几项(句));
输出行(迭代器.重开(句));
整数 和 = 0;
输出行(迭代器.汇聚整数(句, 和));
输出行(和);
输出行(迭代器.重开(句));
输出行(迭代器.取前(句, 2));
输出行(迭代器.当前项(句));
整数 行句 = 迭代器.建("张三\n李四\n王五\n", "");
输出行(迭代器.找含子串(行句, "李"));
输出行(迭代器.当前项(行句));
输出行(迭代器.关(行句));
输出行(迭代器.关(句));
停止

// 预期输出: 3|7,5|3|说"好"|4|苹果,带,逗号,葡萄|"带,逗号"|带,逗号|1|4|1|3|7|1|2|2|1|李四|1|1