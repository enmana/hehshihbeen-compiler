// 示例 10:浮点与 64 位整数 —— 用 `Sample\库\` 里的纯软件库
//
//   关键字中英等价(写 `如果` 和写 `if` 一个意思),标识符随便起,中文优先只是默认 ——
//   本示例故意中英混写;变量名一律用短英文(a b r big one k)。库函数名以库文件头注释为准。
//
//   这里把三个库都 包含 进来(它们名字不重叠,可以同框):
//     · float32.hb:一个 float32 = 一个 `无符号整数` 位模式(符号 1 + 指数 8 + 尾数 23);
//     · int64.hb  :结构 u长整数 = 4 个 16 位半区,无符号 0 ~ 2^64-1;
//     · int64s.hb :结构 长整数  = 同一套半区,补码,INT64_MIN ~ INT64_MAX。
//
//   重点看三处:
//     ① 64 位库的参**按结构整体传** —— 实参只能是 变量/字段/数组元素,不能是表达式;
//        返回的结构也只能**先落到变量**再往下用(所以下面到处是"先接住、再传");
//     ② float32 的值就是 32 位整数,`浮点32加(...)` 这一族可以互相嵌着写、直接进表达式;
//     ③ 同一套 4 个半区,两个库的**口径**不同:2^64-1 在无符号那边是最大,在有符号那边是 -1。
//   想看**双精度**(float64.hb):它和 float32.hb 内部同名(结构 `宽整数`、`除法结果` 等),
//     两个**不能同时包含** —— 见隔壁 `示例13_双精度`。

包含 "../../库/float32.hb"
包含 "../../库/int64.hb"
包含 "../../库/int64s.hb"

// ---- 1) 单精度(float32):加减乘除、开方、比较、打印 ----
// 常量写法:`浮点常量.圆周率` 这类命名常量是静态容器字段,零运行期开销(不要放热循环里)。
输出行(浮点32转字符串(浮点32加(浮点常量.圆周率, 浮点常量.半)));   // 3.641593
输出行(浮点32转字符串(浮点32减(浮点常量.半, 浮点常量.一)));       // -0.5
输出行(浮点32转字符串(浮点32乘(浮点常量.圆周率, 浮点常量.二)));   // 6.283185
输出行(浮点32转字符串(浮点32除(浮点常量.一, 浮点常量.三)));       // 0.3333333
输出行(浮点32转字符串(浮点32开方(浮点常量.二)));                  // 1.414214
测试输出(浮点32小于(浮点常量.负一, 浮点常量.零));                 // 1
测试输出(浮点32相等(浮点常量.半, 浮点常量.半));                   // 1
测试输出(浮点32比较(浮点常量.非数, 浮点常量.零));                 // 2(有一边是 非数 → 不可比)
输出行(浮点32转字符串(浮点32除(浮点常量.一, 浮点常量.零)));       // Inf
输出行(浮点32转字符串(浮点32除(浮点常量.零, 浮点常量.零)));       // NaN
输出行(浮点32转字符串(浮点32取负(浮点常量.零)));                  // -0
if (浮点32是非数(浮点32开方(浮点常量.负一)))
{
    // 负数开方 → 非数
    测试输出(1);                                                   // 1
}

// ---- 2) 无符号 64 位(int64.hb):加 / 乘 / 比较 / 转字符串 ----
//     类型名与函数名照库里的写(`u长整数` / `u长整数加`…);u 开头 = 无符号那一套。
u长整数 big = u长整数最大();                        // 2^64-1
输出行(u长整数转字符串(big));                        // 18446744073709551615
u长整数 ua = 字符串转u长整数("12345678901234567890");
u长整数 ub = 字符串转u长整数("1000000000000000000");
u长整数 ur = u长整数加(ua, ub);                       // 结构返回值先落到变量
输出行(u长整数转字符串(ur));                         // 13345678901234567890
ur = u长整数乘(ub, ub);                              // 10^18 × 10^18:只留低 64 位
输出行(u长整数转字符串(ur));                         // 12919594847110692864
u长整数 uzero = u长整数零();
测试输出(u长整数比较(big, uzero));                   // 1:无符号下 2^64-1 比 0 大
ur = u长整数加(big, ub);                             // 回绕:2^64-1 + 10^18 = 10^18 - 1
输出行(u长整数转字符串(ur));                         // 999999999999999999

// ---- 3) 有符号 64 位(int64s.hb):负数与 INT64_MIN / INT64_MAX 边界 ----
长整数 x = 字符串转长整数("-123456789");
长整数 y = 字符串转长整数("987654321");
长整数 s = 长整数乘(x, y);
输出行(长整数转字符串(s));                           // -121932631112635269(负 × 正)
x = 字符串转长整数("1000000000000000000");
y = 字符串转长整数("-2500000000000000000");
s = 长整数加(x, y);
输出行(长整数转字符串(s));                           // -1500000000000000000
长整数 mn = 长整数最小();                            // INT64_MIN
输出行(长整数转字符串(mn));                          // -9223372036854775808
s = 长整数取负(mn);                                  // 补码回绕:取负还是它自己
输出行(长整数转字符串(s));                           // -9223372036854775808
长整数 mx = 长整数最大();                            // INT64_MAX
输出行(长整数转字符串(mx));                          // 9223372036854775807
长整数 one = 字符串转长整数("1");
s = 长整数加(mx, one);                               // INT64_MAX + 1 → 回绕成 INT64_MIN
输出行(长整数转字符串(s));                           // -9223372036854775808
长整数 negOne = 字符串转长整数("-1");
测试输出(长整数小于(mn, one));                       // 1:INT64_MIN < 1
测试输出(长整数大于(mx, negOne));                    // 1:INT64_MAX > -1
长整数 szero = 长整数零();
长整数 negZero = 字符串转长整数("-0");
测试输出(长整数相等(szero, negZero));                // 1:"-0" 就是 0
长整数 minus1 = 字符串转长整数("-1");
如果 (长整数是负(minus1))
{
    // 有符号的口径:-1 是负数
    测试输出(1);                                     // 1
}

// ---- 4) 64 位也能进循环:累加 100 次 10^12 ----
长整数 acc = 长整数零();
长整数 step = 字符串转长整数("1000000000000");
var k = 0;
当 (k < 100)
{
    // `var k` 写在循环头里只活到循环结束,所以这里写在外面
    acc = 长整数加(acc, step);
    k = k + 1;
}
输出行(长整数转字符串(acc));                         // 100000000000000
测试输出(k);                                          // 100

停止

// 预期输出: 3.641593|-0.5|6.283185|0.3333333|1.414214|1|1|2|Inf|NaN|-0|1|18446744073709551615|13345678901234567890|12919594847110692864|1|999999999999999999|-121932631112635269|-1500000000000000000|-9223372036854775808|-9223372036854775808|9223372036854775807|-9223372036854775808|1|1|1|1|100000000000000|100
