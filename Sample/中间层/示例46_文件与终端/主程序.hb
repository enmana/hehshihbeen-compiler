// ============================================================
// 示例46_文件与终端(G4 批 14:`控制台.hb` / `时间.hb` / `环境.hb`)
//
//   一段真用得上的活:**把一份名单排成中文表格、算一算时间、问一问环境** ——
//     ① **中文表格**:一行 `张三,28,杭州` 交给 `拼表格*`,汉字按两格算、超宽截断、
//        表头居中表身左对齐;表里的竖线在示例里换成 `!`(见下面那个小帮手);
//     ② **数字排版**:空格右对齐、左侧补零、固定小数位(四舍五入按那串最短十进制表示);
//     ③ **进度条**:`[####....] 37%`;
//     ④ **时间**:固定时区偏移下的模板写 / 模板读 / 拆分 / 拼回 / 周几 / 某月天数;
//     ⑤ **环境**:问有没有某个变量、取不到给默认值、把 `%名字%` 展开。
//
//   三条口径(演示里照它走):
//     ① **表格一行 = 一条整串 + 一个分隔串**:语言现在不能把 `字符串 表[]` 当形参,
//        所以 `张三,28,杭州` 这样一整行传进去,库自己切;
//     ② **"拼好"与"打印"分开**:`拼*` 拿字符串(示例里要换掉竖线,就走它),`写*` 直接打;
//     ③ **时间走固定时区偏移**(东八区写 `8 * 3600`),夏令时 / 历史时区变更不做。
//
//   ⚠ **文件那一族(存在 / 大小 / 逐行迭代 / 原子写 / 读一块)不在这篇里** ——
//     它们要真盘读写,自检分组 `控制台文件时间环境库` 里**在真盘上真跑**(35 条断言),
//     标准工程这一篇只演示"跟盘无关"的三件(与 `示例45` 一个口径:标准工程不碰盘)。
// ============================================================
包含 "../../库/控制台.hb"
包含 "../../库/时间.hb"
包含 "../../库/环境.hb"

// 示例自己的小帮手:把表格里的竖线换成 `!`。
//   为什么:**示例末尾那行「预期输出」用 `|` 当分隔符**(自检拿它逐行对账),
//   表格里再出现 `|` 就会把一条输出切成好几段 —— 所以示例里换一个记号再打。
方法 换条(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 0;
    整数 长 = 文本.长度();
    当 (i < 长)
    {
        文字 c = 文本[i];
        如果 (c == '|')
        {
            拼接到(结果, '!');
        }
        否则
        {
            拼接到(结果, c);
        }
        i = i + 1;
    }
    返回 结果;
}

// ---------------- ① 中文表格 ----------------
整数 列宽[3] = [8, 6, 12];
输出行(换条(控制台.拼表格线(列宽, 3)));
输出行(换条(控制台.拼表格头("姓名,年龄,城市", ",", 列宽, 3)));
输出行(换条(控制台.拼表格线(列宽, 3)));
输出行(换条(控制台.拼表格行("张三,28,杭州", ",", 列宽, 3)));
输出行(换条(控制台.拼表格行("李四,7,乌鲁木齐", ",", 列宽, 3)));
输出行(换条(控制台.拼表格行("亚历山大,7,上海", ",", 列宽, 3)));

// ---------------- ② 数字排版 ----------------
控制台.写整数补零(7, 3);
输出行("");
双精度 比值 = 字符串转双精度("0.145");
控制台.写双精度(比值, 2);
双精度 价 = 字符串转双精度("9.999");
控制台.写双精度(价, 2);
双精度 负 = 字符串转双精度("-1.005");
控制台.写双精度(负, 2);

// ---------------- ③ 进度条 ----------------
控制台.进度条(37, 100, 20);
控制台.进度条(3, 4, 8);

// ---------------- ④ 时间 ----------------
时间.设时区偏移(8 * 3600);
输出行(时间.按模板写(1767225600, "YYYY-MM-DD hh:mm:ss WW W"));
输出行(时间.某月天数(2024, 2));
输出行(时间.拼回(2026, 1, 1, 8, 0, 0));
整数 年 = 0;
整数 月 = 0;
整数 日 = 0;
整数 时 = 0;
整数 分 = 0;
整数 秒 = 0;
时间.拆分(1767225600, 年, 月, 日, 时, 分, 秒);
输出行(格式化("{0}-{1}-{2} {3}:{4}:{5}", 年, 月, 日, 时, 分, 秒));
整数 周 = 时间.周几(1767225600);
输出行(周);
整数 戳 = 0;
输出行(时间.按模板读("2026-01-01 08:00:00", 戳));
输出行(戳 == 1767225600);
输出行(时间.按模板读("2026-13-01 00:00:00", 戳));
输出行(戳);

// ---------------- ⑤ 环境 ----------------
输出行(环境.有环境变量("HB_这个变量不该有"));
输出行(环境.取环境变量或("HB_这个变量不该有", "缺省串"));
输出行(环境.展开("值=%HB_这个变量不该有%"));
停止

// 预期输出: +----------+--------+--------------+|!   姓名   !  年龄  !     城市     !|+----------+--------+--------------+|! 张三     ! 28     ! 杭州         !|! 李四     ! 7      ! 乌鲁木齐     !|! 亚历山大 ! 7      ! 上海         !|007|0.15|10.00|-1.01|[#######.............] 37%|[######..] 75%|2026-01-01 08:00:00 星期四 4|29|1767225600|2026-1-1 8:0:0|4|1|1|0|0|0|缺省串|值=%HB_这个变量不该有%