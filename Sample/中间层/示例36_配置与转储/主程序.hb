// ============================================================
// 示例36_配置与转储(G4 批 4:三个"只用文件能力"的库一起用)
//   `Sample/库/版本号.hb`      谁更新 / 解析 —— `1.2.10` 比 `1.2.9` 新(按段比,不是字符串序)
//   `Sample/库/配置.hb`        键=值 / INI 的读改写回(句柄带版本,改一条再加一条,整份写回)
//   `Sample/库/十六进制转储.hb` 偏移 + 十六进制 + ASCII 三栏(每行 16 字节)
//
// 三件小事连起来就是一个"小工具的第一天":先看版本号够不够新 → 读配置、改端口 → 出了事看二进制。
// 全篇只用**已有的文件能力**(`读文件` / `写文件` / `建目录` / `删文件`),不碰网络、不碰窗口。
//
// 口径(与三份库的头注释一致):
//   · 配置的键写 `段.键`(段名里不能有 `.`);没有段的键(`名字 = …`)写在文件最前面,`存` 也写回最前面;
//   · `存` 是**整份重写**(注释与原始顺序不保留);`#` / `;` 开头的行、没有 `=` 的行都跳过;
//   · 转储每行 16 字节,第 8 个字节后面多一个空格;不可打印(32~126 之外)给 `.`;
//   · `版本号.谁更新` 只比 `主.次.修订` 三段,第四段起不参与。
// ============================================================
包含 "../../库/版本号.hb"
包含 "../../库/配置.hb"
包含 "../../库/十六进制转储.hb"

// 局部帮手:把三栏表里的竖线换成 `!` —— 本示例末尾那行「预期输出」用竖线分隔多行,
// 而三栏表每行末尾本来就有两根竖线,不换一下那行就写不出来(口径见下面 ③)。
方法 换竖线(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 0;
    当 (i < 文本.长度())
    {
        字符 码 = 文本[i];
        如果 (码 == 124)                     // '|'
        {
            码 = 33;                         // '!'
        }
        拼接到(结果, 码);
        i = i + 1;
    }
    返回 结果;
}

// ---------------- ① 版本号:按段比,不是字符串序 ----------------
输出行(版本号.谁更新("1.2.10", "1.2.9"));       // 1:字符串比会说"1.2.10"更小
输出行(版本号.谁更新("1.2.9", "1.2.10"));       // -1
输出行(版本号.谁更新("1.2", "1.2.0"));          // 0:缺的段当 0
输出行(版本号.谁更新("v2.0", "1.9.9"));         // 1:开头的 v 自动跳过
输出行(版本号.谁更新("1.2.3.4", "1.2.3.9"));    // 0:第四段起不参与
整数 主 = 0;
整数 次 = 0;
整数 修 = 0;
输出行(版本号.解析("3.14.159", 主, 次, 修));  // 1
输出行(主);
输出行(次);
输出行(修);
输出行(版本号.解析("", 主, 次, 修));          // 0:空文本给假,三个引用都清零

// ---------------- ② 配置:读进来 → 取四档 → 改一条加一条 → 整份写回 ----------------
输出行(建目录("工具/临时/示例36"));            // 1(已存在也算成功,所以这个示例能反复跑)
字符串 配置文本 = "";
拼接到(配置文本, "# 示例配置\n");
拼接到(配置文本, "名字 = 局域网\n");
拼接到(配置文本, "[server]\n");
拼接到(配置文本, "host = 127.0.0.1\n");
拼接到(配置文本, "  port=8080\n");
拼接到(配置文本, "[ui]\n");
拼接到(配置文本, "theme = 暗\n");
拼接到(配置文本, "[feat]\n");
拼接到(配置文本, "调试 = true\n");
输出行(写文件("工具/临时/示例36/应用.ini", 配置文本));
整数 本 = 配置.读("工具/临时/示例36/应用.ini");
输出行(本 > 0);                              // 1
输出行(配置.条数(本));                        // 5
输出行(配置.取(本, "名字", "无"));            // 局域网:没有段的键
输出行(配置.取(本, "server.host", "无"));     // 127.0.0.1
输出行(配置.取整数(本, "server.port", 0));    // 8080(两边空白去掉)
输出行(配置.取(本, "ui.theme", "无"));        // 暗
输出行(配置.取逻辑(本, "feat.调试", 假));     // 1
输出行(配置.取(本, "server.nope", "缺省"));   // 缺省
输出行(配置.设(本, "server.port", "9090"));   // 1:有就改
输出行(配置.设(本, "feat.重试", "3"));        // 1:没有就加(加在它那个段的尾巴上)
输出行(配置.条数(本));                        // 6
输出行(配置.存(本, "工具/临时/示例36/回写.ini"));   // 1
字符串 回 = "";
输出行(读文件("工具/临时/示例36/回写.ini", 回, 4096));
输出(回);                                     // 整份写回的样子(注释不保留、没有段的键在最前)

// ---------------- ③ 转储:偏移 + 十六进制 + ASCII 三栏 ----------------
地址 块 = 申请(64);
存字(块, 0, 0x6C6C6548);                      // "Hell"
存字(块, 4, 0x6F57206F);                      // "o Wo"
存字(块, 8, 0x21646C72);                      // "rld!"
存字(块, 24, 0x0000000A);                     // 第 24 个字节是换行 ⇒ ASCII 栏给它 `.`
字符串 三栏 = 十六进制转储.转储(块, 32);
输出(换竖线(三栏));
释放(块);

// ---------------- ④ 收尾:临时目录清干净 ----------------
输出行(删文件("工具/临时/示例36/应用.ini"));
输出行(删文件("工具/临时/示例36/回写.ini"));
输出行(删目录("工具/临时/示例36"));

// 预期输出: 1|-1|0|1|0|1|3|14|159|0|1|1|1|5|局域网|127.0.0.1|8080|暗|1|缺省|1|1|6|1|1|名字=局域网|[server]|host=127.0.0.1|port=9090|[ui]|theme=暗|[feat]|调试=true|重试=3|00000000  48 65 6C 6C 6F 20 57 6F  72 6C 64 21 00 00 00 00  !Hello World!....!|00000010  00 00 00 00 00 00 00 00  0A 00 00 00 00 00 00 00  !................!|1|1|1
