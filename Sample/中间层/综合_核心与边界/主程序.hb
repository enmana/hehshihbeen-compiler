// 综合示例:核心功能与边界(手动测试拿这一份就够)
//
//   这份不是"教一个知识点",而是一网打尽:
//     类型与边界 / 表达式与优先级 / 流程控制 / 函数与递归 / 结构与引用 /
//     数组与列表 / 字符串 / 堆 / 宿主能力 —— 每块一个 `测试` 块,块里全是 `断言`。
//   **一条断言不成立就打印"第几行 + 条件原文",而且失败不打断**(一次看全),
//   每块跑完打一行汇总(`共 N 条断言,失败 M 条`)。
//
//   怎么用:
//     ① 命令行(在仓库根目录):
//        dotnet 编译器CLI\bin\Debug\net10.0\hbcc.dll -p Sample\中间层\综合_核心与边界\综合_核心与边界.hbp --run
//     ② IDE:文件 → 打开项目… → 选那个 .hbp → 按「执行」
//   输出里每块一行 `测试 某某:共 N 条断言,失败 0 条` —— 全是"失败 0 条"就是全过;
//   哪块印着"失败 1 条",上面几行就有那一行的行号与条件原文。
//
//   边界都藏在哪儿(想改坏哪条就改哪条,看它怎么报):
//     · 常量越界是**编译错误**:`字节 x = 300;` → 「常量 300 超出 字节 范围(0 ~ 255)」
//     · 变量赋值才截断:`字节 b = 300;` 编不过,先 `b = 0;` 再 `b = 300;` 之后 b 是 44
//     · `整数` / `短整数` 是**有符号**的;要 0~4294967295 写 `无符号整数`,
//       要 0~65535 写 `无符号短整数` —— 写错了编译器会带着改法告诉你
//     · 编译期硬上限(数组长度 65536 / 字符串数组 8192 / `包含` 深度 16 / 帧 96 字节 …)
//       见帮助站点《硬上限》一节,或查 `引擎\硬上限C.cs`
//
//   命名说明:**关键字中英文等价**(下面 `如果` 与 `if`、`循环` 与 `for` 混着写),
//   **标识符随便起**(这份全用短英文)。中文优先只是默认,不是限制。

// ==================== 结构 ====================
结构 点
{
    整数 x;
    整数 y;
}

// ==================== 函数与递归 ====================
方法 阶乘(整数 n) 返回 整数
{
    如果 (n <= 1)
    {
        返回 1;
    }
    返回 阶乘(n - 1) * n;
}

方法 求和(整数 表[], 整数 个数) 返回 整数
{
    整数 s = 0;
    for (整数 i = 0; i < 个数; i = i + 1)
    {
        s = s + 表[i];
    }
    返回 s;
}

方法 移动(引用 点 p, 整数 dx, 整数 dy)
{
    p.x = p.x + dx;
    p.y = p.y + dy;
    返回
}

// ==================== 全局数据 ====================
整数 数据[5] = [10, 20, 30, 40, 50];
点 home;

// ==================== 内联汇编:语言里可以直接写机器指令 ====================
// 55 条指令见 `指令集说明.md`;R15 是编译器保留的帧指针,用户代码别碰。
加载立即数 R0, 42
测试输出();                 // 42(不带参数 = 打印 R0;寄存器只在汇编行里出现)

// ==================== 1) 类型与字面量边界 ====================
测试 类型与字面量
{
    字节 b = 0;
    b = 300;                          // 只有变量赋值才截断:300 & 0xFF = 44
    断言 b == 44;

    短整数 s = 0;
    无符号整数 big = 70000;
    s = big;                          // 70000 & 0xFFFF = 4464
    断言 s == 4464;

    无符号短整数 us = 65535;           // 短整数 装不下 65535(它是有符号的),要 无符号短整数
    断言 us == 65535;

    字符 c = 'A';
    断言 c == 65;
    断言 c + 1 == 66;
    断言 'Z' - 'A' == 25;

    逻辑 yes = 真;
    逻辑 no = 假;
    断言 yes == 1;
    断言 no == 0;
}

// ==================== 2) 整数回绕与有符号 ====================
测试 整数回绕与有符号
{
    无符号整数 u = 4294967295;
    断言 u == 4294967295;
    u = u + 1;                        // 32 位回绕
    断言 u == 0;

    无符号整数 zero = 0;
    zero = zero - 1;                  // 无符号的下溢 = 绕到最大
    断言 zero == 4294967295;

    整数 neg = 0 - 7;
    断言 neg < 0;
    断言 0 - neg == 7;
}

// ==================== 3) 表达式与优先级 ====================
测试 表达式与优先级
{
    断言 2 + 3 * 4 == 14;
    断言 (2 + 3) * 4 == 20;
    断言 (2 + 3) * 4 - 6 / 2 == 17;
    断言 1 << 4 == 16;
    断言 0xF0 | 0x0F == 0xFF;
    断言 0xFF & 0x0F == 0x0F;
    断言 0xFF ^ 0x0F == 0xF0;

    无符号整数 all = 0;
    all = ~all;                       // 一元 ~ = 32 位整体按位取反
    断言 all == 4294967295;

    整数 x = 10;
    x += 5;
    断言 x == 15;
    x -= 3;
    断言 x == 12;
    x *= 2;
    断言 x == 24;
    x /= 4;
    断言 x == 6;
    x %= 4;
    断言 x == 2;
    x <<= 3;
    断言 x == 16;
    x >>= 2;
    断言 x == 4;
    x |= 1;
    断言 x == 5;
    x &= 6;
    断言 x == 4;
    x ^= 1;
    断言 x == 5;
    x++;
    断言 x == 6;
    x--;
    断言 x == 5;

    整数 m = 3;
    整数 k = 4;
    整数 bigger = m > k ? m : k;       // 三目
    断言 bigger == 4;
    断言 (m < k ? 10 : 20) == 10;
    逻辑 isBig = m > k;                // 比较当值用
    断言 isBig == 0;
}

// ==================== 4) 流程控制 ====================
测试 流程控制
{
    整数 sum = 0;
    循环 (整数 i = 1; i <= 10; i = i + 1)
    {
        如果 (i == 3)
        {
            继续;                      // 跳过这一次
        }
        如果 (i == 8)
        {
            跳出;                      // 整个循环不干了
        }
        sum = sum + i;
    }
    断言 sum == 25;                    // 1+2+4+5+6+7

    整数 pair = 0;
    循环 (整数 i = 0; i < 3; i = i + 1)
    {
        循环 (整数 j = 0; j < 3; j = j + 1)
        {
            if (j == 1)
            {
                继续 2;                // 一次跳两层
            }
            pair = pair + 1;
        }
    }
    断言 pair == 3;

    整数 w = 0;
    当 (w < 5)
    {
        w = w + 1;
    }
    断言 w == 5;

    整数 label = 0;
    选择 (pair)
    {
        情况 1
        {
            label = 1;
        }
        情况 2, 3
        {
            label = 23;
        }
        默认
        {
            label = 99;
        }
    }
    断言 label == 23;

    整数 score = 85;
    整数 level = 0;
    如果 (score >= 90)
    {
        level = 3;
    }
    否则 如果 (score >= 80)
    {
        level = 2;
    }
    否则
    {
        level = 1;
    }
    断言 level == 2;
}

// ==================== 5) 函数与递归 ====================
测试 函数与递归
{
    断言 阶乘(5) == 120;
    断言 阶乘(0) == 1;
    断言 求和(数据, 5) == 150;
    断言 求和(数据, 3) == 60;
}

// ==================== 6) 结构与引用 ====================
测试 结构与引用
{
    home.x = 3;
    home.y = 4;
    断言 home.x == 3;
    移动(home, 10, 20);                // 引用参数:直接改调用方那一份
    断言 home.x == 13;
    断言 home.y == 24;
    home.x++;
    断言 home.x == 14;

    点 副本;
    副本 = home;                       // 结构整体赋值 = 各有一份
    副本.x = 0;
    断言 home.x == 14;
    断言 副本.x == 0;
}

// ==================== 7) 数组与列表 ====================
测试 数组与列表
{
    断言 数据[0] == 10;
    断言 数据[4] == 50;
    整数 idx = 2;
    断言 数据[idx] == 30;              // 变量下标 = 运行时算地址
    数据[idx] = 33;
    断言 数据[2] == 33;
    数据[2] = 30;

    短整数 分数[];
    分数.添加(85);
    分数.添加(90);
    断言 分数.长度() == 2;
    断言 分数[0] == 85;
    分数[1] = 91;
    断言 分数[1] == 91;
    循环 (整数 i = 1; i <= 10; i = i + 1)
    {
        分数.添加(i);                  // 个数算不出 → 列表自己长
    }
    断言 分数.长度() == 12;

    短整数 别名[];
    别名.add(7);                       // 方法名中英两写法都认
    别名.add(9);
    断言 别名.length() == 2;
    别名.clear();
    断言 别名.length() == 0;
}

// ==================== 8) 字符串 ====================
测试 字符串
{
    字符串 name = "hello";
    断言 name.长度() == 5;
    断言 name[1] == 'e';
    name[1] = 'E';
    断言 name == "hEllo";
    拼接到(name, "!");
    断言 name == "hEllo!";
    断言 name.长度() == 6;

    字符串 变 = "abc";
    变[1] = '中';                       // 换的字可以不等长(多出来的往后挪)
    断言 变.长度() == 3;
    断言 变[1] == '中';

    字符串 空 = "";
    断言 空.长度() == 0;

    字符串 原 = "值语义";
    字符串 副本 = 原;                    // 各有一份
    副本 = "改了";
    断言 原 == "值语义";
    断言 副本 == "改了";
}

// ==================== 9) 堆:申请 / 释放 ====================
测试 堆
{
    地址 p = 申请(8);                    // 要一块 8 字节
    存字(p, 0, 123);
    存字(p, 4, 456);
    断言 取字(p, 0) == 123;
    断言 取字(p, 4) == 456;
    释放(p);                             // 还回堆里
    p = 0;
    断言 p == 0;

    地址 q = 申请(8);                    // 还回去的地方能再要到
    断言 q != 0;
    存字(q, 0, 9);
    断言 取字(q, 0) == 9;
    释放(q);
    q = 0;
}

// ==================== 10) 宿主能力:文件读写 / 目录 / 时间 ====================
// 能力是**宿主注入**的(命令行与 IDE 都注入);纯虚拟机里一律返回 假,程序照常跑完。
测试 宿主能力
{
    字符串 目录 = "Sample/中间层/综合_核心与边界/临时";
    断言 建目录(目录) == 1;

    字符串 文件 = 目录;
    拼接到(文件, "/综合.txt");
    断言 写文件(文件, "abc") == 1;
    断言 追加写文件(文件, "def") == 1;

    字符串 回读 = "";
    断言 读文件(文件, 回读, 4096) == 1;
    断言 回读 == "abcdef";

    字符串 清单 = "";
    断言 列目录(目录, 清单, 4096) == 1;
    断言 清单.长度() > 0;

    断言 删文件(文件) == 1;             // 收尾删掉,不给仓库留垃圾
    断言 当前时间() > 1700000000;
}

// ==================== 收尾 ====================
输出行("综合示例:全部测试块跑完");

停止

// 预期输出: 42|测试 类型与字面量:共 8 条断言,失败 0 条|测试 整数回绕与有符号:共 5 条断言,失败 0 条|测试 表达式与优先级:共 23 条断言,失败 0 条|测试 流程控制:共 5 条断言,失败 0 条|测试 函数与递归:共 4 条断言,失败 0 条|测试 结构与引用:共 6 条断言,失败 0 条|测试 数组与列表:共 10 条断言,失败 0 条|测试 字符串:共 10 条断言,失败 0 条|测试 堆:共 5 条断言,失败 0 条|测试 宿主能力:共 9 条断言,失败 0 条|综合示例:全部测试块跑完
