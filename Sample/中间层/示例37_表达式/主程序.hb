// ============================================================
// 示例37_表达式(G4 批 5:`Sample/库/表达式.hb` —— 运行期拿到的一串算式怎么算出数来)
//   `表达式.求值(算式, 结果)`   算术 → 优先级 / 括号 / 一元 / 比较 / 逻辑(真短路)
//   `表达式.设变量` + `清变量` 算式里可以有名字(值由调用方在运行期给)
//   `表达式.说明(算式)`       错算式给"第几格 + 为什么",不是一句"算错了"
//
// 四段:① 优先级与括号 ② 比较 / 逻辑 / 短路 ③ 变量表 ④ 错算式的带位置说明。
// 库的口径(零依赖 / 32 位有符号 / 不做位运算 / 短路那一支"只解析不算数")见
// `Sample/库/表达式.hb` 的头注释 —— 这一篇只演示怎么用。
//
// 局部帮手 `换竖线`:本示例末尾那行「预期输出」用竖线分隔各条输出,而错因里那句
// "本库不做位运算(`| ^ & << >>` …)"与"那一格是 `|`"本身带竖线 ⇒ 先换成 `!` 再打印
// (与 `示例36_配置与转储` 同一个理由、同一个办法)。
//   ⚠ 帮手里的 `字符 叹 = 33;` 不能图省事写成 `字符 码 = 文本[i];`
//     —— `字符` 是**一个字节**,中文一个字三个字节 ⇒ 拿它当中转会把汉字截成乱码。
// ============================================================
包含 "../../库/表达式.hb"
包含 "../../库/string.hb"          // UI 那一段要 `格式化` 与 `取子串`(把结果拼成一句、把错因截短)

方法 换竖线(字符串 文本) 返回 字符串
{
    字符串 结果 = "";
    整数 i = 0;
    当 (i < 文本.长度())
    {
        整数 码 = 文本[i];
        如果 (码 == 124)
        {
            字符 叹 = 33;
            拼接到(结果, 叹);
        }
        否则
        {
            拼接到(结果, 文本[i]);
        }
        i = i + 1;
    }
    返回 结果;
}

// 算得出来就打印结果;算不出来打印"带位置的那句话"
方法 试(字符串 算式)
{
    整数 结果 = 0;
    如果 (表达式.求值(算式, 结果))
    {
        输出行(结果);
    }
    否则
    {
        输出行(换竖线(表达式.说明(算式)));
    }
}

// ---------------- ① 优先级与括号 ----------------
试("1 + 2 * 3");
试("(1 + 2) * 3");
试("2 * (3 + 4) - 5");
试("100 / 7");
试("100 % 7");
试("-3 + 5");
试("2 * -3");
试("-(2 + 3)");
试("0x1F + 1");
试("!0 + 1");
试("10 - 2 - 3");

// ---------------- ② 比较与逻辑(真短路) ----------------
试("1 + 2 == 3");
试("2 < 3 < 1");
试("1 || 0 && 0");
试("0 && 1 / 0");                    // 左边 0 ⇒ 右边只解析不算数 ⇒ 不报"除数是 0"
试("1 || 1 / 0");                    // 左边非 0 ⇒ 同上
试("1 && 1 / 0");                    // 这一趟没短路成 ⇒ 真报错,而且指着那一格

// ---------------- ③ 变量表 ----------------
表达式.清变量();
试("超时 * 2 + 5");                  // 还没设过 ⇒ 报"名字没有设过值",指着第 1 格那个字
输出行(表达式.设变量("超时", 30));
输出行(表达式.设变量("余量", 0 - 7));
试("超时 * 2 + 5");
试("余量 / 2");                      // 有符号:`-7 / 2` 是 `-3`
试("余量 % 2");                      // 有符号:`-7 % 2` 是 `-1`
试("余量 != 0 && 100 / 余量 > 5");   // 左边非 0 ⇒ 右边真算:100 / -7 = -14,不大于 5
输出行(表达式.有变量("余量"));
表达式.清变量();
输出行(表达式.有变量("余量"));

// ---------------- ④ 错算式:第几格 + 为什么 ----------------
试("1 + * 2");                       // 这一格要一个数、名字或者 `(`
试("(1 + 2");                        // 这一格开的 `(` 没关上
试("10 / 0");                        // 这一格的除数是 0
试("1 2");                           // 算式到这儿就完了,后面还有多余的字符
试("1 | 2");                         // 语言有位运算,这个库不做(单列一条错因)
试("0x");                            // `0x` 后面没数字
试("1 + ");                          // 到末尾了(那一格没有字符,所以只报位置)

// ============================================================
// H82 批 5:窗口那一半 —— **一个真按得动的计算器**(上面的算式与断言一行没动)
//
//   按键拼算式(`拼接到(算式, 键文[键])`)→ 按 `=` 拿 `表达式.求值` 现场算一遍;
//   算不了就把 `表达式.说明` 那句"第几格 + 为什么"截前 22 个字摆上来。
//   键位与命中矩形**同一份写死的表**(四行四列 + 底下两个宽键),点键有高亮。
//
//   写法照 `Sample\说明.md`《带 UI 的示例怎么写》那一节:开窗前把标签全拼好,
//   主循环里只在**按键那一下**动字符串(不是每帧)。
//   ⚠ `拼接到` 只在**顶层**用:这是**写法偏好**,不再是绕缺陷 —— 库那条「方法里往长串尾巴上接
//     短串会多一个 0」的缺陷(`未做任务清单.md` H102)**第445批已修**(容量检查留出末尾那一格)。
// ============================================================

// ---- 一、键位表(四行四列 = 下标 0~15,底下两个宽键 = 16 / 17)----
字符串 键文[18];
键文[0] = "7";
键文[1] = "8";
键文[2] = "9";
键文[3] = "/";
键文[4] = "4";
键文[5] = "5";
键文[6] = "6";
键文[7] = "*";
键文[8] = "1";
键文[9] = "2";
键文[10] = "3";
键文[11] = "-";
键文[12] = "0";
键文[13] = "(";
键文[14] = ")";
键文[15] = "+";
键文[16] = "清空";
键文[17] = "=";

// ---- 二、窗口自己要记住的那几格 ----
字符串 算式 = "";
字符串 结果行 = "点下面的键拼算式;按 = 现场求值";
字符串 说明全 = "";
整数 求值果 = 0;
整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;
整数 点y = 0;
整数 键 = -1;
整数 按下键 = -1;
整数 悬 = -1;
整数 高 = 0;
整数 位 = 0;
整数 复 = 0;
逻辑 有一下 = 假;

逻辑 开着 = 打开窗口("示例37 表达式", 560, 540);
如果 (开着)
{
    逻辑 收手 = 假;
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                如果 (类型 == 5)
                {
                    有一下 = 真;               // 抬起 = "点一下"落地
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
                否则
                {
                    如果 (键码 == 27)
                    {
                        收手 = 真;             // ESC 也收手
                    }
                }
            }
        }

        // ---- 指针在哪个键上(画高亮用;与下面命中那一份是同一套算式)----
        悬 = -1;
        如果 (鼠标y >= 200 && 鼠标y < 392 && 鼠标x >= 62 && 鼠标x < 462)
        {
            高 = (鼠标y - 200) / 48;
            位 = (鼠标x - 62) / 100;
            悬 = 高 * 4 + 位;
        }
        如果 (鼠标y >= 396 && 鼠标y < 444 && 鼠标x >= 62 && 鼠标x < 462)
        {
            悬 = 16 + (鼠标x - 62) / 200;
        }

        // ---- 点击结算**单独摆一层**:命中哪一格键,就按那一格干的事干 ----
        如果 (有一下)
        {
            有一下 = 假;
            键 = -1;
            如果 (点y >= 200 && 点y < 392 && 点x >= 62 && 点x < 462)
            {
                高 = (点y - 200) / 48;
                位 = (点x - 62) / 100;
                键 = 高 * 4 + 位;
            }
            如果 (点y >= 396 && 点y < 444 && 点x >= 62 && 点x < 462)
            {
                键 = 16 + (点x - 62) / 200;
            }
            如果 (键 >= 0)
            {
                按下键 = 键;
                如果 (键 == 16)
                {
                    算式.清空();
                    结果行 = "从头来:按几个键再按 =";
                }
                否则
                {
                    如果 (键 == 17)
                    {
                        如果 (表达式.求值(算式, 求值果))
                        {
                            结果行 = 格式化("= {0}", 求值果);
                        }
                        否则
                        {
                            说明全 = 表达式.说明(算式);
                            结果行 = 取子串(说明全, 0, 22);      // 后面那句太长,窗口放不下
                        }
                    }
                    否则
                    {
                        拼接到(算式, 键文[键]);
                        结果行 = "按 = 现场求值";
                    }
                }
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍 ----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 40, 0xFF2A3550);
            画文字(24, 16, "示例37 表达式:按一按,现算一遍", 0xFFE8E8F0);
            画文字(24, 34, "点键拼算式;按 = 现场求值(算不了就报第几格)", 0xFFB0B0B8);

            // 显示区(底色先画、字后画)
            画矩形(12, 64, 536, 96, 0xFF16161E);
            画文字(24, 76, "算式", 0xFF9CC4FF);
            画文字(88, 76, 算式, 0xFFE8E8F0);
            画文字(24, 112, "结果", 0xFF9CC4FF);
            画文字(88, 112, 结果行, 0xFF9CC4FF);

            // 键区(16 个方键 + 2 个宽键;相邻不留缝 ⇒ 命中算式就是整除,不会点空)
            画矩形(12, 172, 536, 286, 0xFF16161E);
            位 = 0;
            当 (位 < 16)
            {
                高 = 位 / 4;
                复 = 位 - 高 * 4;
                如果 (位 == 按下键)
                {
                    画矩形(62 + 复 * 100, 200 + 高 * 48, 100, 48, 0xFF2A6EF0);      // 刚按过的
                }
                否则
                {
                    如果 (位 == 悬)
                    {
                        画矩形(62 + 复 * 100, 200 + 高 * 48, 100, 48, 0xFF2A3550);  // 指针停在这格
                    }
                    否则
                    {
                        如果 (位 == 3 || 位 == 7 || 位 == 11 || 位 == 15)
                        {
                            画矩形(62 + 复 * 100, 200 + 高 * 48, 100, 48, 0xFF3A3020);   // 四个算符
                        }
                        否则
                        {
                            画矩形(62 + 复 * 100, 200 + 高 * 48, 100, 48, 0xFF232B3E);
                        }
                    }
                }
                画文字(62 + 复 * 100 + 42, 200 + 高 * 48 + 17, 键文[位], 0xFFE8E8F0);
                位 = 位 + 1;
            }
            如果 (按下键 == 16)
            {
                画矩形(62, 396, 200, 48, 0xFF6E2A2A);                            // 清空:刚按过
            }
            否则
            {
                如果 (悬 == 16)
                {
                    画矩形(62, 396, 200, 48, 0xFF4A2020);
                }
                否则
                {
                    画矩形(62, 396, 200, 48, 0xFF4A2020);
                }
            }
            画文字(62 + 78, 396 + 17, 键文[16], 0xFFE8E8F0);
            如果 (按下键 == 17)
            {
                画矩形(262, 396, 200, 48, 0xFF2FA84F);                           // = :刚按过
            }
            否则
            {
                画矩形(262, 396, 200, 48, 0xFF1E4A2E);
            }
            画文字(262 + 86, 396 + 17, 键文[17], 0xFFE8E8F0);

            画文字(24, 470, "点键拼算式;= 现场求值,算不了就把第几格那一句摆上来", 0xFF8A8A96);
            画文字(24, 492, "ESC 或关窗退出:窗口一直转到你自己关", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(160);                             // 让出一帧、别把 CPU 烧满(无头不真等,所以帧数确定)
        }
    }

    关闭窗口();
}

