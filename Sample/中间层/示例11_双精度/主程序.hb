// 示例 11:双精度浮点 —— `Sample\库\float64.hb`(纯软件库,ISA 一条指令都没加)
//
//   关键字中英等价(写 `如果` 和写 `if` 一个意思),标识符随便起,中文优先只是默认 ——
//   本示例故意中英混写;变量名一律用短英文(pi r one k)。库 API 以 float64.hb 的头注释为准。
//
//   一个 `双精度` 就是 64 位位模式,装在 `结构 双精度 { 无符号整数 高; 无符号整数 低; }` 里:
//   高 = (号<<31) | (阶<<20) | 尾数的高 20 位,低 = 尾数的低 32 位。
//
//   重点看三处:
//     ① 结构**按地址传**:`双精度加(a, b)` 的实参只能是 变量/字段/数组元素,返回的结构也只能
//        先落到变量 —— 所以下面全是"先接住、再打印",不能把一次调用塞进另一次调用里;
//     ② 打印是"**最短且能原样读回**":同一个数打出来的字最少,而且 `字符串转双精度` 读回去位模式一模一样;
//     ③ 0.1 + 0.2 在双精度里**不等于 0.3** —— 十进制小数多数在二进制里是无限循环。
//   想看**单精度**(float32.hb):它和本库内部同名(结构 `宽整数` / `除法结果` / `开方结果` 都是两份),
//     两个**不能同时包含** —— 见隔壁 `示例10_浮点与64位`。

包含 "../../库/float64.hb"

// ---- 1) 加减乘除与开方:常量拿库里的命名函数,零运行期开销 ----
双精度 pi = 双精度常量圆周率();
双精度 zero = 双精度常量零();
双精度 one = 双精度常量一();
双精度 one2 = 双精度常量一();
双精度 two = 双精度常量二();
双精度 three = 双精度常量三();
双精度 half = 双精度常量半();
双精度 negOne = 双精度常量负一();
双精度 negHalf = 双精度常量负半();
双精度 negZero = 双精度常量负零();

双精度 r = pi;
输出行(双精度转字符串(r));                       // 3.141592653589793
r = 双精度乘(pi, two);
输出行(双精度转字符串(r));                       // 6.283185307179586
r = 双精度除(one, three);
输出行(双精度转字符串(r));                       // 0.3333333333333333
双精度 p1 = 字符串转双精度("0.1");
双精度 p2 = 字符串转双精度("0.2");
r = 双精度加(p1, p2);
输出行(双精度转字符串(r));                       // 0.30000000000000004(不是 0.3)
r = 双精度开方(two);
输出行(双精度转字符串(r));                       // 1.4142135623730951
r = 双精度减(three, half);
输出行(双精度转字符串(r));                       // 2.5
r = 双精度乘(negHalf, two);
输出行(双精度转字符串(r));                       // -1

// ---- 2) 比较:`双精度比较` 给 -1 / 0 / 1,相等与大小给 逻辑 ----
测试输出(双精度比较(negOne, zero));              // -1(左小)
测试输出(双精度小于(negOne, zero));              // 1
测试输出(双精度大于(pi, three));                 // 1
测试输出(双精度相等(one, one2));                 // 1

// ---- 3) Inf / NaN / -0 ----
双精度 inf = 双精度除(one, zero);
输出行(双精度转字符串(inf));                     // Inf
if (双精度是无穷(inf))
{
    // 英文关键字与 `如果` 完全等价
    测试输出(1);                                  // 1
}
双精度 nan = 双精度除(zero, zero);
输出行(双精度转字符串(nan));                     // NaN
如果 (双精度是非数(nan))
{
    // 中文关键字
    测试输出(1);                                  // 1
}
双精度 nz = 双精度取负(zero);
输出行(双精度转字符串(nz));                      // -0
测试输出(双精度相等(zero, negZero));             // 1:+0 与 -0 相等
双精度 nz2 = 双精度乘(zero, negOne);
测试输出(双精度是零(nz2));                       // 1:0 × 负数 = -0,也是零
测试输出(双精度有负号(nz2));                     // 1:而且负号还在

// ---- 4) 打印最短 / 2^53 就近连偶 / 打印解析环回 ----
双精度 big = 双精度从64(0x43400000, 0);          // 2^53
双精度 big1 = 双精度加(big, one);
输出行(双精度转字符串(big1));                    // 9007199254740992:2^53+1 就近连偶 → 还是 2^53
双精度 near = 字符串转双精度("0.1");
字符串 text = 双精度转字符串(near);
双精度 back = 字符串转双精度(text);
测试输出(双精度相等(near, back));                // 1:打印 → 解析,位模式一模一样

// ---- 5) 解析与命名常量 ----
r = 字符串转双精度("3.141592653589793");
输出行(双精度转字符串(r));                       // 3.141592653589793
r = 字符串转双精度("-0.125");
输出行(双精度转字符串(r));                       // -0.125
r = 双精度常量e();
输出行(双精度转字符串(r));                       // 2.718281828459045
r = 双精度常量根号二();
输出行(双精度转字符串(r));                       // 1.4142135623730951

// ---- 6) 一小段循环:累加 200 次 圆周率/2 ----
双精度 acc = 双精度常量零();
var k = 0;
当 (k < 200)
{
    双精度 step = 双精度乘(pi, half);
    acc = 双精度加(acc, step);
    k = k + 1;
}
输出行(双精度转字符串(acc));                     // 314.15926535897853
测试输出(k);                                      // 200

停止

// 预期输出: 3.141592653589793|6.283185307179586|0.3333333333333333|0.30000000000000004|1.4142135623730951|2.5|-1|-1|1|1|1|Inf|1|NaN|1|-0|1|1|1|9007199254740992|1|3.141592653589793|-0.125|2.718281828459045|1.4142135623730951|314.15926535897853|200
