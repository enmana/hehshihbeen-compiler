// 示例01_类型与字面量 —— byte / short / char / logic / int 五种类型
//
//   这个示例演示什么:
//     1) 五种类型各占几个字节、分别能装多大的数
//        byte  = 1 字节 0~255        short = 2 字节 -32768~32767
//        char  = 1 字节(存编码,'A' 就是 65)   logic = 1 字节(真=1 / 假=0)
//        int   = 4 字节(不写类型时就是它)
//     2) 字面量:十进制 42、0x 十六进制 0x2A、字符 'A'、逻辑 真/假
//     3) 宽度截断:把宽类型的值赋给窄变量,按模截断(300 进 byte 变成 44)
//     4) 字符算术:字符本来就是数,'A' + 1 = 66
//     5) 测试输出的几种写法:测试输出(值) / 测试输出('A') / debug(值) / 测试输出()
//
//   重点看哪几处:【3) 的截断】和【4) 的字符算术】,再就是【5) 的逻辑当条件】。
//   注意:常量直接写越界(byte b = 300)是**编译期报错**,只有"宽值赋给窄变量"才截断。
//   关键字中英等价(如果/if、返回/return 都合法),标识符随便起,中文优先只是默认。
//
//   ============================================================
//   怎么看(带 UI;H82 批 1)—— 这一份是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例01 类型与字面量`。
//       窗口里那五行就是上面那五个变量 —— 类型 / 字节数 / 当前值 / 这一格的说明,
//       **鼠标点哪一行就选中哪一行**(选中的那行有底色),下面那两行是它的"身份证":
//       `b = 45` 是怎么来的(`300 % 256` 再 +1)、`s = 4464` 是怎么来的(`70000 % 65536`)。
//       窗口**一直转到你自己关掉**(点标题栏的叉)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、也不用等人去关 ——
//       旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),跑满它写的帧数就投一个关窗请求;
//       于是"窗口该画什么、点一下变成什么样"都能逐行对出来(硬规矩 6:自检不开窗)。
//     · **顺序**:先把上面那些纯计算跑完、`测试输出` 打完(文件末尾那行 `// 预期输出:` 对的就是它们),
//       **然后**才开窗 —— 于是这一份示例的期望输出里,"数"还是那些数,窗口那几行排在后头。
//   ============================================================

包含 "../../库/string.hb"        // `格式化(...)` 把数字拼成文字要用它(库里那族 `转字符串`)

// 1) 五种类型各来一个
字节 b = 42;
短整数 s = -12;
字符 c = 'A';              // 'A' 就是 65
逻辑 ok = 真;              // 真 = 1
整数 n = -200000;

// 2) 字面量:十进制 / 0x 十六进制 / 字符 / 真假
字节 h = 0x2A;             // 十六进制 0x2A = 42
逻辑 off = 假;             // 假 = 0
字符 z = 'z';              // 122

// 3) 宽度截断:宽类型赋给窄类型,按模截断
整数 big = 300;
b = big;                   // 300 % 256 = 44
整数 wide = 70000;
s = wide;                  // 70000 % 65536 = 4464

// 4) 字符算术:字符就是编码,照样加减
c = c + 1;                 // 65 + 1 = 66
z = z - 1;                 // 122 - 1 = 121

// 5) 逻辑值当条件:如果 与 if 两种写法等价
如果 (ok)
{
    b = b + 1;             // 真 → 44 + 1 = 45
}
如果 (off)
{
    b = b + 1;             // 假 → 这层不进来
}

// 6) 测试输出的几种写法
测试输出(b);                // 45
测试输出(c);                // 66
测试输出(z);                // 121
测试输出(s);                // 4464
测试输出(ok);               // 1
测试输出(off);              // 0
测试输出(h);                // 42
测试输出(n);                // -200000
测试输出('A');              // 65:字符字面量按编码打印
测试输出(0x10);               // 16:英文写法,和 测试输出 一回事

// 7) 不写参数的 测试输出() 打印 R0(只读,不改动 R0)。
//    ⚠ 这一条**只往控制台打 42**:语言层没有"读寄存器"的内建(窗口那一行只是把它写在纸上),
//      想真看寄存器请用 IDE 的寄存器面板。
加载立即数 R0, 42
测试输出();                 // 42

// ---- 8) 带 UI 的那一半(H82 批 1):五行表格 + 点一行看它的来历 ----
// 这一整块**只在真开得了窗口时才跑**:没有图形能力的宿主给 假 ⇒ 一个字都不多打,
// 上面那 11 个数还是上面那 11 个数。

// 表格里的固定那几列:类型名 / 字节数 / 十六进制与字符的写法(值那一列开窗时现拼)
方法 类型名(整数 行) 返回 字符串
{
    字符串 名 = "?";
    如果 (行 == 0)
    {
        名 = "byte(字节)";
    }
    如果 (行 == 1)
    {
        名 = "short(短整数)";
    }
    如果 (行 == 2)
    {
        名 = "char(文字)";
    }
    如果 (行 == 3)
    {
        名 = "logic(逻辑)";
    }
    如果 (行 == 4)
    {
        名 = "int(整数)";
    }
    返回 名;
}

方法 字节数(整数 行) 返回 字符串
{
    字符串 数 = "?";
    如果 (行 == 0)
    {
        数 = "1 字节";
    }
    如果 (行 == 1)
    {
        数 = "2 字节";
    }
    如果 (行 == 2)
    {
        数 = "1 字节";
    }
    如果 (行 == 3)
    {
        数 = "1 字节";
    }
    如果 (行 == 4)
    {
        数 = "4 字节";
    }
    返回 数;
}

方法 补白(字符串 值, 整数 宽) 返回 字符串
{
    字符串 结果 = 值;
    当 (结果.长度() < 宽)
    {
        拼接到(结果, " ");
    }
    返回 结果;
}

方法 字面说明(整数 行) 返回 字符串
{
    字符串 说明 = "";
    如果 (行 == 0)
    {
        说明 = "字面量 42 / 0x2A,再按模截断";
    }
    如果 (行 == 1)
    {
        说明 = "字面量 -12,再按模截断";
    }
    如果 (行 == 2)
    {
        说明 = "字面量 'A'(编码 65),再 + 1";
    }
    如果 (行 == 3)
    {
        说明 = "字面量 真(就是 1)";
    }
    如果 (行 == 4)
    {
        说明 = "字面量 -200000";
    }
    返回 说明;
}

// 表格"值"那一列的文字:`转字符串` 把值翻成十进制,再用 `拼接到` 拼上格式串。
// ⚠ 不用 `格式化(...)` 写这个函数:那一个调用要占一份**函数级**串临时,
//   五个分支挤在同一个函数里当场报"帧超出 96 字节"(实测踩过);分两个小函数就够用。
方法 值文本(整数 值) 返回 字符串
{
    字符串 结果;
    拼接到(结果, "= ", 转字符串(值));
    返回 结果;
}

方法 取行文本(整数 行) 返回 字符串
{
    字符串 结果;
    如果 (行 == 0)
    {
        拼接到(结果, "b  ", 值文本(b));
    }
    如果 (行 == 1)
    {
        拼接到(结果, "s  ", 值文本(s));
    }
    如果 (行 == 2)
    {
        拼接到(结果, "c  ", 值文本(c));
    }
    如果 (行 == 3)
    {
        拼接到(结果, "ok ", 值文本(ok));
    }
    如果 (行 == 4)
    {
        拼接到(结果, "n  ", 值文本(n));
    }
    返回 结果;
}

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                  // 这一帧那"点一下"落在哪儿(x / y)
整数 点y = 0;
整数 选中 = -1;                // 表格里点中的那一行;-1 = 还没点
逻辑 有一下 = 假;              // 这一帧收到过"点一下"(按下 + 抬起)没有

逻辑 开着 = 打开窗口("示例01 类型与字面量", 520, 300);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算它:五行表格从 y=96 起、每行 28 像素。
        // 这一步**单独摆在这一层**,不塞进上面那串嵌套里(与示例16 的"取点击"同一路数)。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点y >= 96)
            {
                如果 (点y < 236)
                {
                    选中 = (点y - 96) / 28;
                }
            }
        }

        如果 (!收手)
        {
            // ⚠ 字符串要**先拼好**再画:`补白` / `取行文本` 每调一次都要在池子里要一块新的,
            //   放在"每帧都跑"的那一层里连跑几分钟会把编译器的字符串池撑爆(实测:真窗口挂 6 秒就报
            //   「字符串 返回值 长不下了:池用完了」)。所以一帧里只按**选中那一行**拼两条。
            字符串 值文本 = "点上面任意一行看它的值";
            如果 (选中 >= 0 && 选中 < 5)
            {
                值文本 = 取行文本(选中);
            }
            字符串 说明 = "点上面任意一行,这里说它的来历";
            如果 (选中 == 0)
            {
                说明 = "b 是 byte(0~255):int big = 300; b = big; ⇒ 300 % 256 = 44;逻辑 ok 为真又加 1 ⇒ 45";
            }
            否则
            {
                如果 (选中 == 1)
                {
                    说明 = "s 是 short(-32768~32767):int wide = 70000; s = wide; ⇒ 70000 % 65536 = 4464(高位被截掉)";
                }
                否则
                {
                    如果 (选中 == 2)
                    {
                        说明 = "c 是 char:'A' = 65,算术 c + 1 ⇒ 66(字符本来就是数)";
                    }
                    否则
                    {
                        如果 (选中 == 3)
                        {
                            说明 = "ok 是 logic:真 就是 1、假 就是 0 —— 它当条件用,成立的那一层才进来";
                        }
                        否则
                        {
                            如果 (选中 == 4)
                            {
                                说明 = "n 是 int:4 字节能装 -2147483648 ~ 2147483647,这里装的是 -200000";
                            }
                        }
                    }
                }
            }

            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼)----
            清屏(0xFF101018);
            画矩形(12, 12, 496, 40, 0xFF2A3550);
            画文字(24, 16, "五种基础类型:占几个字节 与 现在装的是什么", 0xFFE8E8F0);
            画文字(24, 34, "鼠标点一行 ⇒ 下面告诉你这一行是什么", 0xFFB0B0B8);

            // ⚠ 选中那一行的底色要**铺在三列文字之前**:桌面壳的 `画矩形` 是不透明实心填充
            //   (`图形宿主\桌面壳C.cs`),画在文字后面会**把那一行的字盖掉** —— 无头呈现看不出来。
            如果 (选中 == 0)
            {
                画矩形(12, 96, 496, 24, 0xFF2A6EF0);
            }
            如果 (选中 == 1)
            {
                画矩形(12, 124, 496, 24, 0xFF2A6EF0);
            }
            如果 (选中 == 2)
            {
                画矩形(12, 152, 496, 24, 0xFF2A6EF0);
            }
            如果 (选中 == 3)
            {
                画矩形(12, 180, 496, 24, 0xFF2A6EF0);
            }
            如果 (选中 == 4)
            {
                画矩形(12, 208, 496, 24, 0xFF2A6EF0);
            }

            画文字(20, 100, "byte(字节)      ", 0xFFD0D0D8);
            画文字(20, 128, "short(短整数)   ", 0xFFD0D0D8);
            画文字(20, 156, "char(文字)      ", 0xFFD0D0D8);
            画文字(20, 184, "logic(逻辑)     ", 0xFFD0D0D8);
            画文字(20, 212, "int(整数)       ", 0xFFD0D0D8);

            画文字(176, 100, "b  = 45", 0xFFE8E8F0);
            画文字(176, 128, "s  = 4464", 0xFFE8E8F0);
            画文字(176, 156, "c  = 66", 0xFFE8E8F0);
            画文字(176, 184, "ok = 1", 0xFFE8E8F0);
            画文字(176, 212, "n  = -200000", 0xFFE8E8F0);

            画文字(292, 100, "字面量 42 / 0x2A,再按模截断", 0xFF8A8A96);
            画文字(292, 128, "字面量 -12,再按模截断", 0xFF8A8A96);
            画文字(292, 156, "字面量 'A'(编码 65),再 + 1", 0xFF8A8A96);
            画文字(292, 184, "字面量 真(就是 1)", 0xFF8A8A96);
            画文字(292, 212, "字面量 -200000", 0xFF8A8A96);

            画线(12, 240, 508, 240, 0xFF3C3C46);
            画文字(20, 252, 说明, 0xFFE8E8F0);
            画文字(20, 276, 值文本, 0xFFD0D0D8);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();
}

停止

// 想看"常量越界"的报错:把下面这行的 // 去掉再编译,会得到一句带改法的中文报错,然后加回去
