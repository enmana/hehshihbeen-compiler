// ============================================================
// 示例44_编码与通配(G4 批 12:`编码.hb` + `HTML转义.hb` + `通配.hb`)
//
//   一段真用得上的活:**把数据送过文本这道关,再挑出想要的那几条** ——
//     ① **十六进制**:一份 16 字节的"文件头"往返一遍(存进配置 / 打日志要的都是它);
//     ② **Base64**:同一份字节装进只认 ASCII 的地方(邮件 / JSON 字段);
//     ③ **URL 百分号**:一段带中文与空格的查询串,编一遍再解回来;
//     ④ **BCD**:`"20261005"` 这种定长数打成 4 个字节(卡片 / 表计那一类老协议);
//     ⑤ **HTML 转义**:用户输入拼进网页之前先把五个字符换掉;
//     ⑥ **通配匹配**:按 `*.txt` 那一套筛几个名字,再找一找"位置"。
//
//   四条口径(演示里照它走):
//     ① **块与串是两种东西**:二进制数据走 `地址 + 字节数`(转十六进制 / 转Base64 / 转BCD),
//        文本走整条字符串(转十六进制串 / 转Base64串 / 转BCD串 与它们各自的解析);
//     ② **编出来的一定能解回来**(往返逐字节同)—— 这就是这一库的判据;
//     ③ **认不出就给 `假` / -1,不动目标**(不静默截断、不停机);
//     ④ **`*` 与 `?` 按文字算**(一个汉字一个文字),不按字节。
// ============================================================
包含 "../../库/编码.hb"
包含 "../../库/HTML转义.hb"
包含 "../../库/通配.hb"

// ---------------- ① 十六进制:一份 16 字节的"文件头" ----------------
地址 文件头 = 申请(16);
编码.解析十六进制("89504E470D0A1A0A0000000D49484452", 文件头, 16);
输出行(编码.转十六进制(文件头, 16));        // 逐字节同:存进配置 / 打日志都用它

// ---------------- ② Base64:同一份字节换个装法 ----------------
输出行(编码.转Base64(文件头, 16));
地址 解回 = 申请(16);
输出行(编码.解析Base64(编码.转Base64(文件头, 16), 解回, 16));   // 16:解出来几个字节
输出行(编码.转十六进制(解回, 16));           // 与 ① 那一行逐字相同

// ---------------- ③ URL 百分号:查询串里的一段值 ----------------
字符串 查询值 = "张 三&李四=1";
字符串 编好的 = "";
编码.转百分号编码(查询值, 编好的);
输出行(编好的);
字符串 解回来 = "";
编码.解析百分号编码(编好的, 解回来);
输出行(解回来);                              // 与 查询值 相同

// ---------------- ④ BCD:定长数字打成字节 ----------------
地址 卡号 = 申请(8);
输出行(编码.转BCD("20261005", 卡号, 8));     // 4:8 位十进制 = 4 字节
输出行(编码.转十六进制(卡号, 4));            // 20261005 的 BCD
字符串 卡文 = "";
输出行(编码.解析BCD(卡号, 4, 卡文));
输出行(卡文);                                // 20261005

// ---------------- ⑤ HTML 转义:用户输入拼进网页 ----------------
字符串 留言 = "<b>张三</b> & \"李四\" 的 O'Neil";
输出行(HTML转义.转义(留言));
输出行(HTML转义.反转义(HTML转义.转义(留言)));

// ---------------- ⑥ 通配匹配:筛名字 / 找位置 ----------------
输出行(通配.匹配("报告.txt", "*.txt"));          // 1
输出行(通配.匹配("报告.txt", "*.md"));           // 0
输出行(通配.匹配忽略大小写("报告.TXT", "*.txt")); // 1
输出行(通配.匹配("版本 v1.2.3", "v?.?.*"));      // 1
输出行(通配.找位置("版本 v1.2.3", "v?.?.*"));    // 3
输出行(通配.找位置("版本 v1.2.3", "v9*"));       // -1

释放(文件头);
释放(解回);
释放(卡号);
停止

// 预期输出: 89504E470D0A1A0A0000000D49484452|iVBORw0KGgoAAAANSUhEUg==|16|89504E470D0A1A0A0000000D49484452|%E5%BC%A0%20%E4%B8%89%26%E6%9D%8E%E5%9B%9B%3D1|张 三&李四=1|4|20261005|1|20261005|&lt;b&gt;张三&lt;/b&gt; &amp; &quot;李四&quot; 的 O&#39;Neil|<b>张三</b> & "李四" 的 O'Neil|1|0|1|1|3|-1
