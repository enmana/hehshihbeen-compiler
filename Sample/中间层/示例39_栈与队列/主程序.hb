// ============================================================
// 示例39_栈与队列(G4 批 7:`栈.hb` · `队列.hb` · `优先队列.hb` 三个库)
//
//   三个"顺序容器"各演示一段真用得上的活:
//     · `Sample\库\栈.hb` —— **后进先出**:十进制转二进制(余数进栈、倒着取出来就是二进制)
//       (10 个公开函数:是空 / 是满 / 个数 / 压 / 弹 / 看顶 / 看第几 / 压一串 / 到数组 / 清掉)
//     · `Sample\库\队列.hb` —— **先进先出(环形缓冲)**:5 格的小环收 6 个人,看它怎么绕回去
//       (10 个公开函数:是空 / 是满 / 个数 / 入 / 出队 / 看头 / 看尾 / 取第 / 到数组 / 清掉)
//     · `Sample\库\优先队列.hb` —— **最小堆**:任务按优先级排队,每次都取走最急的那一个
//       (9 个公开函数:是空 / 是满 / 个数 / 放 / 取最小 / 看最小 / 建堆 / 升序取出 / 清掉)
//
//   三条口径(演示里照它走,细节看各库的头注释):
//     ① **三个库都不做"新建(容量) 返回一个对象"**:语言里**列表取不出地址**(R3-3 判 d 档),
//        列表传不进函数 ⇒ 统统一张**定长数组当容量**,再用 `引用 整数` 参数当"用了多少 /
//        队头在第几格"这些状态(与 `列表.hb` / `数组.hb` 同一条边界);
//     ② **满了 / 空了不是错误**:**压 / 入 / 放** 给 `假`(没进去)、**弹 / 出队 / 取最小** 给 `假`
//        (没取到,且**不动 `收值`**)—— 不写错误槽、不停机;
//     ③ **`弹` / `出队` 的"个数"是 `引用` 参数**(调用方那一格会被改):写 `栈.弹(格, 顶, 值)`
//        就是"从 `顶` 上弹一个进 `值`",不用再写一句 `顶 = 顶 - 1`。
//
//   ============================================================
//   怎么看(带 UI;H82 批 4)—— 这一份的主题是"**把内存里的结构真画出来**":
//
//     · 上面那三段(**一个字没动**)跑完后,下面这一半把它们再演一遍 —— 用这一篇里现成的
//       三张表当舞台:`位格`(栈)、`环`(环形队列)、`任务`(最小堆)。窗口标题 `示例39 栈与队列`。
//     · **左上:栈** —— 竖着一摞方框(栈底在下、往上长),一帧压一个、满了再一帧弹一个;
//       栈顶那一格画成蓝底并标 `栈顶 →`;旁边那行 `倒着弹出来` 就是"二进制一位一位攒出来"。
//     · **右上:环形队列** —— 5 个格子排一排(标 0~4 号位),`队头` / `队尾` 两个箭头指过去;
//       演"5 格小环收 6 个人":第 6 个人写进 0 号格(绕回去了)之后,底下多一条折线 ——
//       箭头从 0 号格折回来("这是一排格子 + 一条折线,不是圆")。
//     · **下半屏:最小堆** —— 按"父亲不比孩子大"排好的一行格子(标 `堆[0]…`),
//       点一格就说它的优先级与它在第几位。
//     · **点任意一格** ⇒ 底下两行说"它现在装什么 / 是第几个 / 前面(下面)后面(上面)是谁"。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):旁边那份 `事件脚本.txt`
//       是写死的输入(第几帧投哪条事件),跑满它写的帧数就投一个关窗请求 ⇒ 不用等人去关窗。
//     · **顺序**:上面那些纯计算与 `输出行` 先跑完(文件末尾 `// 预期输出:` 对的就是它们),
//       **然后**才开窗 —— 于是期望输出里"数"还是那些数,窗口那几行排在后头。
//     · 画法约定(H82 批 4 a档,**不加新原语**):框 = 外层深色矩形 + 内层缩 2 像素的填充色
//       (2 条命令一个框);箭头 = `画线` + 两条 6 像素短斜线(见 `画箭头` 那 4 行);
//       一行最多约 33 格(窗宽 560 ⇒ 按 1 格 8 像素自己量)。
//   ============================================================
包含 "../../库/栈.hb"
包含 "../../库/队列.hb"
包含 "../../库/优先队列.hb"

// ---------------- ① 栈:十进制 → 二进制 ----------------
整数 数 = 2026;
整数 位格[32];
整数 位顶 = 0;
当 (数 > 0)
{
    栈.压(位格, 位顶, 数 % 2);       // 余数进栈
    数 = 数 / 2;
}
输出行(位顶);                        // 2026 = 11111101010,11 位
整数 上位 = 0;
栈.看顶(位格, 位顶, 上位);
输出行(上位);                        // 栈顶 = 最高位 = 1
整数 倒过来[32];
输出行(栈.到数组(位格, 位顶, 倒过来));   // 从栈底铺出来
输出行(倒过来[0]);                        // 最低位 = 0
整数 从顶走 = 0;
整数 一位 = 0;
整数 几个一 = 0;
当 (从顶走 < 位顶)
{
    栈.看第几个(位格, 位顶, 从顶走, 一位);
    如果 (一位 == 1)
    {
        几个一 = 几个一 + 1;
    }
    从顶走 = 从顶走 + 1;
}
输出行(几个一);                      // 从栈顶一位一位读回来:11111101010 里有 8 个 1
栈.清掉(位格, 位顶);
输出行(栈.是空(位格, 位顶));          // 1

// ---------------- ② 队列:5 格的小环绕一圈 ----------------
整数 环[5];
整数 队头 = 0;
整数 队里 = 0;
整数 谁 = 1;
当 (谁 <= 5)
{
    队列.入(环, 队头, 队里, 谁);
    谁 = 谁 + 1;
}
输出行(队里);                        // 5:满了
输出行(队列.是满(环, 队里));          // 1
整数 出来 = 0;
队列.出队(环, 队头, 队里, 出来);
输出行(出来);                        // 1:最早进去的最先出来
输出行(队头);                        // 1:队头挪到第 1 格
队列.入(环, 队头, 队里, 6);          // 写进"算出来的队尾" = 第 0 格(绕回来了)
输出行(队里);                        // 还是 5
整数 顺着[5];
输出行(队列.到数组(环, 队头, 队里, 顺着));  // 按出队顺序铺出来
输出行(顺着[0]);                     // 2
输出行(顺着[4]);                     // 6(住在第 0 格,可是排在最后)
队列.看头(环, 队头, 队里, 出来);
输出行(出来);                        // 2
队列.看尾(环, 队头, 队里, 出来);
输出行(出来);                        // 6
队列.取第几个(环, 队头, 队里, 2, 出来);
输出行(出来);                        // 出队顺序的第 2 个 = 4
输出行(队列.取第几个(环, 队头, 队里, 9, 出来));   // 越界:0

// ---------------- ③ 优先队列:任务按急缓排队 ----------------
整数 任务[8];
整数 几个 = 0;
优先队列.放(任务, 几个, 5);
优先队列.放(任务, 几个, 1);
优先队列.放(任务, 几个, 9);
优先队列.放(任务, 几个, 3);
输出行(几个);                        // 4
整数 最急 = 0;
优先队列.看最小(任务, 几个, 最急);
输出行(最急);                        // 1(只看不取)
优先队列.取最小(任务, 几个, 最急);
输出行(最急);                        // 1
优先队列.取最小(任务, 几个, 最急);
输出行(最急);                        // 3
输出行(几个);                        // 2
优先队列.放(任务, 几个, 0);
整数 按序[8];
输出行(优先队列.升序取出(任务, 几个, 按序));   // 3 个
输出行(按序[0]);                     // 0
输出行(按序[1]);                     // 5
输出行(按序[2]);                     // 9
输出行(几个);                        // 0:取空了
优先队列.取最小(任务, 几个, 最急);    // 空了给 假
输出行(最急);                        // 9:不动 `收值`

整数 现成[5] = [40, 10, 30, 20, 50];
整数 现成几个 = 5;
优先队列.建堆(现成, 现成几个);        // 现成的一张表当场理成堆(O(n))
优先队列.看最小(现成, 现成几个, 最急);
输出行(最急);                        // 10
输出行(现成几个);                    // 5:建堆不改个数

// ============================================================
// 下面这一半才是 UI(H82 批 4):上面 118 行一个字没动
//
// ⚠ 这一半撞到的几条语言面坑(都是实测,写在这儿省得下一个人再撞):
//   ① 主循环里**一条字符串都不许产生**:算好再画,不然每帧漏一块池(几百帧就「池用完了」);
//   ② `数组元素 = 字符串变量` 编不过(右边要写字面量 / 字符串变量 / 返回字符串的调用);
//      `拼接到(…, 数组元素, …)` 与 `画文字(…, 数组元素, …)` 可以;
//   ③ **别把"返回字符串的函数调用"塞进 `否则` 分支**:那一路拼出来的东西会整段丢掉;
//   ④ **循环体里不留任何声明**(连 `整数 x` 也不行):每转一圈帧指针往前走一格,
//      转上十来圈画出来的字就成了空的(不报错,是"字没了");
//   ⑤ 字符串按下标取的是**一个字节**(不是字符串)⇒ 不能直接交给 `画文字`;
//   ⑥ 运行期"一位一位攒一个长串"再接给 `画文字`,实测画出来是空的 ⇒ 那一行改成 12 行现成的字;
//   ⑦ 一行太长**不折行也不报错**:它就画出去(按 1 格 8 像素自己量)。
// ============================================================
包含 "../../库/string.hb"

// ---------------- 窗口尺寸(手算:宽 560,高 760)----------------
整数 窗宽 = 560;
整数 窗高 = 760;
整数 格宽 = 56;                      // 一个方框 56 × 42,横排间距 56(紧挨着)
整数 格高 = 42;
整数 栈基 = 414;                     // 栈底那一格的顶边;往上每格高 24
整数 队列y = 310;                    // 环形队列那一排格子的顶边
整数 队x0 = 188;                     // 环 0 号格的左边(必须让开左上栈那一摞:88~148)
整数 环空 = 56;
整数 堆y = 496;                      // 最小堆那一行格子的顶边
整数 堆x0 = 108;

// ---------------- 窗口自己要记住的状态(一律写在顶层)----------------
整数 类型 = 0;                       // 图形那一套要的四个出参(照 示例14 / 15 / 16)
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                        // 这一帧那"点一下"落在哪儿
整数 点y = 0;
逻辑 有一下 = 假;                    // 这一帧收到过"点一下"(按下 + 抬起)没有
整数 选中 = -1;                      // 点到哪一格:0 = 栈 / 1 = 环形队列 / 2 = 最小堆;-1 = 还没点
整数 选中格 = -1;                    // 那一格在它自己容器里的序号
整数 落格 = -1;                      // 命中测试的落脚点(结算单独摆浅一层)
整数 帧计 = 0;                       // 每 `刷新()` 一次 +1 —— 动画的节拍只认它
整数 弹过 = 0;                       // 倒着弹出来了几位
整数 i = 0;                          // 开窗前那些循环的下标

// ⚠ 主循环里一条字符串都不许产生(每帧漏一块池)⇒ 下面这些"字"全部在开窗前备好
字符串 说明一 = "";                  // 底下第一行:只在"选中变了"那一刻重拼一次
字符串 说明二 = "";                  // 底下第二行(边界那句)—— 与第一行**分开画**,别拼成一长条
字符串 位文[12];                     // `位格` 里 11 位的十进制文字(主循环里只按下标取)
字符串 现成文[5];                   // `现成[5]` 建堆之后的文字(静态,只拼一次)
字符串 序号文[5];                    // "0" ~ "4":格子角上那个号(⚠ 主循环里不许 数文(号))
字符串 堆号文[5];                    // "堆[0]" ~ "堆[4]"
字符串 弹示[12];                     // "倒着弹到第 k 位"的 12 行现成文字(那一行只用它)
字符串 栈题 = "";                    // 下面这些长句全部**开窗前拼好**(主循环里只画,不再拼)
字符串 队题 = "";
字符串 栈注 = "";
字符串 环注 = "";
字符串 堆注 = "";
字符串 堆注二 = "";
字符串 弹题 = "";
字符串 上台词 = "";
字符串 下台词 = "";
字符串 底注 = "";
字符串 位计文 = "";                  // "11 位"
字符串 几一文 = "";                  // "8 个 1"

// ---------------- 小帮手:数字 → 文字 ----------------
// ⚠ `格式化` 只认 `{0}` 这种占位符(printf 的 `%d` 不报错、也不替换);
// ⚠ `返回 格式化(...)` 会**静默停机** ⇒ 先落进一个字符串变量再 `返回`。
方法 数文(整数 值) 返回 字符串
{
    字符串 文 = 格式化("{0}", 值);
    返回 文;
}

// ---------------- 框 / 箭头:a档"不加新原语"的画法 ----------------
// 框 = 外层深色矩形 + 内层缩 2 像素的填充色矩形(**2 条命令一个框**)
方法 画框(整数 x, 整数 y, 整数 宽, 整数 高, 整数 亮)
{
    如果 (亮 == 1)
    {
        画矩形(x, y, 宽, 高, 0xFF6EA0FF);
        画矩形(x + 2, y + 2, 宽 - 4, 高 - 4, 0xFF2A6EF0);
    }
    否则
    {
        如果 (亮 == 2)
        {
            画矩形(x, y, 宽, 高, 0xFFB0B0B8);
            画矩形(x + 2, y + 2, 宽 - 4, 高 - 4, 0xFF2A3550);
        }
        否则
        {
            画矩形(x, y, 宽, 高, 0xFF3C3C46);
            画矩形(x + 2, y + 2, 宽 - 4, 高 - 4, 0xFF16161E);
        }
    }
}

// 箭头 = 主线 + 两条 6 像素短斜线(3 条命令);方向只有上 / 下 / 左 / 右四种,靠 `向` 挑
//   1 = 朝上(头在下边那端点) 2 = 朝下 3 = 朝左 4 = 朝右
方法 画箭头(整数 x1, 整数 y1, 整数 x2, 整数 y2, 整数 向)
{
    画线(x1, y1, x2, y2, 0xFF9CC4FF);
    如果 (向 == 3)
    {
        画线(x2, y2, x2 + 6, y2 - 6, 0xFF9CC4FF);
        画线(x2, y2, x2 + 6, y2 + 6, 0xFF9CC4FF);
    }
    否则
    {
        如果 (向 == 1)
        {
            画线(x2, y2, x2 - 6, y2 + 6, 0xFF9CC4FF);
            画线(x2, y2, x2 + 6, y2 + 6, 0xFF9CC4FF);
        }
        否则
        {
            如果 (向 == 2)
            {
                画线(x2, y2, x2 - 6, y2 - 6, 0xFF9CC4FF);
                画线(x2, y2, x2 + 6, y2 - 6, 0xFF9CC4FF);
            }
            否则
            {
                画线(x2, y2, x2 - 6, y2 - 6, 0xFF9CC4FF);
                画线(x2, y2, x2 - 6, y2 + 6, 0xFF9CC4FF);
            }
        }
    }
}

// 取环里第 k 格的文字:与 `数文` 一样"经由 `返回`" —— 直接把 `环[k]` 交给 `数文` 写在画命令里
// 会撞"这一句太复杂",包一层就干净了

// 环里第 k 格的文字 / 堆里第 k 格的文字:
// ⚠ "调用里返回的字符串"只有**当场那一帧**算数 —— 存进数组、跨几十帧再拿出来画,画出来是别的格子的值
//   (实测:5 格小环跑完动画以后,第 2 格显示成了第 1 格的 6)⇒ 这里给的全是**字面量**,不用现算的串
方法 环字(整数 k) 返回 字符串
{
    整数 值 = 环[k];
    如果 (值 == 1)
    {
        返回 "1";
    }
    如果 (值 == 2)
    {
        返回 "2";
    }
    如果 (值 == 3)
    {
        返回 "3";
    }
    如果 (值 == 4)
    {
        返回 "4";
    }
    如果 (值 == 5)
    {
        返回 "5";
    }
    返回 "6";
}


// 环里第 k 格、演到第 步 时该显示什么:
// ⚠ 这里**一律给字面量** —— 实测"把数组里的数字转成文字存进字符串数组、跨帧再画"会串味
//   (第 2 格写成了第 1 格的 6);全程查表就没有这个问题
方法 队格(整数 k, 整数 步) 返回 字符串
{
    如果 (k == 0)
    {
        如果 (步 == 0)
        {
            返回 "空";
        }
        如果 (步 == 1)
        {
            返回 "1";
        }
        如果 (步 == 2)
        {
            返回 "1";
        }
        如果 (步 == 3)
        {
            返回 "1";
        }
        如果 (步 == 4)
        {
            返回 "1";
        }
        如果 (步 == 5)
        {
            返回 "2";
        }
        如果 (步 == 6)
        {
            返回 "6";
        }
    }
    如果 (k == 1)
    {
        如果 (步 == 0)
        {
            返回 "空";
        }
        如果 (步 == 1)
        {
            返回 "空";
        }
        如果 (步 == 2)
        {
            返回 "2";
        }
        如果 (步 == 3)
        {
            返回 "2";
        }
        如果 (步 == 4)
        {
            返回 "2";
        }
        如果 (步 == 5)
        {
            返回 "3";
        }
        如果 (步 == 6)
        {
            返回 "2";
        }
    }
    如果 (k == 2)
    {
        如果 (步 == 0)
        {
            返回 "空";
        }
        如果 (步 == 1)
        {
            返回 "空";
        }
        如果 (步 == 2)
        {
            返回 "空";
        }
        如果 (步 == 3)
        {
            返回 "3";
        }
        如果 (步 == 4)
        {
            返回 "3";
        }
        如果 (步 == 5)
        {
            返回 "4";
        }
        如果 (步 == 6)
        {
            返回 "3";
        }
    }
    如果 (k == 3)
    {
        如果 (步 == 0)
        {
            返回 "空";
        }
        如果 (步 == 1)
        {
            返回 "空";
        }
        如果 (步 == 2)
        {
            返回 "空";
        }
        如果 (步 == 3)
        {
            返回 "空";
        }
        如果 (步 == 4)
        {
            返回 "4";
        }
        如果 (步 == 5)
        {
            返回 "5";
        }
        如果 (步 == 6)
        {
            返回 "4";
        }
    }
    如果 (k == 4)
    {
        如果 (步 == 0)
        {
            返回 "空";
        }
        如果 (步 == 1)
        {
            返回 "空";
        }
        如果 (步 == 2)
        {
            返回 "空";
        }
        如果 (步 == 3)
        {
            返回 "空";
        }
        如果 (步 == 4)
        {
            返回 "空";
        }
        如果 (步 == 5)
        {
            返回 "6";
        }
        如果 (步 == 6)
        {
            返回 "5";
        }
    }
    返回 "空";
}

// 栈里第 k 格(从栈底数)该显示什么:2026 = 11111101010 ⇒ 从栈底到栈顶是 0 1 0 1 0 1 1 1 1 1 1
// ⚠ 与 `队格` 同一个道理:给的**全是字面量**(开窗前算出来的那些字符串,几十帧之后会被池回收掉)
方法 位格字(整数 k, 整数 格数) 返回 字符串
{
    如果 (k >= 格数)
    {
        返回 "空";
    }
    如果 (k == 0)
    {
        返回 "0";
    }
    如果 (k == 1)
    {
        返回 "1";
    }
    如果 (k == 2)
    {
        返回 "0";
    }
    如果 (k == 3)
    {
        返回 "1";
    }
    如果 (k == 4)
    {
        返回 "0";
    }
    返回 "1";
}

// ---------------- 点中的那一格:底下两行说什么 ----------------
方法 头字(整数 框) 返回 字符串
{
    如果 (框 == 2)
    {
        返回 "最小堆(优先队列)";
    }
    如果 (框 == 1)
    {
        返回 "环形队列(先进先出)";
    }
    返回 "栈(后进先出)";
}

// ⚠ 字符串数组的元素**不能当赋值右值、也不能当自定义函数的字符串实参**(编译器当场拦)
//     而且"接着要拼的"那一句必须是**字面量** ⇒ 一格一句写全
方法 栈信息(整数 k, 整数 数) 返回 字符串
{
    如果 (k <= 0)
    {
        返回 "栈底那一格:最早压进来的那一位,下面没有格子了";
    }
    如果 (k >= 数)
    {
        返回 "栈顶上面那一格:空的(上面没有格子了)";
    }
    字符串 文 = "第 ";
    拼接到(文, 数文(k));
    拼接到(文, " 格装 ");
    拼接到(文, 位格字(k, 数));
    拼接到(文, ";上面是 ");
    拼接到(文, 位格字(k + 1, 数));
    拼接到(文, "、下面是 ");
    拼接到(文, 位格字(k - 1, 数));
    返回 文;
}

方法 优信息(整数 k, 整数 数) 返回 字符串
{
    字符串 文 = "堆里第 ";
    拼接到(文, 数文(k));
    拼接到(文, " 格(数写在格子上);它是最急的第 ");
    拼接到(文, 数文(数));
    拼接到(文, " 位");
    返回 文;
}

方法 队信息(整数 k, 整数 头, 整数 数) 返回 字符串
{
    整数 序 = (头 + k) % 5;                 // 这一格按"出队顺序"排第几
    字符串 文 = "环里第 ";
    拼接到(文, 数文(k));
    拼接到(文, " 号格(数写在格子上);按出队顺序是第 ");
    拼接到(文, 数文(序));
    拼接到(文, " 个");
    返回 文;
}

// 第二行:这一格是第几个 / 一共几个 / 是不是边界那一个
方法 边界语(整数 框, 整数 k, 整数 头, 整数 数) 返回 字符串
{
    字符串 文 = " —— 这一格是第 ";
    拼接到(文, 数文(k));
    拼接到(文, " 个(一共 ");
    拼接到(文, 数文(数));
    拼接到(文, " 个)");
    如果 (框 == 0)
    {
        如果 (k == 数 - 1)
        {
            拼接到(文, ",是栈顶(下一个弹的就是它)");
        }
        如果 (k == 0)
        {
            拼接到(文, ",是栈底(最早压进来的)");
        }
    }
    如果 (框 == 1)
    {
        如果 (k == 头)
        {
            拼接到(文, ",是队头(下一个出队的就是它)");
        }
        如果 (k == (头 + 数 + 4) % 5)
        {
            拼接到(文, ",是队尾(最后进队的)");
        }
    }
    如果 (框 == 2)
    {
        如果 (k == 0)
        {
            拼接到(文, ",堆[0] 就是最急的那个");
        }
    }
    返回 文;
}

// 点中的那一格 ⇒ 底下第一行(**只在"选中变了"那一刻拼一次**,主循环里不拼)
// ⚠ **别把"返回字符串的函数调用"塞进 `否则` 分支**:实测那样写,`否则` 那一路拼出来的东西
//   会整段丢掉(与"循环体里声明字符串"同一类毛病)⇒ 这一句先挑好、再线性拼
方法 选中一(整数 框, 整数 k, 整数 头, 整数 数) 返回 字符串
{
    字符串 里 = 栈信息(k, 数);            // 三个容器各拼一句,再挑一句
    如果 (框 == 1)
    {
        里 = 队信息(k, 头, 数);
    }
    如果 (框 == 2)
    {
        里 = 优信息(k, 数);
    }
    字符串 文 = 头字(框);
    拼接到(文, " · ");
    拼接到(文, 里);
    返回 文;
}

方法 空位一(整数 框) 返回 字符串
{
    字符串 文 = 头字(框);
    拼接到(文, " —— 这一格现在是空的(演到它装满那一帧再看)");
    返回 文;
}

方法 空位二() 返回 字符串
{
    返回 "框起来的那一格就是选中的;换一格点一下,这两行就跟着换";
}

// ---------------- 开窗前:把每格的文字一次算清(主循环里只画)----------------
i = 0;
当 (i < 位顶)
{
    位文[i] = 数文(位格[i]);
    i = i + 1;
}
位文[位顶] = "空";                    // 栈顶上面那一格 = 空的(边界语要用)
位计文 = 数文(位顶);
几一文 = 数文(几个一);
i = 0;
// ⚠ 这一段原来写的是 `队文[环位] = 数文(环[环位])` —— 实测那会让 **`环[]` 自己被写坏**
//   (第 2 格从 2 变成第 1 格的 6),所以格子里的字一律走"值 → 字面量"的分支
i = 0;
当 (i < 队里)                        // ② 演完留在环里的 5 个人:2 3 4 5 6
{
    整数 环位 = (队头 + i) % 5;
    i = i + 1;
}
i = 0;
i = 0;
当 (i < 现成几个)                    // ③ `建堆` 之后的那张表:也是"值 → 字面量"
{
    如果 (现成[i] == 50)
    {
        现成文[i] = "50";
    }
    如果 (现成[i] == 40)
    {
        现成文[i] = "40";
    }
    如果 (现成[i] == 30)
    {
        现成文[i] = "30";
    }
    如果 (现成[i] == 20)
    {
        现成文[i] = "20";
    }
    如果 (现成[i] == 10)
    {
        现成文[i] = "10";
    }
    i = i + 1;
}
// ⚠ 数组元素的右边只能是**一个字面量 / 一个返回字符串的调用**(写字符串变量会被拦)
序号文[0] = 数文(0);
序号文[1] = 数文(1);
序号文[2] = 数文(2);
序号文[3] = 数文(3);
序号文[4] = 数文(4);
堆号文[0] = "堆[0]";
堆号文[1] = "堆[1]";
堆号文[2] = "堆[2]";
堆号文[3] = "堆[3]";
堆号文[4] = "堆[4]";
// 倒着弹出来那一行:**12 行现成的字**(第 k 行 = 倒着弹到第 k 位的样子)
// ⚠ 试过"运行期一位一位攒这个串再画",画出来是空的 ⇒ 写死这 12 行
弹示[0] = "";
弹示[1] = "1";
弹示[2] = "11";
弹示[3] = "111";
弹示[4] = "1111";
弹示[5] = "11111";
弹示[6] = "111111";
弹示[7] = "1111110";
弹示[8] = "11111101";
弹示[9] = "111111010";
弹示[10] = "1111110101";
弹示[11] = "11111101010";
栈题 = "左上:栈(后进先出)往上长,栈顶画蓝底";
队题 = "右上:环形队列(先进先出)";
栈注 = "2026 = 11111101010(";
拼接到(栈注, 位计文, " 位,里面有 ", 几一文, " 个 1)");
环注 = "5 格小环收 6 个人";
堆注 = "这 8 格就是数组 任务[8]:父子关系按下标算(2i+1 / 2i+2)";
堆注二 = "现成[5] 建堆之后:10 20 30 50 40 —— 看最小 给 10(建堆不改个数)";
弹题 = "倒着弹出来:";
底注 = "上面 118 行纯计算与 输出行 一个字没动 —— 这一屏只是把它们再演一遍";
// ⚠ `字符串 总和 = 左 + 右` 这种"两个字符串相加"编不过(见上面那条),串起来一律靠 `拼接到`
上台词 = "点一格 ⇒ 说它装什么 / 是第几个 / 前后是谁";
下台词 = "框起来的那一格就是选中的;换一格点一下,这两行跟着换";
说明一 = 上台词;
说明二 = 下台词;

逻辑 开着 = 打开窗口("示例39 栈与队列", 窗宽, 窗高);
如果 (开着)                          // 没有图形能力的宿主给 假 ⇒ 一个字都不多打
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // A. 这一个"主循环来回一次"就是一帧(`帧计` = 第几帧)。
        //    ⚠ 这里**不写 `动画步 = 动画步 + 1` 那种自增节拍** —— 实测那样写,`栈.压` 会在同一帧里
        //      被走两遍(状态被改了两遍),栈一路涨到 12 格就撞下标越界。改成**只认 `帧计` 的窗口
        //      + 到点就夹回**以后,一帧走几步都稳(就算走两步,也只是演得快一点)。
        帧计 = 帧计 + 1;

        // B. 栈:一帧压一位(余数进栈),到 11 位停一停,再一帧弹一位(倒着取出来就是二进制)
        如果 (帧计 <= 48)
        {
            整数 该压 = (帧计 - 1) / 2;                  // 每 2 帧压一位
            如果 (该压 > 11)
            {
                该压 = 11;
            }
            当 (位顶 < 该压)
            {
                栈.压(位格, 位顶, 倒过来[位顶]);
            }
        }
        否则
        {
            如果 (帧计 >= 55 && 帧计 <= 100)
            {
                整数 该弹 = (帧计 - 55) / 2;             // 每 2 帧弹一位
                如果 (该弹 > 11)
                {
                    该弹 = 11;
                }
                当 (弹过 < 该弹)
                {
                    栈.弹(位格, 位顶, 出来);
                    弹过 = 弹过 + 1;
                }
            }
        }

        // C. 环形队列:入 1~5(满)→ 出队 1 个 → 再入一个写进 0 号格(绕回去了)
        如果 (帧计 == 110)
        {
            输出行(11000000 + 环[1]);
            队列.入(环, 队头, 队里, 1);
        }
        如果 (帧计 == 114)
        {
            队列.入(环, 队头, 队里, 2);
        }
        如果 (帧计 == 118)
        {
            输出行(11800000 + 环[1]);
            队列.入(环, 队头, 队里, 3);
        }
        如果 (帧计 == 122)
        {
            输出行(12200000 + 环[1]);
            队列.入(环, 队头, 队里, 4);
        }
        如果 (帧计 == 126)
        {
            输出行(12600000 + 环[1]);
            队列.入(环, 队头, 队里, 5);
        }
        如果 (帧计 == 130)
        {
            输出行(13000000 + 环[1]);
            队列.出队(环, 队头, 队里, 出来);            // 队头挪到 1 号格
        }
        如果 (帧计 == 134)
        {
            队列.入(环, 队头, 队里, 6);                  // 写进 0 号格:绕回来了
        }



        // D. 最小堆:放 5 / 1 / 9 / 3(每放一个就"往上浮"),再看最小、取最小两次
        如果 (帧计 == 140)
        {
            优先队列.放(任务, 几个, 5);
        }
        如果 (帧计 == 144)
        {
            优先队列.放(任务, 几个, 1);
        }
        如果 (帧计 == 148)
        {
            优先队列.放(任务, 几个, 9);
        }
        如果 (帧计 == 152)
        {
            优先队列.放(任务, 几个, 3);
        }
        如果 (帧计 == 156)
        {
            优先队列.看最小(任务, 几个, 最急);
        }
        如果 (帧计 == 160)
        {
            优先队列.取最小(任务, 几个, 最急);
        }
        如果 (帧计 == 164)
        {
            优先队列.取最小(任务, 几个, 最急);
        }
        如果 (帧计 == 168)
        {
            优先队列.取最小(任务, 几个, 最急);          // 空了给 假:`最急` 还是 9
        }

        // E. 点击结算:判断 + 赋值写在**浅层**(主循环那一层)最稳 —— 先把点击记进点x / 点y,
        //    轮询那一圈里不做判断,到这儿再结算(与 示例16 的"取点击"同一路数)。
        //    三个容器各一块矩形:栈(左边那一摞)/ 环形队列(中间那一排)/ 最小堆(下半屏那一行)
        如果 (有一下)
        {
            有一下 = 假;
            整数 旧框 = 选中;
            整数 旧格 = 选中格;

            如果 (点x >= 88 && 点x < 144)
            {
                如果 (点y >= 栈基 + 2 - 位顶 * 24 && 点y < 栈基 + 2 + 格高)
                {
                    落格 = (点y - (栈基 + 2)) / 24;          // 0 = 栈底那一格
                    如果 (落格 >= 0 && 落格 < 位顶)
                    {
                        选中 = 0;
                        选中格 = 落格;
                    }
                    否则
                    {
                        选中 = 0;
                        选中格 = -1;
                    }
                }
            }
            如果 (点y >= 队列y && 点y < 队列y + 格高 && 点x >= 队x0)
            {
                落格 = (点x - 队x0) / 环空;
                如果 (落格 >= 0 && 落格 < 5)
                {
                    选中 = 1;
                    选中格 = 落格;
                }
            }
            如果 (点y >= 堆y && 点y < 堆y + 格高)
            {
                落格 = (点x - 堆x0) / 格宽;
                如果 (落格 >= 0 && 落格 < 5)
                {
                    选中 = 2;
                    选中格 = 落格;
                }
            }

            // 换了个容器也走同一条路:不把 `选中格` 抹掉(抹成 -1 就与"刚才那一格"相等 ⇒
            // 底下那两行永远不重拼 —— 这一条是实测撞出来的)
            如果 (选中 >= 0 && (选中 != 旧框 || 选中格 != 旧格))
            {
                整数 有数 = 0;
                如果 (选中 == 0)
                {
                    有数 = 位顶;
                }
                如果 (选中 == 1)
                {
                    有数 = 队里;
                }
                如果 (选中 == 2)
                {
                    有数 = 几个;
                }
                如果 (选中格 >= 0 && 选中格 < 有数)
                {
                    说明一 = 选中一(选中, 选中格, 队头, 有数);
                    说明二 = 边界语(选中, 选中格, 队头, 有数);
                }
                否则
                {
                    说明一 = 空位一(选中);
                    说明二 = 空位二();
                }
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是现成的)----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 44, 0xFF2A3550);
            画文字(24, 18, "示例39 栈与队列:把三种顺序容器画出来", 0xFFE8E8F0);
            画文字(24, 38, "左上 栈 / 右上 环形队列 / 下半屏 最小堆", 0xFFB0B0B8);

            // 左上:栈 —— 竖着一摞方框(栈底在下),一帧压一个、满了再一帧弹一个;栈顶单独标出来
            // ⚠ **选中那块底色先画**(它比格子宽 8、高 4,是"框起来"的那条边):后画就是把这一格的字压住
            整数 s = 0;
            整数 s行 = 栈基 + 2 - 位顶 * 24;         // 栈顶那一格的顶边(⚠ 算式先落一个变量,别在调用里堆)
            整数 亮 = 0;
            如果 (选中 == 0 && 选中格 >= 0 && 选中格 < 位顶)
            {
                画矩形(88, s行 + 选中格 * 24 - 2, 格宽 + 8, 格高 + 4, 0xFF4A6EA8);
            }
            当 (s < 位顶)
            {
                亮 = 0;
                如果 (s == 位顶 - 1)
                {
                    亮 = 1;
                    画文字(12, s行 + (位顶 - 1) * 24 + 8, "栈顶 →", 0xFF9CC4FF);   // 往上挪 6 像素:不然压到下一格的框上
                }
                如果 (选中 == 0 && s == 选中格)
                {
                    亮 = 1;
                }
                画框(92, s行 + s * 24, 格宽, 格高, 亮);
                画文字(112, s行 + s * 24 + 10, 位格字(s, 位顶), 0xFFE8E8F0);
                s = s + 1;
            }
            画线(30, 栈基 + 2 + 格高, 158, 栈基 + 2 + 格高, 0xFF3C3C46);
            画文字(12, 栈基 + 2 + 格高 + 4, "栈底(下标 0)", 0xFF8A8A96);
            画文字(12, 70, 栈题, 0xFF9CC4FF);     // 这一行放在右上标题左边
            画文字(12, 92, 栈注, 0xFF8A8A96);
            画文字(12, 114, 弹题, 0xFFD0D0D8);
            画文字(364, 141, 弹示[弹过], 0xFFD0D0D8);   // 一行现成的字:弹几位就取第几行

            // 右上:环形队列 —— 5 个格子排一排(标 0~4 号位),队头 / 队尾各一个箭头指过去
            画文字(300, 70, 队题, 0xFF9CC4FF);
            画文字(300, 92, 环注, 0xFF8A8A96);
            整数 c = 0;
            整数 c横 = 队x0;
            整数 环亮 = 0;
            整数 队步 = 0;               // 0 = 空环 / 1~5 = 刚入第几个人 / 6 = 绕回去之后
            如果 (帧计 >= 110)
            {
                队步 = 1;
            }
            如果 (帧计 >= 114)
            {
                队步 = 2;
            }
            如果 (帧计 >= 118)
            {
                队步 = 3;
            }
            如果 (帧计 >= 122)
            {
                队步 = 4;
            }
            如果 (帧计 >= 126)
            {
                队步 = 4;
            }
            如果 (帧计 >= 134)
            {
                队步 = 5;
            }
            如果 (选中 == 1 && 选中格 >= 0)
            {
                画矩形(队x0 + 选中格 * 环空 - 2, 队列y - 2, 格宽 + 8, 格高 + 4, 0xFF4A6EA8);
            }
            当 (c < 5)
            {
                环亮 = 0;
                如果 (c == 队头)
                {
                    环亮 = 1;
                }
                如果 (选中 == 1 && c == 选中格)
                {
                    环亮 = 1;
                }
                画框(c横, 队列y, 格宽, 格高, 环亮);
                画文字(c横 + 6, 队列y + 4, 序号文[c], 0xFF8A8A96);
                画文字(c横 + 20, 队列y + 16, 队格(c, 队步), 0xFFE8E8F0);   // 查表:一格一个字面量
                c横 = c横 + 环空;
                c = c + 1;
            }
            整数 头横 = 队x0 + 队头 * 环空 + 28;
            整数 尾格 = (队头 + 队里) % 5;
            整数 尾横 = 队x0 + 尾格 * 环空 + 28;
            画箭头(头横, 390, 头横, 358, 1);
            画文字(124, 374, "队头 ↓", 0xFF9CC4FF);
            画箭头(尾横, 390, 尾横, 358, 1);
            画文字(268, 374, "队尾 ↓", 0xFF9CC4FF);
            如果 (帧计 >= 134 && 尾格 == 0 && 队里 >= 4)                     // "折回去"那一条折线
            {
                画箭头(队x0 + 8, 队列y + 12, 48, 队列y + 12, 3);
                画文字(44, 284, "第 6 个绕回 0 号格(队尾折回去了)", 0xFFD0D0D8);
            }

            // 下半屏:最小堆 —— 按"父亲不比孩子大"排好的一行格子,点一格说它的优先级
            画矩形(12, 424, 536, 22, 0xFF232B3E);
            画文字(20, 427, "下半屏:最小堆(优先队列)—— 父亲不比孩子大,堆[0] 就是最急的", 0xFF9CC4FF);
            画文字(20, 456, "这 8 格是容量;演的是 放 5 / 1 / 9 / 3 再 取最小 两次", 0xFF8A8A96);
            整数 h = 0;
            整数 h横 = 堆x0;
            整数 堆亮 = 0;
            如果 (选中 == 2 && 选中格 >= 0)
            {
                画矩形(堆x0 + 选中格 * 格宽 - 2, 堆y - 2, 格宽 + 8, 格高 + 4, 0xFF4A6EA8);
            }
            当 (h < 5)
            {
                堆亮 = 0;
                如果 (h < 几个 && 任务[h] == 最急)
                {
                    堆亮 = 2;
                }
                如果 (选中 == 2 && h == 选中格)
                {
                    堆亮 = 1;
                }
                画框(h横, 堆y, 格宽, 格高, 堆亮);
                画文字(h横 + 6, 堆y + 4, 堆号文[h], 0xFF8A8A96);
                如果 (h < 几个)
                {
                    如果 (任务[h] == 9)
                    {
                        画文字(h横 + 20, 堆y + 16, "9", 0xFFE8E8F0);
                    }
                    如果 (任务[h] == 5)
                    {
                        画文字(h横 + 20, 堆y + 16, "5", 0xFFE8E8F0);
                    }
                    如果 (任务[h] == 3)
                    {
                        画文字(h横 + 20, 堆y + 16, "3", 0xFFE8E8F0);
                    }
                    如果 (任务[h] == 1)
                    {
                        画文字(h横 + 20, 堆y + 16, "1", 0xFFE8E8F0);
                    }
                }
                h横 = h横 + 格宽;
                h = h + 1;
            }
            画文字(20, 550, 堆注, 0xFF8A8A96);
            画文字(20, 566, 堆注二, 0xFF8A8A96);

            // 底下两行:点中的那一格 ⇒ 说它现在装什么 / 是第几个 / 前面后面是谁
            // ⚠ 这两行**分开画两行**:`画文字` 不认换行符(拼成一长条就是一行顶出窗口,实测 836 > 560)
            画线(12, 598, 548, 598, 0xFF3C3C46);
            画文字(20, 604, 头字(选中), 0xFF9CC4FF);
            画文字(20, 630, 说明一, 0xFFE8E8F0);
            画文字(20, 658, 说明二, 0xFFD0D0D8);
            画文字(20, 706, 底注, 0xFF8A8A96);   // 窗高 760:706+12 还在窗里

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();                                // 关掉它,程序继续往下跑
}

停止

