// ============================================================
// 示例38_数组与统计(G4 批 6:`数组.hb` · `列表.hb` · `统计.hb` 三个库)
//
//   一份"成绩单"从进到出走一遍,把三个库的用法摆在一起:
//     · `Sample\库\数组.hb` —— 定长数组的**搬 / 比 / 数**:去重(升序)、段拷、反转、平移、
//       合并、集合运算(并 / 交 / 差)、是相同、累计和……(17 个公开函数)
//     · `Sample\库\列表.hb` —— 列表动作**收"数组 + 有效个数"**:接到尾 / 插入到 / 删掉 /
//       删掉值 / 去重复 / 查找 / 反转 / 拷到 / 合并……(14 个公开函数)
//       (语言里列表**取不出地址** ⇒ 传不进函数,这一条是语言面的,写在库的头注释里)
//     · `Sample\库\统计.hb` —— 基本统计量:计数 / 求和 / 乘积 / 平方和 / 最大 / 最小 / 极差 /
//       中位数 / 众数 / 第k小 / 平均值 / 样本方差 / 总体方差 / 标准差……(17 个公开函数)
//
//   三条口径(演示里照它走,细节看各库的头注释):
//     ① **要小数的三件返回 `双精度`**(结构),打印不能直接写进 `输出行` ——
//        先落进一个 `双精度` 变量,再 `双精度转字符串`;
//     ② **"目标表小了"一律不报错**:`数组.*` 与 `列表.*` 那些"往另一张表写"的函数
//        返回值就是**实际写出去几个**,调用方自己比对;
//     ③ **去重出来的表是升序的**(语言里没有哈希表内建,"保持原有先后"的去重在
//        `列表.去重复` 那一边 —— 它是就地删重复,不动别的元素的先后)。
// ============================================================
包含 "../../库/数组.hb"
包含 "../../库/列表.hb"
包含 "../../库/统计.hb"
包含 "../../库/string.hb"          // UI 那一段要 `格式化` —— 放文件头,与 示例07 / 示例20 / 示例17 一样

// 双精度是结构:打印要先落进变量,再交给 `双精度转字符串`
方法 打双(双精度 值)
{
    输出行(双精度转字符串(值));
}

// ---------------- ① 一份成绩单:统计那一套怎么用 ----------------
整数 分数[10] = [88, 92, 79, 88, 95, 61, 88, 73, 100, 84];

输出行(统计.个数(分数));                       // 10 份
输出行(统计.求和(分数));                       // 848
输出行(统计.最大(分数));                       // 100
输出行(统计.最小(分数));                       // 61
输出行(统计.极差(分数));                       // 39
输出行(统计.中位数(分数));                     // 偶数个:中间两个都是 88
输出行(统计.众数(分数));                       // 88 出现三次,最多
输出行(统计.第k小(分数, 3));                   // 第三小 = 79
输出行(统计.是否升序(分数));                   // 原样是乱序,给 0
双精度 平均 = 统计.平均值(分数);
双精度 总体 = 统计.总体方差(分数);
双精度 样本 = 统计.样本方差(分数);
双精度 标差 = 统计.标准差(分数);
打双(平均);                                     // 84.8
打双(总体);                                     // 离差平方和 1164 / 10 = 116.4
打双(样本);                                     // 1164 / 9 = 129.333…
打双(标差);                                     // √116.4 = 10.7888…
输出行(统计.草稿个数());                       // 排序用的草稿纸里现在是 10 格
输出行(统计.取草稿(0));                        // 排完最小的那个 = 61
输出行(统计.平方和(分数));                     // 73068

// ---------------- ② 数组那一套:去重 / 段拷 / 平移 / 集合 ----------------
整数 干净[10];
整数 个数 = 数组.去重(分数, 干净);             // 去重后的表是**升序**的
输出行(个数);                                  // 8 个不同的分数
输出行(干净[0]);                               // 61
输出行(干净[7]);                               // 100

整数 前五名[5];
输出行(数组.段拷(干净, 3, 5, 前五名));         // 从第 3 格起拷 5 个
输出行(前五名[0]);                             // 84
输出行(前五名[4]);                             // 100

数组.反转(前五名);
输出行(前五名[0]);                             // 倒过来:100 在最前
数组.反转(前五名);                             // 再倒回去
数组.平移(前五名, 1);                          // 循环左移一格
输出行(前五名[0]);                             // 88
输出行(前五名[4]);                             // 84

整数 左组[3] = [88, 92, 61];
整数 右组[3] = [92, 73, 61];
整数 合[8];
输出行(数组.造并集(左组, 右组, 合));           // 4 个不同的值(升序)
输出行(合[0]);                                 // 61
输出行(合[3]);                                 // 92
输出行(数组.造交集(左组, 右组, 合));           // 两边都有的:61 / 92
输出行(合[1]);                                 // 92
输出行(数组.造差集(左组, 右组, 合));           // 只在左组的:88
输出行(合[0]);                                 // 88
输出行(数组.合并(左组, 右组, 合));             // 归并(不去重)= 6 个
输出行(合[0]);                                 // 61
输出行(合[1]);                                 // 61
输出行(合[2]);                                 // 73
输出行(合[3]);                                 // 88
输出行(合[4]);                                 // 92
输出行(合[5]);                                 // 92
输出行(数组.是相同(左组, 左组));               // 1
输出行(数组.累计和(左组, 合));                 // 前缀和
输出行(合[2]);                                 // 88 + 92 + 61 = 241

// ---------------- ③ 列表那一套:数组 + 有效个数 ----------------
整数 名单[8];
整数 用了 = 0;
用了 = 列表.接到尾(名单, 用了, 88);
用了 = 列表.接到尾(名单, 用了, 73);
用了 = 列表.接到尾(名单, 用了, 88);
用了 = 列表.接到尾(名单, 用了, 61);
输出行(用了);                                  // 4 个
用了 = 列表.插入到(名单, 用了, 1, 92);         // 插在第 1 格之前
输出行(名单[1]);                               // 92
用了 = 列表.删掉(名单, 用了, 0);               // 删掉第 0 格
输出行(名单[0]);                               // 73
输出行(列表.查找(名单, 用了, 88));             // 第一个 88 在第 1 格
输出行(列表.计数(名单, 用了, 88));             // 两个 88
用了 = 列表.去重复(名单, 用了);                // 保持原有先后地去重
输出行(用了);                                  // 3 个不同的:73 / 88 / 61
用了 = 列表.删掉值(名单, 用了, 88);            // 删掉所有 88
输出行(用了);                                  // 2 个
输出行(列表.取元素(名单, 用了, 99));           // 越界:给 0
输出行(列表.是否有效(名单, 用了, 1));          // 1
输出行(列表.改元素(名单, 用了, 0, 100));       // 1
输出行(名单[0]);                               // 100

整数 补考[3] = [59, 66, 71];
输出行(列表.拷到(名单, 补考, 3));              // 整体替换
输出行(名单[2]);                               // 71
输出行(列表.合并(名单, 3, 补考, 3));           // 再接一份:6 格
输出行(名单[5]);                               // 71
输出行(列表.填充(名单, 3, 0));                 // 前 3 格清零
输出行(名单[2]);                               // 0

// ---------------- ④ 三个库合起来:一句话能说清的报表 ----------------
整数 人数 = 统计.个数(分数);
整数 总分 = 统计.求和(分数);
双精度 均分 = 统计.平均值(分数);
输出行(人数);
输出行(总分);
打双(均分);
输出行(统计.最大(分数) - 统计.最小(分数));

// ============================================================
// H82 批 5:窗口那一半 —— 把这份成绩单画成**直方图**(上面的计算与断言一行没动)
//
//   上半 = 十份成绩的柱子(柱高 = 分数 × 1.6 像素;横着那条线 = 平均分;逐帧扫过一根);
//   下半 = 十二个统计量(**开窗前现问库要**,不是抄常数);
//   点任意一根柱子 ⇒ 底下那行换成"第几份 · 多少分"。
//
//   写法照 `Sample\说明.md`《带 UI 的示例怎么写》那一节(开窗前把文字全拼好,主循环里一条字符串都不拼)。
//   三个坑照 示例17 那份记的绕:字符串数组元素当不了赋值右值(H87)⇒ 状态行直接拿元素当 `画文字` 的实参;
//   循环体里不留声明;二维元素读 / 下标算式 / `格式化(...)` 一样占临时寄存器 ⇒ 先落一格再用。
// ============================================================

// ---- 一、要画的文字(全在开窗前拼好)----
//   整数那八条走 `格式化`;四个双精度走 `双精度转字符串`(库里那条口径:要小数的先落变量再转字符串)。
整数 人2 = 统计.个数(分数);
整数 和2 = 统计.求和(分数);
整数 大2 = 统计.最大(分数);
整数 小2 = 统计.最小(分数);
整数 差2 = 统计.极差(分数);
整数 中2 = 统计.中位数(分数);
整数 众2 = 统计.众数(分数);
整数 三2 = 统计.第k小(分数, 3);
字符串 文个 = 格式化("{0} 份", 人2);
字符串 文和 = 格式化("{0}", 和2);
字符串 文大 = 格式化("{0}", 大2);
字符串 文小 = 格式化("{0}", 小2);
字符串 文差 = 格式化("{0}", 差2);
字符串 文中 = 格式化("{0}", 中2);
字符串 文众 = 格式化("{0}", 众2);
字符串 文三 = 格式化("{0}", 三2);
字符串 文均 = 双精度转字符串(平均);
字符串 文总 = 双精度转字符串(总体);
字符串 文样 = 双精度转字符串(样本);
字符串 文标 = 双精度转字符串(标差);

// ---- 二、柱子上要写的字:第 i 份是多少分(下标 0~9)、柱号 0~9 两份小字 ----
字符串 点文[10];
字符串 号文[10];
字符串 暂 = "";
整数 复 = 0;
整数 高 = 0;
当 (复 < 10)
{
    高 = 分数[复];                    // ⚠ 元素读先落一格:直接写进 `格式化` 会撞临时寄存器上限
    暂 = 格式化("第 {0} 份 = {1} 分", 复, 高);
    点文[复] = 暂;
    暂 = 格式化("{0}", 复);
    号文[复] = 暂;
    复 = 复 + 1;
}
整数 均整 = 和2 / 人2;                 // 平均分的整数值(84):给柱子上色用,免得整数与双精度比大小
整数 均线 = 268 - 和2 * 16 / 人2 / 10;  // 平均分那条横线的高度(848 × 1.6 / 10)

// ---- 三、窗口自己要记住的那几格 ----
整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;
整数 点y = 0;
整数 选中 = -1;
整数 亮 = 0;
逻辑 有一下 = 假;
字符串 状态头 = "点上面任意一根柱子 ⇒";

逻辑 开着 = 打开窗口("示例38 数组与统计", 560, 560);
如果 (开着)
{
    逻辑 收手 = 假;
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                如果 (类型 == 5)
                {
                    有一下 = 真;               // 抬起 = "点一下"落地
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
                否则
                {
                    如果 (键码 == 27)
                    {
                        收手 = 真;             // ESC 也收手
                    }
                }
            }
        }

        // 点击结算**单独摆一层**:柱子那块(x 24~532、y 100~268)才算命中
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点y >= 100 && 点y < 268 && 点x >= 24 && 点x < 532)
            {
                选中 = (点x - 24) / 52;
                状态头 = "选中的那根柱子 ⇒";
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼)----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 40, 0xFF2A3550);
            画文字(24, 16, "示例38 数组与统计:一份成绩单走一遍", 0xFFE8E8F0);
            画文字(24, 34, "上半 = 直方图(横线 = 平均分);下半 = 统计量", 0xFFB0B0B8);

            // 上半:十根柱子(⚠ 底色一律画在文字之前;柱子里那些字画在柱子之后 —— 柱子是柱子、字在柱子上面)
            画矩形(12, 64, 536, 220, 0xFF16161E);
            画文字(24, 72, "十份成绩(柱高 = 分数 × 1.6 像素;点一根柱子看它第几份)", 0xFF9CC4FF);
            复 = 0;
            当 (复 < 10)
            {
                高 = 分数[复] * 16 / 10;
                如果 (分数[复] >= 均整)
                {
                    画矩形(24 + 复 * 52, 268 - 高, 40, 高, 0xFF2FA84F);      // 不低于平均分:绿
                }
                否则
                {
                    画矩形(24 + 复 * 52, 268 - 高, 40, 高, 0xFF2A6EF0);      // 低于平均分:蓝
                }
                如果 (复 == 亮)
                {
                    画矩形(24 + 复 * 52, 268 - 高, 40, 6, 0xFFE0C060);       // 这一帧扫到的那一根:顶上一条金边
                }
                画文字(24 + 复 * 52 + 12, 274, 号文[复], 0xFF8A8A96);        // 柱号
                复 = 复 + 1;
            }
            画线(24, 均线, 532, 均线, 0xFFE0C060);                          // 平均分那条横线
            画文字(452, 均线 - 16, "平均分", 0xFFE0C060);

            // 下半:十二个统计量(两列六行)
            画矩形(12, 296, 536, 152, 0xFF16161E);
            画文字(24, 304, "统计量(开窗前现问库要的)", 0xFF9CC4FF);
            画文字(24, 328, "个数", 0xFF9CC4FF);
            画文字(134, 328, 文个, 0xFFD0D0D8);
            画文字(24, 348, "求和", 0xFF9CC4FF);
            画文字(134, 348, 文和, 0xFFD0D0D8);
            画文字(24, 368, "最大", 0xFF9CC4FF);
            画文字(134, 368, 文大, 0xFFD0D0D8);
            画文字(24, 388, "最小", 0xFF9CC4FF);
            画文字(134, 388, 文小, 0xFFD0D0D8);
            画文字(24, 408, "极差", 0xFF9CC4FF);
            画文字(134, 408, 文差, 0xFFD0D0D8);
            画文字(24, 428, "中位数", 0xFF9CC4FF);
            画文字(134, 428, 文中, 0xFFD0D0D8);
            画文字(292, 328, "众数", 0xFF9CC4FF);
            画文字(402, 328, 文众, 0xFFD0D0D8);
            画文字(292, 348, "第 3 小", 0xFF9CC4FF);
            画文字(402, 348, 文三, 0xFFD0D0D8);
            画文字(292, 368, "平均", 0xFF9CC4FF);
            画文字(402, 368, 文均, 0xFFD0D0D8);
            画文字(292, 388, "总体方差", 0xFF9CC4FF);
            画文字(402, 388, 文总, 0xFFD0D0D8);
            画文字(292, 408, "样本方差", 0xFF9CC4FF);
            画文字(402, 408, 文样, 0xFFD0D0D8);
            画文字(292, 428, "标准差", 0xFF9CC4FF);
            画文字(402, 428, 文标, 0xFFD0D0D8);

            // 状态行:选中的那根柱子(点文 那一格直接当 `画文字` 的实参 —— H87 挡的是"当赋值右值")
            画矩形(12, 460, 536, 34, 0xFF232B3E);
            画文字(24, 469, 状态头, 0xFFE8E8F0);
            如果 (选中 >= 0)
            {
                画文字(220, 469, 点文[选中], 0xFF9CC4FF);
            }
            画文字(24, 504, "绿柱 = 不低于平均分的,蓝柱 = 低于平均分的;金线 = 平均分", 0xFF8A8A96);
            画文字(24, 526, "ESC 或关窗退出:窗口一直转到你自己关", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(240);                             // 让出一帧、别把 CPU 烧满(无头不真等)

            // 逐帧推进:金边沿十根柱子走一圈
            亮 = 亮 + 1;
            如果 (亮 >= 10)
            {
                亮 = 0;
            }
        }
    }

    关闭窗口();
}

