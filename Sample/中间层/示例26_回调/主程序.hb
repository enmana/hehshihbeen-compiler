// ============================================================
// 示例26:回调(把函数当参数传)—— G2 起的三件套
//
//   要解决的事:HB 没有闭包、也没有匿名函数,可"这一步到底干什么"经常要**晚一点**才定 ——
//   排序按哪个次序比、按钮被点的是哪一个。以前只有两条路:把几套逻辑写死在各个 `如果` 里,
//   或者复制好几份几乎一样的排序。有了回调,**同一个函数 + 换一个比较器**就够了。
//
//   三件套(缺一不可):
//     ① `地址(函数名)` —— 取**代码地址**(名字是变量 / 字段 / 数组元素时照旧取**数据地址**);
//     ② `回调 名字 = 地址(函数名);` —— 4 字节,和 `整数` 同档(能比较、能当参数传);
//     ③ `间接调用(名字, 实参…)` —— 调用约定与直接调用**逐字同一条**:实参照旧摆进新帧、
//        被调方 `返回` 照旧回来、返回值照旧在表达式里用,只有最后那一条指令不同。
//
//   本示例演示两段:
//     ① 排序比较器:一个冒泡排序 + 三个比较器(升序 / 降序 / 按个位)。
//        排序函数的形参写成 `回调 比较(整数, 整数)` —— 换比较器就换次序,排序本身一行不用改;
//        顺带演示"同一个回调变量中途改指别的函数"(下一次调用就调新的那个)。
//     ② 按钮式分派:一排按钮各挂一个回调,按号调那一个 —— 加按钮只加一格。
//
//   两条边界(帮助《二十九、回调》也写清了):
//     · `回调` 必须写初值,初值只能是 `地址(函数名)`;指向哪个函数**编译期**就定死;
//     · `回调` 只收单个变量 —— 不能进数组 / 结构字段,所以那排按钮写成一格一个变量。
// ============================================================

// ---------------- ① 排序比较器 ----------------

// 把一张整数表逐行打出来
方法 打印表(整数 表[])
{
    整数 i = 0;
    当 (i < 表.长度())
    {
        测试输出(表[i]);
        i = i + 1;
    }
    返回
}

// 冒泡排序:**怎么比**由调用方给(形参就是那一格 `回调 比法(整数, 整数)`)
方法 冒泡排序(整数 表[], 回调 比法(整数, 整数))
{
    整数 i = 0;
    当 (i < 表.长度())
    {
        整数 j = 0;
        当 (j < 表.长度() - 1 - i)
        {
            如果 (间接调用(比法, 表[j], 表[j + 1]) > 0)
            {
                整数 换 = 表[j];
                表[j] = 表[j + 1];
                表[j + 1] = 换;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    返回
}

// 三个比较器:返回值 > 0 表示"左边该排到后面去"
方法 升序(整数 左, 整数 右) 返回 整数
{
    返回 左 - 右;
}

方法 降序(整数 左, 整数 右) 返回 整数
{
    返回 右 - 左;
}

方法 按个位(整数 左, 整数 右) 返回 整数
{
    返回 左 % 10 - 右 % 10;
}

整数 数[6] = [23, 5, 41, 2, 17, 8];
打印表(数);                          // 原样:23 5 41 2 17 8
冒泡排序(数, 地址(升序));
打印表(数);                          // 2 5 8 17 23 41
冒泡排序(数, 地址(降序));
打印表(数);                          // 41 23 17 8 5 2
冒泡排序(数, 地址(按个位));
打印表(数);                          // 个位 1 2 3 5 7 8 ⇒ 41 2 23 5 17 8

// 同一个回调变量,中途改指别的函数(下一次调用就调新的那个)
回调 当前 = 地址(升序);
整数 表二[4] = [9, 3, 7, 1];
冒泡排序(表二, 当前);
打印表(表二);                        // 1 3 7 9
当前 = 地址(降序);
冒泡排序(表二, 当前);
打印表(表二);                        // 9 7 3 1
测试输出(当前 == 地址(降序));        // 1(回调就是一个 4 字节的值,能比较相等)

// ---------------- ② 按钮式分派 ----------------

// 三个按钮各自要干的事:都收一个参数,都返回一个值
方法 问好(整数 参数) 返回 整数
{
    输出行("按钮 问好");
    返回 参数 + 1;
}

方法 清零(整数 参数) 返回 整数
{
    输出行("按钮 清零");
    返回 0;
}

方法 翻倍(整数 参数) 返回 整数
{
    输出行("按钮 翻倍");
    返回 参数 * 2;
}

// 一排按钮各挂一个回调(回调不能进数组,所以是一格一个变量);
// 要加一个新按钮:加一个方法 + 加一格回调 + 分派里加一条 —— 别的按钮一行都不动。
回调 按钮问好 = 地址(问好);
回调 按钮清零 = 地址(清零);
回调 按钮翻倍 = 地址(翻倍);

// 分派:界面上"第 `号` 个按钮被点了"就走这里
方法 点按钮(整数 号, 整数 参数) 返回 整数
{
    如果 (号 == 0)
    {
        返回 间接调用(按钮问好, 参数);
    }
    如果 (号 == 1)
    {
        返回 间接调用(按钮清零, 参数);
    }
    如果 (号 == 2)
    {
        返回 间接调用(按钮翻倍, 参数);
    }
    输出行("没有这个按钮");
    返回 -1;
}

测试输出(点按钮(0, 41));    // 问好:先打"按钮 问好",再打 42
测试输出(点按钮(1, 41));    // 清零:0
测试输出(点按钮(2, 21));    // 翻倍:42
测试输出(点按钮(9, 21));    // 没有这一号:-1
停止

// 预期输出: 23|5|41|2|17|8|2|5|8|17|23|41|41|23|17|8|5|2|41|2|23|5|17|8|1|3|7|9|9|7|3|1|1|按钮 问好|42|按钮 清零|0|按钮 翻倍|42|没有这个按钮|-1
