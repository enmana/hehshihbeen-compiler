// ============================================================
// 示例35_宽度与数字:G4 批 3 —— `宽度.hb`(等宽排版)· `数字.hb`(进制 / 位数 / 千分位)
//
//   这一篇拼一张**对得齐的小表**,顺带把两个库的每一档都走一遍:
//     · **`Sample\库\宽度.hb`** —— `左对齐 / 右对齐 / 居中 / 截断`(4 个);
//       宽度口径与语言内建 **`取文字宽度`** 逐字一致(**中文两格、ASCII 一格**,不开窗也能用);
//     · **`Sample\库\数字.hb`** —— `按进制转字符串 / 按进制解析 / 补零 / 千分位`(4 个);
//       十进制那档仍归 `string.hb` 的 `转字符串`(这一库不另开这个名字)。
//
//   三条口径(演示里照它走):
//     ① **格数按"格"算**:中文两格、ASCII 一格;格数不够时对齐**不截断**(要截断用 `截断`);
//     ② **进制 2~36**,10 以上大写;负号在最前面(`-255` 的十六进制是 `-FF`,不是补码);
//     ③ **`补零` 的位数含负号**:`补零(-7, 4)` 给 `-007`。
//
//   这一篇不碰文件、不碰网络:要看的全是打印出来的字。
// ============================================================
包含 "../../库/宽度.hb"
包含 "../../库/数字.hb"
包含 "../../库/string.hb"          // UI 那一段要把**格数**(整数)拼进文字 ⇒ 要库里的 `转字符串`

// ---------------- ① 先看清"一格是多宽" ----------------
输出行(取文字宽度("abc"));                                 // 3:ASCII 一格
输出行(取文字宽度("汉字"));                                // 4:汉字两格
输出行(取文字宽度("汉字ab"));                              // 8:混着算
输出行(取文字宽度(""));                                    // 0

// ---------------- ② 对齐三兄弟:格数、多出来的一格放哪 ----------------
字符串 看 = "";
看 = 宽度.左对齐("ab", 5);
输出行(格式化("[{0}]", 看));                              // [ab   ]
看 = 宽度.右对齐("ab", 5);
输出行(格式化("[{0}]", 看));                              // [   ab]
看 = 宽度.居中("ab", 5);
输出行(格式化("[{0}]", 看));                              // [ ab  ]:差是奇数,左边少一格
看 = 宽度.居中("ab", 6);
输出行(格式化("[{0}]", 看));                              // [  ab  ]
看 = 宽度.左对齐("汉字", 6);
输出行(格式化("[{0}]", 看));                              // [汉字  ]:两格字算两格
看 = 宽度.左对齐("abcdef", 3);
输出行(格式化("[{0}]", 看));                              // [abcdef]:够长就给原串,不截断

// ---------------- ③ 截断:格数 + 省略一起算,不切半个字 ----------------
看 = 宽度.截断("一二三四五", 6, "…");
输出行(格式化("[{0}]", 看));                              // [一二…]:两格字不会切一半
看 = 宽度.截断("abcdefgh", 5, "..");
输出行(格式化("[{0}]", 看));                              // [abc..]
看 = 宽度.截断("abc", 10, "..");
输出行(格式化("[{0}]", 看));                              // [abc]:本来就够

// ---------------- ④ 数字:进制 / 补零 / 千分位 ----------------
输出行(数字.按进制转字符串(255, 16));                      // FF
输出行(数字.按进制转字符串(-255, 16));                     // -FF:负号在最前面
输出行(数字.按进制转字符串(10, 2));                        // 1010
输出行(数字.按进制转字符串(0, 8));                         // 0
输出行(数字.按进制转字符串(2147483647, 36));               // ZIK0ZJ
输出行(数字.按进制转字符串(0 - 2147483647 - 1, 16));       // -80000000:边界值也印得对
输出行(数字.按进制转字符串(255, 1));                       // (空):进制越界
输出行(数字.补零(7, 5));                                   // 00007
输出行(数字.补零(-7, 5));                                  // -0007:负号占一位
输出行(数字.补零(-7, 2));                                  // -7:够了就原样
输出行(数字.千分位(1234567));                              // 1,234,567
输出行(数字.千分位(-1234));                                // -1,234:负号不参与分组
输出行(数字.千分位(999));                                  // 999

// ---------------- ⑤ 解析:认大小写、认负号,认不出给假并清零 ----------------
整数 收 = 0;
输出行(数字.按进制解析("FF", 16, 收));                     // 1
输出行(收);                                                // 255
输出行(数字.按进制解析("ff", 16, 收));                     // 1:大小写都认
输出行(收);                                                // 255
输出行(数字.按进制解析("-101", 2, 收));                    // 1
输出行(收);                                                // -5
输出行(数字.按进制解析("9", 8, 收));                       // 0:八进制里没有 9
输出行(收);                                                // 0:认不出就清零

// ---------------- ⑥ 凑一张对得齐的表:两个库一起用 ----------------
//   拼一串只能用 `拼接到`(字符串不能用 `+`,语言口径):先 `左对齐` 一列,再一列一列接上去
字符串 表头 = "";
表头 = 宽度.左对齐("名称", 12);
拼接到(表头, 宽度.右对齐("数量", 6));
拼接到(表头, 宽度.右对齐("金额", 12));
输出行(表头);
字符串 行 = "";
行 = 宽度.左对齐("内存条", 12);
拼接到(行, 宽度.右对齐("2", 6));
拼接到(行, 宽度.右对齐(数字.千分位(1234), 12));
输出行(行);
行 = 宽度.左对齐("固态硬盘", 12);
拼接到(行, 宽度.右对齐("1", 6));
拼接到(行, 宽度.右对齐(数字.千分位(12345), 12));
输出行(行);
行 = 宽度.左对齐("很长的名字要截断", 12);
拼接到(行, 宽度.右对齐("1", 6));
拼接到(行, 宽度.右对齐(数字.千分位(1), 12));
输出行(行);
行 = 宽度.截断("很长的名字要截断", 12, "…");
拼接到(行, 宽度.右对齐("1", 6));
拼接到(行, 宽度.右对齐(数字.千分位(1), 12));
输出行(行);

// ============================================================
// H82 批 5:窗口那一半 —— 把"格数"这件事**画出来**(上面的计算与断言一行没动)
//
//   上:一格到底多宽(尺子每 8 像素一格,底下写"汉字ab 占几格");
//   中:对齐三兄弟与截断,方括号里那几段就是库真吐出来的串;
//   下:数字(进制 / 补零 / 千分位)与那张**对得齐的表**(两个库一起用);
//   点表格里任意一行 ⇒ 底下那行说它是怎么拼出来的。
//
//   写法照 `Sample\说明.md`《带 UI 的示例怎么写》那一节(开窗前把文字全拼好,主循环里一条不拼)。
//   ⚠ `拼接到` 只在**顶层**用:这是**写法偏好**,不再是绕缺陷 —— 库那条「方法里往长串尾巴上接
//     短串会多一个 0」的缺陷(`未做任务清单.md` H102)**第445批已修**(容量检查留出末尾那一格)。
// ============================================================

// ---- 一、上:一格多宽(尺子 12 格,每格 8 像素)----
字符串 宽一 = 格式化("abc 占 {0} 格(ASCII 一格)", 取文字宽度("abc"));
字符串 宽二 = 格式化("汉字 占 {0} 格(汉字两格)", 取文字宽度("汉字"));
字符串 宽三 = 格式化("汉字ab 占 {0} 格(混着算)", 取文字宽度("汉字ab"));

// ---- 二、中:对齐三兄弟 + 截断(先落 `看`,再拼进那句话)----
字符串 看 = "";
字符串 对一 = "";
字符串 对二 = "";
字符串 对三 = "";
字符串 对四 = "";
字符串 对五 = "";
看 = 宽度.左对齐("ab", 5);
对一 = 格式化("左对齐 ab → 5 格 = [{0}]", 看);
看 = 宽度.右对齐("ab", 5);
对二 = 格式化("右对齐 ab → 5 格 = [{0}]", 看);
看 = 宽度.居中("ab", 5);
对三 = 格式化("居中 ab → 5 格 = [{0}](差奇数格:左边少)", 看);
看 = 宽度.左对齐("汉字", 6);
对四 = 格式化("左对齐 汉字 → 6 格 = [{0}]", 看);
看 = 宽度.截断("一二三四五", 6, "…");
对五 = 格式化("截断 一二三四五 → 6 格 = [{0}](不切半个字)", 看);

// ---- 三、下:数字那几档 ----
字符串 数一 = "";
字符串 数二 = "";
字符串 数三 = "";
字符串 数四 = "";
看 = 数字.按进制转字符串(255, 16);
数一 = 格式化("255 的十六进制 = {0}", 看);
看 = 数字.按进制转字符串(-255, 16);
数二 = 格式化("-255 的十六进制 = {0}(负号在最前面)", 看);
看 = 数字.补零(7, 5);
数三 = 格式化("补零(7, 5) = {0}", 看);
看 = 数字.千分位(1234567);
数四 = 格式化("千分位(1234567) = {0}", 看);

// ---- 四、那张对得齐的表(表头 + 四行;每行都是"左对齐 + 右对齐 + 右对齐"拼出来的)----
字符串 表头2 = 宽度.左对齐("名称", 12);
看 = 宽度.右对齐("数量", 6);
拼接到(表头2, 看);
看 = 宽度.右对齐("金额", 12);
拼接到(表头2, 看);
字符串 行一 = 宽度.左对齐("内存条", 12);
看 = 宽度.右对齐("2", 6);
拼接到(行一, 看);
看 = 数字.千分位(1234);
看 = 宽度.右对齐(看, 12);
拼接到(行一, 看);
字符串 行二 = 宽度.左对齐("固态硬盘", 12);
看 = 宽度.右对齐("1", 6);
拼接到(行二, 看);
看 = 数字.千分位(12345);
看 = 宽度.右对齐(看, 12);
拼接到(行二, 看);
字符串 行三 = 宽度.左对齐("很长的名字要截断", 12);
看 = 宽度.右对齐("1", 6);
拼接到(行三, 看);
看 = 数字.千分位(1);
看 = 宽度.右对齐(看, 12);
拼接到(行三, 看);
字符串 行四 = 宽度.截断("很长的名字要截断", 12, "…");
看 = 宽度.右对齐("1", 6);
拼接到(行四, 看);
看 = 数字.千分位(1);
看 = 宽度.右对齐(看, 12);
拼接到(行四, 看);

// ---- 五、点一行之后底下那句话(写死的五条,免得每帧现拼)----
字符串 点文[5];
点文[0] = "表头:三列都按格数排(12 + 6 + 12 = 30 格)";
点文[1] = "内存条那一行:数量 6 格右对齐 ⇒ 个位数也贴着金额列";
点文[2] = "固态硬盘那一行:金额 12,345 是 5 位数,右对齐后照样齐";
点文[3] = "第三行没截断:左对齐够长就给原串(所以它顶到数量列上)";
点文[4] = "第四行用了截断:长名字压成 12 格,不切半个汉字";

// ---- 六、窗口自己要记住的那几格 ----
字符串 状态头 = "点表格里任意一行 ⇒";
整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;
整数 点y = 0;
整数 选中 = -1;
整数 亮 = 0;
整数 复 = 0;
整数 高 = 0;
逻辑 有一下 = 假;

逻辑 开着 = 打开窗口("示例35 宽度与数字", 560, 640);
如果 (开着)
{
    逻辑 收手 = 假;
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
             {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
                否则
                {
                    如果 (键码 == 27)
                    {
                        收手 = 真;             // ESC 也收手
                    }
                }
            }
        }

        // 点击结算**单独摆一层**:表格那五行(y 508~600、x 20~540)里点到哪一行
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点y >= 508 && 点y < 600 && 点x >= 20 && 点x < 540)
            {
                选中 = (点y - 508) / 20;
                如果 (选中 > 4)
                {
                    选中 = 4;
                }
                状态头 = "这一行是这么拼出来的 ⇒";
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼)----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 40, 0xFF2A3550);
            画文字(24, 16, "示例35 宽度与数字:格数是怎么算的", 0xFFE8E8F0);
            画文字(24, 34, "等宽字体:1 格 = 8 像素,汉字两格、ASCII 一格", 0xFFB0B0B8);

            // 上:尺子(12 格 × 8 像素 = 96 像素)+ 三行格数
            画矩形(12, 64, 536, 110, 0xFF16161E);
            画文字(24, 72, "一格多宽(尺子每 8 像素一格)", 0xFF9CC4FF);
            复 = 0;
            当 (复 < 12)
            {
                如果 (复 - (复 / 2) * 2 == 0)
                {
                    画矩形(24 + 复 * 8, 96, 8, 10, 0xFF2A6EF0);
                }
                否则
                {
                    画矩形(24 + 复 * 8, 96, 8, 10, 0xFF232B3E);
                }
                复 = 复 + 1;
            }
            画文字(24, 116, 宽一, 0xFFD0D0D8);
            画文字(24, 136, 宽二, 0xFFD0D0D8);
            画文字(240, 136, 宽三, 0xFFD0D0D8);

            // 中:对齐与截断
            画矩形(12, 186, 536, 150, 0xFF16161E);
            画文字(24, 194, "对齐(格数不够时补空格;方括号里就是库里真吐出来的串)", 0xFF9CC4FF);
            画文字(24, 220, 对一, 0xFFD0D0D8);
            画文字(24, 242, 对二, 0xFFD0D0D8);
            画文字(24, 264, 对三, 0xFFD0D0D8);
            画文字(24, 286, 对四, 0xFFD0D0D8);
            画文字(24, 308, 对五, 0xFFD0D0D8);

            // 下:数字
            画矩形(12, 348, 536, 120, 0xFF16161E);
            画文字(24, 356, "数字:进制 / 补零 / 千分位", 0xFF9CC4FF);
            画文字(24, 380, 数一, 0xFFD0D0D8);
            画文字(24, 400, 数二, 0xFFD0D0D8);
            画文字(24, 420, 数三, 0xFFD0D0D8);
            画文字(24, 440, 数四, 0xFFD0D0D8);

            // 下下:那张对得齐的表(底色先画、字后画)
            画矩形(12, 480, 536, 120, 0xFF16161E);
            画文字(24, 486, "对得齐的表:点一行看它是怎么拼的", 0xFF9CC4FF);
            复 = 0;
            当 (复 < 5)
            {
                如果 (复 == 亮)
                {
                    画矩形(20, 508 + 复 * 20, 520, 18, 0xFF232B3E);       // 这一帧扫到的那一行
                }
                如果 (复 == 选中)
                {
                    画矩形(20, 508 + 复 * 20, 520, 18, 0xFF2A6EF0);       // 点中的那一行
                }
                复 = 复 + 1;
            }
            画文字(24, 512, 表头2, 0xFF9CC4FF);
            画文字(24, 532, 行一, 0xFFD0D0D8);
            画文字(24, 552, 行二, 0xFFD0D0D8);
            画文字(24, 572, 行三, 0xFFD0D0D8);
            画文字(24, 592, 行四, 0xFFD0D0D8);

            // 状态行(点文 那一格直接当 `画文字` 的实参 —— H87 挡的是"当赋值右值")
            画文字(24, 606, 状态头, 0xFFE8E8F0);
            如果 (选中 >= 0)
            {
                画文字(24, 624, 点文[选中], 0xFF9CC4FF);
            }

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(240);                             // 让出一帧、别把 CPU 烧满(无头不真等)

            // 逐帧推进:底色沿表格五行走一圈
            亮 = 亮 + 1;
            如果 (亮 >= 5)
            {
                亮 = 0;
            }
        }
    }

    关闭窗口();
}

