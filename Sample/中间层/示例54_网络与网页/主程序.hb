// ============================================================
// 示例54_网络与网页:批 21 那两个库一起走一遍 + **带 UI**(第420批)
//   `Sample\库\网络.hb`(TCP 上"按条说话")· `Sample\库\网页.hb`(取网页 + 拆 HTML)
//
//   ① 网络那一半**自己连自己**:先在 `127.0.0.1:45517` 上 `开监听`,再 `连上`,
//      然后 `等连接` —— 两头都在同一个程序里,**不碰外网**(与 示例29 / 示例50 同一条口径)。
//   ② 按行说话:`发一行` / `收一行` 把"TCP 是字节流、没有消息边界"这件事收进库里 ——
//      客户那一头一口气发三行,服务那一头一行一行交出来(收到几行、怎么切,全由库管)。
//   ③ `收满` 按**字节数**收定长报文:2400 字节的汉字串会跨好几次接收,收回来一个字节不差。
//   ④ 网页那一半:地址拆开再拼回 → 拿一段**写死的** HTML 走 `取标题` / `去标签` / `取链接` /
//      `取属性` / **`取表格`** → `解应答` 把一条 HTTP 应答拆成状态码 / 头 / 正文。
//   ⑤ `取网页` 包着宿主能力 `取网址`(**一个新功能号都没开**)。这一篇不连外网,
//      所以只走**失败那一档**:主机端口没写进本工程 `.hbp` 的 `网址` 表 ⇒ 连都不连,
//      给假、状态码 `4294967295`。成的那一档由自检那一组对着一台本机回环小服务器真跑。
//
//   ============================================================
//   ⑥ **窗口那一半(第420批加,用户 2026-10-11 当班点名要的)**
//      上半:把 `网页.拆` 出来的三样摆出来 —— **标题 / 段落 / 链接 / 表格**(表格是
//            本批新补的 `取表格` 那一族抠的);
//      下半:**网络那几条逐条列出来** —— 通 = 绿方块 / 不通 = 红方块 +(有状态码的)状态码。
//
//      ⚠ 这一半同时治一条**排查之痛**(用户原话:"整族给 0,看不出来是哪一档"):
//        HB 程序能看见的只有"成 / 不成" —— 宿主内部那个状态码(`1` = 这个宿主没挂这一族、
//        `20` = 主机端口不在 `.hbp` 的 `网址` 表里、`17` = 连不上)**一律折成一个 `0` / 假**。
//        所以这里**不假装能分开**(分不开就如实说分不开):
//          · 窗口下半给的是"**第几条开始断**" —— 前几条绿、某一条起全红,断点一眼就看见;
//          · 真正分"哪一档"的是 **IDE 输出页那一行 `[白名单] …`**(`MainWindow.运行与调试器.cs`
//            的 `同步宿主白名单`):它把"这次交给子进程的网址白名单几条"打在输出页上 ——
//            空表 ⇒ 整族状态 1(没挂能力);表里有、可那一条不在 ⇒ 状态 20(不在白名单)。
//        ⇒ 排查口径:**先看窗口断在第几条,再看输出页那一行 `[白名单]`**。
//
//   ⚠ 全程 `测试输出` / `输出行`;末尾那一行 `// 预期输出` 逐行可对(不碰外网)。
//     窗口开在最后(不碰盘);无头那条路靠同目录 `事件脚本.txt` 的 `帧数 1` 投一个关窗请求,
//     所以**只画一帧**,期望输出里那一帧的绘制命令流是确定的(与 示例62_位图 同一套)。
// ============================================================
包含 "../../库/网络.hb"
包含 "../../库/网页.hb"

// 帮手:把换行换成 `!` —— 期望输出要写在一行里,带换行的正文直接打出来会多占好几段
// (示例52 那三栏表也用过这一手)。页面不到一千个字,按下标走这一趟够快。
方法 一行化(字符串 文本) 返回 字符串
{
    字符串 出文 = "";
    整数 长 = 文本.长度();
    整数 i = 0;
    当 (i < 长)
    {
        文字 字 = 文本[i];
        如果 (字 == 10)
        {
            拼接到(出文, '!');
        }
        否则
        {
            拼接到(出文, 字);
        }
        i = i + 1;
    }
    返回 出文;
}

// 帮手:取第 `第几` 段(`第几` 从 0 起;段 = 被换行切开的一段,**空段不算**)
//   窗口上半要一段一段地摆,而 `去标签` 给回来的是一整条带换行的文本。
//   与 `一行化` 同一手:按下标逐字走(页面就这么大,够快)。
方法 取段(字符串 文本, 整数 第几, 字符串 出 段) 返回 逻辑
{
    段 = "";
    整数 长 = 文本.长度();
    整数 i = 0;
    整数 号 = 0;
    字符串 当前 = "";
    当 (i <= 长)
    {
        逻辑 断 = 假;
        如果 (i >= 长)
        {
            断 = 真;
        }
        否则
        {
            文字 字 = 文本[i];
            如果 (字 == 10)
            {
                断 = 真;
            }
            否则
            {
                拼接到(当前, 字);
            }
        }
        如果 (断)
        {
            如果 (当前.长度() > 0)
            {
                如果 (号 == 第几)
                {
                    段 = 当前;
                    返回 真;
                }
                号 = 号 + 1;
            }
            当前 = "";
        }
        i = i + 1;
    }
    返回 假;
}

// 帮手:整数 → 十进制文字(状态码那一列要拼进 `画文字` 的串里,不带库外依赖)
方法 数文(整数 值) 返回 字符串
{
    字符串 出文 = "";
    如果 (值 < 0)
    {
        拼接到(出文, '-');
        值 = 0 - 值;
    }
    如果 (值 == 0)
    {
        拼接到(出文, '0');
        返回 出文;
    }
    字符 倒[12];
    整数 位 = 0;
    当 (值 > 0 && 位 < 12)
    {
        倒[位] = 48 + (值 % 10);
        值 = 值 / 10;
        位 = 位 + 1;
    }
    当 (位 > 0)
    {
        位 = 位 - 1;
        拼接到(出文, 倒[位]);
    }
    返回 出文;
}

// 帮手:窗口下半的一行 —— 左边一个方块(通 = 绿 / 不通 = 红),右边那一行文字。
// 来历(留档,不是禁令了):第420批在这儿量到一处语言缺陷 —— `拼接到` 在**方法里**把一段短串拼到
//   长串尾巴上、**正好把容量填满**那一次,末尾那个 `0` 会写到块外(池里的块挨着放),把下一块的
//   首字节踩成 NUL:`.长度()` 报 15、内容只有 14。当时按"文字一律在顶层拼好再传进来"绕开了;
//   **第445批已修**(容量检查留出末尾那一格;`中间层C.拼接到与格式化.cs` 那一处 + 自检
//   `H102 拼接 正好填满容量时…` 两条钉着)。这里**照旧不改**:顶层拼好传进来本身更清楚,
//   探针与读数留在 `工具\临时\h420\探针_六形状.hb`(修完那一趟六种形状逐条对得上)。
方法 画一行(整数 y, 逻辑 通, 字符串 行文)
{
    如果 (通)
    {
        画矩形(14, y, 10, 10, 0xFF2ECC40);
        画文字(32, y - 2, 行文, 0xFFD0D0D8);
    }
    否则
    {
        画矩形(14, y, 10, 10, 0xFFE04040);
        画文字(32, y - 2, 行文, 0xFFF0A8A8);
    }
}

字符串 本机 = "127.0.0.1";
整数 端口 = 45517;
字符串 双方 = 网络.地址文本(本机, 端口);

// ---------------- ① 自连自收:监听 → 连上 → 等连接 ----------------
//   次序不能反:`连上` 是**同步**的(连上了才回来),`等连接` 也是同步的(有人来才回来)——
//   先把两头都开起来,后面那几条才不会互相等。三层都成不成看返回值(句柄用 `引用` 交出来)。
整数 听 = 0;
逻辑 开成 = 网络.开监听(本机, 端口, 听);
整数 客 = 0;
逻辑 连成 = 假;
如果 (开成)
{
    连成 = 网络.连上(本机, 端口, 客);
}
整数 服 = 0;
逻辑 接成 = 假;
如果 (连成)
{
    接成 = 网络.等连接(听, 服);
}
测试输出(开成);
测试输出(连成);
测试输出(接成);
测试输出(听 > 0);
输出行(双方);

// ---------------- ② 主机名 → 地址 ----------------
字符串 地址串 = "";
逻辑 解成 = 网络.解析主机(本机, 地址串);
测试输出(解成);
输出行(地址串);

// 窗口下半要逐条列这几件事 ⇒ 每一条的**成败**都留一格(接成 为假时后面全是假,如实)
逻辑 收成 = 假;
逻辑 问成 = 假;
逻辑 满成 = 假;
逻辑 关成 = 假;
整数 关数 = 0;

如果 (接成)
{
    // ---------------- ③ 按行说话:一次发三行,一行一行收回来 ----------------
    //   三行是连着发的,对面那一次 `接收` 很可能一口气全收到(实测就是这样);
    //   库把"哪几个字节是一行"这件事管住,调用方只管一行一行拿。
    测试输出(网络.发一行(客, "第一行"));
    测试输出(网络.发一行(客, "第二行"));
    测试输出(网络.发一行(客, "第三行"));
    字符串 行 = "";
    逻辑 收一 = 网络.收一行(服, 行);
    测试输出(收一);
    输出行(行);
    逻辑 收二 = 网络.收一行(服, 行);
    测试输出(收二);
    输出行(行);
    逻辑 收三 = 网络.收一行(服, 行);
    测试输出(收三);
    输出行(行);
    如果 (收一 && 收二 && 收三)
    {
        收成 = 真;
    }

    // ---------------- ④ 一来一回(问答) ----------------
    //   ⚠ 同一个程序里当两头时,**不能让两边互相等**:`问答` 是"发一行 + 收一行"一体的,
    //     所以让服务那一头**先把回话放出去**,客户那一头再问 —— 问完当场就收到了。
    测试输出(网络.发一行(服, "在"));
    字符串 答 = "";
    测试输出(网络.问答(客, "在吗", 答));
    输出行(答);
    测试输出(网络.收一行(服, 行));
    输出行(行);
    如果 (答 == "在")
    {
        问成 = 真;
    }

    // ---------------- ⑤ 收满:按字节数收,汉字跨块也不坏 ----------------
    字符串 大段 = "";
    整数 k = 0;
    当 (k < 800)
    {
        拼接到(大段, "中");
        k = k + 1;
    }
    测试输出(大段.长度());                 // 800 个文字
    测试输出(发送(客, 大段));              // 2400 字节(一个汉字 3 字节)
    字符串 回大 = "";
    测试输出(网络.收满(服, 2400, 回大));
    测试输出(回大 == 大段);                // 逐字节同
    测试输出(回大.长度());                 // 800
    如果 (回大 == 大段)
    {
        满成 = 真;
    }

    // ---------------- ⑥ 计数与复位 ----------------
    测试输出(网络.收到字节数() > 2400);
    测试输出(网络.发出字节数() > 0);       // `发一行` 发出去的(用 `发送` 直接发的不算)
    网络.清掉();
    测试输出(网络.收到字节数());
    测试输出(网络.发出字节数());
}

// ---------------- ⑦ 收尾:三个句柄都关掉(关第二次给假,不会出事) ----------------
逻辑 关客 = 网络.关掉(客);
测试输出(关客);
逻辑 关服 = 网络.关掉(服);
测试输出(关服);
逻辑 关听 = 网络.关掉(听);
测试输出(关听);
如果 (关客 && 关服 && 关听)
{
    关成 = 真;
}
如果 (关客)
{
    关数 = 关数 + 1;
}
如果 (关服)
{
    关数 = 关数 + 1;
}
如果 (关听)
{
    关数 = 关数 + 1;
}

// ---------------- ⑧ 网页那一半之一:地址拆开、再拼回 ----------------
字符串 主机 = "";
整数 网页口 = 0;
字符串 路径 = "";
测试输出(网页.拆网址("https://例子.测试:8443/目录/页?键=1", 主机, 网页口, 路径));
输出行(主机);
测试输出(网页口);                              // 8443(写了的端口照写)
输出行(路径);
输出行(网页.拼网址(主机, 网页口, 路径));
输出行(网页.拼网址("纯主机.测试", 0, ""));     // 端口给 0 = 不写端口那一截
测试输出(网页.拆网址("https://纯主机.测试/", 主机, 网页口, 路径));
测试输出(网页口);                              // 443(https 的缺省端口)
测试输出(网页.是成功(200));
测试输出(网页.是成功(299));
测试输出(网页.是成功(300));

// ---------------- ⑨ 网页那一半之二:拆 HTML(一段写死的页面,不连外网) ----------------
//   这一批往页面里**加了一张表**:`取表格` 那一族(第420批新加的)要有个真页面来拆。
字符串 页 = "";
拼接到(页, "<html><head><title>批21 &amp; 网络 · 网页</title>");
拼接到(页, "<style>body{color:red}</style><script>var x=1;</script></head>");
拼接到(页, "<body><!-- 注释 --><h1>标题一</h1><p>第一段<br>换行</p>");
拼接到(页, "<a href=\"http://站点.example/一\">链接一</a>");
拼接到(页, "<table><tr><th>名字</th><th>年龄</th></tr>");
拼接到(页, "<tr><td>张三</td><td>28</td></tr>");
拼接到(页, "<tr><td><b>李四</b></td><td>30</td></tr></table>");
拼接到(页, "<img src=\"图.png\" alt=\"描述\" data-href=\"不算\"></body></html>");

字符串 标题 = "";
测试输出(网页.取标题(页, 标题));
输出行(标题);                                  // 实体已解开

字符串 纯文 = "";
测试输出(网页.去标签(页, 纯文));               // 样式 / 脚本 / 注释整段跳过
输出行(一行化(纯文));                          // `br` `p` `h1` `tr` 这些块级标签都变成了换行

整数 起 = 0;
整数 下 = 0;
字符串 一条 = "";
整数 链数 = 0;
字符串 链一 = "";
当 (网页.取链接(页, 起, 一条, 下))
{
    输出行(一条);
    链数 = 链数 + 1;
    如果 (链数 == 1)
    {
        链一 = 一条;
    }
    起 = 下;
    下 = 起;
}

字符串 值 = "";
测试输出(网页.取属性(页, 0, "src", 值, 下));
输出行(值);
测试输出(网页.取属性(页, 0, "alt", 值, 下));
输出行(值);
测试输出(网页.取属性(页, 0, "data-href", 值, 下));   // `href` 那一格与 `data-href` 各是各的
输出行(值);

// ---------------- ⑨之二 网页那一半之三:拆那一张表(第420批新加) ----------------
//   `取表格` 只认 `<tr>` 那一档当行、`<td>` / `<th>` 那一档当格;格里的内层标签整段跳过、
//   实体解开、两头空白去掉。⚠ **一次一张表**:格住在库的字节区里,下一个 `网页.*` 会把区换掉。
整数 表起 = 0;
测试输出(网页.取表格(页, 0, 表起));
输出行(网页.表行数());                         // 3(列头那一行也算一行)
输出行(网页.行格数(0));                        // 2
输出行(网页.行格数(1));                        // 2
输出行(网页.行格数(9));                        // 0(越界给 0)
字符串 格 = "";
测试输出(网页.格文本(0, 0, 格));
输出行(格);                                    // 名字
测试输出(网页.格文本(1, 0, 格));
输出行(格);                                    // 张三
测试输出(网页.格文本(2, 0, 格));
输出行(格);                                    // 李四(内层 `<b>` 整段跳过)
测试输出(网页.格文本(2, 1, 格));
输出行(格);                                    // 30
测试输出(网页.格文本(3, 0, 格));               // 0:行越界
整数 表二起 = 0;
测试输出(网页.取表格(页, 表起, 表二起));       // 0:后面没有第二张表了
输出行(网页.表行数());                         // 0(没抠出来就清空,不留上一次的)

// ---------------- ⑩ 网页那一半之四:拆一条 HTTP 应答 ----------------
字符串 答 = "";
拼接到(答, "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\n");
拼接到(答, "Content-Length: 6\r\n\r\n内容体");
整数 码 = 0;
字符串 头 = "";
字符串 正文 = "";
网页.解应答(答, 码, 头, 正文);
测试输出(码);                                  // 200
测试输出(头.长度());                           // 两行头(不含状态行与末尾那个空行)
测试输出(正文.长度());                         // 3

// ---------------- ⑪ 取网页:不碰外网,只走失败那一档 ----------------
//   `127.0.0.1:9` 没写进本工程 `.hbp` 的 `网址` 表 ⇒ 宿主**连都不连**(这是白名单那一关,
//   与"端口上有没有人听"无关)⇒ 给假、状态码 4294967295。
字符串 没取到 = "";
逻辑 取成 = 网页.取网页("http://127.0.0.1:9/", 没取到);
测试输出(取成);
整数 取码 = 网页.上次状态();
测试输出(取码);                                // -1(就是 4294967295)
测试输出(网页.是成功(取码));
输出行(没取到.长度());

// ============================================================
// ⑫ 窗口那一半:上半 = 拆出来的东西;下半 = 网络逐条(通 = 绿 / 不通 = 红)
// ============================================================
//   两件事各问各的:
//     · 上半那三样现在就在手上(`标题` / `纯文` / `链一` / 表格);
//     · ⚠ 表格要**当场重抠一遍** —— 上面那一串 `网页.*`(取属性 / 解应答 / 取网页)
//       已经把库的字节区换掉了,那几格的落点早就作废(这就是"一次一张表"那条口径)。
字符串 表行一 = "";
字符串 表行二 = "";
字符串 表行三 = "";
整数 表行数 = 0;
整数 表格数 = 0;
如果 (网页.取表格(页, 0, 表起))
{
    表行数 = 网页.表行数();
    表格数 = 网页.行格数(0);
    字符串 首格 = "";
    字符串 次格 = "";
    整数 行 = 0;
    当 (行 < 3 && 行 < 表行数)
    {
        字符串 拼行 = "";
        如果 (网页.格文本(行, 0, 首格))
        {
            拼接到(拼行, 首格);
        }
        如果 (网页.行格数(行) > 1)
        {
            拼接到(拼行, "  ·  ");              // ⚠ 分隔符不许用 `|`:那是 `// 预期输出:` 的段分隔符
            如果 (网页.格文本(行, 1, 次格))
            {
                拼接到(拼行, 次格);
            }
        }
        如果 (行 == 0)
        {
            表行一 = 拼行;
        }
        如果 (行 == 1)
        {
            表行二 = 拼行;
        }
        如果 (行 == 2)
        {
            表行三 = 拼行;
        }
        行 = 行 + 1;
    }
}

// 段落那三行:从 `去标签` 的纯文里一段一段取
字符串 段一 = "";
字符串 段二 = "";
字符串 段三 = "";
逻辑 有段一 = 取段(纯文, 0, 段一);
逻辑 有段二 = 取段(纯文, 1, 段二);
逻辑 有段三 = 取段(纯文, 2, 段三);

// 上半那几行文字先拼好(拼串只在窗口这一半用,一格一格复用同一批变量)
字符串 标题行文 = "标题:";
拼接到(标题行文, 标题);
字符串 段头文 = "段落:";
如果 (有段一)
{
    拼接到(段头文, 段一);
    如果 (有段二)
    {
        拼接到(段头文, " …");
    }
}
否则
{
    拼接到(段头文, "(一段都没拆出来)");
}
字符串 链头文 = "链接:";
字符串 链数文 = 数文(链数);
拼接到(链头文, 链数文);
拼接到(链头文, " 条 —— ");
拼接到(链头文, 链一);
字符串 表头文 = "表格:";
字符串 表行数文 = 数文(表行数);
字符串 表格数文 = 数文(表格数);
拼接到(表头文, 表行数文);
拼接到(表头文, " 行 × ");
拼接到(表头文, 表格数文);
拼接到(表头文, " 格(列头也算一行;格里的 `<b>` 整段跳过)");

// 下半那条小结:红了几条 —— "断在第几条"就是这一篇要给的那个回答
整数 红条数 = 0;
如果 (!开成)
{
    红条数 = 红条数 + 1;
}
如果 (!连成)
{
    红条数 = 红条数 + 1;
}
如果 (!接成)
{
    红条数 = 红条数 + 1;
}
如果 (!解成)
{
    红条数 = 红条数 + 1;
}
如果 (!收成)
{
    红条数 = 红条数 + 1;
}
如果 (!问成)
{
    红条数 = 红条数 + 1;
}
如果 (!满成)
{
    红条数 = 红条数 + 1;
}
如果 (!关成)
{
    红条数 = 红条数 + 1;
}
如果 (!取成)
{
    红条数 = 红条数 + 1;
}
字符串 小结文 = "网络:红 ";
字符串 红条数文 = 数文(红条数);
拼接到(小结文, 红条数文);
拼接到(小结文, " 条 / 共 9 条 —— 断在第几条一眼看得见;分「哪一档」看 IDE 输出页那一行 [白名单]");

// ---- 窗口下半那九行文字:**在顶层拼好**(见 `画一行` 头上那一段:方法里拼会吃一个 NUL) ----
//   可报的数只有三个是**稳的**:关了几个 / HTTP 状态码(取网页那条);
//   ⚠ **句柄号不许写进这一行**(第421批实测踩到):句柄 = `(表下标 << 16) | 版本`,
//   而**版本随"这一趟之前有没有别的用例清过句柄表"变** —— 同一个程序、同一条腿,
//   全量自检里跑出来是 `4194308/4259844/4325380`,单跑却是 `4194305/4259841/4325377`
//   ⇒ 写死句柄号的 `// 预期输出:` 是**天生脆**的(与账上 H93 那一族同一个病)。
//   所以这三行只报"**句柄有 / 无**"。
//   宿主内部的档位码(`1` 没挂能力 / `20` 不在白名单)HB 这一侧看不见,见文件头那一段。
字符串 行一 = "开监听 127.0.0.1:45517";
如果 (开成)
{
    拼接到(行一, "  通");
}
否则
{
    拼接到(行一, "  不通");
}
如果 (听 > 0)
{
    拼接到(行一, "  句柄有");
}
否则
{
    拼接到(行一, "  句柄无");
}

字符串 行二 = "连上(自己连自己)";
如果 (连成)
{
    拼接到(行二, "  通");
}
否则
{
    拼接到(行二, "  不通");
}
如果 (客 > 0)
{
    拼接到(行二, "  句柄有");
}
否则
{
    拼接到(行二, "  句柄无");
}

字符串 行三 = "等连接";
如果 (接成)
{
    拼接到(行三, "  通");
}
否则
{
    拼接到(行三, "  不通");
}
如果 (服 > 0)
{
    拼接到(行三, "  句柄有");
}
否则
{
    拼接到(行三, "  句柄无");
}

字符串 行四 = "解析主机 127.0.0.1";
如果 (解成)
{
    拼接到(行四, "  通");
}
否则
{
    拼接到(行四, "  不通");
}

字符串 行五 = "发一行 ×3 → 收一行 ×3";
如果 (收成)
{
    拼接到(行五, "  通");
}
否则
{
    拼接到(行五, "  不通");
}

字符串 行六 = "问答(一来一回)";
如果 (问成)
{
    拼接到(行六, "  通");
}
否则
{
    拼接到(行六, "  不通");
}

字符串 行七 = "收满 2400 字节(汉字跨块)";
如果 (满成)
{
    拼接到(行七, "  通");
}
否则
{
    拼接到(行七, "  不通");
}

字符串 行八 = "关掉三个句柄";
如果 (关成)
{
    拼接到(行八, "  通");
}
否则
{
    拼接到(行八, "  不通");
}
拼接到(行八, "  关了 ");
字符串 数八 = 数文(关数);
拼接到(行八, 数八);
拼接到(行八, " 个");

字符串 行九 = "取网页 http://127.0.0.1:9/(白名单外)";
如果 (取成)
{
    拼接到(行九, "  通");
}
否则
{
    拼接到(行九, "  不通");
}
拼接到(行九, "  状态码 ");
字符串 数九 = 数文(取码);
拼接到(行九, 数九);

如果 (打开窗口("示例54 网络与网页:拆出来的东西 + 网络逐条", 660, 560))
{
    整数 类型 = 0;
    整数 键码 = 0;
    整数 鼠标x = 0;
    整数 鼠标y = 0;
    逻辑 收手 = 假;
    整数 帧 = 0;
    当 (!收手)
    {
        // 收事件:关窗请求(类型 1)归程序管(照示例15 / 16 那一套)
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;
            }
        }
        如果 (!收手)
        {
            清屏(0xFF101018);

            // ---- 上半:网页那一半拆出来的东西 ----
            画文字(14, 12, "① 网页:取标题 / 去标签 / 取链接 / 取表格", 0xFF8A8A96);
            画文字(14, 36, 标题行文, 0xFFFFD050);
            画文字(14, 62, 段头文, 0xFFA0A0AC);
            画文字(30, 82, 段二, 0xFFD0D0D8);
            画文字(30, 98, 段三, 0xFFD0D0D8);
            画文字(14, 124, 链头文, 0xFF80C0FF);
            画文字(14, 150, 表头文, 0xFFA0A0AC);
            画文字(30, 170, 表行一, 0xFFB0E0B0);
            画文字(30, 186, 表行二, 0xFFB0E0B0);
            画文字(30, 202, 表行三, 0xFFB0E0B0);
            画矩形(14, 232, 630, 2, 0xFF303040);

            // ---- 下半:网络那几条逐条列(通 = 绿 / 不通 = 红 + 状态码) ----
            画文字(14, 248, "② 网络:逐条(通 = 绿 / 不通 = 红;有状态码的带上)", 0xFF8A8A96);
            画一行(272, 开成, 行一);
            画一行(296, 连成, 行二);
            画一行(320, 接成, 行三);
            画一行(344, 解成, 行四);
            画一行(368, 收成, 行五);
            画一行(392, 问成, 行六);
            画一行(416, 满成, 行七);
            画一行(440, 关成, 行八);
            画一行(464, 取成, 行九);
            画文字(14, 496, 小结文, 0xFFA0A0AC);
            画文字(14, 518, "跑法:窗口留到你自己关;无头那条路按同目录 事件脚本.txt 只画一帧。", 0xFF707078);

            测试输出(帧);
            刷新();
            帧 = 帧 + 1;
            等待(250);                                  // 不等待就是"一闪就没";无头不真等
        }
    }
    关闭窗口();
}

