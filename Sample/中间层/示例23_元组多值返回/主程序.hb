// ============================================================
// 示例23:元组的多值返回(H68-4 起)—— 一次带回两个结果
//
// 这个示例演示什么:方法能**一次返回几个值** —— `返回 [被除数 / 除数, 被除数 % 除数];`
// 重点看哪几处:
//   ① 写法:`返回 [式子, 式子];` —— 成员按顺序算出来,写进"调用方给的那块"
//      (与结构返回同一套:调用方拿一个变量接住,再按字段读)。
//   ② 调用方怎么用:`[整数, 整数] 商余 = 除法(17, 5);` 然后 `商余.项0` / `商余.项1`;
//      起了名字的元组(`[整数 商, 整数 余]`)就读 `.商` / `.余`。
//   ③ **不必先落一个局部变量**:`返回 [分, 秒 % 60];` 里两个成员直接就是式子
//      (参数运算 / 局部变量 / 分支里各返回一次 都行)。
//   ④ 元组值还能写在这两处(与 ① 共用同一段"按成员填块"的代码):
//      声明初值 `[整数, 整数] 初值对 = [3 + 4, 6 * 2];`、整体赋值 `表[0] = [1 + 1, 2 * 2];`
//      (左边带运行期下标也认:`表[i] = [表[i - 1].项0 + 1, …];`)。
//   ⑤ 没有拆包(H68-3 起就不做):要拆就一个成员一个成员取
//      (`整数 商 = 商余.项0;`),或者用带名字的元组写得明白些。
//
// 关键字中英等价(整数=int、如果=if、循环=for),标识符随便起。
// 本示例不需要任何库,单独就能编译运行。
//
//   ============================================================
//   怎么看(带 UI;H82 批 3)—— 这一份是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例23 元组多值返回`。
//       画面分两半:左边是**函数那一头**(它算的是什么、一次交出哪几个值),
//       右边是**调用点这一头**(这几个值分别落进了哪几个变量)——
//       同号的两格是一对。**点左边某一行** ⇒ 右边对应的那一格同时亮(底色先画、字后画),
//       底下两行说"第几个返回值 → 哪个变量"。每刷新一帧往前走一小步,
//       按**先算 → 再返回 → 再落变量**三步演(一步换一处亮,走完一行换下一行)。
//       窗口**一直转到你自己关掉**(点标题栏的叉)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、
//       也不用等人去关 —— 旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),
//       第 20 帧宿主投一个关窗请求;于是"窗口该画什么、点一下亮哪一对"都能逐行对出来。
//     · **顺序**:上面那些纯计算与 `测试输出` **一个字没动**;带 UI 的这一半接在
//       最后一条语句后面、`停止` 之前 —— 于是这一份的期望输出里,"数"还是那些数,
//       窗口那几行排在后头(没有图形能力的宿主给 假 ⇒ 一个字都不多打)。
//   ============================================================

// ① 两个结果一次带回:商与余数
方法 除法(整数 被除数, 整数 除数) 返回 [整数, 整数]
{
    返回 [被除数 / 除数, 被除数 % 除数];
}

// ③ 成员式子可以是局部变量的运算;分支里各返回一次也认
方法 换算(整数 秒) 返回 [整数, 整数]
{
    整数 分 = 秒 / 60;
    返回 [分, 秒 % 60];
}

方法 大在前(整数 左, 整数 右) 返回 [整数, 整数]
{
    如果 (左 > 右)
    {
        返回 [左, 右];
    }
    返回 [右, 左];
}

// ② 调用方:用变量接住,再按字段读
[整数, 整数] 商余 = 除法(17, 5);
测试输出(商余.项0);                    // 3
测试输出(商余.项1);                    // 2

[整数 商, 整数 余] 带名 = 除法(9, 4);
测试输出(带名.商);                     // 2
测试输出(带名.余);                     // 1
整数 商 = 带名.商;
整数 余 = 带名.余;
测试输出(商 * 10 + 余);                // 21

// ③ 成员是式子 / 参数运算 / 分支里的返回
[整数, 整数] 时分 = 换算(185);
测试输出(时分.项0);                    // 3
测试输出(时分.项1);                    // 5
[整数, 整数] 对 = 大在前(3, 8);
测试输出(对.项0);                      // 8
测试输出(对.项1);                      // 3

// ④ 元组值也认在声明初值与整体赋值这两处(数组元素按常量下标整体赋值也认;
//    运行期下标 `表[i] = [式子, 式子];` 还不认,那里就照常一个成员一个成员写)
[整数, 整数] 初值对 = [3 + 4, 6 * 2];
测试输出(初值对.项0);                      // 7
测试输出(初值对.项1);                      // 12

[整数, 整数] 表[3];
表[0] = [1 + 1, 2 * 2];
循环 (var i = 1; i < 3; i = i + 1)
{
    表[i].项0 = 表[i - 1].项0 + 1;
    表[i].项1 = 表[i - 1].项1 + 10;
}
测试输出(表[2].项0);                   // 4
测试输出(表[2].项1);                   // 24

// ============================================================
// 带 UI 的那一半(H82 批 3):左边"函数那一头" ⇔ 右边"调用点这一头"
//
//   上面那些纯计算与全部 `测试输出` **一个字没动**;这一块接在最后一条语句之后、
//   `停止` 之前 —— 只有在真开得了窗口的宿主上才跑(没有图形能力的宿主给 假 ⇒
//   一个字都不多打,上面那 13 个数还是那 13 个数)。
//
//   窗口里演的是上面那四次多值返回**跑完之后的样子**(6 行 = 6 个返回值;
//   数就是上面 `测试输出` 打出来的那些数):
//     · **左半**是函数那一头:一行一个返回值,三行写着
//       "函数怎么调的(算了什么)/ 算出来的两个结果 / `返回 [左, 右];` 交出哪两个值"。
//     · **右半**是调用点这一头:同一行写着"哪个变量接住 / 起了名读 `.商` `.余`、
//       没起名读 `.项0` `.项1` / 最后取出来的那个数"—— 同号的两格是一对。
//     · **点左边某一行** ⇒ 右边那一格同时亮(两格的底色**先画、字后画**),
//       底下两行说"第几个返回值 → 哪个变量";蓝底就停在点中的那一对上。
//     · **逐帧推进**:每 `刷新()` 一帧走一小步,按 **先算 → 再返回 → 再落变量** 三步演
//       (第 0 步亮左边那格的"算出来"那一行、第 1 步亮两格的"返回"那一行、
//        第 2 步亮右边那格的"落进变量"那一行),走完一行换下一行,6 行走满 18 帧。
//     · 窗口一直转到用户自己关(点标题栏的叉);自检与命令行靠同目录 `事件脚本.txt`
//       (写死的输入:第 3 / 9 / 15 帧各投一次点击)跑满 20 帧后由宿主投关窗请求收手。
//
//   ⚠ 主循环里**一条字符串都不现拼**:这一屏要画的字全在开窗之前拼好(存进下面那几个
//     `字符串 数组`),每帧只 `画文字(…, 数组[下标], …)`。每帧现拼 / 每帧调一个返回字符串的
//     函数,都会把编译器那个池吃光(见 `Sample\说明.md` 那张坑表)。
//   ⚠ 摆位与命中测试**用的是同一组数**(`板左` / `板宽` / `行顶` / `行距`),要挪地方只改这几行。
//   ⚠ `格式化` 的占位符只认 `{0}`(写成 `%d` 不报错、原样返回 `"%d"`)—— 下面一律 `{0}`。
// ============================================================

包含 "../../库/string.hb"        // `格式化("{0}", 值)` 要用的那个 `转字符串` 在库里(放文件头,与 示例07 一样)

// ---- 窗口自己要记住的那几格(写在顶层,不藏在嵌套里)----
整数 类型 = 0;                   // 图形那一套要的四个出参(照 示例14 / 15 / 16)
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                    // 这一帧那"点一下"落在哪儿
整数 点y = 0;
整数 选中 = 0;                   // 点中的那一行(0~5),底下两行说的是它
整数 高亮 = 0;                   // 这一帧演到第几行(每三步换一行)
整数 段 = 0;                     // 这一帧演到三步里的哪一步:0 先算 / 1 再返回 / 2 再落变量
逻辑 有一下 = 假;                // 这一帧收到过"点一下"(按下 + 抬起)没有

// ---- 摆位:画图与命中测试共用这几行(窗宽 560 ⇒ 一行最多约 33 格,格子里的字都短)----
整数 窗宽 = 560;
整数 窗高 = 640;
整数 板左 = 12;                  // 左板(函数那一头)
整数 板宽 = 272;
整数 板右 = 286;                 // 右板(调用点这一头)
整数 行顶 = 118;                 // 第一行的顶边
整数 行高 = 56;                  // 一格多高(三行字:6 / 22 / 38)
整数 行距 = 60;                  // 一行的间距(留 4 像素空当;命中测试的除数)
整数 行数 = 6;

// ---- 这一屏要画的字:全部在**开窗之前**拼好 ----
// ⚠ `字符串` 数组**不能在给定初值时填字符串**,只能声明后一条条填(照那张坑表)。
字符串 左调用[6];                 // 左板第 1 行:函数怎么调的(算了什么)
字符串 左算式[6];                 // 左板第 2 行:算出来的两个结果
字符串 左返回[6];                 // 左板第 3 行:`返回 [...];` 交出哪两个值
字符串 右接住[6];                 // 右板第 1 行:哪个变量接住
字符串 右读法[6];                 // 右板第 2 行:按哪个字段读
字符串 右取出[6];                 // 右板第 3 行:取出来的那个数
字符串 左返回亮[6];               // 左上"返回"那一行正演到时(前面加一支箭头)
字符串 右读法亮[6];
字符串 右取出亮[6];
字符串 详一[6];                 // 底下第 1 行:第几个返回值 → 哪个变量
字符串 详二[6];                 // 底下第 2 行:这一对的来历

// ---- 六行的文字:一律字面量(字符串赋值右边只认"字面量 / 另一个串 / 一个返回串的调用")----
左调用[0] = "除法(17, 5)";
左算式[0] = "算出来:17 / 5 = 3,17 % 5 = 2";
左返回[0] = "返回 [3, 2];";
右接住[0] = "接住:商余";
右读法[0] = "读 .项0 / .项1(没起名)";
右取出[0] = "取出来:3 与 2";
详一[0] = "第 1 个返回值 3 → 商余.项0;第 2 个返回值 2 → 商余.项1";
详二[0] = "上面 ② 那两行:测试输出(商余.项0) 得 3、测试输出(商余.项1) 得 2";

左调用[1] = "除法(9, 4)";
左算式[1] = "算出来:9 / 4 = 2,9 % 4 = 1";
左返回[1] = "返回 [2, 1];";
右接住[1] = "接住:带名";
右读法[1] = "读 .商 / .余(起了名)";
右取出[1] = "取出来:2 与 1";
详一[1] = "第 1 个返回值 2 → 带名.商;第 2 个返回值 1 → 带名.余";
详二[1] = "起了名就能读 .商 / .余 —— 与 .项0 / .项1 说的是同一份";

左调用[2] = "换算(185)";
左算式[2] = "分 = 185 / 60 = 3;秒 = 185 % 60 = 5";
左返回[2] = "返回 [分, 秒 % 60];";
右接住[2] = "接住:时分";
右读法[2] = "读 .项0 / .项1";
右取出[2] = "取出来:3 与 5";
详一[2] = "第 1 个返回值 3 → 时分.项0;第 2 个返回值 5 → 时分.项1";
详二[2] = "成员直接就是式子:一个局部变量 + 一个参数运算,不必先落局部";

左调用[3] = "大在前(3, 8)";
左算式[3] = "比一比:3 > 8 不成立";
左返回[3] = "返回 [右, 左];(另一支)";
右接住[3] = "接住:对";
右读法[3] = "读 .项0 / .项1";
右取出[3] = "取出来:8 与 3";
详一[3] = "第 1 个返回值 8 → 对.项0;第 2 个返回值 3 → 对.项1";
详二[3] = "分支里各返回一次也认:两个 branch 都写 `返回 [...];`";

左调用[4] = "声明初值(不走函数)";
左算式[4] = "两个成员各是一个式子:3 + 4、6 * 2";
左返回[4] = "[整数, 整数] 初值对 = [3 + 4, 6 * 2];";
右接住[4] = "接住:初值对";
右读法[4] = "读 .项0 / .项1";
右取出[4] = "取出来:7 与 12";
详一[4] = "第 1 个成员 7 → 初值对.项0;第 2 个成员 12 → 初值对.项1";
详二[4] = "④ 声明初值也认元组值 —— 与 `返回 [...]` 共用同一段按成员填块的代码";

左调用[5] = "整体赋值 表[0] = [1 + 1, 2 * 2];";
左算式[5] = "表[0] 两个成员:1 + 1 = 2、2 * 2 = 4";
左返回[5] = "再看表[2]:4 与 24(循环填的)";
右接住[5] = "落在哪里:表[0] / 表[2]";
右读法[5] = "读 表[i].项0 / .项1";
右取出[5] = "取出来:表[2] 是 4 与 24";
详一[5] = "第 1 个成员 2 → 表[0].项0;第 2 个成员 4 → 表[0].项1";
详二[5] = "整体赋值左边带常量下标也认;运行期下标那一版就一个成员一个成员写";

// ---- 那四个数:开窗前用 `格式化("{0}", 值)` 拼一遍,主循环只管画 ----
// ⚠ 主循环里写 `画文字(x, y, 转字符串(值), 色)` 就是"每帧漏一块池"⇒ 值也要先转成文字。
// ⚠ 一个函数里别堆超过 ~2 个 `格式化(...)`(帧只有 96 字节,一个调用要一份临时槽);
//   这是**顶层**那一段,只放了这四个(照 示例02 的口径)。
字符串 文商 = "";
字符串 文余 = "";
字符串 文分 = "";
字符串 文秒 = "";
文商 = 格式化("{0}", 商余.项0);
文余 = 格式化("{0}", 商余.项1);
文分 = 格式化("{0}", 时分.项0);
文秒 = 格式化("{0}", 时分.项1);

// 右上第 2 行那格"正演到"的版本(前面加一支箭头 ⇒ 一眼看出这一帧在演哪一步)
整数 填 = 0;
当 (填 < 6)
{
    左返回亮[填] = 左返回[填];
    拼接到(左返回亮[填], "  ←");
    右读法亮[填] = 右读法[填];
    拼接到(右读法亮[填], "  ←");
    右取出亮[填] = 右取出[填];
    拼接到(右取出亮[填], "  ←");
    填 = 填 + 1;
}

// ---- 开窗:下面那一层每帧只画(一条字符串都不再拼)----
逻辑 开着 = 打开窗口("示例23 元组多值返回", 窗宽, 窗高);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算它:六行从 `行顶` 起、每行 `行距` 像素(左板 / 右板同一套口径);
        // 点哪一半都算点这一行 —— 左边点一格,右边同一格跟着亮。
        // ⚠ 这一步**单独摆在这一层**(浅一层就稳):命中测试与赋值别塞进上面那串嵌套里。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点y >= 行顶 && 点y < 行顶 + 行数 * 行距)
            {
                选中 = (点y - 行顶) / 行距;
                高亮 = 选中;
                段 = 0;
            }
        }

        如果 (!收手)
        {
        // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼)----
        清屏(0xFF101018);
        画矩形(12, 12, 窗宽 - 24, 40, 0xFF2A3550);
        画文字(24, 16, "示例23 元组多值返回:一次带回两个结果", 0xFFE8E8F0);
        画文字(24, 34, "左边函数那一头,右边调用点这一头;点左边一行,右边同号一起亮", 0xFFB0B0B8);
        画矩形(板左, 78, 板宽, 26, 0xFF232B3E);
        画文字(20, 84, "函数那一头:算了什么、交出哪几个值", 0xFF9CC4FF);
        画矩形(板右, 78, 板宽, 26, 0xFF232B3E);
        画文字(294, 84, "调用点这一头:值落进了哪几个变量", 0xFF9CC4FF);

        // ⚠ 底色一律画在文字**之前**:`画矩形` 是不透明实心,画在文字后面会把那一格的字盖掉。
        //   一块整板打底 → "鼠标压着的那一行" → 这一帧演到的两格(先算 / 再返回 / 再落变量)。
        画矩形(板左, 行顶, 板宽, 行数 * 行距, 0xFF16161E);
        画矩形(板右, 行顶, 板宽, 行数 * 行距, 0xFF16161E);
        如果 (鼠标y >= 行顶 && 鼠标y < 行顶 + 行数 * 行距)
        {
            整数 悬 = (鼠标y - 行顶) / 行距;
            如果 (悬 != 高亮)
             {
                画矩形(板左, 行顶 + 悬 * 行距, 板宽, 行高, 0xFF232B3E);
                画矩形(板右, 行顶 + 悬 * 行距, 板宽, 行高, 0xFF232B3E);
            }
        }
        // 三步:0 先算(左板绿) / 1 再返回(两板都蓝) / 2 再落变量(右板紫)
        如果 (段 == 0)
        {
            画矩形(板左, 行顶 + 高亮 * 行距, 板宽, 行高, 0xFF1E4A2E);
        }
        如果 (段 == 1)
        {
            画矩形(板左, 行顶 + 高亮 * 行距, 板宽, 行高, 0xFF2A6EF0);
            画矩形(板右, 行顶 + 高亮 * 行距, 板宽, 行高, 0xFF2A6EF0);
        }
        如果 (段 == 2)
        {
            画矩形(板右, 行顶 + 高亮 * 行距, 板宽, 行高, 0xFF5A3E9E);
        }

        // 六行:左板三行 / 右板三行(演到的那一行换成"带箭头"的版本)
        整数 r = 0;
        当 (r < 6)
        {
            整数 行y = 行顶 + r * 行距 + 6;
            画文字(20, 行y, 左调用[r], 0xFFD0E8FF);
            画文字(20, 行y + 16, 左算式[r], 0xFFE8E8F0);
            如果 (r == 高亮 && 段 == 1)
            {
                画文字(20, 行y + 32, 左返回亮[r], 0xFFFFFFFF);
            }
            如果 (!(r == 高亮 && 段 == 1))
            {
                画文字(20, 行y + 32, 左返回[r], 0xFF9CC4FF);
            }
            画文字(294, 行y, 右接住[r], 0xFFD0E8FF);
            如果 (r == 高亮 && 段 == 1)
            {
                画文字(294, 行y + 16, 右读法亮[r], 0xFFFFFFFF);
            }
            如果 (!(r == 高亮 && 段 == 1))
            {
                画文字(294, 行y + 16, 右读法[r], 0xFFB0B0B8);
            }
            如果 (r == 高亮 && 段 == 2)
            {
                画文字(294, 行y + 32, 右取出亮[r], 0xFFFFFFFF);
            }
            如果 (!(r == 高亮 && 段 == 2))
            {
                画文字(294, 行y + 32, 右取出[r], 0xFFE8E8F0);
            }
            r = r + 1;
        }

        // 底下两行:点中的那一对"第几个返回值 → 哪个变量" + 这一对的来历
        画线(12, 490, 548, 490, 0xFF3C3C46);
        画矩形(12, 500, 536, 60, 0xFF16161E);
        画文字(20, 506, 详一[选中], 0xFFE8E8F0);
        画文字(20, 530, 详二[选中], 0xFFD0D0D8);

        // 三步演到哪儿了(这一行说的是"这一帧哪一处亮着")
        如果 (段 == 0)
        {
            画文字(20, 578, "这一帧:先算 —— 函数把两个结果算出来(左板绿底那一行)", 0xFF8A8A96);
        }
        如果 (段 == 1)
        {
            画文字(20, 578, "这一帧:再返回 —— 一块带两个值的元组交回调用方(两板都亮)", 0xFF8A8A96);
        }
        如果 (段 == 2)
        {
            画文字(20, 578, "这一帧:再落变量 —— 两个值分别落进右边那两个变量(右板紫底)", 0xFF8A8A96);
        }
        画文字(20, 606, "每进一帧走一小步(先算 → 再返回 → 再落变量);点一行就停在那一对上", 0xFF8A8A96);

        // ---- 刷新:不调用就一直不显示 ----
        刷新();

        等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)

        // 逐帧推进:三步走完一行,再换下一行;六行走满绕回第一行
        段 = 段 + 1;
        如果 (段 >= 3)
        {
            段 = 0;
            高亮 = 高亮 + 1;
            如果 (高亮 >= 行数)
            {
                高亮 = 0;
            }
        }
        }
    }

    关闭窗口();
}

停止

