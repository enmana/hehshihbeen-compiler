// 示例50_页面调试:WebSocket 客户端 / 服务端 + CDP 那一层(自己连自己,不碰外网)
//
//   这一篇要证的事:**HB 自己就是一个完整的 WebSocket 端点** ——
//   既能当客户端(连出去、发掩码帧),也能当服务端(收请求、回 101、发不掩码帧)。
//
//   为什么自己连自己(与 `示例29_网络` 同一个理由):不碰外网、不需要真有浏览器在跑,
//   自检能一条一条对账。真正的用法是连一台 Chromium 系调试口(Electron 客户端 / Chrome),
//   那一层见 `库\页面调试.hb`;这一篇只把**协议本身**走一遍。
//
//   重点看哪几处:【2】两边看到的握手键是同一个、【3】客户端发出去的帧**首字节 0x81**
//   且**掩码位是 1**(0x89 = 0x80|9,9 是"你好,HB" 的 UTF-8 字节数)、
//   【4】服务端回的帧**不掩码**(RFC 6455 明令)而客户端照样解得开。

包含 "../../库/WebSocket.hb"

字符串 本机 = "127.0.0.1";
整数 端口 = 45317;

// ---------------- ① 监听 → 连到 → 接受(与示例29 同一套:先把两头都开起来) ----------------
整数 听 = 0;
听 = 监听(本机, 端口, 听);
输出行(听 > 0);
整数 客 = 0;
客 = 连到(本机, 端口, 客);
输出行(客 > 0);
整数 服 = 0;
服 = 接受(听, 服);
输出行(服 > 0);

// ---------------- ② 升级:客户端发请求 → 服务端回 101 → 客户端验 ----------------
//   注意次序:**发**那一半要排在对面**收**之前(`发送` 不阻塞、`接收` 会等),
//   所以这里拆成四个半句走 —— 一体式的 `WebSocket.握手` 是给"对面真有服务端"用的。
字符串 键 = "";
输出行(WebSocket.发升级请求(客, 本机, 端口, "/devtools/page/演示", 键));
输出行(键.长度());                                  // 16 字节随机 → Base64 = 24 个字符
字符串 服键 = "";
输出行(WebSocket.读升级键(服, 服键));
输出行(服键 == 键);                                  // 真:两头看到的是同一个键
输出行(WebSocket.回升级(服, 服键));                  // 算 Accept + 回 101
字符串 说明 = "";
输出行(WebSocket.验应答(客, 键, 说明));
输出行(说明);                                        // 升级成功

// ---------------- ③ 客户端发一帧文本,服务端收**原始字节**验帧头 ----------------
//   "你好,HB" 的 UTF-8:你(3) 好(3) ,(1) H(1) B(1) = 9 字节
//   客户端帧 = 2 字节头 + 4 字节掩码 + 9 字节载荷 = 15 字节
输出行(WebSocket.发文本(客, "你好,HB"));
地址 帧块 = 申请(512);
整数 帧长 = 接收块(服, 帧块, 512);
输出行(帧长);                                        // 15
输出行(取字(帧块, 0) & 255);                         // 129 = 0x81(FIN + 文本)
输出行((取字(帧块, 0) >> 8) & 255);                  // 137 = 0x89(掩码位 + 长度 9)

// ---------------- ④ 服务端回一帧(**不掩码**),客户端解成文字 ----------------
输出行(WebSocket.回文本(服, "收到啦"));
字符串 回话 = "";
输出行(WebSocket.收文本(客, 帧块, 512, 回话));
输出行(回话);                                        // 收到啦

// ---------------- ⑤ 收尾:两个句柄 + 一个监听全关掉 ----------------
释放(帧块);
输出行(WebSocket.关掉(客));
输出行(WebSocket.关掉(服));
输出行(关闭(听));
停止

// 预期输出: 1|1|1|1|24|1|1|1|1|升级成功|1|15|129|137|1|1|收到啦|1|1|0
