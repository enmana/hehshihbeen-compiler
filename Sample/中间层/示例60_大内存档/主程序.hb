// ============================================================
// 示例60_大内存档(通用化第2批:可选内存模型 + A 路寻址)
//
//   工程文件里写一行 `"内存": "4MB"` —— 这一份演示"运行内存放大之后程序怎么写":
//     ① **变量落在 1MB 之外**:四个 65536 格的定长数组把变量槽顶过 1MB,
//        后面那些变量(`尾` / `i` / `和`)的地址就在 1MB 以上 ——
//        编译器给这种访问自动改走「**载入高位 + 或立即数** 拼地址 + **间接寻址**」那一档;
//     ② **池长过 1MB**:十万个整数的动态列表,数据块长在字符串池里
//        (池一开始 32KB,不够自己长大 —— 这一份要它长到 1MB 以上)。
//
//   两条口径(都写在帮助《工程文件》那一节里):
//     · **不写 `内存` = 1MB**:那条路一个字没变 —— 同一份源码在 1MB 档下
//       连"变量槽越过 1MB"都装不下(会当场报"内存不够"),所以这一份必须写 4MB;
//     · **代价是代码大一点**:一条直接寻址在大地址上摊成 2~5 条(`4MB` 档的代码段比 `1MB` 档大),
//       换来的是"能把 4MB 用满"。小内存的程序不写 `内存` 就一点代价都没有。
// ============================================================

// ---------- ① 变量槽越过 1MB:四个 65536 格的数组 = 1MB ----------
整数 填a[65536];
整数 填b[65536];
整数 填c[65536];
整数 填d[65536];

整数 尾 = 0;              // 从这一行起,变量的地址已经在 1MB 之外
整数 i = 0;
当 (i < 5)
 {
    尾 = 尾 + i;
    i = i + 1;
}
输出行(尾);              // 10

填a[0] = 7;
填d[65535] = 9;          // 数组最后那一格也落在 1MB 之外
输出行(填a[0]);          // 7
输出行(填d[65535]);      // 9

// ---------- ② 池长过 1MB:十万个整数的动态列表 ----------
整数 大表[];
i = 0;
当 (i < 100000)
 {
    大表.添加(i % 100);
    i = i + 1;
}
输出行(大表.长度());      // 100000

整数 和 = 0;
i = 0;
当 (i < 100000)
 {
    和 = 和 + 大表[i];
    i = i + 1;
}
输出行(和);               // 4950000
输出行(大表[99999]);      // 99

停止

// 预期输出: 10|7|9|100000|4950000|99
