// 示例27_流:G3 流式读写的七个函数(开读流 / 读一块 / 定位 / 关读流 / 开写流 / 写一块 / 关写流)
//
// 为什么要有它们:内存只有 1MB,而 `读文件` / `写文件` 是"整份进出"的 —— 大文件只有
// "开一条流、要几块读几块"这一条路。这一篇只碰标准工程目录里的 `数据/`(跑完自己清干净)。

字符串 目录 = "数据";
字符串 路径 = "数据/流示例.txt";

输出行(建目录(目录));

// ---------------- ① 开写流:一块一块写,写途中用 `定位` 回过头去覆盖 ----------------
// 注意:句柄变量**要先声明**(`整数 写句柄 = 0;`),再写 `写句柄 = 打开写流(…, 写句柄);`
//       —— 一行里"声明 + 拿它自己当实参"是不行的(那一句还没生效)。
整数 写句柄 = 0;
写句柄 = 打开写流(路径, 写句柄);                 // 文件不存在就新建;已存在就从头写起
输出行(写句柄 > 0);                              // 句柄是个正整数(用不了给 -1)
输出行(写一块(写句柄, "0123456789", 0));        // 返回真写下去的字节数(0 = 整段都写)
输出行(写一块(写句柄, "AB", 2));                // 只写前 2 个字节
输出行(定位(写句柄, 6));                         // 挪回第 6 个字节
输出行(写一块(写句柄, "cd", 0));                // 从那儿覆盖着写
输出行(关写流(写句柄));                          // **先冲刷到盘上**再关;0 = 成功
输出行(关写流(写句柄));                          // 同一个句柄再关一次:状态码 22(句柄作废)

// ---------------- ② 开读流:分块读完,块长由返回值说了算 ----------------
字符串 全文 = "";
如果 (读文件(路径, 全文, 4096))
{
    输出行(全文);                                // ① 写完的盘上内容
    输出行(全文.长度());
}

整数 读句柄 = 0;
读句柄 = 打开读流(路径, 读句柄);
字符串 块 = "";
整数 块长 = 0;
// 分块读完:一次要 1 个字节,读到 0 为止(这样"轮数"与"每轮几个"两边必然一致 ——
// `读一块` 的上限是"最多读多少",一次要多大由你定;一次要 1 个字节最省心也最好对账)
整数 轮数 = 0;
字符串 拼起来 = "";
块长 = 读一块(读句柄, 块, 1);
当 (块长 > 0)
{
    拼接到(拼起来, 块);                          // 把这一块接到一起,验证分块读的结果与整读一致
    轮数 = 轮数 + 1;
    块长 = 读一块(读句柄, 块, 1);
}
输出行(轮数);                                    // 12 个字节约 1 字节一块 = 12 轮
输出行(块长);                                    // 循环退出时那个返回值就是 0(到末尾)
输出行(块.长度());                               // 到末尾时那个字符串变量被清空
输出行(拼起来 == 全文);                          // 分块拼起来 == 一次读全

// ---------------- ③ 读流也能定位:跳过前 4 个字节,只读后半段 ----------------
输出行(定位(读句柄, 4));
块长 = 读一块(读句柄, 块, 4096);
输出行(块长);
输出行(块);
输出行(关读流(读句柄));

// ---------------- ④ 流也可以是"库"的输入:把 `Sample\库\排序.hb` 当一份数据一段段数 ----------------
字符串 库路径 = "Sample/库/排序.hb";
整数 库句柄 = 0;
库句柄 = 打开读流(库路径, 库句柄);
整数 总字节 = 0;
字符串 库块 = "";
整数 库块长 = 读一块(库句柄, 库块, 512);
当 (库块长 > 0)
{
    总字节 = 总字节 + 库块长;                    // 按**字节**数:`.长度()` 数的是文字,这里要用返回值
    库块长 = 读一块(库句柄, 库块, 512);
}
输出行(关读流(库句柄));
输出行(总字节 > 1000);                           // 库文件有一千多字节
输出行(总字节);                                  // ⚠ 这个数 = `Sample\库\排序.hb` 的**字节数**:库文件一改,上面那行预期输出也得跟着改

// ---------------- ⑤ 失败路:开一个不存在的文件、拿作废的句柄读 ----------------
整数 空句柄 = 0;
空句柄 = 打开读流("数据/没有这个.txt", 空句柄);
输出行(空句柄);                                  // -1(无符号十进制打出来是 4294967295)
输出行(读一块(空句柄, 块, 16));                  // -1

// ---------------- 收尾:把这一篇自己造的文件清掉(标准工程跑完不留垃圾) ----------------
输出行(关读流(读句柄) == 22);                    // 上面已经关过:再来一次还是"句柄不认"
输出行(删文件(路径));
输出行(删目录(目录));

// 预期输出: 1|1|10|2|0|2|0|22|012345cd89AB|12|12|0|0|1|0|8|45cd89AB|0|0|1|3842|-1|4294967295|1|1|1
