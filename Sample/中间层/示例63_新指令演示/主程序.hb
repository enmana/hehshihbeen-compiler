// ============================================================
// 示例63_新指令演示:ISA 扩容那 27 条里"真用上"的那一批
//
//   这一篇演两样东西(2026-10-13):
//     ① **14 个指令内建**(语言面新加的名字,与 `读文件` / `画文字` 同一档,中英可整体切换)——
//        `取较大` `取较小` `向下取整` `搬符号`(浮点四条)/ `数一位` `前导零` `尾随零` /
//        `循环左移` `循环右移` `字节交换` `取字节` `取整数绝对值` / `双字乘高` `双字乘加`;
//     ② **三条形状识别**(不写名字也认得出):`(值 << n) | (值 >> (32 - n))` → 一条 `循环左移`、
//        四段字节搬运 → 一条 `字节交换`、`左 关系 右 ? 左 : 右` → 一条 `条件移动`。
//
//   为什么要有内建这一档:指令进了 ISA **不等于**库能用上 —— 内联汇编只认真寄存器名,
//   而库函数的参数在帧里(`取字帧` 的偏移由编译器算、源码层拿不到)⇒ 没有名字,库只能自己写循环。
//   `Sample\库\位.hb` 的 `数一位` / `前导零` / `尾随零` 以前就是 32 轮软件循环,现在各一条指令。
//
//   怎么看:窗口里一行一条,把算出来的值列出来;控制台那几行是 `测试输出`,自检逐行对。
//   窗口停留到用户自己关窗(收到 类型 == 1);无头那条路由事件脚本的 `帧数 1` 投关窗请求。
//   末尾 `// 预期输出:` 是现场生成的:
//     hbcc -p Sample\中间层\示例63_新指令演示 --run --无头 --事件脚本 Sample\中间层\示例63_新指令演示\事件脚本.txt
// ============================================================
包含 "../../库/位.hb"
包含 "../../库/数学.hb"

无符号整数 字 = 0x12345678;
浮点 大 = 2.5;
浮点 小 = 0.0 - 1.5;

// ---------------- ① 位统计三条:以前是 32 轮软件循环 ----------------
整数 个数 = 数一位(0xF0F0F0F0);          // 16:一半是 1
整数 前零 = 前导零(0x00010000);           // 15
整数 尾零 = 尾随零(0x00010000);           // 16
测试输出(个数);
测试输出(前零);
测试输出(尾零);
测试输出(数一位(4294967295));             // 32

// ---------------- ② 位与字节:循环移位 / 字节交换 / 取字节 / 绝对值 / 双字乘 ----------------
测试输出(循环左移(2147483649, 1));         // 3:最高位绕到最低位
测试输出(循环右移(3, 1));                  // 2147483649:再绕回来
测试输出(字节交换(字));                    // 2018915346 = 0x78563412
测试输出(取字节(字, 3));                   // 18 = 0x12
测试输出(取整数绝对值(0 - 7));             // 7
测试输出(双字乘高(4294967295, 4294967295)); // 4294967294:64 位积的高半
测试输出(双字乘加(4294967295, 4294967295)); // 4294967295

// ---------------- ③ 浮点四条(非数传播 / 朝 −∞ / 位级搬符号) ----------------
测试输出(取较大(大, 小) > 2.0);            // 1:2.5 比 2.0 大
测试输出(取较小(大, 小) < 0.0 - 1.0);       // 1:-1.5 比 -1.0 小
测试输出(向下取整(小) < 0.0 - 1.0);         // 1:-2 比 -1 小
测试输出(搬符号(大, 小) < 0.0);             // 1:-2.5 是负的

// ---------------- ④ 两个库(收短之后)与形状识别 ----------------
测试输出(位.数一位(字));                   // 13:库方法转发到同一条指令上
测试输出(位.字节交换(字));                 // 2018915346:四段式子 → 一条 `字节交换`
测试输出(位.循环左移(字, 8));              // 878082066:变量移位量 → 一条 `循环左移`
测试输出(数学.绝对值(0 - 7));              // 7
测试输出(数学.最大(3, 9));                 // 9:一条 `条件移动`
测试输出(数学.夹取(120, 0, 100));          // 100:三层三目(最里那层是一条 `条件移动`)
无符号整数 高半 = 数学.乘高(4294967295, 4294967295);   // ⚠ 要打印很大的无符号值:先存进 `无符号整数` 变量
测试输出(高半);                            // 4294967294(库头注释里那条口径)

// ---------------- ⑤ 上窗口:一行一条列出来 ----------------
如果 (打开窗口("示例63 新指令演示:14 个指令内建", 460, 210))
{
    整数 类型 = 0;
    整数 键码 = 0;
    整数 鼠标x = 0;
    整数 鼠标y = 0;
    逻辑 收手 = 假;
    整数 帧 = 0;
    当 (!收手)
    {
        // 收事件:关窗请求(类型 1)归程序管(照示例15 / 16 / 62 那一套)
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;
            }
        }
        如果 (!收手)
        {
            清屏(0xFF101018);
            画文字(12, 10, "14 个指令内建 + 三条形状识别", 0xFFE0E0E8);
            画文字(12, 32, "数一位 / 前导零 / 尾随零:16 / 15 / 16", 0xFF8AC6FF);
            画文字(12, 50, "循环左移 / 右移:3 / 2147483649", 0xFF8AC6FF);
            画文字(12, 68, "字节交换:2018915346  取字节(字,3):18", 0xFF8AC6FF);
            画文字(12, 86, "取整数绝对值(-7):7", 0xFF8AC6FF);
            画文字(12, 104, "双字乘高 / 乘加:4294967294 / 4294967295", 0xFF8AC6FF);
            画文字(12, 122, "取较大 2.5  取较小 -1.5  向下取整 -2  搬符号 -2.5", 0xFFB0E0B0);
            画文字(12, 140, "数学.最大(3, 9) = 9(一条 条件移动)", 0xFFB0E0B0);
            画文字(12, 158, "数学.乘高(4294967295, 4294967295) = 4294967294", 0xFFB0E0B0);
            画文字(12, 180, "关窗请点右上角(自检走 --无头,不开窗)", 0xFF8A8A96);
            测试输出(帧);                     // 哪一帧真画了
            刷新();
            帧 = 帧 + 1;
            等待(250);                        // 每帧停 250 毫秒:不等待就是"一闪就没"(用户实测)。
        }
    }
    关闭窗口();
}
停止

// 预期输出: 16|15|16|32|3|2147483649|2018915346|18|7|4294967294|4294967295|1|1|1|1|13|2018915346|878082066|7|9|100|4294967294|打开窗口 标题="示例63 新指令演示:14 个指令内建" 宽=460 高=210|0|清屏 颜色=0xFF101018|画文字 x=12 y=10 文本="14 个指令内建 + 三条形状识别" 颜色=0xFFE0E0E8|画文字 x=12 y=32 文本="数一位 / 前导零 / 尾随零:16 / 15 / 16" 颜色=0xFF8AC6FF|画文字 x=12 y=50 文本="循环左移 / 右移:3 / 2147483649" 颜色=0xFF8AC6FF|画文字 x=12 y=68 文本="字节交换:2018915346  取字节(字,3):18" 颜色=0xFF8AC6FF|画文字 x=12 y=86 文本="取整数绝对值(-7):7" 颜色=0xFF8AC6FF|画文字 x=12 y=104 文本="双字乘高 / 乘加:4294967294 / 4294967295" 颜色=0xFF8AC6FF|画文字 x=12 y=122 文本="取较大 2.5  取较小 -1.5  向下取整 -2  搬符号 -2.5" 颜色=0xFFB0E0B0|画文字 x=12 y=140 文本="数学.最大(3, 9) = 9(一条 条件移动)" 颜色=0xFFB0E0B0|画文字 x=12 y=158 文本="数学.乘高(4294967295, 4294967295) = 4294967294" 颜色=0xFFB0E0B0|画文字 x=12 y=180 文本="关窗请点右上角(自检走 --无头,不开窗)" 颜色=0xFF8A8A96|刷新 命令=11|关闭窗口
