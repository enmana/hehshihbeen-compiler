// ============================================================
// 示例13:哈希表(库 `Sample\库\map.hb`)—— 清空表 / 存放 / 取出 / 删除 / 遍历
//
//   要解决的事:HB 有 `结构` / `数组` / `列表`,没有"名字 → 值"的关联容器;
//   自举编译器要用符号表(标识符 → 槽号),线性查找太慢。这个库补上它。
//
//   本示例演示:
//     ① 清空表:表的四份状态清掉,块留着接着用(可以反复清)
//     ② 存放:只管写(不返回值);要判"新添还是改旧"先 `有键` 问一句;取值用 `取出`(引用参数收值,没有就不动它)
//     ③ 拉链:两个键落同一个桶也不打架(`xyz` 与 `id` 在 8 个桶时都在 0 号桶)
//     ④ 桶数自己翻倍:装载因子到一半就从 8 翻到 16,老条目重挂链、值一个不丢
//     ⑤ 删除:从链上摘掉;删不掉的给 假,再删一次还是 假
//     ⑥ 遍历:遍历器 + 遍历下一个(桶按号、链按挂的顺序 —— 顺序稳定,能写进预期输出)
//     ⑦ 中文键:哈希按**文字**算,中英文混着放都行
//
//   内存:条目住堆里(一条 12 字节 + 一个桶 4 字节 + 键自己那一小块);
//   要放几万条,在工程文件 `.hbp` 里把 `堆` 调大(账在 `Sample\库\map.hb` 文件头)。
// ============================================================
包含 "../../库/map.hb"

哈希表 表;
清空表(表);
测试输出(条目数(表));              // 0
测试输出(桶数(表));                // 0(桶是第一次存放才开)

// ② 存放 / 改值 / 取出 / 有键
测试输出(有键(表, "name"));        // 假 = 还没有这个键
存放(表, "name", 7);
测试输出(有键(表, "age"));         // 假
存放(表, "age", 42);
测试输出(有键(表, "name"));        // 真 = 这个键已经有了(下面这次是改旧值)
存放(表, "name", 8);
测试输出(条目数(表));              // 2
整数 收 = 0;
测试输出(取出(表, "name", 收));    // 真
测试输出(收);                      // 8
测试输出(取出(表, "没有这个键", 收)); // 假
测试输出(收);                      // 8(假的时候不动 收)
测试输出(有键(表, "age"));         // 真
测试输出(有键(表, "没有这个键"));   // 假

// ③ 撞冲突:xyz 与 id 在 8 个桶时都落 0 号桶 —— 拉链挂上,两个都取得到
测试输出(桶数(表));                // 8
存放(表, "xyz", 100);
存放(表, "id", 200);
测试输出(取出(表, "xyz", 收));     // 真
测试输出(收);                      // 100
测试输出(取出(表, "id", 收));      // 真
测试输出(收);                      // 200
测试输出(条目数(表));              // 4

// ④ 再放一个就到装载因子一半:8 → 16 个桶(老条目重挂链)
存放(表, "符号", 300);
测试输出(桶数(表));                // 16
测试输出(取出(表, "xyz", 收));     // 真(翻倍之后照样取得到)
测试输出(收);                      // 100

// ⑤ 删除
测试输出(删除(表, "age"));         // 真
测试输出(删除(表, "age"));         // 假(已经没了)
测试输出(有键(表, "age"));         // 假
测试输出(条目数(表));              // 4

// ⑥ 遍历:桶 0 起,一条链走完再走下一个桶
哈希遍历器 走;
遍历开始(表, 走);
当 (遍历下一个(表, 走))
{
    输出行(条目键(表, 走.条目));
    测试输出(条目值(表, 走.条目));
}
测试输出(条目数(表));              // 4

// ⑦ 中文键
存放(表, "名字", 500);
测试输出(取出(表, "名字", 收));    // 真
测试输出(收);                      // 500
测试输出(条目数(表));              // 5

// ============================================================
// 带 UI 的那一半(H82 批 2):把桶画出来
//
//   上面那 81 行(纯计算 + 全部 `测试输出`)**一个字没动**;这一块接在它们后面、`停止` 之前 ——
//   只有在真开得了窗口的宿主上才跑(没有图形能力的宿主给 假 ⇒ 一个字都不多打)。
//
//   窗口里演的是**另一份表**(`演表`,与上面那张 `表` 互不影响),把 map.hb 的内部样子画出来:
//     · 左边一列 16 个桶(0~15):每桶画出**挂在链上的键**(链序 = 挂上的顺序,头插法 ⇒ 后放的在前);
//       桶 8~15 是"装载因子到一半、桶数 8 翻成 16"之后才有的(还没翻倍时那一行写"(还没开)")。
//     · 右边一列是"放进去的键 → 值",下面跟着 `条目数` / `桶数` / 装载因子。
//     · **逐帧推进**:第 1 步 存放 name、第 2 步 改值、…… 第 6 步 存放 符号 正好把桶数顶到 16、
//       第 7 步 删除 age、第 8 步 放中文键 名字 —— 一帧一步,左边那 16 行跟着重画。
//     · 点右边某一格键(或点左边某个桶)⇒ 底下两行说这个键的哈希、落几号桶、链上第几个。
//     · 窗口一直转到用户自己关(点标题栏的叉);自检与命令行靠同目录 `事件脚本.txt`
//       (写死的输入:第 3 / 5 / 7 帧各投一次点击)跑满 12 帧后由宿主投关窗请求收手。
//
//   ⚠ 主循环里**一条字符串都不现拼**:这一屏要画的字全在开窗之前拼好(见下面那些数组),
//     每帧只 `画文字(…, 数组[下标], …)`。每帧现拼会把编译器的字符串池吃光(示例01 / 02 实测过)。
//   ⚠ 点击的结算(命中 + 赋值)**单摆一层**(与 示例01 / 示例16 的"取点击"同一路数);
//     主循环里也不用 `跳出`:收手写 `收手 = 真`,外层再用 `如果 (!收手)` 把重画包住。
//   ⚠ 桶里链上有几个键 / 挂在链上的是谁:全用 map.hb 的**公开函数**问
//     (`遍历开始` / `遍历下一个` / `条目键` + `字符串哈希` + `桶数`)—— `Sample\库\map.hb` 一个字没动。
//   ⚠ `字符串` 数组不能在声明时给初值,只能声明后一条条填(照 `Sample\说明.md` 那张坑表)。
// ============================================================
包含 "../../库/string.hb"        // `转字符串` 在库里(把数字拼进文字要用它)

// ---- 窗口自己要记住的那几格(写在顶层,不藏在嵌套里)----
整数 类型 = 0;                   // 图形那一套要的四个出参(照 示例14 / 15 / 16)
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                    // 这一帧那"点一下"落在哪儿
整数 点y = 0;
整数 选中 = -1;                  // -1 = 还没点;0~5 = 右边第几格键;6~21 = 左边第 0~15 号桶
逻辑 有一下 = 假;                // 这一帧收到过"点一下"(按下 + 抬起)没有
整数 步 = 0;                     // 现在推到第几步(每 `刷新()` 一次进下一步,到最后一步停住)

// ---- 演的那张表:窗口里自己一份,与上面那 81 行用的 `表` 无关 ----
哈希表 演表;
清空表(演表);

// ---- 这一屏要画的字:全部在**开窗之前**拼好 ----
字符串 键名[6];                       // 右边那 6 格:要放的键(中文键放最后一个)
整数 起放[6] = [1, 3, 4, 5, 6, 8];    // 每个键是第几步放进去的(用来分"还没放"与"已删")
整数 桶八[6];                         // 8 个桶那一刻:每个键落几号桶 / 在链上第几个
整数 链八[6];
整数 桶十六[6];                       // 16 个桶(翻倍之后)那一刻:同上
整数 链十六[6];

字符串 桶列[144];                // 每步 16 行桶的文字:步 * 16 + 桶号
字符串 键格[54];                 // 每步 6 格键的文字:步 * 6 + 第几格
字符串 数行[9];                  // 每步:"条目数 N / 桶数 M"
字符串 载行[9];                  // 每步:"装载因子 N/M:到一半就翻倍"
字符串 步文表[9];                // 每步一句"这一步在干什么"
字符串 键说明1[6];               // 点某格键:哈希
字符串 键说明2[6];               // 点某格键:8 桶与 16 桶时落几号桶、链上第几个

// ---------- 小件:无符号的十进制文字 ----------
// string.hb 的 `转字符串` 是有符号口径(哈希过了 2^31 会打成负数),哈希这一格自己拼一遍 ——
// 取位那几句与库里 `转字符串` 同一个套路(库没动,这是示例自己的一份)。
方法 无符号文(无符号整数 值) 返回 字符串
{
    字符串 结果;
    字符 数字[10];
    整数 位 = 0;
    无符号整数 剩 = 值;
    当 (剩 > 0)
    {
        数字[位] = 剩 % 10 + '0';
        位 = 位 + 1;
        剩 = 剩 / 10;
    }
    如果 (位 == 0)
    {
        拼接到(结果, '0');
    }
    当 (位 > 0)
    {
        位 = 位 - 1;
        拼接到(结果, 数字[位]);
    }
    返回 结果;
}

// ---------- 一个桶:桶头 / 链上几个 / 链上的键 / 尾巴上的个数 ----------
方法 桶头文(整数 b) 返回 字符串
{
    字符串 s = "桶 ";
    拼接到(s, 转字符串(b), ": ");
    返回 s;
}

// "这一桶里有几个"与"这一桶里挂着谁"都靠走一遍问出来:
// 遍历器是按"桶号从小到大、同桶按链序"给的,所以按"哈希落哪个桶"筛一遍就得到链序。
方法 桶里几个(整数 b, 整数 桶数现) 返回 整数
{
    整数 个 = 0;
    哈希遍历器 游;
    遍历开始(演表, 游);
    当 (遍历下一个(演表, 游))
    {
        字符串 某键 = 条目键(演表, 游.条目);
        整数 码 = 字符串哈希(某键);
        如果 ((码 & (桶数现 - 1)) == b)
        {
            个 = 个 + 1;
        }
    }
    返回 个;
}

方法 链文(整数 b, 整数 桶数现) 返回 字符串
{
    字符串 链;
    哈希遍历器 游;
    遍历开始(演表, 游);
    当 (遍历下一个(演表, 游))
    {
        字符串 某键 = 条目键(演表, 游.条目);
        整数 码 = 字符串哈希(某键);
        如果 ((码 & (桶数现 - 1)) == b)
        {
            如果 (链.长度() > 0)
            {
                拼接到(链, " → ");
            }
            拼接到(链, 某键);
        }
    }
    返回 链;
}

方法 尾文(整数 个) 返回 字符串
{
    字符串 t = "  (";
    拼接到(t, 转字符串(个), " 个)");
    返回 t;
}

方法 桶文字(整数 b) 返回 字符串
{
    字符串 行 = 桶头文(b);
    整数 桶数现 = 桶数(演表);
    如果 (b >= 桶数现)
    {
        拼接到(行, "(还没开)");
        返回 行;
    }
    整数 个 = 桶里几个(b, 桶数现);
    如果 (个 == 0)
    {
        拼接到(行, "(空)");
        返回 行;
    }
    拼接到(行, 链文(b, 桶数现), 尾文(个));
    返回 行;
}

// ---------- 右边一格键:"name → 8" / "age —— 已删" / "xyz —— 还没放" ----------
方法 键行文(整数 k, 整数 号) 返回 字符串
{
    字符串 行;
    整数 取值 = 0;
    拼接到(行, 键名[k]);
    如果 (有键(演表, 键名[k]))
    {
        取出(演表, 键名[k], 取值);
        拼接到(行, " → ", 转字符串(取值));
        返回 行;
    }
    如果 (号 < 起放[k])
    {
        拼接到(行, " —— 还没放");
        返回 行;
    }
    拼接到(行, " —— 已删");
    返回 行;
}

// ---------- 右下那两行:条目数 / 桶数 / 装载因子 ----------
方法 数文字() 返回 字符串
{
    字符串 t = "条目数 ";
    拼接到(t, 转字符串(条目数(演表)));
    拼接到(t, " / 桶数 ", 转字符串(桶数(演表)));
    返回 t;
}

方法 载文字(整数 号) 返回 字符串
{
    字符串 t = "装载因子 ";
    整数 桶数现 = 桶数(演表);
    如果 (桶数现 == 0)
    {
        拼接到(t, "0/0:还没开桶");
        返回 t;
    }
    拼接到(t, 转字符串(条目数(演表)), "/", 转字符串(桶数现));
    如果 (号 == 6)
    {
        拼接到(t, "(4/8 到一半翻倍了)");
        返回 t;
    }
    拼接到(t, ":到一半就翻倍");
    返回 t;
}

// ---------- 点某格键时底下那两行 ----------
// 位段(桶号, 位, 头):位 < 0 = 这一步还没放进去
方法 位段(整数 桶号, 整数 位, 字符串 头) 返回 字符串
{
    字符串 t = 头;
    如果 (位 < 0)
    {
        拼接到(t, "还没放");
        返回 t;
    }
    拼接到(t, "第 ", 转字符串(桶号), " 号桶、第 ", 转字符串(位 + 1), " 个");
    返回 t;
}

方法 键说明首行(整数 k) 返回 字符串
{
    字符串 t = "";
    无符号整数 码 = 字符串哈希(键名[k]);
    拼接到(t, 键名[k], " 的哈希(无符号)= ", 无符号文(码));
    返回 t;
}

方法 键说明次行(整数 k) 返回 字符串
{
    字符串 t = "";
    拼接到(t, 位段(桶八[k], 链八[k], "8 桶:"), ";");
    拼接到(t, 位段(桶十六[k], 链十六[k], "16 桶:"));
    返回 t;
}

// ---------- 每一步那一句"这一步在干什么"(一个字面量一条分支,拆两个函数免得帧超 96)----------
方法 步文前(整数 号) 返回 字符串
{
    字符串 文 = "";
    如果 (号 == 0)
    {
        文 = "第 0 步:空表 —— 桶还没开(第一次 存放 才开 8 个桶)";
    }
    如果 (号 == 1)
    {
        文 = "第 1 步:存放(name, 7)—— 第一次放东西:开出 8 个桶";
    }
    如果 (号 == 2)
    {
        文 = "第 2 步:再 存放(name, 8)—— 同一个键:改值,条目数不涨";
    }
    如果 (号 == 3)
    {
        文 = "第 3 步:存放(age, 42)—— 落 4 号桶(哈希 & 7)";
    }
    如果 (号 == 4)
    {
        文 = "第 4 步:存放(xyz, 100)—— 落 0 号桶";
    }
    返回 文;
}

方法 步文后(整数 号) 返回 字符串
{
    字符串 文 = "";
    如果 (号 == 5)
    {
        文 = "第 5 步:存放(id, 200)—— 与 xyz 落同一个桶:拉链挂上";
    }
    如果 (号 == 6)
    {
        文 = "第 6 步:存放(符号, 300)⇒ 桶数 8 翻成 16,老条目重挂链";
    }
    如果 (号 == 7)
    {
        文 = "第 7 步:删除(age)—— 从链上摘掉:条目数 5 → 4";
    }
    如果 (号 == 8)
    {
        文 = "第 8 步:存放(名字, 500)—— 中文键:哈希按文字算";
    }
    返回 文;
}

方法 步文字(整数 号) 返回 字符串
{
    如果 (号 < 5)
    {
        返回 步文前(号);
    }
    返回 步文后(号);
}

// ---------- 某个键在"桶数现"个桶时:链上第几个(0 起;不在表里给 -1)----------
方法 链位(字符串 键, 整数 桶数现) 返回 整数
{
    整数 码 = 字符串哈希(键);
    整数 位 = 码 & (桶数现 - 1);
    整数 序 = 0;
    哈希遍历器 游;
    遍历开始(演表, 游);
    当 (遍历下一个(演表, 游))
    {
        字符串 某键 = 条目键(演表, 游.条目);
        整数 他码 = 字符串哈希(某键);
        如果 ((他码 & (桶数现 - 1)) == 位)
        {
            如果 (某键 == 键)
            {
                返回 序;
            }
            序 = 序 + 1;
        }
    }
    返回 -1;
}

// 8 个桶那一刻(第 5 步收尾:name / age / xyz / id 四个键、桶数还是 8)
方法 记八()
{
    整数 k = 0;
    当 (k < 6)
    {
        整数 码 = 字符串哈希(键名[k]);
        桶八[k] = 码 & 7;
        链八[k] = 链位(键名[k], 8);
        k = k + 1;
    }
}

// 16 个桶(最后一步:age 已删,name / xyz / id / 符号 / 名字 五个键)
方法 记十六()
{
    整数 k = 0;
    当 (k < 6)
    {
        整数 码 = 字符串哈希(键名[k]);
        桶十六[k] = 码 & 15;
        链十六[k] = 链位(键名[k], 16);
        k = k + 1;
    }
}

// ---------- 推一步 / 记一步 ----------
// 第几步干什么(键名走数组,函数体里一条字符串字面量都没有)
方法 推一步(整数 号)
{
    如果 (号 == 1)
    {
        存放(演表, 键名[0], 7);
    }
    如果 (号 == 2)
    {
        存放(演表, 键名[0], 8);
    }
    如果 (号 == 3)
    {
        存放(演表, 键名[1], 42);
    }
    如果 (号 == 4)
    {
        存放(演表, 键名[2], 100);
    }
    如果 (号 == 5)
    {
        存放(演表, 键名[3], 200);
    }
    如果 (号 == 6)
    {
        存放(演表, 键名[4], 300);
    }
    如果 (号 == 7)
    {
        删除(演表, 键名[1]);
    }
    如果 (号 == 8)
    {
        存放(演表, 键名[5], 500);
    }
}

// 把当前 演表 的样子记成第 号 组文字(16 行桶 + 6 格键 + 三行状态)
方法 记一步(整数 号)
{
    整数 b = 0;
    当 (b < 16)
    {
        桶列[号 * 16 + b] = 桶文字(b);
        b = b + 1;
    }
    整数 k = 0;
    当 (k < 6)
    {
        键格[号 * 6 + k] = 键行文(k, 号);
        k = k + 1;
    }
    数行[号] = 数文字();
    载行[号] = 载文字(号);
    步文表[号] = 步文字(号);
}

// 键名先填好(字符串数组不能在声明时给初值,只能一条条填)
键名[0] = "name";
键名[1] = "age";
键名[2] = "xyz";
键名[3] = "id";
键名[4] = "符号";
键名[5] = "名字";

// 开窗之前:一帧一步地推完,每推一步就把这一屏的样子记一组文字
记一步(0);
整数 号 = 1;
当 (号 < 9)
{
    推一步(号);
    如果 (号 == 5)
    {
        记八();
    }
    如果 (号 == 8)
    {
        记十六();
    }
    记一步(号);
    号 = 号 + 1;
}

// 点某格键时底下那两行(哈希 / 8 桶与 16 桶时落几号桶、链上第几个)
整数 k = 0;
当 (k < 6)
{
    键说明1[k] = 键说明首行(k);
    键说明2[k] = 键说明次行(k);
    k = k + 1;
}

// ---- 开窗:下面那一层每帧只画(一条字符串都不再拼)----
逻辑 开着 = 打开窗口("示例13 哈希表", 560, 540);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算它:右边 6 格键从 y=80 起、每格 22 像素(x 从 304 到 548);
        // 左边 16 行桶同一套口径(x 从 12 到 288)。
        // ⚠ 这一步**单独摆在这一层**,不塞进上面那串嵌套里(与 示例01 / 示例16 的"取点击"同一路数)。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 304 && 点x < 548 && 点y >= 80 && 点y < 212)
            {
                选中 = (点y - 80) / 22;
            }
            如果 (点x >= 12 && 点x < 288 && 点y >= 80 && 点y < 432)
            {
                选中 = 6 + (点y - 80) / 22;
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是现成的)----
            清屏(0xFF101018);
            画矩形(12, 12, 536, 40, 0xFF2A3550);
            画文字(24, 16, "示例13 哈希表:把桶画出来(拉链 / 翻倍 / 删除)", 0xFFE8E8F0);
            画文字(24, 34, "左列 16 个桶(每桶画出挂在链上的键);右边是键 → 值", 0xFFB0B0B8);

            画文字(20, 60, "桶 0…15:第一次存放才开 8 个,到一半翻成 16", 0xFF9CC4FF);
            画文字(312, 60, "放进去的键 → 值", 0xFF9CC4FF);

            // 左边 16 行桶:点中的那一行 + 鼠标压着的那一行都有蓝底(先铺底、再画字)
            整数 i = 0;
            当 (i < 16)
            {
                整数 行y = 80 + i * 22;
                逻辑 亮 = 假;
                如果 (选中 == 6 + i)
                {
                    亮 = 真;
                }
                如果 (鼠标x >= 12 && 鼠标x < 288 && 鼠标y >= 行y && 鼠标y < 行y + 20)
                {
                    亮 = 真;
                }
                如果 (亮)
                {
                    画矩形(12, 行y, 276, 20, 0xFF2A6EF0);
                }
                如果 (!亮)
                {
                    画矩形(12, 行y, 276, 20, 0xFF23232E);
                }
                画文字(20, 行y + 3, 桶列[步 * 16 + i], 0xFFD0D0D8);
                i = i + 1;
            }

            // 右边 6 格键
            整数 j = 0;
            当 (j < 6)
            {
                整数 行y = 80 + j * 22;
                逻辑 亮 = 假;
                如果 (选中 == j)
                {
                    亮 = 真;
                }
                如果 (鼠标x >= 304 && 鼠标x < 548 && 鼠标y >= 行y && 鼠标y < 行y + 20)
                {
                    亮 = 真;
                }
                如果 (亮)
                {
                    画矩形(304, 行y, 244, 20, 0xFF2A6EF0);
                }
                如果 (!亮)
                {
                    画矩形(304, 行y, 244, 20, 0xFF23232E);
                }
                画文字(312, 行y + 3, 键格[步 * 6 + j], 0xFFD0D0D8);
                j = j + 1;
            }

            // 右下:条目数 / 桶数 / 装载因子
            画矩形(304, 222, 244, 44, 0xFF16161E);
            画文字(312, 228, 数行[步], 0xFFE8E8F0);
            画文字(312, 248, 载行[步], 0xFFD0D0D8);

            // 怎么点(右列只有 244 像素宽 ⇒ 一行最多三十来格,长了会顶出窗口)
            画文字(312, 278, "点右边一格键 ⇒ 底下说哈希", 0xFF8A8A96);
            画文字(312, 298, "点左边一个桶 ⇒ 底下画它的链", 0xFF8A8A96);

            // 这一篇演什么
            画文字(312, 330, "本篇:清空表 / 存放 / 改值", 0xFF8A8A96);
            画文字(312, 350, "取出 / 有键 / 删除 / 遍历", 0xFF8A8A96);
            画文字(312, 380, "拉链撞冲突 / 桶数翻倍 / 中文键", 0xFF8A8A96);
            画文字(312, 400, "上面那 81 行是同一批键的输出", 0xFF8A8A96);

            // 底下三行:这一步在干什么 + 点中的那一格说明了什么
            画线(12, 440, 548, 440, 0xFF3C3C46);
            画文字(20, 452, 步文表[步], 0xFFE8E8F0);

            如果 (选中 < 0)
            {
                画文字(20, 478, "点右边一格键 / 点左边一个桶:这里说哈希与落桶", 0xFFD0D0D8);
                画文字(20, 502, "键就那么几个;每进一帧左边那 16 行重画一遍", 0xFF8A8A96);
            }
            如果 (选中 >= 0 && 选中 < 6)
            {
                画文字(20, 478, 键说明1[选中], 0xFFD0D0D8);
                画文字(20, 502, 键说明2[选中], 0xFF8A8A96);
            }
            如果 (选中 >= 6)
            {
                画文字(20, 478, 桶列[步 * 16 + 选中 - 6], 0xFFD0D0D8);
                画文字(20, 502, "点中的那一行就是那个桶现在的样子(链上挂的顺序)", 0xFF8A8A96);
            }

            // ---- 刷新:不调用就一直不显示;顺带推进下一步(封顶在第 8 步)----
            刷新();

            如果 (步 < 8)
            {
                步 = 步 + 1;
            }

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)
        }
    }

    关闭窗口();
}

停止

