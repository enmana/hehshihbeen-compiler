// ============================================================
// 示例24:一张表格 —— 结构数组里再放定长数组(H3 ④ 起)
//
// 这个示例演示什么:**一条引用里两个下标都是变量** —— `表[行号].格[列号]`
// 重点看哪几处:
//   ① 写法:`表[行号].格[列号]` —— 外面是"结构数组的第几个",里面是"那一行里第几格"。
//      两个下标都能是常量,也都能是变量(循环里就是变量)。
//   ② 地址是**线性累加**:字节偏移 = 行号 × 一行的宽 + 列号 × 4(与"自己摊平成一维"同一个道理);
//      本示例拿"先算地址、再按下标读写"对了一遍 —— 读改的是同一格。
//   ③ 越界照旧查:两处都查(外面的数组、里面的数组字段),报错点明是哪一个
//      (`表[3].格[0]` 说行数,`表[行号].格[4]` 说"字段 '格' 只有 4 个元素")。
//   ④ 一行里的格子还能是结构(`点 格[2];` 那种):`表[行号].格[列号].x` 也认。
//   ⑤ 一行里放**动态列表**(`整数 格[];`)也行(`表[行号].格.添加(7);`),那是 H1 起就有的。
//
// 关键字中英等价(结构=struct、整数=int、循环=for、地址=addr),标识符随便起。
// 本示例不需要任何库,单独就能编译运行。
// ============================================================

结构 点
{
    整数 x;
    整数 y;
}

结构 行
{
    整数 格[4];
    点 角[2];
}

行 表[3];
整数 行号 = 1;
整数 列号 = 2;

// ① 两个下标都是变量
表[行号].格[列号] = 7;
测试输出(表[行号].格[列号]);           // 7

// ② 别人那几格没被写坏(常量下标那一格照旧)
表[0].格[0] = 1;
表[2].格[3] = 9;
测试输出(表[0].格[0] * 100 + 表[2].格[3]);   // 109

// ③ 与"先算地址、再按下标读写"读的是同一格
地址 头 = 地址(表[行号].格[0]);
测试输出(取字(头, 列号 * 4));         // 7
存字(头, 列号 * 4, 66);
测试输出(表[行号].格[列号]);           // 66

// ④ 第二下标之后再点结构字段
表[行号].角[0].x = 21;
表[行号].角[1].y = 22;
测试输出(表[行号].角[0].x + 表[行号].角[1].y);   // 43

// ⑤ 循环里两个下标都是变量:把一列填成 1 / 2 / 3 再求和
整数 总 = 0;
循环 (var i = 0; i < 3; i = i + 1)
{
    表[i].格[列号] = i + 1;
    总 = 总 + 表[i].格[列号];
}
测试输出(总);                          // 6

停止

// 预期输出: 7|109|7|66|43|6
