// ============================================================
// 示例28:定时器 —— G3 域 2 的"定时器"那一格(`Sample\库\定时.hb`)
//
//   要解决的事:界面主循环每一轮都要知道"有没有到点的事要做"。这一篇用**纯 HB** 的定时库
//   演示三件:① 每过一段就做一次(动画 / 心跳)② 过一段时间做一次就完(延时收手)
//   ③ 中途取消 + 号复用。
//
//   节拍从哪来:语言内建的 `当前毫秒()`(宿主功能号 55,单调钟,不受改系统时间影响)。
//   定时表住库那边 —— **零新宿主能力**。
//
//   两件必须写清楚的口径:
//     · `每 vs 一次` —— 每过一段的那种到点后自己排下一次;一次性的到点后就摘掉。
//     · **推进到(刻度) vs 推进()** —— 前一个喂的是**指定的刻度**,这一篇全用它(结果完全确定,
//       不看机器钟);真正的程序里用 `推进()`,它自己读 `当前毫秒()`。
//       为什么非要有一个"指定刻度"的入口:自检与"固定步长的动画"要的是可复现 —— 拿机器钟跑,
//       `推进` 早一点晚一点就换一个结果。
//
//   标准用法(界面主循环里,`推进()` 自己读机器钟):
//       定时.每(16, 地址(动一下));
//       定时.一次(3000, 地址(收手));
//       当 (真)
//       {
//           如果 (定时.推进() > 0)
//           {
//               标脏(面);
//           }
//           如果 (要重画(面))
//           {
//               重画(面);
//           }
//           刷新();
//           等待(1);
//       }
//
//   到点判据为什么是"减法取模"而不是比大小:见 `Sample\库\定时.hb` 文件头(约 49.7 天回绕一次)。
// ============================================================
包含 "../../库/定时.hb"

整数 动了几次 = 0;      // "每 16 毫秒"那个回调做了几次
整数 收手了几次 = 0;    // "3 秒后"那个回调做了几次
整数 最后一次的号 = -1;  // 回调收到的是"第几号定时器"

方法 动一下(整数 号)
{
    动了几次 = 动了几次 + 1;
    最后一次的号 = 号;
    返回
}

方法 收手(整数 号)
{
    收手了几次 = 收手了几次 + 1;
    返回
}

方法 从不触发(整数 号)
{
    收手了几次 = 收手了几次 + 100;   // 这个回调**不该**被触发(触发了这一篇就会红)
    返回
}

// 刻度 0 那一刻,先登记两个
整数 心跳号 = 定时.每(16, 地址(动一下));
整数 收手号 = 定时.一次(3000, 地址(收手));

测试输出(心跳号);                 // 0(最小空位)
测试输出(收手号);                 // 1
测试输出(定时.个数());             // 2
测试输出(定时.间隔(心跳号));       // 16
测试输出(定时.在册(收手号));       // 1

// 没到点:一次都不该触发(16 毫秒那个也要过 16 个刻度)
测试输出(定时.推进到(0));          // 0
测试输出(定时.推进到(15));         // 0
测试输出(动了几次);                // 0

// 到点了:16 那个来一次(0 + 16 = 16)
测试输出(定时.推进到(16));         // 1
测试输出(动了几次);                // 1

// 再往前一点点:离上一次只过了 15,还不到点
测试输出(定时.推进到(31));         // 0
测试输出(定时.推进到(32));         // 1
测试输出(动了几次);                // 2

// 一次跨过好几段:只补一次(不是"过几段就补几次")
测试输出(定时.推进到(400));        // 1
测试输出(动了几次);                // 3

// 一次性那个:到 3000 那一刻两件一起到 —— 心跳(400 + 16 ≤ 3000)与收手(0 + 3000)各一次
测试输出(定时.推进到(3000));       // 2
测试输出(收手了几次);              // 1
测试输出(定时.推进到(3016));       // 1(又轮到心跳)
测试输出(收手了几次);              // 1
测试输出(定时.个数());             // 1(一次性的自己摘掉了)
测试输出(定时.在册(收手号));       // 0

// 回调收到的是"第几号定时器"
测试输出(最后一次的号);            // 0

// 中途取消:再登记两个,把前面那个取消掉,然后复用一个空位
整数 取消号 = 定时.每(100, 地址(从不触发));
整数 占位号 = 定时.每(100, 地址(从不触发));
测试输出(定时.个数());             // 3
测试输出(定时.取消(取消号));         // 1
测试输出(定时.取消(取消号));         // 0(再取消一次:它已经不在册了)
测试输出(定时.个数());             // 2
测试输出(定时.取消(99));           // 0(号不对)
整数 复用号 = 定时.每(100, 地址(从不触发));
测试输出(复用号);                    // 1(取最小空位,把取消号那一格复用回来)

// 收尾:全摘掉
定时.清空();
测试输出(定时.个数());             // 0
测试输出(定时.在册(复用号));         // 0
测试输出(动了几次);                // 5(清空之后再推进也不会再触发)
测试输出(定时.推进到(99999));      // 0
测试输出(动了几次);                // 5
测试输出(收手了几次);              // 1(那个"不该被触发"的回调一次都没进来)
停止

// 预期输出: 0|1|2|16|1|0|0|0|1|1|0|1|2|1|3|2|0|1|0|1|0|0|3|1|0|2|0|1|0|0|5|0|5|0
