// ============================================================
// 示例22:元组(H68-3 起)—— 几个值捆成一份,按名字取
//
// 这个示例演示什么:一个"类型位置写一对方括号"的复合值:`[整数, 整数] 一份 = [7, 3];`
// 重点看哪几处:
//   ① 写法:类型位置上写 `[元素类型, 元素类型]`;不写名字时成员依次叫 `.项0` / `.项1`
//      (**从 0 起**,与字符串取字、数组、列表统一);想给成员起名就写成 `[整数 商, 整数 余]`。
//   ② 成员就是普通字段:`一份.项1 = 8;` 能读能改;`[整数, 整数] 副本 = 一份;` 是**整块拷一份**
//      (改副本不动原件)。
//   ③ 元素类型能是:基础类型 / 枚举 / 结构 / **另一个元组**(元组能套元组)。
//      `[颜色, 点]` 这种"枚举 + 结构"一份装下,`[[整数, 整数], 整数]` 就是两层。
//   ④ 元组数组:`[整数, 整数] 表[3];` —— 元素按整块宽紧排,`表[i].项1` 运行期下标也认。
//   ⑤ 元组当**参数**传:结构参数一律**按地址传**(被调方改的就是调用方那份),
//      元组同办 —— 想解耦就先自己拷一份(`[整数, 整数] 副本 = 账;`)再传。
//      元组当**返回值**也认(与结构返回同一套:调用方给个地方,被调方写进去)。
//   ⑥ `引用 [整数, 整数] 指 = 账;` 也认:通过引用改的就是原件。
//   ⑦ 名义制:`[整数, 整数]` 与 `结构 点 { 整数 x; 整数 y; }` 是**两个类型**,
//      长得像也不能互相赋值(要转就一个字段一个字段搬)。
//   ⑧ 明确不做(报错当场说):拆包(`[整数 商, 整数 余] = …`)、元素是 `字符串` 的元组、
//      空元组 `[]`;要拆就一个字段一个字段取(`整数 商 = 结果.项0;`)。
//
// 关键字中英等价(整数=int、枚举=enum、循环=for、结构=struct),标识符随便起。
// 本示例不需要任何库,单独就能编译运行。
//
//   ============================================================
//   怎么看(带 UI;H82 批 3)—— 这一份是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例22 元组`。
//       窗口上半是**元组的格子阵**:12 格,每格一份元组,格里三行写着
//       "成员怎么取 / 成员的类型 / 现在装着的值"。点某一格 ⇒ 底下三行当场说清
//       "它在这一捆里的第几个 / 属于哪一捆 / 现在的值",蓝底就停在你点的那一格上;
//       每刷新一帧,蓝底沿成员往后走一格(走到最后一格绕回第一格)—— 这一捆是怎么
//       一格一格摆出来的,就在眼前挪。窗口**一直转到你自己关掉**(点标题栏的叉)。
//     · **自检 / 命令行**(`hbcc --run --无头 --事件脚本 事件脚本.txt`):没有真窗口、
//       也不用等人去关 —— 旁边那份 `事件脚本.txt` 是**写死的输入**(第几帧投哪条事件),
//       第 20 帧宿主投一个关窗请求;于是"窗口该画什么、点一下亮哪一格"都能逐行对出来。
//     · **顺序**:上面那些纯计算与 `测试输出` **一个字没动**;带 UI 的这一半接在
//       最后一条语句后面、`停止` 之前 —— 于是这一份的期望输出里,"数"还是那些数,
//       窗口那几行排在后头(没有图形能力的宿主给 假 ⇒ 一个字都不多打)。
//   ============================================================

枚举 颜色 { 赤, 绿, 蓝 }
结构 点
{
    整数 x;
    整数 y;
}

// ⑤ 元组当参数:结构参数按地址传 —— 被调方改的正是调用方那一份
方法 累加进(整数 值, [整数, 整数] 账) 返回 整数
{
    账.项0 = 账.项0 + 值;
    账.项1 = 账.项1 + 1;
    返回 账.项0;
}

// 元组当返回值(与结构返回同一套:调用方给个地方,被调方写进去)
方法 取一份() 返回 [整数, 整数]
{
    [整数, 整数] 局 = [4, 5];
    返回 局;
}

// ① 声明与成员:不写名字 ⇒ .项0 / .项1;写名字 ⇒ 用真名
[整数, 整数] 一份 = [7, 3];
测试输出(一份.项0);                    // 7
测试输出(一份.项1);                    // 3
[整数 商, 整数 余] 带名 = [17, 5];
测试输出(带名.商);                     // 17
测试输出(带名.余);                     // 5

// ② 成员能改;整体赋值是独立的一份拷贝
一份.项1 = 8;
测试输出(一份.项1);                    // 8
[整数, 整数] 副本 = 一份;
副本.项0 = 100;
测试输出(一份.项0);                    // 7:改副本不动原件
测试输出(副本.项0);                    // 100

// ⑤ 当参数传(按地址)/ 当返回值用
[整数, 整数] 账 = [0, 0];
测试输出(累加进(5, 账));              // 5
测试输出(账.项0);                      // 5:被调方改的就是这一份
测试输出(账.项1);                      // 1
[整数, 整数] 得到 = 取一份();
测试输出(得到.项0);                    // 4
测试输出(得到.项1);                    // 5

// ④ 元组数组:元素紧排,`表[i].项1` 运行期下标也认
[整数, 整数] 表[3];
表[0].项0 = 1;
表[0].项1 = 2;
循环 (var i = 0; i < 3; i = i + 1)
{
    表[i].项1 = 表[i].项1 + i;
}
测试输出(表[0].项0 + 表[0].项1 + 表[1].项1 + 表[2].项1);   // 6 = 1 + 2 + 1 + 2

// ③ 元组当结构字段;元素类型还能是枚举 / 结构
结构 卡
{
    [整数, 整数] 坐标;
    颜色 花色;
}
卡 我的卡;
我的卡.坐标.项0 = 3;
我的卡.坐标.项1 = 4;
我的卡.花色 = 蓝;
测试输出(我的卡.坐标.项0 + 我的卡.坐标.项1);   // 7
测试输出(我的卡.花色);                          // 2

[颜色, 点] 卡片;
卡片.项0 = 绿;
卡片.项1.x = 8;
测试输出(卡片.项0);                             // 1
测试输出(卡片.项1.x);                           // 8

// ③ 元组套元组
[[整数, 整数], 整数] 套;
套.项0.项0 = 1;
套.项0.项1 = 2;
套.项1 = 3;
测试输出(套.项0.项1 + 套.项1);                  // 5

// ⑥ 引用指一份元组:通过引用改的就是原件
引用 [整数, 整数] 指 = 账;
指.项0 = 99;
测试输出(账.项0);                               // 99

// ============================================================
// 带 UI 的那一半(H82 批 3):左边一版"元组的格子阵",点一格说清它在这一捆里的位置
//
//   上面那些纯计算与全部 `测试输出` **一个字没动**;这一块接在最后一条语句之后、
//   `停止` 之前 —— 只有在真开得了窗口的宿主上才跑(没有图形能力的宿主给 假 ⇒
//   一个字都不多打,上面那 19 个数还是那 19 个数)。
//
//   窗口里演的是上面那些元组**跑完之后的样子**(12 格 = 12 个成员;值就是上面
//   `测试输出` 打出来的那些数):
//     · 左边那块板是**格子阵**:2 列 × 6 行,一格一个成员,格里三行 =
//       "成员 / 类型 / 现在的值"(名字里带 `.项0` 的就是不写名字时编译器给的名)。
//     · **点某一格** ⇒ 底下三行当场说:它是这一捆里的第几个 / 属于哪一捆 / 现在的值;
//       蓝底就停在你点的那一格上;鼠标压着的另一格也有底色(**底色先画、字后画**)。
//     · **逐帧推进**:每 `刷新()` 一帧,蓝底沿成员往后走一格(#0 → #1 → … → #11 → #0)。
//     · 窗口一直转到用户自己关(点标题栏的叉);自检与命令行靠同目录 `事件脚本.txt`
//       (写死的输入:第 2 / 10 帧各投一次点击)跑满 20 帧后由宿主投关窗请求收手。
//
//   ⚠ 主循环里**一条字符串都不现拼**:这一屏要画的字全在开窗之前拼好(存进下面那几个
//     `字符串 数组`),每帧只 `画文字(…, 数组[越算越好的下标], …)`。每帧现拼 / 每帧调一个
//     返回字符串的函数,都会把编译器那个池吃光(见 `Sample\说明.md` 那张坑表)。
//   ⚠ 摆位与命中测试**用的是同一组数**(`格左` / `格宽` / `格顶` / `格距`),要挪地方只改这几行。
//   ⚠ `格式化` 的占位符只认 `{0}`(写成 `%d` 不报错、原样返回 `"%d"`)—— 下面一律 `{0}`。
// ============================================================

包含 "../../库/string.hb"        // `格式化("{0}", 值)` 要用的那个 `转字符串` 在库里(放文件头,与 示例07 一样)

// ---- 窗口自己要记住的那几格(写在顶层,不藏在嵌套里)----
整数 类型 = 0;                   // 图形那一套要的四个出参(照 示例14 / 15 / 16)
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                    // 这一帧那"点一下"落在哪儿
整数 点y = 0;
整数 选中 = 0;                   // 点中的那一格(0~11),底下三行说的是它
整数 高亮 = 0;                   // 这一帧蓝底停在哪一格(每刷新一帧往后走一格)
逻辑 有一下 = 假;                // 这一帧收到过"点一下"(按下 + 抬起)没有

// ---- 摆位:画图与命中测试共用这几行(窗宽 560 ⇒ 一行最多约 33 格,格子里的字都短)----
整数 窗宽 = 560;
整数 窗高 = 600;
整数 格左 = 12;
整数 格顶 = 96;
整数 格宽 = 274;
整数 格高 = 58;
整数 格距 = 62;                  // 一行的间距(留 4 像素空当;命中测试的除数)

// ---- 这一屏要画的字:全部在**开窗之前**拼好 ----
// ⚠ `字符串` 数组**不能在声明时给初值**,只能声明后一条条填(数字类的初值才写在一行里)。
字符串 名格[12];                 // 第 0 行:成员怎么取
字符串 式格[12];                 // 第 1 行:成员的类型
字符串 值格[12];                 // 第 2 行(通常):现在装着的值
字符串 选中值[12];                 // 第 2 行(蓝底正停在这一格时换成这个)
字符串 元格[12];                 // 它在这一捆里的第几个
字符串 捆格[12];                 // 它属于哪一捆(怎么声明出来的)
字符串 现值[12];                 // 底下"现在的值"那一行
整数 列数 = 2;                   // 格子阵的列数(格号 = 行 * 列数 + 列)

// ---- 12 个成员的名字与类型:一律字面量(字符串赋值右边只认"字面量 / 另一个串 / 一个返回串的调用")----
名格[0] = "一份.项0";
式格[0] = "整数";
名格[1] = "一份.项1";
式格[1] = "整数";
名格[2] = "带名.商";
式格[2] = "整数(起了名)";
名格[3] = "带名.余";
式格[3] = "整数(起了名)";
名格[4] = "账.项0";
式格[4] = "整数";
名格[5] = "账.项1";
式格[5] = "整数";
名格[6] = "表[1].项1";
式格[6] = "整数(元组数组)";
名格[7] = "表[2].项1";
式格[7] = "整数(元组数组)";
名格[8] = "我的卡.坐标.项1";
式格[8] = "整数(结构字段)";
名格[9] = "卡片.项0";
式格[9] = "颜色(枚举)";
名格[10] = "套.项0.项1";
式格[10] = "整数(元组套元组)";
名格[11] = "指.项0";
式格[11] = "整数(引用 = 原件)";

// ---- 它在这一捆里的第几个 / 属于哪一捆(也是字面量,一条一条写)----
元格[0] = "第 1 个(下标从 0)";
捆格[0] = "①『一份』:[整数, 整数] 一份 = [7, 3];";
元格[1] = "第 2 个";
捆格[1] = "①『一份』:不写名字 ⇒ .项0 / .项1";
元格[2] = "第 1 个";
捆格[2] = "①『带名』:[整数 商, 整数 余] 带名 = [17, 5];";
元格[3] = "第 2 个";
捆格[3] = "①『带名』:起了名就读 .商 / .余";
元格[4] = "第 1 个";
捆格[4] = "⑤『账』:被 累加进(5, 账) 按地址改过";
元格[5] = "第 2 个";
捆格[5] = "⑤『账』:每进一次 账.项1 = 账.项1 + 1";
元格[6] = "第 2 个";
捆格[6] = "④『表[3]』:元组数组,元素紧排";
元格[7] = "第 2 个";
捆格[7] = "④『表[3]』:循环里 表[i].项1 + i";
元格[8] = "第 2 个";
捆格[8] = "③『我的卡』:元组当结构字段(卡.坐标)";
元格[9] = "第 1 个";
捆格[9] = "③『卡片』:[颜色, 点] —— 枚举 + 结构";
元格[10] = "第 2 个";
捆格[10] = "③『套』:[[整数, 整数], 整数] —— 元组套元组";
元格[11] = "第 1 个";
捆格[11] = "⑥『指』:引用 [整数, 整数] 指 = 账;";

// ---- 现在的值:开窗前用 `格式化("{0}", 值)` 拼一遍,主循环只管画 ----
// ⚠ 主循环里写 `画文字(x, y, 转字符串(值), 色)` 就是"每帧漏一块池"⇒ 值也要先转成文字。
// ⚠ 一个函数里别堆超过 ~2 个 `格式化(...)`(帧只有 96 字节,一个调用要一份临时槽);
//   这是**顶层**那一段,只放了这两个(照 示例02 的口径;下面 `填值` 里那两个在它自己的帧里)。
字符串 值二 = "";
字符串 值四 = "";
值二 = 格式化("{0}", 一份.项1);
值四 = 格式化("{0}", 带名.余);

// 每格那一行"现在的值":不带名的那版 / 蓝底停在这一格时带一支箭头的那版
// (`拼接到` 是往一个字符串变量后面接 —— 每格只接一次,主循环里一次都不接)
方法 填值(整数 格)
{
    字符串 尾 = "";
    如果 (格 == 0)
    {
        尾 = "7";
    }
    如果 (格 == 1)
    {
        尾 = 值二;
    }
    如果 (格 == 2)
    {
        尾 = "17";
    }
    如果 (格 == 3)
    {
        尾 = 值四;
    }
    如果 (格 == 4)
    {
        尾 = "99";
    }
    如果 (格 == 5)
    {
        尾 = "1";
    }
    如果 (格 == 6)
    {
        尾 = "1";
    }
    如果 (格 == 7)
    {
        尾 = "2";
    }
    如果 (格 == 8)
    {
        尾 = "4";
    }
    如果 (格 == 9)
    {
        尾 = "1(绿)";
    }
    如果 (格 == 10)
    {
        尾 = "2";
    }
    如果 (格 == 11)
    {
        尾 = "99";
    }
    值格[格] = 尾;
    选中值[格] = 尾;
    拼接到(选中值[格], "  ←");
    现值[格] = 尾;
}

整数 填 = 0;
当 (填 < 12)
{
    填值(填);
    填 = 填 + 1;
}

// ---- 开窗:下面那一层每帧只画(一条字符串都不再拼)----
逻辑 开着 = 打开窗口("示例22 元组", 窗宽, 窗高);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 收到过"点一下"就结算它:格子阵从 `格左` / `格顶` 起,一格 `格宽` × `格距`;
        // 点中的那一格:底下三行说它,蓝底也停到它身上。
        // ⚠ 这一步**单独摆在这一层**(浅一层就稳):命中测试与赋值别塞进上面那串嵌套里。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 格左 && 点x < 格左 + 列数 * 格宽 && 点y >= 格顶 && 点y < 格顶 + 6 * 格距)
            {
                整数 列 = (点x - 格左) / 格宽;
                整数 行 = (点y - 格顶) / 格距;
                选中 = 行 * 列数 + 列;
                高亮 = 选中;
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼)----
            清屏(0xFF101018);
            画矩形(12, 12, 窗宽 - 24, 40, 0xFF2A3550);
            画文字(24, 16, "示例22 元组:几个值捆成一份,按名字取", 0xFFE8E8F0);
            画文字(24, 34, "左上一格一个成员;点一格 ⇒ 底下说它在这一捆里的位置", 0xFFB0B0B8);
            画文字(20, 68, "格子阵:12 格 = 12 个成员(含元组数组 / 结构字段 / 元组套元组)", 0xFF9CC4FF);

            // ⚠ 底色一律画在文字**之前**:`画矩形` 是不透明实心,画在文字后面会把那一格的 9 个字盖掉。
            //   一块整板打底,再把"鼠标压着的那一格"与"蓝底停着的那一格"盖上 —— 顺序:整板 → 悬停 → 蓝底。
            画矩形(格左, 格顶, 列数 * 格宽, 6 * 格距, 0xFF16161E);
            如果 (鼠标x >= 格左 && 鼠标x < 格左 + 列数 * 格宽 && 鼠标y >= 格顶 && 鼠标y < 格顶 + 6 * 格距)
            {
                整数 悬列 = (鼠标x - 格左) / 格宽;
                整数 悬行 = (鼠标y - 格顶) / 格距;
                整数 悬 = 悬行 * 列数 + 悬列;
                如果 (悬 != 高亮)
                {
                    画矩形(格左 + 悬列 * 格宽, 格顶 + 悬行 * 格距, 格宽 - 4, 格高, 0xFF232B3E);
                }
            }
            整数 亮列 = 高亮 - (高亮 / 列数) * 列数;
            整数 亮行 = 高亮 / 列数;
            画矩形(格左 + 亮列 * 格宽, 格顶 + 亮行 * 格距, 格宽 - 4, 格高, 0xFF2A6EF0);

            整数 格 = 0;
            当 (格 < 12)
            {
                整数 列 = 格 - (格 / 列数) * 列数;
                整数 行 = 格 / 列数;
                整数 格x = 格左 + 列 * 格宽 + 10;
                整数 格y = 格顶 + 行 * 格距 + 6;
                画文字(格x, 格y, 名格[格], 0xFFD0E8FF);
                画文字(格x, 格y + 18, 式格[格], 0xFF9CC4FF);
                如果 (格 == 高亮)
                {
                    画文字(格x, 格y + 36, 选中值[格], 0xFFFFFFFF);
                }
                如果 (格 != 高亮)
                {
                    画文字(格x, 格y + 36, 值格[格], 0xFFE8E8F0);
                }
                格 = 格 + 1;
            }

            // 底下三行:点中的那一格"它在这一捆里的位置 / 类型 / 值"
            画线(12, 484, 548, 484, 0xFF3C3C46);
            画矩形(12, 494, 536, 80, 0xFF16161E);
            画文字(20, 500, 元格[选中], 0xFFE8E8F0);
            画文字(20, 524, 捆格[选中], 0xFFD0D0D8);
            画文字(20, 548, "现在的值:", 0xFF9CC4FF);
            画文字(100, 548, 现值[选中], 0xFFFFFFFF);
            画文字(20, 582, "蓝底 = 这一帧停在这一格(每进一帧往后走一格)", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)

            // 逐帧推进:每刷新一帧,蓝底往后走一格;走到最后一格绕回第一格
            高亮 = 高亮 + 1;
            如果 (高亮 >= 12)
            {
                高亮 = 0;
            }
        }
    }

    关闭窗口();
}

停止

