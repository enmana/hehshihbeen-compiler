// ============================================================
// 示例65:编辑器视图(`Sample\库\编辑器视图.hb`)—— 把 4-1 那份缓冲画出来
//
//   这一件要证的事:**"一份文本缓冲"能按面板尺寸画出来,而且画出来的每一条都能逐条对表**
//   (画布是宿主给的那 10 条图形原语:清屏 / 画文字 / 画矩形 / 画线 / 刷新 …)。
//
//   库管五样(全在 `编辑器视图.画一屏` 里):
//     · **按可视区裁剪**:只画 `可视首行` 起、`可视行数` 行(与 4-1 的滚屏同一个数);
//     · **行号栏**:右对齐排在栏里(位数多了从左边挤出去);
//     · **当前行底色**:光标那一行先铺一条;
//     · **光标方块**:落在 `正文左 + 光标格 × 每格宽` —— 按**格**算(ASCII 1 格 / 中文 2 格);
//     · **滚动条**:行数比可视行数多才画(槽 + 滑块),滑块高按比例。
//
//   口径(几条要紧的,与 4-1 一脉):
//     · **列宽按格、不按像素**:一格 = `每格宽` 像素;一个中文两格。所以中文行往右排不会歪;
//     · **长行不画到面板右边外面**(整条 `画文字` 不发,不是"画出去让它被裁")——命令表干净;
//     · **`水平偏移`**(长行往右挪几格)也在这件里:挪到整行都在左边看不见就一条都不画;
//     · **它不开窗、不清屏、不 `刷新()`**:那些是主循环的事(`清屏` 与窗口是宿主那一层);
//       本库发的是**"内容"那一批命令**,回来的是条数。
//
//   旁边那份 `事件脚本.txt` 只干一件事:**第 1 帧投一个关窗请求**(本件不测输入,输入是 4-1 的事)
//   —— 所以真窗口上会看到一屏,无头那一路把那一屏的命令逐条打出来,与 `// 预期输出:` 逐行对。
// ============================================================
包含 "../../库/编辑器.hb"
包含 "../../库/编辑器视图.hb"
包含 "../../库/string.hb"

// 一段现成的文本:三行中文 + 一行很长的中文(量"裁剪"那一条)
方法 造文本() 返回 字符串
{
    字符串 换 = 编辑器.换行符();
    字符串 结果;
    拼接到(结果, "第一行中文");
    拼接到(结果, 换);
    拼接到(结果, "abc");
    拼接到(结果, 换);
    拼接到(结果, "短");
    拼接到(结果, 换);
    拼接到(结果, "第四行是个很长的行");
    拼接到(结果, 换);
    拼接到(结果, "L5");
    拼接到(结果, 换);
    拼接到(结果, "L6");
    拼接到(结果, 换);
    拼接到(结果, "L7");
    返回 结果;
}

编辑器.编辑缓冲 编;
编辑器.建编辑器(编, 5);
编辑器.装入文本(编, 造文本());
编辑器.设光标(编, 3, 2);                             // 光标停在"很长的行"第 3 个字上

编辑器视图.面板 屏;
编辑器视图.建面板(屏, 10, 20, 200, 100, 32, 20);     // 左 10 / 上 20 / 宽 200 / 高 100 / 行号栏 32 / 行高 20

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 帧 = 0;
逻辑 收手 = 假;

如果 (打开窗口("编辑器视图", 220, 130))
{
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;
            }
        }
        如果 (帧 == 0)
        {
            整数 条 = 编辑器视图.画一屏(屏, 编);
            输出行(格式化("一屏 {0} 条命令(正文 {1} 宽 {2} 左)", 条, 编辑器视图.正文宽(屏), 编辑器视图.正文左(屏)));
        }
        刷新();
        帧 = 帧 + 1;
        等待(100);
    }
    关闭窗口();
}
输出行(格式化("收尾: 画过 {0} 屏, 光标 {1},{2}, 首行 {3}, 一屏 {4} 行", 屏.帧, 编辑器.光标行(编), 编辑器.光标列(编), 编辑器.可视首行(编), 编辑器视图.一屏行数(屏)));
停止
// 预期输出: 打开窗口 标题="编辑器视图" 宽=220 高=130|一屏 15 条命令(正文 154 宽 48 左)|画矩形 x=10 y=20 宽=200 高=100 颜色=0xFF14141C|画文字 x=34 y=23 文本="3" 颜色=0xFF6A6A80|画文字 x=48 y=23 文本="短" 颜色=0xFFE8E8F0|画矩形 x=11 y=40 宽=191 高=20 颜色=0xFF23233A|画文字 x=34 y=43 文本="4" 颜色=0xFF6A6A80|画文字 x=48 y=43 文本="第四行是个很长的行" 颜色=0xFFE8E8F0|画文字 x=34 y=63 文本="5" 颜色=0xFF6A6A80|画文字 x=48 y=63 文本="L5" 颜色=0xFFE8E8F0|画文字 x=34 y=83 文本="6" 颜色=0xFF6A6A80|画文字 x=48 y=83 文本="L6" 颜色=0xFFE8E8F0|画文字 x=34 y=103 文本="7" 颜色=0xFF6A6A80|画文字 x=48 y=103 文本="L7" 颜色=0xFFE8E8F0|画矩形 x=80 y=42 宽=8 高=16 颜色=0xFF2A6EF0|画矩形 x=202 y=20 宽=8 高=100 颜色=0xFF1C1C26|画矩形 x=203 y=49 宽=6 高=71 颜色=0xFF3A3A55|刷新 命令=15|刷新 命令=0|关闭窗口|收尾: 画过 1 屏, 光标 3,2, 首行 2, 一屏 5 行
