// ============================================================
// 示例53_日志与事件:批 20 那两个库一起走一遍(带窗口)
//   `Sample\库\日志.hb`(分级日志)· `Sample\库\事件.hb`(事件归一 + 分派)
//
//   ① 分级日志:级别闸门 / 时间戳 / 两个开关(控制台 + 文件)/ 滚动那 64 条。
//      时间戳是**墙上的钟**,每次跑都不一样 ⇒ 这一篇**只打"格式与计数"**,
//      不把带时间的那一行写进预期输出(写了就每次都红)。
//   ② 事件归一:宿主那四个裸出参(`取事件(类型, 键码, x, y)`)收进库,再问
//      "这是关窗吗 / 这是按键吗 / 最近按了哪个键 / 鼠标在哪 / 该退出了吗"。
//   ③ 两者接在一起:**每收到一条事件就记一条日志**,再把最近那几条画到窗口上 ——
//      这就是"出事了才回去翻"那只日志窗格最小的一份。
//
//   本工程旁边的 `事件脚本.txt` 是一份**写死的输入**:第几帧投哪个事件。
//   自检与 `hbcc --run --事件脚本 …` 按它喂 ⇒ 不开窗也能把这条循环跑得一模一样
//   (硬规矩 6:不许开窗验证)。跑满脚本里那个 `帧数`(5)帧之后,宿主投一个关窗请求。
//
//   ⚠ 日志那一格按"条"滚动(最近 64 条):窗口里画的就是它 ——
//     所以画面最后停在最后几行,而不是全部日志(长跑时不会把内存吃掉)。
//   ⚠ **时间戳写不进预期输出**(它是墙上的钟,每次跑都不一样)⇒ 这一篇把日志那一路的
//     **控制台出口关掉**(`日志.设控制台(假)`),从此一行带时间的都不往 stdout 写;
//     日志**照旧在记**(环那一路一直在记),只是不往控制台冒 —— 这正是 `设控制台` 那一档的用处:
//     "程序自己的输出要能逐行对"与"人要看最近的日志"是两件事。
// ============================================================

包含 "../../库/日志.hb"
包含 "../../库/事件.hb"
包含 "../../库/string.hb"        // `格式化(...)` 把数字拼成文字要它

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;

整数 帧 = 0;                  // 已经刷新过几帧(帧号从 0 起)
整数 收到几条 = 0;            // 一共收了几个"认得出"的事件(不含那个关窗请求)
整数 最近键 = 0;
整数 最近x = 0;
整数 最近y = 0;

// 日志那一路:级别下限 = 信息(2);文件给空串 ⇒ 不碰盘(示例不落盘)
日志.开始(日志.级别信息(), "");

测试输出(日志.取级别());                 // 2
测试输出(日志.取控制台());               // 1(默认开)
测试输出(日志.调试("这一条被级别挡下"));  // 0(级别闸门:挡下时连串都不拼)
测试输出(日志.统计());                   // 0(挡下的那条不算)
日志.设控制台(假);                       // 从这里起不往 stdout 冒(带时间戳的写不进预期输出)

逻辑 开着 = 打开窗口("HB 日志与事件演示", 460, 320);
如果 (开着)
{
    逻辑 收手 = 假;
    当 (!收手)
    {
        // ---- ① 收事件:这一帧投进来的全取出来(取空了给 假,不阻塞)----
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            事件.送事件(类型, 键码, 鼠标x, 鼠标y);      // 归一:收进库那几格 + 计数
            如果 (事件.归到关窗())
            {
                收手 = 真;                              // 关窗请求:这一帧之后不再画
            }
            否则
            {
                收到几条 = 收到几条 + 1;
                最近键 = 事件.最近键();
                最近x = 事件.最近位置x();
                最近y = 事件.最近位置y();

                // 每收一条就记一条日志(按类型分档:按键记"信息"、鼠标记"调试")
                如果 (事件.归到按键())
                {
                    如果 (事件.可打字键(最近键))
                    {
                        日志.信息("按下了一个可打字键");
                    }
                    否则
                    {
                        日志.警告("按下了一个功能键");
                    }
                }
                否则
                {
                    日志.调试("鼠标位置变了");
                }

                测试输出(帧);                    // 这条事件是在第几帧收到的
                测试输出(事件.最近类型());
                测试输出(最近键);
                测试输出(最近x);
                测试输出(最近y);
                测试输出(事件.计数());
            }
        }

        如果 (!收手)
        {
            // ---- ② 重画:即时模式,每帧从头画一遍 ----
            字符串 一行 = "";
            清屏(0xFF101018);
            画文字(10, 10, "HB 日志与事件:按任意键 / 点一下鼠标 / 敲 Esc 退出", 0xFFD0D0D8);

            拼接到(一行, "事件 ");
            拼接到(一行, 格式化("{0}", 事件.计数()));
            拼接到(一行, " 条 / 已刷新 ");
            拼接到(一行, 格式化("{0}", 帧));
            拼接到(一行, " 帧 / 日志 ");
            拼接到(一行, 格式化("{0}", 日志.统计()));
            拼接到(一行, " 条");
            画文字(10, 32, 一行, 0xFFB0B0B8);

            一行 = "";
            拼接到(一行, "最近:类型 ");
            拼接到(一行, 格式化("{0}", 事件.最近类型()));
            拼接到(一行, " 键码 ");
            拼接到(一行, 格式化("{0}", 最近键));
            拼接到(一行, " 位置 ");
            拼接到(一行, 格式化("{0}", 最近x));
            拼接到(一行, ",");
            拼接到(一行, 格式化("{0}", 最近y));
            画文字(10, 50, 一行, 0xFFE8E8F0);

            画文字(10, 74, "日志那一路(最近 64 条;窗口里画的是与时钟无关的那一份):", 0xFF8CA0C0);

            // ⚠ 这里**故意不把库里那几行原样画出来**:那几行带时间戳(墙上的钟),
            //    画上去就等于把"每次跑都不一样"的字写进 文件末尾那行注释 —— 那一行要逐段对。
            //    所以窗口里画的是**与时钟无关**的那一份:四档级别名 + 哪几档会记。
            //    要看带时间戳的原文:把那句 `日志.设控制台(假)` 去掉,控制台上就有。
            整数 画到 = 0;
            整数 级别 = 1;
            当 (级别 <= 4)
            {
                字符串 段 = "";
                拼接到(段, "  ");
                拼接到(段, 日志.级别名(级别));
                拼接到(段, "  ");
                如果 (级别 >= 日志.取级别())
                {
                    拼接到(段, "会记");
                }
                否则
                {
                    拼接到(段, "被挡下");
                }
                画文字(10, 96 + 画到 * 20, 段, 0xFF7BFFB0);
                画到 = 画到 + 1;
                级别 = 级别 + 1;
            }

            画文字(10, 196, "Esc 等于关窗那一档(事件.要退出() 会立起来)", 0xFF8CA0C0);
            一行 = "";
            拼接到(一行, "要退出 = ");
            如果 (事件.要退出())
            {
                拼接到(一行, "真");
            }
            否则
            {
                拼接到(一行, "假");
            }
            画文字(10, 214, 一行, 0xFFE8E8F0);

            // ---- ③ 刷新:不调用就一直不显示 ----
            刷新();

            帧 = 帧 + 1;
            等待(16);                            // 让出一帧,别把 CPU 烧满(无头不真等)
        }
    }

    测试输出(帧);                                // 跑满了多少帧(事件脚本里写的是 5)
    测试输出(收到几条);                          // 5 条(回车 / 移动 / 按下 / 抬起 / A)——
                                                 //   Esc 那一条不在里面:它是"关窗那一档",见下
    测试输出(事件.计数());                       // 6(Esc 也送进来了,只是归到退出那一档)
    测试输出(事件.要退出());                     // 1(Esc 那一档立起来的,不必等关窗请求)
    测试输出(事件.最近类型());                   // 1(最后那一个是关窗请求)
    测试输出(日志.统计());                       // 6(窗口要开了 + 5 条事件)
    测试输出(日志.落盘());                       // 0(没接文件)
    测试输出(日志.取控制台());                   // 0(这一篇把它关了)
    字符串 尾巴 = 日志.取文本();
    // 带时间戳的那几行写不进预期输出,所以这里只量**与时钟无关**的那两件:
    //   ① 环里确实攒下了东西(`>= 60` 是一行的下界:时间戳模板 19 + 两格级别 + 空格 + 一条消息);
    //   ② 控制台关了**不影响**环那一路 —— 这一条正是"三个出口各走各的"的判据。
    测试输出(尾巴.长度() >= 60);                 // 1
    测试输出(日志.信息("收工"));                 // 1(控制台关了,环里照记)
    测试输出(日志.统计());                       // 7

    关闭窗口();
}

停止
// 预期输出: 2|1|0|0|打开窗口 标题="HB 日志与事件演示" 宽=460 高=320|0|2|13|0|0|1|清屏 颜色=0xFF101018|画文字 x=10 y=10 文本="HB 日志与事件:按任意键 / 点一下鼠标 / 敲 Esc 退出" 颜色=0xFFD0D0D8|画文字 x=10 y=32 文本="事件 1 条 / 已刷新 0 帧 / 日志 1 条" 颜色=0xFFB0B0B8|画文字 x=10 y=50 文本="最近:类型 2 键码 13 位置 0,0" 颜色=0xFFE8E8F0|画文字 x=10 y=74 文本="日志那一路(最近 64 条;窗口里画的是与时钟无关的那一份):" 颜色=0xFF8CA0C0|画文字 x=10 y=96 文本="  调试  被挡下" 颜色=0xFF7BFFB0|画文字 x=10 y=116 文本="  信息  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=136 文本="  警告  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=156 文本="  错误  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=196 文本="Esc 等于关窗那一档(事件.要退出() 会立起来)" 颜色=0xFF8CA0C0|画文字 x=10 y=214 文本="要退出 = 假" 颜色=0xFFE8E8F0|刷新 命令=11|1|3|0|120|55|2|清屏 颜色=0xFF101018|画文字 x=10 y=10 文本="HB 日志与事件:按任意键 / 点一下鼠标 / 敲 Esc 退出" 颜色=0xFFD0D0D8|画文字 x=10 y=32 文本="事件 2 条 / 已刷新 1 帧 / 日志 1 条" 颜色=0xFFB0B0B8|画文字 x=10 y=50 文本="最近:类型 3 键码 0 位置 120,55" 颜色=0xFFE8E8F0|画文字 x=10 y=74 文本="日志那一路(最近 64 条;窗口里画的是与时钟无关的那一份):" 颜色=0xFF8CA0C0|画文字 x=10 y=96 文本="  调试  被挡下" 颜色=0xFF7BFFB0|画文字 x=10 y=116 文本="  信息  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=136 文本="  警告  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=156 文本="  错误  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=196 文本="Esc 等于关窗那一档(事件.要退出() 会立起来)" 颜色=0xFF8CA0C0|画文字 x=10 y=214 文本="要退出 = 假" 颜色=0xFFE8E8F0|刷新 命令=11|2|4|1|40|52|3|2|5|1|40|52|4|清屏 颜色=0xFF101018|画文字 x=10 y=10 文本="HB 日志与事件:按任意键 / 点一下鼠标 / 敲 Esc 退出" 颜色=0xFFD0D0D8|画文字 x=10 y=32 文本="事件 4 条 / 已刷新 2 帧 / 日志 1 条" 颜色=0xFFB0B0B8|画文字 x=10 y=50 文本="最近:类型 5 键码 1 位置 40,52" 颜色=0xFFE8E8F0|画文字 x=10 y=74 文本="日志那一路(最近 64 条;窗口里画的是与时钟无关的那一份):" 颜色=0xFF8CA0C0|画文字 x=10 y=96 文本="  调试  被挡下" 颜色=0xFF7BFFB0|画文字 x=10 y=116 文本="  信息  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=136 文本="  警告  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=156 文本="  错误  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=196 文本="Esc 等于关窗那一档(事件.要退出() 会立起来)" 颜色=0xFF8CA0C0|画文字 x=10 y=214 文本="要退出 = 假" 颜色=0xFFE8E8F0|刷新 命令=11|3|2|65|0|0|5|清屏 颜色=0xFF101018|画文字 x=10 y=10 文本="HB 日志与事件:按任意键 / 点一下鼠标 / 敲 Esc 退出" 颜色=0xFFD0D0D8|画文字 x=10 y=32 文本="事件 5 条 / 已刷新 3 帧 / 日志 2 条" 颜色=0xFFB0B0B8|画文字 x=10 y=50 文本="最近:类型 2 键码 65 位置 0,0" 颜色=0xFFE8E8F0|画文字 x=10 y=74 文本="日志那一路(最近 64 条;窗口里画的是与时钟无关的那一份):" 颜色=0xFF8CA0C0|画文字 x=10 y=96 文本="  调试  被挡下" 颜色=0xFF7BFFB0|画文字 x=10 y=116 文本="  信息  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=136 文本="  警告  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=156 文本="  错误  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=196 文本="Esc 等于关窗那一档(事件.要退出() 会立起来)" 颜色=0xFF8CA0C0|画文字 x=10 y=214 文本="要退出 = 假" 颜色=0xFFE8E8F0|刷新 命令=11|4|2|27|0|0|6|清屏 颜色=0xFF101018|画文字 x=10 y=10 文本="HB 日志与事件:按任意键 / 点一下鼠标 / 敲 Esc 退出" 颜色=0xFFD0D0D8|画文字 x=10 y=32 文本="事件 6 条 / 已刷新 4 帧 / 日志 3 条" 颜色=0xFFB0B0B8|画文字 x=10 y=50 文本="最近:类型 2 键码 27 位置 0,0" 颜色=0xFFE8E8F0|画文字 x=10 y=74 文本="日志那一路(最近 64 条;窗口里画的是与时钟无关的那一份):" 颜色=0xFF8CA0C0|画文字 x=10 y=96 文本="  调试  被挡下" 颜色=0xFF7BFFB0|画文字 x=10 y=116 文本="  信息  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=136 文本="  警告  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=156 文本="  错误  会记" 颜色=0xFF7BFFB0|画文字 x=10 y=196 文本="Esc 等于关窗那一档(事件.要退出() 会立起来)" 颜色=0xFF8CA0C0|画文字 x=10 y=214 文本="要退出 = 真" 颜色=0xFFE8E8F0|刷新 命令=11|5|6|7|1|1|3|0|0|1|1|4|关闭窗口
