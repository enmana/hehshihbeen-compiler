// ============================================================
// 示例45_中文文本(G4 批 13:`中文.hb`)
//
//   一段真用得上的活:**把中文这一层的东西收干净** ——
//     ① **名单**:一个字一个字地看(几个汉字、把非汉字滤掉);
//     ② **全角半角**:用户从全角输入法粘进来的 `ＡＢＣ１２３` 先转半角再比;
//     ③ **UTF-8 一字**:一份字节流里第几个字节是哪个字(落在字中间要认得出来);
//     ④ **中文数字**:`一万零五` / `二零二六` 读成整数,认不出的(如 `十十`)给假;
//     ⑤ **金额大写**:报销单上那套大写。
//
//   三条口径(演示里照它走):
//     ① **长度与下标按文字算,字节位置要自己走**(`UTF8解码一字` 拿 `起` 是第几个字节,
//        回来时 `宽` 告诉你这个字占几个字节,一步就能跳到下一个字);
//     ② **认不出就给假 / `-1`,不猜**(`十十` 这种形态给假;落在字中间的字节位置也是 `-1`);
//     ③ **写出去的那一套自带口径**:`整数转中文数字` 是小写(负数写"负"),
//        票据那种大写走 `金额大写`(`拾` 不省、末尾写"整")。
// ============================================================
包含 "../../库/中文.hb"

// ---------------- ① 名单:一个字一个字地看 ----------------
字符串 名单 = "① 张三丰 2026 〇";
输出行(名单.长度());                       // 12 个文字(长度按文字算:含空格、① 与 〇)
输出行(中文.汉字个数(名单));                // 4:张 三 丰 〇
输出行(中文.只留汉字(名单));                // 张三丰〇

// ---------------- ② 全角半角:全角输入法粘进来的东西 ----------------
字符串 用户输入 = "ＡＢＣ１２３";
输出行(用户输入);                          // 原样
输出行(中文.转半角(用户输入));              // 转成 ASCII 之后才能当编码用
输出行(中文.转全角("abc123"));              // 反过来
输出行(中文.是全角('Ａ'));                  // 1(全角)/ 0(半角)
输出行(中文.是全角('A'));

// ---------------- ③ UTF-8 一字:按字节走一份报文 ----------------
字符串 报文 = "中a";
输出行(中文.UTF8字节数(报文));              // 4:一个汉字 3 个字节 + 一个 ASCII
整数 宽 = 0;
输出行(中文.UTF8解码一字(报文, 0, 宽));     // 20013(就是"中")
输出行(宽);                                // 3
输出行(中文.UTF8解码一字(报文, 3, 宽));     // 97(就是"a")
输出行(宽);                                // 1
输出行(中文.UTF8解码一字(报文, 2, 宽));     // -1:第 2 个字节落在"中"中间
输出行(中文.UTF8编码一字(0x1F600));         // 😀(码点编回字节串)

// ---------------- ④ 中文数字:读与写 ----------------
整数 值 = 0;
输出行(中文.中文数字转整数("一万零五", 值));       // 1
输出行(值);                                       // 10005
输出行(中文.中文数字转整数("二零二六", 值));       // 1(逐位读)
输出行(值);                                       // 2026
输出行(中文.中文数字转整数("十十", 值));           // 0:形态不合法
输出行(值);                                       // 0(认不出就把值清零)
输出行(中文.整数转中文数字(20261005));             // 写回去

// ---------------- ⑤ 金额大写:票据那一套 ----------------
输出行(中文.金额大写(12345));               // 123.45 元
输出行(中文.金额大写(10005));               // 100.05 元
输出行(中文.金额大写(0));                   // 0 元

停止

// 预期输出: 12|4|张三丰〇|ＡＢＣ１２３|ABC123|ａｂｃ１２３|1|0|4|20013|3|97|1|-1|😀|1|10005|1|2026|0|0|二千零二十六万一千零五|壹佰贰拾叁元肆角伍分|壹佰元零伍分|零元整
