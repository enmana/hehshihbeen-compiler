// ============================================================
// 示例05:结构与引用 —— 结构定义、字段读写、嵌套、结构数组、引用参数、取址
//
// 这个示例演示什么:结构怎么定义、字段怎么读写、怎么让子程序"改调用方那一份"。
// 重点看哪几处:
//   ① 结构定义与字段读写:结构类型本身不占存储,`点 q;` 声明时才按总宽度分配;
//      字段按声明顺序紧排,访问靠编译期偏移(`q.y` 偏移 4)。
//   ② 字段自增 / 字段当条件:`q.x++`、`如果 (l.begin.x > 0)` 都行,字段就是"结构里的变量"。
//   ③ 嵌套结构:字段类型可以是另一个结构 —— `l.begin.x` 点着走,偏移全是编译期算好的。
//   ④ 结构数组:字段可以是结构数组(`点 cells[3]`),变量也能是结构数组(`点 队[3]`);
//      `队[1].y` 就是结构数组元素里的字段,常量下标编译期算偏移,变量下标运行期算地址。
//   ⑤ 引用参数 `引用 点 p`:调用处直接写 p,编译器自动取地址 —— 被调方改的就是调用方那个对象;
//      `引用 短整数 cnt` 连"结构里的一个字节字段"都能直接改。
//   ⑥ `地址(...)`:取出变量/字段/数组元素/整个结构的地址(一个 32 位字),
//      能当值参与算术(两个字段地址相减 = 那个字段的偏移),也能当实参递给只认地址的函数。
//
// 关键字中英等价(如果=if、函数=func、返回=return、当=while),标识符随便起,
// 中文优先只是默认;本示例标识符一律用短英文。
// 本示例不需要任何库,单独就能编译运行。
//   (带 UI 的那一半要把数字拼进文字,所以文件头多了一行 `包含 "../../库/string.hb"`;
//    纯计算那一段照旧不依赖任何库,`库\` 里也仍旧是零依赖纯 HB。)
//
//   ============================================================
//   怎么看(带 UI;H82 批 3)—— 这一份也是"能开窗就开窗"的写法:
//
//     · **桌面上看**:IDE 里 运行 → 执行(F5);窗口标题是 `示例05 结构与引用`。
//       窗口里演的就是上面这些结构变量**现在的样子**,一栏一件事:
//         左栏 = **结构实例的字段格子**:一个字段一行(字段名 / 类型 / 偏移 / 现在装的值),
//           八行分别是 `q.x` `q.y` `队[1].y` `l.end.y` `t.cells[2].y` `t.cnt` `l.begin.x` `l.end.x`;
//           偏移不是抄来的常数 —— 是开窗前用 `地址(...)` 相减**真算出来的**(与上面那条断言同一口径);
//         右栏 = **引用那一头**:一行一个"谁指着谁"(`引用 点 p` / `引用 整数 ry` / 变量 pa /
//           `引用 字节 cnt` / R5 取址 / R3 取址),两栏之间那条连线就是"指着"这件事本身;
//         底下两行 = 亮着这一格的**偏移 / 现在的值 / 谁引用它**。
//     · **点一下就换**:点左栏某一行 ⇒ 亮那一格,**凡是指着它的那几行一起亮**、一行连一条线过去
//       (`q.x` 就被 `引用 点 p` 与 R5 取址两处指着,于是两行两条线);点右栏某一行 ⇒ 反过来亮它指着的那一格。
//     · **逐帧推进**:每帧高亮沿字段往下走一格(第 8 行绕回第 1 行);旁边那份 `事件脚本.txt`
//       在第 2、6、11、15、19 帧各投一次点击(左栏两下、右栏两下,还有一下点"没人指"的那一格)。
//     · **窗口一直转到你自己关掉**(点标题栏的叉);自检 / 命令行那份脚本跑满 20 帧就投关窗请求;
//       顺序上仍旧是"数在前、开窗在后"—— 末尾那行 `// 预期输出:` 里那 18 个数一个字没变。
//   ============================================================

包含 "../../库/string.hb"        // `转字符串` 在库里(把数字拼进文字要用它;纯 HB,零依赖)

结构 点
{
    整数 x;
    整数 y;
}

结构 线段
{
    点 begin;          // 结构里放结构
    点 end;
}

结构 队伍
{
    点 cells[3];       // 结构里放结构数组
    字节 cnt;
}

// ⑤ 引用参数:改了就是改调用方那份(不用 地址(...),编译器自动取地址)
方法 移动(引用 点 p, 整数 dx, 整数 dy)
{
    p.x = p.x + dx;
    p.y = p.y + dy;
}

// ⑤ 引用参数也能指向"结构里的一个标量字段":字节字段照样改得动
方法 加一(引用 字节 cnt)
{
    cnt = cnt + 1;
}

// ⑥ 只认地址的参数:参数写成 `变量`(32 位字)时是**值传递** ——
//    递进去的就是"地址这个数",被调方把它当指针用,按那个地址读改内存。
方法 存整数(变量 pa, 整数 n)
{
    R1 = pa;
    取字间接 R2 R1            // R2 = *addr
    R2 = R2 + n;
    存字间接 R2 R1            // *addr = R2
}

// ============================================================
// ① 结构定义 + 字段读写 + 字段自增 + 字段当条件
// ============================================================
点 q;
q.x = 5;
q.y = 3;
q.x++;                          // 字段自增 = q.x = q.x + 1
q.y = q.y + 4;
if (q.x > 0)                    // 字段当条件(英文 if 一样认)
{
    q.y++;
}
测试输出(q.x);                  // 6
测试输出(q.y);                  // 8

// ② 引用参数:直接改调用方那份
移动(q, 10, 20);
测试输出(q.x);                  // 16
测试输出(q.y);                  // 28

// ③ 引用变量:指向谁,通过它写进去的就是谁
引用 整数 ry = q.y;
ry = 7;
测试输出(q.y);                  // 7

// ④ 结构数组(变量):常量下标 & 变量下标
点 队[3];
队[0].x = 1;
队[1].x = 2;
队[1].y = 3;
队[2].x = 4;
测试输出(队[1].y);              // 3
var i = 2;
队[i].x = 40;                   // 变量下标:运行期算地址(基址 + i × 8)
测试输出(队[i].x);              // 40

// ⑤ 嵌套结构:两层点着走
线段 l;
l.begin.x = 3;
l.begin.y = 4;
l.end.x = 5;
l.end.y = 6;
// ⑥ `地址(...)` 取字段地址,当实参递给"只认地址"的函数
存整数(地址(l.end.y), 3);      // 拿到 l.end.y 的地址,按那个地址改内存
测试输出(l.end.y);              // 9

// ⑥ 取址:两个字段地址相减 = 那个字段的偏移(点 是 8 字节,y 在第 4 个字节)
测试输出(地址(q.y) - 地址(q.x));   // 4

// ⑦ 地址拿到手以后,自己用指令读写。汇编行只认寄存器,所以地址直接进寄存器
//    (地址也可以落成具名变量 —— 它是个跟布局有关的数,自检按"槽内偏移"判,见手册《取址》一节)
R5 = 地址(q.x);
取字间接 R6 R5
R6 = R6 + 100;
存字间接 R6 R5
测试输出(q.x);                  // 116

// ⑧ 结构里的结构数组字段:队伍.cells[2].y
队伍 t;
t.cells[2].y = 9;
t.cnt = 1;
测试输出(t.cells[2].y);         // 9

// ⑨ 引用参数指向"结构里的那个字节字段"
加一(t.cnt);
测试输出(t.cnt);                // 2

// ⑩ 数组元素也能取址:`地址(队[1])` 就是那个元素的地址(元素间距 = 结构宽度 8 字节)
//    拿到元素地址以后,字段按偏移自己走(y 比元素起点多 4 个字节)。
//    写汇编行时只能用**寄存器**当操作数(汇编器不认识变量),所以地址直接进 R3
R3 = 地址(队[1]);
加立即数 R3 4                  // R3 = 队[1] 的地址 + 4 = 队[1].y 的地址
取字间接 R4 R3                 // R4 = 队[1].y
R4 = R4 + 100;
存字间接 R4 R3                 // 队[1].y = R4
测试输出(队[1].y);             // 103
测试输出(地址(队[1]) - 地址(队[0]));   // 8:结构数组的元素间距 = 结构宽度

// ⑪ 结构里也能声明方法(H60 步④):`方法 …` 写在结构体里(**必须写 `方法` 关键字**,数据与方法一眼分得开),
//    方法体里的字段名走**收方** —— 改的就是那一份实例本身(编译成"收方 + 常量偏移",不多任何运行期机制)
结构 分数
{
    整数 分子;
    整数 分母;
    方法 值() 返回 整数
    {
        返回 分子 * 100 / 分母;
    }
    方法 翻倍()
    {
        分子 = 分子 * 2;
    }
}
分数 半;
半.分子 = 1;
半.分母 = 2;
测试输出(半.值());              // 50
半.翻倍();
测试输出(半.值());              // 100(改的就是 半 这一份)
分数 三分之一;
三分之一.分子 = 1;
三分之一.分母 = 3;
测试输出(分数.值(三分之一));     // 33(写全:`结构名.方法(实例, …)`,收方当第一个实参传)
测试输出(半.值());              // 100(那一份没被动过)

// ============================================================
// ---- 带 UI 的那一半(H82 批 3)----
// 只在**真开得了窗口**时才跑:没有图形能力的宿主给 假 ⇒ 一个字都不多打;
// 上面那 18 个数还是那 18 个数(顺序、条数一个字没动)。
//
//   左栏 = 结构实例的字段格子(字段名 / 类型 / 偏移 / 现在装的值,一个字段一行);
//   右栏 = 引用那一头(一行一个"谁指着谁"),点左栏某一行 ⇒ 指着它的那几行一起亮、一行连一条线过去;
//   底下两行 = 这一格的偏移 / 现在的值 / 谁引用它;每帧高亮沿字段往下走一格。
// ⚠ 主循环(每帧都跑的那一层)里**一条字符串都不产生**:要画的字全在开窗前拼好,每帧只按下标取。
//   实测口径:主循环里每帧现拼几十条,几百帧就把编译器那个字符串池吃光(`示例02` 撞过 209 帧)。
// ============================================================

// ---- 窗口尺寸与摆位:**手算过的一组数**(画图与命中测试用的是同一组)----
//   宽 560:左栏 12~252(四列:字段 20 / 类型 132 / 偏移 190 / 值 222);右栏 264~548
//   高 580:页眉 12~72 / 两栏标题 80~96 / 列头 99 / 八行 112~352 / 底下两行 380~436 / 说明 452~560
整数 窗宽 = 560;
整数 窗高 = 580;
整数 行顶 = 112;                  // 两栏第一行的顶边
整数 行高 = 30;                   // 一行多高(= 命中测试的除数)
整数 左宽 = 240;                  // 左栏一行多宽
整数 右左 = 264;                  // 右栏的左边
整数 右宽 = 284;                  // 右栏一行多宽

// ---- 窗口自己那点状态:写在**顶层**(照模板;不藏在嵌套里)----
整数 类型 = 0;                    // 取事件那四个出参
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;
整数 点x = 0;                     // 这一帧"点一下"点在哪(先记下来,浅一层再结算)
整数 点y = 0;
整数 光标 = 0;                    // 现在亮着的是左栏第几格(0~7)
逻辑 有一下 = 假;                 // 这一帧收到过"点一下"没有

// ---- 这一屏要画的字:全部在**开窗之前**拼好(进主循环之后一条都不再拼)----
// ⚠ `字符串` 数组不能在声明时给初值,只能一条条填;数字类的初值要写在一行里。
字符串 名字列[8];                // 左栏第 1 列:字段名
字符串 类型列[8];                // 左栏第 2 列:字段类型
字符串 偏移列[8];                // 左栏第 3 列:在**自己那个实例**里的偏移(带 + 号)
字符串 值列[8];                  // 左栏第 4 列:现在装的值(开窗前转成文字)
字符串 引述列[6];                // 右栏六行:引用 / 取址的写法,以及它指着哪一格
字符串 详一列[8];                // 底下第一行:这一格是谁、偏移多少、现在装着什么
字符串 详二列[8];                // 底下第二行:谁引用它
整数 格偏移[8];                  // 八格各自的偏移(开窗前用 `地址(...)` 相减真算)
整数 格值[8];                    // 八格现在装着的值
// 右栏第 j 行指着左栏哪一格(-1 = 这一格没人指;一个字段可以被好几行指着 ⇒ 那几行一起亮)。
// 点左栏某一行 ⇒ 右栏凡是指着它的都亮;点右栏某一行 ⇒ 亮它指着的那一格 —— 两边互为反查。
整数 右到左[6] = [0, 1, 3, 5, 0, 2];

// ---- 八格的偏移:同一实例里两个字段地址相减 —— 与上面 `地址(q.y) - 地址(q.x)` 同一条口径 ----
//      (地址是个跟布局有关的数,所以只拿**同一个实例里**的两个地址相减;跨变量的差没有意义)
格偏移[0] = 0;                                          // 结构里第 1 个字段永远在偏移 0
格偏移[1] = 地址(q.y) - 地址(q.x);                      // 4
格偏移[2] = 地址(队[1].y) - 地址(队[1].x);              // 4:元素**里面**的偏移(队[1] 比 队[0] 多 8 字节)
格偏移[3] = 地址(l.end.y) - 地址(l.begin.x);            // 12:嵌套点着走,偏移全是编译期算好的
格偏移[4] = 地址(t.cells[2].y) - 地址(t.cells[0].x);    // 20:结构里那个结构数组字段
格偏移[5] = 地址(t.cnt) - 地址(t.cells[0].x);           // 24:尾上那个 1 字节字段
格偏移[6] = 0;                                          // 线段 l 的头一格
格偏移[7] = 地址(l.end.x) - 地址(l.begin.x);            // 8

// ---- 八格现在装着的值(上面那 18 条断言跑完之后的实况)----
格值[0] = q.x;                    // 116(先被 移动(q,…) 改,又被 R5 取址改)
格值[1] = q.y;                    // 7(ry = 7 写进去的)
格值[2] = 队[1].y;                // 103(R3 取址 +100)
格值[3] = l.end.y;                // 9(存整数 按地址 +3)
格值[4] = t.cells[2].y;           // 9
格值[5] = t.cnt;                  // 2(加一(t.cnt))
格值[6] = l.begin.x;              // 3
格值[7] = l.end.x;                // 5

// ---- 每一格要说的那几句话(一个字面量一条分支;拆成几个小函数,免得一个函数堆太多分支)----
方法 名字文(整数 i) 返回 字符串
{
    字符串 s = "?";
    如果 (i == 0)
    {
        s = "q.x";
    }
    如果 (i == 1)
    {
        s = "q.y";
    }
    如果 (i == 2)
    {
        s = "队[1].y";
    }
    如果 (i == 3)
    {
        s = "l.end.y";
    }
    如果 (i == 4)
    {
        s = "t.cells[2].y";
    }
    如果 (i == 5)
    {
        s = "t.cnt";
    }
    如果 (i == 6)
    {
        s = "l.begin.x";
    }
    如果 (i == 7)
    {
        s = "l.end.x";
    }
    返回 s;
}

方法 类型文(整数 i) 返回 字符串
{
    如果 (i == 5)
    {
        返回 "字节";
    }
    // 八格里只有 t.cnt 是个 1 字节字段
    返回 "整数";
}

方法 位置文(整数 i) 返回 字符串
{
    字符串 s = "?";
    如果 (i == 0)
    {
        s = "点 q 第 1 格";
    }
    如果 (i == 1)
    {
        s = "点 q 第 2 格";
    }
    如果 (i == 2)
    {
        s = "队[1] 第 2 格";
    }
    如果 (i == 3)
    {
        s = "线段 l 第 4 格";
    }
    如果 (i == 4)
    {
        s = "队伍 t 第 3 格";
    }
    如果 (i == 5)
    {
        s = "队伍 t 尾格";
    }
    如果 (i == 6)
    {
        s = "线段 l 第 1 格";
    }
    如果 (i == 7)
    {
        s = "线段 l 第 3 格";
    }
    返回 s;
}

方法 引文(整数 i) 返回 字符串
{
    字符串 s = "?";
    如果 (i == 0)
    {
        s = "引用 点 p(移动)与 R5 取址 —— 都指着这一格";
    }
    如果 (i == 1)
    {
        s = "引用 整数 ry —— 给 ry 赋值就是改这一格";
    }
    如果 (i == 2)
    {
        s = "R3 取 队[1] 的地址再 +4 —— 按地址改的就是这一格";
    }
    如果 (i == 3)
    {
        s = "变量 pa 存着这一格的地址,存整数 按它改";
    }
    如果 (i == 4)
    {
        s = "没人指着 —— 结构数组字段里的格子只能点着走";
    }
    如果 (i == 5)
    {
        s = "引用 字节 cnt(加一) —— 改的就是这一格";
    }
    如果 (i == 6)
    {
        s = "没人指着 —— 第 1 个字段永远在偏移 0";
    }
    如果 (i == 7)
    {
        s = "没人指着 —— 这一格只能按 名字 + 偏移 走到";
    }
    返回 s;
}

// ---- 开窗前那一次拼装:八格 × 五行,之后主循环里一条都不再拼 ----
// ⚠ 值也必须在这儿转成文字 —— 主循环里写 `转字符串(格值[i])` 就是"返回字符串的调用当实参",
//   每调用一次漏一块池(16 帧的脚本看不出来,真窗口挂几百帧就报「池用完了」)。
整数 填 = 0;
当 (填 < 8)
{
    名字列[填] = 名字文(填);
    类型列[填] = 类型文(填);
    字符串 偏 = "+";
    拼接到(偏, 转字符串(格偏移[填]));
    偏移列[填] = 偏;
    值列[填] = 转字符串(格值[填]);

    字符串 句 = "这一格:";
    拼接到(句, 名字列[填]);          // ⚠ 数组元素不能当赋值右值 —— 交给 `拼接到` 接上去
    拼接到(句, " —— ");
    拼接到(句, 位置文(填));
    拼接到(句, ",偏移 ");
    拼接到(句, 偏移列[填]);
    拼接到(句, ",现在装着 ");
    拼接到(句, 值列[填]);
    详一列[填] = 句;

    字符串 谁 = "谁引用它:";
    拼接到(谁, 引文(填));
    详二列[填] = 谁;

    填 = 填 + 1;
}

// ---- 右栏六行:一行一个"谁指着谁"(带数的那两行,数从 偏移列 接上去 —— 与左栏同一个数)----
字符串 行 = "";
行 = "引用 点 p(移动)⇒ q 整个实例";
引述列[0] = 行;
行 = "引用 整数 ry ⇒ q.y 偏移 ";
拼接到(行, 偏移列[1]);
引述列[1] = 行;
行 = "变量 pa 存 l.end.y 的地址,偏移 ";
拼接到(行, 偏移列[3]);
引述列[2] = 行;
行 = "引用 字节 cnt ⇒ t.cnt 偏移 ";
拼接到(行, 偏移列[5]);
引述列[3] = 行;
行 = "R5 取 q.x 的地址:按地址改";
引述列[4] = 行;
行 = "R3 取 队[1] 的地址 + 4 ⇒ 队[1].y";
引述列[5] = 行;

逻辑 开着 = 打开窗口("示例05 结构与引用", 窗宽, 窗高);
如果 (开着)
{
    逻辑 收手 = 假;

    // 主循环:收事件 → 结算点击 → 重画 → 刷新,转到用户自己关窗(或事件脚本投来关窗请求)
    当 (!收手)
    {
        当 (取事件(类型, 键码, 鼠标x, 鼠标y))
        {
            如果 (类型 == 1)
            {
                收手 = 真;                     // 关窗请求:这一帧之后不再画
            }
            否则
            {
                // 鼠标"点一下" = 按下 + 抬起(抬起那一刻才算数):先把这一次点击记下来
                如果 (类型 == 5)
                {
                    有一下 = 真;
                    点x = 鼠标x;
                    点y = 鼠标y;
                }
            }
        }

        // 点击结算:**单独摆在这一层**(命中测试与赋值别塞进上面那串嵌套里,塞进去实测不落地)。
        // 点左栏某一行 ⇒ 亮那一格;点右栏某一行 ⇒ 反过来亮它指着的那一格(两栏是同一件事)。
        // ⚠ 两处命中各自带着自己的矩形(左 12~252 / 右 264~548),y 上界也要卡住 ——
        //   少了上界,点底下的说明文字会被上面那一条按 y 接走。
        如果 (有一下)
        {
            有一下 = 假;
            如果 (点x >= 12 && 点x < 12 + 左宽 && 点y >= 行顶 && 点y < 行顶 + 8 * 行高)
            {
                光标 = (点y - 行顶) / 行高;
            }
            如果 (点x >= 右左 && 点x < 右左 + 右宽 && 点y >= 行顶 && 点y < 行顶 + 6 * 行高)
            {
                整数 行号 = (点y - 行顶) / 行高;
                光标 = 右到左[行号];
            }
        }

        如果 (!收手)
        {
            // ---- 重画:即时模式,每帧从头画一遍(这一层一条字符串都不再拼:画的都是开窗前拼好的)----
            清屏(0xFF101018);
            画矩形(12, 12, 窗宽 - 24, 60, 0xFF2A3550);
            画文字(24, 18, "示例05 结构与引用:结构在内存里,引用指着谁", 0xFFE8E8F0);
            画文字(24, 42, "左栏一格 = 一个字段,右栏一行 = 一个引用", 0xFFB0B0B8);

            // ⚠ 底色一律画在文字**之前**:`画矩形` 是不透明实心,画在文字后面会把那一行的字盖掉
            //   (无头呈现看不出来,桌面壳上才看得出来 —— 「盖字检查」那条几何机检逮的就是这个)。
            画矩形(12, 80, 左宽, 16, 0xFF232B3E);
            画文字(20, 81, "结构实例的字段格子", 0xFF9CC4FF);
            画矩形(右左, 80, 右宽, 16, 0xFF232B3E);
            画文字(272, 81, "引用那一头:谁指着哪一格", 0xFF9CC4FF);

            // 两栏的列头
            画文字(20, 99, "字段", 0xFF8A8A96);
            画文字(132, 99, "类型", 0xFF8A8A96);
            画文字(190, 99, "偏移", 0xFF8A8A96);
            画文字(222, 99, "值", 0xFF8A8A96);
            画文字(272, 99, "引用 / 取址的写法 ⇒ 指着哪一格", 0xFF8A8A96);

            // 左栏八行:一个字段一行(底色先画、字后画)
            var i = 0;
            当 (i < 8)
            {
                var y = 行顶 + i * 行高;
                如果 (i == 光标)
                {
                    画矩形(12, y, 左宽, 26, 0xFF2A6EF0);          // 这一帧亮着的字段:蓝底
                }
                否则
                {
                    画矩形(12, y, 左宽, 26, 0xFF1E2430);
                }
                画文字(20, y + 6, 名字列[i], 0xFFE8E8F0);
                画文字(132, y + 6, 类型列[i], 0xFFB0B0B8);
                画文字(190, y + 6, 偏移列[i], 0xFF9CC4FF);
                画文字(222, y + 6, 值列[i], 0xFFD0D0D8);
                i = i + 1;
            }

            // 右栏六行:一行一个"谁指着谁" —— **凡是指着左边这一格的都亮**(一个字段可以被好几处指着:
            // 比如 q.x 既被 `引用 点 p` 改、也被 R5 取址改,那就两行一起亮、两条连线一起连过去)。
            var j = 0;
            当 (j < 6)
            {
                var y2 = 行顶 + j * 行高;
                如果 (右到左[j] == 光标)
                {
                    画矩形(右左, y2, 右宽, 26, 0xFF2A6EF0);
                }
                否则
                {
                    画矩形(右左, y2, 右宽, 26, 0xFF1E2430);
                }
                画文字(272, y2 + 6, 引述列[j], 0xFFE8E8F0);
                j = j + 1;
            }

            // 两栏之间那几条连线:指着左边这一格的,一行连一条过去("指着谁"画出来)
            var jj = 0;
            当 (jj < 6)
            {
                如果 (右到左[jj] == 光标)
                {
                    画线(12 + 左宽, 行顶 + 光标 * 行高 + 13, 右左, 行顶 + jj * 行高 + 13, 0xFF2A6EF0);
                }
                jj = jj + 1;
            }

            // ---- 底下两行:这一格是谁 / 谁引用它(整句开窗前拼好,这里只按下标取)----
            画线(12, 368, 548, 368, 0xFF3C3C46);
            画矩形(12, 380, 536, 24, 0xFF232B3E);
            画文字(20, 384, 详一列[光标], 0xFFE8E8F0);
            画矩形(12, 412, 536, 24, 0xFF1E2430);
            画文字(20, 416, 详二列[光标], 0xFFD0D0D8);

            // ---- 底下那几句说明:写死的字符串直接进 画文字(每帧不产生新字符串)----
            画线(12, 444, 548, 444, 0xFF3C3C46);
            画文字(20, 452, "结构类型本身不占存储:声明 `点 q;` 时才按总宽度分配", 0xFFB0B0B8);
            画文字(20, 476, "偏移按自己那个实例算:队[1].y 的 +4 是元素里的(元素间距 8)", 0xFFB0B0B8);
            画文字(20, 500, "引用 参数走的是地址:被调方改的就是调用方那一格,不复制", 0xFFB0B0B8);
            画文字(20, 524, "取址拿到的是一个 32 位字:谁能按它读写,谁就指着那一格", 0xFFB0B0B8);
            画文字(20, 548, "每帧高亮往下一格;点左栏点右栏都认 —— 两栏说同一件事", 0xFF8A8A96);

            // ---- 刷新:不调用就一直不显示 ----
            刷新();

            等待(120);                             // 让出一帧、别把 CPU 烧满(无头不真等)

            // 逐帧推进:每刷新一帧,高亮沿字段往下走一格(走到第 8 行绕回第 1 行)
            光标 = 光标 + 1;
            如果 (光标 >= 8)
            {
                光标 = 0;
            }
        }
    }

    关闭窗口();
}

停止

