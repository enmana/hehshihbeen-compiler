// ============================================================
// 示例14:图形界面(R1-6 批 1)—— 开一个窗口、画一屏、逐条看命令
//
//   这一门语言**不做控件库**:窗口 / 像素 / 输入是宿主给的,控件(按钮 / 文本框 /
//   列表 / 布局)由 HB 自己写;每帧重画一遍(即时模式),状态就是普通变量。
//
//   这一批 10 条原语:
//     命令那一档(单独成句,没有返回值):清屏 / 画文字 / 画矩形 / 画线 / 等待 / 关闭窗口 / 刷新
//     有返回值那一档:打开窗口 / 取事件(逻辑)、取文字宽度(整数)
//
//   怎么看:自检(`hbcc --selftest`)与 `hbcc --run` 都是**无头** ——
//   开窗那一刻先打一行,`刷新()` 时把这一帧攒的命令按顺序逐条打出来(硬规矩 6:
//   不开窗也能验);文件末尾那条注释列的就是这些行,自检会逐行比。
//   桌面壳(`HB宿主` 那条路)开的是**真窗口**;没有图形能力的宿主(独立 exe / 手机端)
//   一律给 假,程序自己决定怎么办。
// ============================================================

整数 类型 = 0;
整数 键码 = 0;
整数 鼠标x = 0;
整数 鼠标y = 0;

逻辑 开着 = 打开窗口("HB 图形演示", 320, 200);
如果 (开着)
{
    // ---- 一帧:底色 + 一个"按钮"形状 + 一行文字 + 一条分隔线 ----
    清屏(0xFF101018);
    画矩形(10, 10, 120, 40, 0xFF2A6EF0);
    画文字(16, 24, "你好,HB", 0xFFFFFFFF);
    画线(0, 60, 319, 60, 0xFF3C3C46);
    刷新();                            // 不刷新就一直不显示

    等待(2000);                        // **停 2 秒让人看得见**(用户实测:画完立刻关窗就是"一闪就没");
                                       // 无头不真等、也不产生输出

    // ---- 事件是**轮询**的:有就给真,没有给假(不阻塞)—— 这一趟没有事件 ----
    如果 (取事件(类型, 键码, 鼠标x, 鼠标y))
    {
        测试输出(1);
    }
    否则
    {
        测试输出(0);
    }

    关闭窗口();                        // 关掉它,程序继续跑
}

// ---- 排版用:等宽口径(ASCII 1 格、汉字 2 格),这两条纯计算,没窗口也照样给数 ----
测试输出(取文字宽度("abc"));          // 3
测试输出(取文字宽度("你好"));         // 4
停止
// 预期输出: 打开窗口 标题="HB 图形演示" 宽=320 高=200|清屏 颜色=0xFF101018|画矩形 x=10 y=10 宽=120 高=40 颜色=0xFF2A6EF0|画文字 x=16 y=24 文本="你好,HB" 颜色=0xFFFFFFFF|画线 x1=0 y1=60 x2=319 y2=60 颜色=0xFF3C3C46|刷新 命令=4|0|关闭窗口|3|4
