// ============================================================
// 示例30_运行时:G3 域 6 —— 睡眠 / 冲刷 / 改名 / 临时目录(功能号 43 / 44 / 46 / 47)
//
//   这一域的四条是"程序自己跟机器打交道"的那几件:
//     ① 睡眠(毫秒):**阻塞**睡满再往下走(命令行小工具用;界面里请用 `等待` / `定时.hb`);
//     ② 冲刷(句柄):把写流的缓冲**落盘**、流还开着(与 `关写流` 的"冲刷完顺手关掉"不同);
//     ③ 改名(旧, 新):文件 / 目录换名字或位置,而且**目标已存在就整体替换** ——
//        安全保存(写一份临时的,再一次 `改名` 盖上去)靠的就是它;要"目标存在就不许动"用 `移动到`;
//     ④ 临时目录(变量, 上限):本机的临时目录写进那个 `字符串` 变量(尾部不带分隔符)。
//
//   **45 不在这里**:`45 时钟分辨率/单调时钟` 判定不做 —— 单调钟由 `当前毫秒()` 给(见 示例28_定时器)。
//   这一篇**一句时钟刻度都不往变量里存**:对拍要拿"C# 虚拟机"与"C 后端原生 exe"的**整块内存**
//   逐字节比,存一个"当时是几毫秒"进去就必然对不上(机器状态本来就该是确定的);
//   "睡过之后刻度不倒退"那一条由自检分组 `运行时原语` 真跑一遍来钉。
//
//   这一篇**只碰自己的临时工作目录**(跑完自己清干净),不碰网络、不碰别的示例的文件。
// ============================================================
包含 "../../库/string.hb"

字符串 目录 = "工具/临时/示例30";
字符串 主文件 = "工具/临时/示例30/主文件.txt";
字符串 备份文件 = "工具/临时/示例30/备份文件.txt";
字符串 目标路径 = "工具/临时/示例30/目标路径.txt";

输出行(建目录(目录));

// ---------------- ① 睡眠:整数状态(0 = 睡满;负数不睡、给 9) ----------------
输出行(睡眠(1));                        // 0:真睡满 1 毫秒才往下走
输出行(睡眠(-1));                        // 9:参数不合法(不当 0 睡)

// ---------------- ② 冲刷:写完先落盘(流还开着),后头接着写 ----------------
整数 写句柄 = 0;
写句柄 = 打开写流(主文件, 写句柄);
输出行(写一块(写句柄, "前半", 0));      // 6:两个汉字,每个 3 字节
输出行(冲刷(写句柄));                    // 0:缓冲落盘,**流还开着**
输出行(写一块(写句柄, "后半", 0));      // 6
输出行(冲刷(写句柄));                    // 0
输出行(关写流(写句柄));                  // 0
输出行(冲刷(写句柄));                    // 22:关掉之后句柄作废
字符串 全文 = "";
输出行(读文件(主文件, 全文, 4096));         // 1
输出行(全文);                            // 前半后半

// ---------------- ③ 改名:目标已存在就**整体替换**(与 `移动到` 的"不覆盖"分工) ----------------
输出行(写文件(备份文件, "旧的"));              // 1
输出行(改名(备份文件, 主文件));                    // 1:备份文件 盖到 主文件 上(主文件 原来的内容被替掉,备份文件 没了)
输出行(读文件(主文件, 全文, 4096));         // 1
输出行(全文);                            // 旧的
输出行(改名("工具/临时/示例30/没有这个.txt", 目标路径));   // 0:旧路径不存在
输出行(写文件(备份文件, "备份还在"));            // 1(上面 备份文件 被改名搬走了,这里重新建一个)
输出行(移动到(备份文件, 主文件));                  // 0:`移动到` **不覆盖** —— 目标 主文件 还在,它一个字都不动
输出行(读文件(主文件, 全文, 4096));         // 1
输出行(全文);                            // 旧的(那一次移动没成功)

// ---------------- ④ 临时目录:写进变量;尾部不带分隔符 ----------------
字符串 临时 = "";
输出行(临时目录(临时, 4096));           // 1
输出行(临时.长度() > 0);                 // 1
输出行(以结尾(临时, "\\"));              // 0:尾部没有反斜杠
输出行(以结尾(临时, "/"));               // 0:尾部也没有正斜杠

// ---------------- 收尾:把自己造的文件 / 目录清干净 ----------------
输出行(删文件(主文件));                      // 1
输出行(删文件(备份文件));                      // 1
输出行(删目录(目录));                    // 1

// 预期输出: 1|0|9|6|0|6|0|0|22|1|前半后半|1|1|1|旧的|0|1|0|1|旧的|1|1|0|0|1|1|1
