<?xml version="1.0" encoding="utf-8"?>
<!-- 本仓库自己的 NuGet 源:`本地包\`(自制 AvalonEdit 补丁包 `HB.AvalonEdit`,怎么打出来的见 `本地包\打包\打包.csproj`)。
     有意**不加 `<clear />`** —— 别的包(ToolGood.Words.FirstPinyin / Avalonia / MAUI)照旧走 nuget.org,
     机上那份用户级配置也照旧生效。 -->
<configuration>
  <packageSources>
    <add key="本地包" value="本地包" />
  </packageSources>
</configuration>
