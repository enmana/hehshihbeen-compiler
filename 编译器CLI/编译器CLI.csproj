<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>hehshihbeen_compiler</RootNamespace>
    <AssemblyName>hbcc</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- 与 WPF 工程“链接同一批引擎源码”独立编译,互不干扰;不加 ProjectReference -->
  <ItemGroup>
    <Compile Include="..\引擎\*.cs" Link="引擎\%(Filename)%(Extension)" />
    <Compile Include="..\中间层\*.cs" Link="中间层\%(Filename)%(Extension)" />
    <Compile Include="..\自检\*.cs" Link="自检\%(Filename)%(Extension)" />
    <Compile Include="..\C后端\*.cs" Link="C后端\%(Filename)%(Extension)" />
    <!-- T28:同 `引擎库` —— 自检要真跑"后台线程来的异常记录会排队",hbcc 也得编到 `异常收集C` -->
    <Compile Include="..\异常收集C.cs" Link="异常收集C.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="ToolGood.Words.FirstPinyin" Version="3.1.0.4" />
  </ItemGroup>

  <!-- R3-6-4 批 1:C 后端的运行期源码(手写的那份 `C后端\运行时.c`)嵌进程序集,
       这样 hbcc 从哪儿跑都拼得出完整的 C 源码,不依赖工作目录 -->
  <ItemGroup>
    <EmbeddedResource Include="..\C后端\运行时.c" LogicalName="hb运行时.c" />
  </ItemGroup>

</Project>
