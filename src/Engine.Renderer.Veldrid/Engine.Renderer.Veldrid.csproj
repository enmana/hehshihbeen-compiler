<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	<TargetFramework>net10.0</TargetFramework>
	<RootNamespace>Engine.Renderer.Veldrid</RootNamespace>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<!-- Set UseVeldrid=true to enable Veldrid packages and real backend compilation -->
	<UseVeldrid>false</UseVeldrid>
  </PropertyGroup>
  <ItemGroup>
	<ProjectReference Include="..\Engine.Renderer\Engine.Renderer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseVeldrid)' == 'true'">
	<PackageReference Include="Veldrid" Version="6.0.0" />
	<PackageReference Include="Veldrid.Sdl2" Version="6.0.0" />
	<PackageReference Include="Veldrid.StartupUtilities" Version="6.0.0" />
  </ItemGroup>
  <!-- Compile real backend only when UseVeldrid=true -->
  <ItemGroup>
	<Compile Include="VeldridBackend.Real.cs" Condition="'$(UseVeldrid)' == 'true'" />
	<Compile Include="VeldridBackend.cs" />
  </ItemGroup>
</Project>