<UserControl x:Class="hehshihbeen_compiler.选项页"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" MaxWidth="720">
            <TextBlock Text="选项" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <GroupBox Header="外观与主题" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="当前主题" Width="110" VerticalAlignment="Center"/>
                        <ComboBox x:Name="主题下拉" SelectionChanged="主题下拉_SelectionChanged"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="字体" Width="110" VerticalAlignment="Center"/>
                        <ComboBox x:Name="字体下拉" IsEditable="True"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="字号" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="字号框" Width="80" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="行高" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="行高框" Width="80" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="粗体勾" Content="粗体" Margin="0,0,14,0"/>
                        <CheckBox x:Name="斜体勾" Content="斜体" Margin="0,0,14,0"/>
                        <CheckBox x:Name="行号勾" Content="显示行号" Margin="0,0,14,0"/>
                        <CheckBox x:Name="换行勾" Content="自动换行"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="导引线勾" Content="缩进导引线"
                                  ToolTip="块里每一对跨行 `{}` 在那个 `}` 的列上画一条竖线,颜色跟着那一层的彩虹色;关掉只是不画,折叠与编译都不受影响"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,2" FontSize="11" Foreground="#FF707070" TextWrapping="Wrap"
                               Text="花括号彩虹色(7 档按嵌套层循环;一行一档,填 #RRGGBB。这一层同时管花括号本身的颜色和上面那条导引线)"/>
                    <ItemsControl x:Name="彩虹色表">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2,14,2">
                                    <TextBlock Text="{Binding 标签}" Width="66" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding 色值, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                             Width="96" HorizontalAlignment="Left"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="主题管理(色值可填 #RRGGBB)" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <DockPanel Margin="0,4">
                        <TextBlock Text="主题名" Width="110" VerticalAlignment="Center"/>
                        <TextBox x:Name="主题名框" Width="200" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <ItemsControl x:Name="调色表">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding 标签}" Width="130" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding 色值, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                             Width="130" HorizontalAlignment="Left"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="预览按钮" Content="临时套用配色" Click="预览按钮_Click" Margin="0,0,8,0" Padding="10,3"/>
                        <Button x:Name="另存按钮" Content="另存为新主题" Click="另存按钮_Click" Margin="0,0,8,0" Padding="10,3"/>
                        <Button x:Name="保存当前按钮" Content="保存到当前主题" Click="保存当前按钮_Click" Padding="10,3"/>
                    </StackPanel>
                    <TextBlock x:Name="提示文字" Foreground="#FF808080" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="输入行为" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="成对勾" Content="自动成对 ()[]{} 引号 / 注释" Margin="0,0,18,0"/>
                        <CheckBox x:Name="Tab确认勾" Content="Tab 确认补全候选(空格只输入空格)"/>
                    </StackPanel>
                    <CheckBox x:Name="模糊拼音勾" Content="模糊拼音(例如 cang / cand 也能出 长度)" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="回车缩进勾" Content="回车自动缩进" Margin="0,0,18,0"
                                  ToolTip="按块深度给新行缩进:块里进一档、`}` 行退回来、上一行以 =/逗号收尾时再进一档"/>
                        <TextBlock Text="缩进宽度" VerticalAlignment="Center"/>
                        <TextBox x:Name="缩进宽度框" Width="46" Margin="6,0,0,0"
                                 ToolTip="一档几个空格(1~16);『编辑→格式化当前文件』也按它排"/>
                    </StackPanel>
                    <WrapPanel x:Name="模糊规则面板" Margin="20,4,0,0"/>
                    <TextBlock x:Name="模糊拼音说明" Margin="20,4,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="#FF707070"
                               Text="只影响按拼音打字的匹配:勾中的规则按近似音算,没勾的一律按标准拼音算;只按首字母(如 cd)不受影响。"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="快捷键(改完点下面的『应用并保存』;留空 = 取消这个快捷键)" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <ItemsControl x:Name="快捷键列表">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding 默认值}" Width="150" VerticalAlignment="Center"
                                               Foreground="#FF909090" DockPanel.Dock="Right"/>
                                    <TextBox Text="{Binding 键位, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                             Width="150" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding 标题}" Width="210" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="快捷键说明" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#FF707070"
                               Text="写法:修饰键 + 主键,例如 F5、Ctrl+H、Ctrl+Shift+F(大小写与顺序随便);留空 = 取消这个快捷键。右边灰字是默认值。『查找』由编辑器自带的查找面板注册,这里只列出来。"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="文件" Margin="0,0,0,12" Padding="8">
                <DockPanel Margin="0,4">
                    <Button Content="浏览..." DockPanel.Dock="Right" Width="76" Margin="6,0,0,0" Click="浏览按钮_Click"/>
                    <TextBlock Text="默认文件夹" Width="110" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBox x:Name="文件夹框" VerticalAlignment="Center"/>
                </DockPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
                <Button Content="应用并保存" Click="应用按钮_Click" Padding="14,5"/>
                <Button Content="恢复默认" Click="恢复默认_Click" Padding="14,5" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="状态文字" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
