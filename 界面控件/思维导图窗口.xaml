<Window x:Class="hehshihbeen_compiler.思维导图窗口"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:hehshihbeen_compiler"
        Title="思维导图" Width="1000" Height="680"
        MinWidth="420" MinHeight="260"
        WindowStartupLocation="Manual"
        Background="{DynamicResource 主题内容刷}"
        Foreground="{DynamicResource 主题前景刷}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12">
    <!-- H33 立、H60-14 换成"结构导图"那棵树(H60-15 起帮助那一节叫「结构导图」;入口菜单名仍叫
          「打开思维导图」)。一个浮动窗,靠主窗右侧生成;左边一个框是起点,
          点一下就往右长一级(已经展开的再点一下 = 收起,H61-1)。
          **H63-2 起"长过的不会被清掉"这句作废**:数据仍不清除,但**这一屏画什么由"视野"说了算** ——
          默认只画当前那一格的父链 + 它自己 + 它的直接子(兄弟枝与走过的旁支隐藏),
          顶上那个「全集图」开关勾上才是旧那一套"长过的全都画"(见 `引擎\思维导图C.cs` 的 `算可见`)。
          H61-1 起:根节点只留文件名(全路径进提示)、一个框先长出「声明区 / 调用区」两个可折叠大框、
          声明项左边竖排种类名。硬规矩 6 已由用户 2026-09-25 改成"可以开窗验证",所以这个窗是真的开出来的。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource 主题面板刷}" Padding="10,7">
            <DockPanel>
                <!-- H63-4:左边一格输入框 —— 打名字回车就"铺到"声明的那个框并选中(本文件找不到会去整个工程找) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="找:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource 主题前景刷}"/>
                    <TextBox x:Name="搜索框" Width="150" VerticalAlignment="Center" Padding="4,1"
                             KeyDown="搜索框_按键" Cursor="IBeam"
                             ToolTip="打一个名字(方法 / 变量 / 常量 / 结构 / 参数 / 局部都认),回车就铺到声明那一格并选中;这一份里找不到会去整个工程里找(含 `包含` 进来的库);内建 / 关键字如实说没有源码定义"/>
                    <Button x:Name="按钮搜索" Content="搜" Click="搜索_Click" Padding="8,2" Margin="4,0,0,0"
                            Cursor="Hand" BorderThickness="1" Background="Transparent"
                            BorderBrush="{DynamicResource 主题前景刷}" Foreground="{DynamicResource 主题前景刷}"
                            ToolTip="铺到这个名字的声明那一格并选中(与在输入框里按回车一样)"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- H63-3:缩放(滑条 + 适应窗口;也可以按住 Ctrl 滚轮)。H63-2 那个「全集图」旁边就是它。 -->
                    <TextBlock x:Name="缩放标签" Text="100%" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{DynamicResource 主题前景刷}" ToolTip="当前缩放比例"/>
                    <Slider x:Name="缩放条" Minimum="0.05" Maximum="3" Value="1" Width="110"
                            VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                            ValueChanged="缩放条_变了"
                            ToolTip="缩放:5% ~ 300%(也可以按住 Ctrl 滚轮;「适应窗口」一按整棵树进视口)"/>
                    <Button x:Name="按钮适应窗口" Content="适应窗口" Click="适应窗口_Click" Padding="10,2" Margin="0,0,10,0"
                            Cursor="Hand" BorderThickness="1" Background="Transparent"
                            BorderBrush="{DynamicResource 主题前景刷}" Foreground="{DynamicResource 主题前景刷}"
                            ToolTip="按当前视口算一个比例,让整张图都进窗口(图很大时字会变小 —— 看全貌用)"/>
                    <!-- H63-2:顶上这个开关切"视野 / 全集图"两档 —— 默认视野(只画相关的:当前那一格的
                         父链 + 自己 + 直接子,红线那头只到声明处 + 它的父级);勾上 = 旧那一套"长过的全都画"。 -->
                    <CheckBox x:Name="勾全集图" Content="全集图" Click="全集图_勾了" Cursor="Hand"
                              VerticalAlignment="Center" Margin="0,0,10,0"
                              Foreground="{DynamicResource 主题前景刷}"
                              ToolTip="默认只画相关的那些框(当前那一格的父链 + 它自己 + 它的直接子;红线那头只到声明处和它的父级)。勾上就画全部长出来的框(旧那一套全量视图,文件多时会很大)"/>
                    <Button x:Name="按钮后退" Content="← 上一个" Click="后退_Click" Padding="10,2" Cursor="Hand"
                            BorderThickness="1" Background="Transparent"
                            BorderBrush="{DynamicResource 主题前景刷}" Foreground="{DynamicResource 主题前景刷}"
                            ToolTip="回到上一个你点开过的框(只挪视口与高亮,不动树)"/>
                    <Button x:Name="按钮前进" Content="下一个 →" Click="前进_Click" Padding="10,2" Margin="6,0,0,0"
                            Cursor="Hand" BorderThickness="1" Background="Transparent"
                            BorderBrush="{DynamicResource 主题前景刷}" Foreground="{DynamicResource 主题前景刷}"
                            ToolTip="往后回到下一个你点开过的框"/>
                    <Button x:Name="按钮回到根" Content="回到根" Click="回到根_Click" Padding="10,2" Margin="6,0,0,0"
                            Cursor="Hand" BorderThickness="1" Background="Transparent"
                            BorderBrush="{DynamicResource 主题前景刷}" Foreground="{DynamicResource 主题前景刷}"
                            ToolTip="把视口挪回最开始那个框"/>
                    <Button x:Name="按钮收起" Content="全部收起" Click="收起_Click" Padding="10,2" Margin="6,0,0,0"
                            Cursor="Hand" BorderThickness="1" Background="Transparent"
                            BorderBrush="{DynamicResource 主题前景刷}" Foreground="{DynamicResource 主题前景刷}"
                            ToolTip="把长出来的枝全收掉,只留最开始那个框(重新来一遍)"/>
                </StackPanel>
                <TextBlock x:Name="导图标题" Text="思维导图" FontWeight="SemiBold" FontSize="13"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource 主题前景刷}"/>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="滚动" Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource 主题内容刷}" Padding="0"
                      PreviewMouseWheel="滚动_滚轮了">
            <Canvas x:Name="画布" Background="Transparent"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource 主题面板刷}" Padding="10,5">
            <!-- H63-7:状态行本身报"当前选中那一格";这一长串**操作说明**挪进它的鼠标提示(鼠标停上去才看)。 -->
            <TextBlock x:Name="状态行" FontSize="11" Opacity="0.78" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource 主题前景刷}"
                       ToolTip="状态行报的是你现在选中的那一格(标题 · 种类 · 行号 · 文件)&#x0a;点框 = 展开下一级(已经展开的再点一下 = 收起);双击 = 跳到代码那一行;&#x0a;本文件的方法 / 变量会拉一条红线指回声明区;选中的那一枝到根用绿线;&#x0a;默认只画相关的那些框(顶上「全集图」勾上才看全量);&#x0a;一层超过 20 条时先出 20 条 + 一条「…」,点「…」才全部生成;框上右键还有「展开全部子项 / 收起这一枝 / 看谁调用它 / 跳到代码 / 复制标题」"/>
        </Border>
    </Grid>
</Window>
