<Window x:Class="hehshihbeen_compiler.输入窗口"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="16" Width="380">
        <TextBlock x:Name="提示文本" Text="请输入名称:" Margin="0,0,0,6"/>
        <TextBox x:Name="输入框" Height="26" VerticalContentAlignment="Center"/>
        <CheckBox x:Name="勾选框" Margin="0,10,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="说明文本" Margin="0,6,0,0" Opacity="0.7" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="80" Padding="0,4" IsDefault="True" Click="确定_Click"/>
            <Button Content="取消" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="取消_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
