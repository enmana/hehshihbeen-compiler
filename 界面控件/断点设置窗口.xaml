<Window x:Class="hehshihbeen_compiler.界面控件.断点设置窗口"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="断点设置" SizeToContent="Height" Width="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="标题文本" Text="第 3 行的断点" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="命中条件(留空 = 每次都停)"/>
        <TextBox x:Name="条件框" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas"
                 ToolTip="写法 `变量 运算符 常量`,例如 `i == 5`、`值 != 真`、`c == 'A'`;右边也可以写另一个变量(如 `左 &lt; 右`);只写一个变量名 = 非 0 就停"/>
        <TextBlock x:Name="条件预览" Margin="0,3,0,10" TextWrapping="Wrap" Opacity="0.85"/>

        <TextBlock Text="命中次数(留空 = 每次都停)"/>
        <TextBox x:Name="次数框" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas"
                 ToolTip="`5` = 第 5 次经过时停一次;`%5` = 每 5 次停一次;`&gt;=5` = 第 5 次起每次都停"/>
        <TextBlock x:Name="次数预览" Margin="0,3,0,10" TextWrapping="Wrap" Opacity="0.85"/>

        <TextBlock Text="日志(填了它就只打印、不停下)"/>
        <TextBox x:Name="日志框" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas"
                 ToolTip="例如 `到第 {i} 轮了,和 = {和}`;`{变量}` 换成那个变量现在的值,还认 `{行}` / `{文件}`"/>
        <TextBlock x:Name="日志预览" Margin="0,3,0,0" TextWrapping="Wrap" Opacity="0.85"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="全清空" Width="90" Padding="0,4" Click="清空_Click"
                    ToolTip="三格都清掉 = 这个断点改回普通断点(命中就停)"/>
            <Button x:Name="确定按钮" Content="确定" Width="90" Padding="0,4" Margin="8,0,0,0" IsDefault="True" Click="确定_Click"/>
            <Button Content="取消" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="取消_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
