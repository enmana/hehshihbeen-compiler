<Window x:Class="hehshihbeen_compiler.启动页窗口"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="中文汇编器 · 启动" Width="880" Height="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <!-- 链接样式:像 VS 启动页那样的蓝色可点文字 -->
        <Style x:Key="链接样式" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2B7BD6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="中文汇编器" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="副标题" Opacity="0.7" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左:最近打开的项目 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="最近打开的项目" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock DockPanel.Dock="Top" x:Name="空列表提示" Opacity="0.65" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="还没有打开过项目。右边“新建项目”开一个,或“打开项目”选一个 .hbp 工程文件。"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="最近列表">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Left" Padding="6,4" Margin="0,0,0,2"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="最近项_Click" Tag="{Binding 工程路径}"
                                        ToolTip="{Binding 工程路径}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding 显示名}" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding 时间文本}" Opacity="0.7" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding 相对时间文本}" Opacity="0.7"/>
                                            <TextBlock Text="{Binding 缺失提示}" Foreground="#D16969" Opacity="0.9"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding 工程路径}" Opacity="0.55" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="#40808080"/>

            <!-- 右:开始做什么 -->
            <StackPanel Grid.Column="2" MinWidth="180">
                <TextBlock Text="开始" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="新建项目…" Style="{StaticResource 链接样式}" MouseLeftButtonUp="链接新建项目_Click"/>
                <TextBlock Text="打开项目…" Style="{StaticResource 链接样式}" MouseLeftButtonUp="链接打开项目_Click"/>
                <TextBlock Text="打开文件…" Style="{StaticResource 链接样式}" MouseLeftButtonUp="链接打开文件_Click"/>
                <Separator Margin="0,6,0,10"/>
                <TextBlock Text="直接开始(空白窗口)" Style="{StaticResource 链接样式}" MouseLeftButtonUp="链接空白_Click"
                           ToolTip="关掉这个窗口,不打开任何项目/文件"/>
                <TextBlock Text="清空最近列表" Style="{StaticResource 链接样式}" MouseLeftButtonUp="链接清空_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" Opacity="0.6" TextWrapping="Wrap"
                   Text="提示:启动时不会自动打开任何项目或文件;想接着上次干活,点左边列表里的一条即可。"/>
    </Grid>
</Window>
