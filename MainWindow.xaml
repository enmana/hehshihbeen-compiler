                    <Separator/>
                    <MenuItem Header="综合自检(_Z)" Click="综合自检_Click" ToolTip="运行全指令+中间层+边界自检,结果写输出框,异常写异常框"/>
                </MenuItem>
                <MenuItem Header="调试(_D)" Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem x:Name="调试逐步菜单" Header="逐步(_Z)" Click="调试_逐步菜单_Click"
                              ToolTip="一次走一条**源码行**:编译器生成的指令(序言 / 收尾)一口气跑过,黄条落在这一行上(编辑器不换文档、不展开),底部显示指令 / 寄存器 / 内存;第一次按会自动编译并进入单步。想看展开的汇编用工具栏「展开到汇编」开新页"/>
                    <MenuItem x:Name="调试继续菜单" Header="继续(_J)" Click="调试_继续按钮_Click"
                              ToolTip="往下跑:有断点就停在断点上,没有就跑到停机"/>
                    <MenuItem x:Name="调试停止菜单" Header="停止(_T)" Click="调试_停止按钮_Click" InputGestureText="Shift+F5" IsEnabled="False"
                              ToolTip="把正在跑的程序叫停(死循环也不用杀进程):每 4096 条指令查一次请求,程序**停在原地**(寄存器 / 变量都还看得见),输出页写一行「已停止」;这一次不做断言,再按「执行」从头跑"/>
                    <MenuItem x:Name="调试复位菜单" Header="复位(_F)" Click="调试_复位按钮_Click"
                              ToolTip="回到程序开头(同时退出单步)"/>
                    <Separator/>
                    <MenuItem x:Name="切换断点菜单" Header="切换断点(_B)" Click="菜单切换断点_Click" InputGestureText="F9"
                              ToolTip="在光标那一行加/去一个断点(也可以点行号左边的空白处);断点跟着工程走,存在项目目录的 断点.hbd"/>
                    <MenuItem Header="断点条件(_C)…" Click="断点条件_Click"
                              ToolTip="给光标那一行**已经下好**的断点写一个命中条件(如 i == 5):条件为假就当没命中、接着跑;留空 = 每次停"/>
                    <MenuItem x:Name="加监视菜单" Header="加监视表达式(_W)…" Click="加监视_Click" InputGestureText="Ctrl+Alt+W"
                              ToolTip="把光标下那个名字(或者编辑器里选中的那一段)加进底部『监视』页:每走一步自动重算它现在是多少;也认 `总数 &gt;= 100`、`左 &lt; 右` 这种写法。写下来会记住,下次打开还在。底部的『监视』页里也能直接加"/>
                    <MenuItem x:Name="清除断点菜单" Header="清除所有断点(_K)" Click="菜单清除所有断点_Click"
                              ToolTip="把这个工程里的断点全清掉(编辑器右键菜单里也有同一条)"/>
                </MenuItem>
                <MenuItem Header="视图(_V)" Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem x:Name="命令面板菜单" Header="命令面板(_P)…" Click="命令面板_Click"
