                        Content="&#xeea1;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="20"
                        Foreground="Gold"
                        ToolTip="F5 编译并执行:源码变了自动重新编译从头跑;没变又停在断点上就接着跑"
                        Style="{StaticResource ButtonStyle}"
                        Click="执行按钮_Click"
                        IsEnabled="False"/>
                <!-- 生成 .hb 的按钮已移除:每次编译都会自动生成独立 exe(见 编译启动项目_Click),
                     而 .hb(头 + 机器码)没有别的消费方 —— HB宿主 只运行贴过尾巴(带机器码)的独立 exe。
                     注意**只剩单向残留**:按钮没了,但「文件 → 打开」仍然认 `.hb`(头两个字节 "HB" 就当二进制程序
                     直接喂虚拟机跑,见 `MainWindow.窗口与文件.cs` 的 `文件头[0] == 0x48 && 文件头[1] == 0x42`
                     那一支)—— 这是有意留的"直接跑一个 .hb",不是死代码。 -->

                <!-- H22 停止:程序在后台线程上跑,界面不冻,这一个按钮把长循环叫停(默认键 Shift+F5)。
                     没在跑的时候它是灰的(可用性由 `刷新命令可用性()` 一处管) -->
                <Button Name="停止按钮"
                        Content="&#xE71A;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="IndianRed"
                        ToolTip="Shift+F5 停止:把正在跑的程序叫停(HB 程序死循环时不用再杀进程)&#x0a;程序停在原地 —— 寄存器 / 变量 / 输出都留着,这一次不做断言;再按 F5 从头跑"
                        Style="{StaticResource ButtonStyle}"
                        Click="调试_停止按钮_Click"
                        IsEnabled="False"/>

                <!-- 中英文切换 -->
                <Separator Margin="5,0,5,0" Height="15" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <Button Name="中英切换"
                        Content="&#xe8c1;"
                        FontFamily="Segoe Fluent Icons"
                        Foreground="MediumSlateBlue"
                        FontSize="20"
                        ToolTip="切换到英文"
                        Style="{StaticResource ButtonStyle}"
                        Click="中英切换_Click"/>

                <!-- R3-6-4 批 4:打包方式下拉,决定"编译一次目录里出来的那个程序打成什么"。
                     三档来自唯一事实源 引擎\打包规格C.cs(与 hbcc 那个打包开关是同一个词;
                     第248批 H41 撤掉了「轻量·需装 .NET」那一档 —— 它贴的其实是那份 101 MB 自包含宿主,
                     文案却说"一百多 KB、要装 .NET",而"产物小"已经由「原生 C」更彻底地解决):
                       原生 C            转 C 源码再交本机 C 编译器:几十~几百 KB、不带 .NET(最快最小)
                       自带运行时·单文件  拷自包含 HB 宿主 + 贴机器码:几十 MB、目标机器什么都不用装
                       只编译            不产 exe:交一份 C 源码 / 一份 .hb(自己拿去编 / 自己贴)
                     选完立刻按新档重做一次打包(机器码没变,变的是"打包那一步")。上次选的记在
                     程序目录的 打包方式.json 里(本机偏好,不进 .hbp)。 -->
                <TextBlock Text="打包:"
                           VerticalAlignment="Center"
                           Margin="6,0,2,0"
                           Foreground="#FF556677"
                           FontSize="11"/>
                <ComboBox Name="打包方式下拉"
                          Width="148"
                          Height="22"
                          VerticalAlignment="Center"
                          FontSize="11"
                          ToolTip="编译产物打成什么(三档与 `hbcc --打包` 完全对应)&#x0a;原生 C:几十~几百 KB、不带 .NET,要本机有 C 编译器&#x0a;自带运行时·单文件:几十 MB,目标机器什么都不用装&#x0a;只编译:不产 exe,交一份 C 源码 / 一份 .hb"
                          SelectionChanged="打包方式下拉_SelectionChanged">
                    <ComboBoxItem Content="原生 C"/>
                    <ComboBoxItem Content="自带运行时·单文件"/>
                    <ComboBoxItem Content="只编译"/>
                </ComboBox>

                <!-- 展开到汇编:把当前文件整篇展开,在**新页**里打开(可编辑、可保存;落点 `<文件>_ASM.hba`。——
                     C23:以前它是"只读整篇视图"的开关;那个只读路整个撤了(单步也不再展开编辑器) -->
                <Button Name="展开到汇编按钮" Style="{StaticResource ButtonStyle}"
                        Click="展开到汇编_Click"
                        ToolTip="把**当前文件**整篇展开成汇编,在新标签页里打开(可编辑、可保存;存成「被展开文件名 + _ASM.hba」)。&#x0a;展开文本带 `// 来自第 N 行` 标记,能对回源码行;默认不参与编译 —— 想拿它优化热路径,在「运行 → 汇编源码参与编译」里勾上。">
                    <Grid>
                        <TextBlock Text="&#xe943;"
                                   FontFamily="Segoe Fluent Icons"
                                   Foreground="SteelBlue"
                                   FontSize="16"
                                   Margin="0,3,0,0"/>
                        <TextBlock Text="&lt;/&gt;"
                                   FontFamily="Consolas"
                                   Foreground="SlateBlue"
                                   FontSize="8"
                                   Margin="0,14,0,0"/>
                    </Grid>
                </Button>


            </StackPanel>
        </Grid>

        <!-- ========== 主内容（左:解决方案资源管理器 / 中:编辑器 + 输出区） ========== -->
        <Grid Grid.Row="2" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="项目树列" Width="240" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 解决方案资源管理器:项目(粗体=启动项目) → 文件 -->
            <Border Grid.Column="0" BorderThickness="0" CornerRadius="6"
                    Background="{DynamicResource 主题面板刷}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 标题条:新建/打开在顶部菜单与工具栏(只有一套),这里只当标题 -->
                    <Border Grid.Row="0" Background="{DynamicResource 主题内容刷}" Padding="10,7" CornerRadius="6,6,0,0">
                        <TextBlock Text="解决方案资源管理器" FontWeight="SemiBold" FontSize="12" Opacity="0.85"/>
                    </Border>

                    <TreeView Grid.Row="1" Name="项目树"
                              Background="Transparent" BorderThickness="0"
                              Padding="4,6"
                              Foreground="{DynamicResource 主题前景刷}"
                              MouseDoubleClick="项目树_MouseDoubleClick"
                              PreviewMouseRightButtonDown="项目树_预览右键">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="菜单设为启动项目" Header="设为启动项目" Click="设为启动项目_Click"/>
                                <!-- 第193批:资源管理器右键这条「编译」与菜单那条走**同一条编译路**,
                                     只差一格 —— **不自动打开 `<启动文件>_ASM.hba`**(用户要求与 F5 一个口径)。 -->
                                <MenuItem x:Name="菜单项目编译" Header="编译(启动项目)" Click="编译启动项目_不开汇编源码页_Click"
                                          ToolTip="按工程文件编译启动项目(与 F5 同一条路:不自动打开 &quot;被编译文件_ASM.hba&quot;;想看展开的汇编用 运行 → 编译,或工具栏「展开到汇编」)"/>
                                <Separator/>
                                <!-- H33:思维导图(用户 2026-09-25 拍板)。右键点在哪个节点上,就从哪个节点起。 -->
                                <MenuItem Header="打开思维导图(_T)" Click="打开思维导图_Click"
                                          ToolTip="把这一项一层一层点开:工程 → 文件 → 结构 / 方法 → 这个方法又调用了谁…(浮动窗靠右侧生成;已经长出来的不会被清掉;一层超过 20 个时先出 20 个 + 一条「…」)"/>
                                <MenuItem Header="新建项目…" Click="新建项目_Click"
                                          ToolTip="建 项目目录 + 工程文件(.hbp) + 主程序.hb,建好直接打开主程序.hb"/>
                                <MenuItem Header="新建文件…" Click="新建文件_Click"
                                          ToolTip="在项目目录里新建一个 .hb,并登记进工程文件的文件表;没有项目时不可用"/>
                                <MenuItem Header="添加文件…" Click="添加文件_Click"
                                          ToolTip="把磁盘上已有的文件加进当前工程(可多选);只登记、不复制、不移动:工程目录里按相对路径,工程目录外按绝对路径。按后缀进对应的表:.hb 进「文件」、.hba 进「汇编」(C22)、别的进「资源」"/>
                                <Separator/>
                                <MenuItem Header="添加项目…" Click="添加项目_Click"
                                          ToolTip="把另一个项目加进当前方案(能和现在的项目并存)"/>
                                <MenuItem Header="刷新" Click="刷新项目_Click"/>
                                <Separator/>
                                <MenuItem Header="移除项目" Click="移除项目_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>

                        <TreeView.Resources>
                            <!-- ========== 文件模板 ========== -->
                            <!-- DataType 隐式匹配 local:文件项C,自动生效 -->
                            <DataTemplate DataType="{x:Type local:文件项C}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图标区域:两层叠放 -->
                                    <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <!-- 下层:文件图标 -->
                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#6FA8DC">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE8A5;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding 是资源}" Value="True">
                                                            <Setter Property="Foreground" Value="#D9A441"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 上层:hb 字母 -->
                                        <TextBlock Text="hb" FontSize="8" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="-6,4,0,0"
                                                   Foreground="Red"/>
                                    </Grid>
                                    <TextBlock Text="{Binding 显示名}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>

                            <!-- ========== 项目模板 ========== -->
                            <!-- DataType 隐式匹配 local:项目项C;ItemsSource 决定子项来源 -->
                            <HierarchicalDataTemplate DataType="{x:Type local:项目项C}" ItemsSource="{Binding 文件}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图标区域:两层叠放 -->
                                    <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <!-- 下层:文件夹图标 -->
                                        <TextBlock Text="{Binding 图标}" FontFamily="Segoe Fluent Icons" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#D9A441"/>
                                        <!-- 上层:hb 字母 -->
                                        <TextBlock Text="hb" FontSize="8" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,3,0,0"
                                                   Foreground="Red"/>
                                    </Grid>
                                    <TextBlock Text="{Binding 名称}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding 是否启动项目}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- ========== 展开/折叠三角 ========== -->
                            <Style TargetType="ToggleButton" x:Key="树展开箭头样式">
                                <Setter Property="Width" Value="16"/>
                                <Setter Property="Height" Value="16"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="3">
                                                <Path x:Name="箭头" Data="M 0,0 L 4,4 L 0,8"
                                                      Stroke="{DynamicResource 主题前景刷}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      RenderTransformOrigin="0.5,0.5"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="箭头" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- ========== TreeViewItem 样式 ========== -->
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource 主题前景刷}"/>
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="Margin" Value="0,1,0,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="行底" CornerRadius="4" Padding="4,3"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="展开箭头" Grid.Column="0"
                                                                      Style="{StaticResource 树展开箭头样式}"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                                        <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                          VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="子项" Margin="14,0,0,0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="展开箭头" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="子项" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="行底" Property="Background" Value="{DynamicResource 主题强调刷}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource 主题菜单字刷}"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="行底" Property="Background" Value="#20808080"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>

                        <!-- 注意:这里不再有 <TreeView.ItemTemplate>,模板全部在 Resources 里按 DataType 隐式匹配 -->
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns"/>

            <Grid Grid.Column="2" MinWidth="200">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="80" x:Name="底部行"/>
                </Grid.RowDefinitions>

                <!-- 上:编辑器 -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 编辑器区那一格是**固定分区标题**(写死"源代码 (支持中文指令)"),当前文件名在页头(标签页)上;
                         H30:它原先挂过一个"显示当前文件名"式的名字,可全仓没有一处代码更新它,那个名字已撤 -->                    <TextBlock Grid.Row="0"
                               Text="源代码 (支持中文指令)"
                               FontWeight="Bold"
                               Foreground="{DynamicResource 主题前景刷}" Margin="0,0,0,5"/>

                    <!-- TabControl 核心绑定 -->
                    <TabControl Grid.Row="1" Name="代码选卡"
                                ItemsSource="{Binding 选卡页视图模型表}"
                                SelectedItem="{Binding 选中页, Mode=TwoWay}"
                                SelectionChanged="代码选卡_SelectionChanged"
                                ItemContainerStyle="{StaticResource 标签头样式}"
                                ItemTemplateSelector="{StaticResource 头选择}"
                                ContentTemplateSelector="{StaticResource 内容选择}"
                                Background="{DynamicResource 主题内容刷}"
                                Foreground="{DynamicResource 主题前景刷}"
                                BorderThickness="0">
                    </TabControl>
                </Grid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" Background="Transparent"
                              ResizeBehavior="BasedOnAlignment" ResizeDirection="Rows"/>

                <!-- 下:输出(程序/测试输出) / 编译(编译信息) / 异常 / 变量 / 调试 -->
                <TabControl Grid.Row="2" x:Name="底部选卡" Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{StaticResource 页内标签头}">
                    <TabControl.Resources>
                        <!-- 底部这几页一直是浅底,所以表头/表格行的颜色写死成浅色一套(免得深色主题下白字白底看不见) -->
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="#FFEAEAEA"/>
                            <Setter Property="Foreground" Value="#FF1E1E1E"/>
                            <Setter Property="BorderBrush" Value="#FFCFCFCF"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="4,2,4,2"/>
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="#FF1E1E1E"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="2,1,2,1"/>
                        </Style>
                        <!-- 这一格是给底部那几块**纯标签字**用的(输入 ▶ / 表达式: / 监视说明 / 指令 / 内存 / 寄存器):
                             它们站在浅底上,而窗口那一层前景**跟着主题走**(暗底主题下是浅色)⇒ 不钉住就成"浅字压浅底"。
                             同一档的表格/输入框早就各自钉了 `#FF1E1E1E`,这一格只是把"纯标签"补齐到同一个数。 -->
                        <SolidColorBrush x:Key="主题浅底字刷" Color="#FF1E1E1E"/>
                    </TabControl.Resources>
                    <TabItem x:Name="输出页" Header="输出">
                        <TextBox x:Name="输出框"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 AcceptsReturn="True"
                                 FontSize="13"
                                 IsReadOnly="False"
                                 TextWrapping="Wrap"
                                 Background="#F5F5F5"
                                 KeyDown="输出框_KeyDown"
                                 TextChanged="输出框_TextChanged"/>
                    </TabItem>
                    <TabItem x:Name="编译页" Header="编译">
                        <TextBox x:Name="编译框"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 AcceptsReturn="True"
                                 FontSize="13"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="#F5F5F5"/>
                    </TabItem>
                    <TabItem x:Name="异常页" Header="异常">
                        <TextBox x:Name="异常框"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 AcceptsReturn="True"
                                 FontSize="13"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="#F5F5F5"
                                 Foreground="#C00000"/>
                    </TabItem>

                    <!-- 问题页:编辑器里检查出来的问题都列在这儿(双击跳到那一行) -->
                    <TabItem x:Name="问题页" Header="问题">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,3">
                                <CheckBox x:Name="看错误" Content="错误" IsChecked="True" Margin="0,0,12,0" Click="问题筛选_Changed"/>
                                <CheckBox x:Name="看警告" Content="警告" IsChecked="True" Margin="0,0,12,0" Click="问题筛选_Changed"/>
                                <CheckBox x:Name="看提示" Content="提示" IsChecked="True" Margin="0,0,12,0" Click="问题筛选_Changed"/>
                                <TextBlock x:Name="问题摘要" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                            </StackPanel>
                            <ListView x:Name="问题表" Grid.Row="1" FontFamily="Consolas" FontSize="13"
                                      Background="#F5F5F5" BorderThickness="0"
                                      SelectionMode="Extended"
                                      KeyDown="问题表_KeyDown"
                                      ContextMenuOpening="问题表_右键"
                                      MouseDoubleClick="问题表_MouseDoubleClick">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <!-- P38:一键修复(十条最常见的)。有没有方案由 `问题表_右键` 现算并开关 -->
                                        <MenuItem x:Name="菜单修这一条" Header="修这一条" Click="问题表_一键修复_Click"
                                                  ToolTip="把这一条问题直接改掉(先给改动预览,确认后才落到编辑器;不自动存盘,可以 Ctrl+Z 撤回)"/>
                                        <Separator/>
                                        <MenuItem Header="复制" Click="问题表_复制_Click"/>
                                        <MenuItem Header="复制全部" Click="问题表_复制全部_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="级别" Width="60"  DisplayMemberBinding="{Binding 级别}"/>
                                        <GridViewColumn Header="文件" Width="170" DisplayMemberBinding="{Binding 文件}"/>
                                        <GridViewColumn Header="行"   Width="50"  DisplayMemberBinding="{Binding 行}"/>
                                        <GridViewColumn Header="说明" Width="620" DisplayMemberBinding="{Binding 文本}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!-- 控制台页:程序输出 + 你敲给它的输入(程序在等输入时,在这儿敲一行、回车送进去) -->
                    <TabItem x:Name="控制台页" Header="控制台">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="控制台输出框"
                                     Grid.Row="0"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     AcceptsReturn="True"
                                     FontSize="13"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Foreground="{StaticResource 主题浅底字刷}"
                                     Background="#F5F5F5"/>
                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="输入 ▶" Foreground="{StaticResource 主题浅底字刷}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                                <TextBox x:Name="控制台输入框" Grid.Column="1" FontFamily="Consolas" FontSize="13"
                                         Foreground="{StaticResource 主题浅底字刷}"
                                         KeyDown="控制台输入框_KeyDown" Background="#FFFFFF"/>
                                <Button Grid.Column="2" Content="发送" Margin="6,0,0,0"
                                        Padding="10,2" Click="控制台发送_Click" ToolTip="把这一行送给正在等输入的程序(等于敲回车)"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 监视页(P35):把"我要盯的表达式"写下来,每走一步自动重算(只在调试时出现) -->
                    <TabItem x:Name="监视页" Header="监视" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,4">
                                <TextBlock Text="表达式:" Foreground="{StaticResource 主题浅底字刷}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                <TextBox x:Name="监视输入框" Width="240" Height="24" VerticalContentAlignment="Center"
                                         FontFamily="Consolas" FontSize="12"
                                         Foreground="{StaticResource 主题浅底字刷}" Background="#FFFFFF"
                                         ToolTip="写一个变量名(可带 .字段),或者 `变量 运算符 变量或常量`(如 `i == 5`、`左 &lt; 右`);回车就加上去"
                                         KeyDown="监视输入框_KeyDown"/>
                                <Button Content="添加" Height="24" Padding="10,0" Margin="6,0,0,0" Click="监视添加_Click"/>
                                <Button Content="去这一条" Height="24" Padding="10,0" Margin="6,0,0,0" Click="监视删除_Click"
                                        ToolTip="把列表里选中的那一条去掉"/>
                                <Button Content="全清" Height="24" Padding="10,0" Margin="6,0,0,0" Click="监视清空_Click"/>
                                <TextBlock x:Name="监视说明" Foreground="{StaticResource 主题浅底字刷}" VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                                           Margin="12,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Text="没写监视时,这里会提示怎么用"/>
                            </StackPanel>
                            <ListView x:Name="监视列表" FontFamily="Consolas" FontSize="13"
                                      Foreground="#FF1E1E1E"
                                      Background="#F5F5F5" BorderThickness="0"
                                      MouseDoubleClick="监视表_MouseDoubleClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="表达式" Width="200" DisplayMemberBinding="{Binding 表达式}"/>
                                        <GridViewColumn Header="值" Width="200" DisplayMemberBinding="{Binding 值}"/>
                                        <GridViewColumn Header="类型" Width="110" DisplayMemberBinding="{Binding 类型}"/>
                                        <GridViewColumn Header="变化(最近几次)" Width="330" DisplayMemberBinding="{Binding 历史}"/>
                                        <GridViewColumn Header="说明" Width="330" DisplayMemberBinding="{Binding 说明}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>

                    <!-- 变量页:只在"单步 / 停在断点上"时出现(平时收起,不占地方) -->
                    <TabItem x:Name="变量页" Header="变量" Visibility="Collapsed">
                        <ListView x:Name="变量表" FontFamily="Consolas" FontSize="13"
                                  Foreground="#FF1E1E1E"
                                  Background="#F5F5F5" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名字" Width="170" DisplayMemberBinding="{Binding 名字}"/>
                                    <GridViewColumn Header="值" Width="180" DisplayMemberBinding="{Binding 值}"/>
                                    <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding 类型}"/>
                                    <GridViewColumn Header="在哪" Width="180" DisplayMemberBinding="{Binding 在哪}"/>
                                    <GridViewColumn Header="寄存器" Width="90" DisplayMemberBinding="{Binding 寄存器槽}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <!-- 调试页:指令 / 内存 / 寄存器 并排,各自带自己的滚动条 -->
                    <TabItem x:Name="调试页" Header="调试" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="180"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="3*" MinWidth="180"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="3*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock x:Name="指令标题" DockPanel.Dock="Top" Text="指令" Foreground="{StaticResource 主题浅底字刷}" FontSize="12" Margin="2,0,0,2"/>
                                <TextBox x:Name="指令框" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                         Foreground="#FF1E1E1E"
                                         AcceptsReturn="True" Background="#F5F5F5" BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="内存" Foreground="{StaticResource 主题浅底字刷}" FontSize="12" Margin="2,0,0,2"/>
                                <TextBox x:Name="内存框" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                         Foreground="#FF1E1E1E"
                                         AcceptsReturn="True" Background="#F5F5F5" BorderThickness="0"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </DockPanel>
                            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>
                            <DockPanel Grid.Column="4">
                                <TextBlock DockPanel.Dock="Top" Text="寄存器" Foreground="{StaticResource 主题浅底字刷}" FontSize="12" Margin="2,0,0,2"/>
                                <ListView x:Name="寄存器表" FontFamily="Consolas" FontSize="12"
                                          Foreground="#FF1E1E1E"
                                          Background="#F5F5F5" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="寄存器" Width="70" DisplayMemberBinding="{Binding 寄存器}"/>
                                            <GridViewColumn Header="值" Width="130" DisplayMemberBinding="{Binding 值}"/>
                                            <GridViewColumn Header="谁的" Width="170" DisplayMemberBinding="{Binding 谁的}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ========== 运行监视条(H100 第一步)==========
             ① 数据全从**已有的**地方来,不动协议、不动虚拟机:
                · 状态 / PC / 已执行条数 —— 执行是**分块驱动**的(`机.跑到([], 20_000_000)` 一块两千万条),
                  每块结束那一帧状态就会把这些刷进镜像;
                · 子进程 CPU 与物理内存 —— 走 OS 读数(`虚拟机C.进程用量`,跨进程那台给的是子进程的真数)。
             ② 没事的时候显示"就绪";正在跑的那一台才报数,不编数。 -->
        <Border Grid.Row="3" Background="{DynamicResource 主题面板刷}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource 主题菜单刷}" Padding="8,2">
            <TextBlock x:Name="运行监视条" FontFamily="Consolas" FontSize="12"
                       Foreground="{DynamicResource 主题前景刷}" TextTrimming="CharacterEllipsis"
                       Text="就绪"/>
        </Border>
    </Grid>
</Window>
