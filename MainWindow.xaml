<Window x:Class="hehshihbeen_compiler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:hehshihbeen_compiler"
        xmlns:uc="clr-namespace:hehshihbeen_compiler.选卡控件"
        Title="中文汇编编译器" Height="900" Width="1440"
        PreviewKeyDown="快捷键_预览"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Icon="/assets/汇编_0.png">

    <Window.Resources>
        <!-- 主题动态资源(应用主题时更新,供 Border/TextBlock 等引用) -->
        <SolidColorBrush x:Key="主题面板刷" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="主题内容刷" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="主题前景刷" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="主题强调刷" Color="#FF0078D7"/>
<!-- 菜单那一条(第228批起):暗/亮两套是老样子,风格主题下跟着变 -->
<SolidColorBrush x:Key="主题菜单刷" Color="#FF2D2D30"/>
<SolidColorBrush x:Key="主题悬停刷" Color="#FF3D3D40"/>
<SolidColorBrush x:Key="主题菜单字刷" Color="#FFFFFFFF"/>

        <!-- 标签页头:让整片 Tab 面板随主题变色 -->
        <Style x:Key="标签头样式" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource 主题前景刷}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- H61-3:双击标签头(标题文字以外那一圈)= 把预览页固定成普通页。
                 双击**标题文字**仍然是改文件名 —— 那条路的 `标题框_MouseDoubleClick` 会 `e.Handled = true`,
                 冒泡到不了这里。 -->
            <EventSetter Event="MouseDoubleClick" Handler="标签头_双击"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="头边框"
                                Background="{DynamicResource 主题内容刷}"
                                BorderBrush="{DynamicResource 主题面板刷}"
                                BorderThickness="0,0,1,0"
                                CornerRadius="5,5,0,0"
                                Margin="1,3,0,0"
                                Padding="10,5">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="头边框" Property="Background" Value="{DynamicResource 主题面板刷}"/>
                                <Setter TargetName="头边框" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="头边框" Property="Margin" Value="1,2,-1,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="头边框" Property="Background" Value="{DynamicResource 主题面板刷}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 标签页模板(按"启动页/选项页/普通页"分流) -->
        <!-- 标签头上的关闭按钮:必须把全局 Button 样式里的 Padding/Margin 顶掉,否则 ✕ 会被裁掉 -->
        <Style x:Key="标签关闭按钮样式" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="普通头模板">
            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                <!-- C21:页头显示 `显示标题`(= 标题;有未保存改动时后面多一个 ` *`) -->
                <!-- H61-3:预览(临时)页的页头**斜体**(口径:斜体 = 临时打开;一编辑 / 双击标签头就固定) -->
                <!-- 页头那个文件名的字色:**必须自己写一句**(下面 `Foreground` 那一行)。
                     `TextBox` 的 `Foreground` 是它**模板里自己那一格**(默认黑),不像 `TextBlock` 那样吃父级继承 ——
                     漏了这一句,暗 / 黑客帝国 / 赛博朋克三套暗底下页头上的文件名就是黑字压深色页头,看不见。
                     照 `TabItem` 那条同样的动态刷走 ⇒ 亮色主题下它自己会落回近黑,老样子不变。 -->
                <TextBox Text="{Binding 显示标题, Mode=OneWay}"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"
                         MinWidth="60"
                         IsReadOnly="True"
                         Cursor="Arrow"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Foreground="{DynamicResource 主题前景刷}"
                         MouseDoubleClick="标题框_MouseDoubleClick"
                         PreviewMouseLeftButtonDown="标题框_模拟选卡页标题单击"
                         KeyDown="标题框_KeyDown"
                         LostFocus="标题框_LostFocus">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="ToolTip" Value="双击修改文件名"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding 是临时页}" Value="True">
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="ToolTip"
                                            Value="预览页(斜体):编辑一下、双击标签头空白处、或者再双击导图里那一格,都会固定成普通页;双击标题本身仍是改文件名"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Content="✕"
                        Style="{StaticResource 标签关闭按钮样式}"
                        ToolTip="关闭标签页"
                        VerticalAlignment="Center"
                        Click="标签关闭按钮_Click"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="选项头模板">
            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                <TextBlock Text="⚙ 选项" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <Button Content="✕"
                        Style="{StaticResource 标签关闭按钮样式}"
                        ToolTip="关闭选项页"
                        VerticalAlignment="Center"
                        Click="关闭选项页_Click"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="普通内容模板">
            <Border Background="{DynamicResource 主题面板刷}" Padding="15" CornerRadius="5">
                <local:编辑器 内容="{Binding 内容, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="选项内容模板">
            <local:选项页/>
        </DataTemplate>
        <local:标签头模板选择器 x:Key="头选择"
                        普通头="{StaticResource 普通头模板}"
                        选项头="{StaticResource 选项头模板}"/>
        <local:内容模板选择器 x:Key="内容选择"
                       普通内容="{StaticResource 普通内容模板}"
                       选项内容="{StaticResource 选项内容模板}"/>

        <!-- 按钮样式（保持不变） -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>
                <!-- 禁用时变暗(灰掉):不然光看图标看不出这个按钮现在点不动 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 工具栏上的文字按钮(调试那几个):和图标按钮同高,但用文字说清楚干嘛的 -->
        <Style x:Key="工具栏文字按钮样式" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource 主题前景刷}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#40808080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20808080"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ToolTip 样式（保持不变） -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Silver"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 页内小标签(输出/异常):与主题联动,无关闭钮 -->
        <Style x:Key="页内标签头" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource 主题前景刷}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource 主题内容刷}"
                                BorderBrush="{DynamicResource 主题面板刷}"
                                BorderThickness="0,0,1,0"
                                Padding="12,4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource 主题面板刷}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,2,1,0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource 主题强调刷}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 工具按钮统一样式:禁用时自动变淡(不用换图标也能一眼看出"禁止") -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 不包含顶层菜单 -->
        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource 主题菜单刷}"/>
            <Setter Property="Foreground" Value="{DynamicResource 主题菜单字刷}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="35,2"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      Grid.Column="0"/>
                                    <!-- 箭头 -->
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 0 8 Z"
                                          Fill="{DynamicResource 主题菜单字刷}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="2">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource 主题悬停刷}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                            </Trigger>
                            <!-- 子菜单项：左边留出图标列 -->
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Bd" Property="Padding" Value="35,2,8,2"/>
                            </Trigger>
                            <!-- 子菜单里的有下级项：同样缩进 -->
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Bd" Property="Padding" Value="35,2,8,2"/>
                            </Trigger>
                            <!-- 关键：有下级菜单时显示箭头 -->
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 包含顶层菜单 -->
        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource 主题菜单刷}"/>
            <Setter Property="Foreground" Value="{DynamicResource 主题菜单字刷}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <!-- 菜单项头部（保留默认显示） -->
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}" Padding="4,2" SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <!-- 子菜单 Popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="2">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource 主题悬停刷}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource 主题菜单刷}"/>
            <Setter Property="Foreground" Value="{DynamicResource 主题菜单字刷}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="4,2"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>     <!-- 勾选列(定宽:勾与不勾的标题不会左右错位) -->
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>   <!-- 快捷键文字(InputGestureText) -->
                                        <ColumnDefinition Width="Auto"/>   <!-- 箭头 -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 勾:`IsCheckable` 的项(视图开关、汇编源码参与编译…)原来在这个模板里看不见勾 -->
                                    <Path x:Name="Check"
                                          Grid.Column="0"
                                          Data="M 0 4 L 3.2 7 L 9 -1"
                                          Stroke="White"
                                          StrokeThickness="1.6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>

                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"/>

                                    <!-- 快捷键文字(WPF 默认模板会显示它,自绘模板别忘了这一格) -->
                                    <TextBlock Grid.Column="2"
                                               Text="{TemplateBinding InputGestureText}"
                                               Foreground="#B9B9BC"
                                               Margin="24,0,4,0"
                                               VerticalAlignment="Center"/>

                                    <!-- 箭头：只有子菜单里的有下级项才显示 -->
                                    <Path x:Name="Arrow"
                                          Grid.Column="3"
                                          Data="M 0 0 L 4 4 L 0 8 Z"
                                          Fill="{DynamicResource 主题菜单字刷}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="2">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource 主题悬停刷}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                            </Trigger>

                            <!-- 勾选状态(IsCheckable 的项:勾在这里画,和系统默认模板一样) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- 子菜单项:缩进 = 勾选列 22 + 这里 12,凑成原来那 35 -->
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Bd" Property="Padding" Value="12,2,8,2"/>
                            </Trigger>

                            <!-- 子菜单里的有下级项：缩进 + 向右弹出 + 显示箭头 -->
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Bd" Property="Padding" Value="12,2,8,2"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- 顶级有下级项：向下弹出，不缩进，不显示箭头 -->
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 子菜单项统一走暗色(第169批,bug 3)：
             以前只给**顶层**菜单项写了 SubMenuItemStyle,子菜单项(手写的那一堆 + `建片段菜单()` 现场生成的那些)
             落到 WPF 的默认模板 ⇒ 父项那身 Foreground=White 被继承下去,在亮色系统主题下就是"灰底白字",
             和暗色标题栏两张皮(用户实测报的:编辑 → 插入代码片段)。
             隐式样式(不写 x:Key)正好管这一片:凡是没显式写 Style 的 MenuItem 一律走它 ——
             手写项与现场生成项一起管住;顶层那几项写了 Style,按 WPF 的规矩显式优先,不受影响。 -->
        <Style TargetType="MenuItem" BasedOn="{StaticResource AllMenuItemStyle}"/>
    </Window.Resources>

    <!-- WindowChrome：保留调整边框和拖拽行为 -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"
                      CaptionHeight="30"
                      ResizeBorderThickness="6" />
        <!-- 调整窗口大小的边框宽度 -->
    </WindowChrome.WindowChrome>
    <Window.DataContext>
        <uc:主视图模型 />
    </Window.DataContext>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- 标题栏行（固定高度） -->
            <RowDefinition Height="Auto"/>
            <!-- 工具栏行 -->
            <RowDefinition Height="*"/>
            <!-- 主内容区 -->
            <RowDefinition Height="Auto"/>
            <!-- 运行监视条(H100 第一步):执行中实时看 状态 / PC / 条数 / 条每秒 / 子进程 CPU 与物理内存 -->
        </Grid.RowDefinitions>

        <!-- ========== 标题栏（三栏布局） ========== -->
        <Grid Grid.Row="0" Background="{DynamicResource 主题菜单刷}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左：应用图标 -->
            <Image Grid.Column="0"
                   Source="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Icon}"
                   Width="30" Height="30" Margin="2,0,0,0"
                   Stretch="Uniform" />

            <!-- 中：菜单 -->
            <!-- 菜单项 / 按钮的 `x:Name` 只给**要按状态开关**的那些起(`刷新命令可用性()` 里按名开 `IsEnabled`);
                 一直可用的条目不起名(H30:起了名却全仓没人用 = "有壳没接线",下一个接手的人白找一遍) -->
            <Menu x:Name="主菜单"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  WindowChrome.IsHitTestVisibleInChrome="True" >
                <MenuItem Header="文件(_F)" Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem Header="新建项目(_N)…" Click="新建项目_Click"
                              ToolTip="建 项目目录 + 工程文件(.hbp) + 主程序.hb,建好直接打开主程序.hb"/>
                    <MenuItem x:Name="新建文件菜单" Header="新建文件(_F)…" Click="新建文件_Click"
                              ToolTip="在项目目录里新建一个 .hb;没有项目时不可用"/>
                    <Separator/>
                    <MenuItem Header="打开项目(_P)…" Click="打开项目_Click"
                              ToolTip="读工程文件(.hbp):按里面的路径读出文件与子工程"/>
                    <MenuItem Header="打开文件(_O)…" Click="打开文件_Click"
