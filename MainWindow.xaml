                        BorderThickness="0"
                        Foreground="White"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Content="&#xE922;"
                        Click="最大化还原按钮_Click"
                        ToolTip="最大化"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                <!-- 关闭 -->
