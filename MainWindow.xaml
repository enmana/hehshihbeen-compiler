                <Button Width="30" Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Content="&#xE921;"
                        Click="最小化按钮_Click"
                        ToolTip="最小化"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                <!-- 关键：允许在 Chrome 区域交互 -->
