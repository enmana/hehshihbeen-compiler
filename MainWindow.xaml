                    <MenuItem x:Name="视图控制台" Header="控制台(_K)" IsCheckable="True" IsChecked="True" Click="视图开关_Click"/>
                    <MenuItem x:Name="视图问题" Header="问题(_P)" IsCheckable="True" IsChecked="True" Click="视图开关_Click"/>
                    <MenuItem x:Name="视图变量" Header="变量(_V)" IsCheckable="True" IsChecked="False" Click="视图开关_Click"/>
                    <MenuItem x:Name="视图调试" Header="调试(_D)" IsCheckable="True" IsChecked="False" Click="视图开关_Click"/>
                </MenuItem>
                <MenuItem Header="工具(_U)" Style="{StaticResource SubMenuItemStyle}">
