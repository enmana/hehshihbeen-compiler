                        RenderTransformOrigin="0.5,0.5"
                        Click="新建文件_Click">
                    <Grid>
                        <!-- 底框 -->
                        <TextBlock Text="&#xe7c3;"/>
                        <!-- 绿圈 -->
                        <TextBlock Text="&#xea3b;"
                                   Foreground="LawnGreen"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="10"
                                   Margin="-4,0,0,0"/>
                        <!-- 加号 -->
                        <TextBlock Text="&#xe710;"
                                   Foreground="White"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="9"
                                   Margin="-3.25,0.25,0,0"/>
                    </Grid>
                </Button>

