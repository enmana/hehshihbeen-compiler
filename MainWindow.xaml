                        <TextBlock Text="&#xe737;"/>
                        <!-- 绿圈 -->
                        <TextBlock Text="&#xea3b;"
                                   Foreground="LawnGreen"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="10"
                                   Margin="-4,0,0,0"/>
                        <!-- 加号 -->
                        <TextBlock Text="&#xe710;"
                                   Foreground="White"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="9"
                                   Margin="-3.25,0.25,0,0"/>
                        <TextBlock Text="HB:\"
                                   Foreground="PaleVioletRed"
                                   FontFamily="Arial Narrow"
                                   FontSize="9"
                                   Margin="2.5,8,0,0"/>
                    </Grid>
