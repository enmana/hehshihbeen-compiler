                    <Separator/>
                    <MenuItem x:Name="格式化菜单" Header="格式化当前文件(_F)" Click="格式化_Click" InputGestureText="Ctrl+Shift+F"
                              ToolTip="按块深度重排缩进 + 修行尾空白:先给改动预览再确认;只动空白,注释与字符串一个字符不碰,编译结果逐字节不变"/>
                    <MenuItem x:Name="片段菜单" Header="插入代码片段(_I)"
                              ToolTip="函数 / 如果 / 当 / 循环 / 遍历 / 选择 / 结构 / 测试 这些骨架,插到光标处并按当前层级缩进好">
                        <!-- 条目在窗口构造时按 片段表C.全部 生成(不手抄一份;数据只有引擎那一处) -->
                    </MenuItem>
                    <Separator/>
                    <MenuItem x:Name="语义对齐菜单" Header="语义列对齐(_F)" Click="菜单语义对齐_Click"/>
                    <Separator/>
                    <MenuItem x:Name="重命名菜单" Header="重命名(_M)" Click="重命名_Click"
                              ToolTip="把光标下那个名字在整个工程里改掉:先给一份改动预览,确认后才逐文件落盘;注释与字符串里的同名文字不会被改"/>
                    <Separator/>
                    <MenuItem x:Name="转到定义菜单" Header="转到定义(_D)" Click="转到定义_Click" InputGestureText="F12"
                              ToolTip="跳到光标下那个名字的定义处(跨文件);内建函数 / 宿主能力 / 关键字这类没有源码定义的会说清是哪一类,不会没反应"/>
                    <MenuItem x:Name="查找引用菜单" Header="查找引用(_R)" Click="查找引用_Click" InputGestureText="Shift+F12"
                              ToolTip="列出谁用了这个名字:函数看调用边表(语义);变量按文本整词找(清单写进输出框,并跳到第一处)"/>
                </MenuItem>
                <MenuItem Header="运行(_R)" Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem x:Name="汇编菜单" Header="编译(启动项目)(_A)" Click="汇编按钮_Click" ToolTip="按工程文件编译启动项目"/>
                    <MenuItem x:Name="参与编译菜单" Header="汇编源码参与编译(_H)" IsCheckable="True" Click="汇编源码参与编译_Click"
                              ToolTip="当前这一页是汇编源码(.hba)时可用:勾上把它写进工程文件的 `汇编` 表 —— 下次编译接在源码展开结果之后一起汇编(标签与源码全局共用);取消勾选就拿掉。默认不参与编译,所以不勾时编译产物与没有它时逐字节一致。"/>
                    <MenuItem x:Name="执行菜单" Header="执行(_E)" Click="执行按钮_Click" InputGestureText="F5"
                              ToolTip="F5 = 编译 + 执行:改过没保存的先自动存盘;源码变了自动重新编译、从头跑;没变又停在断点上就接着跑"/>
                    <MenuItem x:Name="允许弹窗菜单" Header="允许弹窗(_W)" IsCheckable="True" IsChecked="False" Click="允许弹窗_Click"
                              ToolTip="H92-1:程序里的提示框 / 选文件 / 另存为要不要真的弹在桌面上。默认**不勾** —— 那几条一律给「这个宿主不弹窗」,程序照常跑完,与命令行 / 自检 / 独立 exe 同一个口径(所以 `示例59_剪贴板与弹窗` 的输出断言两条腿对得上)。勾上就真弹,那时人得守着把它们点掉,程序才走得下去。勾选状态记在 `选项.json` 里,下次打开还在"/>
                    <MenuItem x:Name="控制台窗口跑菜单" Header="在控制台窗口里跑(_K)" Click="控制台窗口跑_Click" InputGestureText="Ctrl+F5" ToolTip="编译(没编就编)→ 把刚生成的独立程序在它自己的控制台窗口里跑起来:输入输出都在那个窗口里,退出码回写到「输出」页。适合看控制台程序(表格 / 进度条 / 读输入)的真效果;那个独立程序是控制台程序,跑完会等你按任意键。工具栏『打包:』选『只编译』时不产独立程序,会在「编译」页如实提示"/>
                    <MenuItem x:Name="热重载菜单" Header="热重载(_R)" Click="热重载菜单_Click" InputGestureText="F6"
                              ToolTip="H13:F6 = 改源码不重启程序就换机器码 —— 编译成功且程序**已经停下**时,把新机器码换进这台虚拟机,上一轮还在的顶层变量接着用(堆里的对象、调用栈、寄存器一律不带过来,重载后从程序开头重跑);程序还在跑就先把它停下,再按一次 F6 换。保不住什么会如实写在「输出」页"/>
                    <Separator/>
                    <MenuItem x:Name="单步调试菜单" Header="单步调试(_D)" Click="打开调试器按钮_Click"
                              ToolTip="打开调试观察窗(变量表 / 寄存器表 / 指令 / 内存;跟着主题换色)"/>
                    <MenuItem Header="中英切换(_L)" Click="中英切换_Click"/>
                    <Separator/>
                    <MenuItem x:Name="自检窗菜单" Header="自检窗格(_S)…" Click="菜单自检窗_Click"
