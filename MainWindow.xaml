                    <MenuItem x:Name="替换当前菜单" Header="替换(当前文件)…(_H)" Click="替换当前文件_Click" InputGestureText="Ctrl+H"
                              ToolTip="只在当前文件里替换:先给改动预览,确认后才改;注释与字符串里的文字不会被改(只改文本、不自动存盘,Ctrl+S 存)"/>
                    <MenuItem Header="全工程替换…(_G)" Click="全工程替换_Click"
